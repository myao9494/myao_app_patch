+        self.assertIn("cache-search", read(ROOT / "agents" / "outlook.md"))
+        for path in (ROOT / "templates" / "project" / "document" / "AGENTS.md", ROOT / "templates" / "obsidian" / "AGENTS.md"):
+            self.assertIn("調査は、1 回で答えまで出す", read(path), path)
 
