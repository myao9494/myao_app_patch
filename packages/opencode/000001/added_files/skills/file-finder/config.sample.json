{
  "roots": [
    "C:/Users/<ユーザー名>/Documents",
    "D:/共有フォルダ"
  ],
  "exclude": [".git", ".handoff", "node_modules", "~$*", "*.tmp", "$RECYCLE.BIN"],
  "everything": {
    "url": "http://127.0.0.1:8080",
    "user": "",
    "password_env": "EVERYTHING_PASSWORD"
  },
  "fulltext": {
    "url": "http://127.0.0.1:8079",
    "folders": []
  },
  "limits": {
    "max_results": 30,
    "snippet_chars": 160,
    "timeout_sec": 15
  }
}
