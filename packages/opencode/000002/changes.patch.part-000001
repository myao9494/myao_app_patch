+    tags = sub.add_parser("tags", help="Vault で使われているタグと件数 (新しいタグを作る前に探す。読み取りだけ)")
+    tags.add_argument("--grep", nargs="+", default=[], help="この語を含むタグだけ (複数可。どれかを含む)")
+    tags.add_argument("--limit", type=int, default=60, help="表示する最大件数")
     return parser
 
 
