+class TaskNoteTests(AppsTestCase):
+    """ガントの「O」と同じノート作成 (POST /api/tasks/with-note、/api/tasks/{id}/note) を呼ぶ。"""
+
+    NOTE = "/v/01_data/2026/11/11/提出【99】.md"
+
+    def setUp(self) -> None:
+        super().setUp()
+        gantt = self.apps["gantt"]
+        gantt.routes[("POST", "/api/tasks/with-note")] = lambda q, b: (200, {"task_id": 99, "note_path": self.NOTE, "created": True, "task": {"id": 99, **b, "hyperlink": self.NOTE}})
+        gantt.routes[("POST", r"/api/tasks/(\d+)/note")] = lambda q, b: (200, {"task_id": 2, "note_path": "/v/01_data/図面のチェック【2】.md", "created": False})
+
+    def test_task_addのwith_noteの試行は何も書かず_ノートも作ると示す(self) -> None:
+        code, out, _ = self.run_cli("task-add", "--title", "提出", "--start", "2026-11-10", "--with-note", "--dry-run")
+        self.assertEqual(code, 0, out)
+        self.assertIn("[試行]", out)
+        self.assertIn("ノート: ガントの「O」と同じ形", out)
+        self.assertFalse(self.apps["gantt"].writes())
+
+    def test_task_addのwith_noteは1回でタスクとノートを作りパスを返す(self) -> None:
+        code, out, _ = self.run_cli("task-add", "--title", "提出", "--start", "2026-11-10", "--last-day", "2026-11-14", "--with-note")
+        self.assertEqual(code, 0, out)
+        writes = self.apps["gantt"].writes()
+        self.assertEqual(len(writes), 1)
+        method, path, _, body = writes[0]
+        self.assertEqual((method, path), ("POST", "/api/tasks/with-note"))
+        self.assertEqual(body, {"text": "提出", "start_date": "2026-11-10 00:00:00", "end_date": "2026-11-15 00:00:00"})
+        self.assertIn("作りました: [99] 提出", out)
+        self.assertIn(f"ノート: {self.NOTE} (新しく作りました)", out)
+        self.assertIn("mark-edit", out)
+
+    def test_with_noteなしの_task_addは_ノートを作らない(self) -> None:
+        self.run_cli("task-add", "--title", "提出", "--start", "2026-11-10")
+        self.assertEqual([w[1] for w in self.apps["gantt"].writes()], ["/api/tasks"])
+
+    def test_task_noteは既存のタスクのノートのパスを返す(self) -> None:
+        code, out, _ = self.run_cli("task-note", "2")
+        self.assertEqual(code, 0, out)
+        method, path, _, body = self.apps["gantt"].writes()[-1]
+        self.assertEqual((method, path, body), ("POST", "/api/tasks/2/note", None))
+        self.assertIn("ノート: /v/01_data/図面のチェック【2】.md (すでにあったので、そのまま使います (中身は変えていません))", out)
+
+    def test_task_noteの試行は書かない(self) -> None:
+        code, out, _ = self.run_cli("task-note", "2", "--dry-run")
+        self.assertEqual(code, 0)
+        self.assertIn("[試行]", out)
+        self.assertIn("[2] 図面のチェック", out)
+        self.assertFalse(self.apps["gantt"].writes())
+
+    def test_task_noteは存在しないタスクを作らずに止める(self) -> None:
+        code, _, err = self.run_cli("task-note", "12345")
+        self.assertEqual(code, 2)
+        self.assertIn("HTTP 404", err)
+        self.assertFalse(self.apps["gantt"].writes())
+
+    def test_古いガントには_更新が要ると伝える(self) -> None:
+        del self.apps["gantt"].routes[("POST", "/api/tasks/with-note")]
+        code, _, err = self.run_cli("task-add", "--title", "提出", "--start", "2026-11-10", "--with-note")
+        self.assertEqual(code, 2)
+        self.assertIn("ガントが古い版かもしれません", err)
+
+    def test_ガントがVaultを見つけられないエラーはそのまま伝える(self) -> None:
+        self.apps["gantt"].routes[("POST", "/api/tasks/with-note")] = lambda q, b: (400, {"detail": "Obsidian home not found: /x"})
+        code, _, err = self.run_cli("task-add", "--title", "提出", "--start", "2026-11-10", "--with-note")
+        self.assertEqual(code, 2)
+        self.assertIn("Obsidian home not found", err)
+        self.assertNotIn("古い版", err)
+
+
