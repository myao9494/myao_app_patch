{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "share": "disabled",
  "permissions": [
    {"action": "read", "resource": "*", "effect": "allow"},
    {"action": "read", "resource": "*.env", "effect": "ask"},
    {"action": "read", "resource": "*.env.*", "effect": "ask"},
    {"action": "read", "resource": "*.env.example", "effect": "allow"},
    {"action": "read", "resource": "*.pem", "effect": "ask"},
    {"action": "read", "resource": "*.key", "effect": "ask"},
    {"action": "read", "resource": "*.pfx", "effect": "ask"},
    {"action": "read", "resource": "*.p12", "effect": "ask"},
    {"action": "read", "resource": "*.kdbx", "effect": "ask"},
    {"action": "read", "resource": "*id_rsa*", "effect": "ask"},
    {"action": "read", "resource": "*id_ed25519*", "effect": "ask"},
    {"action": "edit", "resource": "*", "effect": "allow"},
    {"action": "edit", "resource": "*.env", "effect": "ask"},
    {"action": "edit", "resource": "*.env.*", "effect": "ask"},
    {"action": "edit", "resource": "*.env.example", "effect": "allow"},
    {"action": "skill", "resource": "*", "effect": "allow"},
    {"action": "webfetch", "resource": "*", "effect": "deny"},
    {"action": "websearch", "resource": "*", "effect": "deny"},
    {"action": "external_directory", "resource": "*", "effect": "ask"},
    {"action": "external_directory", "resource": "~/.config/opencode/skills/**", "effect": "allow"},
    {"action": "playwright_*", "resource": "*", "effect": "deny"},
    {"action": "shell", "resource": "*", "effect": "allow"},
    {"action": "shell", "resource": "rm *", "effect": "ask"},
    {"action": "shell", "resource": "del *", "effect": "ask"},
    {"action": "shell", "resource": "erase *", "effect": "ask"},
    {"action": "shell", "resource": "rd *", "effect": "ask"},
    {"action": "shell", "resource": "rmdir *", "effect": "ask"},
    {"action": "shell", "resource": "Remove-Item*", "effect": "ask"},
    {"action": "shell", "resource": "git push*", "effect": "ask"},
    {"action": "shell", "resource": "git reset --hard*", "effect": "ask"},
    {"action": "shell", "resource": "git clean*", "effect": "ask"},
    {"action": "shell", "resource": "git checkout -- *", "effect": "ask"},
    {"action": "shell", "resource": "git checkout .", "effect": "ask"},
    {"action": "shell", "resource": "git restore *", "effect": "ask"},
    {"action": "shell", "resource": "git stash drop*", "effect": "ask"},
    {"action": "shell", "resource": "git stash clear*", "effect": "ask"},
    {"action": "shell", "resource": "git branch -D *", "effect": "ask"},
    {"action": "shell", "resource": "git rebase*", "effect": "ask"},
    {"action": "shell", "resource": "git commit*--amend*", "effect": "ask"},
    {"action": "shell", "resource": "git filter-branch*", "effect": "ask"},
    {"action": "shell", "resource": "git checkout * -- *", "effect": "ask"},
    {"action": "shell", "resource": "git switch*--discard-changes*", "effect": "ask"},
    {"action": "shell", "resource": "git reflog expire*", "effect": "ask"},
    {"action": "shell", "resource": "find * -delete*", "effect": "ask"},
    {"action": "shell", "resource": "find * -exec rm*", "effect": "ask"},
    {"action": "shell", "resource": "* .env*", "effect": "ask"},
    {"action": "shell", "resource": "*/.env*", "effect": "ask"},
    {"action": "shell", "resource": "*.env.example*", "effect": "allow"},
    {"action": "shell", "resource": "ssh *", "effect": "ask"},
    {"action": "shell", "resource": "scp *", "effect": "ask"},
    {"action": "shell", "resource": "sftp *", "effect": "ask"},
    {"action": "shell", "resource": "ftp *", "effect": "ask"},
    {"action": "shell", "resource": "reg add*", "effect": "ask"},
    {"action": "shell", "resource": "reg delete*", "effect": "ask"},
    {"action": "shell", "resource": "Set-ExecutionPolicy*", "effect": "ask"},
    {"action": "shell", "resource": "*pip install*", "effect": "ask"},
    {"action": "shell", "resource": "*pip uninstall*", "effect": "ask"},
    {"action": "shell", "resource": "*pip download*", "effect": "ask"},
    {"action": "shell", "resource": "*outlook-mail*run.bat cal-create*", "effect": "ask"},
    {"action": "shell", "resource": "*outlook-mail*run.bat folder-create*", "effect": "ask"},
    {"action": "shell", "resource": "*outlook-mail*run.bat mail-move*", "effect": "ask"},
    {"action": "shell", "resource": "*outlook-mail*run.bat mail-undo*", "effect": "ask"},
    {"action": "shell", "resource": "*outlook-mail*run.bat cal-create* --dry-run*", "effect": "allow"},
    {"action": "shell", "resource": "*outlook-mail*run.bat folder-create* --dry-run*", "effect": "allow"},
    {"action": "shell", "resource": "*outlook-mail*run.bat mail-move* --dry-run*", "effect": "allow"},
    {"action": "shell", "resource": "*outlook-mail*run.bat mail-undo* --dry-run*", "effect": "allow"},
    {"action": "shell", "resource": "*app-ecosystem*run.bat task-add*", "effect": "ask"},
    {"action": "shell", "resource": "*app-ecosystem*run.sh task-add*", "effect": "ask"},
    {"action": "shell", "resource": "*app-ecosystem*run.bat task-update*", "effect": "ask"},
    {"action": "shell", "resource": "*app-ecosystem*run.sh task-update*", "effect": "ask"},
    {"action": "shell", "resource": "*app-ecosystem*run.bat task-link*", "effect": "ask"},
    {"action": "shell", "resource": "*app-ecosystem*run.sh task-link*", "effect": "ask"},
    {"action": "shell", "resource": "*app-ecosystem*run.bat task-note*", "effect": "ask"},
    {"action": "shell", "resource": "*app-ecosystem*run.sh task-note*", "effect": "ask"},
    {"action": "shell", "resource": "*app-ecosystem*run.bat task-add* --dry-run*", "effect": "allow"},
    {"action": "shell", "resource": "*app-ecosystem*run.sh task-add* --dry-run*", "effect": "allow"},
    {"action": "shell", "resource": "*app-ecosystem*run.bat task-update* --dry-run*", "effect": "allow"},
    {"action": "shell", "resource": "*app-ecosystem*run.sh task-update* --dry-run*", "effect": "allow"},
    {"action": "shell", "resource": "*app-ecosystem*run.bat task-link* --dry-run*", "effect": "allow"},
    {"action": "shell", "resource": "*app-ecosystem*run.sh task-link* --dry-run*", "effect": "allow"},
    {"action": "shell", "resource": "*app-ecosystem*run.bat task-note* --dry-run*", "effect": "allow"},
    {"action": "shell", "resource": "*app-ecosystem*run.sh task-note* --dry-run*", "effect": "allow"},
    {"action": "shell", "resource": "*browser-session*run.bat run* --allow-submit*", "effect": "ask"},
    {"action": "shell", "resource": "*browser-session*run.sh run* --allow-submit*", "effect": "ask"},
    {"action": "shell", "resource": "git push --force*", "effect": "deny"},
    {"action": "shell", "resource": "git push -f*", "effect": "deny"},
    {"action": "shell", "resource": "git push*--force*", "effect": "deny"},
    {"action": "shell", "resource": "git push* -f*", "effect": "deny"},
    {"action": "shell", "resource": "git push* +*", "effect": "deny"},
    {"action": "shell", "resource": "curl *", "effect": "deny"},
    {"action": "shell", "resource": "wget *", "effect": "deny"},
    {"action": "shell", "resource": "Invoke-WebRequest*", "effect": "deny"},
    {"action": "shell", "resource": "iwr *", "effect": "deny"},
    {"action": "shell", "resource": "Invoke-RestMethod*", "effect": "deny"},
    {"action": "shell", "resource": "irm *", "effect": "deny"},
    {"action": "shell", "resource": "curl.exe *", "effect": "deny"},
    {"action": "shell", "resource": "wget.exe *", "effect": "deny"},
    {"action": "shell", "resource": "*Invoke-WebRequest*", "effect": "deny"},
    {"action": "shell", "resource": "*Invoke-RestMethod*", "effect": "deny"},
    {"action": "shell", "resource": "*Net.WebClient*", "effect": "deny"},
    {"action": "shell", "resource": "*DownloadFile*", "effect": "deny"},
    {"action": "shell", "resource": "*DownloadString*", "effect": "deny"},
    {"action": "shell", "resource": "Start-BitsTransfer*", "effect": "deny"},
    {"action": "shell", "resource": "bitsadmin*", "effect": "deny"},
    {"action": "shell", "resource": "certutil*-urlcache*", "effect": "deny"},
    {"action": "shell", "resource": "*-EncodedCommand*", "effect": "deny"},
    {"action": "shell", "resource": "npm install*", "effect": "deny"},
    {"action": "shell", "resource": "npm i", "effect": "deny"},
    {"action": "shell", "resource": "npm i *", "effect": "deny"},
    {"action": "shell", "resource": "npm add*", "effect": "deny"},
    {"action": "shell", "resource": "npm ci*", "effect": "deny"},
    {"action": "shell", "resource": "npx *", "effect": "deny"},
    {"action": "shell", "resource": "format *", "effect": "deny"},
    {"action": "shell", "resource": "Format-Volume*", "effect": "deny"},
    {"action": "shell", "resource": "Clear-Disk*", "effect": "deny"},
    {"action": "shell", "resource": "diskpart*", "effect": "deny"}
  ],
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "node",
          "C:/Users/<ユーザー名>/.config/opencode/mcp/playwright/node_modules/@playwright/mcp/cli.js",
          "--browser",
          "msedge",
          "--isolated",
          "--image-responses",
          "omit",
          "--output-dir",
          ".handoff/playwright",
          "--console-level",
          "error",
          "--no-webmcp",
          "--block-service-workers"
        ],
        "disabled": true,
        "codemode": false,
        "timeout": {
          "startup": 60000,
          "catalog": 60000
        }
      }
    }
  }
}
