-      esac
-    else
-        kfmclient exec "$1"
-        kfmclient_fix_exit_code $?
-    fi
-
-    if [ $? -eq 0 ]; then
-        exit_success
-    else
-        exit_failure_operation_failed
-    fi
-}
-
