diff --git a/mcp/playwright/smoke_test.py b/mcp/playwright/smoke_test.py
deleted file mode 100644
index a6e9581df640b45571bd22fda31343c713f8fbb5..0000000000000000000000000000000000000000
--- a/mcp/playwright/smoke_test.py
+++ /dev/null
@@ -1,120 +0,0 @@
-"""同梱した Playwright MCP が、動くかを確かめる (標準ライブラリだけで動く)。
-
-やること:
-  1. サーバーを標準入出力で起動して、ツールの一覧を取る
-  2. ローカルの小さなページを開いて、スナップショットに見出しが出るかを見る
-
-使い方 (ハーネスのフォルダから):
-  会社:   .venv\\Scripts\\python mcp\\playwright\\smoke_test.py msedge
-  自宅:   python3 mcp/playwright/smoke_test.py chrome
-ブラウザは --headless --isolated で起動する (画面は出ない。プロファイルも保存しない)。
-終了コード: 0 = 成功、1 = 失敗。
-"""
-from __future__ import annotations
-
-import http.server
-import json
-import subprocess
-import sys
-import tempfile
-import threading
-import time
-from pathlib import Path
-
-HERE = Path(__file__).resolve().parent
-CLI = HERE / "node_modules" / "@playwright" / "mcp" / "cli.js"
-FLAGS = ["--isolated", "--image-responses", "omit", "--no-webmcp", "--block-service-workers", "--console-level", "error"]
-
-
-def main() -> int:
-    browser = sys.argv[1] if len(sys.argv) > 1 else "msedge"
-    if not CLI.exists():
-        print(f"失敗: {CLI} がありません")
-        return 1
-
-    with tempfile.TemporaryDirectory() as tmp:
-        site = Path(tmp)
-        (site / "index.html").write_text(
-            "<!doctype html><meta charset=utf-8><title>テストページ</title><h1>見出し</h1>"
-            "<button>押す</button><p>本文</p>",
-            encoding="utf-8",
-        )
-
-        class Handler(http.server.SimpleHTTPRequestHandler):
-            def __init__(self, *args, **kwargs):
-                super().__init__(*args, directory=str(site), **kwargs)
-
-            def log_message(self, *args):
-                pass
-
-        server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
-        port = server.server_address[1]
-        threading.Thread(target=server.serve_forever, daemon=True).start()
-
-        proc = subprocess.Popen(
-            ["node", str(CLI), "--browser", browser, "--headless", *FLAGS, "--output-dir", str(site / "out")],
-            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
-            text=True, encoding="utf-8", cwd=str(site),
-        )
-        counter = {"id": 0}
-
-        def send(method: str, params: dict | None = None, notify: bool = False) -> int | None:
-            message: dict = {"jsonrpc": "2.0", "method": method}
-            if params is not None:
-                message["params"] = params
-            if not notify:
-                counter["id"] += 1
-                message["id"] = counter["id"]
-            assert proc.stdin is not None
-            proc.stdin.write(json.dumps(message) + "\n")
-            proc.stdin.flush()
-            return None if notify else counter["id"]
-
-        def receive(wanted: int, timeout: float = 90) -> dict:
-            assert proc.stdout is not None
-            end = time.time() + timeout
-            while time.time() < end:
-                line = proc.stdout.readline()
-                if not line:
-                    raise RuntimeError("サーバーが終了しました: " + (proc.stderr.read() if proc.stderr else "")[:500])
-                try:
-                    message = json.loads(line)
-                except ValueError:
-                    continue
-                if message.get("id") == wanted:
-                    return message
-            raise TimeoutError(f"応答がありません (id={wanted})")
-
-        def call(name: str, arguments: dict | None = None) -> dict:
-            return receive(send("tools/call", {"name": name, "arguments": arguments or {}}))  # type: ignore[arg-type]
-
-        try:
-            init = receive(send("initialize", {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "smoke", "version": "0"}}))  # type: ignore[arg-type]
-            print("サーバー:", init["result"]["serverInfo"])
-            send("notifications/initialized", notify=True)
-
-            tools = receive(send("tools/list"))["result"]["tools"]  # type: ignore[arg-type]
-            size = len(json.dumps(tools, ensure_ascii=False))
-            print(f"ツール数: {len(tools)} / ツール定義の大きさ: {size} 文字 (使えるエージェントのコンテキストに常に入る)")
-
-            result = call("browser_navigate", {"url": f"http://127.0.0.1:{port}/index.html"})
-            if result.get("error") or result.get("result", {}).get("isError"):
-                print("失敗: ページを開けません:", json.dumps(result, ensure_ascii=False)[:400])
-                return 1
-            snapshot = call("browser_snapshot")["result"]["content"]
-            text = "\n".join(part.get("text", "") for part in snapshot if part.get("type") == "text")
-            ok = "見出し" in text
-            print("スナップショットに見出しが出る:", "OK" if ok else "NG")
-            if not ok:
-                print(text[:600])
-            return 0 if ok else 1
-        except Exception as exc:  # noqa: BLE001 - 失敗の理由をそのまま見せる
-            print(f"失敗: {type(exc).__name__}: {exc}")
-            return 1
-        finally:
-            proc.terminate()
-            server.shutdown()
-
-
-if __name__ == "__main__":
-    sys.exit(main())
diff --git a/mcp/scan_vendor.py b/mcp/scan_vendor.py
deleted file mode 100644
index 3354e7d05967bd0383b2c4b90d1e230ed2f9462d..0000000000000000000000000000000000000000
--- a/mcp/scan_vendor.py
+++ /dev/null
@@ -1,70 +0,0 @@
-"""同梱するフォルダが、Windows と myao-patch-bridge の制約に合うか調べる (読み取り専用。自宅で、同梱を更新したときに使う)。
-
-使い方: python3 -I mcp/scan_vendor.py <リポジトリのルート> <調べるフォルダ(ルートからの相対)>
-例:     python3 -I mcp/scan_vendor.py . mcp/playwright
-規則は myao-patch-bridge の docs/clean-verification.md に基づく:
-  - 予約名 (CON PRN AUX NUL COM1-9 LPT1-9)、使えない文字 < > : " | ? * \\ と制御文字、末尾の空白とピリオド
-  - 大文字小文字だけが違う同名ファイル
-  - リポジトリ内の相対パスは 156 文字以内
-  - サブモジュール・シンボリックリンクは不可 (ここでは、シンボリックリンクは問題として扱う)
-"""
-import os
-import re
-import sys
-from collections import defaultdict
-from pathlib import Path
-
-root = Path(sys.argv[1]).resolve()
-target = (root / sys.argv[2]).resolve()
-RESERVED = {"CON", "PRN", "AUX", "NUL"} | {f"COM{i}" for i in range(1, 10)} | {f"LPT{i}" for i in range(1, 10)}
-BAD = re.compile(r'[<>:"|?*\\\x00-\x1f]')
-
-files = 0
-total = 0
-longest = ("", 0)
-biggest = ("", 0)
-problems = []
-by_lower = defaultdict(list)
-ext_count = defaultdict(int)
-for dirpath, dirnames, filenames in os.walk(target, followlinks=False):
-    for name in dirnames + filenames:
-        full = Path(dirpath) / name
-        rel = full.relative_to(root).as_posix()
-        if full.is_symlink():
-            problems.append(f"シンボリックリンク: {rel}")
-            continue
-        stem = name.split(".")[0].upper()
-        if stem in RESERVED:
-            problems.append(f"予約名: {rel}")
-        if BAD.search(name):
-            problems.append(f"使えない文字: {rel}")
-        if name != name.rstrip(" .") :
-            problems.append(f"末尾の空白/ピリオド: {rel}")
-        by_lower[rel.lower()].append(rel)
-        if len(rel) > 156:
-            problems.append(f"パスが長い({len(rel)}): {rel}")
-    for name in filenames:
-        full = Path(dirpath) / name
-        if full.is_symlink():
-            continue
-        files += 1
-        size = full.stat().st_size
-        total += size
-        rel = full.relative_to(root).as_posix()
-        if len(rel) > longest[1]:
-            longest = (rel, len(rel))
-        if size > biggest[1]:
-            biggest = (rel, size)
-        ext_count[full.suffix.lower() or "(なし)"] += 1
-for key, paths in by_lower.items():
-    if len(paths) > 1:
-        problems.append(f"大文字小文字だけが違う: {paths}")
-
-print(f"ファイル数: {files}")
-print(f"合計: {total/1024/1024:.1f} MB")
-print(f"最長パス: {longest[1]} 文字 (上限 156) {longest[0]}")
-print(f"最大ファイル: {biggest[1]/1024/1024:.2f} MB {biggest[0]}")
-print("拡張子の上位:", sorted(ext_count.items(), key=lambda kv: -kv[1])[:8])
-print(f"問題: {len(problems)} 件")
-for line in problems[:30]:
-    print("  -", line)
diff --git a/sample_opencode.json b/sample_opencode.json
index f8c872a4119cdad283fed21adb94294a41a7bc90..7bc338d5ccb0b7ca3c31b1f43f17242b133b9403 100644
--- a/sample_opencode.json
+++ b/sample_opencode.json
@@ -24,7 +24,6 @@
     {"action": "websearch", "resource": "*", "effect": "deny"},
     {"action": "external_directory", "resource": "*", "effect": "ask"},
     {"action": "external_directory", "resource": "~/.config/opencode/skills/**", "effect": "allow"},
-    {"action": "playwright_*", "resource": "*", "effect": "deny"},
     {"action": "shell", "resource": "*", "effect": "allow"},
     {"action": "shell", "resource": "rm *", "effect": "ask"},
     {"action": "shell", "resource": "del *", "effect": "ask"},
@@ -120,33 +119,5 @@
     {"action": "shell", "resource": "Format-Volume*", "effect": "deny"},
     {"action": "shell", "resource": "Clear-Disk*", "effect": "deny"},
     {"action": "shell", "resource": "diskpart*", "effect": "deny"}
-  ],
-  "mcp": {
-    "servers": {
-      "playwright": {
-        "type": "local",
-        "command": [
-          "node",
-          "C:/Users/<ユーザー名>/.config/opencode/mcp/playwright/node_modules/@playwright/mcp/cli.js",
-          "--browser",
-          "msedge",
-          "--isolated",
-          "--image-responses",
-          "omit",
-          "--output-dir",
-          ".handoff/playwright",
