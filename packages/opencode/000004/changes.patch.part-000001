-   * // playwright.config.ts
-   * import { defineConfig } from '@playwright/test';
-   *
-   * export default defineConfig({
-   *   use: {
-   *     navigationTimeout: 3000,
-   *   },
-   * });
-   * ```
-   *
-   * Learn more about [various timeouts](https://playwright.dev/docs/test-timeouts).
