-
-      /**
-       * File type
-       */
-      mimeType: string;
-
-      /**
-       * File content
-       */
-      buffer: Buffer;
-    }|Array<{
-      /**
-       * File name
-       */
-      name: string;
-
-      /**
-       * File type
-       */
-      mimeType: string;
-
-      /**
-       * File content
