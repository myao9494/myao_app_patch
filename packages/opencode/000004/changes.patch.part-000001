-   * **Usage**
-   *
-   * ```js
-   * // playwright.config.ts
-   * import { defineConfig } from '@playwright/test';
-   *
-   * export default defineConfig({
-   *   use: {
-   *     extraHTTPHeaders: {
-   *       'X-My-Header': 'value',
-   *     },
-   *   },
-   * });
-   * ```
-   *
-   */
-  extraHTTPHeaders: ExtraHTTPHeaders | undefined;
