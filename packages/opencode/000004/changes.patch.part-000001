-      top?: number;
-      /**
-       * Frame width in DIP (requires newWindow to be true or headless shell).
-       */
-      width?: number;
-      /**
-       * Frame height in DIP (requires newWindow to be true or headless shell).
-       */
-      height?: number;
-      /**
-       * Frame window state (requires newWindow to be true or headless shell).
-Default is normal.
