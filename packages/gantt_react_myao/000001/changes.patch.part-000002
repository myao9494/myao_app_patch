+
+      event.preventDefault();
+      event.stopPropagation();
+
+      const rect = taskData.getBoundingClientRect();
+      const relativeX = event.clientX - rect.left + taskData.scrollLeft;
+      const clickedDate = gantt.dateFromPos(relativeX);
