diff --git a/frontend/src/components/GanttChart/ContextMenu.test.ts b/frontend/src/components/GanttChart/ContextMenu.test.ts
index 55d79a70c16c5bd56dd36c9bc33dd4811ae5c705..8d3c64424c7c0f3be65499b72fea03f9f8ca468f 100644
--- a/frontend/src/components/GanttChart/ContextMenu.test.ts
+++ b/frontend/src/components/GanttChart/ContextMenu.test.ts
@@ -104,5 +104,41 @@ describe('ContextMenu - カレンダー日付右クリックメニュー', () =>
       expect(items[0].label).toBe('新規プロジェクト追加');
       expect(items[1].label).toBe('新規タスク追加');
     });
+
+    it('taskIdとonAddScheduleが渡された場合、「スケジュールを追加」が含まれ、実行時にtaskIdと日付が渡されること', () => {
+      const onAddProject = vi.fn();
+      const onAddTask = vi.fn();
+      const onAddSchedule = vi.fn();
+
+      const items = getEmptyAreaContextMenuItems(testDate, {
+        onAddProject,
+        onAddTask,
+        onAddSchedule,
+        taskId: 123,
+      });
+
+      const scheduleItem = items.find((i) => i.label === 'スケジュールを追加');
+      expect(scheduleItem).toBeDefined();
+      expect(scheduleItem?.icon).toBe('📌');
+
+      scheduleItem?.action?.();
+      expect(onAddSchedule).toHaveBeenCalledWith(123, testDate);
+    });
+
+    it('taskIdが未指定（nullまたはundefined）の場合、「スケジュールを追加」は含まれないこと', () => {
+      const onAddProject = vi.fn();
+      const onAddTask = vi.fn();
+      const onAddSchedule = vi.fn();
+
+      const items = getEmptyAreaContextMenuItems(testDate, {
+        onAddProject,
+        onAddTask,
+        onAddSchedule,
+        taskId: null,
+      });
+
+      const scheduleItem = items.find((i) => i.label === 'スケジュールを追加');
+      expect(scheduleItem).toBeUndefined();
+    });
   });
 });
