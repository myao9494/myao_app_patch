diff --git a/frontend/src/components/GanttChart/__tests__/GanttChart.test.tsx b/frontend/src/components/GanttChart/__tests__/GanttChart.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..163d377dda237dc6bc0f0126ee1b21b27d91d9a0
--- /dev/null
+++ b/frontend/src/components/GanttChart/__tests__/GanttChart.test.tsx
@@ -0,0 +1,181 @@
+/**
+ * @vitest-environment jsdom
+ * GanttChart コンポーネントを実際にマウントして検証するテスト
+ * （gantt の初期化・破棄と、props のデータを gantt へ反映する部分）
+ */
+import { StrictMode } from 'react';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { cleanup, render } from '@testing-library/react';
+import { gantt } from 'dhtmlx-gantt';
+import type { Link, Task } from '../../../types/gantt';
+import { GanttChart } from '../GanttChart';
+import { childIds, flushPromises, makeLink, makeTask } from './ganttTestHarness';
+
+vi.mock('../../../services/api', () => ({
+  reorderTasks: vi.fn(() => Promise.resolve({ success: true })),
+  createObsidianNote: vi.fn(),
+  resolveTaskLink: vi.fn(),
+}));
+
+const callbacks = {
+  onTaskUpdate: vi.fn(() => Promise.resolve(true)),
+  onTaskCreate: vi.fn(() => Promise.resolve(undefined)),
+  onTaskDelete: vi.fn(() => Promise.resolve(true)),
+  onLinkCreate: vi.fn(() => Promise.resolve(undefined)),
+};
+
+function tasksFixture(): Task[] {
+  return [
+    makeTask(1, { text: 'Project', kind_task: 2 }),
+    makeTask(2, { parent: 1, sortorder: 0 }),
+    makeTask(3, { parent: 1, sortorder: 1, progress: 1 }),
+  ];
+}
+
+function chart(tasks: Task[], links: Link[] = [], extraProps: Partial<Parameters<typeof GanttChart>[0]> = {}) {
+  return (
+    <GanttChart
+      tasks={tasks}
+      links={links}
+      timeScale="month"
+      gridWidth={380}
+      obsidianHome=""
+      {...callbacks}
+      {...extraProps}
+    />
+  );
+}
+
+function editTask(id: number, fields: Record<string, unknown>) {
+  Object.assign(gantt.getTask(id), fields);
+  gantt.updateTask(id);
+}
+
+beforeEach(() => {
+  // jsdom には無いブラウザAPI
+  vi.stubGlobal('requestAnimationFrame', (callback: FrameRequestCallback) => setTimeout(() => callback(0), 0));
+  vi.stubGlobal('cancelAnimationFrame', (id: number) => clearTimeout(id));
+});
+
+afterEach(() => {
+  cleanup();
+  vi.clearAllMocks();
+  vi.unstubAllGlobals();
+});
+
+describe('データの表示', () => {
+  it('props のタスクとリンクを gantt に読み込むこと', () => {
+    render(chart(tasksFixture(), [makeLink(10, 2, 3)]));
+
+    expect(childIds(0)).toEqual([1]);
+    expect(childIds(1)).toEqual([2, 3]);
+    expect(gantt.isLinkExists(10)).toBe(true);
+  });
+
+  it('props が変わったら差分だけを gantt に反映すること', () => {
+    const tasks = tasksFixture();
+    const { rerender } = render(chart(tasks));
+    const updateTask = vi.spyOn(gantt, 'updateTask');
+
+    rerender(chart([...tasks.slice(0, 2), { ...tasks[2], text: 'Renamed' }, makeTask(4, { parent: 1, sortorder: 2 })]));
+
+    expect(gantt.getTask(3).text).toBe('Renamed');
+    expect(childIds(1)).toEqual([2, 3, 4]);
+    expect(updateTask.mock.calls.map(([id]) => id)).toEqual([3]);
+    // 同期による変更は保存し直さない
+    expect(callbacks.onTaskUpdate).not.toHaveBeenCalled();
+  });
+
+  it('フィルターに合わないタスクを非表示にし、条件に合う子を持つ親は残すこと', async () => {
+    const filter = { showCompleted: false, showType: 'all' as const, periodMode: 'all' as const, searchText: 'Task 2' };
+    render(chart(tasksFixture(), [], { filter }));
+    await flushPromises();
+
+    const visibleIds: number[] = [];
+    gantt.eachTask((task) => {
+      if (gantt.callEvent('onBeforeTaskDisplay', [task.id, task])) visibleIds.push(Number(task.id));
+    });
+    expect(visibleIds).toEqual([1, 2]);
+  });
+});
+
+describe('gantt の初期化と破棄', () => {
+  it('アンマウントで gantt のデータを消すこと', () => {
+    const { unmount } = render(chart(tasksFixture()));
+
+    unmount();
+
+    expect(gantt.getTaskCount()).toBe(0);
+  });
+
+  it('画面を切り替えて戻っても（再マウントしても）、保存が多重に呼ばれないこと', () => {
+    // ガント画面 ⇔ グリッド画面の行き来に相当。以前は戻るたびにイベントハンドラが増えていた
+    for (let i = 0; i < 3; i++) {
+      render(chart(tasksFixture())).unmount();
+    }
+    render(chart(tasksFixture()));
+
+    editTask(2, { progress: 0.5 });
+    gantt.deleteTask(3);
+
+    expect(callbacks.onTaskUpdate).toHaveBeenCalledTimes(1);
+    expect(callbacks.onTaskDelete).toHaveBeenCalledTimes(1);
+  });
+
+  it('再マウント後も、最新の props のデータが読み込まれること', () => {
+    render(chart(tasksFixture())).unmount();
+
+    render(chart([makeTask(7), makeTask(8, { sortorder: 1 })]));
+
+    expect(childIds(0)).toEqual([7, 8]);
+  });
+
+  it('StrictMode（開発時の二重マウント）でも正しく初期化され、保存が1回だけ呼ばれること', () => {
+    render(<StrictMode>{chart(tasksFixture())}</StrictMode>);
+
+    expect(childIds(1)).toEqual([2, 3]);
+    editTask(2, { progress: 0.5 });
+    expect(callbacks.onTaskUpdate).toHaveBeenCalledTimes(1);
+  });
+});
+
+describe('保存の失敗', () => {
+  it('保存に失敗したタスクは、サーバーの値の表示に戻すこと', async () => {
+    callbacks.onTaskUpdate.mockResolvedValueOnce(false);
+    render(chart(tasksFixture()));
+
+    editTask(2, { text: 'Edit that fails to save' });
+    await flushPromises();
+
+    expect(gantt.getTask(2).text).toBe('Task 2');
+  });
+});
+
+describe('外部からの入力画面オープン要求', () => {
+  it('対象タスクを選択して編集画面を開き、処理済みを通知すること', () => {
+    const showLightbox = vi.spyOn(gantt, 'showLightbox').mockImplementation(() => {});
+    const onExternalOpenHandled = vi.fn();
+
+    render(chart(tasksFixture(), [], {
+      externalOpenTaskRequest: { requestId: 42, taskId: 3, attempt: 1 },
+      onExternalOpenHandled,
+    }));
+
+    expect(showLightbox).toHaveBeenCalledWith(3);
+    expect(gantt.getSelectedTasks().map(Number)).toEqual([3]);
+    expect(onExternalOpenHandled).toHaveBeenCalledWith(42);
+  });
+
+  it('対象タスクがまだ読み込まれていなければ、読み込まれた時点で開くこと', () => {
+    const showLightbox = vi.spyOn(gantt, 'showLightbox').mockImplementation(() => {});
+    const onExternalOpenHandled = vi.fn();
+    const request = { externalOpenTaskRequest: { requestId: 42, taskId: 9, attempt: 1 }, onExternalOpenHandled };
+    const { rerender } = render(chart(tasksFixture(), [], request));
+    expect(onExternalOpenHandled).not.toHaveBeenCalled();
+
+    rerender(chart([...tasksFixture(), makeTask(9, { sortorder: 5 })], [], request));
+
+    expect(showLightbox).toHaveBeenCalledWith(9);
+    expect(onExternalOpenHandled).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/frontend/src/components/GanttChart/__tests__/ganttEvents.test.ts b/frontend/src/components/GanttChart/__tests__/ganttEvents.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..85f3d0cde20d6af38823da26a00bb22f485d3922
--- /dev/null
+++ b/frontend/src/components/GanttChart/__tests__/ganttEvents.test.ts
@@ -0,0 +1,381 @@
+/**
+ * @vitest-environment jsdom
+ * Gantt上の操作をバックエンドへ保存するイベントハンドラ（ganttEvents）のテスト
+ */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { gantt } from 'dhtmlx-gantt';
+import type { Task } from '../../../types/gantt';
+import { formatEditDate } from '../../../constants/gantt';
+import { reorderTasks } from '../../../services/api';
+import { attachGanttEvents, type GanttDataCallbacks, type GanttEventDeps } from '../ganttEvents';
+import { createGanttSyncState, syncGanttData, type GanttSyncState } from '../ganttSync';
+import { childIds, flushPromises, makeLink, makeTask, setupGantt, waitForUndoBatch } from './ganttTestHarness';
+
+vi.mock('../../../services/api', () => ({
+  reorderTasks: vi.fn(() => Promise.resolve({ success: true })),
+}));
+
+let teardown: () => void;
+let detach: () => void;
+let state: GanttSyncState;
+let callbacks: Required<GanttDataCallbacks>;
+let requestSync: ReturnType<typeof vi.fn<() => void>>;
+let serverTasks: Task[];
+
+function attach(overrides: Partial<GanttEventDeps> = {}): () => void {
+  return attachGanttEvents({
+    getCallbacks: () => callbacks,
+    getSyncState: () => state,
+    requestSync,
+    onTaskSelected: () => {},
+    onContextMenu: () => {},
+    ...overrides,
+  });
+}
+
+beforeEach(() => {
+  teardown = setupGantt();
+  state = createGanttSyncState();
+  requestSync = vi.fn<() => void>();
+  callbacks = {
+    onTaskUpdate: vi.fn(() => Promise.resolve(true)),
+    onTaskCreate: vi.fn((task: Partial<Task>) => Promise.resolve(makeTask(task.id ?? 100, task))),
+    onTaskDelete: vi.fn(() => Promise.resolve(true)),
+    onLinkCreate: vi.fn(() => Promise.resolve(makeLink(500, 2, 3))),
+    onLinkUpdate: vi.fn(),
+    onLinkDelete: vi.fn(),
+  };
+  serverTasks = [
+    makeTask(1, { text: 'Project', kind_task: 2 }),
+    makeTask(2, { parent: 1, sortorder: 0 }),
+    makeTask(3, { parent: 1, sortorder: 1 }),
+    makeTask(4, { parent: 1, sortorder: 2 }),
+  ];
+  syncGanttData(serverTasks, [], state);
+  detach = attach();
+});
+
+afterEach(() => {
+  detach();
+  teardown();
+  vi.clearAllMocks();
+});
+
+function editTask(id: number, fields: Record<string, unknown>) {
+  Object.assign(gantt.getTask(id), fields);
+  gantt.updateTask(id);
+}
+
+describe('タスクの更新', () => {
+  it('1回の更新で保存を1回だけ呼び、日付を文字列にした内容を送ること', () => {
+    editTask(2, { progress: 0.5, start_date: new Date(2026, 2, 11), end_date: new Date(2026, 2, 14) });
+
+    expect(callbacks.onTaskUpdate).toHaveBeenCalledTimes(1);
+    expect(callbacks.onTaskUpdate).toHaveBeenCalledWith(2, expect.objectContaining({
+      text: 'Task 2',
+      progress: 0.5,
+      start_date: '2026-03-11 00:00:00',
+      end_date: '2026-03-14 00:00:00',
+      parent: 1,
+      is_pinned: false,
+    }));
+  });
+
+  it('編集日の履歴に今日を1度だけ追記して保存すること', () => {
+    const today = formatEditDate(new Date());
+
+    editTask(2, { edit_date: '2020-1-1' });
+    editTask(2, { memo: 'again' });
+
+    expect(gantt.getTask(2).edit_date).toBe(`2020-1-1,${today}`);
+    expect(callbacks.onTaskUpdate).toHaveBeenLastCalledWith(2, expect.objectContaining({
+      edit_date: `2020-1-1,${today}`,
+    }));
+  });
+
+  it('タスク名の先頭のインデントとアイコンを除き、その他の絵文字は壊さないこと', () => {
+    editTask(2, { text: '\u3000📄 📊 レポート' });
+
+    expect(gantt.getTask(2).text).toBe('📊 レポート');
+    expect(callbacks.onTaskUpdate).toHaveBeenCalledWith(2, expect.objectContaining({ text: '📊 レポート' }));
+  });
+
+  it('保存の応答待ちの間は「保存中」として記録し、完了したら解除して再同期を依頼すること', async () => {
+    editTask(2, { progress: 0.5 });
+    editTask(2, { progress: 0.75 });
+    expect(state.pendingSaves.get(2)).toBe(2);
+
+    await flushPromises();
+
+    expect(state.pendingSaves.has(2)).toBe(false);
+    expect(requestSync).toHaveBeenCalledTimes(2);
+  });
+
+  it('保存に失敗したら、次の同期でサーバーの値に戻ること', async () => {
+    vi.mocked(callbacks.onTaskUpdate).mockResolvedValueOnce(false);
+    requestSync.mockImplementation(() => syncGanttData(serverTasks, [], state));
+
+    editTask(2, { text: 'Edit that fails to save' });
+    await flushPromises();
+
+    expect(gantt.getTask(2).text).toBe('Task 2');
+  });
+});
+
+describe('ハンドラの解除（画面切り替え時の多重登録の防止）', () => {
+  it('解除後は保存を呼ばないこと', () => {
+    detach();
+
+    editTask(2, { progress: 0.5 });
+    gantt.deleteTask(3);
+
+    expect(callbacks.onTaskUpdate).not.toHaveBeenCalled();
+    expect(callbacks.onTaskDelete).not.toHaveBeenCalled();
+  });
+
+  it('登録と解除を繰り返しても、更新・削除・リンク作成がそれぞれ1回だけ保存されること', async () => {
+    // ガント画面とグリッド画面を行き来する（マウントとアンマウントを繰り返す）のに相当
+    for (let i = 0; i < 3; i++) {
+      detach();
+      detach = attach();
+    }
+
+    editTask(2, { progress: 0.5 });
+    gantt.addLink({ id: 'temp-link', source: 2, target: 3, type: '0' });
+    gantt.deleteTask(4);
+    await flushPromises();
+
+    expect(callbacks.onTaskUpdate).toHaveBeenCalledTimes(1);
+    expect(callbacks.onLinkCreate).toHaveBeenCalledTimes(1);
+    expect(callbacks.onTaskDelete).toHaveBeenCalledTimes(1);
+  });
+});
+
+describe('タスクの削除', () => {
+  it('削除をバックエンドへ伝え、応答待ちの間は「削除中」として記録すること', async () => {
+    gantt.deleteTask(3);
+
+    expect(callbacks.onTaskDelete).toHaveBeenCalledWith(3);
+    expect(state.pendingDeletes.has(3)).toBe(true);
+
+    await flushPromises();
+    expect(requestSync).toHaveBeenCalled();
+  });
+
+  it('削除に失敗したら、次の同期でタスクが復元されること', async () => {
+    vi.mocked(callbacks.onTaskDelete).mockResolvedValueOnce(false);
+    requestSync.mockImplementation(() => syncGanttData(serverTasks, [], state));
+
+    gantt.deleteTask(3);
+    expect(gantt.isTaskExists(3)).toBe(false);
+    await flushPromises();
+
+    expect(childIds(1)).toEqual([2, 3, 4]);
+  });
+
+  it('同期処理による削除ではバックエンドを呼ばないこと', () => {
+    syncGanttData(serverTasks.filter((task) => task.id !== 3), [], state);
+
+    expect(gantt.isTaskExists(3)).toBe(false);
+    expect(callbacks.onTaskDelete).not.toHaveBeenCalled();
+  });
+});
+
+describe('Undo/Redo', () => {
+  it('更新のUndoは、元の値を1回だけ保存すること', async () => {
+    editTask(2, { progress: 0.5 });
+    await waitForUndoBatch();
+    vi.mocked(callbacks.onTaskUpdate).mockClear();
+
+    gantt.undo();
+
+    expect(gantt.getTask(2).progress).toBe(0);
+    expect(callbacks.onTaskUpdate).toHaveBeenCalledTimes(1);
+    expect(callbacks.onTaskUpdate).toHaveBeenCalledWith(2, expect.objectContaining({ progress: 0 }));
+  });
+
+  it('削除のUndoで復活したタスクを、同じIDのままバックエンドに作り直すこと', async () => {
+    gantt.deleteTask(3);
+    await waitForUndoBatch();
+
+    gantt.undo();
+    expect(gantt.isTaskExists(3)).toBe(true);
+    expect(state.pendingTaskAdds.has('3')).toBe(true);
+    await flushPromises();
+
+    expect(callbacks.onTaskCreate).toHaveBeenCalledTimes(1);
+    expect(callbacks.onTaskCreate).toHaveBeenCalledWith(expect.objectContaining({
+      id: 3,
+      text: 'Task 3',
+      parent: 1,
+      start_date: '2026-03-10 00:00:00',
+    }));
+    expect(state.pendingDeletes.has(3)).toBe(false);
+  });
+
+  it('作り直した直後に古い一覧で同期されても、復活したタスクを消さないこと', async () => {
+    // 作成APIの応答直後は、画面側のデータ（React の state）がまだ古いことがある
+    const staleTasks = serverTasks.filter((task) => task.id !== 3);
+    requestSync.mockImplementation(() => syncGanttData(staleTasks, [], state));
+    gantt.deleteTask(3);
+    await waitForUndoBatch();
+    await flushPromises();
+
+    gantt.undo();
+    await flushPromises();
+
+    expect(callbacks.onTaskCreate).toHaveBeenCalledTimes(1);
+    expect(gantt.isTaskExists(3)).toBe(true);
+
+    syncGanttData(serverTasks, [], state);
+    expect(state.pendingTaskAdds.size).toBe(0);
+  });
+
+  it('作り直しに失敗したら、復活したタスクを取り除くこと', async () => {
+    const staleTasks = serverTasks.filter((task) => task.id !== 3);
+    requestSync.mockImplementation(() => syncGanttData(staleTasks, [], state));
+    vi.mocked(callbacks.onTaskCreate).mockResolvedValueOnce(undefined);
+    gantt.deleteTask(3);
+    await waitForUndoBatch();
+    await flushPromises();
+
+    gantt.undo();
+    await flushPromises();
+
+    expect(gantt.isTaskExists(3)).toBe(false);
+  });
+
+  it('プロジェクトの削除をUndoしたら、子タスクもまとめて作り直すこと', async () => {
+    gantt.deleteTask(1);
+    await waitForUndoBatch();
+
+    gantt.undo();
+    await flushPromises();
+
+    const recreatedIds = vi.mocked(callbacks.onTaskCreate).mock.calls.map(([task]) => task.id);
+    expect(recreatedIds.sort()).toEqual([1, 2, 3, 4]);
+  });
+
+  it('削除の応答が返る前にUndoしても、削除の完了を待ってから作り直すこと', async () => {
+    const order: string[] = [];
+    let finishDelete: (deleted: boolean) => void = () => {};
+    vi.mocked(callbacks.onTaskDelete).mockImplementationOnce(() => new Promise<boolean>((resolve) => {
+      finishDelete = (deleted) => {
+        order.push('delete finished');
+        resolve(deleted);
+      };
+    }));
+    vi.mocked(callbacks.onTaskCreate).mockImplementationOnce((task) => {
+      order.push('create started');
+      return Promise.resolve(makeTask(task.id ?? 0, task));
+    });
+
+    gantt.deleteTask(3);
+    await waitForUndoBatch();
+    gantt.undo();
+    await flushPromises();
+    expect(callbacks.onTaskCreate).not.toHaveBeenCalled();
+
+    finishDelete(true);
+    await flushPromises();
+
+    expect(order).toEqual(['delete finished', 'create started']);
+  });
+
+  it('追加のUndoは削除として保存し、Redoで作り直すこと', async () => {
+    gantt.addTask({ id: 9, text: 'Added', start_date: new Date(2026, 2, 10), duration: 1, parent: 1 }, 1);
+    await waitForUndoBatch();
+
+    gantt.undo();
+    expect(callbacks.onTaskDelete).toHaveBeenCalledWith(9);
+    await flushPromises();
+
+    gantt.redo();
+    await flushPromises();
+    expect(callbacks.onTaskCreate).toHaveBeenCalledWith(expect.objectContaining({ id: 9, text: 'Added' }));
+  });
+});
+
+describe('リンク', () => {
+  it('作成したリンクをバックエンドに保存し、採番されたIDへ付け替えること', async () => {
+    gantt.addLink({ id: 'temp-link', source: 2, target: 3, type: '0' });
+    expect(state.pendingLinkAdds.has('temp-link')).toBe(true);
+
+    await flushPromises();
+
+    expect(callbacks.onLinkCreate).toHaveBeenCalledWith({ source: 2, target: 3, type: 0 });
+    expect(gantt.isLinkExists(500)).toBe(true);
+    expect(gantt.isLinkExists('temp-link')).toBe(false);
+  });
+
+  it('作成直後に古い一覧で同期されてもリンクを消さず、作成に失敗したら取り除くこと', async () => {
+    requestSync.mockImplementation(() => syncGanttData(serverTasks, [], state));
+
+    gantt.addLink({ id: 'temp-link', source: 2, target: 3, type: '0' });
+    await flushPromises();
+    expect(gantt.isLinkExists(500)).toBe(true);
+
+    vi.mocked(callbacks.onLinkCreate).mockResolvedValueOnce(undefined);
+    gantt.addLink({ id: 'temp-link-2', source: 3, target: 4, type: '0' });
+    await flushPromises();
+    expect(gantt.isLinkExists('temp-link-2')).toBe(false);
+  });
+
+  it('更新と削除をバックエンドへ伝えること', () => {
+    syncGanttData(serverTasks, [makeLink(10, 2, 3)], state);
+
+    gantt.getLink(10).target = 4;
+    gantt.updateLink(10);
+    gantt.deleteLink(10);
+
+    expect(callbacks.onLinkUpdate).toHaveBeenCalledWith(10, { source: 2, target: 4, type: 0 });
+    expect(callbacks.onLinkDelete).toHaveBeenCalledWith(10);
+  });
+
+  it('同期処理によるリンクの追加・削除ではバックエンドを呼ばないこと', () => {
+    syncGanttData(serverTasks, [makeLink(10, 2, 3)], state);
+    gantt.render();
+    syncGanttData(serverTasks, [], state);
+
+    expect(callbacks.onLinkCreate).not.toHaveBeenCalled();
+    expect(callbacks.onLinkDelete).not.toHaveBeenCalled();
+  });
+});
+
+describe('並び替え', () => {
+  it('移動先の親に属する全タスクの並び順をまとめて保存すること', () => {
+    gantt.moveTask(4, 0, 1);
+
+    expect(childIds(1)).toEqual([4, 2, 3]);
+    expect(reorderTasks).toHaveBeenCalledWith({
+      items: [
+        { id: 4, sortorder: 0, parent: 1 },
+        { id: 2, sortorder: 1, parent: 1 },
+        { id: 3, sortorder: 2, parent: 1 },
+      ],
+    });
+  });
+});
+
+describe('画面側への通知', () => {
+  it('タスクの選択と右クリックを通知すること', () => {
+    detach();
+    const onTaskSelected = vi.fn();
+    const onContextMenu = vi.fn();
+    detach = attach({ onTaskSelected, onContextMenu });
+    const event = new MouseEvent('contextmenu', { cancelable: true });
+
+    gantt.selectTask(2);
+    gantt.callEvent('onContextMenu', [2, null, event]);
+
+    expect(onTaskSelected).toHaveBeenCalledWith(2);
+    expect(onContextMenu).toHaveBeenCalledWith(2, event);
+    expect(event.defaultPrevented).toBe(true);
+  });
+
+  it('Lightboxを開く前に階層パスをタスクへ設定すること', () => {
+    gantt.callEvent('onBeforeLightbox', [3]);
+
+    expect(gantt.getTask(3).hierarchy_path).toBe('[1]Project &gt; [3]Task 3');
+  });
+});
diff --git a/frontend/src/components/GanttChart/__tests__/ganttSync.test.ts b/frontend/src/components/GanttChart/__tests__/ganttSync.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4af495336b1a3b03d645e14e3d33ca0468d43849
--- /dev/null
+++ b/frontend/src/components/GanttChart/__tests__/ganttSync.test.ts
@@ -0,0 +1,343 @@
+/**
+ * @vitest-environment jsdom
+ * サーバーのデータを gantt へ差分反映する処理（ganttSync）のテスト
+ */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { gantt } from 'dhtmlx-gantt';
+import type { Link, Task } from '../../../types/gantt';
+import {
+  confirmPendingAdd,
+  createGanttSyncState,
+  protectPendingAdd,
+  syncGanttData,
+  type GanttSyncState,
+} from '../ganttSync';
+import { childIds, makeLink, makeTask, setupGantt, waitForUndoBatch } from './ganttTestHarness';
+
+let teardown: () => void;
+let state: GanttSyncState;
+
+/** プロジェクト(1) の下に タスク 2, 3, 4 が並ぶ初期データ */
+function initialTasks(): Task[] {
+  return [
+    makeTask(1, { text: 'Project', kind_task: 2 }),
+    makeTask(2, { parent: 1, sortorder: 0 }),
+    makeTask(3, { parent: 1, sortorder: 1 }),
+    makeTask(4, { parent: 1, sortorder: 2 }),
+  ];
+}
+
+function replaceTask(tasks: Task[], id: number, changes: Partial<Task>): Task[] {
+  return tasks.map((task) => (task.id === id ? { ...task, ...changes } : task));
+}
+
+function sync(tasks: Task[], links: Link[] = []): boolean {
+  return syncGanttData(tasks, links, state);
+}
+
+beforeEach(() => {
+  teardown = setupGantt();
+  state = createGanttSyncState();
+});
+
+afterEach(() => {
+  teardown();
+  vi.restoreAllMocks();
+});
+
+describe('初回ロード', () => {
+  it('階層と並び順を保って読み込み、すべて開いた状態にすること', () => {
+    const changed = sync(initialTasks(), [makeLink(10, 2, 3)]);
+
+    expect(changed).toBe(true);
+    expect(childIds(0)).toEqual([1]);
+    expect(childIds(1)).toEqual([2, 3, 4]);
+    expect(gantt.getTask(1).$open).toBe(true);
+    expect(gantt.getTask(2).start_date).toEqual(new Date(2026, 2, 10));
+    expect(gantt.getLinks().map((link) => [link.id, link.source, link.target, link.type])).toEqual([
+      [10, 2, 3, '0'],
+    ]);
+  });
+
+  it('データが空なら何もしないこと', () => {
+    expect(sync([])).toBe(false);
+    expect(gantt.getTaskCount()).toBe(0);
+  });
+});
+
+describe('差分反映', () => {
+  it('内容が変わっていなければ gantt に触れないこと', () => {
+    sync(initialTasks());
+    const updateTask = vi.spyOn(gantt, 'updateTask');
+
+    // 再取得で配列やオブジェクトが作り直されても、内容が同じなら変更なしと判定する
+    const changed = sync(initialTasks());
+
+    expect(changed).toBe(false);
+    expect(updateTask).not.toHaveBeenCalled();
+  });
+
+  it('サーバー側で変わったタスクだけを更新し、開閉状態は保つこと', () => {
+    const tasks = initialTasks();
+    sync(tasks);
+    gantt.close(1);
+    const updateTask = vi.spyOn(gantt, 'updateTask');
+
+    const changed = sync(replaceTask(replaceTask(tasks, 1, { text: 'Renamed' }), 3, { progress: 0.5 }));
+
+    expect(changed).toBe(true);
+    expect(updateTask.mock.calls.map(([id]) => id)).toEqual([1, 3]);
+    expect(gantt.getTask(1).text).toBe('Renamed');
+    expect(gantt.getTask(1).$open).toBe(false);
+    expect(gantt.getTask(3).progress).toBe(0.5);
+  });
+
+  it('画面上で編集済みで応答待ちのタスクを、古い再取得結果で巻き戻さないこと', () => {
+    const tasks = initialTasks();
+    sync(tasks);
+    gantt.getTask(2).text = 'Edited locally';
+
+    // 保存の応答が届く前に、別の要因（ポーリング等）で編集前のデータが届いた
+    sync(initialTasks());
+
+    expect(gantt.getTask(2).text).toBe('Edited locally');
+  });
+
+  it('保存中のタスクはサーバーの値で上書きせず、保存完了後に反映すること', () => {
+    const tasks = initialTasks();
+    sync(tasks);
+    gantt.getTask(2).text = 'Second edit';
+    state.pendingSaves.set(2, 1);
+    const firstSaveResponse = replaceTask(tasks, 2, { text: 'First edit' });
+
+    sync(firstSaveResponse);
+    expect(gantt.getTask(2).text).toBe('Second edit');
+
+    state.pendingSaves.delete(2);
+    sync(replaceTask(tasks, 2, { text: 'Second edit', edit_date: '2026-03-18' }));
+    expect(gantt.getTask(2).edit_date).toBe('2026-03-18');
+  });
+
+  it('保存に失敗したタスク（前回反映の記録を消したもの）は、サーバーの値へ戻すこと', () => {
+    const tasks = initialTasks();
+    sync(tasks);
+    gantt.getTask(2).text = 'Edit that failed to save';
+
+    state.lastSynced.delete(2);
+    const changed = sync(tasks);
+
+    expect(changed).toBe(true);
+    expect(gantt.getTask(2).text).toBe('Task 2');
+  });
+});
+
+describe('タスクの追加と削除', () => {
+  it('サーバーから消えたタスクを、削除APIを呼ばせずに gantt から取り除くこと', () => {
+    const tasks = initialTasks();
+    sync(tasks);
+    const syncingFlagsDuringDelete: boolean[] = [];
+    const eventId = gantt.attachEvent('onBeforeTaskDelete', () => {
+      syncingFlagsDuringDelete.push(state.isSyncing);
+      return true;
+    });
+
+    sync(tasks.filter((task) => task.id !== 3));
+    gantt.detachEvent(eventId);
+
+    expect(childIds(1)).toEqual([2, 4]);
+    // イベント自体を抑止しているか、発火しても同期中と分かる状態であること
+    expect(syncingFlagsDuringDelete.every(Boolean)).toBe(true);
+    expect(state.isSyncing).toBe(false);
+  });
+
+  it('他の画面で追加されたタスクを、並び順どおりの位置に挿入すること', () => {
+    const tasks = initialTasks();
+    sync(tasks);
+
+    // タスク2を複製 → 直後に 5 が入り、後続の並び順が1つずつ繰り下がる
+    sync([
+      tasks[0],
+      tasks[1],
+      makeTask(5, { parent: 1, sortorder: 1 }),
+      { ...tasks[2], sortorder: 2 },
+      { ...tasks[3], sortorder: 3 },
+    ]);
+
+    expect(childIds(1)).toEqual([2, 5, 3, 4]);
+    expect(gantt.getTask(3).sortorder).toBe(2);
+  });
+
+  it('画面上で削除して応答待ちのタスクと、その子孫を復活させないこと', () => {
+    const tasks = initialTasks();
+    sync(tasks);
+    gantt.silent(() => gantt.deleteTask(1));
+    state.pendingDeletes.add(1);
+
+    sync(tasks);
+
+    expect(gantt.getTaskCount()).toBe(0);
+  });
+
+  it('削除が完了したら応答待ちの記録を消し、削除に失敗した場合は復元すること', () => {
+    const tasks = initialTasks();
+    sync(tasks);
+    gantt.silent(() => gantt.deleteTask(4));
+    state.pendingDeletes.add(4);
+
+    sync(tasks.filter((task) => task.id !== 4));
+    expect(state.pendingDeletes.has(4)).toBe(false);
+
+    // 別のタスクの削除に失敗した場合: 呼び出し側が応答待ちから外すと、次の同期で復元される
+    gantt.silent(() => gantt.deleteTask(3));
+    sync(tasks.filter((task) => task.id !== 4));
+    expect(childIds(1)).toEqual([2, 3]);
+  });
+
+  it('追加したタスクが行として表示され、gantt内部の件数とも一致すること', () => {
+    // silent で追加すると DHTMLX の並び順キャッシュが更新されず、行が表示されない不具合があった
+    const tasks = initialTasks();
+    sync(tasks);
+
+    sync([...tasks, makeTask(5, { kind_task: 2, sortorder: 1 }), makeTask(6, { parent: 5 })]);
+    gantt.render();
+
+    expect(gantt.getTaskCount()).toBe(6);
+    expect(gantt.getGlobalTaskIndex(6)).toBe(5);
+    expect(gantt.getTaskByIndex(5).id).toBe(6);
+  });
+
+  it('子が親より先に並んだデータでも、親から順に追加すること', () => {
+    sync(initialTasks());
+
+    // 並びは (親ID, 並び順) の昇順。親(20)のIDが子の親ID(20)より後ろの行に来る
+    sync([...initialTasks(), makeTask(21, { parent: 20 }), makeTask(20, { parent: 30 }), makeTask(30, { sortorder: 9 })]);
+
+    expect(childIds(0)).toEqual([1, 30]);
+    expect(childIds(30)).toEqual([20]);
+    expect(childIds(20)).toEqual([21]);
+  });
+
+  it('大量のタスクが一度に増えた場合は全体を読み込み直し、閉じていたプロジェクトは閉じたままにすること', () => {
+    const tasks = initialTasks();
+    sync(tasks);
+    gantt.close(1);
+    const imported = Array.from({ length: 60 }, (_, index) => makeTask(100 + index, { sortorder: index + 1 }));
+
+    const changed = sync([...tasks, ...imported]);
+
+    expect(changed).toBe(true);
+    expect(gantt.getTaskCount()).toBe(64);
+    expect(gantt.getTask(1).$open).toBe(false);
+    expect(sync([...tasks, ...imported])).toBe(false);
+  });
+
+  describe('作成APIの応答待ちで gantt 上にだけあるタスク（Undoでの復活）', () => {
+    function restoreLocally(tasks: Task[]) {
+      sync(tasks);
+      gantt.silent(() => gantt.deleteTask(4));
+      sync(tasks.filter((task) => task.id !== 4));
+      gantt.addTask({ id: 4, text: 'Restored by undo', start_date: new Date(2026, 2, 10), duration: 1 }, 1);
+    }
+
+    it('応答待ちの間は消さないこと', () => {
+      const tasks = initialTasks();
+      restoreLocally(tasks);
+      protectPendingAdd(state.pendingTaskAdds, 4);
+
+      sync(tasks.filter((task) => task.id !== 4));
+
+      expect(gantt.isTaskExists(4)).toBe(true);
+    });
+
+    it('作成に成功した直後、まだ古いデータで同期されても消さないこと', () => {
+      const tasks = initialTasks();
+      restoreLocally(tasks);
+      protectPendingAdd(state.pendingTaskAdds, 4);
+      confirmPendingAdd(state.pendingTaskAdds, 4);
+
+      // 作成後の再取得結果が画面に届く前の、古い一覧（タスク4を含まない）での同期
+      sync(tasks.filter((task) => task.id !== 4));
+      expect(gantt.isTaskExists(4)).toBe(true);
+
+      // 新しい一覧が届いたら保護を解除する
+      sync(tasks);
+      expect(state.pendingTaskAdds.size).toBe(0);
+      expect(gantt.getTask(4).text).toBe('Task 4');
+    });
+
+    it('作成に成功してもサーバーの一覧に現れないままなら、一定時間後に保護を解除して消すこと', () => {
+      vi.useFakeTimers();
+      try {
+        const tasks = initialTasks();
+        restoreLocally(tasks);
+        confirmPendingAdd(state.pendingTaskAdds, 4);
+
+        vi.advanceTimersByTime(11_000);
+        sync(tasks.filter((task) => task.id !== 4));
+
+        expect(gantt.isTaskExists(4)).toBe(false);
+      } finally {
+        vi.useRealTimers();
+      }
+    });
+
+    it('作成に失敗して保護が外されたら、次の同期で消すこと', () => {
+      const tasks = initialTasks();
+      restoreLocally(tasks);
+
+      sync(tasks.filter((task) => task.id !== 4));
+
+      expect(gantt.isTaskExists(4)).toBe(false);
+    });
+  });
+});
+
+describe('リンク', () => {
+  it('追加・変更・削除を反映し、変更が無ければ触れないこと', () => {
+    const tasks = initialTasks();
+    sync(tasks, [makeLink(10, 2, 3), makeLink(11, 3, 4)]);
+
+    expect(sync(tasks, [makeLink(10, 2, 3), makeLink(11, 3, 4)])).toBe(false);
+
+    const changed = sync(tasks, [makeLink(10, 2, 4, 1), makeLink(12, 2, 3)]);
+
+    expect(changed).toBe(true);
+    gantt.render(); // 変更があった場合、呼び出し側（GanttChart）が再描画する。リンク一覧はそこで更新される
+    const links = gantt.getLinks().map((link) => [Number(link.id), Number(link.source), Number(link.target), String(link.type)]);
+    expect(links.sort()).toEqual([[10, 2, 4, '1'], [12, 2, 3, '0']]);
+  });
+
+  it('作成APIの応答待ちのリンクを消さないこと', () => {
+    const tasks = initialTasks();
+    sync(tasks);
+    gantt.silent(() => gantt.addLink({ id: 'temp-1', source: 2, target: 3, type: '0' }));
+    protectPendingAdd(state.pendingLinkAdds, 'temp-1');
+
+    sync(tasks);
+
+    expect(gantt.isLinkExists('temp-1')).toBe(true);
+  });
+});
+
+describe('Undo/Redoの履歴', () => {
+  it('同期による変更を履歴に積まず、ユーザー操作の履歴を保つこと', async () => {
+    const tasks = initialTasks();
+    sync(tasks);
+    gantt.getTask(2).text = 'User edit';
+    gantt.updateTask(2);
+    await waitForUndoBatch();
+    const undoStackBefore = gantt.getUndoStack().length;
+    expect(undoStackBefore).toBeGreaterThan(0);
+
+    sync([
+      ...replaceTask(tasks, 3, { text: 'Changed elsewhere' }).filter((task) => task.id !== 4),
+      makeTask(5, { parent: 1, sortorder: 5 }),
+    ]);
+    await waitForUndoBatch();
+
+    expect(gantt.getUndoStack()).toHaveLength(undoStackBefore);
+    gantt.undo();
+    expect(gantt.getTask(2).text).toBe('Task 2');
+    expect(gantt.getTask(3).text).toBe('Changed elsewhere');
+  });
+});
diff --git a/frontend/src/components/GanttChart/__tests__/ganttTemplates.test.ts b/frontend/src/components/GanttChart/__tests__/ganttTemplates.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b5d4ad492de6232faf09ddc3b8045438f3a72ef1
--- /dev/null
+++ b/frontend/src/components/GanttChart/__tests__/ganttTemplates.test.ts
@@ -0,0 +1,190 @@
+/**
+ * @vitest-environment jsdom
+ * ガントチャートの表示テンプレート（ganttTemplates）のテスト
+ */
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { gantt } from 'dhtmlx-gantt';
+import type { Task as GanttTask } from 'dhtmlx-gantt';
+import type { BusinessTripType } from '../../../types/gantt';
+import { applyStaticTemplates, applyTaskBarTemplates, buildScheduleHtml } from '../ganttTemplates';
+import { createGanttSyncState, syncGanttData } from '../ganttSync';
+import { makeTask, setupGantt } from './ganttTestHarness';
+
+let teardown: () => void;
+const START = new Date(2026, 2, 10);
+const END = new Date(2026, 2, 13);
+
+function render(html: string): HTMLElement {
+  const wrapper = document.createElement('div');
+  wrapper.innerHTML = html;
+  return wrapper;
+}
+
+function barText(task: GanttTask): string {
+  return gantt.templates.task_text(START, END, task);
+}
+
+function rightsideText(task: GanttTask): string {
+  return gantt.templates.rightside_text(START, END, task);
+}
+
+beforeEach(() => {
+  teardown = setupGantt();
+  syncGanttData(
+    [
+      makeTask(1, { text: 'Project <A&B>', kind_task: 2 }),
+      makeTask(2, { text: 'Task "quoted" <b>bold</b>', parent: 1, hyperlink: '/vault/a "b".md' }),
+      makeTask(3, { text: 'Milestone', parent: 1, kind_task: 3 }),
+      makeTask(4, { text: 'Root task' }),
+    ],
+    [],
+    createGanttSyncState(),
+  );
+  applyTaskBarTemplates(false);
+});
+
+afterEach(() => {
+  teardown();
+});
+
+describe('タスクバー内のテキスト', () => {
+  it('プロジェクトは "[id]名前" を表示し、名前はHTMLとして解釈させないこと', () => {
+    const label = render(barText(gantt.getTask(1))).querySelector('span');
+
+    expect(label?.textContent).toBe('[1]Project <A&B>');
+    expect(label?.children).toHaveLength(0);
+  });
+
+  it('タスクとマイルストーンはバー内にラベルを出さないこと', () => {
+    expect(barText(gantt.getTask(2))).toBe('');
+    expect(barText(gantt.getTask(3))).toBe('');
+  });
+
+  it('ハイパーリンク付きプロジェクトは、リンク先を属性に持つリンクとして表示すること', () => {
+    const task = gantt.getTask(1);
+    task.hyperlink = 'https://example.com/?a=1&b="2"';
+
+    const link = render(barText(task)).querySelector('a');
+
+    expect(link?.dataset.taskId).toBe('1');
+    expect(link?.dataset.hyperlink).toBe('https://example.com/?a=1&b="2"');
+    expect(link?.textContent).toBe('[1]Project <A&B>');
+  });
+});
+
+describe('バー右側のテキスト', () => {
+  it('タスクは "[id] 名前 > [親id] 親の名前" を、エスケープして表示すること', () => {
+    const wrapper = render(rightsideText(gantt.getTask(2)));
+    const link = wrapper.querySelector('a');
+
+    expect(wrapper.textContent).toBe('[2] Task "quoted" <b>bold</b> > [1] Project <A&B>');
+    expect(wrapper.querySelector('b')).toBeNull();
+    expect(link?.dataset.hyperlink).toBe('/vault/a "b".md');
+  });
+
+  it('親のないタスクは自分の名前だけ、プロジェクトは何も表示しないこと', () => {
+    expect(rightsideText(gantt.getTask(4))).toBe('[4] Root task');
+    expect(rightsideText(gantt.getTask(1))).toBe('');
+  });
+});
+
+describe('印刷モード', () => {
+  it('バー内を空にし、右側にタスク名だけを表示すること', () => {
+    applyTaskBarTemplates(true);
+
+    expect(barText(gantt.getTask(1))).toBe('');
+    expect(render(rightsideText(gantt.getTask(1))).textContent).toBe('Project <A&B>');
+  });
+
+  it('通常モードに戻すと元の表示に戻ること', () => {
+    applyTaskBarTemplates(true);
+    applyTaskBarTemplates(false);
+
+    expect(rightsideText(gantt.getTask(4))).toBe('[4] Root task');
+  });
+});
+
+describe('スケジュールのピン', () => {
+  it('スケジュール1件につきピンを1つ描き、操作用の情報を属性に持たせること', () => {
+    const task = gantt.getTask(2);
+    task.task_schedule = '2026-03-11 打合せ <重要>\n不正な行\n2026-03-12 00:00:00 レビュー';
+
+    const pins = render(buildScheduleHtml(task)).querySelectorAll<HTMLElement>('.gantt-schedule-event');
+
+    expect(pins).toHaveLength(2);
+    expect(pins[0].dataset).toMatchObject({
+      taskId: '2',
+      scheduleIndex: '0',
+      scheduleDate: '2026-03-11',
+      scheduleText: '打合せ <重要>',
+    });
+    expect(pins[0].querySelector('.gantt-schedule-tooltip')?.textContent).toBe('2026-03-11 打合せ <重要>');
+    // ツールチップには時刻を出さない
+    expect(pins[1].querySelector('.gantt-schedule-tooltip')?.textContent).toBe('2026-03-12 レビュー');
+  });
+
+  it('スケジュールが無ければ何も描かないこと', () => {
+    expect(buildScheduleHtml(gantt.getTask(4))).toBe('');
+  });
+});
+
+describe('行・セルのクラス', () => {
+  const holidays = new Set<string>();
+  const trips = new Map<string, BusinessTripType>();
+  let focusTaskId: number | null = null;
+
+  beforeEach(() => {
+    holidays.clear();
+    trips.clear();
+    focusTaskId = null;
+    applyStaticTemplates({
+      getHolidays: () => holidays,
+      getBusinessTrips: () => trips,
+      getKeyboardFocusTaskId: () => focusTaskId,
+    });
+  });
+
+  function cellClass(date: Date): string {
+    return gantt.templates.timeline_cell_class(gantt.getTask(4), date);
+  }
+
+  it('土日と登録済みの休日を休日色にすること', () => {
+    holidays.add('2026-03-11');
+
+    expect(cellClass(new Date(2026, 2, 14))).toBe('weekend'); // 土曜
+    expect(cellClass(new Date(2026, 2, 15))).toBe('weekend'); // 日曜
+    expect(cellClass(new Date(2026, 2, 11))).toBe('weekend'); // 登録した休日（水曜）
+    expect(cellClass(new Date(2026, 2, 12))).toBe('');
+  });
+
+  it('出張日は休日より優先して出張の色にすること', () => {
+    holidays.add('2026-03-11');
+    trips.set('2026-03-11', 'normal_trip');
+    trips.set('2026-03-14', 'day_trip');
+
+    expect(cellClass(new Date(2026, 2, 11))).toBe('business-trip-normal');
+    expect(cellClass(new Date(2026, 2, 14))).toBe('business-trip-day');
+  });
+
+  it('種別と固定状態をバーのクラスにすること', () => {
+    const pinned = gantt.getTask(4);
+    pinned.is_pinned = true;
+
+    expect(gantt.templates.task_class(START, END, gantt.getTask(1))).toBe('pro');
+    expect(gantt.templates.task_class(START, END, gantt.getTask(3))).toBe('ms');
+    expect(gantt.templates.task_class(START, END, pinned)).toBe('task pinned-task');
+  });
+
+  it('キーボードでフォーカス中の行だけを強調すること', () => {
+    focusTaskId = 2;
+
+    expect(gantt.templates.grid_row_class(START, END, gantt.getTask(2))).toBe('keyboard-focus-row');
+    expect(gantt.templates.task_row_class(START, END, gantt.getTask(3))).toBe('');
+  });
+
+  it('ツリーのアイコンを種類とリンク先に応じて切り替えること', () => {
+    expect(gantt.templates.grid_folder(gantt.getTask(1))).toContain('/icons/catppuccin/folder_project_open.svg');
+    expect(gantt.templates.grid_file(gantt.getTask(2))).toContain('/icons/catppuccin/markdown.svg');
+    expect(gantt.templates.grid_file(gantt.getTask(4))).toContain('/icons/catppuccin/file.svg');
+  });
+});
diff --git a/frontend/src/components/GanttChart/__tests__/ganttTestHarness.ts b/frontend/src/components/GanttChart/__tests__/ganttTestHarness.ts
new file mode 100644
index 0000000000000000000000000000000000000000..34898c5645a947e8863cbc8116f00834cd2fd764
--- /dev/null
+++ b/frontend/src/components/GanttChart/__tests__/ganttTestHarness.ts
@@ -0,0 +1,59 @@
+/**
+ * Gantt関連テストの共通ヘルパー
+ * モックではなく実物の DHTMLX Gantt を jsdom 上で初期化して使う
+ * （gantt はシングルトンなので、テストごとに必ず teardown でデータを消す）。
+ */
+import { gantt } from 'dhtmlx-gantt';
+import type { Link, Task } from '../../../types/gantt';
+
+export function setupGantt(): () => void {
+  const container = document.createElement('div');
+  document.body.appendChild(container);
+
+  gantt.plugins({ undo: true, marker: true, multiselect: true });
+  gantt.config.undo = true;
+  gantt.init(container);
+
+  return () => {
+    gantt.clearAll();
+    gantt.clearUndoStack?.();
+    gantt.clearRedoStack?.();
+    container.remove();
+  };
+}
+
+export function makeTask(id: number, overrides: Partial<Task> = {}): Task {
+  return {
+    id,
+    text: `Task ${id}`,
+    start_date: '2026-03-10 00:00:00',
+    end_date: '2026-03-13 00:00:00',
+    duration: 3,
+    progress: 0,
+    parent: 0,
+    kind_task: 1,
+    owner_id: 0,
+    sortorder: 0,
+    is_pinned: false,
+    ...overrides,
+  };
+}
+
+export function makeLink(id: number, source: number, target: number, type: Link['type'] = 0): Link {
+  return { id, source, target, type };
+}
+
+/** 保留中の Promise（APIモックの応答処理など）を消化する */
+export function flushPromises(): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, 0));
+}
+
+/** DHTMLXのUndoプラグインは、操作を約10ms分まとめてから履歴に積む。それを待つ */
+export function waitForUndoBatch(): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, 30));
+}
+
+/** gantt上の、指定した親の子タスクIDを表示順で返す */
+export function childIds(parentId: number | string = 0): number[] {
+  return gantt.getChildren(parentId).map(Number);
+}
diff --git a/frontend/src/components/GanttChart/__tests__/useGanttKeyboard.test.ts b/frontend/src/components/GanttChart/__tests__/useGanttKeyboard.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9aa322ffb2f6b9506ccd970602508b01aa5e60b5
--- /dev/null
+++ b/frontend/src/components/GanttChart/__tests__/useGanttKeyboard.test.ts
@@ -0,0 +1,319 @@
+/**
+ * @vitest-environment jsdom
+ * ガントチャートのキーボードショートカット（useGanttKeyboard）のテスト
+ */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { cleanup, renderHook } from '@testing-library/react';
+import { gantt } from 'dhtmlx-gantt';
+import {
+  handleLightboxKeyDown,
+  useGanttKeyboard,
+  type GanttKeyboardActions,
+  type KeyboardCursor,
+} from '../useGanttKeyboard';
+import { createGanttSyncState, syncGanttData } from '../ganttSync';
+import { flushPromises, makeTask, setupGantt } from './ganttTestHarness';
+
+function pressKey(key: string, init: KeyboardEventInit = {}): KeyboardEvent {
+  const event = new KeyboardEvent('keydown', { key, bubbles: true, cancelable: true, ...init });
+  (document.activeElement ?? document.body).dispatchEvent(event);
+  return event;
+}
+
+describe('Lightbox表示中のキー操作', () => {
+  let saveClicked: number;
+
+  beforeEach(() => {
+    saveClicked = 0;
+    document.body.innerHTML = `
+      <div class="gantt_cal_light">
+        <textarea id="name"></textarea>
+        <textarea id="memo"></textarea>
+        <textarea id="schedule"></textarea>
+      </div>
+      <div class="gantt_btn_set gantt_save_btn_set"></div>
+    `;
+    document.querySelector('.gantt_save_btn_set')?.addEventListener('click', () => {
+      saveClicked++;
+    });
+  });
+
+  afterEach(() => {
+    document.body.innerHTML = '';
+  });
+
+  function keydown(init: KeyboardEventInit): KeyboardEvent {
+    const event = new KeyboardEvent('keydown', { cancelable: true, ...init });
+    vi.spyOn(event, 'stopPropagation');
+    handleLightboxKeyDown(event);
+    return event;
+  }
+
+  it('Enter で保存すること', () => {
+    const event = keydown({ key: 'Enter' });
+
+    expect(saveClicked).toBe(1);
+    expect(event.defaultPrevented).toBe(true);
+    expect(event.stopPropagation).toHaveBeenCalled();
+  });
+
+  it('Shift+Enter は保存せず、改行できるようDHTMLXへのイベント伝播だけ止めること', () => {
+    const event = keydown({ key: 'Enter', shiftKey: true });
+
+    expect(saveClicked).toBe(0);
+    expect(event.defaultPrevented).toBe(false);
+    expect(event.stopPropagation).toHaveBeenCalled();
+  });
+
+  it('日本語入力の変換確定の Enter では保存しないこと', () => {
+    keydown({ key: 'Enter', isComposing: true });
+
+    expect(saveClicked).toBe(0);
+  });
+
+  it('Tab / Shift+Tab で入力欄を順に移動し、端では反対側へ回ること', () => {
+    document.getElementById('name')?.focus();
+
+    keydown({ key: 'Tab' });
+    expect(document.activeElement?.id).toBe('memo');
+
+    keydown({ key: 'Tab' });
+    keydown({ key: 'Tab' });
+    expect(document.activeElement?.id).toBe('name');
+
+    keydown({ key: 'Tab', shiftKey: true });
+    expect(document.activeElement?.id).toBe('schedule');
+  });
+});
+
+describe('チャート上のショートカット', () => {
+  let teardown: () => void;
+  let cursor: { current: KeyboardCursor };
+  let actions: { current: GanttKeyboardActions };
+
+  beforeEach(() => {
+    teardown = setupGantt();
+    syncGanttData(
+      [
+        makeTask(1, { text: 'Project', kind_task: 2 }),
+        makeTask(2, { parent: 1, sortorder: 0 }),
+        makeTask(3, { parent: 1, sortorder: 1 }),
+        makeTask(4, { sortorder: 1 }),
+      ],
+      [],
+      createGanttSyncState(),
+    );
+    gantt.render();
+    sessionStorage.clear();
+
+    cursor = { current: { taskId: null, isFocusMode: false } };
+    actions = {
+      current: {
+        addChildTask: vi.fn(() => Promise.resolve(undefined)),
+        addRootTask: vi.fn(() => Promise.resolve(undefined)),
+        cloneTask: vi.fn(() => Promise.resolve(undefined)),
+        createObsidianNote: vi.fn(),
+        openScheduleModal: vi.fn(),
+        getTimelinePointerTarget: vi.fn(() => null),
+        scrollTaskIntoView: vi.fn(),
+      },
+    };
+    renderHook(() => useGanttKeyboard(cursor, actions));
+  });
+
+  afterEach(() => {
+    cleanup();
+    teardown();
+    document.body.innerHTML = '';
+    vi.restoreAllMocks();
+  });
+
+  function focusSearchInput(): HTMLInputElement {
+    const input = document.createElement('input');
+    document.body.appendChild(input);
+    input.focus();
+    return input;
+  }
+
+  describe('A: タスク追加', () => {
+    it('プロジェクトを選択中なら、その子として追加すること', () => {
+      cursor.current.taskId = 1;
+
+      pressKey('a');
+
+      expect(actions.current.addChildTask).toHaveBeenCalledWith(1);
+    });
+
+    it('子タスクを選択中なら、同じ親の中でそのタスクの直下に追加すること', () => {
+      cursor.current.taskId = 3;
+
+      pressKey('a');
+
+      expect(actions.current.addChildTask).toHaveBeenCalledWith(1, 1);
+    });
+
+    it('最上位のタスクを選択中なら、最上位でそのタスクの直下に追加すること', () => {
+      cursor.current.taskId = 4;
+
+      pressKey('A');
+
+      expect(actions.current.addRootTask).toHaveBeenCalledWith(1);
+    });
+
+    it('追加できたら、そのタスクの編集画面を開くこと', async () => {
+      const showLightbox = vi.spyOn(gantt, 'showLightbox').mockImplementation(() => {});
+      vi.mocked(actions.current.addChildTask).mockResolvedValue(makeTask(50));
+      cursor.current.taskId = 1;
+
+      pressKey('a');
+      await flushPromises();
+
+      expect(showLightbox).toHaveBeenCalledWith(50);
+    });
+
+    it('入力欄にフォーカスがある間は反応しないこと', () => {
+      cursor.current.taskId = 1;
+      focusSearchInput();
+
+      pressKey('a');
+
+      expect(actions.current.addChildTask).not.toHaveBeenCalled();
+    });
+  });
+
+  it('O: 選択中のタスクのObsidianノートを作成すること', () => {
+    cursor.current.taskId = 2;
+
+    pressKey('o');
+
+    expect(actions.current.createObsidianNote).toHaveBeenCalledWith(2);
+  });
+
+  it('S: マウスが指しているタスクと日付でスケジュール追加モーダルを開くこと', () => {
+    const date = new Date(2026, 2, 11);
+    vi.mocked(actions.current.getTimelinePointerTarget).mockReturnValue({ taskId: 3, date });
+
+    pressKey('s');
+
+    expect(actions.current.openScheduleModal).toHaveBeenCalledWith(3, date);
+  });
+
+  it('S: マウスがタイムライン上に無ければ何もしないこと', () => {
+    pressKey('s');
+
+    expect(actions.current.openScheduleModal).not.toHaveBeenCalled();
+  });
+
+  describe('矢印キー', () => {
+    it('↓ で次の行を選択すること', () => {
+      gantt.selectTask(2);
+      cursor.current.taskId = 2;
+
+      pressKey('ArrowDown');
+
+      expect(gantt.getSelectedTasks().map(Number)).toEqual([3]);
+      expect(cursor.current.taskId).toBe(3);
+      expect(actions.current.scrollTaskIntoView).toHaveBeenCalledWith(3);
+    });
+
+    it('Shift+↓ で選択範囲を広げ、Shift+↑ で縮めること', () => {
+      gantt.selectTask(2);
+      cursor.current.taskId = 2;
+
+      pressKey('ArrowDown', { shiftKey: true });
+      expect(gantt.getSelectedTasks().map(Number).sort()).toEqual([2, 3]);
+
+      pressKey('ArrowUp', { shiftKey: true });
+      expect(gantt.getSelectedTasks().map(Number)).toEqual([2]);
+      expect(cursor.current.taskId).toBe(2);
+    });
+
+    it('Ctrl+↓ は選択を変えずにフォーカスだけ移動すること', () => {
+      gantt.selectTask(2);
+      cursor.current.taskId = 2;
+
+      pressKey('ArrowDown', { ctrlKey: true });
+
+      expect(gantt.getSelectedTasks().map(Number)).toEqual([2]);
+      expect(cursor.current).toEqual({ taskId: 3, isFocusMode: true });
+    });
+  });
+
+  describe('Delete', () => {
+    it('確認のうえ選択中のタスクを削除し、その上の行を選択すること', () => {
+      vi.spyOn(window, 'confirm').mockReturnValue(true);
+      gantt.selectTask(3);
+
+      pressKey('Delete');
+
+      expect(gantt.isTaskExists(3)).toBe(false);
+      expect(gantt.getSelectedTasks().map(Number)).toEqual([2]);
+      expect(cursor.current.taskId).toBe(2);
+    });
+
+    it('確認でキャンセルしたら削除しないこと', () => {
+      vi.spyOn(window, 'confirm').mockReturnValue(false);
+      gantt.selectTask(3);
+
+      pressKey('Backspace');
+
+      expect(gantt.isTaskExists(3)).toBe(true);
+    });
+  });
+
+  describe('コピーと貼り付け', () => {
+    it('Ctrl+C で選択中のタスクを表示順に覚え、Ctrl+V で選択タスクの後ろへ順に複製すること', async () => {
+      vi.mocked(actions.current.cloneTask)
+        .mockResolvedValueOnce(makeTask(50, { parent: 1 }))
+        .mockResolvedValueOnce(makeTask(51, { parent: 1 }));
+      gantt.selectTask(3);
+      gantt.selectTask(2);
+
+      pressKey('c', { ctrlKey: true });
+      expect(JSON.parse(sessionStorage.getItem('gantt_copied_task_ids') ?? '[]').map(Number)).toEqual([2, 3]);
+
+      pressKey('v', { metaKey: true });
+      await flushPromises();
+      await flushPromises();
+
+      const targetOfFirstPaste = vi.mocked(actions.current.cloneTask).mock.calls[0][1];
+      expect(vi.mocked(actions.current.cloneTask).mock.calls).toEqual([
+        [2, targetOfFirstPaste],
+        [3, 50],
+      ]);
+      expect(gantt.isTaskExists(50)).toBe(true);
+      expect(gantt.isTaskExists(51)).toBe(true);
+    });
+
+    it('入力欄での Ctrl+C / Ctrl+V / Ctrl+Z はブラウザ標準の動作に任せること', () => {
+      const undo = vi.spyOn(gantt, 'undo').mockImplementation(() => {});
+      sessionStorage.setItem('gantt_copied_task_ids', JSON.stringify([2]));
+      gantt.selectTask(2);
+      focusSearchInput();
+
+      const events = [
+        pressKey('c', { ctrlKey: true }),
+        pressKey('v', { ctrlKey: true }),
+        pressKey('z', { ctrlKey: true }),
+      ];
+
+      expect(events.map((event) => event.defaultPrevented)).toEqual([false, false, false]);
+      expect(actions.current.cloneTask).not.toHaveBeenCalled();
+      expect(undo).not.toHaveBeenCalled();
+    });
+  });
+
+  describe('Undo / Redo', () => {
+    it('Ctrl+Z で元に戻し、Ctrl+Shift+Z と Ctrl+Y でやり直すこと', () => {
+      const undo = vi.spyOn(gantt, 'undo').mockImplementation(() => {});
+      const redo = vi.spyOn(gantt, 'redo').mockImplementation(() => {});
+
+      pressKey('z', { ctrlKey: true });
+      pressKey('z', { metaKey: true, shiftKey: true });
+      pressKey('y', { ctrlKey: true });
+
+      expect(undo).toHaveBeenCalledTimes(1);
+      expect(redo).toHaveBeenCalledTimes(2);
+    });
+  });
+});
