-          const activeTag = document.activeElement?.tagName.toLowerCase();
-          if (activeTag === 'input' || activeTag === 'textarea') return;
-
-          const currentActiveId = mockGantt.getSelectedId();
-          if (currentActiveId && mockGantt.isTaskExists(currentActiveId)) {
-            e.preventDefault();
-            const task = mockGantt.getTask(currentActiveId);
-            const isProject = String(task.kind_task) === '2';
-            
-            if (isProject) {
-              handleAddChild(Number(currentActiveId), 1 as any);
-            } else {
-              const parentId = task.parent ? Number(task.parent) : 0;
-              if (parentId === 0) {
-                handleAddNewTask(null, 1 as any);
-              } else {
-                handleAddChild(parentId, 1 as any);
-              }
-            }
-          }
-        }
-      };
-
-      // ケース1: プロジェクト (kind_task: '2') を選択している場合
-      mockGantt.getSelectedId = vi.fn().mockReturnValue('10');
-      mockGantt.isTaskExists = vi.fn().mockReturnValue(true);
-      mockGantt.getTask = vi.fn().mockReturnValue({ kind_task: '2', parent: 0 });
-
-      handleKeyDown(mockEvent);
-      expect(mockEvent.preventDefault).toHaveBeenCalled();
-      expect(handleAddChild).toHaveBeenCalledWith(10, 1);
-      expect(handleAddNewTask).not.toHaveBeenCalled();
-
-      // mockのクリア
-      vi.clearAllMocks();
-      mockEvent.preventDefault.mockClear();
-
-      // ケース2: 通常タスク (kind_task: '1', parent: 20) を選択している場合
-      mockGantt.getSelectedId = vi.fn().mockReturnValue('11');
-      mockGantt.isTaskExists = vi.fn().mockReturnValue(true);
-      mockGantt.getTask = vi.fn().mockReturnValue({ kind_task: '1', parent: 20 });
-
-      handleKeyDown(mockEvent);
-      expect(mockEvent.preventDefault).toHaveBeenCalled();
-      expect(handleAddChild).toHaveBeenCalledWith(20, 1);
-      expect(handleAddNewTask).not.toHaveBeenCalled();
-
-      // mockのクリア
-      vi.clearAllMocks();
-      mockEvent.preventDefault.mockClear();
-
-      // ケース3: ルート階層のタスク (kind_task: '1', parent: 0) を選択している場合
