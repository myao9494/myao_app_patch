diff --git a/frontend/src/contexts/useTheme.ts b/frontend/src/contexts/useTheme.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d26528e6487e87c923e8ae30aa94dc70c31235c6
--- /dev/null
+++ b/frontend/src/contexts/useTheme.ts
@@ -0,0 +1,18 @@
+import { createContext, useContext } from 'react';
+
+export interface ThemeContextType {
+  darkMode: boolean;
+  toggleDarkMode: () => void;
+  setDarkMode: (value: boolean) => void;
+}
+
+export const ThemeContext = createContext<ThemeContextType | undefined>(undefined);
+
+/** 現在のテーマと切り替え関数を取得する（ThemeProvider の内側で使うこと） */
+export function useTheme(): ThemeContextType {
+  const context = useContext(ThemeContext);
+  if (context === undefined) {
+    throw new Error('useTheme must be used within a ThemeProvider');
+  }
+  return context;
+}
diff --git a/frontend/src/hooks/__tests__/useGanttData.test.ts b/frontend/src/hooks/__tests__/useGanttData.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..feea6ef2af4e9d5c0a522e3bf983e658dfeb1b82
--- /dev/null
+++ b/frontend/src/hooks/__tests__/useGanttData.test.ts
@@ -0,0 +1,263 @@
+/**
+ * @vitest-environment jsdom
+ * タスク・リンクのデータ管理フック（useGanttData）のテスト。APIはモックする。
+ */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { act, cleanup, renderHook, waitFor } from '@testing-library/react';
+import * as api from '../../services/api';
+import type { Link, Task } from '../../types/gantt';
+import { useGanttData } from '../useGanttData';
+
+vi.mock('../../services/api');
+
+const POLL_INTERVAL_MS = 2000;
+
+function makeTask(id: number, overrides: Partial<Task> = {}): Task {
+  return {
+    id,
+    text: `Task ${id}`,
+    start_date: '2026-03-10 00:00:00',
+    end_date: '2026-03-13 00:00:00',
+    duration: 3,
+    progress: 0,
+    parent: 0,
+    kind_task: 1,
+    owner_id: 0,
+    sortorder: 0,
+    ...overrides,
+  };
+}
+
+/** バックエンドの状態（モック） */
+let server: { tasks: Task[]; links: Link[]; sequence: number; online: boolean };
+
+beforeEach(() => {
+  vi.useFakeTimers({ shouldAdvanceTime: true });
+  server = { tasks: [makeTask(1), makeTask(2)], links: [], sequence: 5, online: true };
+
+  vi.mocked(api.getGanttUpdateSequence).mockImplementation(async () =>
+    server.online ? { success: true, data: { sequence: server.sequence } } : { success: false, error: 'offline' }
+  );
+  vi.mocked(api.getTasks).mockImplementation(async () =>
+    server.online
+      ? { success: true, data: { tasks: server.tasks, links: server.links } }
+      : { success: false, error: 'Network Error' }
+  );
+});
+
+afterEach(() => {
+  cleanup();
+  vi.useRealTimers();
+  vi.resetAllMocks();
+});
+
+async function renderLoaded() {
+  const rendered = renderHook(() => useGanttData());
+  await waitFor(() => expect(rendered.result.current.loading).toBe(false));
+  return rendered;
+}
+
+async function advancePoll() {
+  await act(async () => {
+    await vi.advanceTimersByTimeAsync(POLL_INTERVAL_MS);
+  });
+}
+
+describe('初回取得', () => {
+  it('タスクとリンクを取得して読み込み完了にすること', async () => {
+    const { result } = await renderLoaded();
+
+    expect(result.current.tasks.map((task) => task.id)).toEqual([1, 2]);
+    expect(result.current.error).toBeNull();
+  });
+
+  it('取得に失敗したらエラーを出し、バックエンドが復帰したら自動で取り直すこと', async () => {
+    server.online = false;
+    const { result } = await renderLoaded();
+    expect(result.current.error).toBe('Network Error');
+    expect(result.current.tasks).toEqual([]);
+
+    server.online = true;
+    await advancePoll();
+
+    expect(result.current.tasks.map((task) => task.id)).toEqual([1, 2]);
+    expect(result.current.error).toBeNull();
+  });
+});
+
+describe('自動更新（更新シーケンスのポーリング）', () => {
+  it('シーケンスが変わらなければ取り直さないこと', async () => {
+    await renderLoaded();
+    vi.mocked(api.getTasks).mockClear();
+
+    await advancePoll();
+    await advancePoll();
+
+    expect(api.getTasks).not.toHaveBeenCalled();
+  });
+
+  it('他のタブやランチャーからの変更でシーケンスが進んだら取り直すこと', async () => {
+    const { result } = await renderLoaded();
+
+    server.tasks = [...server.tasks, makeTask(3)];
+    server.sequence = 6;
+    await advancePoll();
+
+    expect(result.current.tasks.map((task) => task.id)).toEqual([1, 2, 3]);
+  });
+
+  it('バックエンドの再起動でシーケンスが小さい値に戻っても、変更として取り直すこと', async () => {
+    const { result } = await renderLoaded();
+
+    server.tasks = [makeTask(1)];
+    server.sequence = 0;
+    await advancePoll();
+
+    expect(result.current.tasks.map((task) => task.id)).toEqual([1]);
+
+    // 取り直した後は、新しいシーケンスを基準にする
+    vi.mocked(api.getTasks).mockClear();
+    await advancePoll();
+    expect(api.getTasks).not.toHaveBeenCalled();
+  });
+
+  it('取り直しに失敗しても、表示中のデータは消さないこと', async () => {
+    const { result } = await renderLoaded();
+
+    server.sequence = 6;
+    vi.mocked(api.getTasks).mockResolvedValueOnce({ success: false, error: 'Network Error' });
+    await advancePoll();
+
+    expect(result.current.error).toBe('Network Error');
+    expect(result.current.tasks.map((task) => task.id)).toEqual([1, 2]);
+
+    await advancePoll();
+    expect(result.current.error).toBeNull();
+  });
+
+  it('取得中に別の更新が入っても、次のポーリングで取り直せること', async () => {
+    const { result } = await renderLoaded();
+
+    // シーケンス 6 を読んだ直後・タスク取得の前に、もう1件更新（シーケンス 7）が入る
+    server.sequence = 6;
+    vi.mocked(api.getTasks).mockImplementationOnce(async () => {
+      const snapshot = { tasks: [...server.tasks, makeTask(3)], links: [] };
+      server.tasks = [...snapshot.tasks, makeTask(4)];
+      server.sequence = 7;
+      return { success: true, data: snapshot };
+    });
+    await advancePoll();
+    expect(result.current.tasks.map((task) => task.id)).toEqual([1, 2, 3]);
+
+    await advancePoll();
+    expect(result.current.tasks.map((task) => task.id)).toEqual([1, 2, 3, 4]);
+  });
+});
+
+describe('タスクの保存', () => {
+  it('更新に成功したら、バックエンドの応答でローカルのデータを置き換えて true を返すこと', async () => {
+    const { result } = await renderLoaded();
+    vi.mocked(api.updateTask).mockResolvedValue({
+      success: true,
+      data: makeTask(2, { text: 'Saved', duration: 9 }),
+    });
+
+    let saved = false;
+    await act(async () => {
+      saved = await result.current.updateTask(2, { text: '  Saved' });
+    });
+
+    expect(saved).toBe(true);
+    expect(result.current.tasks[1]).toMatchObject({ text: 'Saved', duration: 9 });
+  });
+
+  it('更新に失敗したら、データを変えずにエラーを出して false を返すこと', async () => {
+    const { result } = await renderLoaded();
+    vi.mocked(api.updateTask).mockResolvedValue({ success: false, error: 'Task not found' });
+
+    let saved = true;
+    await act(async () => {
+      saved = await result.current.updateTask(2, { text: 'x' });
+    });
+
+    expect(saved).toBe(false);
+    expect(result.current.tasks[1].text).toBe('Task 2');
+    expect(result.current.error).toContain('Task not found');
+  });
+
+  it('削除に成功したら、子孫も含めてローカルのデータから取り除くこと', async () => {
+    server.tasks = [makeTask(1), makeTask(2, { parent: 1 }), makeTask(3)];
+    const { result } = await renderLoaded();
+    vi.mocked(api.deleteTask).mockResolvedValue({
+      success: true,
+      data: { deleted_id: 1, deleted_children: [2] },
+    });
+
+    let deleted = false;
+    await act(async () => {
+      deleted = await result.current.deleteTask(1);
+    });
+
+    expect(deleted).toBe(true);
+    expect(result.current.tasks.map((task) => task.id)).toEqual([3]);
+  });
+
+  it('削除に失敗したら false を返し、データは残すこと', async () => {
+    const { result } = await renderLoaded();
+    vi.mocked(api.deleteTask).mockResolvedValue({ success: false, error: 'boom' });
+
+    let deleted = true;
+    await act(async () => {
+      deleted = await result.current.deleteTask(1);
+    });
+
+    expect(deleted).toBe(false);
+    expect(result.current.tasks).toHaveLength(2);
+  });
+
+  it('作成時に日付が無ければ、ローカル日付で今日〜7日後を補って全データを取り直すこと', async () => {
+    vi.setSystemTime(new Date(2026, 2, 18, 3, 0)); // 日本時間の早朝（UTCではまだ前日）
+    const { result } = await renderLoaded();
+    vi.mocked(api.createTask).mockImplementation(async (request) => {
+      const created = makeTask(3, request as Partial<Task>);
+      server.tasks = [...server.tasks, created];
+      return { success: true, data: created };
+    });
+
+    await act(async () => {
+      await result.current.createTask({ parent: 1 });
+    });
+
+    expect(api.createTask).toHaveBeenCalledWith({
+      parent: 1,
+      text: '新規タスク',
+      start_date: '2026-03-18 00:00:00',
+      end_date: '2026-03-25 00:00:00',
+    });
+    expect(result.current.tasks.map((task) => task.id)).toEqual([1, 2, 3]);
+  });
+});
+
+describe('リンクの保存', () => {
+  it('作成・更新・削除をローカルのデータへ反映すること', async () => {
+    const { result } = await renderLoaded();
+    vi.mocked(api.createLink).mockResolvedValue({ success: true, data: { id: 9, source: 1, target: 2, type: 0 } });
+    vi.mocked(api.updateLink).mockResolvedValue({ success: true });
+    vi.mocked(api.deleteLink).mockResolvedValue({ success: true });
+
+    await act(async () => {
+      await result.current.createLink({ source: 1, target: 2, type: 0 });
+    });
+    expect(result.current.links).toEqual([{ id: 9, source: 1, target: 2, type: 0 }]);
+
+    await act(async () => {
+      await result.current.updateLink(9, { type: 1 });
+    });
+    expect(result.current.links[0].type).toBe(1);
+
+    await act(async () => {
+      await result.current.deleteLink(9);
+    });
+    expect(result.current.links).toEqual([]);
+  });
+});
diff --git a/frontend/src/hooks/useAppSettings.ts b/frontend/src/hooks/useAppSettings.ts
new file mode 100644
index 0000000000000000000000000000000000000000..29df8b2cc650e046bb11ff84bd477ff2ce09488c
--- /dev/null
+++ b/frontend/src/hooks/useAppSettings.ts
@@ -0,0 +1,125 @@
+/**
+ * バックエンドから取得するアプリ設定系データのフック
+ * - 休日・出張日（タイムラインの背景色に使う）と、休日の追加/解除
+ * - 検索用の同義語グループ
+ * - Obsidian Vault へのCSV定期保存と、その差分サマリ
+ */
+import { useCallback, useEffect, useState } from 'react';
+import * as api from '../services/api';
+import type {
+  BusinessTripSettings,
+  HolidaySettings,
+  ObsidianCsvSyncSummary,
+  ObsidianCsvSyncSummaryNotFound,
+} from '../types/gantt';
+
+const OBSIDIAN_CSV_SYNC_INTERVAL_MS = 30 * 60 * 1000;
+
+/** 休日・出張日の設定。holidays は右クリックメニューからも追加/解除できる */
+export function useCalendarSettings() {
+  const [holidaySettings, setHolidaySettings] = useState<HolidaySettings | null>(null);
+  const [businessTripSettings, setBusinessTripSettings] = useState<BusinessTripSettings | null>(null);
+
+  useEffect(() => {
+    void api.getHolidays().then((result) => {
+      if (result.success && result.data) setHolidaySettings(result.data);
+    });
+    void api.getBusinessTrips().then((result) => {
+      if (result.success && result.data) setBusinessTripSettings(result.data);
+    });
+  }, []);
+
+  const addHoliday = useCallback(async (dateStr: string) => {
+    const result = await api.addHoliday(dateStr);
+    if (result.success && result.data) {
+      setHolidaySettings(result.data);
+    } else {
+      alert(result.error || '休日の追加に失敗しました');
+    }
+  }, []);
+
+  const removeHoliday = useCallback(async (dateStr: string) => {
+    const result = await api.deleteHoliday(dateStr);
+    if (result.success && result.data) {
+      setHolidaySettings(result.data);
+    } else {
+      alert(result.error || '休日の解除に失敗しました');
+    }
+  }, []);
+
+  return {
+    holidaySettings,
+    setHolidaySettings,
+    businessTripSettings,
+    setBusinessTripSettings,
+    addHoliday,
+    removeHoliday,
+  };
+}
+
+/** 検索語の同義語グループ。外部の同義語APIが使えない場合は空のまま（通常の検索になる） */
+export function useSynonyms(): string[][] {
+  const [synonyms, setSynonyms] = useState<string[][]>([]);
+
+  useEffect(() => {
+    void api.getSynonyms().then((result) => {
+      if (result.success && result.data) setSynonyms(result.data.groups || []);
+    });
+  }, []);
+
+  return synonyms;
+}
+
+/**
+ * Obsidian Vault へのCSV保存。
+ * Obsidianホームが設定されていれば、起動時と30分ごとに現在のデータを保存し、差分サマリを保持する。
+ */
+export function useObsidianCsvSync(obsidianHome: string) {
+  const [summary, setSummary] = useState<ObsidianCsvSyncSummary | ObsidianCsvSyncSummaryNotFound | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const targetHome = obsidianHome.trim();
+
+  useEffect(() => {
+    if (!targetHome) return;
+
+    let cancelled = false;
+    const runSync = async () => {
+      const result = await api.syncObsidianCsv(targetHome);
+      if (cancelled) return;
+      if (result.success && result.data) {
+        setSummary(result.data);
+        setError(null);
+      } else {
+        setError(result.error || 'Obsidian CSV同期に失敗しました');
+      }
+    };
+
+    void runSync();
+    const timerId = window.setInterval(runSync, OBSIDIAN_CSV_SYNC_INTERVAL_MS);
+    return () => {
+      cancelled = true;
+      window.clearInterval(timerId);
+    };
+  }, [targetHome]);
+
+  /** 保存済みの最新サマリを取得し直す。Obsidianホーム未設定の場合は false を返す */
+  const reloadSummary = useCallback(async (): Promise<boolean> => {
+    if (!targetHome) return false;
+
+    const result = await api.getObsidianCsvSyncSummary(targetHome);
+    if (result.success && result.data) {
+      setSummary(result.data);
+      setError(null);
+    } else {
+      setError(result.error || '差分サマリの取得に失敗しました');
+    }
+    return true;
+  }, [targetHome]);
+
+  // Obsidianホームが未設定の間は、以前の結果を見せない
+  return {
+    summary: targetHome ? summary : null,
+    error: targetHome ? error : null,
+    reloadSummary,
+  };
+}
diff --git a/frontend/src/hooks/useGanttData.ts b/frontend/src/hooks/useGanttData.ts
new file mode 100644
index 0000000000000000000000000000000000000000..451bc49da4bfddd1284ac0b318b167a42ef27cbb
--- /dev/null
+++ b/frontend/src/hooks/useGanttData.ts
@@ -0,0 +1,175 @@
+/**
+ * タスク・リンクのデータ管理フック
+ * - 初回取得と、更新シーケンスのポーリングによる自動更新（他のタブやランチャーからの変更を反映）
+ * - タスク・リンクの作成/更新/削除/複製（APIを呼び、成功したらローカルの state に反映する）
+ */
+import { useCallback, useEffect, useRef, useState } from 'react';
+import * as api from '../services/api';
+import { formatDateString } from '../constants/gantt';
+import type { CreateTaskRequest, Link, Task } from '../types/gantt';
+
+const UPDATE_SEQUENCE_POLL_INTERVAL_MS = 2000;
+const DEFAULT_NEW_TASK_DAYS = 7;
+
+export function useGanttData() {
+  const [tasks, setTasks] = useState<Task[]>([]);
+  const [links, setLinks] = useState<Link[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState<string | null>(null);
+
+  // 最後に取得したデータに対応する更新シーケンス番号（未取得なら null）
+  const knownSequenceRef = useRef<number | null>(null);
+  const isFetchingRef = useRef(false);
+
+  const fetchData = useCallback(async (showLoading = false) => {
+    if (showLoading) setLoading(true);
+    isFetchingRef.current = true;
+    try {
+      // シーケンス番号はデータより「先に」読む。
+      // 取得中に別の更新が入った場合でも、次のポーリングで差に気づいて取り直せる。
+      const sequenceResult = await api.getGanttUpdateSequence();
+      const result = await api.getTasks();
+      if (result.success && result.data) {
+        setTasks(result.data.tasks || []);
+        setLinks(result.data.links || []);
+        setError(null);
+        if (sequenceResult.success && sequenceResult.data) {
+          knownSequenceRef.current = sequenceResult.data.sequence;
+        }
+      } else {
+        // 取得に失敗しても、表示中のデータは消さずに残す（一時的な通信断で画面を空にしない）
+        setError(result.error || 'データの取得に失敗しました');
+      }
+    } finally {
+      isFetchingRef.current = false;
+      if (showLoading) setLoading(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    void fetchData(true);
+  }, [fetchData]);
+
+  // 更新シーケンスのポーリングによる自動更新。
+  // バックエンドの再起動でシーケンスは 0 に戻るため、大小ではなく「値が変わったか」で判定する。
+  useEffect(() => {
+    let cancelled = false;
+
+    const checkUpdateSequence = async () => {
+      if (isFetchingRef.current) return;
+      const result = await api.getGanttUpdateSequence();
+      if (cancelled || isFetchingRef.current || !result.success || !result.data) return;
+
+      if (result.data.sequence !== knownSequenceRef.current) {
+        await fetchData(false);
+      }
+    };
+
+    const timerId = window.setInterval(checkUpdateSequence, UPDATE_SEQUENCE_POLL_INTERVAL_MS);
+    return () => {
+      cancelled = true;
+      window.clearInterval(timerId);
+    };
+  }, [fetchData]);
+
+  // --- タスク ---
+
+  /** タスクを更新する。成功したら true（失敗時はエラーを表示して false） */
+  const updateTask = useCallback(async (id: number, taskData: Partial<Task>): Promise<boolean> => {
+    const result = await api.updateTask(id, taskData);
+    if (result.success && result.data) {
+      // バックエンドの応答（実際のDBの状態）をそのまま使い、ローカルの state とDBの一貫性を保つ
+      const saved = result.data;
+      setTasks((prev) => prev.map((task) => (task.id === id ? { ...task, ...saved } : task)));
+      return true;
+    }
+    setError(`タスクの保存に失敗しました: ${result.error ?? ''}`);
+    return false;
+  }, []);
+
+  /** タスクを作成し、正しい並び順で表示するため全データを取り直す。作成したタスクを返す */
+  const createTask = useCallback(async (taskData: Partial<Task>): Promise<Task | undefined> => {
+    const today = new Date();
+    const defaultEnd = new Date(today);
+    defaultEnd.setDate(defaultEnd.getDate() + DEFAULT_NEW_TASK_DAYS);
+
+    const requestData: CreateTaskRequest = {
+      ...taskData,
+      text: taskData.text || '新規タスク',
+      start_date: taskData.start_date || formatDateString(today),
+      end_date: taskData.end_date || formatDateString(defaultEnd),
+    };
+    const result = await api.createTask(requestData);
+    if (result.success && result.data) {
+      await fetchData();
+      return result.data;
+    }
+    setError(`タスクの作成に失敗しました: ${result.error ?? ''}`);
+    return undefined;
+  }, [fetchData]);
+
+  /** タスクと、その子孫をまとめて削除する。成功したら true（失敗時はエラーを表示して false） */
+  const deleteTask = useCallback(async (id: number): Promise<boolean> => {
+    const result = await api.deleteTask(id);
+    if (result.success && result.data) {
+      const deletedIds = new Set([result.data.deleted_id, ...result.data.deleted_children]);
+      setTasks((prev) => prev.filter((task) => !deletedIds.has(task.id)));
+      return true;
+    }
+    setError(`タスクの削除に失敗しました: ${result.error ?? ''}`);
+    return false;
+  }, []);
+
+  /** タスクを子孫ごと複製する。targetId を指定するとそのタスクの直後に挿入する */
+  const cloneTask = useCallback(async (id: number, targetId?: number): Promise<Task | undefined> => {
+    const result = await api.cloneTask(id, targetId);
+    if (result.success && result.data) {
+      // 子孫も複製されるため、全データを取り直す
+      await fetchData();
+      return result.data;
+    }
+    setError(`タスクの複製に失敗しました: ${result.error ?? ''}`);
+    return undefined;
+  }, [fetchData]);
+
+  // --- リンク ---
+
+  const createLink = useCallback(async (linkData: Omit<Link, 'id'>): Promise<Link | undefined> => {
+    const result = await api.createLink(linkData);
+    if (result.success && result.data) {
+      const newLink = result.data;
+      setLinks((prev) => [...prev, newLink]);
+      return newLink;
+    }
+    return undefined;
+  }, []);
+
+  const updateLink = useCallback(async (id: number, linkData: Partial<Link>) => {
+    const result = await api.updateLink(id, linkData);
+    if (result.success) {
+      setLinks((prev) => prev.map((link) => (link.id === id ? { ...link, ...linkData } : link)));
+    }
+  }, []);
+
+  const deleteLink = useCallback(async (id: number) => {
+    const result = await api.deleteLink(id);
+    if (result.success) {
+      setLinks((prev) => prev.filter((link) => link.id !== id));
+    }
+  }, []);
+
+  return {
+    tasks,
+    links,
+    loading,
+    error,
+    fetchData,
+    updateTask,
+    createTask,
+    deleteTask,
+    cloneTask,
+    createLink,
+    updateLink,
+    deleteLink,
+  };
+}
diff --git a/frontend/src/hooks/useGridStaging.ts b/frontend/src/hooks/useGridStaging.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c5d4ce364a51aabb5c3257e257fadb71ff2a32eb
--- /dev/null
+++ b/frontend/src/hooks/useGridStaging.ts
@@ -0,0 +1,89 @@
+/**
+ * グリッド編集（/grid）のステージング管理フック
+ *
+ * グリッド上の編集は本データに直接反映せず、バックエンドのステージングテーブルに保持する。
+ * - グリッド画面を開いたときにステージングを本データで初期化する
+ * - 本データとの差分一覧を保持し、個別の「元に戻す」と一括アップロード（コミット）を提供する
+ */
+import { useCallback, useEffect, useState } from 'react';
+import * as api from '../services/api';
+import type { GridDiffItem } from '../types/gantt';
+
+interface UseGridStagingOptions {
+  /** グリッド画面を表示中かどうか */
+  active: boolean;
+  /** コミット後に本データを再取得する */
+  onCommitted: () => Promise<void>;
+}
+
+export function useGridStaging({ active, onCommitted }: UseGridStagingOptions) {
+  const [diffs, setDiffs] = useState<GridDiffItem[]>([]);
+  const [selectedDiff, setSelectedDiff] = useState<GridDiffItem | null>(null);
+  const [committing, setCommitting] = useState(false);
+  const [initialized, setInitialized] = useState(false);
+
+  const refreshDiffs = useCallback(async () => {
+    const result = await api.getGridDiff();
+    if (result.success && result.data) {
+      setDiffs(result.data.diffs);
+    }
+  }, []);
+
+  // グリッド画面に入ったらステージングを初期化し、離れたら状態を捨てる
+  useEffect(() => {
+    if (!active) {
+      setInitialized(false);
+      setDiffs([]);
+      setSelectedDiff(null);
+      return;
+    }
+    if (initialized) return;
+
+    let cancelled = false;
+    void api.initGrid().then(async (result) => {
+      if (cancelled || !result.success) return;
+      setInitialized(true);
+      await refreshDiffs();
+    });
+    return () => {
+      cancelled = true;
+    };
+  }, [active, initialized, refreshDiffs]);
+
+  /** ステージングの差分を本データへ一括反映する */
+  const commit = useCallback(async () => {
+    setCommitting(true);
+    try {
+      const result = await api.commitGrid();
+      if (!result.success || !result.data) return;
+
+      const { updated_tasks, updated_links, errors } = result.data;
+      if (errors.length > 0) {
+        alert(`アップロードにエラーがありました: ${errors.join(', ')}`);
+      } else {
+        alert(`アップロード完了: Tasks ${updated_tasks}件, Links ${updated_links}件`);
+      }
+      await onCommitted();
+      await api.initGrid();
+      setDiffs([]);
+      setSelectedDiff(null);
+    } finally {
+      setCommitting(false);
+    }
+  }, [onCommitted]);
+
+  /** 指定した差分1件を破棄し、本データの値に戻す */
+  const revert = useCallback(async (item: GridDiffItem) => {
+    const result = await api.revertGridDiff(item.table, item.id, item.field);
+    if (!result.success) {
+      alert(`元に戻す処理に失敗しました: ${result.error}`);
+      return;
+    }
+    await refreshDiffs();
+    setSelectedDiff((selected) =>
+      selected?.id === item.id && selected?.field === item.field ? null : selected
+    );
+  }, [refreshDiffs]);
+
+  return { diffs, selectedDiff, setSelectedDiff, committing, refreshDiffs, commit, revert };
+}
diff --git a/frontend/src/hooks/useLatestRef.ts b/frontend/src/hooks/useLatestRef.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ef9db22977f636e2b02e88707844628e62125821
--- /dev/null
+++ b/frontend/src/hooks/useLatestRef.ts
@@ -0,0 +1,14 @@
+import { useLayoutEffect, useRef, type RefObject } from 'react';
+
+/**
+ * 常に最新の値を指す ref を返す。
+ * 一度だけ登録するイベントハンドラ（DHTMLX Gantt や document のリスナー）から、
+ * 再登録なしで最新の props / コールバックを参照するために使う。
+ */
+export function useLatestRef<T>(value: T): RefObject<T> {
+  const ref = useRef(value);
+  useLayoutEffect(() => {
+    ref.current = value;
+  });
+  return ref;
+}
diff --git a/frontend/src/hooks/useOpenInputRequests.ts b/frontend/src/hooks/useOpenInputRequests.ts
new file mode 100644
index 0000000000000000000000000000000000000000..38945aef591413c2bdddc132b1742367c3bda8e2
--- /dev/null
+++ b/frontend/src/hooks/useOpenInputRequests.ts
@@ -0,0 +1,82 @@
+/**
+ * 外部（ランチャー等）からの「タスク入力画面を開く」リクエストを受け取るフック
+ *
+ * - 5秒ごとにハートビートを送り、このタブが開いていることをバックエンドに知らせる
+ *   （Windowsでは、タブが開いていれば新しいタブを開かずに既存ウィンドウを前面に出す判断に使われる）
+ * - 1秒ごとにリクエストをポーリングし、未処理のものがあれば Gantt 画面へ切り替えて開かせる
+ * - 開けたら ack を送ってバックエンドのリクエストを消す
+ */
+import { useCallback, useEffect, useState } from 'react';
+import { useLocation, useNavigate } from 'react-router-dom';
+import * as api from '../services/api';
+
+const HEARTBEAT_INTERVAL_MS = 5000;
+const REQUEST_POLL_INTERVAL_MS = 1000;
+// リロード後に同じリクエストを二重に処理しないよう、処理済みの最大IDをタブ単位で覚えておく
+const LAST_HANDLED_REQUEST_KEY = 'gantt_lastOpenInputRequestId';
+
+export interface ExternalOpenTaskRequest {
+  requestId: number;
+  taskId: number;
+  /** 同じリクエストの再試行でも値が変わるようにするための時刻 */
+  attempt: number;
+}
+
+export function useOpenInputRequests() {
+  const location = useLocation();
+  const navigate = useNavigate();
+  const [request, setRequest] = useState<ExternalOpenTaskRequest | null>(null);
+  const [lastHandledRequestId, setLastHandledRequestId] = useState(() =>
+    Number(window.sessionStorage.getItem(LAST_HANDLED_REQUEST_KEY) || '0')
+  );
+
+  useEffect(() => {
+    const sendHeartbeat = () => {
+      void api.sendTaskInputOpenClientHeartbeat();
+    };
+
+    sendHeartbeat();
+    const timerId = window.setInterval(sendHeartbeat, HEARTBEAT_INTERVAL_MS);
+    return () => window.clearInterval(timerId);
+  }, []);
+
+  useEffect(() => {
+    let cancelled = false;
+
+    const pollRequest = async () => {
+      const result = await api.getTaskInputOpenRequest();
+      if (cancelled || !result.success || !result.data) return;
+
+      const pending = result.data;
+      if (pending.request_id <= lastHandledRequestId) return;
+
+      setRequest({
+        requestId: pending.request_id,
+        taskId: pending.task_id,
+        attempt: Date.now(),
+      });
+
+      if (location.pathname !== '/') {
+        navigate('/');
+      }
+    };
+
+    void pollRequest();
+    const timerId = window.setInterval(pollRequest, REQUEST_POLL_INTERVAL_MS);
+    return () => {
+      cancelled = true;
+      window.clearInterval(timerId);
+    };
+  }, [lastHandledRequestId, location.pathname, navigate]);
+
+  const markHandled = useCallback((requestId: number) => {
+    setLastHandledRequestId((prev) => {
+      const next = Math.max(prev, requestId);
+      window.sessionStorage.setItem(LAST_HANDLED_REQUEST_KEY, String(next));
+      return next;
+    });
+    void api.acknowledgeTaskInputOpenRequest(requestId);
+  }, []);
+
+  return { request, markHandled };
+}
diff --git a/frontend/src/hooks/useSyncedState.ts b/frontend/src/hooks/useSyncedState.ts
new file mode 100644
index 0000000000000000000000000000000000000000..07779ded227ac24c3f329fffc2d18666a553c3c8
--- /dev/null
+++ b/frontend/src/hooks/useSyncedState.ts
@@ -0,0 +1,15 @@
+import { useState, type Dispatch, type SetStateAction } from 'react';
+
+/**
+ * 外部の値（props など）で初期化し、その値が変わったら追従するローカル state。
+ * 入力欄のように「編集中はローカルの値を持ち、外部から値が変えられたらそれに合わせる」用途に使う。
+ */
+export function useSyncedState<T>(source: T): [T, Dispatch<SetStateAction<T>>] {
+  const [state, setState] = useState(source);
+  const [previousSource, setPreviousSource] = useState(source);
+  if (source !== previousSource) {
+    setPreviousSource(source);
+    setState(source);
+  }
+  return [state, setState];
+}
diff --git a/frontend/src/services/__tests__/api.test.ts b/frontend/src/services/__tests__/api.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..90a8089c47ec2cb690d8efdc4819d2f56922edf5
--- /dev/null
+++ b/frontend/src/services/__tests__/api.test.ts
@@ -0,0 +1,82 @@
+/**
+ * APIクライアント（services/api）のテスト。HTTP通信は axios のアダプターを差し替えてモックする。
+ */
+import { afterEach, describe, expect, it } from 'vitest';
+import { AxiosError, type AxiosAdapter, type InternalAxiosRequestConfig } from 'axios';
+import api, { cloneTask, describeApiError, getTasks, updateTask } from '../api';
+
+const originalAdapter = api.defaults.adapter;
+let requests: InternalAxiosRequestConfig[] = [];
+
+/** 指定したステータスとボディを返すアダプターに差し替える（4xx/5xx は axios と同じく例外にする） */
+function respondWith(status: number, data: unknown) {
+  const adapter: AxiosAdapter = async (config) => {
+    requests.push(config);
+    const response = { data, status, statusText: '', headers: {}, config };
+    if (status >= 400) {
+      throw new AxiosError(`Request failed with status code ${status}`, 'ERR_BAD_REQUEST', config, null, response);
+    }
+    return response;
+  };
+  api.defaults.adapter = adapter;
+}
+
+afterEach(() => {
+  api.defaults.adapter = originalAdapter;
+  requests = [];
+});
+
+describe('API呼び出しの結果', () => {
+  it('成功時は success と応答データを返すこと', async () => {
+    respondWith(200, { tasks: [], links: [] });
+
+    expect(await getTasks()).toEqual({ success: true, data: { tasks: [], links: [] } });
+    expect(requests[0].url).toBe('/api/tasks');
+  });
+
+  it('失敗時は例外を投げず、バックエンドの詳細メッセージを error に入れること', async () => {
+    respondWith(404, { detail: 'Task not found' });
+
+    expect(await updateTask(1, { text: 'x' })).toEqual({ success: false, error: 'Task not found' });
+  });
+
+  it('詳細メッセージが無い失敗では、通信エラーのメッセージを返すこと', async () => {
+    respondWith(500, 'Internal Server Error');
+
+    const result = await getTasks();
+
+    expect(result.success).toBe(false);
+    expect(result.error).toBe('Request failed with status code 500');
+  });
+
+  it('複製先の指定は、指定されたときだけクエリパラメータにすること', async () => {
+    respondWith(200, {});
+
+    await cloneTask(3);
+    await cloneTask(3, 7);
+
+    expect(requests.map((request) => [request.url, request.params])).toEqual([
+      ['/api/tasks/3/clone', {}],
+      ['/api/tasks/3/clone', { target_id: 7 }],
+    ]);
+  });
+});
+
+describe('describeApiError', () => {
+  it('バリデーションエラーのように detail が文字列でない場合は、例外のメッセージを使うこと', () => {
+    const error = new AxiosError('Request failed with status code 422', 'ERR_BAD_REQUEST', undefined, null, {
+      data: { detail: [{ msg: 'field required' }] },
+      status: 422,
+      statusText: '',
+      headers: {},
+      config: {} as InternalAxiosRequestConfig,
+    });
+
+    expect(describeApiError(error)).toBe('Request failed with status code 422');
+  });
+
+  it('Error でない値には既定のメッセージを返すこと', () => {
+    expect(describeApiError('oops')).toBe('通信エラー');
+    expect(describeApiError(null, '同義語APIエラー')).toBe('同義語APIエラー');
+  });
+});
