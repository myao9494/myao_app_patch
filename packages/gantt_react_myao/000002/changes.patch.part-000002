- */
-import { describe, it, expect, vi, beforeEach } from 'vitest';
-
-// 実際のコンポーネントをテストするのは依存関係が多いため、
-// ロジック部分（handleKeyDown）の振る舞いをシミュレートするテストを作成します。
-
-describe('GanttChart Keyboard Shortcuts (Lightbox)', () => {
-  let mockGantt: any;
-  let mockEvent: any;
-  let saveBtnClicked = false;
-
-  beforeEach(() => {
-    saveBtnClicked = false;
-    mockGantt = {
-      getState: vi.fn(() => ({ lightbox: true })),
-    };
-    mockEvent = {
-      key: 'Enter',
-      shiftKey: false,
-      preventDefault: vi.fn(),
-      stopPropagation: vi.fn(),
-    };
-    
-    // DOMのモック
-    document.querySelector = vi.fn((selector) => {
-      if (selector === '.gantt_btn_set.gantt_save_btn_set') {
-        return {
-          click: () => { saveBtnClicked = true; }
-        };
-      }
-      return null;
-    }) as any;
-  });
-
-  // 以前のロジック（Shift+Enterで保存、Enterで改行）をテストし、
-  // その後修正して新しいロジック（Enterで保存、Shift+Enterで改行）をテストする。
-
-  it('Enterキーのみで保存が実行されること（新仕様）', () => {
-    // 修正後のロジックをシミュレート
-    const handleKeyDown = (e: any) => {
-      if (mockGantt.getState().lightbox) {
-        if (e.key === 'Enter') {
-          if (!e.shiftKey) { // 修正点: Shiftなしで保存
-            e.preventDefault();
-            e.stopPropagation();
-            const saveBtn = document.querySelector('.gantt_btn_set.gantt_save_btn_set');
-            if (saveBtn) (saveBtn as any).click();
-          } else {
-            e.stopPropagation();
-          }
-        }
-      }
-    };
-
-    handleKeyDown(mockEvent);
-    expect(saveBtnClicked).toBe(true);
-    expect(mockEvent.preventDefault).toHaveBeenCalled();
-  });
-
-  it('Shift + Enterで改行が許可されること（新仕様）', () => {
-    mockEvent.shiftKey = true;
-    
-    const handleKeyDown = (e: any) => {
-      if (mockGantt.getState().lightbox) {
-        if (e.key === 'Enter') {
-          if (!e.shiftKey) {
-            e.preventDefault();
-            e.stopPropagation();
-            const saveBtn = document.querySelector('.gantt_btn_set.gantt_save_btn_set');
-            if (saveBtn) (saveBtn as any).click();
-          } else {
-            // Shift + Enter の場合は何もしない（ブラウザデフォルトの改行を許可）
-            e.stopPropagation();
-          }
-        }
-      }
-    };
-
-    handleKeyDown(mockEvent);
-    expect(saveBtnClicked).toBe(false);
-    expect(mockEvent.preventDefault).not.toHaveBeenCalled();
-    expect(mockEvent.stopPropagation).toHaveBeenCalled();
-  });
-
-  describe('Aキーによるショートカット操作', () => {
-    it('Aキーを押すと選択中の要素の種類に応じてタスクが追加されること', () => {
-      mockEvent.key = 'a';
-      // Lightboxが閉じている状態をシミュレート
-      mockGantt.getState = vi.fn(() => ({ lightbox: false }));
-      
-      const handleAddChild = vi.fn();
-      const handleAddNewTask = vi.fn();
-
-      // GanttChart.tsx に追加する予定の Aキーショートカットロジック
-      const handleKeyDown = (e: any) => {
-        if (mockGantt.getState().lightbox) return;
-
-        const modifierPressed = e.ctrlKey || e.metaKey;
