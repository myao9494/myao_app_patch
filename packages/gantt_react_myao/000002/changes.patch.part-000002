-      mockGantt.isTaskExists = vi.fn().mockReturnValue(true);
-      mockGantt.getTask = vi.fn().mockReturnValue({ kind_task: '1', parent: 0 });
-
-      handleKeyDown(mockEvent);
-      expect(mockEvent.preventDefault).toHaveBeenCalled();
