 }
 
+/** 検索語1つ分。candidates には検索語自身とその同義語が入る */
+interface SearchTerm {
+  token: string;
+  candidates: string[];
+}
+
 /**
  * 親ID → 子タスク配列のMapを構築する
  * sortorderでソート済みの状態で格納する
@@ -323,11 +329,26 @@ function resolveFilterDateBounds(filter: TaskFilter): FilterDateBounds {
   return {};
 }
 
+/**
+ * 検索文字列を空白（全角含む）で区切り、各語を同義語込みの候補に展開する。
