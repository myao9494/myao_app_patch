diff --git a/frontend/src/components/UniverSheet/gridColumns.ts b/frontend/src/components/UniverSheet/gridColumns.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0e7b244f9e58be64ab11e6c866e3b09bbf18a6ed
--- /dev/null
+++ b/frontend/src/components/UniverSheet/gridColumns.ts
@@ -0,0 +1,48 @@
+/**
+ * グリッド（UniverSheet）の列定義
+ * 列の並び順がそのままシートの列番号になる。field はバックエンドのカラム名で、
+ * ステージング更新API（/api/grid/tasks, /api/grid/links）へ送るキーとして使う。
+ */
+
+export interface ColumnDefinition {
+  /** カラム名（ヘッダー表示用） */
+  name: string;
+  /** フィールド名（DBのカラム名） */
+  field: string;
+  /** 列幅(px) */
+  width: number;
+}
+
+/** Tasksシートの列: DBの全カラムを表示する */
+export const TASK_COLUMN_DEFINITIONS: ColumnDefinition[] = [
+  { name: 'ID', field: 'id', width: 60 },
+  { name: 'タスク名', field: 'text', width: 300 },
+  { name: '開始日', field: 'start_date', width: 130 },
+  { name: '終了日', field: 'end_date', width: 130 },
+  { name: '期間', field: 'duration', width: 50 },
+  { name: '進捗率(%)', field: 'progress', width: 70 },
+  { name: '親ID', field: 'parent', width: 60 },
+  { name: '種類', field: 'kind_task', width: 50 },
+  { name: 'オーナー', field: 'owner_id', width: 70 },
+  { name: '並び順', field: 'sortorder', width: 60 },
+  { name: '色', field: 'color', width: 80 },
+  { name: '文字色', field: 'textColor', width: 80 },
+  { name: 'ToDo', field: 'ToDo', width: 120 },
+  { name: 'スケジュール', field: 'task_schedule', width: 120 },
+  { name: 'フォルダ', field: 'folder', width: 120 },
+  { name: 'URL', field: 'url_adress', width: 150 },
+  { name: 'メール', field: 'mail', width: 120 },
+  { name: 'メモ', field: 'memo', width: 200 },
+  { name: 'リンク', field: 'hyperlink', width: 150 },
+  { name: '編集日', field: 'edit_date', width: 120 },
+  { name: '作成日', field: 'created_at', width: 130 },
+  { name: '更新日', field: 'updated_at', width: 130 },
+];
+
+/** Linksシートの列 */
+export const LINK_COLUMN_DEFINITIONS: ColumnDefinition[] = [
+  { name: 'ID', field: 'id', width: 60 },
+  { name: 'ソースタスクID (source)', field: 'source', width: 120 },
+  { name: 'ターゲットタスクID (target)', field: 'target', width: 120 },
+  { name: 'リンクタイプ (type)', field: 'type', width: 100 },
+];
diff --git a/frontend/src/components/UniverSheet/gridTaskName.test.ts b/frontend/src/components/UniverSheet/gridTaskName.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..44584264b4ea94dfecdb42339abbb4be0c312576
--- /dev/null
+++ b/frontend/src/components/UniverSheet/gridTaskName.test.ts
@@ -0,0 +1,83 @@
+import { describe, it, expect } from 'vitest';
+import type { Task } from '../../types/gantt';
+import { stripLeadingNoise } from '../../utils/taskText';
+import { buildTaskNamePrefix, stripTaskNamePrefix } from './gridTaskName';
+import { LINK_COLUMN_DEFINITIONS, TASK_COLUMN_DEFINITIONS } from './gridColumns';
+
+function task(overrides: Partial<Task>): Task {
+  return {
+    id: 1,
+    text: 'Task',
+    start_date: '2026-03-10 00:00:00',
+    end_date: '2026-03-13 00:00:00',
+    duration: 3,
+    progress: 0,
+    parent: 0,
+    kind_task: 1,
+    owner_id: 0,
+    sortorder: 0,
+    ...overrides,
+  };
+}
+
+const project = task({ kind_task: 2, indent: 0 });
+const nestedTask = task({ indent: 2 });
+const linkedTask = task({ indent: 1, hyperlink: 'https://example.com/page' });
+const markdownTask = task({ hyperlink: '/vault/note.md' });
+
+describe('buildTaskNamePrefix', () => {
+  it('階層の深さ分の全角スペースと、種類に応じたアイコンを付けること', () => {
+    expect(buildTaskNamePrefix(project)).toBe('📂 ');
+    expect(buildTaskNamePrefix(nestedTask)).toBe('\u3000\u3000📄 ');
+    expect(buildTaskNamePrefix(linkedTask)).toBe('\u3000🔗 ');
+    expect(buildTaskNamePrefix(markdownTask)).toBe('📝 ');
+  });
+});
+
+describe('stripTaskNamePrefix', () => {
+  it.each([project, nestedTask, linkedTask, markdownTask])(
+    '表示用の装飾を残したまま編集しても、タスク名だけが取り出せること',
+    (target) => {
+      const cellValue = `${buildTaskNamePrefix(target)}新しい名前`;
+
+      expect(stripTaskNamePrefix(cellValue, target)).toBe('新しい名前');
+    },
+  );
+
+  it('バックエンドの除去対象に無いアイコン（📂 🔗 など）も確実に取り除けること', () => {
+    // 以前は装飾ごと送っており、バックエンドで消えないアイコンがタスク名に残っていた
+    const cellValue = `${buildTaskNamePrefix(project)}プロジェクト名`;
+
+    expect(stripLeadingNoise(cellValue)).toBe('📂 プロジェクト名');
+    expect(stripTaskNamePrefix(cellValue, project)).toBe('プロジェクト名');
+  });
+
+  it('インデントだけ消された場合もアイコンを取り除くこと', () => {
+    expect(stripTaskNamePrefix('🔗 名前', linkedTask)).toBe('名前');
+    expect(stripTaskNamePrefix('\u3000\u3000\u3000🔗名前', linkedTask)).toBe('名前');
+  });
+
+  it('セル全体を打ち直した場合は、先頭の空白だけを除いてそのまま使うこと', () => {
+    expect(stripTaskNamePrefix('  打ち直した名前', project)).toBe('打ち直した名前');
+    expect(stripTaskNamePrefix('🎨 デザイン', nestedTask)).toBe('🎨 デザイン');
+  });
+});
+
+describe('列定義', () => {
+  it('1列目がIDで、フィールド名に重複が無いこと', () => {
+    for (const definitions of [TASK_COLUMN_DEFINITIONS, LINK_COLUMN_DEFINITIONS]) {
+      const fields = definitions.map((column) => column.field);
+      expect(fields[0]).toBe('id');
+      expect(new Set(fields).size).toBe(fields.length);
+    }
+  });
+
+  it('Tasksシートは 開始日〜文字色 が3〜12列目に並んでいること（中央揃えの対象範囲）', () => {
+    const fields = TASK_COLUMN_DEFINITIONS.map((column) => column.field);
+
+    expect(fields.slice(2, 12)).toEqual([
+      'start_date', 'end_date', 'duration', 'progress', 'parent',
+      'kind_task', 'owner_id', 'sortorder', 'color', 'textColor',
+    ]);
+  });
+});
diff --git a/frontend/src/components/UniverSheet/gridTaskName.ts b/frontend/src/components/UniverSheet/gridTaskName.ts
new file mode 100644
index 0000000000000000000000000000000000000000..442be92d30c9933577aff39e0790ca90a25b7954
--- /dev/null
+++ b/frontend/src/components/UniverSheet/gridTaskName.ts
@@ -0,0 +1,50 @@
+/**
+ * グリッドのタスク名セルの装飾（インデント＋種類アイコン）
+ *
+ * グリッドはテキストしか表示できないため、タスク名の前に
+ * 「階層の深さ分の全角スペース」と「種類を表す絵文字」を付けて表示する。
+ * この装飾はDBに保存してはいけないので、編集されたセルの値からは必ず取り除く。
+ */
+import type { Task } from '../../types/gantt';
+import { getTaskIconName } from '../../utils/iconUtils';
+
+const INDENT_UNIT = '\u3000';
+const DEFAULT_ICON = '📄';
+// Ganttで使う Catppuccin アイコン名 → グリッド用の絵文字
+const ICON_BY_NAME: Record<string, string> = {
+  folder_project: '📂',
+  folder_project_open: '📂',
+  folder: '📁',
+  folder_open: '📁',
+  markdown: '📝',
+  pdf: '📕',
+  python: '🐍',
+  javascript: '📜',
+  typescript: '📜',
+  excalidraw: '🎨',
+  url: '🔗',
+};
+
+/** タスク名の前に付ける装飾（インデント＋アイコン＋半角スペース）を返す */
+export function buildTaskNamePrefix(task: Task): string {
+  const isOpen = !!task.open;
+  const icon = ICON_BY_NAME[getTaskIconName(task, isOpen, isOpen)] ?? DEFAULT_ICON;
+  return `${INDENT_UNIT.repeat(task.indent || 0)}${icon} `;
+}
+
+/**
+ * 編集後のセルの値から、表示用の装飾を取り除いてタスク名だけを返す。
+ * 装飾を残したまま編集された場合はその装飾を、セル全体を打ち直された場合は先頭の空白だけを除く。
+ */
+export function stripTaskNamePrefix(value: string, task: Task): string {
+  const prefix = buildTaskNamePrefix(task);
+  if (value.startsWith(prefix)) {
+    return value.slice(prefix.length);
+  }
+  // インデントだけ消された／アイコンの後ろの空白だけ消された、などの編集にも対応する
+  const withoutIndent = value.replace(/^[\s\u3000]+/, '');
+  const iconOnly = prefix.trim();
+  return withoutIndent.startsWith(iconOnly)
+    ? withoutIndent.slice(iconOnly.length).replace(/^[\s\u3000]+/, '')
+    : withoutIndent;
+}
