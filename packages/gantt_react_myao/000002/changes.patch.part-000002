-  // Expand all tasks - オリジナルアプリと同じ方式でgantt内部を直接操作
-  useEffect(() => {
-    if (!initialized.current || expandAllTrigger === 0) return;
-
-    gantt.eachTask(function (task) {
-      task.$open = true;
-    });
-    gantt.render();
-  }, [expandAllTrigger]);
