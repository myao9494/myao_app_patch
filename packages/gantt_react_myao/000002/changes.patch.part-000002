diff --git a/frontend/src/components/GanttChart/contextMenuItems.ts b/frontend/src/components/GanttChart/contextMenuItems.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0352a46fccdc05b1690403b6f59eaa0c96974905
--- /dev/null
+++ b/frontend/src/components/GanttChart/contextMenuItems.ts
@@ -0,0 +1,245 @@
+/**
+ * コンテキストメニューの項目生成ユーティリティ
+ * - タスク行・バー右クリック時の操作メニュー（編集、Obsidian連携、固定、フィルター追加、スケジュール追加など）
+ * - カレンダー日付ヘッダー右クリック時の休日追加・解除メニュー
+ * - カレンダー空き領域・背景セル右クリック時の新規プロジェクト・タスク追加、
+ *   スケジュール追加（行列から取得したタスク・日付）、休日メニュー
+ */
+import type { TaskKind } from '../../types/gantt';
+import { OWNERS, KIND_TASKS, COLOR_OPTIONS } from '../../constants/gantt';
+import { formatDateToYMD } from '../../utils/dateUtils';
+
+export interface ContextMenuItem {
+  label?: string;
+  icon?: string;
+  action?: () => void;
+  danger?: boolean;
+  divider?: boolean;
+  submenu?: ContextMenuItem[];
+}
+
+// タスク用のメニュー項目
+export function getTaskContextMenuItems(
+  taskId: number,
+  taskKind: number,
+  isPinned: boolean,
+  callbacks: {
+    onEdit: (id: number) => void;
+    onDelete: (id: number) => void;
+    onSetProgress: (id: number, progress: number) => void;
+    onSetOwner: (id: number, ownerId: number) => void;
+    onSetKind: (id: number, kind: string) => void;
+    onSetColor: (id: number, color: string) => void;
+    onSetTextColor: (id: number, color: string) => void;
+    onSetTimePeriod: (id: number) => void;
+    onAddChild: (parentId: number, kind: TaskKind) => void;
+    onCopy: (id: number) => void;
+    onAddSchedule: (id: number, initialDate?: Date) => void;
+    onCreateObsidian: (id: number) => void;
+    onAddToFilter: (id: number) => void;
+    onTogglePinned: (id: number, nextPinned: boolean) => void;
+  }
+): ContextMenuItem[] {
+  const items: ContextMenuItem[] = [
+    {
+      label: '子タスク追加',
+      icon: '⏰',
+      action: () => callbacks.onAddChild(taskId, 1),
+    },
+    {
+      label: '子プロジェクト追加',
+      icon: '📁',
+      action: () => callbacks.onAddChild(taskId, 2),
+    },
+    { divider: true },
+    {
+      label: 'タスク編集',
+      icon: '✏️',
+      action: () => callbacks.onEdit(taskId),
+    },
+    {
+      label: 'Obsidian (O)',
+      icon: '📝',
+      action: () => callbacks.onCreateObsidian(taskId),
+    },
+    {
+      label: isPinned ? '固定を解除' : '固定',
+      icon: isPinned ? '🟢' : '📍',
+      action: () => callbacks.onTogglePinned(taskId, !isPinned),
+    },
+    ...(taskKind == 2 ? [{ divider: true }, {
+      label: 'フィルターに追加',
+      icon: '🔍',
+      action: () => callbacks.onAddToFilter(taskId),
+    }] : []),
+    { divider: true },
+    {
+      label: '期間設定',
+      icon: '📅',
+      action: () => callbacks.onSetTimePeriod(taskId),
+    },
+    {
+      label: 'スケジュールを追加',
+      icon: '📌',
+      action: () => callbacks.onAddSchedule(taskId),
+    },
+    {
+      label: '種別変更',
+      icon: '🏷️',
+      submenu: KIND_TASKS.map((kind) => ({
+        label: kind.label,
+        action: () => callbacks.onSetKind(taskId, kind.key),
+      })),
+    },
+    {
+      label: '進捗設定',
+      icon: '📊',
+      submenu: [
+        {
+          label: '100%',
+          action: () => callbacks.onSetProgress(taskId, 1),
+        },
+        {
+          label: '75%',
+          action: () => callbacks.onSetProgress(taskId, 0.75),
+        },
+        {
+          label: '50%',
+          action: () => callbacks.onSetProgress(taskId, 0.5),
+        },
+        {
+          label: '25%',
+          action: () => callbacks.onSetProgress(taskId, 0.25),
+        },
+        {
+          label: '0%',
+          action: () => callbacks.onSetProgress(taskId, 0),
+        },
+      ],
+    },
+    {
+      label: 'バー色設定',
+      icon: '🎨',
+      submenu: COLOR_OPTIONS.map((color) => ({
+        label: color.label,
+        icon: color.key ? '■' : '□', // 色付きアイコンがあれば良いが、一旦文字で
+        action: () => callbacks.onSetColor(taskId, color.key),
+      })),
+    },
+    {
+      label: '文字色設定',
+      icon: '🅰️',
+      submenu: COLOR_OPTIONS.map((color) => ({
+        label: color.label,
+        action: () => callbacks.onSetTextColor(taskId, color.key),
+      })),
+    },
+    {
+      label: 'オーナー変更',
+      icon: '👤',
+      submenu: OWNERS.map((owner) => ({
+        label: owner.label,
+        action: () => callbacks.onSetOwner(taskId, owner.key),
+      })),
+    },
+    { divider: true },
+    {
+      label: 'コピー',
+      icon: '📋',
+      action: () => callbacks.onCopy(taskId),
+    },
+    { divider: true },
+    {
+      label: '削除',
+      icon: '🗑️',
+      danger: true,
+      action: () => callbacks.onDelete(taskId),
+    },
+  ];
+  return items;
+}
+
+// カレンダー日付ヘッダー用のメニューアイテム
+export function getDateHeaderContextMenuItems(
+  date: Date,
+  isHoliday: boolean,
+  callbacks: {
+    onAddHoliday?: (dateStr: string) => void;
+    onRemoveHoliday?: (dateStr: string) => void;
+  }
+): ContextMenuItem[] {
+  const dateStr = formatDateToYMD(date);
+  if (isHoliday) {
+    return [
+      {
+        label: `休日を解除 (${dateStr})`,
+        icon: '🗑️',
+        danger: true,
+        action: () => callbacks.onRemoveHoliday?.(dateStr),
+      },
+    ];
+  }
+  return [
+    {
+      label: `休日を追加 (${dateStr})`,
+      icon: '🎌',
+      action: () => callbacks.onAddHoliday?.(dateStr),
+    },
+  ];
+}
+
+// Menu items for empty area
+export function getEmptyAreaContextMenuItems(
+  date: Date | null,
+  callbacks: {
+    onAddProject: (date: Date | null) => void;
+    onAddTask: (date: Date | null) => void;
+    onAddSchedule?: (taskId: number, date: Date) => void;
+    onAddHoliday?: (dateStr: string) => void;
+    onRemoveHoliday?: (dateStr: string) => void;
+    isHoliday?: boolean;
+    taskId?: number | null;
+  }
+): ContextMenuItem[] {
+  const items: ContextMenuItem[] = [
+    {
+      label: '新規プロジェクト追加',
+      icon: '📁',
+      action: () => callbacks.onAddProject(date),
+    },
+    {
+      label: '新規タスク追加',
+      icon: '⏰',
+      action: () => callbacks.onAddTask(date),
+    },
+  ];
+
+  if (callbacks.taskId != null && date && callbacks.onAddSchedule) {
+    items.push({
+      label: 'スケジュールを追加',
+      icon: '📌',
+      action: () => callbacks.onAddSchedule!(callbacks.taskId!, date),
+    });
+  }
+
+  if (date && (callbacks.onAddHoliday || callbacks.onRemoveHoliday)) {
+    const dateStr = formatDateToYMD(date);
+    items.push({ divider: true });
+    if (callbacks.isHoliday) {
+      items.push({
+        label: `休日を解除 (${dateStr})`,
+        icon: '🗑️',
+        danger: true,
+        action: () => callbacks.onRemoveHoliday?.(dateStr),
+      });
+    } else {
+      items.push({
+        label: `休日を追加 (${dateStr})`,
+        icon: '🎌',
+        action: () => callbacks.onAddHoliday?.(dateStr),
+      });
+    }
+  }
+
+  return items;
+}
diff --git a/frontend/src/components/GanttChart/ganttEvents.ts b/frontend/src/components/GanttChart/ganttEvents.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7a2fa35567d16916247e331734e2ededb3dcd48e
--- /dev/null
+++ b/frontend/src/components/GanttChart/ganttEvents.ts
@@ -0,0 +1,335 @@
+/**
+ * DHTMLX Gantt のイベントハンドラ登録
+ * Gantt上の操作（更新・削除・並び替え・リンク・Undo/Redo）をバックエンドへ保存する。
+ *
+ * gantt はアプリ全体で1つのシングルトンなので、登録したハンドラは必ず解除する
+ * （解除しないと、画面を切り替えて戻るたびにハンドラが増え、保存APIが多重に呼ばれる）。
+ * attachGanttEvents() は解除用の関数を返す。
+ */
+import { gantt } from 'dhtmlx-gantt';
+import type { Link as GanttLink, Task as GanttTask } from 'dhtmlx-gantt';
+import type { Link, Task } from '../../types/gantt';
+import { reorderTasks } from '../../services/api';
+import { formatEditDate } from '../../constants/gantt';
+import { stripLeadingNoise } from '../../utils/taskText';
+import { confirmPendingAdd, protectPendingAdd, type GanttSyncState } from './ganttSync';
+import {
+  buildTaskSavePayload,
+  getSelectedTaskIds,
+  getTaskHierarchyHtml,
+  isProjectTask,
+  isTaskSelected,
+  type GanttId,
+} from './ganttTaskUtils';
+
+/** データ変更を親コンポーネント（API呼び出し側）へ伝えるコールバック */
+export interface GanttDataCallbacks {
+  /** 保存に成功したら true。false の場合、Gantt上の表示はサーバーの値へ戻される */
+  onTaskUpdate?: (id: number, task: Partial<Task>) => Promise<boolean>;
+  /** 作成されたタスクを返す（失敗時は undefined） */
+  onTaskCreate?: (task: Partial<Task>) => Promise<Task | undefined>;
+  /** 削除に成功したら true。false の場合、Gantt上にタスクが復元される */
+  onTaskDelete?: (id: number) => Promise<boolean>;
+  onLinkCreate?: (link: Omit<Link, 'id'>) => Promise<Link | undefined>;
+  onLinkUpdate?: (id: number, link: Partial<Link>) => void;
+  onLinkDelete?: (id: number) => void;
+}
+
+export interface GanttEventDeps {
+  /** 常に最新のコールバックを返す */
+  getCallbacks: () => GanttDataCallbacks;
+  getSyncState: () => GanttSyncState;
+  /** 最新の tasks / links で Gantt を同期し直す */
+  requestSync: () => void;
+  onTaskSelected: (id: GanttId) => void;
+  onContextMenu: (taskId: GanttId | null, event: MouseEvent) => void;
+}
+
+/** DHTMLXのUndo/Redo履歴に積まれる1操作分のコマンド（value / oldValue は操作対象のコピー） */
+interface UndoCommand {
+  entity: 'task' | 'link';
+  type: 'add' | 'update' | 'remove' | 'move';
+  value?: { id?: GanttId };
+}
+
+type UndoDirection = 'undo' | 'redo';
+
+function toLinkPayload(link: GanttLink): Omit<Link, 'id'> {
+  return {
+    source: Number(link.source),
+    target: Number(link.target),
+    type: Number(link.type) as Link['type'],
+  };
+}
+
+export function attachGanttEvents(deps: GanttEventDeps): () => void {
+  const eventIds: string[] = [];
+  const on = (name: string, handler: (...args: never[]) => unknown) => {
+    eventIds.push(gantt.attachEvent(name as never, handler as never, undefined as never));
+  };
+
+  // --- バックエンドへの保存 ---
+
+  const saveTask = (id: GanttId, task: GanttTask) => {
+    const { onTaskUpdate } = deps.getCallbacks();
+    const taskId = Number(id);
+    if (!onTaskUpdate || Number.isNaN(taskId)) return;
+
+    // タスク名の先頭に混入したインデント(空白)やアイコン(絵文字)を除去する
+    if (typeof task.text === 'string') {
+      task.text = stripLeadingNoise(task.text);
+    }
+
+    const state = deps.getSyncState();
+    state.pendingSaves.set(taskId, (state.pendingSaves.get(taskId) ?? 0) + 1);
+    onTaskUpdate(taskId, buildTaskSavePayload(task))
+      .catch(() => false)
+      .then((saved) => {
+        // 保存に失敗した場合は、次の同期でサーバーの値に戻す
+        if (!saved) state.lastSynced.delete(taskId);
+        const remaining = (state.pendingSaves.get(taskId) ?? 1) - 1;
+        if (remaining > 0) {
+          state.pendingSaves.set(taskId, remaining);
+        } else {
+          state.pendingSaves.delete(taskId);
+        }
+        deps.requestSync();
+      });
+  };
+
+  // 削除APIの応答待ち（タスクID → 完了を待つPromise）。直後のUndoによる再作成はこれを待ってから行う
+  const deletesInFlight = new Map<number, Promise<void>>();
+
+  const deleteTaskOnServer = (id: GanttId) => {
+    const { onTaskDelete } = deps.getCallbacks();
+    const taskId = Number(id);
+    if (!onTaskDelete || Number.isNaN(taskId)) return;
+
+    const state = deps.getSyncState();
+    state.pendingDeletes.add(taskId);
+    const settled = onTaskDelete(taskId)
+      .catch(() => false)
+      .then((deleted) => {
+        // 削除に失敗した場合は、次の同期でタスクを復元する
+        if (!deleted) state.pendingDeletes.delete(taskId);
+        if (deletesInFlight.get(taskId) === settled) deletesInFlight.delete(taskId);
+        deps.requestSync();
+      });
+    deletesInFlight.set(taskId, settled);
+  };
+
+  /**
+   * Undo/Redo でGantt上に復活したタスクを、同じIDのままバックエンドに作り直す
+   * （IDを保つことで、子タスクの親参照やリンクがそのまま有効になる）。
+   */
+  const restoreTaskOnServer = (id: GanttId) => {
+    const { onTaskCreate } = deps.getCallbacks();
+    const taskId = Number(id);
+    if (!onTaskCreate || Number.isNaN(taskId)) return;
+
+    const state = deps.getSyncState();
+    protectPendingAdd(state.pendingTaskAdds, id);
+    (deletesInFlight.get(taskId) ?? Promise.resolve())
+      .then(() => {
+        if (!gantt.isTaskExists(id)) return undefined;
+        state.pendingDeletes.delete(taskId);
+        return onTaskCreate({ ...buildTaskSavePayload(gantt.getTask(id)), id: taskId });
+      })
+      .catch(() => undefined)
+      .then((createdTask) => {
+        if (createdTask) {
+          // 作成後の再取得結果が画面に届くまでの間、古いデータでの同期に消されないよう保護を続ける
+          confirmPendingAdd(state.pendingTaskAdds, id);
+        } else {
+          // 作り直せなかった場合は保護を外し、次の同期でサーバーの状態（タスク無し）に合わせる
+          state.pendingTaskAdds.delete(String(id));
+        }
+        deps.requestSync();
+      });
+  };
+
+  /** Gantt上で引かれたリンクをバックエンドに作成し、採番されたIDへ付け替える */
+  const createLinkOnServer = (ganttId: GanttId, link: GanttLink) => {
+    const { onLinkCreate } = deps.getCallbacks();
+    if (!onLinkCreate) return;
+
+    const state = deps.getSyncState();
+    protectPendingAdd(state.pendingLinkAdds, ganttId);
+    onLinkCreate(toLinkPayload(link))
+      .catch(() => undefined)
+      .then((createdLink) => {
+        state.pendingLinkAdds.delete(String(ganttId));
+        if (createdLink?.id && gantt.isLinkExists(ganttId)) {
+          if (String(ganttId) !== String(createdLink.id)) {
+            gantt.changeLinkId(ganttId, createdLink.id);
+          }
+          confirmPendingAdd(state.pendingLinkAdds, createdLink.id);
+        }
+        deps.requestSync();
+      });
+  };
+
+  // --- タスク ---
+
+  // 読み込んだタスクはすべて開いた状態にする
+  on('onTaskLoading', (task: GanttTask) => {
+    task.$open = true;
+    return true;
+  });
+
+  // gantt.createTask() で作られるタスクの初期値
+  on('onTaskCreated', (task: GanttTask) => {
+    const today = new Date();
+    task.duration = 1;
+    task.start_date = today;
+    task.edit_date = formatEditDate(today);
+    task.kind_task = '1';
+    task.owner_id = 0;
+    return true;
+  });
+
+  // Gantt上で削除されたタスクをバックエンドからも削除する（子孫はバックエンド側でまとめて削除される）
+  on('onBeforeTaskDelete', (id: GanttId) => {
+    if (!deps.getSyncState().isSyncing) {
+      deleteTaskOnServer(id);
+    }
+    return true; // DHTMLXにデフォルトの削除処理（UI更新など）を続行させる
+  });
+
+  // タスク更新時に edit_date（編集日の履歴）へ今日を追記し、バックエンドに保存する
+  on('onAfterTaskUpdate', (id: GanttId, task: GanttTask) => {
+    if (deps.getSyncState().isSyncing) return true;
+
+    const todayStr = formatEditDate(new Date());
+    if (task.edit_date) {
+      if (!String(task.edit_date).split(',').includes(todayStr)) {
+        task.edit_date = `${task.edit_date},${todayStr}`;
+      }
+    } else {
+      task.edit_date = todayStr;
+    }
+
+    saveTask(id, task);
+    return true;
+  });
+
+  on('onTaskSelected', (id: GanttId) => {
+    deps.onTaskSelected(id);
+    return true;
+  });
+
+  // --- リンク ---
+
+  on('onAfterLinkAdd', (id: GanttId, link: GanttLink) => {
+    if (deps.getSyncState().isSyncing) return;
+    createLinkOnServer(id, link);
+  });
+
+  on('onAfterLinkUpdate', (id: GanttId, link: GanttLink) => {
+    if (deps.getSyncState().isSyncing) return;
+    deps.getCallbacks().onLinkUpdate?.(Number(id), toLinkPayload(link));
+  });
+
+  on('onAfterLinkDelete', (id: GanttId) => {
+    if (deps.getSyncState().isSyncing) return;
+    deps.getCallbacks().onLinkDelete?.(Number(id));
+  });
+
+  // --- Undo/Redo ---
+  // Undo/Redo による更新・削除・並び替え・リンク操作は、DHTMLXが通常の操作と同じイベント
+  // （onAfterTaskUpdate / onBeforeTaskDelete / onAfterTaskMove / onAfterLink*）を発火するので、
+  // 上のハンドラでそのまま保存される。
+  // タスクの「復活」（削除のUndo、追加のRedo）だけは対応するイベントが無いため、ここで保存する。
+  const handleUndoRedo = (direction: UndoDirection) => (action: { commands?: UndoCommand[] } | null) => {
+    const restoringType = direction === 'undo' ? 'remove' : 'add';
+    for (const command of action?.commands ?? []) {
+      const id = command.value?.id;
+      if (command.entity === 'task' && command.type === restoringType && id != null && gantt.isTaskExists(id)) {
+        restoreTaskOnServer(id);
+      }
+    }
+  };
+  on('onAfterUndo', handleUndoRedo('undo'));
+  on('onAfterRedo', handleUndoRedo('redo'));
+
+  // --- 行のドラッグ&ドロップ（並び替え） ---
+
+  // order_branch_free=true でも、折りたたんだプロジェクトには兄弟としてしかドロップできない。
+  // 直前の行が閉じたプロジェクトの場合は、その子として配置し直してプロジェクトを開く
+  on('onBeforeRowDragEnd', (id: GanttId) => {
+    try {
+      const globalIndex = gantt.getGlobalTaskIndex(id);
+      const previousRow = globalIndex > 0 ? gantt.getTaskByIndex(globalIndex - 1) : null;
+      if (previousRow && gantt.isTaskExists(previousRow.id)) {
+        const previousTask = gantt.getTask(previousRow.id);
+        const isDroppedAsSibling = String(gantt.getTask(id).parent) !== String(previousTask.id);
+        if (isProjectTask(previousTask) && !previousTask.$open && isDroppedAsSibling) {
+          gantt.moveTask(id, gantt.getChildren(previousTask.id).length, previousTask.id);
+          previousTask.$open = true;
+          previousTask.open = true;
+          gantt.render();
+        }
+      }
+    } catch {
+      // タスクが見つからない場合は無視
+    }
+    return true;
+  });
+
+  // 並び替え後、移動先の親に属する全兄弟の並び順（と親）をまとめて保存する
+  let isMovingSelection = false;
+  on('onAfterTaskMove', (id: GanttId, parent: GanttId, tindex: number) => {
+    if (isMovingSelection) return true;
+
+    // 複数選択中のタスクをドラッグした場合は、残りの選択タスクも直後に並べる
+    const selectedTasks = getSelectedTaskIds();
+    if (selectedTasks.length > 1 && isTaskSelected(id)) {
+      isMovingSelection = true;
+      let offset = 1;
+      for (const selectedId of selectedTasks) {
+        if (String(selectedId) !== String(id)) {
+          gantt.moveTask(selectedId, tindex + offset, parent);
+          offset++;
+        }
+      }
+      isMovingSelection = false;
+    }
+
+    const items = gantt.getChildren(parent).map((childId, index) => ({
+      id: Number(childId),
+      sortorder: index,
+      parent: Number(parent),
+    }));
+    void reorderTasks({ items });
+
+    return true;
+  });
+
+  // --- Lightbox ---
+
+  on('onBeforeLightbox', (id: GanttId) => {
+    gantt.getTask(id).hierarchy_path = getTaskHierarchyHtml(id);
+    return true;
+  });
+
+  // Lightboxを開いたらタスク名の入力欄にフォーカスする
+  on('onLightbox', () => {
+    setTimeout(() => {
+      document.querySelector<HTMLTextAreaElement>('.gantt_cal_ltext textarea')?.focus();
+    }, 0);
+  });
+
+  // --- コンテキストメニュー ---
+
+  on('onContextMenu', (taskId: GanttId | null, _linkId: GanttId | null, event: MouseEvent) => {
+    event.preventDefault();
+    deps.onContextMenu(taskId, event);
+    return false;
+  });
+
+  return () => {
+    for (const eventId of eventIds) {
+      gantt.detachEvent(eventId);
+    }
+  };
+}
diff --git a/frontend/src/components/GanttChart/ganttSetup.ts b/frontend/src/components/GanttChart/ganttSetup.ts
new file mode 100644
index 0000000000000000000000000000000000000000..686aa0600da0bd8ea64736fd9a81a5cd0ba00512
--- /dev/null
+++ b/frontend/src/components/GanttChart/ganttSetup.ts
@@ -0,0 +1,147 @@
+/**
+ * DHTMLX Gantt の静的な設定（プラグイン・基本設定・Lightbox・列・ズーム・今日マーカー）
+ * gantt.init() の前に configureGantt() を1度呼ぶ。
+ */
+import { gantt } from 'dhtmlx-gantt';
+import type { Task as GanttTask } from 'dhtmlx-gantt';
+import {
+  OWNERS,
+  KIND_TASKS,
+  COLOR_OPTIONS,
+  ZOOM_CONFIG,
+  getOwnerLabel,
+} from '../../constants/gantt';
+import { escapeHtml } from '../../utils/taskText';
+import { getTaskHierarchyHtml } from './ganttTaskUtils';
+
+export type TimeScale = 'day' | 'month' | 'quarter' | 'year';
+
+export const BASE_ROW_HEIGHT = 27;
+export const BASE_BAR_HEIGHT = 18;
+const OWNER_COLUMN_WIDTH = 60;
+const UNDO_STEPS = 10;
+const TODAY_MARKER_ID = 'today-marker';
+
+/**
+ * タイムラインの表示範囲を「今日の1年前〜1年後」に設定する。
+ * fit_tasks=false と合わせ、タスクに合わせて範囲が勝手に狭まるのを防ぐ。
+ */
+export function resetDisplayRange(): void {
+  const today = new Date();
+  const oneYearAgo = new Date(today);
+  oneYearAgo.setFullYear(oneYearAgo.getFullYear() - 1);
+  const oneYearLater = new Date(today);
+  oneYearLater.setFullYear(oneYearLater.getFullYear() + 1);
+  gantt.config.start_date = oneYearAgo;
+  gantt.config.end_date = oneYearLater;
+}
+
+/** 現在時刻を示す「Now」マーカー（赤い縦線）を追加、または現在時刻へ移動する */
+export function showTodayMarker(): void {
+  const marker = gantt.getMarker(TODAY_MARKER_ID);
+  if (marker) {
+    marker.start_date = new Date();
+    gantt.updateMarker(TODAY_MARKER_ID);
+    return;
+  }
+  gantt.addMarker({
+    id: TODAY_MARKER_ID,
+    start_date: new Date(),
+    css: 'today',
+    text: 'Now',
+  });
+}
+
+function configureLightbox(): void {
+  // 種別・オーナー・色は右クリックメニューで設定するため、Lightboxにはテキスト項目だけを置く
+  gantt.config.lightbox.sections = [
+    { name: 'hierarchy', height: 22, type: 'template', map_to: 'hierarchy_path' },
+    { name: 'description', height: 35, map_to: 'text', type: 'textarea', focus: true },
+    { name: 'hyperlink', height: 30, map_to: 'hyperlink', type: 'textarea' },
+    { name: 'ToDo', height: 60, map_to: 'ToDo', type: 'textarea' },
+    { name: 'memo', height: 60, map_to: 'memo', type: 'textarea' },
+    { name: 'task_schedule', height: 60, map_to: 'task_schedule', type: 'textarea' },
+    { name: 'edit_date', height: 35, map_to: 'edit_date', type: 'textarea' },
+  ];
+
+  gantt.locale.labels.section_hierarchy = '';
+  gantt.locale.labels.section_description = 'タスク名';
+  gantt.locale.labels.section_hyperlink = 'hyperlink';
+  gantt.locale.labels.section_ToDo = 'ToDo';
+  gantt.locale.labels.section_memo = 'memo';
+  gantt.locale.labels.section_task_schedule = 'task_schedule';
+  gantt.locale.labels.section_edit_date = 'edit_date';
+
+  // Lightbox最上部に階層パスを表示する
+  if (gantt.form_blocks?.template) {
+    gantt.form_blocks.template.set_value = (node: HTMLElement, _value: unknown, task: GanttTask) => {
+      node.innerHTML = `<div class="hierarchy-path">${getTaskHierarchyHtml(task.id)}</div>`;
+    };
+  }
+}
+
+function configureColumns(): void {
+  // 追加・複製などの操作は右クリックメニューで行う。
+  // インラインエディタの誤作動を避けるため、列に editor は定義しない
+  gantt.config.columns = [
+    {
+      name: 'text',
+      label: 'Task name',
+      tree: true,
+      width: '*', // 幅を自動調整
+      resize: true,
+      // 既定ではタスク名がHTMLとして解釈されるため、文字どおり表示する
+      template: (task: GanttTask) => escapeHtml(task.text),
+    },
+    {
+      // オーナー列の幅は一定に保つ
+      name: 'owner_id',
+      label: 'owner',
+      width: OWNER_COLUMN_WIDTH,
+      min_width: OWNER_COLUMN_WIDTH,
+      max_width: OWNER_COLUMN_WIDTH,
+      align: 'center',
+      template: (task: GanttTask) => getOwnerLabel(task.owner_id),
+      resize: false,
+    },
+  ];
+}
+
+/** gantt.init() の前に行う設定一式 */
+export function configureGantt(timeScale: TimeScale): void {
+  gantt.plugins({
+    keyboard_navigation: false,
+    undo: true,
+    marker: true,
+    multiselect: true,
+  });
+
+  gantt.config.date_format = '%Y-%m-%d %H:%i:%s';
+  gantt.config.order_branch = true;
+  gantt.config.order_branch_free = true;
+  gantt.config.sort = true;
+  gantt.config.open_tree_initially = true;
+  gantt.config.keyboard_navigation_cells = false;
+  gantt.config.row_height = BASE_ROW_HEIGHT;
+  gantt.config.bar_height = BASE_BAR_HEIGHT;
+  gantt.config.multiselect = true;
+
+  gantt.config.undo = true;
+  gantt.config.undo_steps = UNDO_STEPS;
+
+  gantt.config.fit_tasks = false;
+  resetDisplayRange();
+
+  gantt.serverList('kind_task', KIND_TASKS.map((kind) => ({ key: kind.key, label: kind.label })));
+  gantt.serverList('owner_id', OWNERS.map((owner) => ({ key: owner.key, label: owner.label })));
+  gantt.serverList('color', COLOR_OPTIONS.map((color) => ({ key: color.key, label: color.label })));
+  gantt.serverList('textColor', COLOR_OPTIONS.map((color) => ({ key: color.key, label: color.label })));
+
+  configureLightbox();
+  configureColumns();
+
+  if (gantt.ext?.zoom) {
+    gantt.ext.zoom.init(ZOOM_CONFIG as unknown as Parameters<typeof gantt.ext.zoom.init>[0]);
+    gantt.ext.zoom.setLevel(timeScale);
+  }
+}
diff --git a/frontend/src/components/GanttChart/ganttSync.ts b/frontend/src/components/GanttChart/ganttSync.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e4b61c4164d5a7bd68b016a4dacd9722a1e946db
--- /dev/null
+++ b/frontend/src/components/GanttChart/ganttSync.ts
@@ -0,0 +1,328 @@
+/**
+ * サーバーから取得したタスク・リンク（Reactのstate）を DHTMLX Gantt 内部のデータへ差分反映する。
+ *
+ * - clearAll() による全再構築は原則せず、前回反映した内容から変わったタスクだけを更新する
+ *   （ちらつき防止と、大量データでの負荷軽減のため）。
+ * - Gantt上の操作（ドラッグ・Lightbox・削除など）は先に画面へ反映され、APIの応答は後から届く。
+ *   応答待ちの間に別の再取得が走っても操作結果を巻き戻さないよう、
+ *   「保存中」「削除中」「追加中」のIDを GanttSyncState で管理する。
+ * - 反映によってAPIが再度呼ばれたり、Undo/Redo の履歴が汚れたりしないようにする。
+ *   更新と削除は gantt.silent()（イベントを発火させない）で行う。
+ *   追加だけは silent で行うと DHTMLX 内部の並び順キャッシュが更新されず行が表示されなくなるため、
+ *   通常の追加として行い、その間は Undo の記録を止め、同期中フラグでイベントハンドラ側のAPI呼び出しを止める。
+ */
+import { gantt } from 'dhtmlx-gantt';
+import type { Link, Task } from '../../types/gantt';
+import { addTaskToGantt, toGanttTask } from './ganttTaskUtils';
+
+/** 作成APIの応答が届いてから、サーバーの一覧に現れるまで待つ時間の上限 */
+const PENDING_ADD_GRACE_MS = 10_000;
+/** これより多くのタスクを一度に追加する場合（CSVインポート等）は、全体を読み込み直す */
+const BULK_ADD_THRESHOLD = 50;
+
+export interface GanttSyncState {
+  /** 最後にGanttへ反映したサーバー側タスクの内容（タスクID → シグネチャ） */
+  lastSynced: Map<number, string>;
+  /** 保存APIの応答待ち件数（タスクID → 件数）。待っている間はサーバーの値で上書きしない */
+  pendingSaves: Map<number, number>;
+  /** Gantt上では削除済みで、削除APIの応答待ちのタスクID。待っている間は復活させない */
+  pendingDeletes: Set<number>;
+  /**
+   * Gantt上に先に存在し、バックエンドへ作成中のタスク（Undoでの復活）。ID → 保護期限(ms)。
+   * 期限までは、サーバーの一覧に無くても消さない
+   */
+  pendingTaskAdds: Map<string, number>;
+  /** Gantt上に先に存在し、バックエンドへ作成中のリンク。ID → 保護期限(ms) */
+  pendingLinkAdds: Map<string, number>;
+  /** true の間は同期処理中。Ganttのイベントハンドラ側でAPI呼び出しを抑止するために参照する */
+  isSyncing: boolean;
+}
+
+export function createGanttSyncState(): GanttSyncState {
+  return {
+    lastSynced: new Map(),
+    pendingSaves: new Map(),
+    pendingDeletes: new Set(),
+    pendingTaskAdds: new Map(),
+    pendingLinkAdds: new Map(),
+    isSyncing: false,
+  };
+}
+
+/** 作成APIを呼んでいる間の保護を始める（応答が届くまで無期限） */
+export function protectPendingAdd(pending: Map<string, number>, id: string | number): void {
+  pending.set(String(id), Infinity);
+}
+
+/**
+ * 作成APIが成功した後の保護に切り替える。
+ * サーバーの一覧に現れた時点で保護は解除されるが、現れないままでも一定時間で解除する。
+ */
+export function confirmPendingAdd(pending: Map<string, number>, id: string | number): void {
+  pending.set(String(id), Date.now() + PENDING_ADD_GRACE_MS);
+}
+
+function isProtected(pending: Map<string, number>, id: string): boolean {
+  const protectedUntil = pending.get(id);
+  return protectedUntil !== undefined && Date.now() < protectedUntil;
+}
+
+/** サーバーの一覧に現れた、または期限が切れた「追加中」の記録を捨てる */
+function releasePendingAdds(pending: Map<string, number>, serverIds: Set<string>): void {
+  for (const id of pending.keys()) {
+    if (serverIds.has(id) || !isProtected(pending, id)) {
+      pending.delete(id);
+    }
+  }
+}
+
+/** タスクの内容が前回反映時から変わったかを判定するための文字列 */
+export function taskSignature(task: Task): string {
+  return JSON.stringify(task);
+}
+
+/** タスク自身か、その先祖のいずれかが削除APIの応答待ちかどうか */
+function isAwaitingDelete(task: Task, taskMap: Map<number, Task>, pendingDeletes: Set<number>): boolean {
+  if (pendingDeletes.size === 0) return false;
+  const visited = new Set<number>();
+  let current: Task | undefined = task;
+  while (current && !visited.has(current.id)) {
+    if (pendingDeletes.has(current.id)) return true;
+    visited.add(current.id);
+    current = current.parent ? taskMap.get(current.parent) : undefined;
+  }
+  return false;
+}
+
+/**
+ * 他の画面や外部から追加されたタスクを、並び順（sortorder）どおりの位置に入れるための挿入位置を返す。
+ * 兄弟の並び順はサーバー側の最新値で比べる（gantt上の値は、挿入に伴う繰り下げがまだ反映されていないため）。
+ */
+function findInsertIndex(task: Task, taskMap: Map<number, Task>): number | undefined {
+  const sortorder = task.sortorder ?? 0;
+  const index = gantt.getChildren(task.parent || 0).findIndex((siblingId) => {
+    const sibling = taskMap.get(Number(siblingId));
+    return sibling !== undefined && (sibling.sortorder ?? 0) > sortorder;
+  });
+  return index === -1 ? undefined : index;
+}
+
+function toGanttLink(link: Link) {
+  return { ...link, type: String(link.type) };
+}
+
+/** Ganttが空の状態から parse でまとめて読み込む（1件ずつ追加するより大幅に速い） */
+function loadAll(tasks: Task[], links: Link[], state: GanttSyncState): void {
+  gantt.parse({
+    data: tasks.map(toGanttTask),
+    links: links.map(toGanttLink),
+  });
+  state.lastSynced.clear();
+  for (const task of tasks) {
+    state.lastSynced.set(task.id, taskSignature(task));
+  }
+}
+
+/** 全データを読み込み直す（大量追加時用）。開閉状態は引き継ぐが、Undo/Redoの履歴は消える */
+function reloadAll(tasks: Task[], links: Link[], state: GanttSyncState): void {
+  const closedIds: (string | number)[] = [];
+  gantt.eachTask((task) => {
+    if (!task.$open) closedIds.push(task.id);
+  });
+
+  gantt.clearAll();
+  loadAll(tasks, links, state);
+
+  for (const id of closedIds) {
+    if (gantt.isTaskExists(id)) {
+      gantt.getTask(id).$open = false;
+    }
+  }
+}
+
+/**
+ * サーバーから消えたタスクの削除と、内容が変わったタスクの更新を行う（gantt.silent 内で呼ぶ）。
+ * @returns 変更の有無と、gantt にまだ無い（追加が必要な）タスク
+ */
+function removeAndUpdateTasks(
+  tasks: Task[],
+  taskMap: Map<number, Task>,
+  state: GanttSyncState,
+): { changed: boolean; missing: Task[] } {
+  let changed = false;
+  const serverIds = new Set(tasks.map((task) => String(task.id)));
+
+  // 親を消すと子も消えるので、都度存在を確認する
+  const staleIds: (string | number)[] = [];
+  gantt.eachTask((task) => {
+    const id = String(task.id);
+    if (!serverIds.has(id) && !isProtected(state.pendingTaskAdds, id)) {
+      staleIds.push(task.id);
+    }
+  });
+  for (const id of staleIds) {
+    if (gantt.isTaskExists(id)) {
+      gantt.deleteTask(id);
+      changed = true;
+    }
+  }
+
+  const missing: Task[] = [];
+  for (const task of tasks) {
+    if (!gantt.isTaskExists(task.id)) {
+      if (!isAwaitingDelete(task, taskMap, state.pendingDeletes)) {
+        missing.push(task);
+      }
+      continue;
+    }
+
+    if ((state.pendingSaves.get(task.id) ?? 0) > 0) continue;
+    const signature = taskSignature(task);
+    if (state.lastSynced.get(task.id) === signature) continue;
+
+    // 開閉状態はサーバーに保存していないので、Gantt上の状態を保つ
+    const existing = gantt.getTask(task.id);
+    const wasOpen = existing.$open;
+    Object.assign(existing, toGanttTask(task));
+    existing.$open = wasOpen;
+    existing.open = wasOpen;
+    gantt.updateTask(task.id);
+    state.lastSynced.set(task.id, signature);
+    changed = true;
+  }
+
+  return { changed, missing };
+}
+
+/** ルートからの階層の深さ（親を辿れる範囲で数える） */
+function depthOf(task: Task, taskMap: Map<number, Task>): number {
+  let depth = 0;
+  const visited = new Set<number>([task.id]);
+  let parent = task.parent ? taskMap.get(task.parent) : undefined;
+  while (parent && !visited.has(parent.id)) {
+    visited.add(parent.id);
+    depth++;
+    parent = parent.parent ? taskMap.get(parent.parent) : undefined;
+  }
+  return depth;
+}
+
+/** gantt にまだ無いタスクを、並び順どおりの位置へ追加する（Undoには記録させない） */
+function addMissingTasks(missing: Task[], taskMap: Map<number, Task>, state: GanttSyncState): void {
+  // 親が先に存在するよう、浅い階層から追加する（同じ深さの中ではサーバーの並び順のまま）
+  const parentsFirst = missing
+    .map((task) => ({ task, depth: depthOf(task, taskMap) }))
+    .sort((a, b) => a.depth - b.depth)
+    .map(({ task }) => task);
+
+  const undoEnabled = gantt.config.undo;
+  gantt.config.undo = false;
+  try {
+    for (const task of parentsFirst) {
+      addTaskToGantt(task, findInsertIndex(task, taskMap));
+      state.lastSynced.set(task.id, taskSignature(task));
+    }
+  } finally {
+    gantt.config.undo = undoEnabled;
+  }
+}
+
+function syncLinks(links: Link[], state: GanttSyncState): boolean {
+  let changed = false;
+  const serverIds = new Set(links.map((link) => String(link.id)));
+
+  for (const ganttLink of gantt.getLinks()) {
+    const id = String(ganttLink.id);
+    if (!serverIds.has(id) && !isProtected(state.pendingLinkAdds, id) && gantt.isLinkExists(ganttLink.id)) {
+      gantt.deleteLink(ganttLink.id);
+      changed = true;
+    }
+  }
+
+  for (const link of links) {
+    const next = toGanttLink(link);
+    if (!gantt.isLinkExists(link.id)) {
+      gantt.addLink(next);
+      changed = true;
+      continue;
+    }
+
+    const existing = gantt.getLink(link.id);
+    if (
+      String(existing.source) !== String(next.source) ||
+      String(existing.target) !== String(next.target) ||
+      String(existing.type) !== next.type
+    ) {
+      Object.assign(existing, next);
+      gantt.updateLink(link.id);
+      changed = true;
+    }
+  }
+
+  return changed;
+}
+
+/** サーバーに存在しなくなったID・不要になった保護の管理情報を捨てる */
+function releaseStaleState(tasks: Task[], links: Link[], state: GanttSyncState): void {
+  const serverIds = new Set(tasks.map((task) => task.id));
+  for (const id of state.lastSynced.keys()) {
+    if (!serverIds.has(id)) state.lastSynced.delete(id);
+  }
+  for (const id of state.pendingDeletes) {
+    if (!serverIds.has(id)) state.pendingDeletes.delete(id);
+  }
+  releasePendingAdds(state.pendingTaskAdds, new Set(tasks.map((task) => String(task.id))));
+  releasePendingAdds(state.pendingLinkAdds, new Set(links.map((link) => String(link.id))));
+}
+
+/**
+ * tasks / links を Gantt に差分反映する。
+ * @returns Ganttのデータを変更した場合は true（呼び出し側で再描画する）
+ */
+export function syncGanttData(tasks: Task[], links: Link[], state: GanttSyncState): boolean {
+  releaseStaleState(tasks, links, state);
+
+  state.isSyncing = true;
+  try {
+    if (state.lastSynced.size === 0 && gantt.getTaskCount() === 0) {
+      if (tasks.length === 0 && links.length === 0) return false;
+      loadAll(tasks, links, state);
+      return true;
+    }
+
+    // 同期による変更が Undo/Redo の履歴に残らないよう、前後で履歴を保存・復元する
+    const undoStack = gantt.getUndoStack ? gantt.getUndoStack().slice() : [];
+    const redoStack = gantt.getRedoStack ? gantt.getRedoStack().slice() : [];
+
+    const taskMap = new Map(tasks.map((task) => [task.id, task]));
+    let changed = false;
+    let missing: Task[] = [];
+    gantt.silent(() => {
+      ({ changed, missing } = removeAndUpdateTasks(tasks, taskMap, state));
+    });
+
+    if (missing.length > BULK_ADD_THRESHOLD) {
+      reloadAll(tasks, links, state);
+      return true;
+    }
+    if (missing.length > 0) {
+      addMissingTasks(missing, taskMap, state);
+      changed = true;
+    }
+
+    gantt.silent(() => {
+      changed = syncLinks(links, state) || changed;
+    });
+
+    if (gantt.getUndoStack) {
+      gantt.getUndoStack().splice(0, Infinity, ...undoStack);
+    }
+    if (gantt.getRedoStack) {
+      gantt.getRedoStack().splice(0, Infinity, ...redoStack);
+    }
+
+    return changed;
+  } finally {
+    state.isSyncing = false;
+  }
+}
diff --git a/frontend/src/components/GanttChart/ganttTaskUtils.ts b/frontend/src/components/GanttChart/ganttTaskUtils.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5b6ab5e4f514cef11695d240a437562e4b207542
--- /dev/null
+++ b/frontend/src/components/GanttChart/ganttTaskUtils.ts
@@ -0,0 +1,221 @@
+/**
+ * ガントチャート（DHTMLX Gantt）のタスクを扱う小さなヘルパー群
+ * - APIのタスク（日付は文字列）⇔ Gantt内部のタスク（日付は Date）の変換
+ * - 階層パス・ハイパーリンク・複数選択・タイムライン上の座標解決
+ */
+import { gantt } from 'dhtmlx-gantt';
+import type { Task as GanttTask } from 'dhtmlx-gantt';
+import type { Task } from '../../types/gantt';
+import { formatDateString } from '../../constants/gantt';
+import { escapeHtml } from '../../utils/taskText';
+import {
+  resolveTimelineCellContext,
+  type TimelineShortcutContext,
+} from '../../utils/ganttTimelineShortcut';
+
+export type GanttId = string | number;
+
+/** ローカルファイルを開くための外部 open-path API（ポート8001で別途稼働） */
+const OPEN_PATH_API_URL = 'http://localhost:8001/api/fullpath';
+
+/** "YYYY-MM-DD HH:mm:ss" 形式の文字列を Date に変換する（不正な値は undefined） */
+export function parseTaskDate(value: string | Date | null | undefined): Date | undefined {
+  if (!value) return undefined;
+  if (value instanceof Date) return value;
+  const parsed = new Date(String(value).replace(' ', 'T'));
+  return Number.isNaN(parsed.getTime()) ? undefined : parsed;
+}
+
+/**
+ * APIのタスクをGanttに渡す形へ変換する。
+ * DHTMLX Gantt内部の "date.getFullYear is not a function" エラーを避けるため、日付は必ず Date にする。
+ */
+export function toGanttTask(task: Task) {
+  return {
+    ...task,
+    start_date: parseTaskDate(task.start_date),
+    end_date: parseTaskDate(task.end_date),
+    open: task.expanded !== false,
+  };
+}
+
+/**
+ * サーバーで作成済みのタスクを gantt に追加する（開いた状態で追加する）。
+ * @param index 親の子タスク内での挿入位置。省略時は末尾
+ */
+export function addTaskToGantt(task: Task, index?: number): void {
+  const now = new Date();
+  const ganttTask = toGanttTask(task);
+  gantt.addTask(
+    {
+      ...ganttTask,
+      start_date: ganttTask.start_date ?? now,
+      end_date: ganttTask.end_date ?? now,
+      open: true,
+      $open: true,
+    },
+    task.parent || 0,
+    index,
+  );
+}
+
+/** anchorId のタスクの直後にあたる挿入位置を返す（anchorId が parentId の子でなければ undefined） */
+export function indexAfterTask(anchorId: GanttId | undefined, parentId: GanttId): number | undefined {
+  if (anchorId === undefined || !gantt.isTaskExists(anchorId)) return undefined;
+  if (String(gantt.getTask(anchorId).parent || 0) !== String(parentId || 0)) return undefined;
+  return gantt.getTaskIndex(anchorId) + 1;
+}
+
+/** Gantt内部のタスクから、バックエンドへ保存する項目を取り出す */
+export function buildTaskSavePayload(task: GanttTask): Partial<Task> {
+  return {
+    text: task.text,
+    start_date: task.start_date instanceof Date ? formatDateString(task.start_date) : task.start_date,
+    end_date: task.end_date instanceof Date ? formatDateString(task.end_date) : task.end_date,
+    duration: task.duration,
+    progress: task.progress,
+    parent: Number(task.parent) || 0,
+    kind_task: task.kind_task,
+    owner_id: task.owner_id,
+    sortorder: task.sortorder,
+    hyperlink: task.hyperlink,
+    ToDo: task.ToDo,
+    memo: task.memo,
+    task_schedule: task.task_schedule,
+    edit_date: task.edit_date,
+    color: task.color,
+    textColor: task.textColor,
+    is_pinned: Boolean(task.is_pinned),
+  };
+}
+
+export function isProjectTask(task: GanttTask): boolean {
+  return String(task.kind_task) === '2';
+}
+
+/** "[id]タスク名" 形式のラベル（HTMLエスケープ済み）。separator はIDと名前の間に入れる文字 */
+export function buildTaskLabelHtml(task: GanttTask, separator = ''): string {
+  const text = escapeHtml(task.text);
+  return task.id ? `[${escapeHtml(task.id)}]${separator}${text}` : text;
+}
+
+/** ルートからそのタスクまでの階層パス（"[1]親 > [2]子"、HTMLエスケープ済み）を返す */
+export function getTaskHierarchyHtml(taskId: GanttId): string {
+  try {
+    let task = gantt.getTask(taskId);
+    const hierarchy: string[] = [];
+
+    while (task) {
+      hierarchy.unshift(buildTaskLabelHtml(task));
+
+      if (task.parent && task.parent !== 0 && gantt.isTaskExists(task.parent)) {
+        task = gantt.getTask(task.parent);
+      } else {
+        break;
+      }
+    }
+
+    return hierarchy.join(' &gt; ');
+  } catch {
+    return '';
+  }
+}
+
+/** ハイパーリンクをブラウザで開けるURLにする（ローカルパスは open-path API 経由） */
+export function formatHyperlink(link: string): string {
+  if (!link) return '';
+  if (link.startsWith('http://') || link.startsWith('https://')) {
+    return link;
+  }
+  // すでにエンコードされている（%が含まれる）場合はそのまま渡す。
+  // そうでない場合はエンコードして渡す（二重エンコード防止）
+  const encodedPath = link.includes('%') ? link : encodeURIComponent(link);
+  return `${OPEN_PATH_API_URL}?path=${encodedPath}`;
+}
+
+/** リンク先が Obsidian Vault（obsidianHome 配下）のファイルかどうか */
+export function isObsidianLink(link: string, obsidianHome: string): boolean {
+  const trimmedLink = link.trim();
+  const trimmedHome = obsidianHome.trim();
+  if (!trimmedLink || !trimmedHome) return false;
+  return (
+    trimmedLink === trimmedHome ||
+    trimmedLink.startsWith(`${trimmedHome}/`) ||
+    trimmedLink.startsWith(`${trimmedHome}\\`)
+  );
+}
+
+/** Shift+クリック等で複数選択されているタスクIDを返す */
+export function getSelectedTaskIds(): GanttId[] {
+  return gantt.getSelectedTasks ? gantt.getSelectedTasks() : [];
+}
+
+export function isTaskSelected(taskId: GanttId): boolean {
+  return getSelectedTaskIds().map(String).includes(String(taskId));
+}
+
+/**
+ * 右クリック等の操作対象タスクを決める。
+ * 複数選択中で、対象タスクがその選択に含まれていれば選択全体、そうでなければそのタスクのみ。
+ */
+export function resolveTargetTaskIds(taskId: number): number[] {
+  const selectedTasks = getSelectedTaskIds();
+  return selectedTasks.length > 1 && isTaskSelected(taskId)
+    ? selectedTasks.map(Number)
+    : [taskId];
+}
+
+function getTimelineElement(): HTMLElement | undefined {
+  return gantt.$task_data as HTMLElement | undefined;
+}
+
+/** タイムライン上の縦位置（スクロール込みのY座標）から行インデックスを求める */
+function getRowIndexByTopPosition(top: number): number {
+  const timelineView = gantt.$ui.getView('timeline') as {
+    getItemIndexByTopPosition?: (top: number) => number;
+  } | null;
+  return timelineView?.getItemIndexByTopPosition?.(top) ?? -1;
+}
+
+/** マウス座標のX位置に対応するタイムライン上の日時を返す */
+export function dateFromClientX(clientX: number): Date | null {
+  const timeline = getTimelineElement();
+  if (!timeline) return null;
+  const rect = timeline.getBoundingClientRect();
+  const date = gantt.dateFromPos(clientX - rect.left + timeline.scrollLeft);
+  return date && !Number.isNaN(date.getTime()) ? date : null;
+}
+
+/** マウス座標のY位置にある行のタスクIDを返す */
+export function taskIdFromClientY(clientY: number): number | null {
+  const timeline = getTimelineElement();
+  if (!timeline) return null;
+  const rect = timeline.getBoundingClientRect();
+  const index = getRowIndexByTopPosition(clientY - rect.top + timeline.scrollTop);
+  if (index < 0) return null;
+
+  const task = gantt.getTaskByIndex(index);
+  if (!task?.id || !gantt.isTaskExists(task.id)) return null;
+  return Number(task.id);
+}
+
+/** マウス座標から、タイムライン上の行（タスクID）と列（日付）を解決する */
+export function resolveTimelineContext(
+  clientX: number,
+  clientY: number,
+  eventTarget: EventTarget | null,
+): TimelineShortcutContext | null {
+  const timeline = getTimelineElement();
+  if (!timeline) return null;
+  return resolveTimelineCellContext({
+    clientX,
+    clientY,
+    timelineElement: timeline,
+    taskAttribute: gantt.config.task_attribute,
+    eventTarget,
+    dateFromPos: (x) => gantt.dateFromPos(x),
+    getItemIndexByTopPosition: getRowIndexByTopPosition,
+    getTaskByIndex: (index) => gantt.getTaskByIndex(index),
+    locateTask: (element) => gantt.locate(element as unknown as Event),
+  });
+}
diff --git a/frontend/src/components/GanttChart/ganttTemplates.ts b/frontend/src/components/GanttChart/ganttTemplates.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5037d5ffe42a09c1d670d5e89bc6aa7dbbaff458
--- /dev/null
+++ b/frontend/src/components/GanttChart/ganttTemplates.ts
@@ -0,0 +1,160 @@
+/**
+ * ガントチャートの表示テンプレート（タスクバー・右側テキスト・ツリーアイコン・セル背景）
+ * DHTMLX Gantt のテンプレートはHTML文字列を返すため、タスク名などユーザー入力は必ずエスケープする。
+ */
+import { gantt } from 'dhtmlx-gantt';
+import type { Task as GanttTask } from 'dhtmlx-gantt';
+import type { BusinessTripType, Task } from '../../types/gantt';
+import { getTaskKindClass } from '../../constants/gantt';
+import { getTaskIconName } from '../../utils/iconUtils';
+import { formatDateForSchedule, parseSchedule } from '../../utils/scheduleParser';
+import { escapeHtml } from '../../utils/taskText';
+import { buildTaskLabelHtml, isProjectTask, type GanttId } from './ganttTaskUtils';
+
+const ICON_BASE_PATH = '/icons/catppuccin';
+const ONE_DAY_MS = 24 * 60 * 60 * 1000;
+
+// プロジェクトバー内のラベル。スケジュールのピン(z-index: 5)より手前に置き、
+// ラッパーは pointer-events: none で背面のクリックを通し、ラベル（リンク）だけクリック可能にする
+const BAR_LABEL_WRAPPER_STYLE =
+  'position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 10; pointer-events: none; display: flex; align-items: center; overflow: visible;';
+const BAR_LABEL_STYLE =
+  'margin-left: 30px; pointer-events: auto; flex-shrink: 0; white-space: nowrap; display: inline-block;';
+
+/** テンプレートが参照する、コンポーネント側の最新状態 */
+export interface GanttTemplateState {
+  /** 休日として背景を塗る日付（YYYY-MM-DD） */
+  getHolidays: () => Set<string>;
+  /** 出張日（YYYY-MM-DD → 種別） */
+  getBusinessTrips: () => Map<string, BusinessTripType>;
+  /** Cmd+矢印キーでフォーカス中のタスクID（フォーカスモードでなければ null） */
+  getKeyboardFocusTaskId: () => GanttId | null;
+}
+
+/**
+ * タスクのスケジュール（task_schedule）をバー上のピン📌として描画するHTMLを返す。
+ * ピンは対象日のセルの中央に置く。data-* 属性はピンの右クリック・ドラッグ処理で使う。
+ */
+export function buildScheduleHtml(task: GanttTask): string {
+  if (!task.task_schedule) return '';
+
+  const taskStartPos = gantt.posFromDate(task.start_date as Date);
+  return parseSchedule(task.task_schedule)
+    .map((event) => {
+      const eventPos = gantt.posFromDate(event.date);
+      const dayCellWidth = gantt.posFromDate(new Date(event.date.getTime() + ONE_DAY_MS)) - eventPos;
+      const relativeLeft = eventPos - taskStartPos + dayCellWidth * 0.5;
+      const dateStr = formatDateForSchedule(event.date);
+      // ツールチップには日付とテキストだけを出す（時刻 00:00:00 などは除く）
+      const text = escapeHtml(event.text.replace(/\d{2}:\d{2}:\d{2}/g, '').trim());
+
+      return `
+          <div
+            class="gantt-schedule-event"
+            data-task-id="${escapeHtml(task.id)}"
+            data-schedule-index="${event.sourceIndex ?? 0}"
+            data-schedule-date="${dateStr}"
+            data-schedule-text="${text}"
+            style="left: ${relativeLeft}px; top: 0; margin-left: -5px;"
+          >
+            <div class="gantt-schedule-icon">📌</div>
+            <div class="gantt-schedule-tooltip">${dateStr} ${text}</div>
+          </div>
+        `;
+    })
+    .join('');
+}
+
+/** ハイパーリンク付きならクリックで開けるリンク、なければ fallbackTag で包んだHTMLを返す */
+function wrapWithHyperlink(task: GanttTask, innerHtml: string, style = '', fallbackTag = ''): string {
+  const styleAttr = style ? ` style="${style}"` : '';
+  if (task.hyperlink) {
+    return `<a href="#" data-task-id="${escapeHtml(task.id)}" data-hyperlink="${escapeHtml(task.hyperlink)}"${styleAttr}>${innerHtml}</a>`;
+  }
+  return fallbackTag ? `<${fallbackTag}${styleAttr}>${innerHtml}</${fallbackTag}>` : innerHtml;
+}
+
+/** タスクバー内: タスク/マイルストーンはピンのみ、プロジェクトは "[id]名前" ラベルも表示する */
+function taskBarText(_start: Date, _end: Date, task: GanttTask): string {
+  const scheduleHtml = buildScheduleHtml(task);
+  const kind = String(task.kind_task);
+  if (kind === '1' || kind === '3') {
+    return scheduleHtml;
+  }
+
+  const labelHtml = wrapWithHyperlink(task, buildTaskLabelHtml(task), BAR_LABEL_STYLE, 'span');
+  return `${scheduleHtml}<div style="${BAR_LABEL_WRAPPER_STYLE}">${labelHtml}</div>`;
+}
+
+/** バー右側: タスク/マイルストーンのみ "[id] 名前 > [親id] 親の名前" を表示する */
+function taskRightsideText(_start: Date, _end: Date, task: GanttTask): string {
+  if (isProjectTask(task)) {
+    return '';
+  }
+
+  let displayHtml = buildTaskLabelHtml(task, ' ');
+  if (task.parent && task.parent !== 0 && gantt.isTaskExists(task.parent)) {
+    displayHtml += ` &gt; ${buildTaskLabelHtml(gantt.getTask(task.parent), ' ')}`;
+  }
+  return wrapWithHyperlink(task, displayHtml);
+}
+
+/**
+ * タスクバーまわりのテンプレートを設定する。
+ * 印刷モードではバー内を空にし、右側にタスク名だけを表示する。
+ */
+export function applyTaskBarTemplates(isPrintMode: boolean): void {
+  if (isPrintMode) {
+    gantt.templates.task_text = () => '';
+    gantt.templates.rightside_text = (_start: Date, _end: Date, task: GanttTask) => escapeHtml(task.text);
+    return;
+  }
+  gantt.templates.task_text = taskBarText;
+  gantt.templates.rightside_text = taskRightsideText;
+}
+
+function treeIconHtml(task: GanttTask, cssClass: string, isOpen: boolean, isFolder: boolean): string {
+  const iconName = getTaskIconName(task as unknown as Task, isOpen, isFolder);
+  const extension = iconName === 'excalidraw' ? 'ico' : 'svg';
+  return `<div class='gantt_tree_icon ${cssClass}' style='background-image:url(${ICON_BASE_PATH}/${iconName}.${extension})'></div>`;
+}
+
+/** モードに依存しないテンプレート（行・セルのクラス、ツリーアイコン）を設定する */
+export function applyStaticTemplates(state: GanttTemplateState): void {
+  gantt.templates.task_class = (_start: Date, _end: Date, task: GanttTask) => {
+    const classes = [getTaskKindClass(task.kind_task)];
+    if (task.is_pinned) {
+      classes.push('pinned-task');
+    }
+    return classes.join(' ');
+  };
+
+  // 出張日 > 土日・休日 の優先順で背景クラスを決める
+  gantt.templates.timeline_cell_class = (_task: GanttTask, date: Date) => {
+    const dateKey = formatDateForSchedule(date);
+    const tripType = state.getBusinessTrips().get(dateKey);
+    if (tripType === 'normal_trip') {
+      return 'business-trip-normal';
+    }
+    if (tripType === 'day_trip') {
+      return 'business-trip-day';
+    }
+    if (date.getDay() === 0 || date.getDay() === 6 || state.getHolidays().has(dateKey)) {
+      return 'weekend';
+    }
+    return '';
+  };
+
+  // Cmd+矢印キーでのフォーカス移動中の行を強調する
+  const keyboardFocusRowClass = (_start: Date, _end: Date, task: GanttTask) =>
+    task.id === state.getKeyboardFocusTaskId() ? 'keyboard-focus-row' : '';
+  gantt.templates.grid_row_class = keyboardFocusRowClass;
+  gantt.templates.task_row_class = keyboardFocusRowClass;
+
+  // ツリーのデフォルトアイコンを Catppuccin アイコンに置き換える
+  gantt.templates.grid_folder = (task: GanttTask) => {
+    const isOpen = !!(task.$open || task.open);
+    return treeIconHtml(task, `gantt_folder_${isOpen ? 'open' : 'closed'}`, isOpen, true);
+  };
+  gantt.templates.grid_file = (task: GanttTask) => treeIconHtml(task, 'gantt_file', false, false);
+}
diff --git a/frontend/src/components/GanttChart/timelinePointer.ts b/frontend/src/components/GanttChart/timelinePointer.ts
new file mode 100644
index 0000000000000000000000000000000000000000..48ac5245ded6e7c96811c08675b3dc308f95a1e2
--- /dev/null
+++ b/frontend/src/components/GanttChart/timelinePointer.ts
@@ -0,0 +1,63 @@
+/**
+ * タイムライン上のマウス位置の追跡
+ * 「S」キー（マウス位置のタスク・日付にスケジュールを追加）で、
+ * キーを押した時点でマウスが指している行（タスク）と列（日付）を解決するために使う。
+ */
+import { gantt } from 'dhtmlx-gantt';
+import type { TimelineShortcutContext } from '../../utils/ganttTimelineShortcut';
+import { resolveTimelineContext } from './ganttTaskUtils';
+
+export interface TimelinePointerTracker {
+  /** マウスがタイムライン上にあれば、その位置のタスクと日付を返す */
+  getShortcutTarget: () => TimelineShortcutContext | null;
+  detach: () => void;
+}
+
+/** gantt.init() の後に呼ぶこと（タイムライン要素が必要なため） */
+export function trackTimelinePointer(): TimelinePointerTracker {
+  const timeline = gantt.$task_data as HTMLElement | undefined;
+  if (!timeline) {
+    return { getShortcutTarget: () => null, detach: () => {} };
+  }
+
+  let isPointerInside = false;
+  let lastPosition: { clientX: number; clientY: number } | null = null;
+  let lastResolved: TimelineShortcutContext | null = null;
+
+  const resolveAt = (clientX: number, clientY: number) =>
+    resolveTimelineContext(clientX, clientY, document.elementFromPoint(clientX, clientY));
+
+  const handlePointer = (event: MouseEvent) => {
+    const rect = timeline.getBoundingClientRect();
+    isPointerInside =
+      event.clientX >= rect.left &&
+      event.clientX <= rect.right &&
+      event.clientY >= rect.top &&
+      event.clientY <= rect.bottom;
+    if (!isPointerInside) return;
+
+    lastPosition = { clientX: event.clientX, clientY: event.clientY };
+    lastResolved = resolveAt(event.clientX, event.clientY) ?? lastResolved;
+  };
+
+  const handleLeave = () => {
+    isPointerInside = false;
+  };
+
+  document.addEventListener('mousemove', handlePointer, true);
+  document.addEventListener('mousedown', handlePointer, true);
+  timeline.addEventListener('mouseleave', handleLeave, true);
+
+  return {
+    getShortcutTarget: () => {
+      if (!isPointerInside || !lastPosition) return null;
+      // スクロール等で位置がずれている可能性があるため、キー入力時点で解決し直す
+      return resolveAt(lastPosition.clientX, lastPosition.clientY) ?? lastResolved;
+    },
+    detach: () => {
+      document.removeEventListener('mousemove', handlePointer, true);
+      document.removeEventListener('mousedown', handlePointer, true);
+      timeline.removeEventListener('mouseleave', handleLeave, true);
+    },
+  };
+}
diff --git a/frontend/src/components/GanttChart/useGanttKeyboard.ts b/frontend/src/components/GanttChart/useGanttKeyboard.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ac05d900998c767b6804df9638be254e8a14d702
--- /dev/null
+++ b/frontend/src/components/GanttChart/useGanttKeyboard.ts
@@ -0,0 +1,370 @@
+/**
+ * ガントチャートのキーボードショートカット
+ *
+ * Lightbox（タスク編集）表示中:
+ *   Enter 保存 / Shift+Enter 改行 / Tab・Shift+Tab 入力欄の移動 / Esc キャンセル（DHTMLX標準）
+ * チャート上:
+ *   Ctrl(Cmd)+Z 元に戻す / Ctrl(Cmd)+Shift+Z・Ctrl(Cmd)+Y やり直し
+ *   ↑↓ 選択の移動 / Shift+↑↓ 複数選択 / Ctrl(Cmd)+↑↓ フォーカスのみ移動 / Ctrl(Cmd)+Enter フォーカス行の選択切替
+ *   Enter 編集 / Delete・Backspace 選択タスクの削除
+ *   A タスク追加 / S マウス位置のタスク・日付にスケジュール追加 / O Obsidianノート作成
+ *   Ctrl(Cmd)+C コピー / Ctrl(Cmd)+V 選択タスクの後ろへ貼り付け
+ */
+import { useEffect, type RefObject } from 'react';
+import { gantt } from 'dhtmlx-gantt';
+import type { Task } from '../../types/gantt';
+import type { TimelineShortcutContext } from '../../utils/ganttTimelineShortcut';
+import {
+  addTaskToGantt,
+  getSelectedTaskIds,
+  indexAfterTask,
+  isProjectTask,
+  isTaskSelected,
+  type GanttId,
+} from './ganttTaskUtils';
+
+const COPIED_TASK_IDS_KEY = 'gantt_copied_task_ids';
+// 複数ID対応前の保存形式（単一ID）。読み取りのみ対応する
+const LEGACY_COPIED_TASK_ID_KEY = 'gantt_copied_task_id';
+const LIGHTBOX_SAVE_BUTTON_SELECTOR = '.gantt_btn_set.gantt_save_btn_set';
+const LIGHTBOX_INPUT_SELECTOR = '.gantt_cal_light textarea';
+
+/** キーボード操作の起点となる「現在の行」 */
+export interface KeyboardCursor {
+  /** 最後に選択、またはフォーカス移動した行のタスクID */
+  taskId: GanttId | null;
+  /** true の間は Ctrl(Cmd)+矢印キーによるフォーカス移動中（選択は変えず、フォーカス行を強調表示する） */
+  isFocusMode: boolean;
+}
+
+export interface GanttKeyboardActions {
+  addChildTask: (parentId: number, insertAfterSortOrder?: number) => Promise<Task | undefined>;
+  addRootTask: (insertAfterSortOrder?: number) => Promise<Task | undefined>;
+  cloneTask: (taskId: number, targetId?: number) => Promise<Task | undefined>;
+  createObsidianNote: (taskId: number) => void;
+  openScheduleModal: (taskId: number, date: Date) => void;
+  /** マウスが指しているタイムライン上のタスクと日付（タイムライン外なら null） */
+  getTimelinePointerTarget: () => TimelineShortcutContext | null;
+  scrollTaskIntoView: (taskId: GanttId) => void;
+}
+
+function isTypingTarget(element: Element | null, extraTags: string[] = []): boolean {
+  const tag = element?.tagName.toLowerCase() ?? '';
+  return ['input', 'textarea', ...extraTags].includes(tag);
+}
+
+/**
+ * Lightbox表示中のキー操作。
+ * DHTMLX標準では Enter で改行できないため、Enter=保存 / Shift+Enter=改行 に割り当て直す。
+ */
+export function handleLightboxKeyDown(event: KeyboardEvent): void {
+  if (event.key === 'Enter' && !event.isComposing) {
+    if (event.shiftKey) {
+      // テキストエリア内での改行を許可し、DHTMLX標準の「Enterで保存」は止める
+      event.stopPropagation();
+      return;
+    }
+    event.preventDefault();
+    event.stopPropagation();
+    document.querySelector<HTMLElement>(LIGHTBOX_SAVE_BUTTON_SELECTOR)?.click();
+    return;
+  }
+
+  if (event.key === 'Tab') {
+    const inputs = Array.from(document.querySelectorAll<HTMLTextAreaElement>(LIGHTBOX_INPUT_SELECTOR));
+    if (inputs.length === 0) return;
+
+    event.preventDefault();
+    event.stopPropagation();
+    const currentIndex = inputs.indexOf(document.activeElement as HTMLTextAreaElement);
+    const step = event.shiftKey ? -1 : 1;
+    const nextIndex = currentIndex === -1
+      ? (event.shiftKey ? inputs.length - 1 : 0)
+      : (currentIndex + step + inputs.length) % inputs.length;
+    inputs[nextIndex].focus();
+  }
+  // Esc はDHTMLX標準のキャンセル処理に任せる
+}
+
+function readCopiedTaskIds(): number[] {
+  const stored = sessionStorage.getItem(COPIED_TASK_IDS_KEY);
+  let ids: unknown[] = [];
+  if (stored) {
+    try {
+      const parsed: unknown = JSON.parse(stored);
+      if (Array.isArray(parsed)) ids = parsed;
+    } catch {
+      // 壊れた値は無視する
+    }
+  } else {
+    const legacyId = sessionStorage.getItem(LEGACY_COPIED_TASK_ID_KEY);
+    if (legacyId) ids = [legacyId];
+  }
+  return ids.map(Number).filter((id) => !Number.isNaN(id));
+}
+
+function clearSelection(): void {
+  gantt.unselectTask();
+  for (const taskId of getSelectedTaskIds()) {
+    gantt.unselectTask(taskId);
+  }
+}
+
+export function useGanttKeyboard(
+  cursorRef: RefObject<KeyboardCursor>,
+  actionsRef: RefObject<GanttKeyboardActions>,
+): void {
+  useEffect(() => {
+    const currentTaskId = (): GanttId | null => cursorRef.current.taskId || gantt.getSelectedId();
+
+    /** Ctrl(Cmd)+Z: 元に戻す / Ctrl(Cmd)+Shift+Z・Ctrl(Cmd)+Y: やり直し */
+    const handleUndoRedo = (event: KeyboardEvent) => {
+      event.preventDefault();
+      if (event.key.toLowerCase() === 'y' || event.shiftKey) {
+        gantt.redo();
+      } else {
+        gantt.undo();
+      }
+    };
+
+    /** Enter: 編集画面を開く / Ctrl(Cmd)+Enter: フォーカス行の選択を切り替える */
+    const handleEnter = (event: KeyboardEvent, modifierPressed: boolean) => {
+      // Lightbox以外のモーダルや入力欄でのEnterを、ガント上のEnterと誤認しない
+      if (isTypingTarget(document.activeElement, ['button', 'select'])) return;
+
+      const activeId = currentTaskId();
+      if (!activeId) return;
+
+      event.preventDefault();
+      if (modifierPressed) {
+        if (isTaskSelected(activeId)) {
+          gantt.unselectTask(activeId);
+        } else {
+          gantt.selectTask(activeId);
+        }
+        gantt.render();
+        return;
+      }
+
+      cursorRef.current.isFocusMode = false;
+      gantt.showLightbox(activeId);
+    };
+
+    /** Delete / Backspace: 選択中のタスクをまとめて削除し、その上の行を選択する */
+    const handleDelete = (event: KeyboardEvent) => {
+      if (isTypingTarget(document.activeElement)) return;
+
+      const selectedTasks = getSelectedTaskIds();
+      if (selectedTasks.length === 0) return;
+
+      event.preventDefault();
+      if (!window.confirm(`選択された ${selectedTasks.length} 件のタスクを削除しますか？`)) return;
+
+      // 選択の中で最も上に表示されている行の、1つ上の行を覚えておく
+      const topMostTaskId = selectedTasks.reduce((top, id) =>
+        gantt.getGlobalTaskIndex(id) < gantt.getGlobalTaskIndex(top) ? id : top
+      );
+      const previousId = gantt.getPrev(topMostTaskId);
+
+      for (const taskId of [...selectedTasks]) {
+        // 親と一緒に既に削除されている場合がある
+        if (gantt.isTaskExists(taskId)) {
+          gantt.deleteTask(taskId);
+        }
+      }
+
+      if (previousId && gantt.isTaskExists(previousId)) {
+        gantt.selectTask(previousId);
+        cursorRef.current.taskId = previousId;
+      } else {
+        cursorRef.current.taskId = null;
+      }
+    };
+
+    /** ↑↓: 選択の移動 / Shift+↑↓: 複数選択の伸縮 / Ctrl(Cmd)+↑↓: フォーカスのみ移動 */
+    const handleArrow = (event: KeyboardEvent, modifierPressed: boolean) => {
+      const activeId = currentTaskId();
+      if (!activeId) return;
+
+      event.preventDefault();
+      const nextId = event.key === 'ArrowUp' ? gantt.getPrev(activeId) : gantt.getNext(activeId);
+      if (!nextId) return;
+
+      const cursor = cursorRef.current;
+      if (event.shiftKey) {
+        if (isTaskSelected(nextId)) {
+          // 選択範囲を縮める：現在の行の選択を解除して戻る
+          gantt.unselectTask(activeId);
+        } else {
+          gantt.selectTask(nextId);
+        }
+      } else if (modifierPressed) {
+        cursor.isFocusMode = true;
+      } else {
+        for (const taskId of getSelectedTaskIds()) {
+          gantt.unselectTask(taskId);
+        }
+        cursor.isFocusMode = false;
+        gantt.selectTask(nextId);
+      }
+      cursor.taskId = nextId;
+      if (cursor.isFocusMode) {
+        gantt.render(); // フォーカス行の強調表示を更新する
+      }
+      actionsRef.current.scrollTaskIntoView(nextId);
+    };
+
+    /**
+     * A: タスクを追加してすぐ編集画面を開く。
+     * 現在の行がプロジェクトならその子として、タスクならその直下（同じ親）に追加する。
+     */
+    const handleAddTask = async (event: KeyboardEvent) => {
+      if (isTypingTarget(document.activeElement)) return;
+
+      const activeId = currentTaskId();
+      if (!activeId || !gantt.isTaskExists(activeId)) return;
+
+      event.preventDefault();
+      const task = gantt.getTask(activeId);
+      const parentId = task.parent ? Number(task.parent) : 0;
+      const actions = actionsRef.current;
+
+      let createdTask: Task | undefined;
+      if (isProjectTask(task)) {
+        createdTask = await actions.addChildTask(Number(activeId));
+      } else if (parentId === 0) {
+        createdTask = await actions.addRootTask(task.sortorder);
+      } else {
+        createdTask = await actions.addChildTask(parentId, task.sortorder);
+      }
+
+      if (createdTask?.id) {
+        gantt.showLightbox(createdTask.id);
+      }
+    };
+
+    /** S: マウスが指しているタスク・日付を初期値にしてスケジュール追加モーダルを開く */
+    const handleAddSchedule = (event: KeyboardEvent) => {
+      if (isTypingTarget(document.activeElement, ['button', 'select'])) return;
+
+      const target = actionsRef.current.getTimelinePointerTarget();
+      if (!target || !gantt.isTaskExists(target.taskId)) return;
+
+      event.preventDefault();
+      actionsRef.current.openScheduleModal(target.taskId, target.date);
+    };
+
+    /** O: 現在の行のタスクにObsidianノートを作成する */
+    const handleCreateObsidianNote = (event: KeyboardEvent) => {
+      if (isTypingTarget(document.activeElement)) return;
+
+      const activeId = currentTaskId();
+      if (!activeId || !gantt.isTaskExists(activeId)) return;
+
+      event.preventDefault();
+      actionsRef.current.createObsidianNote(Number(activeId));
+    };
+
+    /** Ctrl(Cmd)+C: 選択中のタスクIDを表示順（上から下）で覚える */
+    const handleCopy = (event: KeyboardEvent) => {
+      const selectedTasks = getSelectedTaskIds();
+      const selectedId = gantt.getSelectedId();
+      const copiedIds = selectedTasks.length > 0
+        ? [...selectedTasks].sort((a, b) => gantt.getGlobalTaskIndex(a) - gantt.getGlobalTaskIndex(b))
+        : (selectedId ? [selectedId] : []);
+      if (copiedIds.length === 0) return;
+
+      event.preventDefault();
+      sessionStorage.setItem(COPIED_TASK_IDS_KEY, JSON.stringify(copiedIds));
+    };
+
+    /** Ctrl(Cmd)+V: コピーしたタスクを、選択中のタスクの後ろへ順に複製し、複製したタスクを選択する */
+    const handlePaste = (event: KeyboardEvent) => {
+      const copiedIds = readCopiedTaskIds();
+      if (copiedIds.length === 0) return;
+
+      event.preventDefault();
+      const selectedId = gantt.getSelectedId();
+      let targetId = selectedId ? Number(selectedId) : undefined;
+
+      const paste = async () => {
+        const createdIds: number[] = [];
+
+        for (const copiedId of copiedIds) {
+          // 貼り付け先の指定がなければ、バックエンドはコピー元の直後に挿入する
+          const anchorId = targetId ?? copiedId;
+          const createdTask = await actionsRef.current.cloneTask(copiedId, targetId);
+          if (!createdTask?.id) continue;
+
+          createdIds.push(createdTask.id);
+          // 次のタスクは、いま作ったタスクの後ろに挿入する
+          targetId = createdTask.id;
+
+          // ganttに直接追加してUndoの履歴に記録させる（差分同期は履歴に影響しない）
+          if (!gantt.isTaskExists(createdTask.id)) {
+            addTaskToGantt(createdTask, indexAfterTask(anchorId, createdTask.parent || 0));
+          }
+        }
+
+        if (createdIds.length === 0) return;
+
+        // Ganttの再描画を待ってから、複製したタスクをすべて選択状態にする
+        setTimeout(() => {
+          clearSelection();
+          for (const id of createdIds) {
+            if (gantt.isTaskExists(id)) {
+              gantt.selectTask(id);
+            }
+          }
+          cursorRef.current.taskId = createdIds[createdIds.length - 1];
+        }, 100);
+      };
+
+      void paste();
+    };
+
+    const handleKeyDown = (event: KeyboardEvent) => {
+      if (gantt.getState().lightbox) {
+        handleLightboxKeyDown(event);
+        return;
+      }
+
+      const modifierPressed = event.ctrlKey || event.metaKey;
+      const key = event.key.toLowerCase();
+
+      if (modifierPressed && ['z', 'y', 'c', 'v'].includes(key)) {
+        // 入力欄（検索ボックスやモーダル）では、ブラウザ標準の元に戻す・コピー・貼り付けを優先する
+        if (isTypingTarget(document.activeElement)) return;
+
+        if (key === 'c') {
+          handleCopy(event);
+        } else if (key === 'v') {
+          handlePaste(event);
+        } else {
+          handleUndoRedo(event);
+        }
+        return;
+      }
+
+      if (event.key === 'Enter') {
+        handleEnter(event, modifierPressed);
+      } else if (event.key === 'Delete' || event.key === 'Backspace') {
+        handleDelete(event);
+      } else if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {
+        handleArrow(event, modifierPressed);
+      } else if (!modifierPressed && key === 'a') {
+        void handleAddTask(event);
+      } else if (!modifierPressed && key === 's') {
+        handleAddSchedule(event);
+      } else if (!modifierPressed && key === 'o') {
+        handleCreateObsidianNote(event);
+      }
+    };
+
+    // capture phaseで登録し、DHTMLX内部のイベント処理より先に捕捉する
+    document.addEventListener('keydown', handleKeyDown, true);
+    return () => {
+      document.removeEventListener('keydown', handleKeyDown, true);
+    };
+  }, [cursorRef, actionsRef]);
+}
diff --git a/frontend/src/components/GanttChart/useSchedulePins.ts b/frontend/src/components/GanttChart/useSchedulePins.ts
new file mode 100644
index 0000000000000000000000000000000000000000..743daea688b2e94ee67b5b8766a8f827fbbc60e2
--- /dev/null
+++ b/frontend/src/components/GanttChart/useSchedulePins.ts
@@ -0,0 +1,176 @@
+/**
+ * タスクバー上のスケジュールピン（📌）の操作
+ * - 右クリック: スケジュール名の編集・削除メニュー
+ * - ドラッグ&ドロップ: 別の日付へ移動（別の行に落とすと、そのタスクのスケジュールへ移す）
+ * ピンは ganttTemplates.buildScheduleHtml が出力する data-* 属性付きの要素。
+ */
+import { useEffect, type RefObject } from 'react';
+import { gantt } from 'dhtmlx-gantt';
+import type { ContextMenuItem } from './contextMenuItems';
+import {
+  addOrUpdateSchedule,
+  formatDateForSchedule,
+  getScheduleAtIndex,
+  moveScheduleAtIndex,
+  removeScheduleAtIndex,
+} from '../../utils/scheduleParser';
+import { dateFromClientX, taskIdFromClientY } from './ganttTaskUtils';
+
+// この距離(px)以上動かしたらクリックではなくドラッグとみなす
+const DRAG_THRESHOLD_PX = 3;
+
+export interface SchedulePin {
+  taskId: number;
+  /** task_schedule 内での、そのスケジュールの位置（パース順） */
+  sourceIndex: number;
+  text: string;
+  date: Date;
+}
+
+export interface SchedulePinHandlers {
+  /** タスクの task_schedule を保存する */
+  saveSchedule: (taskId: number, newSchedule: string) => void;
+  /** スケジュール編集モーダルを開く */
+  editPin: (pin: SchedulePin) => void;
+  showContextMenu: (x: number, y: number, items: ContextMenuItem[]) => void;
+}
+
+interface PinDragState {
+  taskId: number;
+  sourceIndex: number;
+  startX: number;
+  startY: number;
+  element: HTMLElement;
+  dragged: boolean;
+}
+
+function findPinElement(target: EventTarget | null): HTMLElement | null {
+  if (!(target instanceof Element)) return null;
+  const element = target.closest('.gantt-schedule-event');
+  return element instanceof HTMLElement ? element : null;
+}
+
+function readPin(element: HTMLElement): SchedulePin | null {
+  const taskId = Number(element.dataset.taskId);
+  const sourceIndex = Number(element.dataset.scheduleIndex);
+  const date = new Date(`${element.dataset.scheduleDate || ''}T00:00:00`);
+
+  if (!taskId || Number.isNaN(sourceIndex) || Number.isNaN(date.getTime())) {
+    return null;
+  }
+  return { taskId, sourceIndex, text: element.dataset.scheduleText || '', date };
+}
+
+export function useSchedulePins(
+  containerRef: RefObject<HTMLDivElement | null>,
+  handlersRef: RefObject<SchedulePinHandlers>,
+): void {
+  useEffect(() => {
+    const container = containerRef.current;
+    if (!container) return;
+
+    let dragState: PinDragState | null = null;
+
+    const handleContextMenu = (event: MouseEvent) => {
+      const element = findPinElement(event.target);
+      const pin = element && readPin(element);
+      if (!pin) return;
+
+      event.preventDefault();
+      event.stopPropagation();
+      handlersRef.current.showContextMenu(event.clientX, event.clientY, [
+        {
+          label: 'スケジュール名を編集',
+          icon: '✏️',
+          action: () => handlersRef.current.editPin(pin),
+        },
+        {
+          label: 'スケジュールを削除',
+          icon: '🗑️',
+          danger: true,
+          action: () => {
+            const currentSchedule = gantt.getTask(pin.taskId).task_schedule || '';
+            handlersRef.current.saveSchedule(pin.taskId, removeScheduleAtIndex(currentSchedule, pin.sourceIndex));
+          },
+        },
+      ]);
+    };
+
+    const handleMouseDown = (event: MouseEvent) => {
+      if (event.button !== 0) return;
+      const element = findPinElement(event.target);
+      const pin = element && readPin(element);
+      if (!element || !pin) return;
+
+      // タスクバー自体のドラッグ（DHTMLX）を始めさせない
+      event.preventDefault();
+      event.stopPropagation();
+      dragState = {
+        taskId: pin.taskId,
+        sourceIndex: pin.sourceIndex,
+        startX: event.clientX,
+        startY: event.clientY,
+        element,
+        dragged: false,
+      };
+      element.classList.add('dragging');
+    };
+
+    const handleMouseMove = (event: MouseEvent) => {
+      if (!dragState) return;
+
+      const deltaX = event.clientX - dragState.startX;
+      const deltaY = event.clientY - dragState.startY;
+      if (Math.abs(deltaX) > DRAG_THRESHOLD_PX || Math.abs(deltaY) > DRAG_THRESHOLD_PX) {
+        dragState.dragged = true;
+      }
+      dragState.element.style.transform = `translate(${deltaX}px, ${deltaY}px)`;
+    };
+
+    const handleMouseUp = (event: MouseEvent) => {
+      const finished = dragState;
+      if (!finished) return;
+
+      finished.element.classList.remove('dragging');
+      finished.element.style.transform = '';
+      dragState = null;
+
+      if (!finished.dragged || !gantt.isTaskExists(finished.taskId)) return;
+
+      const targetDate = dateFromClientX(event.clientX);
+      if (!targetDate) return;
+
+      const sourceSchedule = gantt.getTask(finished.taskId).task_schedule || '';
+      const movedEvent = getScheduleAtIndex(sourceSchedule, finished.sourceIndex);
+      if (!movedEvent) return;
+
+      const targetTaskId = taskIdFromClientY(event.clientY) ?? finished.taskId;
+      const targetDateStr = formatDateForSchedule(targetDate);
+      const { saveSchedule } = handlersRef.current;
+
+      if (targetTaskId === finished.taskId) {
+        saveSchedule(finished.taskId, moveScheduleAtIndex(sourceSchedule, finished.sourceIndex, targetDateStr));
+        return;
+      }
+
+      if (!gantt.isTaskExists(targetTaskId)) return;
+
+      // 別のタスクの行に落とした場合は、元のタスクから外して移動先のタスクに追加する
+      const targetSchedule = gantt.getTask(targetTaskId).task_schedule || '';
+      saveSchedule(finished.taskId, removeScheduleAtIndex(sourceSchedule, finished.sourceIndex));
+      saveSchedule(targetTaskId, addOrUpdateSchedule(targetSchedule, targetDateStr, movedEvent.text));
+    };
+
+    container.addEventListener('contextmenu', handleContextMenu, true);
+    container.addEventListener('mousedown', handleMouseDown, true);
+    document.addEventListener('mousemove', handleMouseMove, true);
+    document.addEventListener('mouseup', handleMouseUp, true);
+
+    return () => {
+      container.removeEventListener('contextmenu', handleContextMenu, true);
+      container.removeEventListener('mousedown', handleMouseDown, true);
+      document.removeEventListener('mousemove', handleMouseMove, true);
+      document.removeEventListener('mouseup', handleMouseUp, true);
+    };
+  }, [containerRef, handlersRef]);
+}
diff --git a/frontend/src/components/GanttChart/useTimelineScroll.ts b/frontend/src/components/GanttChart/useTimelineScroll.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f5a1e884c54c1e41ce90e6f8d328e5fa5206b684
--- /dev/null
+++ b/frontend/src/components/GanttChart/useTimelineScroll.ts
@@ -0,0 +1,132 @@
+/**
+ * タイムラインのスクロール操作
+ * - 空き領域の左ドラッグ／中ボタンドラッグで、掴んで動かすようにスクロールする
+ * - マウスホイールの縦方向入力で、Gantt全体を縦スクロールする
+ */
+import { useEffect, type RefObject } from 'react';
+import { gantt } from 'dhtmlx-gantt';
+
+const MIDDLE_BUTTON = 1;
+const LEFT_BUTTON = 0;
+
+// DHTMLXがドラッグ・クリックを処理する要素。ここから始まる左ドラッグはスクロールにしない
+const DHTMLX_INTERACTIVE_SELECTOR =
+  '.gantt_task_line, .gantt_task_content, .gantt_task_progress, .gantt_task_drag, .gantt_link_control, .gantt_link_point, .gantt_task_link';
+const INTERACTIVE_CLASSES = [
+  'gantt_task_line', 'gantt_task_content',
+  'gantt_link_control', 'gantt_link_point', 'gantt_link_line',
+  'gantt_task_drag',
+  'gantt_hor_scroll', 'gantt_ver_scroll',
+];
+const INTERACTIVE_TAGS = ['circle', 'path', 'INPUT', 'TEXTAREA', 'A', 'SELECT'];
+// 左側グリッドと日付ヘッダーでは、左ドラッグでのスクロールを行わない
+const NON_SCROLL_AREA_SELECTOR = '.gantt_grid, .gantt_grid_scale, .gantt_task_scale';
+
+/** 左ボタンでのドラッグスクロールを開始してよい「空き領域」かどうか */
+function isEmptyTimelineArea(event: MouseEvent, container: HTMLElement): boolean {
+  // DHTMLXが既にドラッグを処理中
+  if ((gantt.getState() as { drag_id?: unknown }).drag_id) return false;
+
+  // z-index の都合で event.target が背景になることがあるため、クリック位置にある全要素を調べる
+  const elementsAtPoint = document.elementsFromPoint(event.clientX, event.clientY);
+  if (elementsAtPoint.some((element) => element.closest(DHTMLX_INTERACTIVE_SELECTOR))) return false;
+
+  const targetNode = event.target as Node | null;
+  const target = targetNode instanceof Element ? targetNode : targetNode?.parentElement;
+  if (!target) return false;
+
+  if (target.closest(NON_SCROLL_AREA_SELECTOR)) return false;
+  if (gantt.locate(event)) return false;
+
+  for (let current: Element | null = target; current && current !== container; current = current.parentElement) {
+    const element = current;
+    if (
+      element.closest(DHTMLX_INTERACTIVE_SELECTOR) ||
+      INTERACTIVE_CLASSES.some((className) => element.classList.contains(className)) ||
+      INTERACTIVE_TAGS.includes(element.tagName)
+    ) {
+      return false;
+    }
+  }
+  return true;
+}
+
+export function useTimelineDragScroll(containerRef: RefObject<HTMLDivElement | null>): void {
+  useEffect(() => {
+    const container = containerRef.current;
+    if (!container) return;
+
+    let isDragging = false;
+    let startX = 0;
+    let startY = 0;
+    let startScrollX = 0;
+    let startScrollY = 0;
+
+    const handleMouseDown = (event: MouseEvent) => {
+      if (event.button !== MIDDLE_BUTTON && event.button !== LEFT_BUTTON) return;
+      if (event.button === LEFT_BUTTON && !isEmptyTimelineArea(event, container)) return;
+
+      event.preventDefault();
+      isDragging = true;
+      startX = event.clientX;
+      startY = event.clientY;
+      const scrollState = gantt.getScrollState();
+      startScrollX = scrollState.x;
+      startScrollY = scrollState.y;
+      container.style.cursor = 'grabbing';
+    };
+
+    const handleMouseMove = (event: MouseEvent) => {
+      if (!isDragging) return;
+      event.preventDefault();
+      gantt.scrollTo(startScrollX - (event.clientX - startX), startScrollY - (event.clientY - startY));
+    };
+
+    const handleMouseUp = (event: MouseEvent) => {
+      if (!isDragging) return;
+      if (event.button === MIDDLE_BUTTON) event.preventDefault();
+      isDragging = false;
+      container.style.cursor = 'default';
+    };
+
+    container.addEventListener('mousedown', handleMouseDown, { capture: true });
+    window.addEventListener('mousemove', handleMouseMove);
+    window.addEventListener('mouseup', handleMouseUp);
+
+    return () => {
+      container.removeEventListener('mousedown', handleMouseDown, { capture: true });
+      window.removeEventListener('mousemove', handleMouseMove);
+      window.removeEventListener('mouseup', handleMouseUp);
+    };
+  }, [containerRef]);
+}
+
+export function useVerticalWheelScroll(containerRef: RefObject<HTMLDivElement | null>): void {
+  useEffect(() => {
+    const container = containerRef.current;
+    if (!container) return;
+
+    const handleWheel = (event: WheelEvent) => {
+      if (event.defaultPrevented) return;
+      // 横方向が主のスクロールはDHTMLXに任せる
+      if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
+
+      const target = event.target;
+      if (target instanceof Element && target.closest('.gantt_hor_scroll, .gantt_ver_scroll')) {
+        return;
+      }
+
+      const scrollState = gantt.getScrollState();
+      const nextY = Math.max(0, scrollState.y + event.deltaY);
+      if (nextY === scrollState.y) return;
+
+      event.preventDefault();
+      gantt.scrollTo(scrollState.x, nextY);
+    };
+
+    container.addEventListener('wheel', handleWheel, { passive: false });
+    return () => {
+      container.removeEventListener('wheel', handleWheel);
+    };
+  }, [containerRef]);
+}
