diff --git a/frontend/src/utils/__tests__/taskText.test.ts b/frontend/src/utils/__tests__/taskText.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a6e14d2963f7751d03e0dcc14bf2190203ad18d6
--- /dev/null
+++ b/frontend/src/utils/__tests__/taskText.test.ts
@@ -0,0 +1,41 @@
+import { describe, it, expect } from 'vitest';
+import { escapeHtml, stripLeadingNoise } from '../taskText';
+
+describe('stripLeadingNoise', () => {
+  it('先頭の半角・全角スペースとタブを取り除くこと', () => {
+    expect(stripLeadingNoise(' \t\u3000\u3000タスク名')).toBe('タスク名');
+  });
+
+  it('UIがタスク名の前に付けるアイコンを取り除くこと', () => {
+    expect(stripLeadingNoise('\u3000📁 プロジェクト')).toBe('プロジェクト');
+    expect(stripLeadingNoise('📄📌 タスク')).toBe('タスク');
+  });
+
+  it('それ以外の絵文字で始まるタスク名は壊さずにそのまま残すこと', () => {
+    // u フラグの無い正規表現では、サロゲートペアの片方だけが削れて文字化けしていた
+    expect(stripLeadingNoise('📊 レポート')).toBe('📊 レポート');
+    expect(stripLeadingNoise('🚀 リリース')).toBe('🚀 リリース');
+    expect(stripLeadingNoise('  🔥 重要')).toBe('🔥 重要');
+  });
+
+  it('先頭以外のアイコンや空白には触れないこと', () => {
+    expect(stripLeadingNoise('資料 📁 整理 ')).toBe('資料 📁 整理 ');
+  });
+
+  it('null / undefined は空文字として扱うこと', () => {
+    expect(stripLeadingNoise(null)).toBe('');
+    expect(stripLeadingNoise(undefined)).toBe('');
+  });
+});
+
+describe('escapeHtml', () => {
+  it('HTMLとして解釈される文字をエスケープすること', () => {
+    expect(escapeHtml(`<b>A&B</b> "x" 'y'`)).toBe('&lt;b&gt;A&amp;B&lt;/b&gt; &quot;x&quot; &#39;y&#39;');
+  });
+
+  it('文字列以外も文字列化して返すこと', () => {
+    expect(escapeHtml(42)).toBe('42');
+    expect(escapeHtml(null)).toBe('');
+    expect(escapeHtml(undefined)).toBe('');
+  });
+});
diff --git a/frontend/src/utils/autoMoveTasks.ts b/frontend/src/utils/autoMoveTasks.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c76d5130b6acb58bdc336f0fdb815eb55a74261c
--- /dev/null
+++ b/frontend/src/utils/autoMoveTasks.ts
@@ -0,0 +1,62 @@
+/**
+ * 「タスク自動移動」の移動計画を立てるユーティリティ
+ *
+ * 開始日が今日以前の未完了タスクを、期間（日数）を保ったまま前倒し/後ろ倒しする:
+ * - タスク（kind 1）: 開始日を今日にする
+ * - プロジェクト（kind 2）: 開始日を直近の月曜日にする
+ * 完了済み・固定（ピン留め）・マイルストーン・開始日が未来のものは動かさない。
+ */
+import { formatDateString } from '../constants/gantt';
+import type { Task } from '../types/gantt';
+
+export interface TaskMove {
+  id: number;
+  start_date: string;
+  end_date: string;
+}
+
+function startOfDay(date: Date): Date {
+  const result = new Date(date);
+  result.setHours(0, 0, 0, 0);
+  return result;
+}
+
+/** 基準日を含む週の月曜日（基準日が月曜ならその日） */
+export function getMostRecentMonday(baseDate: Date): Date {
+  const result = startOfDay(baseDate);
+  result.setDate(result.getDate() - ((result.getDay() + 6) % 7));
+  return result;
+}
+
+export function planAutoMove(tasks: Task[], now: Date = new Date()): TaskMove[] {
+  const today = startOfDay(now);
+  const recentMonday = getMostRecentMonday(today);
+  const moves: TaskMove[] = [];
+
+  for (const task of tasks) {
+    if (task.progress >= 1 || task.is_pinned || !task.start_date) continue;
+
+    const currentStart = startOfDay(new Date(String(task.start_date).replace(' ', 'T')));
+    if (currentStart.getTime() > today.getTime()) continue;
+
+    let targetStart: Date;
+    if (task.kind_task === 1) {
+      targetStart = today;
+    } else if (task.kind_task === 2) {
+      targetStart = recentMonday;
+    } else {
+      continue;
+    }
+    if (currentStart.getTime() === targetStart.getTime()) continue;
+
+    const targetEnd = new Date(targetStart);
+    targetEnd.setDate(targetEnd.getDate() + (task.duration || 1));
+    moves.push({
+      id: task.id,
+      start_date: formatDateString(targetStart),
+      end_date: formatDateString(targetEnd),
+    });
+  }
+
+  return moves;
+}
