+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd "$ROOT_DIR"
+
 BACKEND_PORT=8000
 
 # Colors for output
@@ -40,8 +44,11 @@ echo ""
 echo "-----------------------------------"
 echo "Starting Backend (Serving Frontend)..."
 echo "-----------------------------------"
+# backend/.venv（Python 3.14）を用意する（詳細は backend/ensure_venv.sh）
+source "$ROOT_DIR/backend/ensure_venv.sh"
+ensure_backend_venv || exit 1
 cd backend
