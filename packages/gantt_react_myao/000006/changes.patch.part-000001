diff --git a/backend/tests/test_python_env.py b/backend/tests/test_python_env.py
new file mode 100644
index 0000000000000000000000000000000000000000..05ccbe4b61c548b7fd9a37283749f990b175f332
--- /dev/null
+++ b/backend/tests/test_python_env.py
@@ -0,0 +1,106 @@
+"""
+Python 実行環境（backend/.venv）の用意と起動スクリプトの約束を確かめるテスト。
+
+仕様（CLAUDE.md「起動」）:
+- Python は 3.14（Mac・会社の Windows とも 3.14.9）。サーバーは常に backend/.venv の Python で起動する
+- 会社の Windows 端末には uv が無い。setup_windows.bat が pip だけで backend\\.venv を作り、
+  uv.lock から書き出した requirements-lock.txt（版固定）を入れる。Windows の起動バッチは uv を使わない
+- macOS の start_app.sh / start_dev.sh は backend/ensure_venv.sh で venv を用意してから、その Python で起動する
+"""
+import re
+import tomllib
+from pathlib import Path
+
+BACKEND_DIR = Path(__file__).resolve().parent.parent
+ROOT_DIR = BACKEND_DIR.parent
+
+
+def _normalize(name: str) -> str:
+    return re.sub(r"[-_.]+", "-", name).lower()
+
+
+def _locked_versions() -> dict[str, str]:
+    """uv.lock に記録された依存パッケージ（プロジェクト自身を除く）の名前と版"""
+    data = tomllib.loads((BACKEND_DIR / "uv.lock").read_text(encoding="utf-8"))
+    return {
+        _normalize(pkg["name"]): pkg["version"]
+        for pkg in data["package"]
+        if "virtual" not in pkg.get("source", {}) and "editable" not in pkg.get("source", {})
+    }
+
+
+def _pinned_versions() -> dict[str, str]:
+    """requirements-lock.txt で == 固定されたパッケージの名前と版"""
+    pinned: dict[str, str] = {}
+    for line in (BACKEND_DIR / "requirements-lock.txt").read_text(encoding="utf-8").splitlines():
+        line = line.split("#", 1)[0].strip()
+        if not line:
+            continue
+        match = re.match(r"^([A-Za-z0-9._-]+)==([^\s;]+)", line)
+        assert match, f"== で版を固定していない行があります: {line}"
+        pinned[_normalize(match.group(1))] = match.group(2)
+    return pinned
+
+
+def _read_crlf_batch(name: str) -> str:
+    """CRLF で保存されていることを確かめてから中身を返す（LF だと cmd が行を読み違える）"""
+    raw = (ROOT_DIR / name).read_bytes()
+    assert b"\n" not in raw.replace(b"\r\n", b""), f"{name} に LF だけの改行があります"
+    return raw.decode("utf-8")
+
+
+def test_requirements_lock_pins_every_package_in_uv_lock():
+    assert _pinned_versions() == _locked_versions()
+
+
+def test_requirements_lock_keeps_windows_only_packages():
+    text = (BACKEND_DIR / "requirements-lock.txt").read_text(encoding="utf-8")
+    assert re.search(r"^colorama==.*sys_platform == 'win32'", text, re.MULTILINE)
+
+
+def test_python_version_is_314():
+    assert (BACKEND_DIR / ".python-version").read_text(encoding="utf-8").strip() == "3.14.9"
+
+
+def test_setup_windows_batch_contract():
+    script = _read_crlf_batch("setup_windows.bat")
+
+    # Python 3.14 を py ランチャー → python の順に探し、uv には頼らない
+    assert script.index("py -3.14") < script.index('set "PY_CMD=python"')
+    assert "sys.version_info[:2] == (3, 14)" in script
+    assert not re.search(r"^\s*uv\s", script, re.MULTILINE | re.IGNORECASE)
+
+    # backend\.venv を作り（壊れている・版が違うときは作り直す）、版固定の一覧を入れる
+    assert "%PY_CMD% -m venv --clear .venv" in script
+    assert '"%VENV_PY%" -m pip install -r requirements-lock.txt' in script
+    assert "/nopause" in script
+
+    labels = {line.strip()[1:].lower() for line in script.splitlines() if line.strip().startswith(":") and not line.strip().startswith("::")}
+    goto_targets = {line.strip().split(":")[-1].lower() for line in script.splitlines() if "goto :" in line.lower()}
+    assert goto_targets <= labels
+
+
+def test_windows_start_batches_use_backend_venv_without_uv():
+    for name in ("start_app.bat", "start_dev.bat"):
+        script = _read_crlf_batch(name)
+        assert "uv run" not in script, name
+        assert r'set "PYTHON_EXE=%~dp0backend\.venv\Scripts\python.exe"' in script, name
+        assert r'call "%~dp0setup_windows.bat" /nopause' in script, name
+        assert '"%PYTHON_EXE%" -m uvicorn main:app' in script, name
+
+
+def test_mac_start_scripts_use_backend_venv():
+    for name in ("start_app.sh", "start_dev.sh"):
+        script = (ROOT_DIR / name).read_text(encoding="utf-8")
+        assert 'source "$ROOT_DIR/backend/ensure_venv.sh"' in script, name
+        assert '"$BACKEND_PYTHON" -m uvicorn main:app' in script, name
+        assert "uv run" not in script, name
+
+
+def test_ensure_venv_script_contract():
+    script = (BACKEND_DIR / "ensure_venv.sh").read_text(encoding="utf-8")
+    # uv があれば uv.lock どおりに揃え、無ければ pip で requirements-lock.txt を入れる
+    assert "uv sync --frozen --inexact" in script
+    assert "requirements-lock.txt" in script
+    assert "-m venv --clear" in script
+    assert "sys.version_info[:2] == (3, 14)" in script
diff --git a/setup_windows.bat b/setup_windows.bat
new file mode 100644
index 0000000000000000000000000000000000000000..007213c30273e8181f3b087200de260ee9e3545d
--- /dev/null
+++ b/setup_windows.bat
@@ -0,0 +1,66 @@
+@echo off
+setlocal
+rem ==============================================================================
+rem Gantt - Windows 用セットアップ（backend\.venv を作る）
+rem
+rem 会社PC向け（uv なし・pip だけで用意する）:
+rem 1. Python 3.14 を探す（py -3.14 → python の順）。3.14 が無ければ止める
+rem 2. backend\.venv を作る。既にあって Python 3.14 で動くならそのまま使い、
+rem    壊れている・版が違う（Mac で作った venv など）ときは作り直す（消すのは .venv の中身だけ）
+rem 3. pip を更新し、backend\requirements-lock.txt（uv.lock と同じ版に固定）を入れる
+rem    requirements.txt は下限だけで新しすぎる版が入るため使わない
+rem 4. fastapi / uvicorn / sqlalchemy が import できるか確かめる
+rem
+rem 使い方: setup_windows.bat をダブルクリック。何度実行してもよい。
+rem   start_app.bat / start_dev.bat から呼ぶときは /nopause を付ける（最後に止まらない）
+rem   社内プロキシが必要な場合は、先に pip の設定（pip.ini や HTTPS_PROXY）を済ませておく
+rem ==============================================================================
+
+set "BACKEND_DIR=%~dp0backend"
+set "VENV_PY=%BACKEND_DIR%\.venv\Scripts\python.exe"
+set "NOPAUSE="
+if /i "%~1"=="/nopause" set "NOPAUSE=1"
+
+cd /d "%BACKEND_DIR%" || goto :fail
+
+rem --- Python 3.14 を探す ---
+set "PY_CMD="
+py -3.14 -c "import sys" >nul 2>&1 && set "PY_CMD=py -3.14"
+if not defined PY_CMD (
+    python -c "import sys; sys.exit(0 if sys.version_info[:2] == (3, 14) else 1)" >nul 2>&1 && set "PY_CMD=python"
+)
+if not defined PY_CMD (
+    echo [Setup] ERROR: Python 3.14 was not found. Install Python 3.14 and add it to PATH.
+    goto :fail
+)
+for /f "delims=" %%v in ('%PY_CMD% -V 2^>^&1') do echo [Setup] Using %%v [%PY_CMD%]
+
+rem --- backend\.venv を用意する ---
+set "VENV_OK="
+if exist "%VENV_PY%" (
+    "%VENV_PY%" -c "import sys; sys.exit(0 if sys.version_info[:2] == (3, 14) else 1)" >nul 2>&1 && set "VENV_OK=1"
+)
+if defined VENV_OK (
+    echo [Setup] Reusing backend\.venv
+) else (
+    echo [Setup] Creating backend\.venv ...
+    %PY_CMD% -m venv --clear .venv || goto :fail
+)
+
+rem --- 依存パッケージを入れる ---
+echo [Setup] Upgrading pip ...
+"%VENV_PY%" -m pip install --upgrade pip
+echo [Setup] Installing backend\requirements-lock.txt ...
+"%VENV_PY%" -m pip install -r requirements-lock.txt || goto :fail
+
+echo [Setup] Verifying installation ...
+"%VENV_PY%" -c "import fastapi, uvicorn, sqlalchemy, multipart, sys; print('[Setup] Python', sys.version.split()[0], '/ fastapi', fastapi.__version__, '/ sqlalchemy', sqlalchemy.__version__)" || goto :fail
+
+echo [Setup] Done. Start the app with start_app.bat or start_dev.bat.
+if not defined NOPAUSE pause
+exit /b 0
+
+:fail
+echo [Setup] Setup failed. See the messages above.
+if not defined NOPAUSE pause
+exit /b 1
diff --git a/start_app.bat b/start_app.bat
index b71e19f3a6850cce5153758b969d8e023dfa6e99..1c651765c461f6025ea4364a4d4be2f509e549d4 100644
--- a/start_app.bat
+++ b/start_app.bat
@@ -4,6 +4,21 @@ setlocal
 :: Define ports
 set BACKEND_PORT=8000
 
+:: ---------------------------------------------------------
+:: 0. Python: backend\.venv only (created by setup_windows.bat, no uv needed)
+:: ---------------------------------------------------------
+cd /d "%~dp0"
+set "PYTHON_EXE=%~dp0backend\.venv\Scripts\python.exe"
+if not exist "%PYTHON_EXE%" (
+    echo backend\.venv was not found. Running setup_windows.bat ...
+    call "%~dp0setup_windows.bat" /nopause
+)
+if not exist "%PYTHON_EXE%" (
+    echo Failed to prepare backend\.venv. Run setup_windows.bat and check the messages.
+    pause
+    exit /b 1
+)
+
 echo Starting Gantt Chart Application...
 echo.
 
@@ -29,7 +44,7 @@ echo.
 :: ---------------------------------------------------------
 echo Starting Backend...
 cd backend
-start "Gantt Backend" cmd /k "echo Starting Backend... & uv run uvicorn main:app --reload --host 0.0.0.0 --port %BACKEND_PORT%"
+start "Gantt Backend" cmd /k ""%PYTHON_EXE%" -m uvicorn main:app --reload --host 0.0.0.0 --port %BACKEND_PORT%"
 cd ..
 
 echo.
diff --git a/start_app.sh b/start_app.sh
index be9530af8ac5a08f4e3fb33b892836c7d7c0d649..ca16d6ae3d4ec5c6a19895d1de5131d70f294851 100755
--- a/start_app.sh
