diff --git a/backend/routers/ecosystem.py b/backend/routers/ecosystem.py
new file mode 100644
index 0000000000000000000000000000000000000000..87fbe11e1cab2b749805ac0553200d8bc387faf6
--- /dev/null
+++ b/backend/routers/ecosystem.py
@@ -0,0 +1,174 @@
+"""
+エコシステム API（ハーネスの LLM や、ほかの自作アプリから使う共通の入口）。
+共通の形は、ハーネス（opencode）の docs/apps.md の「エコシステム API 1」。
+
+- GET /api/ecosystem: アプリの名乗り。版、人が開く深いリンクのひな形、使ってよい操作の一覧
+- GET /api/ecosystem/tasks: タスクを、LLM が読みやすい小さな形で探す（読み取りだけ）
+    入力: q（空白区切りで AND。タスク名・メモ・ToDo・フォルダに、大文字小文字を区別せず部分一致）、
+          status（open: 進捗 100% 未満 / done: 100% / all。既定 open）、
+          due_within_days（最終日が「基準日 + N 日」以前。期限切れも含む）、
+          limit（1〜200。既定 30）、today（基準日 YYYY-MM-DD。既定は今日）
+    出力: total（一致した件数）、truncated（limit で切ったか）、items（id、名前、種類、開始・終了の日付、
+          最終日 last_day（保存している終了日は「最終日の翌日」なので、人が言う期限はこちら）、
+          進捗 %、親の id、親のタスク名を「 > 」でつないだ path、担当、ピン留め、期限切れ、残り日数、
+          ToDo の先頭 100 文字（改行は「 / 」でつないだ 1 行）、メモの有無、つながっているノートの名前 link）。期限切れ・残り日数・due_within_days は最終日で判定する。
+          メモの本文は返さない（詳しくは GET /api/tasks/{id}）。
+    並び: open と all は終了日の早い順、done は終了日の遅い順。
+作成・更新は、既存の POST /api/tasks・PUT /api/tasks/{id} を使う（operations に載せる）。削除は載せない。
+"""
+from datetime import date, datetime, timedelta
+from typing import Literal, Optional
+
+from fastapi import APIRouter, Depends, Query, Request
+from sqlalchemy.orm import Session
+
+from database import get_db
+from models import Task as TaskModel
+
+router = APIRouter(prefix="/api/ecosystem", tags=["ecosystem"])
+
+ECOSYSTEM_VERSION = 1
+APP_ID = "gantt"
+APP_TITLE = "ガントチャート（タスクとスケジュール）"
+
+OPERATIONS = [
+    {"id": "tasks.search", "method": "GET", "path": "/api/ecosystem/tasks", "effect": "read"},
+    {"id": "tasks.get", "method": "GET", "path": "/api/tasks/{task_id}", "effect": "read"},
+    {"id": "tasks.create", "method": "POST", "path": "/api/tasks", "effect": "write"},
+    {"id": "tasks.update", "method": "PUT", "path": "/api/tasks/{task_id}", "effect": "write"},
+]
+LINKS = {"home": "/"}
+
+KIND_LABELS = {1: "task", 2: "project", 3: "milestone"}
+OWNER_LABELS = {0: "自分", 10: "待", 20: "サイン取", 30: "他"}
+TODO_PREVIEW_CHARS = 100
+
+
+@router.get("")
+def ecosystem_manifest(request: Request) -> dict:
+    """アプリの名乗り（エコシステム API 1 の共通の形）。"""
+    from main import APP_VERSION  # main が router を読み込むので、循環を避けて呼び出し時に読む
+
+    return {
+        "ecosystem": ECOSYSTEM_VERSION,
+        "app": APP_ID,
+        "title": APP_TITLE,
+        "version": APP_VERSION,
+        "base_url": str(request.base_url).rstrip("/"),
+        "links": LINKS,
+        "operations": OPERATIONS,
+    }
+
+
+def _date_part(value: Optional[str]) -> str:
+    """'YYYY-MM-DD HH:mm:ss' から日付だけを取り出す。"""
+    return (value or "")[:10]
+
+
+def _parse_date(value: Optional[str]) -> Optional[date]:
+    try:
+        return datetime.strptime(_date_part(value), "%Y-%m-%d").date()
+    except ValueError:
+        return None
+
+
+def _last_day(task: TaskModel) -> Optional[date]:
+    """最終日（保存している終了日の前日。開始日より前にはしない）。"""
+    end = _parse_date(task.end_date)
+    if end is None:
+        return None
+    start = _parse_date(task.start_date)
+    last = end - timedelta(days=1)
+    return max(last, start) if start else last
+
+
+def _is_done(task: TaskModel) -> bool:
+    return (task.progress or 0.0) >= 1.0
+
+
+def _matches(task: TaskModel, terms: list[str]) -> bool:
+    haystack = " ".join(filter(None, [task.text, task.memo, task.ToDo, task.folder])).lower()
+    return all(term in haystack for term in terms)
+
+
+def _path_of(task: TaskModel, by_id: dict[int, TaskModel]) -> str:
+    """親のタスク名を、上から順に「 > 」でつなぐ（循環していても止まる）。"""
+    names: list[str] = []
+    seen = {task.id}
+    parent_id = task.parent or 0
+    while parent_id and parent_id in by_id and parent_id not in seen:
+        seen.add(parent_id)
+        parent = by_id[parent_id]
+        names.append(parent.text)
+        parent_id = parent.parent or 0
+    return " > ".join(reversed(names))
+
+
+def _link_name(hyperlink: Optional[str]) -> Optional[str]:
+    """つながっているノート・URL を短く返す。ローカルのパスはファイル名だけ（Obsidian のノートは `名前【ID】.md`）。"""
+    value = (hyperlink or "").strip()
+    if not value:
+        return None
+    if value.startswith(("http://", "https://")):
+        return value
+    return value.replace("\\", "/").rstrip("/").rsplit("/", 1)[-1]
+
+
+def _compact(task: TaskModel, by_id: dict[int, TaskModel], today: date) -> dict:
+    last = _last_day(task)
+    # 1 行で読めるように、改行を「 / 」でつなぐ（一覧の 1 行が崩れないように）
+    todo = " / ".join(line.strip() for line in (task.ToDo or "").splitlines() if line.strip())
+    if len(todo) > TODO_PREVIEW_CHARS:
+        todo = todo[:TODO_PREVIEW_CHARS] + "…"
+    return {
+        "id": task.id,
+        "text": task.text,
+        "kind": KIND_LABELS.get(task.kind_task or 1, str(task.kind_task)),
+        "start": _date_part(task.start_date),
+        "end": _date_part(task.end_date),
+        "last_day": last.isoformat() if last else None,
+        "progress": round((task.progress or 0.0) * 100),
+        "parent": task.parent or 0,
+        "path": _path_of(task, by_id),
+        "owner": OWNER_LABELS.get(task.owner_id or 0, str(task.owner_id)),
+        "pinned": bool(task.is_pinned),
+        "overdue": bool(last and last < today and not _is_done(task)),
+        "days_left": (last - today).days if last else None,
+        "todo": todo or None,
+        "has_memo": bool((task.memo or "").strip()),
+        "link": _link_name(task.hyperlink),
+    }
+
+
+@router.get("/tasks")
+def search_tasks(
+    q: str = "",
+    status: Literal["open", "done", "all"] = "open",
+    due_within_days: Optional[int] = Query(None, ge=0, le=3650),
+    limit: int = Query(30, ge=1, le=200),
+    today: Optional[date] = None,
+    db: Session = Depends(get_db),
+) -> dict:
+    """タスクを小さな形で探す（読み取りだけ）。"""
+    base = today or date.today()
+    tasks = db.query(TaskModel).all()
+    by_id = {task.id: task for task in tasks}
+    terms = [term.lower() for term in q.split() if term]
+
+    selected = []
+    for task in tasks:
+        if status == "open" and _is_done(task):
+            continue
+        if status == "done" and not _is_done(task):
+            continue
+        if terms and not _matches(task, terms):
+            continue
+        if due_within_days is not None:
+            last = _last_day(task)
+            if last is None or (last - base).days > due_within_days:
+                continue
+        selected.append(task)
+
+    selected.sort(key=lambda t: (_date_part(t.end_date), t.id), reverse=(status == "done"))
+    items = [_compact(task, by_id, base) for task in selected[:limit]]
+    return {"total": len(selected), "truncated": len(selected) > limit, "items": items}
diff --git a/backend/tests/test_ecosystem.py b/backend/tests/test_ecosystem.py
new file mode 100644
index 0000000000000000000000000000000000000000..c78d7113ca5e20f7642049d79037ba09db37ecad
--- /dev/null
+++ b/backend/tests/test_ecosystem.py
@@ -0,0 +1,150 @@
+"""
+エコシステム API（ハーネスの LLM や、ほかの自作アプリから使う共通の入口）のテスト。
+- GET /api/ecosystem: アプリの名乗り（共通の形。版、深いリンク、使ってよい操作）
+- GET /api/ecosystem/tasks: タスクを、LLM が読みやすい小さな形で探す
+  （未完了・完了・すべて、期限の近さ、キーワード、件数の上限。親のタスク名を「 > 」でつないだ path つき）
+"""
+
+
+def test_manifest_has_common_shape(client):
+    response = client.get("/api/ecosystem")
+    assert response.status_code == 200
+    body = response.json()
+    assert body["ecosystem"] == 1
+    assert body["app"] == "gantt"
+    assert body["title"]
+    assert body["version"] == client.get("/api/health").json()["version"]
+    assert body["base_url"] == "http://testserver"
+    assert body["links"]["home"] == "/"
+    operations = {op["id"]: op for op in body["operations"]}
+    assert operations["tasks.search"] == {"id": "tasks.search", "method": "GET", "path": "/api/ecosystem/tasks", "effect": "read"}
+    assert operations["tasks.create"]["effect"] == "write"
+    assert operations["tasks.update"] == {"id": "tasks.update", "method": "PUT", "path": "/api/tasks/{task_id}", "effect": "write"}
+    assert all(op["effect"] in {"read", "write", "open"} for op in body["operations"])
+    assert not any(op["method"] == "DELETE" for op in body["operations"]), "削除はエコシステムに出さない"
+
+
+def search(client, **params):
+    response = client.get("/api/ecosystem/tasks", params={"today": "2024-01-10", **params})
+    assert response.status_code == 200, response.text
+    return response.json()
+
+
+def test_default_is_open_tasks_sorted_by_end_date(client, create_task):
+    create_task("後の期限", start_date="2024-01-01 00:00:00", end_date="2024-01-20 00:00:00")
+    create_task("先の期限", start_date="2024-01-01 00:00:00", end_date="2024-01-12 00:00:00")
+    create_task("完了", progress=1.0)
+
+    body = search(client)
+
+    assert [item["text"] for item in body["items"]] == ["先の期限", "後の期限"]
+    assert body["total"] == 2
+    assert body["truncated"] is False
+    first = body["items"][0]
+    assert first["start"] == "2024-01-01"
+    assert first["end"] == "2024-01-12"  # 保存されている終了日 (最終日の翌日)
+    assert first["last_day"] == "2024-01-11"  # 人が言う「期限」(最終日)
+    assert first["progress"] == 0
+    assert first["days_left"] == 1  # 最終日までの日数
+    assert first["overdue"] is False
+
+
+def test_status_done_and_all(client, create_task):
+    create_task("未完了")
+    create_task("完了", progress=1.0)
+    assert [i["text"] for i in search(client, status="done")["items"]] == ["完了"]
+    assert {i["text"] for i in search(client, status="all")["items"]} == {"未完了", "完了"}
+    assert client.get("/api/ecosystem/tasks", params={"status": "nope"}).status_code == 422
+
+
+def test_due_within_days_includes_overdue(client, create_task):
+    create_task("期限切れ", end_date="2024-01-05 00:00:00")  # 最終日 01-04
+    create_task("7日後が最終日", end_date="2024-01-18 00:00:00")  # 最終日 01-17
+    create_task("8日後が最終日", end_date="2024-01-19 00:00:00")
+
+    body = search(client, due_within_days=7)
+
+    assert [i["text"] for i in body["items"]] == ["期限切れ", "7日後が最終日"]
+    assert body["items"][0]["overdue"] is True
+    assert body["items"][0]["days_left"] == -6
+
+
+def test_keywords_are_and_and_search_memo_and_todo(client, create_task):
+    create_task("見積の作成", memo="A社 向け")
+    create_task("見積の確認", ToDo="B社に電話")
+    create_task("議事録")
+
+    assert [i["text"] for i in search(client, q="見積")["items"]] == ["見積の作成", "見積の確認"]
+    assert [i["text"] for i in search(client, q="見積 a社")["items"]] == ["見積の作成"]  # 空白で AND、大文字小文字を区別しない
+    assert [i["text"] for i in search(client, q="電話")["items"]] == ["見積の確認"]
+
+
+def test_path_kind_owner_and_flags(client, create_task):
+    project = create_task("案件A", kind_task=2)
+    phase = create_task("設計", parent=project["id"])
+    task = create_task("図面", parent=phase["id"], owner_id=10, is_pinned=True, memo="長いメモ", ToDo="x" * 300)
+
+    item = next(i for i in search(client, status="all")["items"] if i["id"] == task["id"])
+
+    assert item["path"] == "案件A > 設計"
+    assert item["parent"] == phase["id"]
+    assert item["kind"] == "task"
+    assert item["owner"] == "待"
+    assert item["pinned"] is True
+    assert item["has_memo"] is True
+    assert len(item["todo"]) <= 101  # 長い ToDo は短くして返す (末尾に …)
+    project_item = next(i for i in search(client, status="all")["items"] if i["id"] == project["id"])
+    assert project_item["kind"] == "project"
+    assert project_item["path"] == ""
+    assert "memo" not in item, "メモの本文は返さない (詳しくは GET /api/tasks/{id})"
+
+
+def test_limit_and_truncated(client, create_task):
+    for n in range(5):
+        create_task(f"T{n}")
+    body = search(client, limit=2)
+    assert len(body["items"]) == 2
+    assert body["total"] == 5
+    assert body["truncated"] is True
+    assert client.get("/api/ecosystem/tasks", params={"limit": 0}).status_code == 422
+    assert client.get("/api/ecosystem/tasks", params={"limit": 201}).status_code == 422
+
+
+def test_today_must_be_a_date(client):
+    assert client.get("/api/ecosystem/tasks", params={"today": "2024/01/10"}).status_code == 422
+
+
+def test_ecosystem_routes_are_not_swallowed_by_spa(tmp_path):
+    from fastapi.testclient import TestClient
+    from main import create_app
+
+    dist = tmp_path / "dist"
+    dist.mkdir()
+    (dist / "index.html").write_text("<html></html>", encoding="utf-8")
+    client = TestClient(create_app(frontend_dist=dist))
+    assert client.get("/api/ecosystem").headers["content-type"].startswith("application/json")
+    assert client.get("/api/ecosystem/tasks").headers["content-type"].startswith("application/json")
+
+
+def test_last_day_is_today_is_not_overdue(client, create_task):
+    create_task("今日まで", start_date="2024-01-10 00:00:00", end_date="2024-01-11 00:00:00")
+    item = search(client)["items"][0]
+    assert item["last_day"] == "2024-01-10"
+    assert item["days_left"] == 0
+    assert item["overdue"] is False
+
+
+def test_todo_preview_is_one_line(client, create_task):
+    create_task("電話", ToDo="9/B 予約\n\n  11/B 受取\r\n4/E 期限")
+    assert search(client)["items"][0]["todo"] == "9/B 予約 / 11/B 受取 / 4/E 期限"
+
+
+def test_link_shows_linked_note_name(client, create_task):
+    """タスクとノートのつながり (hyperlink) を、名前だけで返す (フルパスは GET /api/tasks/{id})。"""
+    create_task("つながり", hyperlink="/Users/u/vault/01_data/2026/11/07/まとめ【1】.md\n")
+    create_task("URL", hyperlink="http://localhost:3001/?filepath=x")
+    create_task("なし")
+    items = {i["text"]: i for i in search(client)["items"]}
+    assert items["つながり"]["link"] == "まとめ【1】.md"
+    assert items["URL"]["link"] == "http://localhost:3001/?filepath=x"
+    assert items["なし"]["link"] is None
diff --git a/docs/SPECIFICATION.md b/docs/SPECIFICATION.md
index 500b8ab4fdf67e6fe3f3b3dc93fb6492d762902d..d1c75c45281b0677d195416e243b29279db0585e 100644
--- a/docs/SPECIFICATION.md
+++ b/docs/SPECIFICATION.md
@@ -403,6 +403,21 @@ FastAPI の Swagger UI（`/docs`）でも確認できます。失敗時は HTTP
 | PUT | `/api/business-trips/raw` | 出張テキストの一括更新 |
 | GET | `/api/synonyms` | 同義語グループ（外部APIの中継。取得できなければ 502） |
 
+### 7.6 エコシステム API（ハーネスやほかの自作アプリ向け）
+
+ハーネス（opencode）の LLM や、ほかの自作アプリが使う共通の入口です。共通の形は、ハーネスの `docs/apps.md` の「エコシステム API 1」。実装は `backend/routers/ecosystem.py`。読み取りだけで、データは変えません。
+
+| Method | Endpoint | 説明 |
+| --- | --- | --- |
+| GET | `/api/ecosystem` | アプリの名乗り（`{ecosystem: 1, app: "gantt", title, version, base_url, links, operations}`）。`operations` は、外から使ってよい操作（探す・1 件取得・作成・更新）。削除は載せない |
+| GET | `/api/ecosystem/tasks` | タスクを LLM が読みやすい小さな形で探す（下の表） |
+
+`/api/ecosystem/tasks` の入力と出力:
+
+- 入力: `q`（空白区切りで AND。タスク名・メモ・ToDo・フォルダに、大文字小文字を区別せず部分一致）、`status`（`open`: 進捗 100% 未満、`done`: 100%、`all`。既定 `open`）、`due_within_days`（最終日が「基準日 + N 日」以前。期限切れも含む）、`limit`（1〜200。既定 30）、`today`（基準日 `YYYY-MM-DD`。既定は今日）
+- 出力: `{total, truncated, items}`。`items` の各項目は `id`、`text`、`kind`（`task` / `project` / `milestone`）、`start`・`end`（日付だけ。`end` は保存している終了日で、最終日の翌日）、`last_day`（最終日。人が言う期限。期限切れ `overdue`・残り日数 `days_left`・`due_within_days` はこれで判定）、`progress`（%）、`parent`、`path`（親のタスク名を「 > 」でつないだもの）、`owner`（自分・待・サイン取・他）、`pinned`、`overdue`、`days_left`、`todo`（先頭 100 文字。改行は「 / 」でつないだ 1 行）、`has_memo`、`link`（`hyperlink` のノートのファイル名。URL ならそのまま。なければ `null`。Obsidian のノートは `名前【ID】.md` の形 → 5.1）。メモの本文は返さない（`GET /api/tasks/{id}` で取る）
+- 並び: `open` と `all` は終了日の早い順、`done` は終了日の遅い順
+
 API以外のパスは、ビルド済みフロントエンド（`frontend/dist`）を返します。`index.html` と Service Worker は常に再検証させ、ハッシュ付きアセットは長期キャッシュさせます。`dist` の外のファイルは返しません。
 
 ## 8. 設定
diff --git a/frontend/package-lock.json b/frontend/package-lock.json
index c12bf648fce2e81049de11c0dd23e6f42021ff2f..7db40f0b0031b602c7fd633bfd3e85b7afb991c4 100644
--- a/frontend/package-lock.json
+++ b/frontend/package-lock.json
@@ -12153,6 +12153,7 @@
       "integrity": "sha512-5eWdz2yb3ajxWF3C8C4TjkXl7FGm3n2E/VlazALrQHzK7nYMSGFnCZto0bbPNl77AwkOZVLk0YnBAejUu0NiWA==",
       "dev": true,
       "license": "MIT",
+      "peer": true,
       "dependencies": {
         "@vitest/expect": "4.1.12",
         "@vitest/mocker": "4.1.12",
