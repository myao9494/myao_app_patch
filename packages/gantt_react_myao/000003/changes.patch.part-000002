diff --git a/frontend/src/hooks/__tests__/useGridStaging.test.ts b/frontend/src/hooks/__tests__/useGridStaging.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0e3bd1e5cec34185915f972fe73346493e38d794
--- /dev/null
+++ b/frontend/src/hooks/__tests__/useGridStaging.test.ts
@@ -0,0 +1,137 @@
+/**
+ * @vitest-environment jsdom
+ * グリッド編集のステージング管理フック（useGridStaging）のテスト。APIはモックする。
+ */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { act, cleanup, renderHook, waitFor } from '@testing-library/react';
+import * as api from '../../services/api';
+import type { GridDiffItem } from '../../types/gantt';
+import { useGridStaging } from '../useGridStaging';
+
+vi.mock('../../services/api');
+
+const diff = (field: string): GridDiffItem => ({ id: 1, table: 'tasks', field, original: 'a', current: 'b' });
+const onCommitted = vi.fn(() => Promise.resolve());
+let alertSpy: ReturnType<typeof vi.spyOn>;
+
+beforeEach(() => {
+  alertSpy = vi.spyOn(window, 'alert').mockImplementation(() => {});
+  vi.mocked(api.initGrid).mockResolvedValue({ success: true, data: { tasks_count: 1, links_count: 0 } });
+  vi.mocked(api.getGridDiff).mockResolvedValue({ success: true, data: { diffs: [diff('text')] } });
+});
+
+afterEach(() => {
+  cleanup();
+  vi.restoreAllMocks();
+  vi.resetAllMocks();
+});
+
+async function renderActive() {
+  const rendered = renderHook(({ active }) => useGridStaging({ active, onCommitted }), {
+    initialProps: { active: true },
+  });
+  await waitFor(() => expect(rendered.result.current.diffs).toHaveLength(1));
+  return rendered;
+}
+
+describe('ステージングの初期化', () => {
+  it('グリッド画面でないときは、何も呼ばないこと', () => {
+    renderHook(() => useGridStaging({ active: false, onCommitted }));
+
+    expect(api.initGrid).not.toHaveBeenCalled();
+  });
+
+  it('グリッド画面に入ったら、ステージングを初期化して差分を取得すること', async () => {
+    const { result } = await renderActive();
+
+    expect(api.initGrid).toHaveBeenCalledTimes(1);
+    expect(result.current.diffs).toEqual([diff('text')]);
+  });
+
+  it('グリッド画面を離れたら、差分と選択を捨てること', async () => {
+    const { result, rerender } = await renderActive();
+    act(() => result.current.setSelectedDiff(diff('text')));
+
+    rerender({ active: false });
+
+    await waitFor(() => expect(result.current.diffs).toEqual([]));
+    expect(result.current.selectedDiff).toBeNull();
+  });
+});
+
+describe('コミット', () => {
+  it('反映したら本データを取り直し、ステージングを初期化し直して差分を空にすること', async () => {
+    vi.mocked(api.commitGrid).mockResolvedValue({
+      success: true,
+      data: { updated_tasks: 2, updated_links: 1, errors: [] },
+    });
+    const { result } = await renderActive();
+
+    await act(() => result.current.commit());
+
+    expect(alertSpy).toHaveBeenCalledWith('アップロード完了: Tasks 2件, Links 1件');
+    expect(onCommitted).toHaveBeenCalledTimes(1);
+    expect(api.initGrid).toHaveBeenCalledTimes(2);
+    expect(result.current.diffs).toEqual([]);
+    expect(result.current.committing).toBe(false);
+  });
+
+  it('エラーがあれば内容を表示すること', async () => {
+    vi.mocked(api.commitGrid).mockResolvedValue({
+      success: true,
+      data: { updated_tasks: 0, updated_links: 0, errors: ['boom'] },
+    });
+    const { result } = await renderActive();
+
+    await act(() => result.current.commit());
+
+    expect(alertSpy).toHaveBeenCalledWith('アップロードにエラーがありました: boom');
+  });
+
+  it('APIが失敗したら何も変えず、処理中の状態も戻すこと', async () => {
+    vi.mocked(api.commitGrid).mockResolvedValue({ success: false, error: 'x' });
+    const { result } = await renderActive();
+
+    await act(() => result.current.commit());
+
+    expect(onCommitted).not.toHaveBeenCalled();
+    expect(result.current.diffs).toHaveLength(1);
+    expect(result.current.committing).toBe(false);
+  });
+});
+
+describe('差分の取り消し', () => {
+  it('取り消したら差分を取り直し、その差分を選択中なら選択も外すこと', async () => {
+    vi.mocked(api.revertGridDiff).mockResolvedValue({ success: true, data: undefined });
+    const { result } = await renderActive();
+    act(() => result.current.setSelectedDiff(diff('text')));
+    vi.mocked(api.getGridDiff).mockResolvedValue({ success: true, data: { diffs: [] } });
+
+    await act(() => result.current.revert(diff('text')));
+
+    expect(api.revertGridDiff).toHaveBeenCalledWith('tasks', 1, 'text');
+    expect(result.current.diffs).toEqual([]);
+    expect(result.current.selectedDiff).toBeNull();
+  });
+
+  it('別の項目を選択中なら、選択は残すこと', async () => {
+    vi.mocked(api.revertGridDiff).mockResolvedValue({ success: true, data: undefined });
+    const { result } = await renderActive();
+    act(() => result.current.setSelectedDiff(diff('memo')));
+
+    await act(() => result.current.revert(diff('text')));
+
+    expect(result.current.selectedDiff).toEqual(diff('memo'));
+  });
+
+  it('失敗したらエラーを表示し、差分は取り直さないこと', async () => {
+    vi.mocked(api.revertGridDiff).mockResolvedValue({ success: false, error: 'nope' });
+    const { result } = await renderActive();
+    vi.mocked(api.getGridDiff).mockClear();
+
+    await act(() => result.current.revert(diff('text')));
+
+    expect(alertSpy).toHaveBeenCalledWith('元に戻す処理に失敗しました: nope');
+    expect(api.getGridDiff).not.toHaveBeenCalled();
+  });
+});
diff --git a/frontend/src/hooks/__tests__/useOpenInputRequests.test.tsx b/frontend/src/hooks/__tests__/useOpenInputRequests.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..1cdd36261448d2425f5f415812706f3c9fb16aa6
--- /dev/null
+++ b/frontend/src/hooks/__tests__/useOpenInputRequests.test.tsx
@@ -0,0 +1,109 @@
+/**
+ * @vitest-environment jsdom
+ * 外部からの入力画面オープン要求を受け取るフック（useOpenInputRequests）のテスト。APIはモックする。
+ */
+import type { ReactNode } from 'react';
+import { MemoryRouter, useLocation } from 'react-router-dom';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { act, cleanup, renderHook } from '@testing-library/react';
+import * as api from '../../services/api';
+import { useOpenInputRequests } from '../useOpenInputRequests';
+
+vi.mock('../../services/api');
+
+const STORAGE_KEY = 'gantt_lastOpenInputRequestId';
+const pending = (requestId: number, taskId = 7) => ({
+  success: true as const,
+  data: { request_id: requestId, task_id: taskId, created_at: '2026-01-01 00:00:00' },
+});
+
+function renderAt(path: string) {
+  const wrapper = ({ children }: { children: ReactNode }) => <MemoryRouter initialEntries={[path]}>{children}</MemoryRouter>;
+  return renderHook(() => ({ open: useOpenInputRequests(), location: useLocation() }), { wrapper });
+}
+
+/** 非同期のポーリング処理が完了するまで待つ */
+const settle = () => act(async () => { await vi.advanceTimersByTimeAsync(0); });
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  window.sessionStorage.clear();
+  vi.mocked(api.sendTaskInputOpenClientHeartbeat).mockResolvedValue({ success: true, data: { status: 'ok' } });
+  vi.mocked(api.getTaskInputOpenRequest).mockResolvedValue({ success: true, data: null });
+  vi.mocked(api.acknowledgeTaskInputOpenRequest).mockResolvedValue({
+    success: true, data: { status: 'ok', cleared: true, request_id: 0 },
+  });
+});
+
+afterEach(() => {
+  cleanup();
+  vi.useRealTimers();
+  vi.resetAllMocks();
+});
+
+describe('ハートビート', () => {
+  it('開いたときに1回送り、その後は5秒ごとに送ること', async () => {
+    renderAt('/');
+    await settle();
+    expect(api.sendTaskInputOpenClientHeartbeat).toHaveBeenCalledTimes(1);
+
+    await act(async () => { await vi.advanceTimersByTimeAsync(10_000); });
+
+    expect(api.sendTaskInputOpenClientHeartbeat).toHaveBeenCalledTimes(3);
+  });
+});
+
+describe('リクエストの受け取り', () => {
+  it('未処理のリクエストがあれば、タスクIDつきで返すこと', async () => {
+    vi.mocked(api.getTaskInputOpenRequest).mockResolvedValue(pending(5, 42));
+    const { result } = renderAt('/');
+
+    await settle();
+
+    expect(result.current.open.request).toMatchObject({ requestId: 5, taskId: 42 });
+  });
+
+  it('処理済みのID以下のリクエストは無視すること', async () => {
+    window.sessionStorage.setItem(STORAGE_KEY, '5');
+    vi.mocked(api.getTaskInputOpenRequest).mockResolvedValue(pending(5));
+    const { result } = renderAt('/');
+
+    await settle();
+
+    expect(result.current.open.request).toBeNull();
+  });
+
+  it('ガント以外の画面にいるときは、ガント画面へ切り替えること', async () => {
+    vi.mocked(api.getTaskInputOpenRequest).mockResolvedValue(pending(5));
+    const { result } = renderAt('/grid');
+
+    await settle();
+
+    expect(result.current.location.pathname).toBe('/');
+  });
+});
+
+describe('処理済みの通知', () => {
+  it('処理済みにすると、バックエンドへ ack し、IDを覚えて同じリクエストを再処理しないこと', async () => {
+    vi.mocked(api.getTaskInputOpenRequest).mockResolvedValue(pending(5));
+    const { result } = renderAt('/');
+    await settle();
+
+    act(() => result.current.open.markHandled(5));
+    const firstAttempt = result.current.open.request;
+    await act(async () => { await vi.advanceTimersByTimeAsync(2000); });
+
+    expect(api.acknowledgeTaskInputOpenRequest).toHaveBeenCalledWith(5);
+    expect(window.sessionStorage.getItem(STORAGE_KEY)).toBe('5');
+    expect(result.current.open.request).toBe(firstAttempt);
+  });
+
+  it('古いIDで処理済みにしても、覚えている最大IDは小さくならないこと', async () => {
+    window.sessionStorage.setItem(STORAGE_KEY, '9');
+    const { result } = renderAt('/');
+
+    act(() => result.current.open.markHandled(3));
+
+    expect(window.sessionStorage.getItem(STORAGE_KEY)).toBe('9');
+  });
+});
diff --git a/frontend/src/hooks/useGanttData.ts b/frontend/src/hooks/useGanttData.ts
index 451bc49da4bfddd1284ac0b318b167a42ef27cbb..acdee274fcd320586478ce205b3ad344a170e0ba 100644
