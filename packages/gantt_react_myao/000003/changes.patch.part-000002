gn-items:center;justify-content:center;font-size:12px;color:var(--text-secondary);z-index:50;transition:left .3s,background .2s;box-shadow:0 2px 4px #0000001a}.collapse-toggle:hover{background:var(--hover-bg);color:var(--text-primary)}.collapse-toggle.collapsed{left:8px}
