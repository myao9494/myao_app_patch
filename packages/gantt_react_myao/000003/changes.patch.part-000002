 /** "YYYY-MM-DD HH:mm:ss" 形式の文字列を Date に変換する（不正な値は undefined） */
 export function parseTaskDate(value: string | Date | null | undefined): Date | undefined {
diff --git a/frontend/src/components/GanttChart/useGanttDisplaySettings.ts b/frontend/src/components/GanttChart/useGanttDisplaySettings.ts
new file mode 100644
index 0000000000000000000000000000000000000000..889772929be8737ac05d54c6b585f50fd430ad1a
--- /dev/null
+++ b/frontend/src/components/GanttChart/useGanttDisplaySettings.ts
@@ -0,0 +1,158 @@
+/**
+ * 表示設定（タイムスケール・休日/出張・左グリッド・印刷モード・全展開/全折りたたみ・表示倍率）を gantt へ反映する。
+ * gantt の初期化後に反映するため、必ず初期化の useEffect より後に呼ぶこと。
+ */
+import { useEffect, type RefObject } from 'react';
+import { gantt } from 'dhtmlx-gantt';
+import type { BusinessTripEntry } from '../../types/gantt';
+import { BASE_BAR_HEIGHT, BASE_ROW_HEIGHT, type TimeScale } from './ganttSetup';
+import { applyTaskBarTemplates } from './ganttTemplates';
+
+const SCALE_STYLE_ELEMENT_ID = 'gantt-scale-style';
+
+/** 表示倍率に合わせて、Gantt各部のフォントサイズを上書きするCSSを生成する */
+function buildScaleStyle(scale: number): string {
+  const baseFontSize = Math.max(8, Math.round(12 * scale));
+  const taskContentFontSize = Math.max(8, Math.round(10 * scale));
+  const sideContentFontSize = Math.max(8, Math.round(11 * scale));
+
+  return `
+      .gantt_scale_cell,
+      .gantt_grid_head_cell,
+      .gantt_task_cell,
+      .gantt_grid_data,
+      .gantt_row,
+      .gantt_cell,
+      .gantt_grid_data .gantt_cell.gantt_last_cell,
+      .gantt_grid_scale .gantt_grid_head_cell,
+      .gantt_grid_data .gantt_row.odd:hover,
+      .gantt_grid_data .gantt_row:hover,
+      .hierarchy-path,
+      .gantt_cal_light,
+      .gantt_cal_light .gantt_cal_ltext .gantt_section_time,
+      .gantt_cal_light .gantt_cal_larea,
+      .gantt_cal_light .gantt_cal_ltext textarea,
+      .gantt_cal_light select,
+      .gantt_cal_light input {
+        font-size: ${baseFontSize}px !important;
+      }
+
+      .gantt_task_content {
+        font-size: ${taskContentFontSize}px !important;
+      }
+
+      .gantt_side_content {
+        font-size: ${sideContentFontSize}px !important;
+      }
+    `;
+}
+
+interface UseGanttDisplaySettingsOptions {
+  initialized: RefObject<boolean>;
+  timeScale: TimeScale;
+  isPrintMode: boolean;
+  gridCollapsed: boolean;
+  gridWidth: number;
+  displaySize: number;
+  /** 値が増えるたびに全タスクを展開する */
+  expandAllTrigger: number;
+  /** 値が増えるたびに全タスクを折りたたむ */
+  collapseAllTrigger: number;
+  holidays: string[];
+  businessTrips: BusinessTripEntry[];
+  /** テンプレートから参照される、休日・出張の集合（このフックが更新する） */
+  holidaySetRef: RefObject<Set<string>>;
+  businessTripMapRef: RefObject<Map<string, BusinessTripEntry['type']>>;
+}
+
+export function useGanttDisplaySettings({
+  initialized,
+  timeScale,
+  isPrintMode,
+  gridCollapsed,
+  gridWidth,
+  displaySize,
+  expandAllTrigger,
+  collapseAllTrigger,
+  holidays,
+  businessTrips,
+  holidaySetRef,
+  businessTripMapRef,
+}: UseGanttDisplaySettingsOptions): void {
+  useEffect(() => {
+    if (initialized.current && gantt.ext?.zoom) {
+      gantt.ext.zoom.setLevel(timeScale);
+      gantt.render();
+    }
+  }, [initialized, timeScale]);
+
+  useEffect(() => {
+    holidaySetRef.current = new Set(holidays.map((holiday) => holiday.trim()).filter(Boolean));
+    if (initialized.current) {
+      gantt.render();
+    }
+  }, [initialized, holidays, holidaySetRef]);
+
+  useEffect(() => {
+    businessTripMapRef.current = new Map(
+      businessTrips
+        .filter((trip) => trip.date && (trip.type === 'normal_trip' || trip.type === 'day_trip'))
+        .map((trip) => [trip.date.trim(), trip.type])
+    );
+    if (initialized.current) {
+      gantt.render();
+    }
+  }, [initialized, businessTrips, businessTripMapRef]);
+
+  // 左側グリッドの表示/幅と、印刷モード（グリッド非表示・バー右にタスク名のみ）
+  useEffect(() => {
+    if (!initialized.current) return;
+
+    if (isPrintMode) {
+      gantt.config.show_grid = false;
+      gantt.showDate(new Date());
+    } else {
+      gantt.config.show_grid = !gridCollapsed;
+      gantt.config.grid_width = gridCollapsed ? 0 : gridWidth;
+    }
+    applyTaskBarTemplates(isPrintMode);
+    gantt.render();
+  }, [initialized, isPrintMode, gridCollapsed, gridWidth]);
+
+  useEffect(() => {
+    if (!initialized.current || expandAllTrigger === 0) return;
+    gantt.eachTask((task) => {
+      task.$open = true;
+    });
+    gantt.render();
+  }, [initialized, expandAllTrigger]);
+
+  useEffect(() => {
+    if (!initialized.current || collapseAllTrigger === 0) return;
+    gantt.eachTask((task) => {
+      task.$open = false;
+    });
+    gantt.render();
+  }, [initialized, collapseAllTrigger]);
+
+  // 表示倍率: 行・バー・列の大きさとフォントサイズを変える
+  useEffect(() => {
+    if (!initialized.current) return;
+
+    const scale = displaySize / 100;
+    gantt.config.scale_height = Math.round(60 * scale);
+    gantt.config.row_height = Math.round(BASE_ROW_HEIGHT * scale);
+    gantt.config.bar_height = Math.max(12, Math.round(BASE_BAR_HEIGHT * scale));
+    gantt.config.min_column_width = Math.round(30 * scale);
+
+    let styleElement = document.getElementById(SCALE_STYLE_ELEMENT_ID);
+    if (!styleElement) {
+      styleElement = document.createElement('style');
+      styleElement.id = SCALE_STYLE_ELEMENT_ID;
+      document.head.appendChild(styleElement);
+    }
+    styleElement.textContent = buildScaleStyle(scale);
+
+    gantt.render();
+  }, [initialized, displaySize]);
+}
diff --git a/frontend/src/components/GanttChart/useGanttFilter.ts b/frontend/src/components/GanttChart/useGanttFilter.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d10e0fd400179b75adf6c749fe3a8177b445ffcc
--- /dev/null
+++ b/frontend/src/components/GanttChart/useGanttFilter.ts
@@ -0,0 +1,62 @@
+/**
+ * フィルタの反映。表示対象のタスクIDを事前計算し、対象が変わったときだけ gantt を再描画する。
+ * 親タスクを維持して、マッチした子タスクが孤立しないようにする（判定は filterUtils）。
+ * gantt の初期化後に反映するため、必ず初期化の useEffect より後に呼ぶこと。
+ */
+import { useEffect, useMemo, useRef, type RefObject } from 'react';
+import { gantt } from 'dhtmlx-gantt';
+import type { Task, TaskFilter } from '../../types/gantt';
+import { buildTaskFilterIndexes, computeVisibleTaskIds } from '../../utils/filterUtils';
+
+interface UseGanttFilterOptions {
+  initialized: RefObject<boolean>;
+  tasks: Task[];
+  filter?: TaskFilter;
+  synonyms: string[][];
+  /** onBeforeTaskDisplay から参照される、表示対象のタスクID（このフックが更新する） */
+  visibleTaskIdsRef: RefObject<Set<number>>;
+}
+
+export function useGanttFilter({ initialized, tasks, filter, synonyms, visibleTaskIdsRef }: UseGanttFilterOptions): void {
+  const visibleSignatureRef = useRef('');
+  const refreshFrameRef = useRef<number | null>(null);
+
+  const taskFilterIndexes = useMemo(() => buildTaskFilterIndexes(tasks, synonyms), [tasks, synonyms]);
+
+  useEffect(() => {
+    if (!initialized.current) return;
+
+    const visibleTaskIds = computeVisibleTaskIds(tasks, filter, taskFilterIndexes, synonyms);
+    visibleTaskIdsRef.current = visibleTaskIds;
+
+    let visibleSignature = '';
+    for (const task of tasks) {
+      if (visibleTaskIds.has(task.id)) {
+        visibleSignature += `${task.id},`;
+      }
+    }
+    if (visibleSignatureRef.current === visibleSignature) {
+      return;
+    }
+    visibleSignatureRef.current = visibleSignature;
+
+    if (refreshFrameRef.current !== null) {
+      cancelAnimationFrame(refreshFrameRef.current);
+    }
+    refreshFrameRef.current = requestAnimationFrame(() => {
+      refreshFrameRef.current = null;
+      gantt.refreshData();
+    });
+  }, [initialized, tasks, taskFilterIndexes, synonyms, filter, visibleTaskIdsRef]);
+
+  // アンマウント時（gantt を作り直す前）に、保留中の再描画を取り消し、次回は必ず反映させる
+  useEffect(() => {
+    return () => {
+      if (refreshFrameRef.current !== null) {
+        cancelAnimationFrame(refreshFrameRef.current);
+        refreshFrameRef.current = null;
+      }
+      visibleSignatureRef.current = '';
+    };
+  }, []);
+}
diff --git a/frontend/src/components/GanttChart/useTaskHyperlinks.ts b/frontend/src/components/GanttChart/useTaskHyperlinks.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1f3bc8884021d26a3bd1f2d8e262a413766a81ab
--- /dev/null
+++ b/frontend/src/components/GanttChart/useTaskHyperlinks.ts
@@ -0,0 +1,82 @@
+/**
+ * タスクのハイパーリンク操作。
+ * - Obsidianノートの作成（既にあれば再利用）とリンク設定、そのノートを開く
+ * - ハイパーリンクを開く（Obsidianノートはリネーム・移動されていても、タスクIDで探し直してから開く）
+ * 処理中の多重実行は無視する。
+ */
+import { useCallback, useRef } from 'react';
+import { createObsidianNote, resolveTaskLink } from '../../services/api';
+import { formatHyperlink, isObsidianLink, type GanttId } from './ganttTaskUtils';
+
+interface UseTaskHyperlinksOptions {
+  obsidianHome: string;
+  /** gantt 上のタスクの項目を書き換える（保存は gantt のイベント経由で行われる） */
+  updateTaskFields: (taskId: GanttId, fields: Record<string, unknown>) => void;
+}
+
+export function useTaskHyperlinks({ obsidianHome, updateTaskFields }: UseTaskHyperlinksOptions) {
+  const isCreatingObsidianRef = useRef(false);
+  const isResolvingHyperlinkRef = useRef(false);
+
+  // タスクのObsidianノートを作成（既にあれば再利用）してリンクし、そのノートを開く
+  const handleCreateObsidianNote = useCallback(async (taskId: number) => {
+    if (isCreatingObsidianRef.current) return;
+    isCreatingObsidianRef.current = true;
+    try {
+      const response = await createObsidianNote(taskId, obsidianHome);
+      if (!response.success || !response.data) {
+        console.error('Failed to create Obsidian note:', response.error);
+        alert(`ファイル作成に失敗しました: ${response.error}`);
+        return;
+      }
+
+      const hyperlink = response.data.hyperlink;
+      updateTaskFields(taskId, { hyperlink });
+      if (hyperlink) {
+        window.open(formatHyperlink(hyperlink), '_blank');
+      }
+    } catch (error) {
+      console.error(error);
+      alert('エラーが発生しました');
+    } finally {
+      isCreatingObsidianRef.current = false;
+    }
+  }, [obsidianHome, updateTaskFields]);
+
+  /**
+   * タスクのハイパーリンクを開く。
+   * Obsidianノートは、リネーム・移動されていてもタスクIDで探し直してから開く。
+   */
+  const openHyperlink = useCallback(async (taskId: number, hyperlink: string) => {
+    if (!hyperlink) return;
+
+    if (!isObsidianLink(hyperlink, obsidianHome)) {
+      window.open(formatHyperlink(hyperlink), '_blank');
+      return;
+    }
+
+    if (isResolvingHyperlinkRef.current) return;
+    isResolvingHyperlinkRef.current = true;
+
+    try {
+      const response = await resolveTaskLink(taskId, obsidianHome);
+      if (!response.success || !response.data?.hyperlink) {
+        alert(response.error || 'Obsidianリンクの再解決に失敗しました');
+        return;
+      }
+
+      const resolvedHyperlink = response.data.hyperlink;
+      if (response.data.updated) {
+        updateTaskFields(taskId, { hyperlink: resolvedHyperlink });
+      }
+      window.open(formatHyperlink(resolvedHyperlink), '_blank');
+    } catch (error) {
+      console.error(error);
+      alert('Obsidianリンクを開けませんでした');
+    } finally {
+      isResolvingHyperlinkRef.current = false;
+    }
+  }, [obsidianHome, updateTaskFields]);
+
+  return { createObsidianNote: handleCreateObsidianNote, openHyperlink };
+}
diff --git a/frontend/src/components/GridDiffPanel/GridDiffPanel.test.tsx b/frontend/src/components/GridDiffPanel/GridDiffPanel.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..18d36958abbbd6e1e8805a86c4e8704fd78d92d2
--- /dev/null
+++ b/frontend/src/components/GridDiffPanel/GridDiffPanel.test.tsx
@@ -0,0 +1,99 @@
+/**
+ * @vitest-environment jsdom
+ * グリッドの差分パネルのテスト
+ **/
+import { cleanup, fireEvent, render, screen } from '@testing-library/react';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import type { GridDiffItem } from '../../types/gantt';
+import { GridDiffPanel } from './GridDiffPanel';
+
+afterEach(cleanup);
+
+const taskDiff = (id: number, field: string, original: string | null, current: string | null): GridDiffItem => ({
+  id, table: 'tasks', field, original, current,
+});
+const linkDiff: GridDiffItem = { id: 9, table: 'links', field: 'type', original: '0', current: '1' };
+
+function renderPanel(props: Partial<Parameters<typeof GridDiffPanel>[0]> = {}) {
+  const handlers = { onCommit: vi.fn(), onToggle: vi.fn(), onRevert: vi.fn() };
+  render(
+    <GridDiffPanel
+      diffs={[taskDiff(1, 'text', 'A', 'B'), taskDiff(1, 'memo', null, 'x'), linkDiff]}
+      selectedDiff={null}
+      collapsed={false}
+      {...handlers}
+      {...props}
+    />,
+  );
+  return handlers;
+}
+
+describe('GridDiffPanel', () => {
+  it('件数を表示し、Tasks と Links をタブで切り替えること', () => {
+    renderPanel();
+
+    expect(screen.getByText('3件の変更')).toBeTruthy();
+    expect(screen.getByText('Tasks (2)')).toBeTruthy();
+    expect(screen.getByText('Links (1)')).toBeTruthy();
+    expect(screen.getByText('タスク名')).toBeTruthy();
+
+    fireEvent.click(screen.getByText('Links (1)'));
+
+    expect(screen.getByText('ID: 9')).toBeTruthy();
+    expect(screen.getByText('タイプ')).toBeTruthy();
+    expect(screen.queryByText('タスク名')).toBeNull();
+  });
+
+  it('値がない側は「(なし)」と表示し、フィールドは同じIDごとにまとめること', () => {
+    renderPanel();
+
+    expect(screen.getAllByText('ID: 1')).toHaveLength(1);
+    expect(screen.getByText('(なし)')).toBeTruthy();
+  });
+
+  it('差分がなければ「変更なし」を表示し、アップロードを押せないこと', () => {
+    renderPanel({ diffs: [] });
+
+    expect(screen.getByText('変更なし')).toBeTruthy();
+    expect((screen.getByRole('button', { name: /DBにアップロード/ }) as HTMLButtonElement).disabled).toBe(true);
+  });
+
+  it('アップロードボタンで onCommit を呼び、処理中は押せないこと', () => {
+    const handlers = renderPanel();
+
+    fireEvent.click(screen.getByRole('button', { name: '⬆ DBにアップロード (3件)' }));
+    expect(handlers.onCommit).toHaveBeenCalledTimes(1);
+
+    cleanup();
+    renderPanel({ committing: true });
+    expect((screen.getByRole('button', { name: /アップロード中/ }) as HTMLButtonElement).disabled).toBe(true);
+  });
+
+  it('折りたたまれているときは本体を出さず、トグルで onToggle を呼ぶこと', () => {
+    const handlers = renderPanel({ collapsed: true });
+
+    expect(screen.queryByText('差分確認', { exact: false })).toBeNull();
+    fireEvent.click(screen.getByTitle('差分パネル 表示/非表示'));
+    expect(handlers.onToggle).toHaveBeenCalledTimes(1);
+  });
+
+  it('差分を右クリックして「元に戻す」を選ぶと、その差分で onRevert を呼ぶこと', () => {
+    const handlers = renderPanel();
+
+    fireEvent.contextMenu(screen.getByText('タスク名'));
+    fireEvent.click(screen.getByText('元に戻す (Undo)'));
+
+    expect(handlers.onRevert).toHaveBeenCalledWith(taskDiff(1, 'text', 'A', 'B'));
+    expect(screen.queryByText('元に戻す (Undo)')).toBeNull();
+  });
+
+  it('メニューの外をクリックすると、何もせずメニューを閉じること', () => {
+    const handlers = renderPanel();
+
+    fireEvent.contextMenu(screen.getByText('タスク名'));
+    fireEvent.click(document.body);
+
+    expect(screen.queryByText('元に戻す (Undo)')).toBeNull();
+    expect(handlers.onRevert).not.toHaveBeenCalled();
+  });
+});
diff --git a/frontend/src/components/Header/CalendarSettingsModal.test.tsx b/frontend/src/components/Header/CalendarSettingsModal.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..14b617d88bf2c100c3fd1e457c07e6d588bc05e5
--- /dev/null
+++ b/frontend/src/components/Header/CalendarSettingsModal.test.tsx
@@ -0,0 +1,82 @@
+/**
+ * @vitest-environment jsdom
+ * 休日・出張の追加モーダルのテスト。APIはモックする。
+ **/
+import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import * as api from '../../services/api';
+import type { BusinessTripSettings, HolidaySettings } from '../../types/gantt';
+import { CalendarSettingsModal } from './CalendarSettingsModal';
+
+vi.mock('../../services/api');
+
+const holidays: HolidaySettings = { holidays: [], raw_text: '', file_path: '/data/holidays.txt' };
+const trips: BusinessTripSettings = { business_trips: [], raw_text: '', file_path: '/data/trips.txt' };
+
+const handlers = {
+  onHolidaySettingsChange: vi.fn(),
+  onBusinessTripSettingsChange: vi.fn(),
+  onClose: vi.fn(),
+};
+
+function renderModal() {
+  return render(<CalendarSettingsModal holidaySettings={holidays} businessTripSettings={trips} {...handlers} />);
+}
+
+beforeEach(() => vi.clearAllMocks());
+afterEach(cleanup);
+
+describe('CalendarSettingsModal', () => {
+  it('休日を追加すると、APIを呼んで結果を親へ渡し、入力欄を空にすること', async () => {
+    const saved = { ...holidays, holidays: ['2026-05-01'], raw_text: '2026-05-01' };
+    vi.mocked(api.addHoliday).mockResolvedValue({ success: true, data: saved });
+    renderModal();
+
+    fireEvent.change(screen.getByLabelText('カレンダーで追加'), { target: { value: '2026-05-01' } });
+    fireEvent.click(screen.getAllByRole('button', { name: '追加' })[0]);
+
+    await waitFor(() => expect(handlers.onHolidaySettingsChange).toHaveBeenCalledWith(saved));
+    expect(api.addHoliday).toHaveBeenCalledWith('2026-05-01');
+    expect((screen.getByLabelText('カレンダーで追加') as HTMLInputElement).value).toBe('');
+  });
+
+  it('日付が空のまま追加しようとすると、APIを呼ばずにエラーを出すこと', () => {
+    renderModal();
+
+    fireEvent.click(screen.getAllByRole('button', { name: '追加' })[0]);
+
+    expect(api.addHoliday).not.toHaveBeenCalled();
+    expect(screen.getByText('日付を入力してください')).toBeTruthy();
+  });
+
+  it('出張の追加に失敗したら、バックエンドのエラーメッセージを表示すること', async () => {
+    vi.mocked(api.addBusinessTrip).mockResolvedValue({ success: false, error: 'date is invalid' });
+    renderModal();
+
+    fireEvent.change(screen.getByLabelText('出張をカレンダーで追加'), { target: { value: '2026-05-02' } });
+    fireEvent.click(screen.getByLabelText('日帰り出張'));
+    fireEvent.click(screen.getAllByRole('button', { name: '追加' })[1]);
+
+    await waitFor(() => expect(screen.getByText('date is invalid')).toBeTruthy());
+    expect(api.addBusinessTrip).toHaveBeenCalledWith('2026-05-02', 'day_trip');
+    expect(handlers.onBusinessTripSettingsChange).not.toHaveBeenCalled();
+  });
+
+  it('休日テキストの保存で、編集した内容をAPIへ送ること', async () => {
+    vi.mocked(api.updateHolidayRawText).mockResolvedValue({ success: true, data: holidays });
+    renderModal();
+
+    fireEvent.change(screen.getByLabelText('休日ファイルをまとめて編集'), { target: { value: '2026-01-05' } });
+    fireEvent.click(screen.getByRole('button', { name: '休日テキストを保存' }));
+
+    await waitFor(() => expect(api.updateHolidayRawText).toHaveBeenCalledWith('2026-01-05'));
+  });
+
+  it('閉じるボタンで onClose を呼ぶこと', () => {
+    renderModal();
+
+    fireEvent.click(screen.getByRole('button', { name: '閉じる' }));
+
+    expect(handlers.onClose).toHaveBeenCalled();
+  });
+});
diff --git a/frontend/src/components/Header/CalendarSettingsModal.tsx b/frontend/src/components/Header/CalendarSettingsModal.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..1d65ea0050c587775723214ab7540bb85aeaa97b
--- /dev/null
+++ b/frontend/src/components/Header/CalendarSettingsModal.tsx
@@ -0,0 +1,212 @@
+/**
+ * 休日・出張の追加モーダル。
+ * 日付を1件ずつ追加するほか、バックエンドのテキストファイル（holidays.txt / business_trips.txt）を
+ * まとめて編集して保存できる。開くたびに入力欄を初期状態から始めるため、閉じている間はマウントしない。
+ */
+import { useState } from 'react';
+import { useSyncedState } from '../../hooks/useSyncedState';
+import { addBusinessTrip, addHoliday, updateBusinessTripRawText, updateHolidayRawText } from '../../services/api';
+import type { BusinessTripSettings, BusinessTripType, HolidaySettings } from '../../types/gantt';
+import './Header.css';
+
+interface CalendarSettingsModalProps {
+  holidaySettings: HolidaySettings | null;
+  onHolidaySettingsChange: (settings: HolidaySettings) => void;
+  businessTripSettings: BusinessTripSettings | null;
+  onBusinessTripSettingsChange: (settings: BusinessTripSettings) => void;
+  onClose: () => void;
+}
+
+export function CalendarSettingsModal({
+  holidaySettings,
+  onHolidaySettingsChange,
+  businessTripSettings,
+  onBusinessTripSettingsChange,
+  onClose,
+}: CalendarSettingsModalProps) {
+  const [holidayInput, setHolidayInput] = useState('');
+  const [holidayRawText, setHolidayRawText] = useSyncedState(holidaySettings?.raw_text || '');
+  const [holidayError, setHolidayError] = useState<string | null>(null);
+  const [holidaySaving, setHolidaySaving] = useState(false);
+  const [tripInput, setTripInput] = useState('');
+  const [tripType, setTripType] = useState<BusinessTripType>('normal_trip');
+  const [tripRawText, setTripRawText] = useSyncedState(businessTripSettings?.raw_text || '');
+  const [tripError, setTripError] = useState<string | null>(null);
+  const [tripSaving, setTripSaving] = useState(false);
+
+  const handleAddHoliday = async () => {
+    if (!holidayInput.trim()) {
+      setHolidayError('日付を入力してください');
+      return;
+    }
+
+    setHolidaySaving(true);
+    setHolidayError(null);
+    const result = await addHoliday(holidayInput.trim());
+    setHolidaySaving(false);
+
+    if (result.success && result.data) {
+      onHolidaySettingsChange(result.data);
+      setHolidayRawText(result.data.raw_text);
+      setHolidayInput('');
+      return;
+    }
+
+    setHolidayError(result.error || '休日の追加に失敗しました');
+  };
+
+  const handleAddBusinessTrip = async () => {
+    if (!tripInput.trim()) {
+      setTripError('日付を入力してください');
+      return;
+    }
+
+    setTripSaving(true);
+    setTripError(null);
+    const result = await addBusinessTrip(tripInput.trim(), tripType);
+    setTripSaving(false);
+
+    if (result.success && result.data) {
+      onBusinessTripSettingsChange(result.data);
+      setTripRawText(result.data.raw_text);
+      setTripInput('');
+      return;
+    }
+
+    setTripError(result.error || '出張の追加に失敗しました');
+  };
+
+  const handleSaveHolidayText = async () => {
+    setHolidaySaving(true);
+    setHolidayError(null);
+    const result = await updateHolidayRawText(holidayRawText);
+    setHolidaySaving(false);
+
+    if (result.success && result.data) {
+      onHolidaySettingsChange(result.data);
+      setHolidayRawText(result.data.raw_text);
+      return;
+    }
+
+    setHolidayError(result.error || '休日ファイルの保存に失敗しました');
+  };
+
+  const handleSaveBusinessTripText = async () => {
+    setTripSaving(true);
+    setTripError(null);
+    const result = await updateBusinessTripRawText(tripRawText);
+    setTripSaving(false);
+
+    if (result.success && result.data) {
+      onBusinessTripSettingsChange(result.data);
+      setTripRawText(result.data.raw_text);
+      return;
+    }
+
+    setTripError(result.error || '出張ファイルの保存に失敗しました');
+  };
+
+  return (
+    <div className="settings-modal-overlay" onClick={() => onClose()}>
+      <div className="settings-modal" onClick={(e) => e.stopPropagation()}>
+        <div className="settings-modal-header">
+          <h2>休日・出張の追加</h2>
+          <button className="close-btn" onClick={() => onClose()}>✕</button>
+        </div>
+        <div className="settings-modal-body">
+          <div className="settings-field">
+            <label htmlFor="holiday-date-input">カレンダーで追加</label>
+            <div className="holiday-inline-row">
+              <input
+                id="holiday-date-input"
+                type="date"
+                value={holidayInput}
+                onChange={(e) => setHolidayInput(e.target.value)}
+              />
+              <button className="btn primary" onClick={handleAddHoliday} disabled={holidaySaving}>
+                追加
+              </button>
+            </div>
+          </div>
+
+          <div className="settings-field">
+            <label htmlFor="holiday-text-input">直打ちで追加</label>
+            <input
+              id="holiday-text-input"
+              type="text"
+              value={holidayInput}
+              onChange={(e) => setHolidayInput(e.target.value)}
+              placeholder="YYYY-MM-DD"
+            />
+          </div>
+
+          <div className="settings-field">
+            <label htmlFor="holiday-raw-text">休日ファイルをまとめて編集</label>
+            <textarea
+              id="holiday-raw-text"
+              className="holiday-textarea"
+              value={holidayRawText}
+              onChange={(e) => setHolidayRawText(e.target.value)}
+              placeholder={'1行に1日ずつ入力します\n例: 2026-01-05'}
+            />
+          </div>
+
+          <div className="settings-path">
+            保存先: {holidaySettings?.file_path || 'backend/data/holidays.txt'}
+          </div>
+          {holidayError && <div className="settings-error">{holidayError}</div>}
+
+          <div className="settings-field">
+            <label htmlFor="trip-date-input">出張をカレンダーで追加</label>
+            <div className="holiday-inline-row">
+              <input
+                id="trip-date-input"
+                type="date"
+                value={tripInput}
+                onChange={(e) => setTripInput(e.target.value)}
+              />
+              <label className="trip-type-checkbox">
+                <input
+                  type="checkbox"
+                  checked={tripType === 'day_trip'}
+                  onChange={(e) => setTripType(e.target.checked ? 'day_trip' : 'normal_trip')}
+                />
+                <span>日帰り出張</span>
+              </label>
+              <button className="btn primary" onClick={handleAddBusinessTrip} disabled={tripSaving}>
+                追加
+              </button>
+            </div>
+          </div>
+
+          <div className="settings-field">
+            <label htmlFor="trip-raw-text">出張ファイルをまとめて編集</label>
+            <textarea
+              id="trip-raw-text"
+              className="holiday-textarea"
+              value={tripRawText}
+              onChange={(e) => setTripRawText(e.target.value)}
+              placeholder={'1行に1日ずつ入力します\n例: 2026-01-05,normal_trip\n例: 2026-01-06,day_trip'}
+            />
+          </div>
+
+          <div className="settings-path">
+            出張保存先: {businessTripSettings?.file_path || 'backend/data/business_trips.txt'}
+          </div>
+          {tripError && <div className="settings-error">{tripError}</div>}
+        </div>
+        <div className="settings-modal-footer">
+          <button className="btn" onClick={() => onClose()}>
+            閉じる
+          </button>
+          <button className="btn primary" onClick={handleSaveBusinessTripText} disabled={tripSaving}>
+            出張テキストを保存
+          </button>
+          <button className="btn primary" onClick={handleSaveHolidayText} disabled={holidaySaving}>
+            休日テキストを保存
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/frontend/src/components/Header/CsvSyncSummaryModal.test.tsx b/frontend/src/components/Header/CsvSyncSummaryModal.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..fb263dd9681b651d38501a377f652282bd1fc7d8
--- /dev/null
+++ b/frontend/src/components/Header/CsvSyncSummaryModal.test.tsx
@@ -0,0 +1,83 @@
+/**
+ * @vitest-environment jsdom
+ * Obsidian CSV差分サマリのモーダルのテスト
+ **/
+import { cleanup, fireEvent, render, screen } from '@testing-library/react';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import type { CsvDiffSection, ObsidianCsvSyncSummary } from '../../types/gantt';
+import { CsvSyncSummaryModal } from './CsvSyncSummaryModal';
+
+afterEach(cleanup);
+
+const section = (overrides: Partial<CsvDiffSection> = {}): CsvDiffSection => ({
+  added_count: 1, deleted_count: 0, modified_count: 1, unchanged_count: 5,
+  added_examples: [{ id: '3', label: 'New task', changed_fields: [] }],
+  deleted_examples: [],
+  modified_examples: [{ id: '4', label: 'Edited task', changed_fields: ['text', 'memo'] }],
+  ...overrides,
+});
+
+const summary = {
+  exists: true,
+  status: 'updated',
+  checked_at: '2026-01-02 03:04:05',
+  saved_at: null,
+  output_dir: '/vault/70_gantt_csv',
+  history: [{}, {}],
+  tasks: section(),
+  links: section({ added_count: 0, modified_count: 0, added_examples: [], modified_examples: [] }),
+} as unknown as ObsidianCsvSyncSummary;
+
+describe('CsvSyncSummaryModal', () => {
+  it('状態・保存先・履歴件数と、追加/変更の一覧を表示すること', () => {
+    render(<CsvSyncSummaryModal summary={summary} error={null} onClose={vi.fn()} />);
+
+    expect(screen.getByText('状態: 差分ありで保存')).toBeTruthy();
+    expect(screen.getByText('最終保存: -')).toBeTruthy();
+    expect(screen.getByText('履歴件数: 2')).toBeTruthy();
+    expect(screen.getByText('New task')).toBeTruthy();
+    expect(screen.getByText('変更: text, memo')).toBeTruthy();
+    expect(screen.getAllByText('追加 1').length).toBeGreaterThan(0);
+  });
+
+  it.each([
+    ['initial_save', '初回保存'],
+    ['unchanged', '差分なし'],
+  ])('状態 %s は「%s」と表示すること', (status, label) => {
+    render(<CsvSyncSummaryModal summary={{ ...summary, status } as ObsidianCsvSyncSummary} error={null} onClose={vi.fn()} />);
+
+    expect(screen.getByText(`状態: ${label}`)).toBeTruthy();
+  });
+
+  it('サマリが未保存なら、その旨と保存先を表示すること', () => {
+    render(
+      <CsvSyncSummaryModal
+        summary={{ exists: false, output_dir: '/vault/70_gantt_csv', summary_json_path: '', summary_markdown_path: '' }}
+        error={null}
+        onClose={vi.fn()}
+      />,
+    );
+
+    expect(screen.getByText('まだ差分サマリは保存されていません。')).toBeTruthy();
+    expect(screen.getByText('保存先: /vault/70_gantt_csv')).toBeTruthy();
+  });
+
+  it('エラーがあるときは、サマリより優先してエラーだけを表示すること', () => {
+    render(<CsvSyncSummaryModal summary={summary} error="disk full" onClose={vi.fn()} />);
+
+    expect(screen.getByText('disk full')).toBeTruthy();
+    expect(screen.queryByText('履歴件数: 2')).toBeNull();
+  });
+
+  it('✕ボタンと背景のクリックで閉じ、モーダル内のクリックでは閉じないこと', () => {
+    const onClose = vi.fn();
+    const { container } = render(<CsvSyncSummaryModal summary={summary} error={null} onClose={onClose} />);
+
+    fireEvent.click(screen.getByText('Obsidian CSV差分サマリ'));
+    expect(onClose).not.toHaveBeenCalled();
+
+    fireEvent.click(screen.getByText('✕'));
+    fireEvent.click(container.querySelector('.csv-summary-overlay') as HTMLElement);
+    expect(onClose).toHaveBeenCalledTimes(2);
+  });
+});
diff --git a/frontend/src/components/Header/DayRangeInput.test.tsx b/frontend/src/components/Header/DayRangeInput.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..e7f11cc142eb5792683207df4bb9494b68142061
--- /dev/null
+++ b/frontend/src/components/Header/DayRangeInput.test.tsx
@@ -0,0 +1,130 @@
+/**
+ * @vitest-environment jsdom
+ * 表示期間の日数入力欄（DayRangeInput）と、ツールバーのフォーカス移動のテスト
+ **/
+import { useState } from 'react';
+import { cleanup, fireEvent, render, screen } from '@testing-library/react';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { DayRangeInput } from './DayRangeInput';
+import { OptionButtonGroup } from './OptionButtonGroup';
+
+afterEach(cleanup);
+
+function Harness({ editable = true, onCommit = vi.fn(), onActivate = vi.fn(), initial = '0' }) {
+  const [value, setValue] = useState(initial);
+  return (
+    <div className="toolbar">
+      <button>前のボタン</button>
+      <DayRangeInput
+        side="start"
+        value={value}
+        onValueChange={setValue}
+        onCommit={onCommit}
+        editable={editable}
+        onActivate={onActivate}
+      />
+      <span>~</span>
+      <DayRangeInput
+        side="end"
+        value="5"
+        onValueChange={() => {}}
+        onCommit={() => {}}
+        editable={editable}
+        onActivate={() => {}}
+      />
+      <div className="btn-group"><button>次のボタン</button></div>
+    </div>
+  );
+}
+
+const startInput = () => screen.getAllByRole('textbox')[0] as HTMLInputElement;
+const endInput = () => screen.getAllByRole('textbox')[1] as HTMLInputElement;
+
+describe('DayRangeInput', () => {
+  it('全角で入力した数字は半角にそろえ、数字以外は受け付けないこと', () => {
+    render(<Harness />);
+
+    fireEvent.change(startInput(), { target: { value: '－１２' } });
+    expect(startInput().value).toBe('-12');
+
+    fireEvent.change(startInput(), { target: { value: 'abc' } });
+    expect(startInput().value).toBe('-12');
+  });
+
+  it('Enter で範囲内の値に確定して反映すること', () => {
+    const onCommit = vi.fn();
+    render(<Harness onCommit={onCommit} initial="5000" />);
+
+    fireEvent.keyDown(startInput(), { key: 'Enter' });
+
+    expect(onCommit).toHaveBeenCalledWith(1000);
+    expect(startInput().value).toBe('1000');
+  });
+
+  it('フォーカスを外したときも確定すること（空欄は 0）', () => {
+    const onCommit = vi.fn();
+    render(<Harness onCommit={onCommit} initial="" />);
+
+    fireEvent.blur(startInput());
+
+    expect(onCommit).toHaveBeenCalledWith(0);
+    expect(startInput().value).toBe('0');
+  });
+
+  it('期間限定でないときは読み取り専用で、触ると切り替えを要求すること', () => {
+    const onActivate = vi.fn();
+    render(<Harness editable={false} onActivate={onActivate} />);
+
+    expect(startInput().readOnly).toBe(true);
+    fireEvent.mouseDown(startInput());
+
+    expect(onActivate).toHaveBeenCalledWith('start');
+  });
+
+  it('開始側は、右端で右キーを押すと終了側へ、先頭で左キーを押すと前のボタンへ移ること', () => {
+    render(<Harness initial="5" />);
+
+    startInput().focus();
+    startInput().setSelectionRange(1, 1);
+    fireEvent.keyDown(startInput(), { key: 'ArrowRight' });
+    expect(document.activeElement).toBe(endInput());
+
+    startInput().focus();
+    startInput().setSelectionRange(0, 0);
+    fireEvent.keyDown(startInput(), { key: 'ArrowLeft' });
+    expect(document.activeElement).toBe(screen.getByText('前のボタン'));
+  });
+
+  it('終了側は、先頭で左キーを押すと開始側へ、右端で右キーを押すと次のボタン群へ移ること', () => {
+    render(<Harness />);
+
+    endInput().focus();
+    endInput().setSelectionRange(0, 0);
+    fireEvent.keyDown(endInput(), { key: 'ArrowLeft' });
+    expect(document.activeElement).toBe(startInput());
+
+    endInput().focus();
+    endInput().setSelectionRange(1, 1);
+    fireEvent.keyDown(endInput(), { key: 'ArrowRight' });
+    expect(document.activeElement).toBe(screen.getByText('次のボタン'));
+  });
+});
+
+describe('OptionButtonGroup', () => {
+  it('選択中のボタンだけを active にし、押した値を通知すること', () => {
+    const onSelect = vi.fn();
+    render(
+      <OptionButtonGroup
+        options={[{ value: false, label: '未完了' }, { value: true, label: '全て' }]}
+        value={true}
+        onSelect={onSelect}
+      />,
+    );
+
+    expect(screen.getByText('全て').className).toContain('active');
+    expect(screen.getByText('未完了').className).not.toContain('active');
+
+    fireEvent.click(screen.getByText('未完了'));
+    expect(onSelect).toHaveBeenCalledWith(false);
+  });
+});
diff --git a/frontend/src/components/Header/DayRangeInput.tsx b/frontend/src/components/Header/DayRangeInput.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..cf7ed9aa5c90f0b280948084f5614689daadf4cf
--- /dev/null
+++ b/frontend/src/components/Header/DayRangeInput.tsx
@@ -0,0 +1,81 @@
+/**
+ * 表示期間（期間限定モード）の日数入力欄。開始側と終了側で同じ挙動を共有する。
+ *
+ * - 期間限定モードでないときは読み取り専用で、触れるとモードを切り替えてから入力できるようにする。
+ * - 入力中は全角数字なども受け付け、Enter かフォーカスを外したときに -1000〜1000 の値として確定する。
+ */
+import { forwardRef } from 'react';
+import { finalizeNumberInput, isValidNumberInput, normalizeNumberInput } from '../../utils/numberInput';
+import { focusSiblingMatching, pickButton, pickInput } from './toolbarNavigation';
+
+export type DayRangeSide = 'start' | 'end';
+
+interface DayRangeInputProps {
+  side: DayRangeSide;
+  value: string;
+  onValueChange: (value: string) => void;
+  /** 確定した日数をフィルターへ反映する */
+  onCommit: (days: number) => void;
+  /** 期間限定モードのときだけ編集できる */
+  editable: boolean;
+  /** 期間限定モードへ切り替えて、この欄を編集状態にする */
+  onActivate: (side: DayRangeSide) => void;
+}
+
+export const DayRangeInput = forwardRef<HTMLInputElement, DayRangeInputProps>(function DayRangeInput(
+  { side, value, onValueChange, onCommit, editable, onActivate },
+  ref,
+) {
+  const commit = () => {
+    const finalized = finalizeNumberInput(value);
+    if (finalized !== value) onValueChange(finalized);
+    onCommit(Number(finalized));
+  };
+
+  const handleKeyDown = (event: React.KeyboardEvent<HTMLInputElement>) => {
+    event.stopPropagation(); // DHTMLX干渉防止
+    const input = event.currentTarget;
+
+    if (event.key === 'Enter') {
+      commit();
+      input.select(); // 再選択して連続入力を容易に
+      return;
+    }
+
+    // 開始側: 右は終了側の入力欄へ、左は表示期間のボタンへ。終了側: 左は開始側の入力欄へ、右は次のボタン群へ。
+    const atEnd = input.selectionStart === input.value.length;
+    const atStart = input.selectionStart === 0;
+    if (event.key === 'ArrowRight' && atEnd) {
+      event.preventDefault();
+      focusSiblingMatching(input, 'next', side === 'start' ? pickInput : pickButton);
+    } else if (event.key === 'ArrowLeft' && atStart) {
+      event.preventDefault();
+      focusSiblingMatching(input, 'prev', side === 'start' ? pickButton : pickInput);
+    }
+  };
+
+  return (
+    <input
+      ref={ref}
+      type="text"
+      className="number-input wide"
+      readOnly={!editable}
+      aria-disabled={!editable}
+      value={value}
+      onMouseDown={(event) => {
+        if (!editable) {
+          event.preventDefault();
+          onActivate(side);
+        }
+      }}
+      onFocus={() => onActivate(side)}
+      onChange={(event) => {
+        if (isValidNumberInput(event.target.value)) {
+          onValueChange(normalizeNumberInput(event.target.value));
+        }
+      }}
+      onKeyDown={handleKeyDown}
+      onBlur={commit}
+    />
+  );
+});
