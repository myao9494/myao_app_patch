+    ['updateGridLink', () => client.updateGridLink(5, { type: 1 }), 'put', '/api/grid/links/5', undefined, { type: 1 }],
+    ['getGridDiff', () => client.getGridDiff(), 'get', '/api/grid/diff', undefined, undefined],
+    ['commitGrid', () => client.commitGrid(), 'post', '/api/grid/commit', undefined, undefined],
+    ['revertGridDiff', () => client.revertGridDiff('tasks', 5, 'text'), 'post', '/api/grid/revert', undefined, { table: 'tasks', id: 5, field: 'text' }],
+  ];
+
+  it.each(cases)('%s は、期待するメソッド・URL・パラメータ・ボディで呼ぶこと', async (_name, call, method, url, params, body) => {
+    respondWith(200, {});
+
+    await call();
+
+    const sent = requests[0];
+    expect(sent.method).toBe(method);
+    expect(sent.url).toBe(url);
+    expect(sent.params).toEqual(params);
+    // ボディなしの POST は null として送られる
+    expect((sent.data == null ? null : JSON.parse(sent.data)) ?? undefined).toEqual(body);
+  });
+
+  it('日付の解除は、URLに使えない文字をエンコードすること', async () => {
+    respondWith(200, {});
+
+    await client.deleteHoliday('2026/01/01');
+
+    expect(requests[0].url).toBe('/api/holidays/2026%2F01%2F01');
+  });
+
+  it('同義語APIの失敗では、専用の既定メッセージを返すこと', async () => {
+    api.defaults.adapter = async () => { throw 'unexpected'; };
+
+    expect(await client.getSynonyms()).toEqual({ success: false, error: '同義語APIエラー' });
+  });
+});
+
+describe('CSVのインポート/エクスポート', () => {
+  it('インポートは、ファイルを multipart で送ること', async () => {
+    respondWith(200, { imported_count: 1, skipped_count: 0, errors: [] });
+
+    const result = await client.importCSV(new File(['id,text'], 'tasks.csv'));
+
+    expect(result.success).toBe(true);
+    expect(requests[0].url).toBe('/api/import/csv');
+    expect(requests[0].data).toBeInstanceOf(FormData);
+    expect((requests[0].data as FormData).get('file')).toBeInstanceOf(File);
+  });
+
+  it('エクスポートは、成功したら Blob を返し、失敗したら null を返すこと', async () => {
+    const blob = new Blob(['zip']);
+    respondWith(200, blob);
+    expect(await client.exportCSV()).toBe(blob);
+    expect(requests[0].responseType).toBe('blob');
+
+    vi.spyOn(console, 'error').mockImplementation(() => {});
+    respondWith(500, 'error');
+    expect(await client.exportCSV()).toBeNull();
+  });
+});
diff --git a/frontend/src/services/api.ts b/frontend/src/services/api.ts
index 03840de8a0a132c6c2333aebdec37e95f4ec6d99..cf2be11dedbfc80e0475f0250c5fb3830c5c47b3 100644
--- a/frontend/src/services/api.ts
+++ b/frontend/src/services/api.ts
@@ -37,6 +37,35 @@ const api = axios.create({
 
 const DEFAULT_ERROR_MESSAGE = '通信エラー';
 
+// --- 更新シーケンス ---
+// バックエンドは、すべてのAPI応答に現在の更新シーケンス番号を付ける。
+// 変更系（GET以外）の応答で受け取った番号を、観測者（データ管理フック）へ渡す。
+
+const UPDATE_SEQUENCE_HEADER = 'x-update-sequence';
+
+type UpdateSequenceListener = (sequence: number) => void;
+const updateSequenceListeners = new Set<UpdateSequenceListener>();
+
+/** 変更系APIが成功するたびに、その応答時点の更新シーケンス番号を受け取る。戻り値は解除関数 */
+export function observeMutationSequence(listener: UpdateSequenceListener): () => void {
+  updateSequenceListeners.add(listener);
+  return () => {
+    updateSequenceListeners.delete(listener);
+  };
+}
+
+api.interceptors.response.use((response) => {
+  const method = response.config.method?.toLowerCase();
+  const rawSequence = response.headers?.[UPDATE_SEQUENCE_HEADER];
+  if (method && method !== 'get' && rawSequence !== undefined) {
+    const sequence = Number(rawSequence);
+    if (Number.isInteger(sequence)) {
+      updateSequenceListeners.forEach((listener) => listener(sequence));
+    }
+  }
+  return response;
+});
+
 /** 例外から画面表示用のエラーメッセージを取り出す */
 export function describeApiError(error: unknown, fallback: string = DEFAULT_ERROR_MESSAGE): string {
   if (axios.isAxiosError(error)) {
diff --git a/frontend/src/utils/__tests__/diffActions.test.ts b/frontend/src/utils/__tests__/diffActions.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b40ac81b55b98cba681dc88f7724b04d07616163
--- /dev/null
+++ b/frontend/src/utils/__tests__/diffActions.test.ts
@@ -0,0 +1,91 @@
+import { describe, expect, it } from 'vitest';
+import type { Task } from '../../types/gantt';
+import type { TaskDiff } from '../../types/diff';
+import { filterDiffsBySearch, planRevert } from '../diffActions';
+
+function makeTask(id: number, overrides: Partial<Task> = {}): Task {
+  return {
+    id,
+    text: `Task ${id}`,
+    start_date: '2026-03-10 00:00:00',
+    end_date: '2026-03-13 00:00:00',
+    duration: 3,
+    progress: 0,
+    parent: 0,
+    kind_task: 1,
+    owner_id: 0,
+    sortorder: 0,
+    ...overrides,
+  };
+}
+
+describe('filterDiffsBySearch', () => {
+  const diffs: TaskDiff[] = [
+    { type: 'added', task: makeTask(1, { text: 'Alpha Report', memo: 'urgent' }) },
+    { type: 'deleted', task: makeTask(22, { text: 'Beta' }) },
+    { type: 'modified', task: makeTask(3, { text: 'Gamma' }) },
+  ];
+
+  it('検索語が空（空白のみ）なら、そのまま返すこと', () => {
+    expect(filterDiffsBySearch(diffs, '')).toBe(diffs);
+    expect(filterDiffsBySearch(diffs, ' 　 ')).toBe(diffs);
+  });
+
+  it('タスク名・ID・メモを、大文字小文字を区別せずに検索すること', () => {
+    expect(filterDiffsBySearch(diffs, 'alpha').map((d) => d.task.id)).toEqual([1]);
+    expect(filterDiffsBySearch(diffs, '22').map((d) => d.task.id)).toEqual([22]);
+    expect(filterDiffsBySearch(diffs, 'URGENT').map((d) => d.task.id)).toEqual([1]);
+  });
+
+  it('半角・全角スペース区切りの語は、すべて含むものだけを残すこと（AND検索）', () => {
+    expect(filterDiffsBySearch(diffs, 'alpha　urgent').map((d) => d.task.id)).toEqual([1]);
+    expect(filterDiffsBySearch(diffs, 'alpha beta')).toEqual([]);
+  });
+});
+
+describe('planRevert', () => {
+  it('追加された差分は削除、削除された差分は作成に戻すこと', () => {
+    expect(planRevert({ type: 'added', task: makeTask(1) })).toEqual({ kind: 'delete', id: 1 });
+    expect(planRevert({ type: 'deleted', task: makeTask(2) })).toEqual({ kind: 'create', data: makeTask(2) });
+  });
+
+  it('変更された差分は、ファイルの値で更新すること（idは含めない）', () => {
+    const original = makeTask(3, { text: 'Old' });
+    const action = planRevert({ type: 'modified', task: makeTask(3, { text: 'New' }), originalTask: original });
+
+    expect(action?.kind).toBe('update');
+    if (action?.kind !== 'update') return;
+    expect(action.id).toBe(3);
+    expect(action.data.text).toBe('Old');
+    expect('id' in action.data).toBe(false);
+  });
+
+  it('1項目だけを指定したときは、その項目だけを戻すこと', () => {
+    const diff: TaskDiff = {
+      type: 'modified',
+      task: makeTask(3, { text: 'New', memo: 'new memo' }),
+      originalTask: makeTask(3, { text: 'Old', memo: 'old memo' }),
+    };
+
+    expect(planRevert(diff, 'text')).toEqual({ kind: 'update', id: 3, data: { text: 'Old' } });
+  });
+
+  it('日付・期間のどれかを戻すときは、3項目をセットで戻すこと', () => {
+    const diff: TaskDiff = {
+      type: 'modified',
+      task: makeTask(3, { duration: 5, end_date: '2026-03-15 00:00:00' }),
+      originalTask: makeTask(3),
+    };
+
+    expect(planRevert(diff, 'duration')).toEqual({
+      kind: 'update',
+      id: 3,
+      data: { duration: 3, start_date: '2026-03-10 00:00:00', end_date: '2026-03-13 00:00:00' },
+    });
+  });
+
+  it('変更前の値がない変更や、変更なしの差分は戻せないこと', () => {
+    expect(planRevert({ type: 'modified', task: makeTask(1) })).toBeNull();
+    expect(planRevert({ type: 'unchanged', task: makeTask(1) })).toBeNull();
+  });
+});
diff --git a/frontend/src/utils/__tests__/numberInput.test.ts b/frontend/src/utils/__tests__/numberInput.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..84af6bf1714956caec839e646d52504a88a34715
--- /dev/null
+++ b/frontend/src/utils/__tests__/numberInput.test.ts
@@ -0,0 +1,37 @@
+import { describe, expect, it } from 'vitest';
+import { finalizeNumberInput, isValidNumberInput, normalizeNumberInput } from '../numberInput';
+
+describe('normalizeNumberInput', () => {
+  it('全角の数字とハイフン類を半角にすること', () => {
+    expect(normalizeNumberInput('－１２')).toBe('-12');
+    expect(normalizeNumberInput('ー５')).toBe('-5');
+    expect(normalizeNumberInput('−３')).toBe('-3');
+  });
+
+  it('半角の値はそのまま返すこと', () => {
+    expect(normalizeNumberInput('-7')).toBe('-7');
+  });
+});
+
+describe('isValidNumberInput', () => {
+  it.each(['', '-', '0', '-15', '１２', '－３'])('入力途中も含め %j を受け付けること', (value) => {
+    expect(isValidNumberInput(value)).toBe(true);
+  });
+
+  it.each(['a', '1.5', '--1', '1-', '１a'])('%j は受け付けないこと', (value) => {
+    expect(isValidNumberInput(value)).toBe(false);
+  });
+});
+
+describe('finalizeNumberInput', () => {
+  it('数値にできない値は 0 にすること', () => {
+    expect(finalizeNumberInput('')).toBe('0');
+    expect(finalizeNumberInput('-')).toBe('0');
+  });
+
+  it('-1000〜1000 の範囲に収めること', () => {
+    expect(finalizeNumberInput('5000')).toBe('1000');
+    expect(finalizeNumberInput('-5000')).toBe('-1000');
+    expect(finalizeNumberInput('１２')).toBe('12');
+  });
+});
diff --git a/frontend/src/utils/diffActions.ts b/frontend/src/utils/diffActions.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3ce79902b57b1eff9f0817cae9bd41f2c88d840a
--- /dev/null
+++ b/frontend/src/utils/diffActions.ts
@@ -0,0 +1,66 @@
+/**
+ * 差分比較（DiffViewer）の純粋な処理。
+ * - 検索語による差分の絞り込み
+ * - 「ファイルの内容に戻す」ときに、バックエンドへ何をするかの決定
+ */
+import type { Task } from '../types/gantt';
+import type { TaskDiff } from '../types/diff';
+
+/**
+ * タスク名・ID・メモに対する検索で差分を絞り込む。
+ * 半角・全角スペースで区切ったすべての語を含むものだけを残す（AND検索、大文字小文字は区別しない）。
+ */
+export function filterDiffsBySearch(diffs: TaskDiff[], searchText: string): TaskDiff[] {
+  const keywords = searchText
+    .split(/[\s\u3000]+/)
+    .map((keyword) => keyword.toLowerCase().trim())
+    .filter((keyword) => keyword.length > 0);
+  if (keywords.length === 0) return diffs;
+
+  return diffs.filter(({ task }) => {
+    const target = `${task.text?.toLowerCase() || ''} ${task.id} ${task.memo?.toLowerCase() || ''}`;
+    return keywords.every((keyword) => target.includes(keyword));
+  });
+}
+
+/** 差分1件を「ファイルの内容」へ戻すための操作 */
+export type RevertAction =
+  | { kind: 'delete'; id: number }
+  | { kind: 'create'; data: Partial<Task> }
+  | { kind: 'update'; id: number; data: Partial<Task> };
+
+/** 日付・期間は互いに依存するので、どれか1つを戻すときは3つをセットで戻す */
+const DATE_FIELDS: ReadonlyArray<keyof Task> = ['start_date', 'end_date', 'duration'];
+
+/**
+ * 差分をファイルの内容に戻す操作を決める。
+ * - 追加（現在だけにある）→ 削除、削除（ファイルだけにある）→ 作成、変更 → ファイルの値で更新
+ * - fieldKey を指定すると、変更のうち1項目だけを戻す
+ * 戻せない差分（変更前の値がないなど）は null。
+ */
+export function planRevert(diff: TaskDiff, fieldKey?: keyof Task): RevertAction | null {
+  if (diff.type === 'added') {
+    return { kind: 'delete', id: diff.task.id };
+  }
+  if (diff.type === 'deleted') {
+    return { kind: 'create', data: { ...diff.task } };
+  }
+  if (diff.type !== 'modified' || !diff.originalTask) {
+    return null;
+  }
+
+  const original = diff.originalTask;
+  if (fieldKey) {
+    const data: Partial<Task> = { [fieldKey]: original[fieldKey] };
+    if (DATE_FIELDS.includes(fieldKey)) {
+      data.start_date = original.start_date;
+      data.end_date = original.end_date;
+      data.duration = original.duration;
+    }
+    return { kind: 'update', id: diff.task.id, data };
+  }
+
+  const { id: _id, ...data } = original;
+  void _id; // id は更新対象外
+  return { kind: 'update', id: diff.task.id, data };
+}
