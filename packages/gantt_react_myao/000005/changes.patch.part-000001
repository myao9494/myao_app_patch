+def create_task_with_note(task: TaskCreate, obsidian_home: str | None = None, db: Session = Depends(get_db)):
+    """
+    タスクを作り、そのタスクの Obsidian ノートも作って、タスクとノートのパスを 1 回で返す。
+    タスクの作り方は POST /api/tasks と同じ。ノートは POST /api/tasks/{id}/note と同じ。
+    ノートの作成に失敗しても、タスクは作成済みのまま残る（detail に ID を書く。続きは POST /api/tasks/{id}/note）。
+    """
+    obsidian_home = _resolve_obsidian_home(obsidian_home)  # Vault が無いなら、タスクも作らない
+    db_task = create_task(task, db)
+    try:
+        note_path, created = _ensure_note(db, db_task, obsidian_home)
+    except HTTPException as e:
+        raise HTTPException(
+            status_code=e.status_code,
+            detail=f"タスク {db_task.id} は作成済みですが、ノートを作れませんでした: {e.detail}",
+        )
+    return TaskWithNote(task_id=db_task.id, note_path=note_path, created=created, task=db_task)
+
