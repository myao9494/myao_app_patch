+    if source_markdown:
+        files = changed_files(repo, repo, text_extensions, specific_paths=related_paths_for_markdown(repo, source_markdown))
+    elif single_file:
+        files = changed_files(repo, repo, text_extensions, specific_paths=[_single_file_rel_path(repo, single_file, text_extensions)])
+    else:
+        files = changed_files(repo, folder, text_extensions)
+    return folder, repo, source_markdown, single_file, text_extensions, files
+
