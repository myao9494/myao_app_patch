+
+
+def changed_files_for_payload(payload: dict) -> tuple[Path, Path, str | None, str | None, set[str], list[dict]]:
+    """folder の指定（フォルダー・Markdown・ファイル1つ）から、変更の一覧を作る。一覧・コミット・GET で同じ範囲にする。"""
