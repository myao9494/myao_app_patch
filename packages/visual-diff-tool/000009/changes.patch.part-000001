+def _single_file_rel_path(repo: Path, single_file: str, text_extensions: set[str] | None) -> str:
+    """ファイル1つの指定を、リポジトリからの相対パスにする。対象拡張子に無ければ、設定で足すよう案内する。"""
+    try:
+        rel_path = Path(single_file).relative_to(repo).as_posix()
+    except ValueError as exc:
+        raise HTTPException(status_code=422, detail="ファイルがリポジトリの外にあります") from exc
+    if text_extensions is not None and git_file_kind(rel_path, text_extensions) is None:
+        suffix = Path(rel_path).suffix.lower() or "(拡張子なし)"
+        raise HTTPException(
