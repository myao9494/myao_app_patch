diff --git a/frontend/test/lib.test.js b/frontend/test/lib.test.js
index 83e9b364a653fa7ea5a2a098218e7adf866b07d3..eeb088fc0e529730802264a7712a28de9bf0770e 100644
--- a/frontend/test/lib.test.js
