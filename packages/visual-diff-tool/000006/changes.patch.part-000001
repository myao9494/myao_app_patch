+.report-preview-header,
+.report-preview-page > footer {
+  padding: 13px 20px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 14px;
+  border-bottom: 1px solid var(--border);
+  background: var(--surface-2);
 }
+.report-preview-header { position: sticky; top: 0; z-index: 20; }
+
+.report-preview-header h1 { margin: 0; font-size: 20px; }
+.report-preview-header p { margin: 3px 0 0; color: var(--text-muted); font-size: 12px; }
+.report-preview-header > div:last-child { display: flex; gap: 8px; }
+.report-preview-header button, .report-preview-page > footer button { min-height: 34px; padding: 0 14px; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); background: var(--surface-2); color: var(--text); font-weight: 600; cursor: pointer; }
+.report-preview-header button:hover:not(:disabled), .report-preview-page > footer button:hover:not(:disabled) { background: var(--surface-hover); }
+.report-preview-header button.primary, .report-preview-page > footer button.primary { border-color: transparent; background: var(--accent); color: #fff; }
+.report-preview-header button.primary:hover:not(:disabled), .report-preview-page > footer button.primary:hover:not(:disabled) { background: var(--accent-strong); }
+.report-preview-header button { display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
+.report-preview-page > footer { border-top: 1px solid var(--border); border-bottom: 0; }
+.report-preview-content { min-height: 0; padding: 18px; }
+.report-preview-card { width: min(1180px, 100%); margin: 0 auto 14px; border: 1px solid var(--border-strong); border-radius: 8px; overflow: hidden; background: var(--surface-2); box-shadow: 0 8px 24px rgba(0,0,0,.24); }
+.report-preview-card > header { min-height: 52px; padding: 8px 11px; display: grid; grid-template-columns: auto minmax(0,1fr) auto auto; align-items: center; gap: 8px; background: var(--surface-1); cursor: grab; }
+.report-preview-card > header > div { min-width: 0; display: flex; flex-direction: column; }
+.report-preview-card > header strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.report-preview-card > header small { color: var(--text-muted); }
+.report-preview-card > header button { width: 32px; height: 30px; border: 1px solid var(--text-faint); border-radius: 4px; background: var(--bg); color: #fff; cursor: pointer; }
+.report-preview-text { padding: 10px; overflow: auto; }
+.report-preview-labels, .report-preview-row { min-width: 720px; display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr) 38px; }
+.report-preview-labels b { padding: 6px 10px; background: #273449; }
+.report-preview-row code { min-width: 0; padding: 4px 8px; display: grid; grid-template-columns: 42px minmax(0,1fr); border-bottom: 1px solid var(--border); white-space: pre-wrap; overflow-wrap: anywhere; }
+.report-preview-row code:first-child { background: #3d2027; }
+.report-preview-row code:nth-child(2) { background: #173927; }
+.report-preview-row code i { padding-right: 8px; color: var(--text-muted); text-align: right; font-style: normal; user-select: none; }
+.report-preview-row > button { margin: 3px; border: 1px solid var(--accent); border-radius: 4px; display: grid; place-items: center; background: var(--accent-strong); color: #fff; cursor: pointer; }
+.report-preview-clean { padding: 14px; color: #86efac; }
+.report-preview-image-editor { padding: 12px; }
+.report-preview-note-tabs { margin-bottom: 10px; display: flex; gap: 6px; flex-wrap: wrap; }
+.report-preview-note-tabs button { min-height: 30px; padding: 0 10px; border: 1px solid var(--border-strong); border-radius: 5px; background: var(--surface-2); color: var(--text-muted); cursor: pointer; }
+.report-preview-note-tabs button.active { border-color: var(--accent); background: var(--accent-strong); color: #fff; }
+.report-crop-layout { display: grid; grid-template-columns: minmax(360px, 1fr) minmax(260px, 340px); align-items: start; gap: 16px; }
+.report-view-editor { position: relative; max-width: 100%; padding: 0 8px 8px 0; }
+.report-view-toolbar { margin-bottom: 9px; }
+.report-view-actions { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; }
+.report-view-actions button { min-height: 32px; padding: 0 11px; border: 1px solid var(--text-faint); border-radius: 5px; background: var(--surface-1); color: var(--text); cursor: pointer; }
+.report-view-actions button.active { border-color: #93c5fd; background: var(--accent-strong); color: #fff; }
+.report-view-actions span { padding: 4px 7px; border-radius: 4px; background: var(--bg); color: var(--text-muted); font-size: 12px; }
+.report-crop-hint { margin: 0 0 7px; color: #bfdbfe; font-size: 12px; }
+.report-crop-stage { position: relative; width: 100%; overflow: hidden; border: 1px solid var(--text-faint); background: #fff; cursor: crosshair; touch-action: none; user-select: none; }
+.report-crop-stage img { position: absolute; display: block; max-width: none; pointer-events: none; }
+.report-pan-stage { cursor: grab; }
+.report-pan-stage:active { cursor: grabbing; }
+.report-pan-stage.selecting { cursor: crosshair; }
+.report-crop-selection { position: absolute; border: 2px solid #6366f1; background: rgba(99, 102, 241, .08); box-shadow: 0 0 0 9999px rgba(15, 23, 42, .36); pointer-events: none; }
+.report-crop-selection i { position: absolute; width: 14px; height: 14px; border: 3px solid #6366f1; background: #fff; }
+.report-crop-selection i:nth-child(1) { left: -7px; top: -7px; border-right: 0; border-bottom: 0; }
+.report-crop-selection i:nth-child(2) { right: -7px; top: -7px; border-left: 0; border-bottom: 0; }
+.report-crop-selection i:nth-child(3) { right: -7px; bottom: -7px; border-left: 0; border-top: 0; }
+.report-crop-selection i:nth-child(4) { left: -7px; bottom: -7px; border-right: 0; border-top: 0; }
+.report-visible-area-badge { position: absolute; right: 8px; bottom: 8px; padding: 4px 7px; border-radius: 4px; background: rgba(15,23,42,.82); color: #fff; font-size: 11px; pointer-events: none; }
+.report-card-resize-handle { position: absolute; right: 0; bottom: 0; width: 22px; height: 22px; padding: 0; border: 0; border-right: 4px solid var(--accent); border-bottom: 4px solid var(--accent); background: transparent; cursor: nwse-resize; touch-action: none; }
+.report-preview-memo-editor { min-height: 220px; padding: 14px; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; border: 1px solid var(--border-strong); border-radius: 7px; background: var(--surface-2); }
+.report-preview-memo-editor > strong { color: #f8fafc; font-size: 16px; }
+.report-preview-memo-editor textarea { width: 100%; min-height: 180px; resize: vertical; border: 1px solid var(--text-faint); border-radius: 5px; padding: 10px; background: var(--bg); color: #fff; font: inherit; line-height: 1.5; }
+.report-preview-memo-editor button { min-height: 32px; padding: 0 10px; border: 1px solid var(--text-faint); border-radius: 5px; background: var(--surface-1); color: var(--text); cursor: pointer; }
 
