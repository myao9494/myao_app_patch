+}
+
+/* ---- 右パネル（比較の設定と結果） ---- */
+
+.inspector {
+  position: relative;
+  min-height: 0;
+  display: flex;
+  flex-direction: column;
+  border-left: 1px solid var(--border);
+  background: var(--surface-1);
+  overflow-y: auto;
+}
+
+.inspector-close {
+  display: none;
+  position: absolute;
+  top: 8px;
+  right: 8px;
   z-index: 1;
+  width: 28px;
+  min-height: 28px;
+}
+
+.inspector-section {
   padding: 14px 16px;
+  border-bottom: 1px solid var(--border);
+}
+
+.inspector-section.grow {
+  flex: 1;
+  border-bottom: 0;
+}
+
+.inspector-section h3 {
+  margin: 0 0 10px;
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  color: var(--text-muted);
+  font-size: 12px;
+  font-weight: 700;
+  letter-spacing: 0.04em;
+}
+
+.inspector-section h3 .count {
+  padding: 0 6px;
+  border-radius: 999px;
+  background: var(--surface-3);
+  color: var(--text);
+  font-size: 11px;
+}
+
+.inspector-hint,
+.inspector-note {
+  margin: 0;
+  color: var(--text-muted);
+  font-size: 12.5px;
+}
+
+.inspector-note {
+  margin-top: 8px;
+  display: flex;
+  gap: 6px;
+  align-items: baseline;
+  color: var(--text-faint);
+}
+
+.summary-hero {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+}
+
+.summary-label {
+  color: var(--text-muted);
+  font-size: 12px;
+  font-weight: 700;
+}
+
+.summary-hero strong {
+  font-size: 30px;
+  font-weight: 750;
+  line-height: 1.15;
+  font-variant-numeric: tabular-nums;
+  letter-spacing: -0.01em;
+}
+
+.summary-hero strong.has-diff {
+  color: #ffc35c;
+}
+
+.summary-hero strong.no-diff {
+  color: var(--success);
+}
+
+.summary-sub {
+  color: var(--text-muted);
+  font-size: 13px;
+}
+
+.summary-grid {
+  margin: 12px 0 0;
+  display: grid;
