+.shortcut-help-modal > header > div { display: flex; align-items: center; gap: 9px; }
+.shortcut-help-modal h2 { margin: 0; font-size: 18px; }
+.shortcut-help-modal header button { width: 32px; height: 32px; border: 1px solid var(--text-faint); border-radius: 5px; background: var(--bg); color: #fff; font-size: 20px; cursor: pointer; }
+.shortcut-help-body { padding: 16px; }
+.shortcut-help-body h3 { margin: 0 0 9px; color: #bfdbfe; font-size: 14px; }
+.shortcut-help-body h3:not(:first-child) { margin-top: 20px; }
+.shortcut-help-body dl { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7px 16px; }
+.shortcut-help-body dl div { display: grid; grid-template-columns: 110px 1fr; align-items: center; gap: 8px; }
+.shortcut-help-body dt, .shortcut-help-body dd { margin: 0; }
+.shortcut-help-body kbd { display: inline-block; min-width: 30px; padding: 3px 7px; border: 1px solid var(--text-faint); border-bottom-width: 2px; border-radius: 5px; background: var(--bg); color: #fff; text-align: center; }
+.shortcut-help-body ul { margin: 0; padding-left: 20px; color: var(--text-muted); line-height: 1.55; }
+
+.report-preview-page {
+  min-height: 100vh;
+  display: grid;
+  grid-template-rows: auto minmax(0, 1fr) auto;
+  background: #0b1220;
+  color: #e5e7eb;
 }
 
-.notice.warning {
-  background: #422006;
