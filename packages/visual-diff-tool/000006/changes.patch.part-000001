+.three-diff-container{display:flex;flex-direction:column;width:100%;height:100%;background:var(--bg-primary, var(--bg));color:var(--text-primary, #f8fafc);overflow:hidden}.three-diff-toolbar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px 12px;padding:8px 12px;background:var(--surface-1);border-bottom:1px solid var(--border);font-size:13px;z-index:10}.three-diff-section-toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px;padding:7px 12px;background:var(--surface-2);border-bottom:1px solid var(--border);font-size:13px;z-index:9}.three-diff-axis-buttons{display:flex;gap:2px;padding:2px;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--surface-1)}.three-diff-git-badge{display:inline-flex;align-items:center;gap:8px;min-height:30px;padding:0 10px 0 4px;background:var(--surface-2);border:1px solid var(--border);border-radius:var(--radius-sm);font-size:12px}.three-diff-git-tag{background:var(--accent-soft);color:#a9c2ff;font-size:10.5px;font-weight:800;padding:3px 7px;border-radius:5px;letter-spacing:.03em}.three-diff-git-path{color:var(--text);font-family:var(--font-mono);max-width:340px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.three-diff-axis-btn{min-height:26px;padding:0 10px;border:0;border-radius:5px;background:transparent;color:var(--text-muted);font-size:12px;font-weight:700;cursor:pointer}.three-diff-axis-btn:hover{background:var(--surface-3);color:var(--text)}.three-diff-axis-btn.active{background:var(--surface-3);color:var(--text);box-shadow:inset 0 0 0 1px var(--border-strong)}.three-diff-controls-group{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.three-diff-input-group{display:flex;align-items:center;gap:6px}.three-diff-input-group label{color:var(--text-muted);font-size:12px;font-weight:600;white-space:nowrap}.three-diff-select,.three-diff-input{min-height:30px;padding:0 8px;border:1px solid var(--border-strong);border-radius:var(--radius-sm);background:var(--surface-2);color:var(--text);font-size:12.5px}.three-diff-btn{min-height:30px;padding:0 11px;display:inline-flex;align-items:center;gap:6px;border:1px solid var(--border-strong);border-radius:var(--radius-sm);background:var(--surface-2);color:var(--text);font-size:12.5px;font-weight:600;white-space:nowrap;cursor:pointer;transition:background .12s,border-color .12s,color .12s}.three-diff-btn:hover:not(:disabled){background:var(--surface-hover)}.three-diff-btn:disabled{opacity:.45;cursor:not-allowed}.three-diff-btn-primary{border-color:#5b8cff8c;background:var(--accent-soft);color:#c4d5ff}.three-diff-btn-primary:hover:not(:disabled){background:#5b8cff38}.three-diff-btn.three-diff-run{border-color:transparent;background:var(--accent);color:#fff}.three-diff-btn.three-diff-run:hover:not(:disabled){background:var(--accent-strong)}.three-diff-slider-box{min-height:30px;display:flex;align-items:center;gap:8px;padding:0 8px;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--surface-2)}.three-diff-slider-box input[type=range]{width:130px;cursor:pointer;accent-color:var(--accent)}.three-diff-stat-badge{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:12px;font-size:11px;font-weight:600}.badge-added{background:#22c55e33;color:#4ade80;border:1px solid rgba(34,197,94,.4)}.badge-deleted{background:#ef444433;color:#f87171;border:1px solid rgba(239,68,68,.4)}.three-diff-workspace{display:flex;flex:1;position:relative;overflow:hidden}.three-diff-canvas-area{display:flex;flex:1;height:100%;position:relative;background:#090d16}.three-diff-viewport{position:relative;flex:1;height:100%;overflow:hidden}.three-canvas-host{position:absolute;inset:0;width:100%;height:100%;overflow:hidden}.three-diff-viewport canvas{width:100%!important;height:100%!important;display:block}.viewport-label{position:absolute;top:10px;left:12px;background:#0f172ad9;border:1px solid var(--border);padding:4px 10px;border-radius:4px;font-size:12px;font-weight:600;pointer-events:none;z-index:5}.three-diff-setup-card{display:flex;flex-direction:column;gap:16px;width:min(680px,calc(100% - 32px));height:fit-content;align-self:center;margin:40px auto;padding:24px;background:var(--surface-1);border:1px solid var(--border);border-radius:var(--radius-lg);box-shadow:var(--shadow)}.dropzone-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}.step-dropzone{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px 16px;border:2px dashed var(--border-strong);border-radius:6px;background:var(--bg);cursor:pointer;text-align:center;transition:border-color .15s,background .15s}.step-dropzone:hover{border-color:var(--accent);background:#131d33}.step-dropzone.has-file{border-color:#22c55e;border-style:solid}.dropzone-title{font-weight:600;font-size:14px;margin-bottom:4px}.dropzone-filename{font-size:12px;color:var(--text-muted);word-break:break-all}.samples-selector{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--text-muted);padding-top:8px;border-top:1px solid var(--border)}.three-diff-warning-box{padding:8px 12px;background:#eab30826;border:1px solid rgba(234,179,8,.4);border-radius:4px;color:#fde047;font-size:12px;margin:8px 16px;display:flex;flex-direction:column;gap:4px}.three-diff-error-box{padding:10px 14px;background:#ef444426;border:1px solid rgba(239,68,68,.4);border-radius:4px;color:#fca5a5;font-size:13px;margin:12px 16px}.three-diff-progress-overlay{position:absolute;inset:0;background:#0f172ad9;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;z-index:50}.three-diff-progress-bar{width:320px;height:8px;background:var(--border);border-radius:4px;overflow:hidden}.three-diff-progress-fill{height:100%;background:var(--accent);transition:width .3s}.three-diff-stats-drawer{padding:6px 16px;background:var(--bg);border-top:1px solid var(--border);font-size:11px;color:var(--text-muted);display:flex;flex-wrap:wrap;gap:16px;align-items:center}
