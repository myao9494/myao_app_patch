+  font-variant-numeric: tabular-nums;
+}
+
+.summary-method {
+  margin: 8px 0 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  color: var(--text-faint);
+  font-size: 11.5px;
+}
+
+.callout {
+  margin: 0;
+  padding: 8px 10px;
+  display: flex;
+  gap: 8px;
+  align-items: flex-start;
+  border-radius: var(--radius-sm);
+  font-size: 12.5px;
+}
+
+.callout + .callout {
+  margin-top: 8px;
+}
+
+.callout svg {
+  flex: none;
+  margin-top: 2px;
+}
+
+.callout.warning {
+  background: rgba(245, 181, 61, 0.1);
+  color: #f8cf7c;
+}
+
+.callout.info {
+  background: var(--accent-soft);
+  color: #a9c2ff;
+}
+
+.anchor-action {
+  width: 100%;
+  margin-top: 8px;
+}
+
+.legend {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+  display: grid;
+  gap: 7px;
+}
+
+.legend li {
+  display: grid;
+  grid-template-columns: 14px auto 1fr;
+  align-items: center;
+  gap: 8px;
+  font-weight: 650;
+}
+
+.legend li span {
+  justify-self: end;
+  color: var(--text-faint);
+  font-size: 12px;
+  font-weight: 500;
+}
+
+.swatch {
+  width: 14px;
+  height: 14px;
+  border-radius: 4px;
+}
+
+.swatch.removed { background: var(--removed); }
+.swatch.added { background: var(--added); }
+.swatch.changed { background: var(--changed); }
+
+.slider-field {
+  display: grid;
+  gap: 8px;
+}
+
+.slider-head {
   display: flex;
   align-items: center;
   justify-content: space-between;
-  border-bottom: 1px solid #334155;
-  background: #1e293b;
 }
 
-.shortcut-help-modal > header > div { display: flex; align-items: center; gap: 9px; }
-.shortcut-help-modal h2 { margin: 0; font-size: 18px; }
-.shortcut-help-modal header button { width: 32px; height: 32px; border: 1px solid #64748b; border-radius: 5px; background: #0f172a; color: #fff; font-size: 20px; cursor: pointer; }
-.shortcut-help-body { padding: 16px; }
-.shortcut-help-body h3 { margin: 0 0 9px; color: #bfdbfe; font-size: 14px; }
-.shortcut-help-body h3:not(:first-child) { margin-top: 20px; }
-.shortcut-help-body dl { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7px 16px; }
-.shortcut-help-body dl div { display: grid; grid-template-columns: 110px 1fr; align-items: center; gap: 8px; }
-.shortcut-help-body dt, .shortcut-help-body dd { margin: 0; }
-.shortcut-help-body kbd { display: inline-block; min-width: 30px; padding: 3px 7px; border: 1px solid #64748b; border-bottom-width: 2px; border-radius: 5px; background: #0f172a; color: #fff; text-align: center; }
-.shortcut-help-body ul { margin: 0; padding-left: 20px; color: #cbd5e1; line-height: 1.55; }
+.slider-head h3 {
+  margin: 0;
+}
+
+.slider-head output {
+  padding: 1px 8px;
+  border-radius: var(--radius-sm);
+  background: var(--surface-2);
+  font-weight: 700;
+  font-variant-numeric: tabular-nums;
+}
+
+.slider-field input[type="range"] {
+  width: 100%;
+}
+
+.slider-scale {
+  display: flex;
+  justify-content: space-between;
+  color: var(--text-faint);
+  font-size: 11px;
+}
+
+.segmented.full {
+  width: 100%;
+}
+
+.segmented.full button {
+  flex: 1;
+  justify-content: center;
+  padding: 0 6px;
+}
+
+.anchor-chip {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 4px 4px 4px 10px;
+  border: 1px solid rgba(60, 207, 142, 0.4);
+  border-radius: var(--radius-sm);
+  background: rgba(60, 207, 142, 0.08);
+  color: #86e2b9;
+}
+
+.anchor-chip span {
+  flex: 1;
+}
+
+.change-list {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+  display: grid;
+  gap: 4px;
+}
+
+.change-list button {
+  width: 100%;
+  min-height: 34px;
+  padding: 0 10px;
+  display: grid;
+  grid-template-columns: 26px 1fr auto;
+  align-items: center;
+  gap: 8px;
+  border: 1px solid transparent;
+  border-radius: var(--radius-sm);
+  background: var(--surface-2);
+  color: var(--text);
+  text-align: left;
+  cursor: pointer;
+}
+
+.change-list button:hover:not(:disabled) {
+  border-color: var(--border-strong);
+  background: var(--surface-3);
+}
+
+.change-list button.active {
+  border-color: rgba(91, 140, 255, 0.6);
+  background: var(--accent-soft);
+}
+
+.change-index {
+  width: 22px;
+  height: 22px;
+  display: grid;
+  place-items: center;
+  border-radius: 6px;
+  background: var(--surface-3);
+  font-size: 11px;
+  font-weight: 800;
+}
+
+.change-size {
+  font-weight: 600;
+  font-variant-numeric: tabular-nums;
+}
+
+.change-pos {
+  color: var(--text-faint);
+  font-size: 11.5px;
+  font-variant-numeric: tabular-nums;
+}
+
+/* ---- Git差分: サイドバー ---- */
+
+.git-sidebar {
+  min-height: 0;
+  display: flex;
+  flex-direction: column;
+  border-right: 1px solid var(--border);
+  background: var(--surface-1);
+}
+
+.git-source {
+  padding: 14px;
+  border-bottom: 1px solid var(--border);
+}
+
+.git-source .field-label {
+  display: block;
+  margin-bottom: 6px;
+}
+
+.git-source-row {
+  display: flex;
+  gap: 6px;
+}
+
+.git-folder-box {
+  position: relative;
+  flex: 1;
+  min-width: 0;
+}
+
+.git-folder-box .input {
+  width: 100%;
+  padding-right: 32px;
+}
+
+.git-history-toggle {
+  position: absolute;
+  top: 3px;
+  right: 3px;
+  width: 28px;
+  height: 28px;
+  border: 0;
+  border-radius: 5px;
+  display: grid;
+  place-items: center;
+  background: transparent;
+  color: var(--text-muted);
+  cursor: pointer;
+}
+
+.git-history-toggle:hover:not(:disabled) {
+  background: var(--surface-3);
+  color: var(--text);
+}
+
+.git-history-toggle:disabled {
+  opacity: 0.3;
+  cursor: not-allowed;
+}
+
+.git-history {
+  position: absolute;
+  left: 0;
+  right: -40px;
+  top: calc(100% + 4px);
+  z-index: 40;
+  max-height: 280px;
+  overflow: auto;
+  padding: 4px;
+  border: 1px solid var(--border-strong);
+  border-radius: var(--radius);
+  background: var(--surface-2);
+  box-shadow: var(--shadow);
+}
+
+.git-history button {
+  width: 100%;
+  min-height: 32px;
+  padding: 6px 8px;
+  border: 0;
+  border-radius: var(--radius-sm);
+  background: transparent;
+  color: var(--text);
+  cursor: pointer;
+  overflow: hidden;
+  text-align: left;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  direction: rtl;
+}
 
