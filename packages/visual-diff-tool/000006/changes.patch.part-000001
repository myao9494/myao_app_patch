+  const rightPaneImage = activeResult ? rightImage : activeTab === "git" ? (gitItem?.image_current ? toDataUri(gitItem.image_current) : null) : rightPreviewImage;
+  const viewerHasImage = Boolean(leftPaneImage || rightPaneImage);
+  const gitPosition = currentGitTarget ? `${gitIndex + 1} / ${gitTargets.length}` : "";
+
+  return (
+    <main className={`app-shell ${gitTextMode ? "text-diff-mode" : ""}`} style={{ zoom: displayScale, height: `${100 / displayScale}vh` }}>
+      <AppHeader
+        activeTab={activeTab}
+        onChangeTab={setActiveTab}
+        settings={settings}
+        onExtensionsApplied={() => {
+          setGitInfo(null);
+          setGitResult(null);
+          setGitItem(null);
+        }}
+        onSaveObsidianSettings={saveObsidianFolderSetting}
+        onOpenHelp={() => setHelpOpen(true)}
+      />
+
+      {activeTab === "3d" ? (
+        <React.Suspense fallback={<div className="loading-panel"><Loader2 className="spin" size={20} />3D差分ビューアーを読み込み中…</div>}>
+          <ThreeDiffViewer />
+        </React.Suspense>
+      ) : (
+        <div className={`workspace ${activeTab === "git" ? "has-sidebar" : ""} ${showInspector ? "has-inspector" : ""}`}>
+          {activeTab === "git" && (
+            <GitSidebar
+              folder={gitFolder}
+              folderHistory={gitFolderHistory}
+              onFolderChange={changeGitFolder}
+              onLoad={loadGitImages}
+              info={gitInfo}
+              files={comparableGitFiles}
+              targets={gitTargets}
+              currentFile={currentGitFile}
+              currentView={currentGitView}
+              busy={gitBusy}
+              onSelectTarget={(index) => index >= 0 && selectGitIndex(index)}
+              excludedPaths={gitExportExcluded}
+              onToggleExport={(path, included) => setGitExportExcluded((paths) => included
+                ? paths.filter((item) => item !== path)
+                : [...new Set([...paths, path])])}
+              onIncludeAll={() => setGitExportExcluded([])}
+              onExcludeAll={() => setGitExportExcluded(comparableGitFiles.map((file) => file.path))}
+              onExport={exportGitHtml}
+              exportBusy={exportBusy}
+            />
+          )}
+
+          <section className="main-column">
+            {activeTab === "files" && (
+              <div className="source-bar">
+                <SourceCard
+                  label="A"
+                  role="基準（変更前）"
+                  side="left"
+                  active={activeSide === "left"}
+                  data={left}
+                  page={pageA}
+                  setPage={(page) => selectPage("left", page)}
+                  onActivate={setActiveSide}
+                  onPasteImage={pasteImage}
+                  onFile={(file) => loadFile("left", file)}
+                />
+                <ArrowRight className="source-arrow" size={18} aria-hidden="true" />
+                <SourceCard
+                  label="B"
+                  role="比較対象（変更後）"
+                  side="right"
+                  active={activeSide === "right"}
+                  data={right}
+                  page={pageB}
+                  setPage={(page) => selectPage("right", page)}
+                  onActivate={setActiveSide}
+                  onPasteImage={pasteImage}
+                  onFile={(file) => loadFile("right", file)}
+                />
+                <button type="button" className="btn btn-primary btn-lg compare-button" disabled={!canCompare || busy} onClick={() => compare()}>
+                  {busy ? <Loader2 className="spin" size={18} /> : <ScanSearch size={18} />}
+                  {result ? "再比較" : "比較"}
+                </button>
+              </div>
+            )}
+
+            {activeTab === "git" && currentGitFile && (
+              <div className="git-file-header">
+                <div className="git-file-title">
+                  <strong title={currentGitFile.path}>{currentGitFile.path}</strong>
+                  {currentGitView === "excalidraw" && <span className="badge">Excalidraw図</span>}
+                  <span className={`badge ${currentGitFile.change_type}`}>{changeTypeLabel(currentGitFile.change_type)}</span>
+                  {currentGitFile.head_path !== currentGitFile.path && <span className="git-file-from">← {currentGitFile.head_path}</span>}
+                </div>
+                <div className="git-file-nav">
+                  <span>{gitPosition}</span>
+                  <button type="button" className="btn btn-ghost btn-icon" title="前のファイル（←）" aria-label="前のファイル" disabled={gitBusy} onClick={() => selectGitIndex(gitIndex - 1)}>
+                    <ChevronLeft size={18} />
+                  </button>
+                  <button type="button" className="btn btn-ghost btn-icon" title="次のファイル（→）" aria-label="次のファイル" disabled={gitBusy} onClick={() => selectGitIndex(gitIndex + 1)}>
+                    <ChevronRight size={18} />
+                  </button>
+                </div>
+              </div>
+            )}
+
+            {exportNotice && <div className="banner success" role="status">{exportNotice}<button type="button" aria-label="閉じる" onClick={() => setExportNotice("")}><X size={14} /></button></div>}
+            {currentError && <div className="banner error" role="alert"><AlertTriangle size={16} />{currentError}</div>}
+
+            {gitTextMode ? (
+              <TextDiffView
+                file={currentGitFile}
+                item={gitItem}
+                memo={currentTextMemo}
+                busy={gitBusy}
+                previewBusy={textEditor.busy}
+                dirty={textEditor.dirty}
+                onEditText={textEditor.editLine}
+                onSave={textEditor.save}
+                onRevertLine={textEditor.revertLine}
+                onMemoChange={(value) => setGitTextMemos((current) => ({ ...current, [currentTextMemoKey]: value }))}
+              />
+            ) : git3dMode ? (
+              <React.Suspense fallback={<div className="loading-panel"><Loader2 className="spin" size={20} />3D差分ビューアーを読み込み中…</div>}>
+                <ThreeDiffViewer gitMode={true} gitFile={currentGitFile} gitFolder={gitInfo?.folder || gitFolder} />
+              </React.Suspense>
+            ) : (showFilesViewer || showGitImageViewer) && (activeTab === "files" || currentGitFile) ? (
+              <section className="viewer-area" aria-busy={activeTab === "git" ? gitBusy : busy}>
+                {(activeTab === "git" ? gitBusy : busy) && <div className="progress-bar" role="progressbar" aria-label="処理中" />}
+                {viewerHasImage && <ViewerToolbar
+                  view={view}
+                  onViewChange={setView}
+                  viewsEnabled={Boolean(activeResult)}
+                  zoom={zoom}
+                  onZoom={(delta) => setZoom((value) => Math.max(0.25, Math.min(3, value + delta)))}
+                  onFitWidth={() => setZoom(1)}
+                  onFitAll={fitWholeImage}
+                  memoLabel={activeTab === "git" ? "画像メモ" : "差分メモ"}
+                  onOpenMemo={viewerHasImage ? (activeTab === "git" ? openGitMemo : () => openDiffMemoTab(result, left, right, setError)) : null}
+                  canOpenMemo={activeTab === "git" ? Boolean(gitResult || gitItem?.image_head || gitItem?.image_current) : Boolean(result)}
+                  status={(activeTab === "git" ? gitBusy : busy) ? "処理中…" : ""}
+                  inspectorOpen={showInspector}
+                  onToggleInspector={inspectorAvailable ? () => setInspectorOpen((open) => !open) : null}
+                />}
+                <div className="viewer">
+                  <ImagePane
+                    title={activeTab === "git" ? "変更前（HEAD）" : "A 基準"}
+                    side="left"
+                    active={activeSide === "left"}
+                    subtitle={activeTab === "git" ? currentGitFile?.head_path : left?.file?.name}
+                    image={leftPaneImage}
+                    zoom={zoom}
+                    regions={activeTab === "git" || (activeResult && view !== "original") ? [] : pickingAnchor ? left?.regions ?? [] : anchorRegion ? [anchorRegion] : []}
+                    selectedRegion={anchorRegion}
+                    onSelectRegion={selectAnchorRegion}
+                    onActivate={setActiveSide}
+                    onPasteImage={pasteImage}
+                    onDropFile={activeTab === "files" ? (file) => loadFile("left", file) : undefined}
+                    onPickFile={activeTab === "files" ? (file) => loadFile("left", file) : undefined}
+                    emptyTitle={activeTab === "git" ? "変更前の画像はありません" : "A：基準になる画像"}
+                    emptyHint={activeTab === "git" ? "このファイルは新しく追加されました" : "ファイルをドロップ、またはこの枠をクリックして Ctrl+V で貼り付け"}
+                    loading={activeTab === "git" ? gitBusy : busy && !left?.preview}
+                    focusRect={activeResult && view !== "original" ? focusedRect : null}
+                    onCanvasRef={(element) => registerCanvas("left", element)}
+                    onCanvasScroll={(event) => syncCanvasScroll("left", event)}
+                    onCanvasWheel={handleImageWheel}
+                  />
+                  <ImagePane
+                    title={rightPaneTitle}
+                    side="right"
+                    active={activeSide === "right"}
+                    subtitle={activeTab === "git" ? currentGitFile?.path : right?.file?.name}
+                    image={rightPaneImage}
+                    zoom={zoom}
+                    regions={[]}
+                    selectedRegion={null}
+                    onActivate={setActiveSide}
+                    onPasteImage={pasteImage}
+                    onDropFile={activeTab === "files" ? (file) => loadFile("right", file) : undefined}
+                    onPickFile={activeTab === "files" ? (file) => loadFile("right", file) : undefined}
+                    emptyTitle={activeTab === "git" ? "変更後の画像はありません" : "B：比較する画像"}
+                    emptyHint={activeTab === "git" ? "このファイルは削除されました" : "ファイルをドロップ、またはこの枠をクリックして Ctrl+V で貼り付け"}
+                    loading={activeTab === "git" ? gitBusy : false}
+                    focusRect={activeResult && view !== "original" ? focusedRect : null}
+                    onCanvasRef={(element) => registerCanvas("right", element)}
+                    onCanvasScroll={(event) => syncCanvasScroll("right", event)}
+                    onCanvasWheel={handleImageWheel}
+                  />
+                </div>
+              </section>
+            ) : (
+              activeTab === "git" && !gitBusy && (
+                <div className="placeholder-panel">
+                  <FolderGit2 size={36} strokeWidth={1.4} />
+                  <strong>{gitInfo ? "変更されたファイルはありません" : "左のパネルでフォルダーを指定してください"}</strong>
+                  <span>{gitInfo ? "HEAD との差分が見つかりませんでした。" : "Gitリポジトリのフォルダー、またはObsidianのMarkdownファイルを指定して読み込みます。"}</span>
+                </div>
+              )
+            )}
+          </section>
+
+          {showInspector && (
+            <DiffInspector
+              result={activeResult}
+              threshold={diffThreshold}
+              onThresholdChange={setDiffThreshold}
+              category={category}
+              onCategoryChange={selectCategory}
+              anchor={activeTab === "files" && left?.file instanceof File ? {
+                selected: anchorRegion,
+                count: left?.regions?.length ?? 0,
+                picking: pickingAnchor,
+                onStartPicking: startPickingAnchor,
+                onCancelPicking: () => setPickingAnchor(false),
+                onClear: clearAnchorRegion,
+              } : null}
+              focusedRect={focusedRect}
+              onFocusRect={focusDiffRect}
+              busy={activeTab === "git" ? gitBusy : busy}
+              onClose={() => setInspectorOpen(false)}
+            />
+          )}
+        </div>
+      )}
+      {helpOpen && <ShortcutHelp page={activeTab === "git" ? "git" : "files"} onClose={() => setHelpOpen(false)} />}
+    </main>
+  );
+
+  async function loadGitImages(folderOverride = gitFolder) {
+    const requestId = gitRequestIdRef.current + 1;
+    gitRequestIdRef.current = requestId;
+    setGitBusy(true);
+    setGitError("");
+    setGitResult(null);
+    setGitItem(null);
+    try {
+      const folder = String(folderOverride || "").trim();
+      const info = await postJson("/git/files", { folder, text_extensions: textExtensions });
+      if (requestId !== gitRequestIdRef.current) return;
+      setGitInfo(info);
+      const normalizedFolder = folder;
+      if (normalizedFolder) {
+        setGitFolderHistory((history) => [normalizedFolder, ...history.filter((item) => item !== normalizedFolder)].slice(0, 12));
+      }
+      setGitExportExcluded([]);
+      const nextFiles = (info.files ?? []).filter((file) => file.comparable);
+      setGitIndex(0);
+      if (nextFiles[0]) {
+        await loadGitFile(nextFiles[0], requestId, info.folder || folder, nextFiles[0].kind === "text" ? "text" : nextFiles[0].kind === "3d" ? "3d" : "image");
+      }
+    } catch (err) {
+      if (requestId === gitRequestIdRef.current) setGitError(err.message);
+    } finally {
+      if (requestId === gitRequestIdRef.current) setGitBusy(false);
+    }
+  }
+
+  async function selectGitIndex(nextIndex) {
+    if (!gitTargets.length) return;
+    const wrappedIndex = (nextIndex + gitTargets.length) % gitTargets.length;
+    const target = gitTargets[wrappedIndex];
+    setGitIndex(wrappedIndex);
+    if (target.file.path === currentGitFile?.path) {
+      if (target.mode === currentGitView) return;
+      if (target.mode === "text" && gitItem) {
+        setGitResult(null);
+        return;
+      }
+    }
+    const requestId = gitRequestIdRef.current + 1;
+    gitRequestIdRef.current = requestId;
+    setGitBusy(true);
+    setGitError("");
+    setGitResult(null);
+    setGitItem(null);
+    try {
+      await loadGitFile(target.file, requestId, undefined, target.mode);
+    } catch (err) {
+      if (requestId === gitRequestIdRef.current) setGitError(err.message);
+    } finally {
+      if (requestId === gitRequestIdRef.current) setGitBusy(false);
+    }
+  }
+
+  async function compareGitFile(
+    file,
+    requestId = gitRequestIdRef.current,
+    selectedCategory = category,
+    folderOverride = gitInfo?.folder || gitFolder,
+    targetMode = "image",
+  ) {
+    const nextResult = await postJson("/git/diff", {
+      folder: folderOverride,
+      path: file.path,
+      head_path: file.head_path,
+      category: selectedCategory,
+      diff_threshold: diffThreshold,
+      ...(targetMode === "excalidraw" ? { subresource: "excalidraw" } : {}),
+    });
+    if (requestId === gitRequestIdRef.current) {
+      setGitResult(nextResult);
+    }
+  }
+
+  async function loadGitFile(file, requestId = gitRequestIdRef.current, folderOverride = gitInfo?.folder || gitFolder, targetMode = file.kind === "text" ? "text" : file.kind === "3d" ? "3d" : "image") {
+    if (file.kind === "3d" || targetMode === "3d") {
+      setGitItem(null);
+      setGitResult(null);
+      return;
+    }
+    if ((file.kind === "image" || targetMode === "excalidraw") && file.diffable) {
+      await compareGitFile(file, requestId, targetMode === "excalidraw" ? "図面" : category, folderOverride, targetMode);
+      return;
+    }
+    const nextItem = await postJson("/git/item", {
+      folder: folderOverride,
+      text_extensions: textExtensions,
+      include_text: file.kind === "text",
+      ...file,
+    });
+    if (requestId === gitRequestIdRef.current) {
+      if (file.kind === "text") {
+        const textCurrent = normalizeLineEndings(nextItem.text_current ?? "");
+        const textHead = normalizeLineEndings(nextItem.text_head ?? "");
+        setGitItem({ ...nextItem, text_head: textHead, text_current: textCurrent, text_saved: textCurrent });
+        textEditor.resetHistory(file.path);
+      } else {
+        setGitItem(nextItem);
+        textEditor.resetHistory();
+      }
+    }
+  }
+
+  async function openGitMemo() {
+    if (!currentGitFile || !gitInfo) return;
+    const fallbackImage = gitItem?.image_head ?? gitItem?.image_current;
+    const memoResult = gitResult ?? (fallbackImage ? {
+      image_a: gitItem?.image_head ?? fallbackImage,
+      image_b_aligned: gitItem?.image_current ?? fallbackImage,
+    } : null);
+    if (!memoResult) return;
+    // Markdown内のExcalidraw図は本文テキストのメモと別物なので、メモIDを分けて保存する。
+    const id = gitImageMemoId(
+      gitInfo.repo_root,
+      currentGitView === "excalidraw" ? `${currentGitFile.path}#excalidraw` : currentGitFile.path,
+    );
+    const memoFiles = comparableGitFiles.filter((file) => file.kind === "image");
+    const memoIndex = memoFiles.findIndex((file) => file.path === currentGitFile.path);
+    await openDiffMemoTab(
+      memoResult,
+      { file: { name: `変更前:${currentGitFile.head_path}` } },
+      { file: { name: currentGitFile.path } },
+      setGitError,
+      id,
+      {
+        reportPreviewReturn: true,
+        memoNavigation: memoIndex >= 0 ? {
+          folder: gitInfo.folder || gitFolder,
+          repo_root: gitInfo.repo_root,
+          files: memoFiles,
+          index: memoIndex,
+          category,
+          diff_threshold: diffThreshold,
+          text_extensions: textExtensions,
+        } : null,
+      },
+    );
+  }
+
+  async function exportGitHtml() {
+    if (!gitInfo || !exportableGitFiles.length) return;
+    setExportBusy(true);
+    setExportNotice("");
+    setGitError("");
+    try {
+      const entries = await collectReportEntries({
+        files: exportableGitFiles,
+        info: gitInfo,
+        folder: gitFolder,
+        current: { file: currentGitFile, view: currentGitView, result: gitResult, item: gitItem },
+        category,
+        diffThreshold,
+        textExtensions,
+        textMemos: gitTextMemos,
+        concurrency: EXPORT_FETCH_CONCURRENCY,
+      });
+      setReportPreview(entries);
+      window.history.pushState(null, "", `${window.location.pathname}${window.location.search}#report-preview`);
+      setExportNotice("プレビューを作成しました。内容を調整してから出力してください。");
+    } catch (err) {
+      setGitError(`HTMLプレビューを作成できませんでした: ${err.message}`);
+    } finally {
+      setExportBusy(false);
+    }
+  }
+
+  async function revertPreviewLine(entryIndex, row) {
+    if (!gitInfo) return;
+    const entry = reportPreview?.[entryIndex];
+    if (!entry || entry.file.kind !== "text") return;
+    setExportBusy(true);
+    setGitError("");
+    try {
+      const restored = await postJson("/git/revert-line", {
+        folder: gitInfo.folder || gitFolder,
+        text_extensions: textExtensions,
+        path: entry.file.path,
+        head_path: entry.file.head_path,
+        row,
+      });
+      setReportPreview((current) => current?.map((item, index) => (
+        index === entryIndex ? { ...item, data: { ...item.data, rows: restored.rows } } : item
+      )) ?? null);
+      if (entry.file.path === currentGitFile?.path) {
+        setGitItem((current) => {
+          if (!current) return current;
+          // 未保存の編集中テキストは上書きしない（表示行と本文の整合を保つ）。保存時はサーバーが
+          // base_text を照合し、ファイルが変わっていれば409で拒否するので、編集内容は失われない。
+          const dirty = normalizeLineEndings(current.text_current ?? "") !== normalizeLineEndings(current.text_saved ?? "");
+          if (dirty || typeof restored.text_current !== "string") return current;
+          return { ...current, rows: restored.rows, text_current: restored.text_current, text_saved: restored.text_current };
+        });
+      }
+      setExportNotice(`${entry.file.path} の1行を変更前へ戻しました。`);
+    } catch (err) {
+      setGitError(`行を戻せませんでした: ${err.message}`);
+    } finally {
+      setExportBusy(false);
+    }
+  }
+
+  async function finalizeGitHtml(entries) {
+    if (!gitInfo || !entries.length) {
+      setGitError("HTML出力に必要な情報がありません。プレビューを閉じて、もう一度開いてください。");
+      return;
+    }
+    setExportBusy(true);
+    setExportNotice("");
+    setGitError("");
+    try {
+      const html = await buildStandaloneGitReport(gitInfo, entries);
+      const filename = gitReportFilename(gitInfo);
+      if (gitInfo.source_markdown && obsidianReportFolder) {
+        const saved = await postJson("/reports/save", {
+          html,
+          filename,
+          source_markdown: gitInfo.source_markdown,
+        });
+        setExportNotice(`HTMLを保存しました: ${saved.path}`);
+      } else {
+        downloadTextFile(html, filename, "text/html;charset=utf-8");
+        setExportNotice(`HTMLを保存しました（${entries.length}件、外部接続なしで閲覧できます）`);
+      }
+      closeReportPreviewPage();
+    } catch (err) {
+      setGitError(`HTML出力に失敗しました: ${err.message}`);
+    } finally {
+      setExportBusy(false);
+    }
+  }
+
+  function closeReportPreviewPage() {
+    setReportPreview(null);
+    if (window.location.hash.startsWith("#report-preview")) {
+      window.history.back();
+    }
+  }
+}
diff --git a/frontend/src/components/AppHeader.jsx b/frontend/src/components/AppHeader.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..3494a88782548e31ff679d20c066f3e9eeee9329
--- /dev/null
+++ b/frontend/src/components/AppHeader.jsx
@@ -0,0 +1,45 @@
+/**
+ * メイン画面のヘッダー（アプリ名・モード切替・ヘルプ・設定メニュー）。
+ */
+import React from "react";
+import { Boxes, FolderGit2, HelpCircle, ImageUp } from "lucide-react";
+import { SettingsMenu } from "./SettingsMenu.jsx";
+
+const MODES = [
+  { id: "files", label: "ファイル差分", icon: ImageUp },
+  { id: "git", label: "Git差分", icon: FolderGit2 },
+  { id: "3d", label: "3D差分", icon: Boxes },
+];
+
+export function AppHeader({ activeTab, onChangeTab, settings, onExtensionsApplied, onSaveObsidianSettings, onOpenHelp }) {
+  return (
+    <header className="app-header">
+      <div className="brand">
+        <span className="brand-mark" aria-hidden="true">
+          <span />
+          <span />
+        </span>
+        <span className="brand-name">Visual Diff</span>
+      </div>
+      <nav className="segmented mode-tabs" aria-label="比較モード">
+        {MODES.map(({ id, label, icon: Icon }) => (
+          <button key={id} type="button" className={activeTab === id ? "active" : ""} onClick={() => onChangeTab(id)}>
+            <Icon size={16} />
+            {label}
+          </button>
+        ))}
+      </nav>
+      <div className="header-actions">
+        <button type="button" className="btn btn-ghost btn-icon" title="ショートカットと操作（H）" aria-label="ショートカットと操作" onClick={onOpenHelp}>
+          <HelpCircle size={18} />
+        </button>
+        <SettingsMenu
+          settings={settings}
+          onExtensionsApplied={onExtensionsApplied}
+          onSaveObsidianSettings={onSaveObsidianSettings}
+          onOpenHelp={onOpenHelp}
+        />
+      </div>
+    </header>
+  );
+}
diff --git a/frontend/src/components/DiffInspector.jsx b/frontend/src/components/DiffInspector.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..8017232ce659a96affb7a109173eb0718f692e19
--- /dev/null
+++ b/frontend/src/components/DiffInspector.jsx
@@ -0,0 +1,154 @@
+/**
+ * 画像差分の右パネル。比較の設定（カテゴリ・基準領域・しきい値）と結果（差分率・凡例・変更箇所の一覧）をまとめる。
+ * 変更箇所をクリックすると、左右の画像をその位置へ移動して強調表示する。
+ */
+import React from "react";
+import { AlertTriangle, Crosshair, MousePointer2, X } from "lucide-react";
+
+const CATEGORIES = ["汎用", "図面", "グラフ", "書類"];
+
+export function DiffInspector({
+  result,
+  threshold,
+  onThresholdChange,
+  category,
+  onCategoryChange,
+  anchor,
+  focusedRect,
+  onFocusRect,
+  busy,
+  onClose,
+}) {
+  const rects = result?.diff_rects ?? [];
+  const warnings = [
+    result?.alignment?.warning ? `位置合わせに失敗したため、補正せずに比較しています（${result.alignment.warning}）` : null,
+    ...(result?.conversion_warnings ?? []).map((warning) => `変換時の注意: ${warning}`),
+  ].filter(Boolean);
+
+  return (
+    <aside className="inspector" aria-label="比較の設定と結果">
+      {onClose && (
+        <button type="button" className="btn btn-ghost btn-icon inspector-close" aria-label="右パネルを閉じる" title="閉じる（I）" onClick={onClose}>
+          <X size={16} />
+        </button>
+      )}
+      {result ? (
+        <section className="inspector-section summary-section">
+          <div className="summary-hero">
+            <span className="summary-label">差分率</span>
+            <strong className={result.diff_ratio > 0 ? "has-diff" : "no-diff"}>{(result.diff_ratio * 100).toFixed(3)}%</strong>
+            <span className="summary-sub">
+              {rects.length ? `${rects.length}か所の変更` : result.diff_pixels ? "小さな差分のみ" : "差分なし"}
+            </span>
+          </div>
+          <dl className="summary-grid">
+            <div><dt>差分ピクセル</dt><dd>{result.diff_pixels.toLocaleString()}</dd></div>
+            <div title="一致した特徴点の数 / 位置合わせに採用した数"><dt>特徴点</dt><dd>{result.alignment.method === "cached" ? "—" : `${result.alignment.matches} / ${result.alignment.inliers}`}</dd></div>
+          </dl>
+          <p className="summary-method" title={result.alignment.method}>位置合わせ: {result.alignment.method === "none" ? "なし" : result.alignment.method === "cached" ? "保存済みの結果" : result.alignment.method}</p>
+        </section>
+      ) : (
+        <section className="inspector-section">
+          <p className="inspector-hint">A と B を選んで「比較」を押すと、ここに差分率と変更箇所が表示されます。</p>
+        </section>
+      )}
+
+      {warnings.length > 0 && (
+        <section className="inspector-section">
+          {warnings.map((warning) => (
+            <p className="callout warning" key={warning}><AlertTriangle size={15} />{warning}</p>
+          ))}
+        </section>
+      )}
+
+      {result && (
+        <section className="inspector-section">
+          <h3>凡例</h3>
+          <ul className="legend">
+            <li><i className="swatch removed" />削除<span>A（基準）だけにある</span></li>
+            <li><i className="swatch added" />追加<span>B（比較）だけにある</span></li>
+            <li><i className="swatch changed" />変更<span>両方にあり、違う</span></li>
+          </ul>
+        </section>
+      )}
+
+      <section className="inspector-section">
+        <label className="slider-field">
+          <span className="slider-head">
+            <h3>しきい値</h3>
+            <output>{threshold.toFixed(2)}</output>
+          </span>
+          <input type="range" min="0" max="1" step="0.01" value={threshold} onChange={(event) => onThresholdChange(Number(event.target.value))} />
+          <span className="slider-scale"><span>細かな違いも検出</span><span>大きな違いだけ</span></span>
+        </label>
+      </section>
+
+      <section className="inspector-section">
+        <h3>画像の種類</h3>
+        <div className="segmented full" role="group" aria-label="画像の種類">
+          {CATEGORIES.map((item) => (
+            <button key={item} type="button" className={category === item ? "active" : ""} onClick={() => onCategoryChange(item)}>
+              {item}
+            </button>
+          ))}
+        </div>
+        <p className="inspector-note">種類に合わせて位置合わせの前処理を切り替えます。</p>
+      </section>
+
+      {anchor && (
+        <section className="inspector-section">
+          <h3>位置合わせの基準領域</h3>
+          {anchor.picking ? (
+            <>
+              <p className="callout info"><MousePointer2 size={15} />A の画像上で、位置合わせに使う枠をクリックしてください。</p>
+              <button type="button" className="btn btn-ghost anchor-action" onClick={anchor.onCancelPicking}>やめる</button>
+            </>
+          ) : anchor.selected ? (
+            <>
+              <div className="anchor-chip">
+                <Crosshair size={15} />
+                <span>{anchor.selected.label}</span>
+                <button type="button" className="btn btn-ghost btn-icon" aria-label="基準領域を解除" title="解除" onClick={anchor.onClear}>
+                  <X size={15} />
+                </button>
+              </div>
+              <button type="button" className="btn btn-ghost anchor-action" onClick={anchor.onStartPicking}>選び直す</button>
+            </>
+          ) : (
+            <>
+              <button type="button" className="btn anchor-action" disabled={!anchor.count} onClick={anchor.onStartPicking}>
+                <Crosshair size={15} />
+                画像上で選ぶ（{anchor.count}候補）
+              </button>
+              <p className="inspector-note">通常は自動で位置合わせします。ずれる場合に、図枠など動かない部分を基準にできます。</p>
+            </>
+          )}
+        </section>
+      )}
+
+      {result && (
+        <section className="inspector-section grow">
+          <h3>変更箇所 <span className="count">{rects.length}</span></h3>
+          {rects.length ? (
+            <ol className="change-list">
+              {rects.map((rect, index) => {
+                const active = focusedRect && focusedRect.x === rect.x && focusedRect.y === rect.y && focusedRect.width === rect.width && focusedRect.height === rect.height;
+                return (
+                  <li key={`${rect.x}-${rect.y}-${rect.width}-${rect.height}`}>
+                    <button type="button" className={active ? "active" : ""} disabled={busy} onClick={() => onFocusRect(rect)}>
+                      <span className="change-index">{index + 1}</span>
+                      <span className="change-size">{rect.width} × {rect.height}px</span>
+                      <span className="change-pos">({rect.x}, {rect.y})</span>
+                    </button>
+                  </li>
+                );
+              })}
+            </ol>
+          ) : (
+            <p className="inspector-note">大きな変更箇所はありません。</p>
+          )}
+        </section>
+      )}
+    </aside>
+  );
+}
diff --git a/frontend/src/components/ImagePane.jsx b/frontend/src/components/ImagePane.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..6dade87cd01312a4c67f63330c86d722af322ac5
--- /dev/null
+++ b/frontend/src/components/ImagePane.jsx
@@ -0,0 +1,233 @@
+/**
+ * 比較画像の表示ペイン（拡大縮小・左右スクロール同期・基準領域候補の表示）。
+ * 画像がないときは、ドロップ／クリックで選択／貼り付けを案内する空の状態を表示する。
+ * focusRect（画像ピクセル座標）を渡すと、その変更箇所を強調枠で示す。
+ */
+import React, { useEffect, useRef, useState } from "react";
+import { ImagePlus } from "lucide-react";
+import { firstDroppedFile } from "../lib/files.js";
+
+export function ImagePane({
+  title,
+  side,
+  active,
+  subtitle,
+  image,
+  zoom,
+  regions = [],
+  selectedRegion,
+  onSelectRegion,
+  onActivate,
+  onPasteImage,
+  onDropFile,
+  onCanvasRef,
+  onCanvasScroll,
+  onCanvasWheel,
+  onPickFile,
+  emptyTitle,
+  emptyHint,
+  focusRect = null,
+  loading = false,
+}) {
+  const inputRef = useRef(null);
+  const [imageSize, setImageSize] = useState(null);
+  const [panning, setPanning] = useState(false);
+  const panRef = useRef(null);
+  const imageRef = useRef(null);
+  useEffect(() => {
+    // 読み込み済みの画像では load イベントがこの effect より先に来ることがあるため、要素から直接読む
+    const element = imageRef.current;
+    setImageSize(element?.complete && element.naturalWidth
+      ? { width: element.naturalWidth, height: element.naturalHeight }
+      : null);
+  }, [image]);
+
+  const [dragging, setDragging] = useState(false);
+
+  function startCanvasPan(event) {
+    if (event.button !== 0 && event.button !== 1) return;
+    // 基準領域ボタンはクリック選択を優先し、ドラッグパンを開始しない。
+    if (event.button === 0 && event.target.closest?.("button")) return;
+    event.preventDefault();
+    const canvas = event.currentTarget;
+    panRef.current = {
+      pointerId: event.pointerId,
+      button: event.button,
+      startX: event.clientX,
+      startY: event.clientY,
+      scrollLeft: canvas.scrollLeft,
+      scrollTop: canvas.scrollTop,
+      moved: false,
+    };
+    canvas.setPointerCapture?.(event.pointerId);
+    setPanning(true);
+  }
+
+  function moveCanvasPan(event) {
+    const pan = panRef.current;
+    if (!pan || pan.pointerId !== event.pointerId) return;
+    const canvas = event.currentTarget;
+    const deltaX = event.clientX - pan.startX;
+    const deltaY = event.clientY - pan.startY;
+    if (!pan.moved && Math.hypot(deltaX, deltaY) < 4) return;
+    pan.moved = true;
+    event.preventDefault();
+    canvas.scrollLeft = pan.scrollLeft - deltaX;
+    canvas.scrollTop = pan.scrollTop - deltaY;
+    setPanning(true);
+  }
+
+  function endCanvasPan(event) {
+    const pan = panRef.current;
+    if (!pan || pan.pointerId !== event.pointerId) return;
+    panRef.current = null;
+    if (event.currentTarget.hasPointerCapture?.(event.pointerId)) {
+      event.currentTarget.releasePointerCapture(event.pointerId);
+    }
+    setPanning(false);
+  }
+
+  function handleDrop(event) {
+    event.preventDefault();
+    setDragging(false);
+    onActivate(side);
+    const file = firstDroppedFile(event.dataTransfer);
+    if (file) onDropFile?.(file);
+  }
+
+  return (
+    <article
+      className={`pane ${active ? "active" : ""} ${dragging ? "dragging" : ""}`}
+      tabIndex={0}
+      onFocus={() => onActivate(side)}
+      onClick={() => onActivate(side)}
+      onPaste={(event) => onPasteImage(side, event)}
+      onDragEnter={(event) => {
+        event.preventDefault();
+        setDragging(true);
+        onActivate(side);
+      }}
+      onDragOver={(event) => event.preventDefault()}
+      onDragLeave={(event) => {
+        if (!event.currentTarget.contains(event.relatedTarget)) setDragging(false);
+      }}
+      onDrop={handleDrop}
+    >
+      <div className="pane-title">
+        <span className={`pane-dot ${side}`} aria-hidden="true" />
+        <strong>{title}</strong>
+        {subtitle && <span title={subtitle}>{subtitle}</span>}
+      </div>
+      <div
+        className={`canvas ${panning ? "panning" : ""}`}
+        ref={onCanvasRef}
+        onScroll={onCanvasScroll}
+        onWheel={onCanvasWheel}
+        onPointerDown={startCanvasPan}
+        onPointerMove={moveCanvasPan}
+        onPointerUp={endCanvasPan}
+        onPointerCancel={endCanvasPan}
+        onAuxClick={(event) => {
+          if (event.button === 1) event.preventDefault();
+        }}
+      >
+        {image ? (
+          <div className="image-stage" style={{ width: `${zoom * 100}%` }}>
+            <img
+              ref={imageRef}
+              src={image}
+              alt={title}
+              draggable={false}
+              onLoad={(event) =>
+                setImageSize({
+                  width: event.currentTarget.naturalWidth,
+                  height: event.currentTarget.naturalHeight,
+                })
+              }
+            />
+            {imageSize && focusRect && (
+              <div className="focus-box" style={regionStyle(focusRect, imageSize)} aria-hidden="true" />
+            )}
+            {imageSize && regions.length > 0 && (
+              <div className="region-layer" aria-label="基準領域候補">
+                {regions.map((region, index) => (
+                  <button
+                    key={`${region.x}-${region.y}-${region.width}-${region.height}-${index}`}
+                    className={`region-box ${isSameRegion(region, selectedRegion) ? "selected" : ""}`}
+                    title={`${region.label} (${region.width}x${region.height})`}
+                    style={regionStyle(region, imageSize)}
+                    onClick={(event) => {
+                      event.stopPropagation();
+                      onSelectRegion?.(region);
+                    }}
+                  >
+                    {index + 1}
+                  </button>
+                ))}
+              </div>
+            )}
+          </div>
+        ) : (
+          <div className={`empty-state ${dragging ? "dragging" : ""}`}>
+            {loading ? (
+              <span className="empty-loading" aria-label="読み込み中" />
+            ) : (
+              <>
+                <ImagePlus size={34} strokeWidth={1.5} />
+                <strong>{emptyTitle ?? "画像がありません"}</strong>
+                {emptyHint && <span>{emptyHint}</span>}
+                {onPickFile && (
+                  <>
+                    <button
+                      type="button"
+                      className="btn"
+                      onPointerDown={(event) => event.stopPropagation()}
+                      onClick={(event) => {
+                        event.stopPropagation();
+                        inputRef.current?.click();
+                      }}
+                    >
+                      ファイルを選択
+                    </button>
+                    <input
+                      ref={inputRef}
+                      type="file"
+                      hidden
+                      onChange={(event) => {
+                        if (event.target.files?.[0]) {
+                          onPickFile(event.target.files[0]);
+                          event.target.value = "";
+                        }
+                      }}
+                    />
+                  </>
+                )}
+              </>
+            )}
+          </div>
+        )}
+      </div>
+    </article>
+  );
+}
+
+function regionStyle(region, imageSize) {
+  return {
+    left: `${(region.x / imageSize.width) * 100}%`,
+    top: `${(region.y / imageSize.height) * 100}%`,
+    width: `${(region.width / imageSize.width) * 100}%`,
+    height: `${(region.height / imageSize.height) * 100}%`,
+  };
+}
+
+function isSameRegion(a, b) {
+  return Boolean(
+    a &&
+      b &&
+      a.x === b.x &&
+      a.y === b.y &&
+      a.width === b.width &&
+      a.height === b.height &&
+      a.label === b.label,
+  );
+}
diff --git a/frontend/src/components/SettingsMenu.jsx b/frontend/src/components/SettingsMenu.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..85cdbc2a12af4960d482365d706392da154e51ef
--- /dev/null
+++ b/frontend/src/components/SettingsMenu.jsx
@@ -0,0 +1,252 @@
+/**
+ * メイン画面と差分メモ画面で共通のハンバーガーメニューと設定状態。
+ * - Git対象拡張子・表示倍率: このブラウザの localStorage に保存し、別タブの変更も storage イベントで反映する
+ * - Obsidianフォルダー・レポート保存先: Backend の設定ファイルへ保存する（/api/settings/obsidian）
+ */
+import React, { useEffect, useRef, useState } from "react";
+import { BookOpenText, ExternalLink, HelpCircle, Menu } from "lucide-react";
+import { API_BASE, getJson } from "../lib/api.js";
+import {
+  DEFAULT_TEXT_EXTENSIONS,
+  DISPLAY_SCALE_STORAGE_KEY,
+  GIT_EXTENSION_STORAGE_KEY,
+  loadDisplayScale,
+  loadTextExtensions,
+  normalizeTextExtensions,
+  persistLocalStorage,
+} from "../lib/storage.js";
+
+export function useAppSettings() {
+  const [textExtensions, setTextExtensions] = useState(loadTextExtensions);
+  const [extensionDraft, setExtensionDraft] = useState(() => loadTextExtensions().join(", "));
+  const [obsidianFolder, setObsidianFolder] = useState("");
+  const [obsidianFolderDraft, setObsidianFolderDraft] = useState("");
+  const [obsidianReportFolder, setObsidianReportFolder] = useState("");
+  const [obsidianReportFolderDraft, setObsidianReportFolderDraft] = useState("");
+  const [obsidianSettingsBusy, setObsidianSettingsBusy] = useState(false);
+  const [displayScale, setDisplayScale] = useState(loadDisplayScale);
+
+  function applyServerSettings(settings) {
+    const folder = String(settings.obsidian_folder || "");
+    const reportFolder = String(settings.obsidian_report_folder || "");
+    setObsidianFolder(folder);
+    setObsidianFolderDraft(folder);
+    setObsidianReportFolder(reportFolder);
+    setObsidianReportFolderDraft(reportFolder);
+  }
+
+  useEffect(() => {
+    getJson("/settings/obsidian").then(applyServerSettings).catch(() => {
+      // 設定APIのない古いサーバーでも、設定以外の機能はそのまま使える。
+    });
+  }, []);
+
+  useEffect(() => {
+    persistLocalStorage(GIT_EXTENSION_STORAGE_KEY, textExtensions);
+  }, [textExtensions]);
+
+  useEffect(() => {
+    persistLocalStorage(DISPLAY_SCALE_STORAGE_KEY, displayScale);
+  }, [displayScale]);
+
+  useEffect(() => {
+    function syncSharedSettings(event) {
+      if (event.key === DISPLAY_SCALE_STORAGE_KEY) setDisplayScale(loadDisplayScale());
+      if (event.key === GIT_EXTENSION_STORAGE_KEY) {
+        const next = loadTextExtensions();
+        setTextExtensions(next);
+        setExtensionDraft(next.join(", "));
+      }
+    }
+    window.addEventListener("storage", syncSharedSettings);
+    return () => window.removeEventListener("storage", syncSharedSettings);
+  }, []);
+
+  /** 入力中のObsidian設定をサーバーへ保存する。失敗時は例外を投げる（表示方法は呼び出し側が決める）。 */
+  async function saveObsidianSettings() {
+    setObsidianSettingsBusy(true);
+    try {
+      const response = await fetch(`${API_BASE}/settings/obsidian`, {
+        method: "PUT",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({
+          obsidian_folder: obsidianFolderDraft.trim(),
+          obsidian_report_folder: obsidianReportFolderDraft.trim(),
+        }),
+      });
+      const body = await response.json().catch(() => ({}));
+      if (!response.ok) throw new Error(body.detail || `設定保存に失敗しました（${response.status}）`);
+      applyServerSettings(body);
+    } finally {
+      setObsidianSettingsBusy(false);
+    }
+  }
+
+  return {
+    textExtensions,
+    setTextExtensions,
+    extensionDraft,
+    setExtensionDraft,
+    obsidianFolder,
+    obsidianFolderDraft,
+    setObsidianFolderDraft,
+    obsidianReportFolder,
+    obsidianReportFolderDraft,
+    setObsidianReportFolderDraft,
+    obsidianSettingsBusy,
+    saveObsidianSettings,
+    displayScale,
+    setDisplayScale,
+  };
+}
+
+export function SettingsMenu({ settings, className = "", onExtensionsApplied, onSaveObsidianSettings, onOpenHelp }) {
+  const [menuOpen, setMenuOpen] = useState(false);
+  const containerRef = useRef(null);
+
+  // メニューの外をクリック、または Esc で閉じる
+  useEffect(() => {
+    if (!menuOpen) return undefined;
+    function closeOnOutside(event) {
+      if (!containerRef.current?.contains(event.target)) setMenuOpen(false);
+    }
+    function closeOnEscape(event) {
+      if (event.key === "Escape") setMenuOpen(false);
+    }
+    document.addEventListener("pointerdown", closeOnOutside);
+    window.addEventListener("keydown", closeOnEscape);
+    return () => {
+      document.removeEventListener("pointerdown", closeOnOutside);
+      window.removeEventListener("keydown", closeOnEscape);
+    };
+  }, [menuOpen]);
+  const {
+    extensionDraft,
+    setExtensionDraft,
+    setTextExtensions,
+    obsidianFolder,
+    obsidianFolderDraft,
+    setObsidianFolderDraft,
+    obsidianReportFolder,
+    obsidianReportFolderDraft,
+    setObsidianReportFolderDraft,
+    obsidianSettingsBusy,
+    displayScale,
+    setDisplayScale,
+  } = settings;
+
+  return (
+    <div className="header-menu" ref={containerRef}>
+      <button className="menu-button" type="button" aria-label="メニュー" aria-expanded={menuOpen} onClick={() => setMenuOpen((open) => !open)}>
+        <Menu size={22} />
+      </button>
+      {menuOpen && (
+        <div className={`hamburger-menu ${className}`.trim()} role="menu">
+          <section className="settings-group">
+            <h4>Git差分</h4>
+            <label className="settings-field">
+              <span>テキストとして比較する拡張子（カンマ区切り）</span>
+              <textarea value={extensionDraft} rows={2} onChange={(event) => setExtensionDraft(event.target.value)} />
+            </label>
+            <small>画像・STEPは常に対象です。このブラウザに保存されます。</small>
+            <div className="settings-actions">
+              <button
+                type="button"
+                className="btn btn-primary"
+                onClick={() => {
+                  const next = normalizeTextExtensions(extensionDraft);
+                  setTextExtensions(next);
+                  setExtensionDraft(next.join(", "));
+                  onExtensionsApplied?.(next);
+                }}
+              >
+                適用
+              </button>
+              <button
+                type="button"
+                className="btn"
+                onClick={() => {
+                  setExtensionDraft(DEFAULT_TEXT_EXTENSIONS.join(", "));
+                  setTextExtensions(DEFAULT_TEXT_EXTENSIONS);
+                }}
+              >
+                初期値に戻す
+              </button>
+            </div>
+          </section>
+          <section className="settings-group">
+            <h4>Obsidian連携 <span>サーバーに保存</span></h4>
+            <label className="settings-field">
+              <span>Obsidianフォルダー（Vault）</span>
+              <input
+                type="text"
+                value={obsidianFolderDraft}
+                placeholder="/path/to/obsidian-vault"
+                onChange={(event) => setObsidianFolderDraft(event.target.value)}
+              />
+            </label>
+            <small>Markdownを指定したときのリンク解決に使います。</small>
+            <label className="settings-field">
+              <span>HTMLレポートの保存先</span>
+              <input
+                type="text"
+                value={obsidianReportFolderDraft}
+                placeholder="/path/to/report-folder"
+                onChange={(event) => setObsidianReportFolderDraft(event.target.value)}
+              />
+            </label>
+            <small>Markdown起点のHTMLレポートをこのフォルダーへ保存します（未設定ならダウンロード）。</small>
+            <div className="settings-actions">
+              <button type="button" className="btn btn-primary" disabled={obsidianSettingsBusy} onClick={onSaveObsidianSettings}>
+                {obsidianSettingsBusy ? "保存中…" : "サーバーへ保存"}
+              </button>
+              <button
+                type="button"
+                className="btn"
+                onClick={() => {
+                  setObsidianFolderDraft(obsidianFolder);
+                  setObsidianReportFolderDraft(obsidianReportFolder);
+                }}
+              >
+                変更を戻す
+              </button>
+            </div>
+          </section>
+          <section className="settings-group">
+            <h4>表示</h4>
+            <label className="settings-field">
+              <span className="settings-row"><span>アプリの表示倍率</span><output>{Math.round(displayScale * 100)}%</output></span>
+              <input
+                type="range"
+                min="50"
+                max="200"
+                step="5"
+                value={Math.round(displayScale * 100)}
+                onChange={(event) => setDisplayScale(Number(event.target.value) / 100)}
+              />
+            </label>
+            <div className="settings-actions">
+              <button type="button" className="btn" disabled={displayScale === 1} onClick={() => setDisplayScale(1)}>100%に戻す</button>
+            </div>
+          </section>
+          <button
+            type="button"
+            role="menuitem"
+            onClick={() => {
+              setMenuOpen(false);
+              window.open("/api-guide", "_blank", "noopener,noreferrer");
+            }}
+          >
+            <BookOpenText size={18} />
+            APIエンドポイント説明
+            <ExternalLink size={16} />
+          </button>
+          <button type="button" role="menuitem" onClick={() => { setMenuOpen(false); onOpenHelp(); }}>
+            <HelpCircle size={18} />
+            ショートカットと操作
+          </button>
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/frontend/src/components/ShortcutHelp.jsx b/frontend/src/components/ShortcutHelp.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..5ad90afbb6a74c15deb16ab7bfeb14f6bedee045
--- /dev/null
+++ b/frontend/src/components/ShortcutHelp.jsx
@@ -0,0 +1,98 @@
+/**
+ * Hキーで開くショートカット・操作ヘルプ。
+ */
+import React, { useEffect, useState } from "react";
+import { HelpCircle } from "lucide-react";
+import { isTypingTarget } from "../lib/util.js";
+
+export function useShortcutHelp() {
+  const [open, setOpen] = useState(false);
+  useEffect(() => {
+    const handleHelpShortcut = (event) => {
+      if (event.key === "Escape") {
+        setOpen(false);
+        return;
+      }
+      if (isTypingTarget(event.target) || event.key.toLowerCase() !== "h") return;
+      event.preventDefault();
+      setOpen((current) => !current);
+    };
+    window.addEventListener("keydown", handleHelpShortcut);
+    return () => window.removeEventListener("keydown", handleHelpShortcut);
+  }, []);
+  return [open, setOpen];
+}
+
+export function ShortcutHelp({ page, onClose }) {
+  const content = page === "memo" ? {
+    title: "画像メモのショートカット",
+    shortcuts: [
+      ["← / →", "前後の画像へ移動（Git差分から開いた場合）"],
+      ["T", "メモを追加"], ["L", "選択メモへラインを追加"], ["N", "付箋を追加"],
+      ["A", "ドラッグした起点から終点へ矢印を追加"], ["C", "変更雲"], ["R / 2", "矩形"],
+      ["O / 4", "楕円"], ["M", "マーカー"], ["Ctrl/Cmd+Z", "元に戻す"],
+      ["Ctrl/Cmd+Shift+Z", "やり直す"], ["Delete", "選択中の図形を削除"],
+      ["H", "このヘルプの表示／非表示"], ["Esc", "テキスト編集／ヘルプを閉じる"],
+    ],
+    settings: [
+      "画像内のメモ本文: ダブルクリックで文字編集になります。上部の本文欄はクリックで編集でき、Escまたは図形選択で編集を終了します。",
+      "図形: クリックで水色の選択枠を表示します。選択後はDelete／Backspaceで削除できます。",
+      "Git対象拡張子: git差分でテキストとして扱う形式を設定します。画像形式は常に対象です。",
+      "Obsidianフォルダー: Markdownリンクの解決元です。",
+      "レポート保存先: 出力HTMLをサーバー側で保存するフォルダーです。",
+      "表示倍率: アプリ全体のUI倍率です。画像メモの表示サイズとは別です。",
+    ],
+  } : page === "git" ? {
+    title: "git差分のショートカット",
+    shortcuts: [
+      ["← / →", "前後の変更ファイルへ移動"], ["1〜4", "表示を切替（元画像／補正B／差分／マスク）"], ["Tab", "補正Bと差分表示を切替"],
+      ["] / [", "次／前の変更箇所へ移動"], ["Esc", "変更箇所の強調を解除"], ["F / W", "全体を表示／幅に合わせる"], ["I", "右パネルの表示切替"],
+      ["Ctrl/Cmd+S", "テキストの編集を保存"], ["Ctrl/Cmd+Z", "テキストの編集を元に戻す"], ["変更行の→", "HEAD側の内容に戻す（テキスト）"], ["H", "このヘルプ"],
+    ],
+    settings: [
+      "Git対象拡張子: 一覧・HTMLレポートに含めるテキスト形式を設定します。",
+      "Obsidianフォルダー: Markdownから関連ファイルをたどる基準です。",
+      "レポート保存先: プレビュー調整後のHTML保存先です。未設定時はダウンロードします。",
+      "表示倍率: git差分画面全体を50〜200%で表示します。",
+    ],
+  } : page === "report" ? {
+    title: "HTML出力プレビューの操作",
+    shortcuts: [["H", "このヘルプ"]],
+    settings: [
+      "カード見出しをドラッグするか、↑／↓ボタンで出力順を変更します。",
+      "画像はドラッグ／2本指スワイプで移動し、ピンチで拡大・縮小します。右下ハンドルでカードをリサイズできます。",
+      "領域指定ボタンで出力範囲を選びます。未指定の場合は現在表示中の範囲を出力します。",
+      "テキスト差分の戻すボタンは作業ファイルを1行だけ変更前へ戻します。ファイルがプレビュー後に変わった場合は安全のため拒否します。",
+      "メモ編集で詳細を直した後は、「戻る」ボタンでHTML出力プレビューへ戻れます。",
+    ],
+  } : page === "api" ? {
+    title: "API説明ページのショートカット",
+    shortcuts: [["H", "このヘルプ"], ["Ctrl/Cmd+F", "ブラウザ内検索"]],
+    settings: ["このページには固有設定がありません。設定は差分画面のハンバーガーメニューから変更できます。"],
+  } : {
+    title: "ファイル差分のショートカット",
+    shortcuts: [
+      ["Ctrl/Cmd+V", "選択中の枠（A / B）へ画像を貼り付け"], ["1〜4", "表示を切替（元画像／補正B／差分／マスク）"], ["Tab", "補正Bと差分表示を切替"],
+      ["] / [", "次／前の変更箇所へ移動"], ["Esc", "変更箇所の強調を解除"], ["F / W", "全体を表示／幅に合わせる"], ["I", "右パネルの表示切替"],
+      ["Ctrl/Cmd/Alt+ホイール", "画像を拡大・縮小"], ["H", "このヘルプ"],
+    ],
+    settings: [
+      "Git対象拡張子: git差分モードで扱うテキスト形式です。",
+      "Obsidianフォルダー／レポート保存先: Markdown連携とHTML保存に使います。",
+      "表示倍率: アプリ全体のUI倍率です。画像の拡大率とは別です。",
+    ],
+  };
+  return (
+    <div className="shortcut-help-backdrop" role="presentation" onMouseDown={(event) => event.target === event.currentTarget && onClose()}>
+      <section className="shortcut-help-modal" role="dialog" aria-modal="true" aria-labelledby="shortcut-help-title">
+        <header><div><HelpCircle size={22} /><h2 id="shortcut-help-title">{content.title}</h2></div><button type="button" onClick={onClose} aria-label="閉じる">×</button></header>
+        <div className="shortcut-help-body">
+          <h3>ショートカット</h3>
+          <dl>{content.shortcuts.map(([key, label]) => <div key={key}><dt><kbd>{key}</kbd></dt><dd>{label}</dd></div>)}</dl>
+          <h3>設定と操作</h3>
+          <ul>{content.settings.map((setting) => <li key={setting}>{setting}</li>)}</ul>
+        </div>
+      </section>
+    </div>
+  );
+}
diff --git a/frontend/src/components/SourceCard.jsx b/frontend/src/components/SourceCard.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..f82ed55d14a6ecbb9ab0d58e3c4741e031b61cd6
--- /dev/null
+++ b/frontend/src/components/SourceCard.jsx
@@ -0,0 +1,94 @@
+/**
+ * ファイル差分の比較元（A: 基準 / B: 比較対象）を選ぶカード。
+ * クリックでファイル選択、ドラッグ＆ドロップ、フォーカス中の Ctrl/Cmd+V 貼り付けに対応し、
+ * 複数ページ（PDF/TIFF）はページを選べる。
+ */
+import React, { useRef, useState } from "react";
+import { FileImage, Layers, Upload } from "lucide-react";
+import { firstDroppedFile } from "../lib/files.js";
+
+export function SourceCard({ label, role, side, active, data, page, setPage, onFile, onActivate, onPasteImage }) {
+  const inputRef = useRef(null);
+  const [dragging, setDragging] = useState(false);
+  const pages = data?.metadata?.pages ?? [];
+  const selected = Boolean(data);
+
+  function handleDrop(event) {
+    event.preventDefault();
+    setDragging(false);
+    onActivate(side);
+    const file = firstDroppedFile(event.dataTransfer);
+    if (file) onFile(file);
+  }
+
+  return (
+    <div
+      className={`source-card ${selected ? "selected" : "empty"} ${active ? "active" : ""} ${dragging ? "dragging" : ""}`}
+      tabIndex={0}
+      onFocus={() => onActivate(side)}
+      onClick={() => onActivate(side)}
+      onPaste={(event) => onPasteImage(side, event)}
+      onDragEnter={(event) => {
+        event.preventDefault();
+        setDragging(true);
+        onActivate(side);
+      }}
+      onDragOver={(event) => event.preventDefault()}
+      onDragLeave={(event) => {
+        if (!event.currentTarget.contains(event.relatedTarget)) setDragging(false);
+      }}
+      onDrop={handleDrop}
+    >
+      <span className={`source-tag ${side}`}>{label}</span>
+      <div className="source-body">
+        <span className="source-role">{role}</span>
+        {selected ? (
+          <>
+            <strong className="source-name" title={data.file?.name}>{data.file?.name}</strong>
+            <span className="source-meta">
+              {data.metadata.format.toUpperCase()}
+              {data.metadata.page_count > 1 ? ` ・ ${data.metadata.page_count}ページ` : ""}
+              {data.attachment ? " ・ 貼り付け" : ""}
+            </span>
+          </>
+        ) : (
+          <span className="source-placeholder">ドロップ / クリック / Ctrl+V</span>
+        )}
+      </div>
+      {pages.length > 1 && (
+        <label className="source-page" title="比較するページ" onClick={(event) => event.stopPropagation()}>
+          <Layers size={14} />
+          <select value={page} onChange={(event) => setPage(Number(event.target.value))}>
+            {pages.map((item) => (
+              <option key={item.index} value={item.index}>
+                {item.index + 1} / {pages.length}
+              </option>
+            ))}
+          </select>
+        </label>
+      )}
+      <button
+        type="button"
+        className="btn btn-ghost source-pick"
+        onClick={(event) => {
+          event.stopPropagation();
+          inputRef.current?.click();
+        }}
+      >
+        {selected ? <FileImage size={15} /> : <Upload size={15} />}
+        {selected ? "変更" : "選択"}
+      </button>
+      <input
+        ref={inputRef}
+        type="file"
+        hidden
+        onChange={(event) => {
+          if (event.target.files?.[0]) {
+            onFile(event.target.files[0]);
+            event.target.value = "";
+          }
+        }}
+      />
+    </div>
+  );
+}
diff --git a/frontend/src/components/ViewerToolbar.jsx b/frontend/src/components/ViewerToolbar.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..f3be08983d887086ccbf50dd5b7c2c1768f50489
--- /dev/null
+++ b/frontend/src/components/ViewerToolbar.jsx
@@ -0,0 +1,70 @@
+/**
+ * 画像ビューアの上部バー（表示の切り替え・拡大縮小・メモを開く）。
+ * 表示: 元画像 / 補正B / 差分（オーバーレイ） / マスク。数字キー 1〜4 と Tab でも切り替えられる。
+ */
+import React from "react";
+import { Maximize, MoveHorizontal, PanelRight, PanelTopOpen, ZoomIn, ZoomOut } from "lucide-react";
+
+export const VIEWS = [
+  { id: "original", label: "元画像", key: "1" },
+  { id: "aligned", label: "補正B", key: "2" },
+  { id: "overlay", label: "差分", key: "3" },
+  { id: "mask", label: "マスク", key: "4" },
+];
+
+export function ViewerToolbar({ view, onViewChange, viewsEnabled, zoom, onZoom, onFitWidth, onFitAll, memoLabel, onOpenMemo, canOpenMemo, status, inspectorOpen, onToggleInspector }) {
+  return (
+    <div className="viewer-toolbar">
+      <div className="segmented" role="group" aria-label="表示の切り替え">
+        {VIEWS.map((item) => (
+          <button
+            key={item.id}
+            type="button"
+            className={view === item.id ? "active" : ""}
+            disabled={!viewsEnabled}
+            title={`${item.label}（${item.key}）`}
+            onClick={() => onViewChange(item.id)}
+          >
+            {item.label}
+          </button>
+        ))}
+      </div>
+      {status && <span className="viewer-status">{status}</span>}
+      <div className="viewer-toolbar-right">
+        <div className="zoom-group" role="group" aria-label="拡大縮小">
+          <button type="button" className="btn btn-ghost btn-icon" title="縮小" aria-label="縮小" onClick={() => onZoom(-0.1)}>
+            <ZoomOut size={16} />
+          </button>
+          <output title="Ctrl+ホイールでも拡大縮小できます">{Math.round(zoom * 100)}%</output>
+          <button type="button" className="btn btn-ghost btn-icon" title="拡大" aria-label="拡大" onClick={() => onZoom(0.1)}>
+            <ZoomIn size={16} />
+          </button>
+          <button type="button" className="btn btn-ghost btn-icon" title="幅に合わせる（W）" aria-label="幅に合わせる" onClick={onFitWidth}>
+            <MoveHorizontal size={16} />
+          </button>
+          <button type="button" className="btn btn-ghost btn-icon" title="全体を表示（F）" aria-label="全体を表示" onClick={onFitAll}>
+            <Maximize size={16} />
+          </button>
+        </div>
+        {onOpenMemo && (
+          <button type="button" className="btn" disabled={!canOpenMemo} onClick={onOpenMemo} title="別タブでメモを付ける">
+            <PanelTopOpen size={16} />
+            {memoLabel}
+          </button>
+        )}
+        {onToggleInspector && (
+          <button
+            type="button"
+            className={`btn btn-ghost btn-icon ${inspectorOpen ? "active" : ""}`}
+            title={inspectorOpen ? "右パネルを隠す（I）" : "右パネルを表示（I）"}
+            aria-label="右パネルの表示切り替え"
+            aria-pressed={inspectorOpen}
+            onClick={onToggleInspector}
+          >
+            <PanelRight size={17} />
+          </button>
+        )}
+      </div>
+    </div>
+  );
+}
diff --git a/frontend/src/git/GitSidebar.jsx b/frontend/src/git/GitSidebar.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..01c789b319cd63054a3ea1f35c5b32444f5bca20
--- /dev/null
+++ b/frontend/src/git/GitSidebar.jsx
@@ -0,0 +1,192 @@
+/**
+ * Git差分の左サイドバー。フォルダー／Markdownの指定、変更ファイルの一覧（種類・変更種別・絞り込み）、
+ * HTML出力に含めるファイルのチェック、HTMLプレビューの作成をまとめる。
+ * ファイルは ← / → キーでも順に移動できる。
+ */
+import React, { useEffect, useMemo, useRef, useState } from "react";
+import { Box, ChevronDown, Download, FileText, FolderOpen, Image, Loader2, PenTool, RefreshCw, Search } from "lucide-react";
+import { changeTypeLabel } from "./gitLabels.js";
+
+const KIND_ICONS = { image: Image, text: FileText, "3d": Box };
+
+export function GitSidebar({
+  folder,
+  folderHistory,
+  onFolderChange,
+  onLoad,
+  info,
+  files,
+  targets,
+  currentFile,
+  currentView,
+  busy,
+  onSelectTarget,
+  excludedPaths,
+  onToggleExport,
+  onIncludeAll,
+  onExcludeAll,
+  onExport,
+  exportBusy,
+}) {
+  const [historyOpen, setHistoryOpen] = useState(false);
+  const folderInputRef = useRef(null);
+
+  // 長いパスは末尾（フォルダー名・ファイル名）が見えるようにする。入力中は触らない。
+  useEffect(() => {
+    const input = folderInputRef.current;
+    if (input && document.activeElement !== input) input.scrollLeft = input.scrollWidth;
+  }, [folder, info]);
+  const [filterText, setFilterText] = useState("");
+  const query = filterText.trim().toLowerCase();
+  const visibleFiles = useMemo(
+    () => (query ? files.filter((file) => file.path.toLowerCase().includes(query)) : files),
+    [files, query],
+  );
+  const exportCount = files.filter((file) => !excludedPaths.includes(file.path)).length;
+
+  function targetIndex(file, mode) {
+    return targets.findIndex((target) => target.file.path === file.path && (!mode || target.mode === mode));
+  }
+
+  return (
+    <aside className="git-sidebar" aria-label="Gitの変更ファイル">
+      <div className="git-source">
+        <label className="field-label" htmlFor="git-folder-input">リポジトリのフォルダー / Markdown</label>
+        <div className="git-source-row">
+          <div className="git-folder-box">
+            <input
+              id="git-folder-input"
+              ref={folderInputRef}
+              className="input"
+              title={folder}
+              type="text"
+              value={folder}
+              placeholder="/path/to/repo または note.md"
+              onChange={(event) => onFolderChange(event.target.value)}
+              onKeyDown={(event) => {
+                if (event.key === "Enter") onLoad();
+              }}
+              onBlur={(event) => {
+                event.currentTarget.scrollLeft = event.currentTarget.scrollWidth;
+              }}
+            />
+            <button
+              type="button"
+              className="git-history-toggle"
+              title="最近使ったフォルダー"
+              aria-label="最近使ったフォルダー"
+              aria-expanded={historyOpen}
+              disabled={!folderHistory.length}
+              onClick={() => setHistoryOpen((open) => !open)}
+            >
+              <ChevronDown size={15} />
+            </button>
+            {historyOpen && folderHistory.length > 0 && (
+              <div className="git-history" role="listbox" aria-label="最近使ったフォルダー">
+                {folderHistory.map((item) => (
+                  <button
+                    type="button"
+                    role="option"
+                    aria-selected={item === folder}
+                    key={item}
+                    title={item}
+                    onClick={() => {
+                      onFolderChange(item);
+                      setHistoryOpen(false);
+                    }}
+                  >
+                    {item}
+                  </button>
+                ))}
+              </div>
+            )}
+          </div>
+          <button type="button" className="btn btn-primary btn-icon" title={info ? "再読み込み" : "読み込み"} aria-label="読み込み" disabled={!folder || busy} onClick={() => onLoad()}>
+            {busy ? <Loader2 className="spin" size={16} /> : info ? <RefreshCw size={16} /> : <FolderOpen size={16} />}
+          </button>
+        </div>
+        {info && (
+          <p className="git-source-meta">
+            {files.length}件の変更{info.source_markdown ? " ・ Markdownのリンク先のみ" : ""}
+          </p>
+        )}
+      </div>
+
+      {info ? (
+        <>
+          {files.length > 3 && (
+            <label className="git-filter">
+              <Search size={14} />
+              <input type="text" value={filterText} placeholder="ファイル名で絞り込み" onChange={(event) => setFilterText(event.target.value)} />
+            </label>
+          )}
+          <ul className="git-file-list">
+            {visibleFiles.map((file) => {
+              const Icon = KIND_ICONS[file.kind] ?? FileText;
+              const included = !excludedPaths.includes(file.path);
+              const isCurrent = currentFile?.path === file.path;
+              const name = file.path.split("/").pop();
+              const dir = file.path.slice(0, file.path.length - name.length);
+              const excalidrawIndex = file.kind === "text" && file.embedded_excalidraw ? targetIndex(file, "excalidraw") : -1;
+              return (
+                <li key={file.path} className={isCurrent ? "current" : ""}>
+                  <div className={`git-file ${isCurrent && currentView !== "excalidraw" ? "active" : ""}`}>
+                    <input
+                      type="checkbox"
+                      checked={included}
+                      title="HTML出力に含める"
+                      aria-label={`${file.path} をHTML出力に含める`}
+                      onChange={(event) => onToggleExport(file.path, event.target.checked)}
+                    />
+                    <button type="button" className="git-file-main" onClick={() => onSelectTarget(targetIndex(file))} title={file.path}>
+                      <Icon size={16} className={`kind-icon kind-${file.kind}`} />
+                      <span className="git-file-text">
+                        <span className="git-file-name">{name}</span>
+                        {dir && <span className="git-file-dir">{dir}</span>}
+                      </span>
+                      <span className={`badge ${file.change_type}`}>{changeTypeLabel(file.change_type)}</span>
+                    </button>
+                  </div>
+                  {excalidrawIndex >= 0 && (
+                    <button
+                      type="button"
+                      className={`git-subtarget ${isCurrent && currentView === "excalidraw" ? "active" : ""}`}
+                      onClick={() => onSelectTarget(excalidrawIndex)}
+                    >
+                      <PenTool size={14} />
+                      埋め込みExcalidraw図
+                    </button>
+                  )}
+                </li>
+              );
+            })}
+            {!visibleFiles.length && <li className="git-empty">{files.length ? "一致するファイルがありません" : "変更されたファイルはありません"}</li>}
+          </ul>
+          <div className="git-export">
+            <div className="git-export-head">
+              <span>HTML出力 <strong>{exportCount}</strong> / {files.length}</span>
+              <span className="git-export-toggles">
+                <button type="button" className="link-button" disabled={!files.length} onClick={onIncludeAll}>すべて</button>
+                <button type="button" className="link-button" disabled={!files.length} onClick={onExcludeAll}>なし</button>
+              </span>
+            </div>
+            <button type="button" className="btn btn-primary" disabled={!exportCount || busy || exportBusy} onClick={onExport}>
+              {exportBusy ? <Loader2 className="spin" size={16} /> : <Download size={16} />}
+              HTMLプレビューを作成
+            </button>
+          </div>
+        </>
+      ) : (
+        <div className="git-intro">
+          <FolderOpen size={30} strokeWidth={1.5} />
+          <p>Git管理しているフォルダー、またはObsidianのMarkdownファイルを指定すると、HEAD（最後のコミット）からの変更を一覧します。</p>
+          <ul>
+            <li>画像・図面は位置を合わせて差分を表示</li>
+            <li>テキストは左右に並べて行ごとに比較・編集</li>
+            <li>STEPファイルは3Dで比較</li>
+          </ul>
+        </div>
+      )}
+    </aside>
+  );
+}
diff --git a/frontend/src/git/TextDiffView.jsx b/frontend/src/git/TextDiffView.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..740078af7bf678809c79285bb4db8376249f96ac
--- /dev/null
+++ b/frontend/src/git/TextDiffView.jsx
@@ -0,0 +1,137 @@
+/**
+ * テキスト差分の左右表示。変更後の行はその場で編集でき、行ごとにHEAD側の内容へ戻せる。
+ * 行番号は共通行・置換行が左右同じ通し番号、追加行は「A」、削除行は「D」（Backend の text_diff.py が生成）。
+ */
+import React, { useMemo } from "react";
+import { ArrowRight, FileText, Save } from "lucide-react";
+import { normalizeLineEndings } from "../lib/util.js";
+
+export function TextDiffView({ file, item, memo, busy, previewBusy, dirty, onEditText, onSave, onRevertLine, onMemoChange }) {
+  const canRevertFile = Boolean(file.has_head && file.has_current);
+  const editableLines = useMemo(() => normalizeLineEndings(item?.text_current ?? "").split("\n"), [item?.text_current]);
+  return (
+    <section className="text-diff-section">
+      <div className="text-diff-heading">
+        <div>
+          <button
+            type="button"
+            className="btn btn-primary text-save-button"
+            disabled={!dirty || busy || previewBusy}
+            onClick={onSave}
+            title="変更後の内容を元のテキストファイルへ保存（Ctrl/Cmd+S）"
+          >
+            <Save size={15} />
+            保存
+          </button>
+          {dirty ? <span className="unsaved-badge">未保存の編集があります</span> : <span className="text-edit-hint">右側の行はその場で編集できます</span>}
+        </div>
+        <label>
+          <FileText size={15} />
+          <textarea
+            aria-label="このファイルのメモ（HTMLへ出力）"
+            title="このファイルのメモ（HTMLへ出力）"
+            value={memo}
+            placeholder="確認事項や変更理由を入力"
+            onChange={(event) => onMemoChange(event.target.value)}
+          />
+        </label>
+      </div>
+      <div className="text-diff-columns" aria-label="テキスト差分">
+        <div className="text-column-title">変更前: {file.head_path}</div>
+        <div className="text-column-title text-diff-action-title" aria-hidden="true" />
+        <div className="text-column-title">変更後: {file.path}</div>
+        {(item?.rows ?? []).map((row, index) => (
+          <React.Fragment key={`${row.old_number ?? "x"}-${row.new_number ?? "x"}-${index}`}>
+            <DiffCodeCell side="old" row={row} />
+            <DiffActionCell row={row} busy={busy || previewBusy} onRevertLine={canRevertFile ? onRevertLine : null} />
+            <DiffCodeCell
+              side="new"
+              row={row}
+              editable
+              editableText={Number.isInteger(row.new_index) ? editableLines[row.new_index] ?? row.new ?? "" : row.new ?? ""}
+              onEdit={onEditText}
+              disabled={busy}
+            />
+          </React.Fragment>
+        ))}
+        {!item && <div className="text-diff-empty">差分を読み込んでいます。</div>}
+      </div>
+    </section>
+  );
+}
+
+function DiffActionCell({ row, busy, onRevertLine }) {
+  const canRevert = Boolean(
+    onRevertLine
+      && ["replace", "insert", "delete"].includes(row.kind)
+      && Number.isInteger(row.old_index)
+      && Number.isInteger(row.new_index),
+  );
+  return (
+    <div className={`diff-action-cell ${canRevert ? "has-action" : ""}`}>
+      {canRevert && (
+        <button
+          type="button"
+          disabled={busy}
+          title="HEAD側の内容を変更後ファイルへ反映して元に戻す"
+          aria-label="HEAD側の内容を変更後ファイルへ反映して元に戻す"
+          onClick={() => onRevertLine(row)}
+        >
+          <ArrowRight size={17} />
+        </button>
+      )}
+    </div>
+  );
+}
+
+function DiffLineEditor({ number, row, value, segments, onEdit, disabled }) {
+  const segmentText = segments?.map((segment) => segment.text).join("") ?? "";
+  const showHighlight = Boolean(segments?.length && segmentText === value);
+
+  return (
+    <span className="diff-line-editor-wrap">
+      <span className="diff-line-sizer" aria-hidden="true">
+        {showHighlight ? segments.map((segment, index) => (
+          <mark key={index} className={segment.changed ? "changed" : ""}>{segment.text}</mark>
+        )) : (value || " ")}
+        {"\n"}
+      </span>
+      <textarea
+        className="diff-line-editor"
+        aria-label={`変更後 ${number ?? ""}行目`}
+        rows={1}
+        wrap="soft"
+        value={value}
+        disabled={disabled}
+        spellCheck="false"
+        onChange={(event) => onEdit(row, event.target.value)}
+      />
+    </span>
+  );
+}
+
+function DiffCodeCell({ side, row, editable = false, editableText = "", onEdit, disabled = false }) {
+  const number = side === "old" ? row.old_number : row.new_number;
+  const text = side === "old" ? row.old : row.new;
+  const segments = side === "old" ? row.old_segments : row.new_segments;
+  const className = side === "old"
+    ? row.kind === "delete" || row.kind === "replace" ? "removed" : row.kind === "insert" ? "added-gap" : ""
+    : row.kind === "insert" || row.kind === "replace" ? "added" : row.kind === "delete" ? "removed-gap" : "";
+  return (
+    <div className={`diff-code-cell ${className}`}>
+      <span className="line-number">{number ?? ""}</span>
+      <code>{editable && side === "new" && row.new !== null && Number.isInteger(row.new_index) ? (
+        <DiffLineEditor
+          number={number}
+          row={row}
+          value={editableText}
+          segments={segments}
+          onEdit={onEdit}
+          disabled={disabled}
+        />
+      ) : segments ? segments.map((segment, index) => (
+        <mark key={index} className={segment.changed ? "changed" : ""}>{segment.text}</mark>
+      )) : row.kind === "insert" || row.kind === "delete" ? <mark className="changed">{text ?? ""}</mark> : text ?? ""}</code>
+    </div>
+  );
+}
diff --git a/frontend/src/git/gitLabels.js b/frontend/src/git/gitLabels.js
new file mode 100644
index 0000000000000000000000000000000000000000..50dc623c3553971903bec732e87b64ec0f33ea99
--- /dev/null
+++ b/frontend/src/git/gitLabels.js
@@ -0,0 +1,7 @@
+/**
+ * Git変更種別の表示名。
+ */
+
+export function changeTypeLabel(type) {
+  return ({ modified: "変更", added: "追加", deleted: "削除", untracked: "未追跡", renamed: "名前変更", copied: "コピー" })[type] ?? type;
+}
diff --git a/frontend/src/git/useGitTextEditor.js b/frontend/src/git/useGitTextEditor.js
new file mode 100644
index 0000000000000000000000000000000000000000..c2eb8903cb9289cd554d2f240a62f298ab030546
--- /dev/null
+++ b/frontend/src/git/useGitTextEditor.js
@@ -0,0 +1,158 @@
+/**
+ * git差分のテキスト編集（変更後の行をその場で編集 → 差分プレビュー → 作業ファイルへ保存）。
+ * - 編集のたびに /api/git/text-diff で差分行を取り直す（古い応答は requestId で捨てる）
+ * - 元に戻す／やり直す の履歴はファイルごとに持ち、保存・ファイル切り替えで消える
+ * - 保存は /api/git/save-text。読み込み時の本文（text_saved）を base_text として送り、
+ *   外部でファイルが変わっていればサーバーが409で拒否する
+ * - テキスト表示中は Ctrl/Cmd+S で保存、Ctrl/Cmd+Z / Shift+Z で元に戻す／やり直す
+ */
+import { useEffect, useRef, useState } from "react";
+import { postJson } from "../lib/api.js";
+import { normalizeLineEndings } from "../lib/util.js";
+
+const EMPTY_HISTORY = { path: "", undo: [], redo: [] };
+
+export function useGitTextEditor({ enabled, file, info, folder, textExtensions, item, setItem, onError, onNotice }) {
+  const [busy, setBusy] = useState(false);
+  const [history, setHistory] = useState(EMPTY_HISTORY);
+  const previewRequestRef = useRef(0);
+
+  const dirty = Boolean(
+    file?.kind === "text"
+      && item
+      && normalizeLineEndings(item.text_current ?? "") !== normalizeLineEndings(item.text_saved ?? ""),
+  );
+
+  function requestBody(extra) {
+    return {
+      folder: info.folder || folder,
+      text_extensions: textExtensions,
+      path: file.path,
+      head_path: file.head_path,
+      has_head: file.has_head,
+      ...extra,
+    };
+  }
+
+  /** ファイルを読み込み直したときに履歴を消す（テキスト以外では path を空にする）。 */
+  function resetHistory(path = "") {
+    setHistory({ path, undo: [], redo: [] });
+  }
+
+  async function preview(nextText, { recordHistory = true } = {}) {
+    if (!file || file.kind !== "text" || !info || !item) return;
+    const normalizedText = normalizeLineEndings(nextText);
+    const currentText = normalizeLineEndings(item.text_current ?? "");
+    if (normalizedText === currentText) return;
+    if (recordHistory) {
+      setHistory((current) => current.path === file.path
+        ? { path: current.path, undo: [...current.undo, currentText], redo: [] }
+        : { path: file.path, undo: [currentText], redo: [] });
+    }
+    const requestId = previewRequestRef.current + 1;
+    previewRequestRef.current = requestId;
+    setItem((current) => current ? { ...current, text_current: normalizedText } : current);
+    setBusy(true);
+    onError("");
+    try {
+      const result = await postJson("/git/text-diff", requestBody({ text: normalizedText }));
+      if (requestId === previewRequestRef.current) {
+        setItem((current) => current ? { ...current, text_current: normalizedText, rows: result.rows } : current);
+      }
+    } catch (err) {
+      if (requestId === previewRequestRef.current) onError(`編集内容を反映できませんでした: ${err.message}`);
+    } finally {
+      if (requestId === previewRequestRef.current) setBusy(false);
+    }
+  }
+
+  function editLine(row, value) {
+    if (!item || !Number.isInteger(row.new_index)) return;
+    const lines = normalizeLineEndings(item.text_current ?? "").split("\n");
+    if (row.new_index < 0 || row.new_index >= lines.length) return;
+    lines[row.new_index] = value;
+    preview(lines.join("\n"));
+  }
+
+  /** 差分行をHEAD側の内容へ戻す（編集中の本文に対して行い、保存するまでファイルは変えない）。 */
+  function revertLine(row) {
+    if (!item || !file || file.kind !== "text") return;
+    const lines = normalizeLineEndings(item.text_current ?? "").split("\n");
+    const index = Number.isInteger(row.new_index) ? row.new_index : lines.length;
+    if (row.kind === "insert") {
+      if (index >= 0 && index < lines.length) lines.splice(index, 1);
+    } else if (row.kind === "delete") {
+      lines.splice(Math.max(0, Math.min(index, lines.length)), 0, String(row.old ?? ""));
+    } else if (row.kind === "replace" && index >= 0 && index < lines.length) {
+      lines[index] = String(row.old ?? "");
+    } else {
+      return;
+    }
+    preview(lines.join("\n"));
+  }
+
+  function undo() {
+    if (!file || !item || history.path !== file.path || !history.undo.length) return;
+    const currentText = normalizeLineEndings(item.text_current ?? "");
+    const previousText = history.undo[history.undo.length - 1];
+    setHistory((current) => ({
+      path: current.path,
+      undo: current.undo.slice(0, -1),
+      redo: [...current.redo, currentText],
+    }));
+    preview(previousText, { recordHistory: false });
+  }
+
+  function redo() {
+    if (!file || !item || history.path !== file.path || !history.redo.length) return;
+    const currentText = normalizeLineEndings(item.text_current ?? "");
+    const nextText = history.redo[history.redo.length - 1];
+    setHistory((current) => ({
+      path: current.path,
+      undo: [...current.undo, currentText],
+      redo: current.redo.slice(0, -1),
+    }));
+    preview(nextText, { recordHistory: false });
+  }
+
+  async function save() {
+    if (!file || file.kind !== "text" || !info || !item || !dirty || busy) return;
+    const text = normalizeLineEndings(item.text_current ?? "");
+    setBusy(true);
+    onError("");
+    try {
+      const saved = await postJson("/git/save-text", requestBody({
+        base_text: normalizeLineEndings(item.text_saved ?? ""),
+        text,
+      }));
+      const savedText = normalizeLineEndings(saved.text_current ?? text);
+      setItem((current) => current ? { ...current, text_current: savedText, text_saved: savedText, rows: saved.rows } : current);
+      resetHistory(file.path);
+      onNotice(`${file.path} を保存しました。`);
+    } catch (err) {
+      onError(`保存できませんでした: ${err.message}`);
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  useEffect(() => {
+    function handleTextEditKeys(event) {
+      if (!enabled) return;
+      const modifier = event.ctrlKey || event.metaKey;
+      if (!modifier) return;
+      if (event.key.toLowerCase() === "s") {
+        event.preventDefault();
+        save();
+      } else if (event.key.toLowerCase() === "z") {
+        event.preventDefault();
+        if (event.shiftKey) redo();
+        else undo();
+      }
+    }
+    window.addEventListener("keydown", handleTextEditKeys);
+    return () => window.removeEventListener("keydown", handleTextEditKeys);
+  }, [enabled, file, info, folder, textExtensions, item, history, dirty, busy]);
+
+  return { busy, dirty, editLine, revertLine, save, resetHistory };
+}
diff --git a/frontend/src/lib/api.js b/frontend/src/lib/api.js
new file mode 100644
index 0000000000000000000000000000000000000000..62be1a6c69e3c01bfe86ef96db6801da08d53bab
--- /dev/null
+++ b/frontend/src/lib/api.js
@@ -0,0 +1,63 @@
+/**
+ * Backend API 呼び出しの共通処理（JSONの送受信とエラー変換）。
+ */
+
+// Vite のビルド時に import.meta.env が置き換わる。Node のテストから読み込んでも落ちないよう ?. を使う。
+export const API_BASE = import.meta.env?.VITE_API_BASE ?? "/api";
+
+// items を順序を保ったまま、最大 limit 件ずつ並列に処理する。1件でも失敗したら全体を失敗として返す。
+export async function mapWithConcurrency(items, limit, worker) {
+  const results = new Array(items.length);
+  let nextIndex = 0;
+  let failure = null;
+  async function run() {
+    while (failure === null && nextIndex < items.length) {
+      const index = nextIndex++;
+      try {
+        results[index] = await worker(items[index], index);
+      } catch (err) {
+        failure = failure ?? { err };
+      }
+    }
+  }
+  await Promise.all(Array.from({ length: Math.min(limit, items.length) }, run));
+  if (failure) throw failure.err;
+  return results;
+}
+
+export async function postForm(path, form) {
+  const response = await fetch(`${API_BASE}${path}`, { method: "POST", body: form });
+  const body = await response.json().catch(() => ({}));
+  if (!response.ok) {
+    throw apiError(body.detail || `API error: ${response.status}`, response.status);
+  }
+  return body;
+}
+
+export async function postJson(path, payload) {
+  const response = await fetch(`${API_BASE}${path}`, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify(payload),
+  });
+  const body = await response.json().catch(() => ({}));
+  if (!response.ok) {
+    throw apiError(body.detail || `API error: ${response.status}`, response.status);
+  }
+  return body;
+}
+
+export async function getJson(path) {
+  const response = await fetch(`${API_BASE}${path}`);
+  const body = await response.json().catch(() => ({}));
+  if (!response.ok) {
+    throw apiError(body.detail || `API error: ${response.status}`, response.status);
+  }
+  return body;
+}
+
+function apiError(message, status) {
+  const error = new Error(message);
+  error.status = status;
+  return error;
+}
diff --git a/frontend/src/lib/files.js b/frontend/src/lib/files.js
new file mode 100644
index 0000000000000000000000000000000000000000..2a88038bdcc6af5db390d55afac315b557e04f14
--- /dev/null
+++ b/frontend/src/lib/files.js
@@ -0,0 +1,64 @@
+/**
+ * 画像データ（Base64）・クリップボード・ドロップ・ダウンロードに関する処理。
+ */
+
+// APIの画像オブジェクトごとに data URI を1回だけ作る。画像は数MBのBase64なので、描画のたびに
+// 文字列を組み立てると、Reactが毎回その巨大な文字列どうしを比較することになる。
+// 画像オブジェクトは置き換えで更新される（中身を書き換えない）ため、オブジェクト単位のキャッシュで安全。
+const dataUriCache = new WeakMap();
+
+export function toDataUri(image) {
+  let uri = dataUriCache.get(image);
+  if (uri === undefined) {
+    uri = `data:${image.mime_type};base64,${image.data}`;
+    dataUriCache.set(image, uri);
+  }
+  return uri;
+}
+
+export function loadImage(src) {
+  return new Promise((resolve, reject) => {
+    const image = new Image();
+    image.onload = () => resolve(image);
+    image.onerror = () => reject(new Error("画像を読み込めませんでした"));
+    image.src = src;
+  });
+}
+
+export function imageFileFromClipboard(clipboardData) {
+  const items = Array.from(clipboardData?.items ?? []);
+  const imageItem = items.find((item) => item.kind === "file" && item.type.startsWith("image/"));
+  const blob = imageItem?.getAsFile();
+  if (!blob) return null;
+  const extension = extensionForMime(blob.type);
+  const timestamp = new Date().toISOString().replace(/[:.]/g, "-");
+  return new File([blob], `clipboard-${timestamp}.${extension}`, { type: blob.type || "image/png" });
+}
+
+export function firstDroppedFile(dataTransfer) {
+  return Array.from(dataTransfer?.files ?? []).find((file) => file.size > 0) ?? null;
+}
+
+function extensionForMime(mimeType) {
+  if (mimeType === "image/jpeg") return "jpg";
+  if (mimeType === "image/webp") return "webp";
+  if (mimeType === "image/gif") return "gif";
+  return "png";
+}
+
+export function extensionForFilename(filename) {
+  const extension = String(filename || "").split(".").pop()?.toLowerCase();
+  return extension && extension !== filename ? extension : "png";
+}
+
+export function downloadTextFile(content, filename, mimeType) {
+  const blob = new Blob([content], { type: mimeType });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = filename;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+  window.setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
diff --git a/frontend/src/lib/location.js b/frontend/src/lib/location.js
new file mode 100644
index 0000000000000000000000000000000000000000..3692a129bfefbd12c41d3ae756ce662861e093c5
--- /dev/null
+++ b/frontend/src/lib/location.js
@@ -0,0 +1,35 @@
+/**
+ * URLパラメーター（外部アプリ・Obsidianからの起動）の解釈。
+ */
+import { extensionForFilename } from "./files.js";
+
+export function externalResultIdFromLocation() {
+  return new URLSearchParams(window.location.search).get("result_id");
+}
+
+export function markdownPathFromLocation() {
+  const params = new URLSearchParams(window.location.search);
+  return params.get("markdown_path") || params.get("markdown_file") || "";
+}
+
+export function externalFileData(side, result) {
+  const filename = side === "A" ? result.filename_a : result.filename_b;
+  const page = side === "A" ? result.page_a : result.page_b;
+  return {
+    file: { name: filename || `API File ${side}` },
+    metadata: {
+      format: extensionForFilename(filename),
+      page_count: Math.max(1, Number(page ?? 0) + 1),
+      pages: [
+        {
+          index: Number(page ?? 0),
+          width: result.width,
+          height: result.height,
+          warnings: [],
+        },
+      ],
+      warnings: [],
+    },
+    external: true,
+  };
+}
diff --git a/frontend/src/lib/memoStore.js b/frontend/src/lib/memoStore.js
new file mode 100644
index 0000000000000000000000000000000000000000..e37cef9139711e30ef8e180ec86a9644d8e91fae
--- /dev/null
+++ b/frontend/src/lib/memoStore.js
@@ -0,0 +1,137 @@
+/**
+ * 差分メモ（別タブ）の比較画像・メモ・レイアウトの保存と、メモタブの開閉。
+ * 保存先は IndexedDB を基本とし、利用できない場合のみ localStorage にフォールバックする。
+ * Git画像のメモIDはリポジトリとパスから決まる（同じファイルを開けば前回のメモを引き継ぐ）。
+ */
+
+const MEMO_DB_NAME = "visual-diff-memo";
+
+const MEMO_DB_STORE = "payloads";
+
+const MEMO_STORAGE_KEY = "visual-diff-memo-fallback";
+
+export async function storeMemoPayload(id, payload) {
+  try {
+    const db = await openMemoDb();
+    await idbRequest(db.transaction(MEMO_DB_STORE, "readwrite").objectStore(MEMO_DB_STORE).put({ id, payload, createdAt: Date.now() }));
+  } catch {
+    localStorage.setItem(`${MEMO_STORAGE_KEY}:${id}`, JSON.stringify(payload));
+  }
+}
+
+export async function readMemoPayload(id) {
+  if (!id) return null;
+  try {
+    const db = await openMemoDb();
+    const record = await idbRequest(db.transaction(MEMO_DB_STORE, "readonly").objectStore(MEMO_DB_STORE).get(id));
+    if (record?.payload) return record.payload;
+  } catch {
+    // Fall back to localStorage below.
+  }
+  try {
+    const raw = localStorage.getItem(`${MEMO_STORAGE_KEY}:${id}`);
+    return raw ? JSON.parse(raw) : null;
+  } catch {
+    return null;
+  }
+}
+
+let memoDbPromise = null;
+
+// 接続は1つを使い回す（呼び出しごとに indexedDB.open すると接続が溜まり続けるため）。
+function openMemoDb() {
+  if (!memoDbPromise) {
+    memoDbPromise = openMemoDbConnection().catch((error) => {
+      memoDbPromise = null; // 失敗した場合は次回に再試行する
+      throw error;
+    });
+  }
+  return memoDbPromise;
+}
+
+function openMemoDbConnection() {
+  return new Promise((resolve, reject) => {
+    if (!window.indexedDB) {
+      reject(new Error("IndexedDB is not available"));
+      return;
+    }
+    const request = indexedDB.open(MEMO_DB_NAME, 1);
+    request.onupgradeneeded = () => {
+      request.result.createObjectStore(MEMO_DB_STORE, { keyPath: "id" });
+    };
+    request.onsuccess = () => {
+      const db = request.result;
+      // ブラウザ側で閉じられた接続は使い回さない
+      db.onclose = () => { memoDbPromise = null; };
+      db.onversionchange = () => { db.close(); memoDbPromise = null; };
+      resolve(db);
+    };
+    request.onerror = () => reject(request.error ?? new Error("Could not open memo storage"));
+  });
+}
+
+function idbRequest(request) {
+  return new Promise((resolve, reject) => {
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error ?? new Error("Memo storage request failed"));
+  });
+}
+
+export function memoPayloadIdFromHash() {
+  const [, id] = window.location.hash.match(/^#diff-memo\/(.+)$/) ?? [];
+  return id ? decodeURIComponent(id) : null;
+}
+
+export async function openDiffMemoTab(result, left, right, onError, fixedId = null, extraPayload = {}) {
+  const id = fixedId ?? (crypto.randomUUID?.() ?? String(Date.now()));
+  const existing = fixedId ? await readMemoPayload(id) : null;
+  const payload = {
+    imageA: result.image_a,
+    imageB: result.image_b_aligned,
+    nameA: left?.file?.name,
+    nameB: right?.file?.name,
+    notes: existing?.notes ?? [],
+    stickies: existing?.stickies ?? [],
+    stageSize: existing?.stageSize ?? null,
+    memoZoom: existing?.memoZoom ?? 100,
+    memoImageScale: existing?.memoImageScale ?? 100,
+    memoGeometryVersion: existing?.memoGeometryVersion ?? null,
+    reportOptions: existing?.reportOptions ?? null,
+    ...extraPayload,
+  };
+  try {
+    await storeMemoPayload(id, payload);
+    window.open(`${window.location.origin}${window.location.pathname}${window.location.search}#diff-memo/${id}`, "_blank");
+  } catch (err) {
+    onError?.(`差分メモを開けませんでした: ${err.message}`);
+  }
+}
+
+export async function openStoredMemoTab(id) {
+  const stored = await readMemoPayload(id);
+  if (stored) await storeMemoPayload(id, { ...stored, reportPreviewReturn: true });
+  window.open(`${window.location.origin}${window.location.pathname}${window.location.search}#diff-memo/${encodeURIComponent(id)}`, "_blank");
+}
+
+export function returnToReportPreview() {
+  if (window.opener && !window.opener.closed) {
+    window.opener.focus();
+    window.close();
+    return;
+  }
+  window.location.href = `${window.location.origin}${window.location.pathname}${window.location.search}`;
+}
+
+export function gitMemoKey(repo, path) {
+  return `${repo || "repo"}::${path}`;
+}
+
+export function gitImageMemoId(repo, path) {
+  const source = gitMemoKey(repo, path);
+  let hash = 2166136261;
+  for (let index = 0; index < source.length; index += 1) {
+    hash ^= source.charCodeAt(index);
+    hash = Math.imul(hash, 16777619);
+  }
+  return `git-image-${(hash >>> 0).toString(16)}`;
+}
diff --git a/frontend/src/lib/storage.js b/frontend/src/lib/storage.js
new file mode 100644
index 0000000000000000000000000000000000000000..6af7059e65136442aa5438e59aa2487f7d4e735c
--- /dev/null
+++ b/frontend/src/lib/storage.js
@@ -0,0 +1,100 @@
+/**
+ * ブラウザに保存する設定（localStorage）の読み書き。値は読み込み時に正規化し、壊れていても既定値で動く。
+ */
+import { clamp } from "./util.js";
+
+export const DEFAULT_TEXT_EXTENSIONS = [".md", ".txt", ".csv", ".json", ".yaml", ".yml"];
+
+export const GIT_EXTENSION_STORAGE_KEY = "visual-diff-git-text-extensions";
+
+export const GIT_TEXT_MEMO_STORAGE_KEY = "visual-diff-git-text-memos";
+
+export const GIT_FOLDER_HISTORY_STORAGE_KEY = "visual-diff-git-folder-history";
+
+// v2: 以前は未保存時に50%が保存されてしまう不具合があったため、キーを変えて全員を100%へ戻す
+export const DISPLAY_SCALE_STORAGE_KEY = "visual-diff-display-scale-v2";
+
+export const MEMO_SIDEBAR_WIDTH_STORAGE_KEY = "visual-diff-memo-sidebar-width";
+
+export const MEMO_SIDEBAR_VISIBLE_STORAGE_KEY = "visual-diff-memo-sidebar-visible";
+
+export function loadTextExtensions() {
+  try {
+    return normalizeTextExtensions(JSON.parse(localStorage.getItem(GIT_EXTENSION_STORAGE_KEY) || "null") ?? DEFAULT_TEXT_EXTENSIONS);
+  } catch {
+    return [...DEFAULT_TEXT_EXTENSIONS];
+  }
+}
+
+export function normalizeTextExtensions(value) {
+  const items = Array.isArray(value) ? value : String(value || "").split(/[,\s]+/);
+  return [...new Set(items.map((item) => String(item).trim().toLowerCase()).filter(Boolean).map((item) => item.startsWith(".") ? item : `.${item}`)
+    .filter((item) => /^\.[a-z0-9][a-z0-9._+-]{0,15}$/.test(item)))].slice(0, 50);
+}
+
+export function loadGitTextMemos() {
+  try {
+    const value = JSON.parse(localStorage.getItem(GIT_TEXT_MEMO_STORAGE_KEY) || "{}");
+    return value && typeof value === "object" && !Array.isArray(value) ? value : {};
+  } catch {
+    return {};
+  }
+}
+
+// 未保存のキーは null。Number(null) は 0 になり最小値へ丸められてしまうため、数値として読めない値は既定値にする。
+function readStoredNumber(key) {
+  const raw = localStorage.getItem(key);
+  if (raw === null || raw.trim() === "") return null;
+  const value = Number(raw);
+  return Number.isFinite(value) ? value : null;
+}
+
+export function loadDisplayScale() {
+  try {
+    const value = readStoredNumber(DISPLAY_SCALE_STORAGE_KEY);
+    return value === null ? 1 : Math.min(2, Math.max(0.5, value));
+  } catch {
+    return 1;
+  }
+}
+
+export function loadMemoSidebarWidth() {
+  try {
+    const value = readStoredNumber(MEMO_SIDEBAR_WIDTH_STORAGE_KEY);
+    return value === null ? 230 : clamp(Math.round(value), 160, 420);
+  } catch {
+    return 230;
+  }
+}
+
+export function loadMemoSidebarVisible() {
+  try {
+    const value = localStorage.getItem(MEMO_SIDEBAR_VISIBLE_STORAGE_KEY);
+    return value === null ? true : value !== "false";
+  } catch {
+    return true;
+  }
+}
+
+export function loadGitFolderHistory() {
+  try {
+    const value = JSON.parse(localStorage.getItem(GIT_FOLDER_HISTORY_STORAGE_KEY) || "[]");
+    if (!Array.isArray(value)) return [];
+    return [...new Set(value.map((item) => String(item).trim()).filter(Boolean))].slice(0, 12);
+  } catch {
+    return [];
+  }
+}
+
+export function loadLastGitFolder() {
+  return loadGitFolderHistory()[0] ?? "";
+}
+
+export function persistLocalStorage(key, value) {
+  try {
+    localStorage.setItem(key, JSON.stringify(value));
+    return true;
+  } catch {
+    return false;
+  }
+}
diff --git a/frontend/src/lib/util.js b/frontend/src/lib/util.js
new file mode 100644
index 0000000000000000000000000000000000000000..d1fa1726a3fa6021dd1c699caa256ef2c2ba13c2
--- /dev/null
+++ b/frontend/src/lib/util.js
@@ -0,0 +1,19 @@
+/**
+ * 画面に依存しない小さな共通関数。
+ */
+
+export function clamp(value, min, max) {
+  return Math.min(max, Math.max(min, value));
+}
+
+export function isTypingTarget(target) {
+  return ["INPUT", "TEXTAREA", "SELECT"].includes(target?.tagName) || target?.isContentEditable;
+}
+
+export function normalizeLineEndings(value) {
+  return String(value ?? "").replace(/\r\n/g, "\n").replace(/\r/g, "\n");
+}
+
+export function escapeHtml(value) {
+  return String(value ?? "").replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char]);
+}
