+}
+
+.region-box.selected {
+  box-shadow: 0 0 0 3px rgba(60, 207, 142, 0.35);
+}
+
+/* 変更箇所の一覧から選んだ箇所の強調枠 */
+.focus-box {
+  position: absolute;
+  margin: -6px;
+  padding: 6px;
+  box-sizing: content-box;
+  border: 2px solid var(--accent);
+  border-radius: 6px;
+  box-shadow: 0 0 0 9999px rgba(8, 10, 15, 0.35), 0 0 0 4px rgba(91, 140, 255, 0.35);
+  pointer-events: none;
+  animation: focus-pulse 1.2s ease-out 1;
+}
+
+@keyframes focus-pulse {
+  from { box-shadow: 0 0 0 9999px rgba(8, 10, 15, 0.35), 0 0 0 16px rgba(91, 140, 255, 0.45); }
+  to { box-shadow: 0 0 0 9999px rgba(8, 10, 15, 0.35), 0 0 0 4px rgba(91, 140, 255, 0.35); }
+}
+
+.empty-state {
+  flex: 1;
+  height: 100%;
