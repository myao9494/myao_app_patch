+  background: var(--added);
+}
+
+.canvas {
+  flex: 1;
+  min-height: 0;
+  display: flex; /* 画像がペインより小さいとき、auto マージンで上下左右の中央に置く（拡大時は通常どおりスクロール） */
+  overflow: auto;
+  overscroll-behavior: none;
+  cursor: grab;
+  background-color: #0f1117;
+  background-image:
+    linear-gradient(45deg, #151821 25%, transparent 25%),
+    linear-gradient(-45deg, #151821 25%, transparent 25%),
+    linear-gradient(45deg, transparent 75%, #151821 75%),
+    linear-gradient(-45deg, transparent 75%, #151821 75%);
+  background-size: 20px 20px;
+  background-position: 0 0, 0 10px, 10px -10px, -10px 0;
+}
+
+.canvas.panning {
+  cursor: grabbing;
+  user-select: none;
+}
+
+.canvas img {
+  display: block;
+  width: 100%;
+  max-width: none;
+  transform-origin: top left;
+}
+
+.image-stage {
+  position: relative;
+  flex: none;
+  min-width: 160px;
+  margin: auto;
+}
+
+.region-layer {
+  position: absolute;
   inset: 0;
-  z-index: 50;
-  padding: 24px;
