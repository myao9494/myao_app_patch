+"""APIエンドポイント（機能ごとの APIRouter）。"""
diff --git a/backend/app/routes/git.py b/backend/app/routes/git.py
new file mode 100644
index 0000000000000000000000000000000000000000..7077d15383adf1b1942fd45ead64261cad64e285
--- /dev/null
+++ b/backend/app/routes/git.py
@@ -0,0 +1,347 @@
+"""
+Git差分API（HEAD と作業ツリーの比較、テキストの編集・保存・1行復元）。
+POST /api/git/images, /api/git/files, /api/git/markdown（GETも可）, /api/git/item,
+/api/git/text-diff, /api/git/save-text, /api/git/revert-line, /api/git/diff
+"""
+
+from __future__ import annotations
+
+import json
+from urllib.parse import quote
+
+from fastapi import APIRouter, HTTPException, Request
+from fastapi.responses import JSONResponse
+
+from ..diff_pipeline import build_diff_response, git_preview_payload
+from ..file_utils import encode_like_original, read_file_limited, write_bytes_atomically
+from ..git_repo import (
+    changed_files,
+    changed_image_files,
+    git_file_kind,
+    git_repo_root,
+    git_show,
+    payload_folder,
+    payload_git_scope,
+    safe_git_path,
+    text_extensions_from_payload,
+)
+from ..image_io import MAX_UPLOAD_BYTES, extract_excalidraw_json
+from ..markdown_links import related_paths_for_markdown
+from ..models import DiffResponse
+from ..text_diff import (
+    EXCALIDRAW_PLUGIN_MARKER_RE,
+    MAX_TEXT_BYTES,
+    build_markdown_text_diff_rows,
+    decode_git_text,
+)
+
+router = APIRouter()
+
+
+@router.post("/api/git/images")
+def git_images(payload: dict) -> JSONResponse:
+    folder, source_markdown = payload_git_scope(payload)
+    repo = git_repo_root(folder)
+    if source_markdown:
+        related_paths = related_paths_for_markdown(repo, source_markdown)
+        files = changed_image_files(repo, repo, specific_paths=related_paths)
+    else:
+        files = changed_image_files(repo, folder)
+    return JSONResponse(
+        {
+            "folder": str(folder),
+            "repo_root": str(repo),
+            "source_markdown": source_markdown,
+            "files": files,
+        }
+    )
+
+
+@router.post("/api/git/files")
+def git_files(payload: dict) -> JSONResponse:
+    folder, source_markdown = payload_git_scope(payload)
+    repo = git_repo_root(folder)
+    text_extensions = text_extensions_from_payload(payload)
+    if source_markdown:
+        related_paths = related_paths_for_markdown(repo, source_markdown)
+        files = changed_files(repo, repo, text_extensions, specific_paths=related_paths)
+    else:
+        files = changed_files(repo, folder, text_extensions)
+    return JSONResponse(
+        {
+            "folder": str(folder),
+            "repo_root": str(repo),
+            "text_extensions": sorted(text_extensions),
+            "source_markdown": source_markdown,
+            "files": files,
+        }
+    )
+
+
+@router.post("/api/git/markdown")
+def git_markdown_diff(payload: dict, request: Request) -> JSONResponse:
+    """Create a deep link for an Obsidian Markdown-rooted Git diff.
+
+    Obsidian integrations can call this endpoint with the active note path,
+    then open ``diff_url``. The web UI consumes the same path and loads the
+    Markdown diff plus all changed files reachable from its links.
+    """
+    raw_markdown = str(
+        payload.get("markdown_path")
+        or payload.get("markdown_file")
+        or payload.get("path")
+        or payload.get("folder")
+        or ""
+    ).strip()
+    if not raw_markdown:
+        raise HTTPException(status_code=422, detail="markdown_path is required")
+    folder, source_markdown = payload_git_scope({"folder": raw_markdown})
+    if not source_markdown:
+        raise HTTPException(status_code=422, detail="markdown_path must point to a Markdown file")
+    repo = git_repo_root(folder)
+    text_extensions = text_extensions_from_payload(payload)
+    related_paths = related_paths_for_markdown(repo, source_markdown)
+    files = changed_files(repo, repo, text_extensions, specific_paths=related_paths)
+    return JSONResponse(
+        {
+            "folder": str(folder),
+            "repo_root": str(repo),
+            "source_markdown": source_markdown,
+            "text_extensions": sorted(text_extensions),
+            "files": files,
+            "diff_url": f"{str(request.base_url).rstrip('/')}/?markdown_path={quote(source_markdown, safe='')}",
+        }
+    )
+
+
+@router.get("/api/git/markdown")
+def get_git_markdown_diff(request: Request, path: str | None = None, markdown_path: str | None = None) -> JSONResponse:
+    """GET convenience form for integrations that only have a note path."""
+    return git_markdown_diff({"markdown_path": markdown_path or path or ""}, request)
+
+
+@router.post("/api/git/item")
+def git_item(payload: dict) -> JSONResponse:
+    folder = payload_folder(payload)
+    repo = git_repo_root(folder)
+    path = str(payload.get("path") or "")
+    if not path:
+        raise HTTPException(status_code=422, detail="path is required")
+    rel_path = safe_git_path(repo, path, restrict_to_images=False)
+    head_path = str(payload.get("head_path") or path)
+    head_rel_path = safe_git_path(repo, head_path, restrict_to_images=False)
+    text_extensions = text_extensions_from_payload(payload)
+    kind = git_file_kind(rel_path, text_extensions)
+    if kind is None:
+        raise HTTPException(status_code=422, detail="path extension is not enabled")
+
+    has_head = bool(payload.get("has_head", True))
+    has_current = bool(payload.get("has_current", True))
+    max_bytes = MAX_UPLOAD_BYTES if kind in ("image", "3d") else MAX_TEXT_BYTES
+    previous = git_show(repo, head_rel_path, max_bytes=max_bytes) if has_head else None
+    current_path = repo / rel_path
+    current = None
+    if has_current:
+        if not current_path.exists() or not current_path.is_file():
+            raise HTTPException(status_code=404, detail=f"Current file not found: {rel_path}")
+        current = read_file_limited(current_path, max_bytes, rel_path)
+
+    response: dict = {"path": rel_path, "head_path": head_rel_path, "kind": kind}
+    if kind == "image":
+        response["image_head"] = git_preview_payload(head_rel_path, previous) if previous is not None else None
+        response["image_current"] = git_preview_payload(rel_path, current) if current is not None else None
+    elif kind == "3d":
+        response["step_available"] = True
+        response["has_head"] = has_head and previous is not None
+        response["has_current"] = has_current and current is not None
+    else:
+        old_text, old_encoding = decode_git_text(previous) if previous is not None else ("", None)
+        new_text, new_encoding = decode_git_text(current) if current is not None else ("", None)
+        response.update({"encoding_head": old_encoding, "encoding_current": new_encoding, "rows": build_markdown_text_diff_rows(old_text, new_text)})
+        if payload.get("include_text", True):
+            response.update({"text_head": old_text, "text_current": new_text})
+    return JSONResponse(response)
+
+
+@router.post("/api/git/text-diff")
+def git_text_diff(payload: dict) -> JSONResponse:
+    """Build a preview diff for an edited working-tree text value."""
+    folder = payload_folder(payload)
+    repo = git_repo_root(folder)
+    rel_path = safe_git_path(repo, str(payload.get("path") or ""), restrict_to_images=False)
+    head_rel_path = safe_git_path(repo, str(payload.get("head_path") or rel_path), restrict_to_images=False)
+    text_extensions = text_extensions_from_payload(payload)
+    if git_file_kind(rel_path, text_extensions) != "text":
+        raise HTTPException(status_code=422, detail="Only enabled text files can be previewed")
+    has_head = bool(payload.get("has_head", True))
+    previous = git_show(repo, head_rel_path, max_bytes=MAX_TEXT_BYTES) if has_head else None
+    old_text, _ = decode_git_text(previous) if previous is not None else ("", "utf-8")
+    new_text = str(payload.get("text") or "")
+    return JSONResponse({"path": rel_path, "rows": build_markdown_text_diff_rows(old_text, new_text), "text_current": new_text})
+
+
+@router.post("/api/git/save-text")
+def save_git_text(payload: dict) -> JSONResponse:
+    """Save an edited text draft back to the working-tree file."""
+    folder = payload_folder(payload)
+    repo = git_repo_root(folder)
+    rel_path = safe_git_path(repo, str(payload.get("path") or ""), restrict_to_images=False)
+    head_rel_path = safe_git_path(repo, str(payload.get("head_path") or rel_path), restrict_to_images=False)
+    text_extensions = text_extensions_from_payload(payload)
+    if git_file_kind(rel_path, text_extensions) != "text":
+        raise HTTPException(status_code=422, detail="Only enabled text files can be saved")
+    current_path = repo / rel_path
+    if not current_path.is_file():
+        raise HTTPException(status_code=404, detail=f"Current file not found: {rel_path}")
+
+    current_bytes = read_file_limited(current_path, MAX_TEXT_BYTES, rel_path)
+    current_text, current_encoding = decode_git_text(current_bytes)
+    normalized_current_text = current_text.replace("\r\n", "\n").replace("\r", "\n")
+    base_text = payload.get("base_text")
+    if isinstance(base_text, str) and normalized_current_text != base_text:
+        raise HTTPException(status_code=409, detail="The file changed outside this editor. Reload the preview before saving")
+    edited_text = str(payload.get("text") or "")
+    newline = "\r\n" if b"\r\n" in current_bytes else "\n"
+    normalized_text = edited_text.replace("\r\n", "\n").replace("\r", "\n")
+    serialized_text = normalized_text.replace("\n", newline)
+    saved_bytes = encode_like_original(serialized_text, current_encoding, "Edited text")
+    write_bytes_atomically(current_path, saved_bytes, "Could not save the working-tree file")
+
+    old_bytes = git_show(repo, head_rel_path, max_bytes=MAX_TEXT_BYTES) if bool(payload.get("has_head", True)) else None
+    old_text, _ = decode_git_text(old_bytes) if old_bytes is not None else ("", "utf-8")
+    return JSONResponse(
+        {
+            "path": rel_path,
+            "text_current": normalized_text,
+            "rows": build_markdown_text_diff_rows(old_text, normalized_text),
+            "encoding_current": current_encoding,
+        }
+    )
+
+
+@router.post("/api/git/revert-line")
+def git_revert_line(payload: dict) -> JSONResponse:
+    """Restore one displayed working-tree diff row to its HEAD value."""
+    folder = payload_folder(payload)
+    repo = git_repo_root(folder)
+    rel_path = safe_git_path(repo, str(payload.get("path") or ""), restrict_to_images=False)
+    head_rel_path = safe_git_path(repo, str(payload.get("head_path") or rel_path), restrict_to_images=False)
+    text_extensions = text_extensions_from_payload(payload)
+    if git_file_kind(rel_path, text_extensions) != "text":
+        raise HTTPException(status_code=422, detail="Only enabled text files can be restored by line")
+    current_path = repo / rel_path
+    if not current_path.is_file():
+        raise HTTPException(status_code=404, detail=f"Current file not found: {rel_path}")
+
+    old_text, _ = decode_git_text(git_show(repo, head_rel_path, max_bytes=MAX_TEXT_BYTES))
+    current_bytes = read_file_limited(current_path, MAX_TEXT_BYTES, rel_path)
+    new_text, current_encoding = decode_git_text(current_bytes)
+    requested = payload.get("row")
+    if not isinstance(requested, dict) or requested.get("kind") not in {"replace", "insert", "delete"}:
+        raise HTTPException(status_code=422, detail="A changed diff row is required")
+    requested_old_index = requested.get("old_index")
+    requested_new_index = requested.get("new_index")
+    if (
+        not isinstance(requested_old_index, int)
+        or isinstance(requested_old_index, bool)
+        or not isinstance(requested_new_index, int)
+        or isinstance(requested_new_index, bool)
+    ):
+        raise HTTPException(status_code=422, detail="Diff row indexes are required")
+
+    candidates = [
+        row for row in build_markdown_text_diff_rows(old_text, new_text)
+        if row.get("kind") == requested.get("kind")
+        and row.get("old") == requested.get("old")
+        and row.get("new") == requested.get("new")
+        and row.get("old_index") == requested_old_index
+        and row.get("new_index") == requested_new_index
+    ]
+    if not candidates:
+        raise HTTPException(status_code=409, detail="The file changed after the preview. Reload the preview and try again")
+    row = candidates[0]
+    lines = new_text.splitlines()
+    index = int(row["new_index"])
+    if row["kind"] == "insert":
+        if index >= len(lines):
+            raise HTTPException(status_code=409, detail="The target line no longer exists")
+        lines.pop(index)
+    elif row["kind"] == "delete":
+        lines.insert(min(index, len(lines)), str(row.get("old") or ""))
+    else:
+        if index >= len(lines):
+            raise HTTPException(status_code=409, detail="The target line no longer exists")
+        lines[index] = str(row.get("old") or "")
+
+    newline = "\r\n" if b"\r\n" in current_bytes else "\n"
+    restored_text = newline.join(lines)
+    if new_text.endswith(("\n", "\r")):
+        restored_text += newline
+    restored_bytes = encode_like_original(restored_text, current_encoding, "Restored text")
+    write_bytes_atomically(current_path, restored_bytes, "Could not update the working-tree file")
+    # text_current は改行をLFに正規化した復元後の全文。編集中でなければUIの本文もこれで更新できる。
+    return JSONResponse(
+        {
+            "path": rel_path,
+            "rows": build_markdown_text_diff_rows(old_text, restored_text),
+            "text_current": restored_text.replace("\r\n", "\n").replace("\r", "\n"),
+        }
+    )
+
+
+@router.post("/api/git/diff", response_model=DiffResponse)
+def git_diff(payload: dict) -> DiffResponse:
+    folder = payload_folder(payload)
+    repo = git_repo_root(folder)
+    path = str(payload.get("path") or "")
+    if not path:
+        raise HTTPException(status_code=422, detail="path is required")
+    subresource = str(payload.get("subresource") or "").strip().lower()
+    if subresource == "excalidraw":
+        rel_path = safe_git_path(repo, path, restrict_to_images=False)
+        if not rel_path.lower().endswith(".md"):
+            raise HTTPException(status_code=422, detail="Excalidraw subresource requires a Markdown file")
+        current_path = repo / rel_path
+        if not current_path.exists() or not current_path.is_file():
+            raise HTTPException(status_code=404, detail=f"Current file not found: {rel_path}")
+        head_path = str(payload.get("head_path") or path)
+        head_rel_path = safe_git_path(repo, head_path, restrict_to_images=False)
+        previous = git_show(repo, head_rel_path, max_bytes=MAX_TEXT_BYTES)
+        current = read_file_limited(current_path, MAX_TEXT_BYTES, rel_path)
+        return build_diff_response(
+            filename_a=f"HEAD:{head_rel_path}.excalidraw",
+            content_a=_embedded_excalidraw_json_bytes(previous),
+            filename_b=f"{rel_path}.excalidraw",
+            content_b=_embedded_excalidraw_json_bytes(current),
+            category=str(payload.get("category") or "図面"),
+            diff_threshold=float(payload.get("diff_threshold") or 0.1),
+        )
+
+    rel_path = safe_git_path(repo, path)
+    head_path = str(payload.get("head_path") or path)
+    head_rel_path = safe_git_path(repo, head_path)
+    current_path = repo / rel_path
+    if not current_path.exists() or not current_path.is_file():
+        raise HTTPException(status_code=404, detail=f"Current file not found: {rel_path}")
+    previous = git_show(repo, head_rel_path, max_bytes=MAX_UPLOAD_BYTES)
+    current = read_file_limited(current_path, MAX_UPLOAD_BYTES, rel_path)
+    return build_diff_response(
+        filename_a=f"HEAD:{head_rel_path}",
+        content_a=previous,
+        filename_b=rel_path,
+        content_b=current,
+        category=str(payload.get("category") or "汎用"),
+        diff_threshold=float(payload.get("diff_threshold") or 0.1),
+    )
+
+
+def _embedded_excalidraw_json_bytes(content: bytes) -> bytes:
+    """Extract a note's drawing as standalone JSON for the normal image pipeline."""
+    text = content.decode("utf-8", errors="ignore")
+    if not EXCALIDRAW_PLUGIN_MARKER_RE.search(text):
+        return b'{"type":"excalidraw","elements":[],"appState":{}}'
+    try:
+        payload = extract_excalidraw_json(content)
+    except Exception as exc:
+        raise HTTPException(status_code=422, detail=f"Could not find Excalidraw JSON in Markdown: {exc}") from exc
+    return json.dumps(payload, ensure_ascii=False).encode("utf-8")
diff --git a/backend/app/routes/images.py b/backend/app/routes/images.py
new file mode 100644
index 0000000000000000000000000000000000000000..9b05f0595f766c2b8b39cd49e47def9a67d71175
--- /dev/null
+++ b/backend/app/routes/images.py
@@ -0,0 +1,166 @@
+"""
+ファイル差分（アップロード画像の比較）API。
+POST /api/attachments, /api/analyze, /api/convert, /api/diff, /api/rediff, GET /api/diff/{result_id}
+"""
+
+from __future__ import annotations
+
+import concurrent.futures
+
+from fastapi import (
+    APIRouter,
+    BackgroundTasks,
+    File,
+    Form,
+    HTTPException,
+    Request,
+    UploadFile,
+)
+from fastapi.responses import JSONResponse
+
+from ..attachments import RETENTION_DAYS, cleanup_expired_attachments, save_attachment
+from ..diff_pipeline import (
+    analyze_or_400,
+    build_cached_diff_response,
+    build_diff_response,
+    convert_page_or_400,
+    decode_rediff_images,
+    encode_pngs_parallel,
+    page_warnings,
+    parse_anchor_region,
+    read_upload_or_413,
+    schedule_open_result,
+)
+from ..diffing import build_visual_diff
+from ..image_io import encode_png, pil_to_cv
+from ..models import (
+    AnalyzeResponse,
+    DiffResponse,
+    ImagePayload,
+    PageInfo,
+    RediffRequest,
+    RediffResponse,
+)
+from ..regions import suggest_anchor_regions
+from ..result_cache import get_diff_images, store_diff_images
+
+router = APIRouter()
+
+
+@router.post("/api/attachments")
+def upload_attachment(file: UploadFile = File(...)) -> JSONResponse:
+    content = read_upload_or_413(file)
+    if not content:
+        raise HTTPException(status_code=400, detail="Attachment is empty")
+    deleted_expired = cleanup_expired_attachments()
+    path = save_attachment(file.filename or "clipboard.png", content)
+    return JSONResponse(
+        {
+            "filename": file.filename or "clipboard.png",
+            "stored_as": path.name,
+            "size": len(content),
+            "retention_days": RETENTION_DAYS,
+            "deleted_expired": deleted_expired,
+        }
+    )
+
+
+@router.post("/api/analyze", response_model=AnalyzeResponse)
+def analyze(file: UploadFile = File(...)) -> AnalyzeResponse:
+    content = read_upload_or_413(file)
+    fmt, pages = analyze_or_400(file.filename or "upload", content)
+    warnings = page_warnings(pages)
+    return AnalyzeResponse(
+        filename=file.filename or "upload",
+        format=fmt,
+        page_count=len(pages),
+        pages=[PageInfo(index=page.index, width=page.width, height=page.height, warnings=list(page.warnings)) for page in pages],
+        warnings=warnings,
+    )
+
+
+@router.post("/api/convert")
+def convert(file: UploadFile = File(...), page: int = Form(0)) -> JSONResponse:
+    content = read_upload_or_413(file)
+    fmt, selected = convert_page_or_400(file.filename or "upload", content, page)
+    # プレビューPNGのエンコードと基準領域候補の抽出は独立しているので並列に行う（どちらもGILを解放する）
+    with concurrent.futures.ThreadPoolExecutor(max_workers=2) as executor:
+        encoded = executor.submit(encode_png, selected.image)
+        regions = executor.submit(lambda: suggest_anchor_regions(pil_to_cv(selected.image)))
+        image_data, region_list = encoded.result(), regions.result()
+    return JSONResponse(
+        {
+            "filename": file.filename,
+            "format": fmt,
+            "page": selected.index,
+            "width": selected.image.width,
+            "height": selected.image.height,
+            "image": {"mime_type": "image/png", "data": image_data},
+            "regions": region_list,
+            "warnings": list(selected.warnings),
+        }
+    )
+
+
+@router.post("/api/diff", response_model=DiffResponse)
+def diff(
+    background_tasks: BackgroundTasks,
+    request: Request,
+    file_a: UploadFile = File(...),
+    file_b: UploadFile = File(...),
+    page_a: int = Form(0),
+    page_b: int = Form(0),
+    category: str = Form("汎用"),
+    diff_threshold: float = Form(0.1),
+    anchor_region: str | None = Form(None),
+) -> DiffResponse:
+    response = build_diff_response(
+        filename_a=file_a.filename or "a",
+        content_a=read_upload_or_413(file_a),
+        filename_b=file_b.filename or "b",
+        content_b=read_upload_or_413(file_b),
+        category=category,
+        diff_threshold=diff_threshold,
+        page_a=page_a,
+        page_b=page_b,
+        anchor_region=parse_anchor_region(anchor_region),
+    )
+    schedule_open_result(background_tasks, request, response.result_id)
+    return response
+
+
+@router.post("/api/rediff", response_model=RediffResponse)
+def rediff(payload: RediffRequest) -> RediffResponse:
+    result_id = payload.result_id
+    if payload.result_id:
+        cached = get_diff_images(payload.result_id)
+        if cached:
+            image_a = cached.image_a
+            image_b_aligned = cached.image_b_aligned
+        elif payload.image_a is None or payload.image_b_aligned is None:
+            raise HTTPException(status_code=404, detail="Diff result cache expired")
+        else:
+            image_a, image_b_aligned = decode_rediff_images(payload)
+            result_id = store_diff_images(image_a, image_b_aligned)
+    else:
+        image_a, image_b_aligned = decode_rediff_images(payload)
+        result_id = store_diff_images(image_a, image_b_aligned)
+    diff_result = build_visual_diff(image_a, image_b_aligned, threshold=payload.diff_threshold)
+    encoded_overlay, encoded_mask = encode_pngs_parallel(diff_result["overlay"], diff_result["mask"])
+    return RediffResponse(
+        result_id=result_id,
+        overlay=ImagePayload(data=encoded_overlay),
+        mask=ImagePayload(data=encoded_mask),
+        diff_rects=diff_result["rects"],
+        diff_pixels=diff_result["diff_pixels"],
+        diff_ratio=diff_result["diff_ratio"],
+        diff_threshold=diff_result["threshold"],
+    )
+
+
+@router.get("/api/diff/{result_id}", response_model=DiffResponse)
+def get_diff_result(result_id: str, diff_threshold: float = 0.1) -> DiffResponse:
+    cached = get_diff_images(result_id)
+    if not cached:
+        raise HTTPException(status_code=404, detail="Diff result cache expired")
+    return build_cached_diff_response(result_id, cached, diff_threshold)
diff --git a/backend/app/routes/settings.py b/backend/app/routes/settings.py
new file mode 100644
index 0000000000000000000000000000000000000000..4b4450c65cddc228bda4ec950ddd7c8bd5935036
--- /dev/null
+++ b/backend/app/routes/settings.py
@@ -0,0 +1,79 @@
+"""
+サーバー設定とレポート保存API。
+GET/PUT /api/settings/obsidian, POST /api/reports/save
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from fastapi import APIRouter, HTTPException
+from fastapi.responses import JSONResponse
+
+from ..file_utils import write_bytes_atomically
+from ..settings_store import (
+    load_server_settings,
+    save_server_settings,
+    validated_directory_setting,
+)
+
+router = APIRouter()
+
+
+MAX_REPORT_BYTES = 50 * 1024 * 1024
+
+
+@router.get("/api/settings/obsidian")
+def get_obsidian_settings() -> JSONResponse:
+    settings = load_server_settings()
+    return JSONResponse(
+        {
+            "obsidian_folder": settings.get("obsidian_folder", ""),
+            "obsidian_report_folder": settings.get("obsidian_report_folder", ""),
+        }
+    )
+
+
+@router.put("/api/settings/obsidian")
+def update_obsidian_settings(payload: dict) -> JSONResponse:
+    settings = load_server_settings()
+    raw_folder = (
+        validated_directory_setting(payload.get("obsidian_folder"), "Obsidianフォルダー")
+        if "obsidian_folder" in payload
+        else str(settings.get("obsidian_folder") or "")
+    )
+    raw_report_folder = (
+        validated_directory_setting(payload.get("obsidian_report_folder"), "Obsidianレポート保存先")
+        if "obsidian_report_folder" in payload
+        else str(settings.get("obsidian_report_folder") or "")
+    )
+    settings["obsidian_folder"] = raw_folder
+    settings["obsidian_report_folder"] = raw_report_folder
+    save_server_settings(settings)
+    return JSONResponse({"obsidian_folder": raw_folder, "obsidian_report_folder": raw_report_folder})
+
+
+@router.post("/api/reports/save")
+def save_report(payload: dict) -> JSONResponse:
+    html = str(payload.get("html") or "")
+    if not html:
+        raise HTTPException(status_code=422, detail="html is required")
+    if len(html.encode("utf-8")) > MAX_REPORT_BYTES:
+        raise HTTPException(status_code=413, detail="HTML report is too large")
+
+    settings = load_server_settings()
+    # The destination is an administrator/user configured server setting. Do not
+    # accept a per-request override, otherwise any page able to call the local API
+    # could write a report into an arbitrary existing directory.
+    raw_folder = str(settings.get("obsidian_report_folder") or "").strip()
+    if not raw_folder:
+        raise HTTPException(status_code=422, detail="Obsidianレポート保存先が未設定です")
+    folder = validated_directory_setting(raw_folder, "Obsidianレポート保存先", required=True)
+    filename = Path(str(payload.get("filename") or "差分レポート.html")).name.strip()
+    if not filename:
+        filename = "差分レポート.html"
+    if not filename.lower().endswith(".html"):
+        filename = f"{filename}.html"
+    destination = Path(folder) / filename
+    write_bytes_atomically(destination, html.encode("utf-8"), "HTMLレポートを保存できませんでした")
+    return JSONResponse({"filename": filename, "path": str(destination), "size": len(html.encode("utf-8"))})
diff --git a/backend/app/routes/three_d.py b/backend/app/routes/three_d.py
new file mode 100644
index 0000000000000000000000000000000000000000..cfe7f12b375ae3c3feda519e4aadd19636aacad7
--- /dev/null
+++ b/backend/app/routes/three_d.py
@@ -0,0 +1,208 @@
+"""
+3D CAD差分（STEP比較）API。重い処理は MeshDiffJobManager が子プロセスで実行する。
+GET /api/3d/status, /api/3d/samples, POST /api/3d/samples/load, POST /api/3d/jobs,
+GET /api/3d/jobs/{job_id}, GET /api/3d/jobs/{job_id}/mesh/{side}, DELETE /api/3d/jobs/{job_id},
+POST /api/git/3d/jobs（HEAD と作業ツリーのSTEPを比較。片側だけなら単体プレビュー）
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from fastapi import APIRouter, File, Form, HTTPException, UploadFile
+from fastapi.responses import JSONResponse, Response
+
+from ..diff_pipeline import read_upload_or_413
+from ..file_utils import read_file_limited
+from ..git_repo import (
+    git_repo_root,
+    git_show,
+    is_git_3d_path,
+    payload_folder,
+    safe_git_path,
+)
+from ..image_io import MAX_UPLOAD_BYTES
+from ..mesh_jobs import (
+    ALIGN_MODES,
+    QUALITY_MODES,
+    MeshDiffJobManager,
+    check_3d_availability,
+)
+
+router = APIRouter()
+
+
+mesh_job_manager = MeshDiffJobManager()
+
+
+@router.get("/api/3d/status")
+def get_3d_status() -> dict:
+    return check_3d_availability()
+
+
+@router.post("/api/3d/jobs", status_code=202)
+def create_3d_job(
+    file_old: UploadFile = File(...),
+    file_new: UploadFile = File(...),
+    quality: str = Form("standard"),
+    align_mode: str = Form("auto"),
+    linear_deflection: float | None = Form(None),
+) -> JSONResponse:
+    if not is_git_3d_path(file_old.filename or "") or not is_git_3d_path(file_new.filename or ""):
+        raise HTTPException(status_code=400, detail="STEPファイル（拡張子 .step または .stp）を指定してください。")
+    _validate_3d_request(quality, align_mode)
+
+    content_old = read_upload_or_413(file_old)
+    content_new = read_upload_or_413(file_new)
+    if not content_old or not content_new:
+        raise HTTPException(status_code=400, detail="アップロードされたファイルが空です。")
+
+    job_id = mesh_job_manager.create_job(
+        file_old.filename or "old.step",
+        content_old,
+        file_new.filename or "new.step",
+        content_new,
+        quality=quality,
+        align_mode=align_mode,
+        linear_deflection=linear_deflection,
+    )
+    return JSONResponse(status_code=202, content={"job_id": job_id, "status": "queued"})
+
+
+@router.get("/api/3d/jobs/{job_id}")
+def get_3d_job_status(job_id: str) -> JSONResponse:
+    status = mesh_job_manager.get_status(job_id)
+    if status is None:
+        raise HTTPException(status_code=404, detail="指定された3D差分ジョブが見つかりません。")
+    return JSONResponse(status)
+
+
+@router.get("/api/3d/jobs/{job_id}/mesh/{side}")
+def get_3d_job_mesh(job_id: str, side: str):
+    if side not in ("old", "new"):
+        raise HTTPException(status_code=400, detail="side は 'old' または 'new' を指定してください。")
+    status = mesh_job_manager.get_status(job_id)
+    if status is None:
+        raise HTTPException(status_code=404, detail="指定された3D差分ジョブが見つかりません。")
+    if status.get("status") != "done":
+        raise HTTPException(status_code=409, detail=f"ジョブが完了していません（現在の状態: {status.get('status')}）。")
+    data = mesh_job_manager.get_mesh_binary(job_id, side)
+    if data is None:
+        raise HTTPException(status_code=404, detail="メッシュデータが存在しません。")
+    return Response(content=data, media_type="application/octet-stream")
+
+
+@router.delete("/api/3d/jobs/{job_id}")
+def delete_3d_job(job_id: str) -> JSONResponse:
+    deleted = mesh_job_manager.delete_job(job_id)
+    if not deleted:
+        raise HTTPException(status_code=404, detail="指定された3D差分ジョブが見つかりません。")
+    return JSONResponse({"status": "deleted"})
+
+
+def _validate_3d_request(quality: str, align_mode: str) -> None:
+    if quality not in QUALITY_MODES:
+        raise HTTPException(status_code=400, detail=f"無効な品質設定です: {quality}（{' / '.join(QUALITY_MODES)}）")
+    if align_mode not in ALIGN_MODES:
+        raise HTTPException(status_code=400, detail=f"無効な位置合わせモードです: {align_mode}")
+    avail = check_3d_availability()
+    if not avail["available"]:
+        raise HTTPException(
+            status_code=503,
+            detail=f"3D差分に必要なライブラリが不足しています: {', '.join(avail['missing'])}。{avail['install_hint']}",
+        )
+
+
+STEP_SAMPLE_DEFINITIONS = [
+    {"id": "hole_position", "title": "穴位置の変更 (φ12穴 x=30 → x=60)"},
+    {"id": "dimension", "title": "寸法の変更 (ブロック長さ 80 → 90)"},
+    {"id": "added_boss", "title": "ボスの追加 (φ20x15 円柱)"},
+    {"id": "moved_rotated", "title": "位置・向きズレのみ (同一形状・回転35°/15°補正・差分0%)"},
+    {"id": "moved_rotated_diff", "title": "位置ズレ＋形状変更 (回転35°/15°補正＋縦壁に穴追加)"},
+    {"id": "unit_inch", "title": "単位不一致 (ミリ vs インチ段付き軸)"},
+]
+STEP_SAMPLES_DIR = Path(__file__).resolve().parents[3] / "samples" / "step"
+
+
+@router.get("/api/3d/samples")
+def get_3d_samples() -> list[dict]:
+    return [
+        item for item in STEP_SAMPLE_DEFINITIONS
+        if (STEP_SAMPLES_DIR / f"{item['id']}_a.step").exists() and (STEP_SAMPLES_DIR / f"{item['id']}_b.step").exists()
+    ]
+
+
+@router.post("/api/3d/samples/load", status_code=202)
+def load_3d_sample(payload: dict) -> JSONResponse:
+    sample_id = str(payload.get("sample_id", ""))
+    quality = str(payload.get("quality", "standard"))
+    align_mode = str(payload.get("align_mode", "auto"))
+
+    # 定義済みのサンプルIDだけを受け付ける（任意のパスを組み立てさせない）。
+    known_ids = {item["id"] for item in STEP_SAMPLE_DEFINITIONS}
+    path_a = STEP_SAMPLES_DIR / f"{sample_id}_a.step"
+    path_b = STEP_SAMPLES_DIR / f"{sample_id}_b.step"
+    if sample_id not in known_ids or not path_a.exists() or not path_b.exists():
+        raise HTTPException(status_code=404, detail=f"サンプル '{sample_id}' が見つかりません。")
+    _validate_3d_request(quality, align_mode)
+
+    content_old = path_a.read_bytes()
+    content_new = path_b.read_bytes()
+    job_id = mesh_job_manager.create_job(
+        f"{sample_id}_a.step",
+        content_old,
+        f"{sample_id}_b.step",
+        content_new,
+        quality=quality,
+        align_mode=align_mode,
+    )
+    return JSONResponse(status_code=202, content={"job_id": job_id, "status": "queued"})
+
+
+@router.post("/api/git/3d/jobs", status_code=202)
+def create_git_3d_job(payload: dict) -> JSONResponse:
+    """Git管理下のSTEPファイル（HEAD vs 作業ツリー）から3D差分ジョブを作成する。"""
+    folder = payload_folder(payload)
+    repo = git_repo_root(folder)
+    path = str(payload.get("path") or "")
+    if not path:
+        raise HTTPException(status_code=422, detail="path is required")
+    rel_path = safe_git_path(repo, path, restrict_to_images=False)
+    head_path = str(payload.get("head_path") or path)
+    head_rel_path = safe_git_path(repo, head_path, restrict_to_images=False)
+
+    if not is_git_3d_path(rel_path):
+        raise HTTPException(status_code=400, detail="STEPファイル（拡張子 .step または .stp）を指定してください。")
+
+    quality = str(payload.get("quality") or "standard")
+    align_mode = str(payload.get("align_mode") or "auto")
+    _validate_3d_request(quality, align_mode)
+
+    has_head = bool(payload.get("has_head", True))
+    has_current = bool(payload.get("has_current", True))
+
+    content_old = b""
+    if has_head:
+        try:
+            content_old = git_show(repo, head_rel_path, max_bytes=MAX_UPLOAD_BYTES)
+        except HTTPException:
+            content_old = b""
+
+    content_new = b""
+    if has_current:
+        current_path = repo / rel_path
+        if current_path.exists() and current_path.is_file():
+            content_new = read_file_limited(current_path, MAX_UPLOAD_BYTES, rel_path)
+
+    if not content_old and not content_new:
+        raise HTTPException(status_code=404, detail="HEAD側にも作業ツリー側にもSTEPファイルが見つかりません。")
+
+    job_id = mesh_job_manager.create_job(
+        f"HEAD_{Path(head_rel_path).name}" if content_old else "",
+        content_old,
+        Path(rel_path).name if content_new else "",
+        content_new,
+        quality=quality,
+        align_mode=align_mode,
+    )
+    return JSONResponse({"job_id": job_id, "status": "pending"}, status_code=202)
diff --git a/backend/app/settings_store.py b/backend/app/settings_store.py
new file mode 100644
index 0000000000000000000000000000000000000000..547e0f42f88862af2f5737a712361917387a6251
--- /dev/null
+++ b/backend/app/settings_store.py
@@ -0,0 +1,47 @@
+"""
+サーバー設定（Obsidianフォルダー・レポート保存先）の読み書き。
+- 保存先は `backend/.visual-diff-settings.json`（環境変数 VISUAL_DIFF_SETTINGS_PATH で変更可）
+- ファイルが無い・壊れている場合は空設定として扱う（初回起動や会社環境でもエラーにしない）
+- 書き込みは一時ファイル経由の置き換えで行い、途中で壊れた設定ファイルを残さない
+"""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+
+from fastapi import HTTPException
+
+SERVER_SETTINGS_PATH = Path(os.environ.get("VISUAL_DIFF_SETTINGS_PATH", Path(__file__).resolve().parents[1] / ".visual-diff-settings.json"))
+
+
+def validated_directory_setting(value: object, label: str, *, required: bool = False) -> str:
+    raw_value = str(value or "").strip()
+    if not raw_value:
+        if required:
+            raise HTTPException(status_code=422, detail=f"{label}が未設定です")
+        return ""
+    folder = Path(raw_value).expanduser()
+    try:
+        folder = folder.resolve(strict=True)
+    except FileNotFoundError as exc:
+        raise HTTPException(status_code=422, detail=f"{label}が見つかりません") from exc
+    if not folder.is_dir():
+        raise HTTPException(status_code=422, detail=f"{label}はディレクトリを指定してください")
+    return str(folder)
+
+
+def load_server_settings() -> dict:
+    try:
+        value = json.loads(SERVER_SETTINGS_PATH.read_text(encoding="utf-8"))
+        return value if isinstance(value, dict) else {}
+    except (FileNotFoundError, OSError, json.JSONDecodeError):
+        return {}
+
+
+def save_server_settings(settings: dict) -> None:
+    SERVER_SETTINGS_PATH.parent.mkdir(parents=True, exist_ok=True)
+    temporary = SERVER_SETTINGS_PATH.with_suffix(f"{SERVER_SETTINGS_PATH.suffix}.tmp")
+    temporary.write_text(json.dumps(settings, ensure_ascii=False, indent=2), encoding="utf-8")
+    temporary.replace(SERVER_SETTINGS_PATH)
