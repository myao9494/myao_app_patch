+  padding: 2px 4px;
+  border: 2px dashed var(--changed);
+  border-radius: 4px;
+  background: rgba(245, 181, 61, 0.08);
+  color: #1a1206;
+  font-weight: 800;
+  font-size: 11px;
+  line-height: 1;
   display: grid;
-  place-items: center;
-  background: rgba(2, 6, 23, 0.72);
