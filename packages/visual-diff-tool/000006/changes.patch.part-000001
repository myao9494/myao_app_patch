diff --git a/frontend/test/jsx_runtime.test.js b/frontend/test/jsx_runtime.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..9367ed56b4f378afd54ed85604370274a18fdd81
--- /dev/null
+++ b/frontend/test/jsx_runtime.test.js
@@ -0,0 +1,25 @@
+/**
+ * ビルド設定の前提を守るテスト。
+ * vite.config を置かずに esbuild の既定（クラシックJSX変換: React.createElement）でビルドしているため、
+ * JSXを含むファイルは必ず React を import していなければならない（無いと画面が真っ白になる）。
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import { readdirSync, readFileSync } from "node:fs";
+import { join } from "node:path";
+
+const SRC = new URL("../src/", import.meta.url).pathname;
+
+function listJsxFiles(dir) {
+  return readdirSync(dir, { withFileTypes: true }).flatMap((entry) => {
+    const path = join(dir, entry.name);
+    if (entry.isDirectory()) return listJsxFiles(path);
+    return entry.name.endsWith(".jsx") ? [path] : [];
+  });
+}
+
+test("すべての .jsx ファイルが React を import している", () => {
+  const missing = listJsxFiles(SRC).filter((file) => !/^import React\b/m.test(readFileSync(file, "utf8")));
+  assert.deepEqual(missing, []);
+});
diff --git a/frontend/test/lib.test.js b/frontend/test/lib.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..aef2e7550988298f4b107828199b5f5e28d102fd
--- /dev/null
+++ b/frontend/test/lib.test.js
@@ -0,0 +1,86 @@
+/**
+ * 共通処理（lib/）の単体テスト。
+ * - Git対象拡張子の正規化
+ * - Git画像メモIDの決まり方（同じファイルは同じID、Excalidraw図は本文と別ID）
+ * - 並列度を制限した順序維持の非同期処理
+ * - 画像の data URI を画像オブジェクトごとに1回だけ作る
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import { mapWithConcurrency } from "../src/lib/api.js";
+import { toDataUri } from "../src/lib/files.js";
+import { gitImageMemoId, gitMemoKey } from "../src/lib/memoStore.js";
+import { loadDisplayScale, loadMemoSidebarWidth, normalizeTextExtensions } from "../src/lib/storage.js";
+import { normalizeLineEndings } from "../src/lib/util.js";
+
+test("normalizeTextExtensions: 小文字化・ドット補完・重複除去・不正値除外を行う", () => {
+  assert.deepEqual(normalizeTextExtensions("MD, .txt  yaml,md, ..bad, ok!"), [".md", ".txt", ".yaml"]);
+  assert.deepEqual(normalizeTextExtensions([".CSV", "csv"]), [".csv"]);
+  assert.equal(normalizeTextExtensions(Array.from({ length: 80 }, (_, index) => `e${index}`)).length, 50);
+});
+
+test("gitImageMemoId: 同じリポジトリ・パスは同じID、Excalidraw図は本文と別ID", () => {
+  const id = gitImageMemoId("/repo", "docs/note.md");
+  assert.equal(id, gitImageMemoId("/repo", "docs/note.md"));
+  assert.match(id, /^git-image-[0-9a-f]+$/);
+  assert.notEqual(id, gitImageMemoId("/repo", "docs/note.md#excalidraw"));
+  assert.equal(gitMemoKey("", "a.md"), "repo::a.md");
+});
+
+test("mapWithConcurrency: 順序を保ち、同時実行数を limit 以下に抑える", async () => {
+  let running = 0;
+  let peak = 0;
+  const results = await mapWithConcurrency([30, 5, 20, 1, 10], 2, async (delay, index) => {
+    running += 1;
+    peak = Math.max(peak, running);
+    await new Promise((resolve) => setTimeout(resolve, delay));
+    running -= 1;
+    return index * 10;
+  });
+  assert.deepEqual(results, [0, 10, 20, 30, 40]);
+  assert.equal(peak, 2);
+});
+
+test("mapWithConcurrency: 1件でも失敗したら例外を投げる", async () => {
+  await assert.rejects(
+    mapWithConcurrency([1, 2, 3], 2, async (value) => {
+      if (value === 2) throw new Error("failed");
+      return value;
+    }),
+    /failed/,
+  );
+});
+
+test("normalizeLineEndings: CRLF・CRをLFへ統一する", () => {
+  assert.equal(normalizeLineEndings("a\r\nb\rc\n"), "a\nb\nc\n");
+  assert.equal(normalizeLineEndings(undefined), "");
+});
+
+test("toDataUri: 同じ画像オブジェクトには同じ文字列を返し、別オブジェクトは別に作る", () => {
+  const image = { mime_type: "image/png", data: "QUJD" };
+  const first = toDataUri(image);
+  assert.equal(first, "data:image/png;base64,QUJD");
+  assert.equal(toDataUri(image), first);
+  assert.equal(toDataUri({ mime_type: "image/jpeg", data: "QUJD" }), "data:image/jpeg;base64,QUJD");
+});
+
+test("loadDisplayScale / loadMemoSidebarWidth: 未保存なら既定値（100% / 230px）、保存値は範囲内に丸める", () => {
+  const store = new Map();
+  globalThis.localStorage = {
+    getItem: (key) => (store.has(key) ? store.get(key) : null),
+    setItem: (key, value) => store.set(key, String(value)),
+  };
+  try {
+    assert.equal(loadDisplayScale(), 1);
+    assert.equal(loadMemoSidebarWidth(), 230);
+    store.set("visual-diff-display-scale-v2", "1.25");
+    store.set("visual-diff-memo-sidebar-width", "9999");
+    assert.equal(loadDisplayScale(), 1.25);
+    assert.equal(loadMemoSidebarWidth(), 420);
+    store.set("visual-diff-display-scale-v2", "abc");
+    assert.equal(loadDisplayScale(), 1);
+  } finally {
+    delete globalThis.localStorage;
+  }
+});
diff --git a/frontend/test/memo_model.test.js b/frontend/test/memo_model.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..c3090c4f9d11a2899e5970a662f63064dd1522af
--- /dev/null
+++ b/frontend/test/memo_model.test.js
@@ -0,0 +1,114 @@
+/**
+ * 差分メモのデータモデル（memo/memoModel.js）の単体テスト。
+ * - 保存データが古い・壊れていても normalize* で安全な値へ補正できる
+ * - 矢印の起点・終点と矩形表現の相互変換
+ * - メモの色割り当て・引出線の辺へのスナップ・自動サイズ
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  arrowAnnotationFromEndpoints,
+  calculateMemoAutoSize,
+  MEMO_COLORS,
+  MEMO_DEFAULTS,
+  memoArrowEndpoints,
+  memoColor,
+  memoHistorySnapshot,
+  memoHistorySnapshotEquals,
+  memoNoteLeaders,
+  nextMemoColorIndex,
+  nextMemoNumber,
+  normalizeMemoAnnotations,
+  normalizeMemoNotes,
+  normalizeStickyNotes,
+  snapMemoLeaderPoint,
+  STICKY_DEFAULTS,
+  updateMemoLeader,
+} from "../src/memo/memoModel.js";
+
+test("normalizeMemoNotes: 配列以外・nullを除外し、範囲外や不正値を既定値へ補正する", () => {
+  assert.deepEqual(normalizeMemoNotes(null), []);
+  assert.deepEqual(normalizeMemoNotes("x"), []);
+  const [note] = normalizeMemoNotes([null, { x: 500, y: -10, text: 3, changeType: "unknown", fontSize: 999 }]);
+  assert.equal(note.id, "recovered-note-0"); // null を除いた後の位置で採番する
+  assert.equal(note.x, 88);
+  assert.equal(note.y, 0);
+  assert.equal(note.text, MEMO_DEFAULTS.text);
+  assert.equal(note.changeType, MEMO_DEFAULTS.changeType);
+  assert.equal(note.fontSize, 48);
+  assert.deepEqual(note.extraLeaders, []);
+  assert.deepEqual(note.annotations, []);
+});
+
+test("normalizeMemoNotes: 色番号がない古いデータはメモ番号から色を決める", () => {
+  const [note] = normalizeMemoNotes([{ id: "a", number: MEMO_COLORS.length + 2 }]);
+  assert.equal(note.colorIndex, 1);
+  assert.equal(memoColor(note), MEMO_COLORS[1]);
+});
+
+test("normalizeMemoAnnotations: 未知の種類は矩形、マーカーは細い高さを許可する", () => {
+  const [rect, marker] = normalizeMemoAnnotations([
+    { type: "triangle", x: 10, y: 10, width: 200, height: 0 },
+    { type: "highlight", x: 0, y: 0, width: 10, height: 0.05 },
+  ]);
+  assert.equal(rect.type, "rectangle");
+  assert.equal(rect.width, 90); // 画像の右端を超えない
+  assert.equal(rect.height, 0.4);
+  assert.equal(marker.height, 0.05);
+  assert.equal(marker.opacity, 28);
+});
+
+test("normalizeStickyNotes: 位置・サイズを範囲内へ収める", () => {
+  const [sticky] = normalizeStickyNotes([{ x: 200, width: 10, fontSize: "abc" }]);
+  assert.equal(sticky.x, 90);
+  assert.equal(sticky.y, STICKY_DEFAULTS.y);
+  assert.equal(sticky.width, 120);
+  assert.equal(sticky.fontSize, STICKY_DEFAULTS.fontSize);
+});
+
+test("arrowAnnotationFromEndpoints / memoArrowEndpoints: 右上から左下への矢印を往復変換できる", () => {
+  const start = { x: 80, y: 10 };
+  const end = { x: 20, y: 60 };
+  const annotation = arrowAnnotationFromEndpoints(start, end);
+  assert.deepEqual(
+    { x: annotation.x, y: annotation.y, reverseX: annotation.reverseX, reverseY: annotation.reverseY },
+    { x: 20, y: 10, reverseX: true, reverseY: false },
+  );
+  assert.deepEqual(memoArrowEndpoints(annotation), { start, end });
+});
+
+test("nextMemoColorIndex / nextMemoNumber: 未使用の色と次の番号を選ぶ", () => {
+  const notes = [{ id: "a", number: 1, colorIndex: 0 }, { id: "b", number: 4, colorIndex: 2 }];
+  assert.equal(nextMemoColorIndex(notes), 1);
+  assert.equal(nextMemoNumber(notes), 5);
+});
+
+test("snapMemoLeaderPoint: 引出線の起点はメモ枠の最も近い辺に吸着する", () => {
+  const size = { width: 100, height: 40 };
+  assert.deepEqual(snapMemoLeaderPoint({ x: 3, y: 20 }, size), { x: 0, y: 20 });
+  assert.deepEqual(snapMemoLeaderPoint({ x: 50, y: 38 }, size), { x: 50, y: 40 });
+  assert.deepEqual(snapMemoLeaderPoint({ x: 500, y: 20 }, size), { x: 100, y: 20 });
+});
+
+test("memoNoteLeaders / updateMemoLeader: 追加の引出線も含めて終点を更新できる", () => {
+  const [note] = normalizeMemoNotes([{ id: "n", extraLeaders: [{ id: "l1" }] }]);
+  assert.deepEqual(memoNoteLeaders(note).map((leader) => leader.id), ["primary", "l1"]);
+  const moved = updateMemoLeader(note, "n", "l1", "end", { end: { x: 5, y: 6 } });
+  assert.equal(moved.extraLeaders[0].leaderEndX, 5);
+  assert.equal(moved.leaderEndX, note.leaderEndX);
+});
+
+test("calculateMemoAutoSize: 文字数に応じて広がり、上限で折り返す", () => {
+  const small = calculateMemoAutoSize({ text: "あ", fontSize: 15 });
+  const long = calculateMemoAutoSize({ text: "あ".repeat(200), fontSize: 15 });
+  assert.equal(small.width, 100);
+  assert.equal(long.width, 420);
+  assert.ok(long.height > small.height);
+});
+
+test("memoHistorySnapshotEquals: 正規化後の内容で比較する", () => {
+  const left = memoHistorySnapshot([{ id: "a", text: "x" }], []);
+  const right = memoHistorySnapshot([{ id: "a", text: "x", unknownField: 1 }], null);
+  assert.ok(memoHistorySnapshotEquals(left, right));
+});
diff --git a/frontend/test/report.test.js b/frontend/test/report.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..7389678cd96f14c23e6f10ae7c5bef8e06e53624
--- /dev/null
+++ b/frontend/test/report.test.js
@@ -0,0 +1,79 @@
+/**
+ * HTML出力（report/standaloneReport.js）と表示範囲計算（report/reportGeometry.js）の単体テスト。
+ * - 自己完結HTMLに埋め込む文字列は必ずエスケープする
+ * - 出力領域（crop）と表示範囲は画像に対する % で計算する
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  effectiveMemoStageSize,
+  normalizeReportCrop,
+  normalizeReportView,
+  reportViewportGeometry,
+  reportVisibleCrop,
+} from "../src/report/reportGeometry.js";
+import { buildTextReportSection, gitReportFilename, reportLineHtml } from "../src/report/standaloneReport.js";
+import { escapeHtml } from "../src/lib/util.js";
+
+test("escapeHtml: HTMLの特殊文字をすべてエスケープする", () => {
+  assert.equal(escapeHtml(`<a href="x">'&'</a>`), "&lt;a href=&quot;x&quot;&gt;&#39;&amp;&#39;&lt;/a&gt;");
+  assert.equal(escapeHtml(null), "");
+});
+
+test("reportLineHtml: 変更箇所だけ mark で囲み、内容はエスケープする", () => {
+  const row = { kind: "replace", old_segments: [{ text: "a<b", changed: false }, { text: "c", changed: true }] };
+  assert.equal(reportLineHtml(row, "old"), "a&lt;b<mark>c</mark>");
+  assert.equal(reportLineHtml({ kind: "insert", new: "<x>" }, "new"), "<mark>&lt;x&gt;</mark>");
+  assert.equal(reportLineHtml({ kind: "equal", old: "same" }, "old"), "same");
+});
+
+test("buildTextReportSection: パスとメモをエスケープし、行を左右セルとして出力する", () => {
+  const html = buildTextReportSection({
+    file: { path: "<evil>.md", head_path: "old.md", change_type: "modified" },
+    data: { rows: [{ kind: "replace", old_number: 1, new_number: 1, old: "a", new: "b" }] },
+    memo: "line1\n<script>",
+  });
+  assert.ok(html.includes("&lt;evil&gt;.md"));
+  assert.ok(!html.includes("<script>"));
+  assert.ok(html.includes("line1<br>&lt;script&gt;"));
+  assert.equal((html.match(/class="code-cell/g) ?? []).length, 2);
+});
+
+test("gitReportFilename: Markdown起点はノート名、通常はリポジトリ名と日付", () => {
+  assert.equal(gitReportFilename({ source_markdown: "C:\\vault\\設計メモ.md" }), "設計メモ_変更差分レポート.html");
+  assert.match(gitReportFilename({ repo_root: "/work/my-repo" }), /^my-repo-diff-\d{8}\.html$/);
+});
+
+test("normalizeReportCrop: 範囲外を補正し、不正な値は null", () => {
+  assert.equal(normalizeReportCrop(null), null);
+  assert.deepEqual(normalizeReportCrop({ x: 99, y: -5, width: 50, height: 1 }), { x: 98, y: 0, width: 2, height: 2 });
+});
+
+test("reportViewportGeometry / reportVisibleCrop: 倍率100%では画像全体が表示範囲になる", () => {
+  const view = normalizeReportView({ centerX: 50, centerY: 50, zoom: 100, cardWidth: 500, cardHeight: 250 });
+  const imageSize = { width: 1000, height: 500 };
+  const viewport = { width: 500, height: 250 };
+  const geometry = reportViewportGeometry(imageSize, viewport, view);
+  assert.deepEqual({ width: geometry.width, height: geometry.height, left: geometry.left, top: geometry.top }, {
+    width: 500, height: 250, left: 0, top: 0,
+  });
+  assert.deepEqual(reportVisibleCrop(imageSize, viewport, view), { x: 0, y: 0, width: 100, height: 100 });
+});
+
+test("reportVisibleCrop: 倍率200%・中心を左上寄りにすると左上1/4付近を切り出す", () => {
+  const view = normalizeReportView({ centerX: 25, centerY: 25, zoom: 200, cardWidth: 500, cardHeight: 250 });
+  assert.deepEqual(reportVisibleCrop({ width: 1000, height: 500 }, { width: 500, height: 250 }, view), {
+    x: 0, y: 0, width: 50, height: 50,
+  });
+});
+
+test("effectiveMemoStageSize: 新形式は画像倍率を掛け、旧形式は妥当な寸法だけ使う", () => {
+  assert.deepEqual(
+    effectiveMemoStageSize({ stageSize: { width: 800, height: 600 }, memoGeometryVersion: 2, memoImageScale: 50 }),
+    { width: 400, height: 300 },
+  );
+  assert.deepEqual(effectiveMemoStageSize({ stageSize: { width: 900, height: 600 } }), { width: 900, height: 600 });
+  assert.equal(effectiveMemoStageSize({ stageSize: { width: 3000, height: 600 } }), null);
+  assert.equal(effectiveMemoStageSize(null), null);
+});
diff --git a/tests/test_api_safety.py b/tests/test_api_safety.py
new file mode 100644
index 0000000000000000000000000000000000000000..d9d679971c7e4d5ab555990177c6149e2ddacce1
--- /dev/null
+++ b/tests/test_api_safety.py
@@ -0,0 +1,131 @@
+"""
+API の入力検証・安定性に関する回帰テスト。
+- 3DジョブIDは uuid4 の16進32文字だけを受け付け、`..` などでジョブ領域外を読み書き・削除させない
+- 3Dサンプル読み込みは定義済みIDだけを受け付ける
+- 静的ファイル配信は frontend/dist 直下のファイルだけを返す
+- 単体プレビュー（片側だけのSTEP）で失敗しても、原因を status.json に残して入力を削除する
+- Excalidraw埋め込みMarkdownのテキスト差分にも行数上限を適用する
+- Markdown起点の git status はパス指定を分割しても同じ結果になる
+"""
+
+import json
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from fastapi import HTTPException
+from fastapi.testclient import TestClient
+
+from backend.app import git_repo, main
+from backend.app.git_repo import changed_files, chunk_paths_by_length
+from backend.app.main import app
+from backend.app.mesh_jobs import (
+    MeshDiffJobManager,
+    _worker_entrypoint,
+    is_valid_job_id,
+)
+from backend.app.routes import three_d
+from backend.app.text_diff import MAX_TEXT_DIFF_LINES, build_markdown_text_diff_rows
+
+
+class TestMeshJobIdValidation(unittest.TestCase):
+    def setUp(self):
+        self.temp_dir = tempfile.TemporaryDirectory()
+        self.parent = Path(self.temp_dir.name)
+        self.sentinel = self.parent / "sentinel.txt"
+        self.sentinel.write_text("keep", encoding="utf-8")
+        self.manager = MeshDiffJobManager(self.parent / "jobs", retention_minutes=30)
+
+    def tearDown(self):
+        self.temp_dir.cleanup()
+
+    def test_only_uuid_hex_ids_are_valid(self):
+        self.assertTrue(is_valid_job_id("0123456789abcdef0123456789abcdef"))
+        for job_id in ("..", ".", "", "../jobs", "does-not-exist", "0123456789ABCDEF0123456789ABCDEF"):
+            self.assertFalse(is_valid_job_id(job_id), job_id)
+
+    def test_parent_directory_is_never_deleted_or_read(self):
+        self.assertFalse(self.manager.delete_job(".."))
+        self.assertIsNone(self.manager.get_status(".."))
+        self.assertIsNone(self.manager.get_mesh_binary("..", "old"))
+        self.assertTrue(self.sentinel.exists())
+        self.assertTrue((self.parent / "jobs").exists())
+        with self.assertRaises(ValueError):
+            self.manager.job_dir("..")
+
+    def test_api_rejects_dot_segments(self):
+        client = TestClient(app)
+        with patch.object(three_d, "mesh_job_manager", self.manager):
+            self.assertEqual(client.delete("/api/3d/jobs/%2e%2e").status_code, 404)
+            self.assertEqual(client.get("/api/3d/jobs/%2e%2e").status_code, 404)
+            self.assertEqual(client.get("/api/3d/jobs/%2e%2e/mesh/old").status_code, 404)
+        self.assertTrue(self.sentinel.exists())
+
+
+class TestSampleAndStaticValidation(unittest.TestCase):
+    def setUp(self):
+        self.client = TestClient(app)
+
+    def test_unknown_or_path_like_sample_id_is_404(self):
+        for sample_id in ("../step/hole_position", "unknown", ""):
+            response = self.client.post("/api/3d/samples/load", json={"sample_id": sample_id})
+            self.assertEqual(response.status_code, 404, sample_id)
+
+    def test_static_files_are_limited_to_dist_root(self):
+        self.assertIsNone(main._resolve_dist_file("../README.md"))
+        self.assertIsNone(main._resolve_dist_file(".."))
+        self.assertIsNone(main._resolve_dist_file("assets"))
+        if (main.DIST_DIR / "favicon.svg").exists():
+            self.assertEqual(main._resolve_dist_file("favicon.svg"), (main.DIST_DIR / "favicon.svg").resolve())
+
+
+class TestSingleStepJobFailure(unittest.TestCase):
+    def test_single_side_failure_writes_error_status_and_removes_input(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            job_dir = Path(tmp)
+            (job_dir / "status.json").write_text(json.dumps({"status": "running"}), encoding="utf-8")
+            broken = job_dir / "input_new.step"
+            broken.write_bytes(b"ISO-10303-21;\nbroken")
+            # 以前は片側が空のとき、エラー処理中に None.unlink() で二重例外となり原因が失われていた。
+            _worker_entrypoint(str(job_dir), "", str(broken), "", "broken.step", "coarse", "auto", None)
+            status = json.loads((job_dir / "status.json").read_text(encoding="utf-8"))
+            self.assertEqual(status["status"], "error")
+            self.assertTrue(status["error"])
+            self.assertFalse(broken.exists())
+
+
+class TestTextDiffLimits(unittest.TestCase):
+    def test_embedded_excalidraw_markdown_respects_line_limit(self):
+        marker = "---\nexcalidraw-plugin: parsed\n---\n"
+        huge = marker + "\n".join(f"line {index}" for index in range(MAX_TEXT_DIFF_LINES + 1))
+        with self.assertRaises(HTTPException) as caught:
+            build_markdown_text_diff_rows("", huge)
+        self.assertEqual(caught.exception.status_code, 413)
+
+
+class TestGitStatusChunking(unittest.TestCase):
+    def test_chunk_paths_by_length(self):
+        paths = [f"dir/file_{index:03d}.md" for index in range(50)]
+        chunks = chunk_paths_by_length(paths, 100)
+        self.assertEqual([path for chunk in chunks for path in chunk], paths)
+        self.assertTrue(all(sum(len(path) + 1 for path in chunk) <= 100 for chunk in chunks))
+        self.assertEqual(chunk_paths_by_length(["x" * 300], 100), [["x" * 300]])
+
+    def test_chunked_status_matches_single_call(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            repo = Path(tmp)
+            subprocess.run(["git", "init"], cwd=repo, check=True, capture_output=True)
+            for index in range(12):
+                (repo / f"note_{index:02d}.md").write_text(f"note {index}\n", encoding="utf-8")
+            paths = {f"note_{index:02d}.md" for index in range(12)}
+            expected = changed_files(repo, repo, {".md"}, specific_paths=paths)
+            with patch.object(git_repo, "GIT_PATHSPEC_CHUNK_CHARS", 30):
+                chunked = changed_files(repo, repo, {".md"}, specific_paths=paths)
+            self.assertEqual(len(expected), 12)
+            self.assertEqual(chunked, expected)
+
+
+if __name__ == "__main__":
+    unittest.main()
