-.report-preview-header { position: sticky; top: 0; z-index: 20; }
-
-.report-preview-header h1 { margin: 0; font-size: 20px; }
-.report-preview-header p { margin: 3px 0 0; color: #94a3b8; font-size: 12px; }
-.report-preview-header > div:last-child { display: flex; gap: 8px; }
-.report-preview-header button, .report-preview-page > footer button { min-height: 36px; padding: 0 14px; border: 1px solid #64748b; border-radius: 5px; background: #1e293b; color: #fff; cursor: pointer; }
-.report-preview-header button { display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
-.report-preview-page > footer { border-top: 1px solid #334155; border-bottom: 0; }
-.report-preview-content { min-height: 0; padding: 18px; }
-.report-preview-card { width: min(1180px, 100%); margin: 0 auto 14px; border: 1px solid #475569; border-radius: 8px; overflow: hidden; background: #111827; box-shadow: 0 8px 24px rgba(0,0,0,.24); }
-.report-preview-card > header { min-height: 52px; padding: 8px 11px; display: grid; grid-template-columns: auto minmax(0,1fr) auto auto; align-items: center; gap: 8px; background: #1e293b; cursor: grab; }
-.report-preview-card > header > div { min-width: 0; display: flex; flex-direction: column; }
-.report-preview-card > header strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
-.report-preview-card > header small { color: #94a3b8; }
-.report-preview-card > header button { width: 32px; height: 30px; border: 1px solid #64748b; border-radius: 4px; background: #0f172a; color: #fff; cursor: pointer; }
-.report-preview-text { padding: 10px; overflow: auto; }
-.report-preview-labels, .report-preview-row { min-width: 720px; display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr) 38px; }
-.report-preview-labels b { padding: 6px 10px; background: #273449; }
-.report-preview-row code { min-width: 0; padding: 4px 8px; display: grid; grid-template-columns: 42px minmax(0,1fr); border-bottom: 1px solid #334155; white-space: pre-wrap; overflow-wrap: anywhere; }
-.report-preview-row code:first-child { background: #3d2027; }
-.report-preview-row code:nth-child(2) { background: #173927; }
-.report-preview-row code i { padding-right: 8px; color: #94a3b8; text-align: right; font-style: normal; user-select: none; }
-.report-preview-row > button { margin: 3px; border: 1px solid #60a5fa; border-radius: 4px; display: grid; place-items: center; background: #1d4ed8; color: #fff; cursor: pointer; }
-.report-preview-clean { padding: 14px; color: #86efac; }
-.report-preview-image-editor { padding: 12px; }
-.report-preview-note-tabs { margin-bottom: 10px; display: flex; gap: 6px; flex-wrap: wrap; }
-.report-preview-note-tabs button { min-height: 30px; padding: 0 10px; border: 1px solid #475569; border-radius: 5px; background: #172033; color: #cbd5e1; cursor: pointer; }
-.report-preview-note-tabs button.active { border-color: #60a5fa; background: #1d4ed8; color: #fff; }
-.report-crop-layout { display: grid; grid-template-columns: minmax(360px, 1fr) minmax(260px, 340px); align-items: start; gap: 16px; }
-.report-view-editor { position: relative; max-width: 100%; padding: 0 8px 8px 0; }
-.report-view-toolbar { margin-bottom: 9px; }
-.report-view-actions { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; }
-.report-view-actions button { min-height: 32px; padding: 0 11px; border: 1px solid #64748b; border-radius: 5px; background: #1e293b; color: #e2e8f0; cursor: pointer; }
-.report-view-actions button.active { border-color: #93c5fd; background: #1d4ed8; color: #fff; }
-.report-view-actions span { padding: 4px 7px; border-radius: 4px; background: #0f172a; color: #cbd5e1; font-size: 12px; }
-.report-crop-hint { margin: 0 0 7px; color: #bfdbfe; font-size: 12px; }
-.report-crop-stage { position: relative; width: 100%; overflow: hidden; border: 1px solid #64748b; background: #fff; cursor: crosshair; touch-action: none; user-select: none; }
-.report-crop-stage img { position: absolute; display: block; max-width: none; pointer-events: none; }
-.report-pan-stage { cursor: grab; }
-.report-pan-stage:active { cursor: grabbing; }
-.report-pan-stage.selecting { cursor: crosshair; }
-.report-crop-selection { position: absolute; border: 2px solid #6366f1; background: rgba(99, 102, 241, .08); box-shadow: 0 0 0 9999px rgba(15, 23, 42, .36); pointer-events: none; }
-.report-crop-selection i { position: absolute; width: 14px; height: 14px; border: 3px solid #6366f1; background: #fff; }
-.report-crop-selection i:nth-child(1) { left: -7px; top: -7px; border-right: 0; border-bottom: 0; }
-.report-crop-selection i:nth-child(2) { right: -7px; top: -7px; border-left: 0; border-bottom: 0; }
-.report-crop-selection i:nth-child(3) { right: -7px; bottom: -7px; border-left: 0; border-top: 0; }
-.report-crop-selection i:nth-child(4) { left: -7px; bottom: -7px; border-right: 0; border-top: 0; }
-.report-visible-area-badge { position: absolute; right: 8px; bottom: 8px; padding: 4px 7px; border-radius: 4px; background: rgba(15,23,42,.82); color: #fff; font-size: 11px; pointer-events: none; }
-.report-card-resize-handle { position: absolute; right: 0; bottom: 0; width: 22px; height: 22px; padding: 0; border: 0; border-right: 4px solid #60a5fa; border-bottom: 4px solid #60a5fa; background: transparent; cursor: nwse-resize; touch-action: none; }
-.report-preview-memo-editor { min-height: 220px; padding: 14px; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; border: 1px solid #475569; border-radius: 7px; background: #172033; }
-.report-preview-memo-editor > strong { color: #f8fafc; font-size: 16px; }
-.report-preview-memo-editor textarea { width: 100%; min-height: 180px; resize: vertical; border: 1px solid #64748b; border-radius: 5px; padding: 10px; background: #0f172a; color: #fff; font: inherit; line-height: 1.5; }
-.report-preview-memo-editor button { min-height: 32px; padding: 0 10px; border: 1px solid #64748b; border-radius: 5px; background: #1e293b; color: #e2e8f0; cursor: pointer; }
 
