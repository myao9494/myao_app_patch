-    current = start_dir
-    while True:
-        if (current / ".obsidian").is_dir():
-            return current
-        if current == repo or current.parent == current:
-            break
-        current = current.parent
-
-    if (repo / ".obsidian").is_dir():
-        return repo
-
-    return repo
