olor:#f97316}.copy-notice{color:#bbf7d0;font-size:13px}.memo-stage-wrap{flex:1;min-height:0;overflow:auto;padding:24px;display:block}.memo-stage{position:relative;width:min(100%,1280px);margin:0 auto;min-height:calc(420px * var(--memo-content-scale, 1));background:#0a0a0a;border:1px solid #374151;border-radius:6px;overflow:hidden;cursor:grab;-webkit-user-select:none;user-select:none}.memo-stage.panning{cursor:grabbing}.memo-stage.annotation-drawing{cursor:crosshair}.memo-image,.memo-image-b-clip{display:block;width:100%}.memo-image{height:auto;pointer-events:none}.memo-image-b-clip{position:absolute;inset:0;overflow:hidden}.memo-image-a{opacity:1}.comparison-handle{position:absolute;top:0;bottom:0;width:18px;background:#0ea5e9;background-clip:content-box;box-shadow:inset 8px 0 0 transparent,inset -8px 0 0 transparent,0 0 12px #0ea5e9d9;cursor:ew-resize;padding:0 8px;transform:translate(-9px);pointer-events:auto;z-index:4}.comparison-handle span{position:absolute;top:12px;min-width:82px;height:36px;padding:0 10px;border-radius:999px;display:grid;place-items:center;background:#111827;border:1px solid #f8fafc;color:#f8fafc;font-size:16px;font-weight:800;line-height:1;white-space:nowrap;z-index:1}.comparison-handle span:first-child{right:8px}.comparison-handle span:last-child{left:8px}.memo-annotation{position:absolute;z-index:1;min-width:6px;min-height:6px;border:calc(4px * var(--memo-content-scale, 1)) solid color-mix(in srgb,var(--annotation-color, #ef4444) calc(var(--annotation-opacity, 1) * 100%),transparent);background:transparent;cursor:move;touch-action:none}.memo-sticky{position:absolute;z-index:3;min-width:120px;min-height:64px;padding:0;border:1px solid #d6b85b;border-radius:3px;background:#fef3c7;box-shadow:0 8px 20px #42200633;cursor:grab;touch-action:none;transform:scale(var(--memo-content-scale, 1));transform-origin:top left}.memo-sticky:after{content:"";position:absolute;right:0;bottom:0;border-width:0 0 14px 14px;border-style:solid;border-color:transparent transparent #e7cf83 transparent;pointer-events:none}.memo-sticky textarea{width:100%;height:100%;resize:none;border:0;padding:27px 12px 12px;background:transparent;color:#1f2937;font-size:var(--sticky-font-size, 15px);font-weight:700;line-height:1.4;outline:none;overflow:hidden}.sticky-grip{position:absolute;top:0;left:0;right:0;height:23px;display:grid;place-items:center;border-bottom:1px solid rgba(161,98,7,.22);background:#d9770614;color:#92400e;cursor:grab;z-index:2}.sticky-grip span{transform:translateY(-3px);font-size:16px;font-weight:900;letter-spacing:2px;pointer-events:none}.memo-sticky textarea:focus{box-shadow:inset 0 0 0 2px #d97706}.sticky-delete{position:absolute;top:-10px;right:-10px;width:22px;height:22px;padding:0;border:1px solid #92400e;border-radius:999px;display:grid;place-items:center;background:#78350f;color:#fef3c7;cursor:pointer}.memo-annotation.cloud{border-width:7px;border-style:dotted;border-radius:18px}.memo-annotation.ellipse{border-radius:50%}.memo-annotation.highlight{min-height:2px;border:0;border-radius:4px;background:color-mix(in srgb,var(--annotation-color, #facc15) calc(var(--annotation-opacity, .28) * 100%),transparent);mix-blend-mode:multiply}.memo-annotation.arrow{min-width:18px;min-height:18px;border:0}.memo-arrow{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none}.memo-arrow line{stroke:var(--annotation-color, #ef4444);stroke-width:calc(var(--arrow-stroke-width, 4) * 1px * var(--memo-content-scale, 1));vector-effect:non-scaling-stroke;stroke-linecap:round}.memo-arrow-endpoint{position:absolute;width:18px;height:18px;padding:0;border:3px solid #ffffff;border-radius:999px;background:#111827;transform:translate(-50%,-50%);cursor:crosshair;z-index:4}.memo-arrow-endpoint.end{border-color:var(--annotation-color, #ef4444);background:#fff}.memo-annotation.selected{z-index:3}.memo-annotation.selected:after{content:"";position:absolute;inset:-6px;border:2px solid #38bdf8;border-radius:4px;box-shadow:0 0 0 1px #0f172ae6,0 0 8px #38bdf8bf;pointer-events:none;z-index:2}.memo-annotation-resize{position:absolute;width:20px;height:20px;padding:0;border:1px solid #ffffff;display:grid;place-items:center;background:#111827;color:#fff;z-index:3}.memo-annotation-resize{right:-10px;bottom:-10px;border-radius:3px;cursor:nwse-resize}.memo-note{position:absolute;z-index:2;min-height:42px;padding:0;cursor:grab;display:flex;touch-action:none;transform:scale(var(--memo-content-scale, 1));transform-origin:top left}.memo-leader{position:absolute;left:-420px;top:-240px;width:1040px;height:760px;z-index:0;pointer-events:none;overflow:visible}.memo-leader line{stroke:var(--memo-line, #ff1d14);stroke-opacity:var(--memo-alpha, 1);stroke-width:6px;stroke-linecap:butt;pointer-events:stroke;cursor:pointer}.memo-leader-handle{position:absolute;width:14px;height:14px;padding:0;border:2px solid #ffffff;border-radius:999px;background:#ff1d14;transform:translate(-7px,-7px);cursor:crosshair;z-index:4;opacity:0}.memo-leader-handle.end{background:#fff;border-color:#ff1d14}.memo-leader-handle.extra{background:#f97316}.memo-leader-handle.end.extra{background:#fff7ed;border-color:#f97316}.memo-note.selected .memo-leader-handle{opacity:1}.memo-note textarea{position:relative;width:100%;height:100%;min-height:inherit;resize:none;border:2px solid transparent;border-radius:8px;padding:6px 8px;background:var(--memo-fill, #ff1d14);background:color-mix(in srgb,var(--memo-fill, #ff1d14) calc(var(--memo-alpha, 1) * 100%),transparent);color:#fff;font-size:var(--memo-font-size, 24px);font-weight:800;line-height:1.15;text-align:center;outline:none;z-index:1;cursor:grab;caret-color:transparent}.memo-note.selected textarea{border-color:var(--memo-border, #ffffff);box-shadow:0 0 0 3px color-mix(in srgb,var(--memo-line, #ff1d14) 32%,transparent)}.memo-note.editing textarea{border-color:#38bdf8;box-shadow:0 0 0 3px #38bdf86b;cursor:text;caret-color:auto;-webkit-user-select:text;user-select:text}.memo-delete{position:absolute;right:-10px;top:-10px;width:24px;height:24px;padding:0;border:1px solid #991b1b;border-radius:999px;display:grid;place-items:center;background:#450a0a;color:#fecaca;cursor:pointer;z-index:3}.context-menu{position:fixed;z-index:20;min-width:280px;padding:6px;border:1px solid #475569;border-radius:6px;background:#1f2937;box-shadow:0 18px 48px #00000073}.context-menu button{width:100%;min-height:34px;padding:0 10px;border:0;border-radius:4px;display:flex;align-items:center;background:transparent;color:#e5e7eb;cursor:pointer;text-align:left}.context-menu button:hover{background:#374151}.memo-empty{width:min(560px,calc(100vw - 32px));margin:20vh auto 0;padding:24px;border:1px solid #374151;border-radius:6px;background:#171717}.api-guide-page{min-height:100vh;background:#0f172a}.api-guide-header{min-height:86px;padding:18px 24px;border-bottom:1px solid #334155;display:flex;align-items:center;justify-content:space-between;gap:16px;background:#1e293b}.api-guide-header>div:last-child{display:flex;align-items:center;gap:8px}.api-guide-openapi{text-decoration:none}.api-guide-content{width:min(1120px,calc(100vw - 48px));margin:0 auto;padding:24px 0 40px;display:flex;flex-direction:column;gap:16px}.api-guide-section,.api-endpoint{border:1px solid #334155;border-radius:6px;padding:18px;background:#111827}.api-guide-section h2,.api-endpoint h2,.api-endpoint h3{margin:0 0 10px;letter-spacing:0}.api-guide-section h2{font-size:20px}.api-endpoint h3{margin-top:16px;font-size:14px;color:#bae6fd}.api-guide-section ul,.api-guide-section ol{margin:10px 0 0;padding-left:22px;color:#cbd5e1}.api-guide-section li+li{margin-top:8px}.api-endpoint-title{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-bottom:8px}.api-method{min-width:54px;min-height:28px;padding:0 8px;border-radius:4px;display:inline-flex;align-items:center;justify-content:center;background:#0ea5e9;color:#082f49;font-size:12px;font-weight:800}code{border-radius:4px;padding:1px 5px;background:#020617;color:#bfdbfe}pre{margin:8px 0 0;max-width:100%;overflow:auto;border:1px solid #334155;border-radius:6px;padding:12px;background:#020617;color:#dbeafe;font-size:13px;line-height:1.45}@keyframes spin{to{transform:rotate(360deg)}}@media(max-width:1040px){.viewer{grid-template-columns:1fr}}@media(max-width:800px){.memo-workspace{height:auto;min-height:calc(100vh - 130px);grid-template-columns:1fr}.memo-sidebar{max-height:250px;border-right:0;border-bottom:1px solid #374151}.memo-content{min-height:620px}}@media(max-width:640px){.app-header,.api-guide-header,.mode-tabs,.toolbar,.summary,.viewer,.memo-header,.memo-toolbar,.memo-editor,.memo-sidebar,.memo-stage-wrap{padding-left:12px;padding-right:12px}.header-main{gap:10px}.header-main .mode-tabs{gap:4px}.header-main .mode-tabs button{padding:0 8px}.api-guide-header{align-items:flex-start;flex-direction:column}.api-guide-content{width:calc(100vw - 24px)}.memo-header{align-items:flex-start;flex-direction:column}.slider-control,.slider-control input,.memo-sidebar-width-control,.memo-sidebar-width-control input{width:100%;min-width:0}.file-picker{flex-direction:column;align-items:flex-start}.git-folder,.git-nav,.git-nav select,.git-meta{width:100%;min-width:0}.summary{grid-template-columns:1fr 1fr}.text-diff-section{margin-left:12px;margin-right:12px}.text-diff-heading{flex-direction:column}.text-diff-heading label{width:100%;max-width:none;flex-basis:auto}}
