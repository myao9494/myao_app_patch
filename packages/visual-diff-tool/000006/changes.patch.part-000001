diff --git a/frontend/src/theme.css b/frontend/src/theme.css
new file mode 100644
index 0000000000000000000000000000000000000000..b7dc950124790bf9912e5527bf5b833d33baf8d7
--- /dev/null
+++ b/frontend/src/theme.css
@@ -0,0 +1,257 @@
+/**
+ * デザイントークン（色・文字・角丸・影）と基本スタイル。全画面で共通に使う。
+ * テーマはダークモード固定（CLAUDE.md の GUI 仕様）。差分の意味色は Backend のオーバーレイ色に合わせる:
+ *   削除（Aだけ）= 赤 / 追加（Bだけ）= 青 / 変更（両方）= 黄
+ */
+:root {
+  --bg: #0c0e13;
+  --surface-1: #13161d;
+  --surface-2: #191d26;
+  --surface-3: #212633;
+  --surface-hover: #262c3a;
+  --border: #252a36;
+  --border-strong: #353c4d;
+
+  --text: #e8ebf1;
+  --text-muted: #a1a9ba;
+  --text-faint: #6e7689;
+
+  --accent: #5b8cff;
+  --accent-strong: #4374f0;
+  --accent-soft: rgba(91, 140, 255, 0.14);
+  --accent-ring: rgba(91, 140, 255, 0.45);
+
+  --removed: #f2606b;
+  --added: #4d9dff;
+  --changed: #f5b53d;
+  --success: #3ccf8e;
+  --warning: #f5b53d;
+  --danger: #f2606b;
+
+  --radius-sm: 6px;
+  --radius: 10px;
+  --radius-lg: 14px;
+  --shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
+  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.25);
+
+  --font-sans: Inter, "Hiragino Sans", "Hiragino Kaku Gothic ProN", "Noto Sans JP", "Yu Gothic UI", "Meiryo", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
+  --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
+
+  font-family: var(--font-sans);
+  font-size: 14px;
+  line-height: 1.45;
+  color: var(--text);
+  background: var(--bg);
+  color-scheme: dark;
+  -webkit-font-smoothing: antialiased;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+body {
+  margin: 0;
+  background: var(--bg);
+}
+
+button,
+input,
+select,
+textarea {
+  font: inherit;
+  color: inherit;
+}
+
+:focus-visible {
+  outline: 2px solid var(--accent-ring);
+  outline-offset: 2px;
+}
+
+::selection {
+  background: rgba(91, 140, 255, 0.35);
+}
+
+/* スクロールバーを目立たせない（macOS 以外でも暗い背景になじませる） */
+* {
+  scrollbar-width: thin;
+  scrollbar-color: var(--border-strong) transparent;
+}
+
+kbd {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-width: 18px;
+  height: 18px;
+  padding: 0 5px;
+  border: 1px solid var(--border-strong);
+  border-bottom-width: 2px;
+  border-radius: 4px;
+  background: var(--surface-2);
+  color: var(--text-muted);
+  font: 600 11px/1 var(--font-mono);
+}
+
+/* ---- 共通部品 ---- */
+
+.btn {
+  min-height: 34px;
+  padding: 0 12px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 7px;
+  border: 1px solid var(--border-strong);
+  border-radius: var(--radius-sm);
+  background: var(--surface-2);
+  color: var(--text);
+  font-weight: 600;
+  white-space: nowrap;
+  cursor: pointer;
+  transition: background 0.12s, border-color 0.12s, color 0.12s;
+}
+
+.btn:hover:not(:disabled) {
+  background: var(--surface-hover);
+  border-color: #46506a;
+}
+
+.btn:disabled {
+  opacity: 0.45;
+  cursor: not-allowed;
+}
+
+.btn-primary {
+  border-color: transparent;
+  background: var(--accent);
+  color: #fff;
+}
+
+.btn-primary:hover:not(:disabled) {
+  background: var(--accent-strong);
+  border-color: transparent;
+}
+
+.btn-ghost {
+  border-color: transparent;
+  background: transparent;
+  color: var(--text-muted);
+}
+
+.btn-ghost:hover:not(:disabled) {
+  background: var(--surface-3);
+  border-color: transparent;
+  color: var(--text);
+}
+
+.btn-ghost.active {
+  background: var(--surface-3);
+  color: var(--text);
+}
+
+.btn-lg {
+  min-height: 42px;
+  padding: 0 18px;
+  font-size: 15px;
+  border-radius: var(--radius);
+}
+
+.btn-icon {
+  width: 34px;
+  padding: 0;
+}
+
+.segmented {
+  display: inline-flex;
+  padding: 3px;
+  gap: 2px;
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  background: var(--surface-1);
+}
+
+.segmented button {
+  min-height: 28px;
+  padding: 0 11px;
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  border: 0;
+  border-radius: 7px;
+  background: transparent;
+  color: var(--text-muted);
+  font-weight: 600;
+  white-space: nowrap;
+  cursor: pointer;
+}
+
+.segmented button:hover:not(:disabled) {
+  color: var(--text);
+  background: var(--surface-3);
+}
+
+.segmented button.active {
+  background: var(--surface-3);
+  color: var(--text);
+  box-shadow: inset 0 0 0 1px var(--border-strong), var(--shadow-sm);
+}
+
+.segmented button:disabled {
+  opacity: 0.4;
+  cursor: not-allowed;
+}
+
+.field {
+  display: grid;
+  gap: 6px;
+}
+
+.field > span,
+.field-label {
+  color: var(--text-muted);
+  font-size: 12px;
+  font-weight: 600;
+}
+
+.input,
+.field input[type="text"],
+.field select,
+.field textarea {
+  min-height: 34px;
+  padding: 0 10px;
+  border: 1px solid var(--border-strong);
+  border-radius: var(--radius-sm);
+  background: var(--surface-2);
+  color: var(--text);
+}
+
+.field textarea {
+  padding: 8px 10px;
+  resize: vertical;
+}
+
+input[type="range"] {
+  accent-color: var(--accent);
+}
+
+.badge {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  height: 20px;
+  padding: 0 7px;
+  border-radius: 999px;
+  background: var(--surface-3);
+  color: var(--text-muted);
+  font-size: 11px;
+  font-weight: 700;
+  white-space: nowrap;
+}
+
+.badge.modified { background: rgba(245, 181, 61, 0.16); color: #f8c96a; }
+.badge.added,
+.badge.untracked { background: rgba(60, 207, 142, 0.16); color: #63dba6; }
+.badge.deleted { background: rgba(242, 96, 107, 0.16); color: #f58790; }
+.badge.renamed,
+.badge.copied { background: var(--accent-soft); color: #8fb0ff; }
