new file mode 100644
index 0000000000000000000000000000000000000000..6b6a646f78dbcb7ed94eea46300d94c7705c9a0a
--- /dev/null
+++ b/backend/app/mesh_diff.py
@@ -0,0 +1,472 @@
+"""
+3Dメッシュ差分の中核ロジック（位置合わせ・細分化・距離算出・バイナリ入出力）。
+- 位置合わせ（新メッシュを旧メッシュの座標系へ移す4x4行列を求める）:
+  - auto    : 元座標で一致率が高ければ動かさない。低ければ fit を実施し、良くなった場合のみ採用
+  - none    : 動かさない（大きくずれていれば警告）
+  - centroid: 面積重心を合わせる平行移動のみ
+  - fit     : 面積重心＋慣性主軸の24通りの姿勢候補 → トリム付きICP（変更部分の影響を除外）
+- 細分化（refine_mesh）: 辺長上限（max_edge）を超える三角形を分割し、解像度を確保（頂点数上限を設定）
+- 差分算出（compute_mesh_diff）: 各頂点から相手メッシュ表面への最短距離を計算
+- バイナリ形式（VDM1）: メッシュ座標・面インデックス・頂点距離をWebフロントエンドと高速にやり取り
+trimesh / scipy / rtree に依存する（requirements-3d.txt）。
+"""
+
+from __future__ import annotations
+
+import itertools
+import json
+import math
+import struct
+from dataclasses import dataclass, field
+from typing import Callable
+
+import numpy as np
+
+ALIGN_MODES = ("auto", "none", "centroid", "fit")
+IDENTITY_ACCEPT_RATIO = 0.6  # 元座標の一致率がこれ以上なら「同じ座標系で作られた版違い」とみなす
+SCORE_SAMPLES = 3000
+PCA_SAMPLES = 20000
+COARSE_SAMPLES = 1500
+COARSE_ITERATIONS = 15
+FINE_ITERATIONS = 60
+TRIM_PERCENTILE = 85.0
+SCALE_FACTORS = (25.4, 304.8, 1000.0, 100.0, 10.0)
+
+
+@dataclass
+class AlignmentResult:
+    matrix: np.ndarray  # 新メッシュへ適用する4x4変換
+    applied: str  # identity / centroid / fit
+    inlier_ratio: float
+    rms: float
+    identity_inlier_ratio: float
+    translation: list[float] = field(default_factory=lambda: [0.0, 0.0, 0.0])
+    rotation_deg: float = 0.0
+    warnings: list[str] = field(default_factory=list)
+
+
+@dataclass
+class DiffMeshSide:
+    vertices: np.ndarray  # (N, 3) float64 または float32
+    faces: np.ndarray  # (M, 3) int64 または uint32
+    distances: np.ndarray  # (N,) float64 または float32
+
+
+@dataclass
+class MeshDiffResult:
+    old: DiffMeshSide
+    new: DiffMeshSide
+    alignment: AlignmentResult
+    tolerance: float
+    warnings: list[str] = field(default_factory=list)
+
+
+def scale_mismatch_warning(reference_extents, moving_extents) -> str | None:
+    """寸法比が単位換算係数に近ければ警告文を返す。"""
+    ref = float(np.linalg.norm(reference_extents))
+    mov = float(np.linalg.norm(moving_extents))
+    if ref <= 0 or mov <= 0:
+        return None
+    ratio = max(ref, mov) / min(ref, mov)
+    for factor in SCALE_FACTORS:
+        if abs(math.log(ratio) - math.log(factor)) < math.log(1.05):
+            return (
+                f"新旧の寸法比が約{factor:g}倍です。長さ単位の不一致（mm / inch / m など）の可能性があります。"
+                "スケールは自動補正していません。"
+            )
+    return None
+
+
+def area_centroid(mesh) -> np.ndarray:
+    """三角形の面積で重み付けした表面重心（水密でないメッシュでも定義できる）。"""
+    areas = np.asarray(mesh.area_faces)
+    total = float(areas.sum())
+    if total <= 0:
+        return np.asarray(mesh.vertices).mean(axis=0)
+    return (np.asarray(mesh.triangles_center) * areas[:, None]).sum(axis=0) / total
+
+
+def align_meshes(reference, moving, *, mode: str = "auto", tolerance: float) -> AlignmentResult:
+    """moving（新）を reference（旧）へ重ねる変換を求める。"""
+    if mode not in ALIGN_MODES:
+        raise ValueError(f"未知の位置合わせモードです: {mode}（{' / '.join(ALIGN_MODES)}）")
+    diag = float(max(np.linalg.norm(reference.extents), np.linalg.norm(moving.extents), 1e-9))
+    inlier_tol = max(3.0 * float(tolerance), diag * 0.002)
+    warnings: list[str] = []
+
+    identity = np.eye(4)
+    identity_ratio, identity_rms = _symmetric_score(reference, moving, identity, inlier_tol)
+
+    if mode == "none":
+        if identity_ratio < IDENTITY_ACCEPT_RATIO:
+            warnings.append(
+                f"元座標のままでは形状が大きくずれています（一致率 {identity_ratio:.0%}）。"
+                "位置合わせモード「自動」を検討してください。"
+            )
+        return AlignmentResult(identity, "identity", identity_ratio, identity_rms, identity_ratio, warnings=warnings)
+
+    if mode == "auto" and identity_ratio >= IDENTITY_ACCEPT_RATIO:
+        return AlignmentResult(identity, "identity", identity_ratio, identity_rms, identity_ratio)
+
+    if mode == "centroid":
+        matrix = np.eye(4)
+        matrix[:3, 3] = area_centroid(reference) - area_centroid(moving)
+        applied = "centroid"
+    else:
+        matrix = _fit_transform(reference, moving, inlier_tol)
+        applied = "fit"
+
+    ratio, rms = _symmetric_score(reference, moving, matrix, inlier_tol)
+    if mode == "auto" and ratio <= identity_ratio:
+        warnings.append(f"自動位置合わせで一致率が改善しなかったため、元座標のまま比較します（一致率 {identity_ratio:.0%}）。")
+        return AlignmentResult(identity, "identity", identity_ratio, identity_rms, identity_ratio, warnings=warnings)
+
+    translation = [float(v) for v in matrix[:3, 3]]
+    rotation_deg = _rotation_angle_deg(matrix[:3, :3])
+    warnings.append(
+        "原点または向きが異なるため、新版を自動で位置合わせしました"
+        f"（平行移動 {translation[0]:.3f}, {translation[1]:.3f}, {translation[2]:.3f} mm / 回転 {rotation_deg:.2f}°、"
+        f"一致率 {ratio:.0%}）。"
+    )
+    if ratio < IDENTITY_ACCEPT_RATIO:
+        warnings.append(f"位置合わせ後も一致率が低いです（{ratio:.0%}）。形状が大きく異なるか、位置合わせに失敗した可能性があります。")
+    return AlignmentResult(matrix, applied, ratio, rms, identity_ratio, translation, rotation_deg, warnings)
+
+
+def _samples(mesh, count: int) -> np.ndarray:
+    import trimesh
+
+    points, _ = trimesh.sample.sample_surface(mesh, count, seed=0)
+    return np.asarray(points, dtype=np.float64)
+
+
+def _transform_points(points: np.ndarray, matrix: np.ndarray) -> np.ndarray:
+    return points @ matrix[:3, :3].T + matrix[:3, 3]
+
+
+def _surface_distance(mesh, points: np.ndarray) -> np.ndarray:
+    import trimesh
+
+    _, distance, _ = trimesh.proximity.closest_point(mesh, points)
+    return np.asarray(distance, dtype=np.float64)
+
+
+def _symmetric_score(reference, moving, matrix: np.ndarray, inlier_tol: float) -> tuple[float, float]:
+    """双方向の一致率と、一致点のRMS距離を返す。"""
+    moving_points = _transform_points(_samples(moving, SCORE_SAMPLES), matrix)
+    forward = _surface_distance(reference, moving_points)
+    inverse = np.linalg.inv(matrix)
+    reference_points = _transform_points(_samples(reference, SCORE_SAMPLES), inverse)
+    backward = _surface_distance(moving, reference_points)
+    distances = np.concatenate([forward, backward])
+    inliers = distances <= inlier_tol
+    ratio = float(inliers.mean())
+    rms = float(np.sqrt(np.mean(distances[inliers] ** 2))) if inliers.any() else float("inf")
+    return ratio, rms
+
+
+def _kabsch(source: np.ndarray, target: np.ndarray) -> np.ndarray:
+    """source を target へ重ねる剛体変換（4x4）を最小二乗で求める。"""
+    source_center = source.mean(axis=0)
+    target_center = target.mean(axis=0)
+    h = (source - source_center).T @ (target - target_center)
+    u, _, vt = np.linalg.svd(h)
+    d = np.sign(np.linalg.det(vt.T @ u.T)) or 1.0
+    rotation = vt.T @ np.diag([1.0, 1.0, d]) @ u.T
+    matrix = np.eye(4)
+    matrix[:3, :3] = rotation
+    matrix[:3, 3] = target_center - rotation @ source_center
+    return matrix
+
+
+def _rotation_angle_deg(rotation: np.ndarray) -> float:
+    cos_angle = (np.trace(rotation) - 1.0) / 2.0
+    return float(math.degrees(math.acos(min(1.0, max(-1.0, cos_angle)))))
+
+
+def _signed_permutations() -> list[np.ndarray]:
+    """行列式+1の符号付き置換行列（立方体の回転群、24通り）。"""
+    matrices = []
+    for perm in itertools.permutations(range(3)):
+        for signs in itertools.product((1.0, -1.0), repeat=3):
+            matrix = np.zeros((3, 3))
+            for row, col in enumerate(perm):
+                matrix[row, col] = signs[row]
+            if np.linalg.det(matrix) > 0:
+                matrices.append(matrix)
+    return matrices
+
+
+def _principal_axes(points: np.ndarray, center: np.ndarray) -> np.ndarray:
+    centered = points - center
+    _, vectors = np.linalg.eigh(centered.T @ centered)
+    axes = vectors[:, ::-1]  # 分散の大きい順
+    if np.linalg.det(axes) < 0:
+        axes[:, 2] *= -1
+    return axes
+
+
+def _trimmed_icp(source: np.ndarray, matrix: np.ndarray, nearest, iterations: int) -> tuple[np.ndarray, float]:
+    """トリム付きICP。nearest(points) は (対応点, 距離) を返す。距離上位の対応は除外する。"""
+    score = float("inf")
+    for _ in range(iterations):
+        moved = _transform_points(source, matrix)
+        targets, distances = nearest(moved)
+        keep = distances <= np.percentile(distances, TRIM_PERCENTILE)
+        if keep.sum() < 6:
+            break
+        step = _kabsch(moved[keep], targets[keep])
+        matrix = step @ matrix
+        score = float(np.mean(distances[keep]))
+        if np.linalg.norm(step[:3, 3]) < 1e-9 and _rotation_angle_deg(step[:3, :3]) < 1e-7:
+            break
+    return matrix, score
+
+
+def _fit_transform(reference, moving, inlier_tol: float) -> np.ndarray:
+    import trimesh
+    from scipy.spatial import cKDTree
+
+    reference_dense = _samples(reference, PCA_SAMPLES)
+    moving_dense = _samples(moving, PCA_SAMPLES)
+    reference_center = area_centroid(reference)
+    moving_center = area_centroid(moving)
+    reference_axes = _principal_axes(reference_dense, reference_center)
+    moving_axes = _principal_axes(moving_dense, moving_center)
+
+    tree = cKDTree(reference_dense)
+
+    def coarse_nearest(points: np.ndarray):
+        distances, indices = tree.query(points)
+        return reference_dense[indices], distances
+
+    coarse_source = moving_dense[:: max(1, PCA_SAMPLES // COARSE_SAMPLES)]
+    best_matrix, best_score = np.eye(4), float("inf")
+    # 主軸の向き（符号・順序）は形状だけでは一意に決まらないため24通りを試す
+    for permutation in _signed_permutations():
+        rotation = reference_axes @ permutation @ moving_axes.T
+        candidate = np.eye(4)
+        candidate[:3, :3] = rotation
+        candidate[:3, 3] = reference_center - rotation @ moving_center
+        candidate, score = _trimmed_icp(coarse_source, candidate, coarse_nearest, COARSE_ITERATIONS)
+        if score < best_score:
+            best_matrix, best_score = candidate, score
+
+    # 仕上げ: 参照メッシュ表面上の厳密な最近傍点で収束させる
+    fine_source = _samples(moving, SCORE_SAMPLES)
+
+    def exact_nearest(points: np.ndarray):
+        closest, distances, _ = trimesh.proximity.closest_point(reference, points)
+        return np.asarray(closest), np.asarray(distances)
+
+    matrix, _ = _trimmed_icp(fine_source, best_matrix, exact_nearest, FINE_ITERATIONS)
+    return matrix
+
+
+def refine_mesh(
+    vertices: np.ndarray,
+    faces: np.ndarray,
+    *,
+    max_edge: float,
+    max_vertices: int = 1_000_000,
+    max_iter: int = 25,
+) -> tuple[np.ndarray, np.ndarray]:
+    """辺長が max_edge を超える三角形を分割し、解像度を向上させる。"""
+    import trimesh
+
+    vertices = np.array(vertices, dtype=np.float64, copy=True)
+    faces = np.array(faces, dtype=np.int64, copy=True)
+
+    for _ in range(max_iter):
+        edges = np.sort(trimesh.remesh.faces_to_edges(faces), axis=1)
+        unique, inverse = trimesh.grouping.unique_rows(edges)
+        edges_unique = edges[unique]
+        lengths = np.linalg.norm(
+            vertices[edges_unique[:, 0], :3] - vertices[edges_unique[:, 1], :3], axis=1
+        )
+        long_edge = lengths > max_edge
+        if not long_edge.any():
+            break
+        num_new = int(long_edge.sum())
+        if len(vertices) + num_new > max_vertices:
+            break
+
+        midpoint = np.full(len(unique), -1, dtype=np.int64)
+        midpoint[long_edge] = np.arange(num_new) + len(vertices)
+        vertices = np.vstack((vertices, vertices[edges_unique[long_edge]].mean(axis=1)))
+
+        face_mid = midpoint[inverse].reshape((-1, 3))
+        split = face_mid >= 0
+        count = split.sum(axis=1)
+
+        keep = count == 0
+        faces_keep = faces[keep]
+
+        one = count == 1
+        j = np.argmax(split[one], axis=1)
+        r = np.arange(len(j))
+        f1, mid1 = faces[one], face_mid[one]
+        a, b, c = f1[r, j], f1[r, (j + 1) % 3], f1[r, (j + 2) % 3]
+        p = mid1[r, j]
+        faces_one = np.column_stack((a, p, c, p, b, c)).reshape((-1, 3))
+
+        two = count == 2
+        j = (np.argmin(split[two], axis=1) + 1) % 3
+        r = np.arange(len(j))
+        f2, mid2 = faces[two], face_mid[two]
+        a, b, c = f2[r, j], f2[r, (j + 1) % 3], f2[r, (j + 2) % 3]
+        p, q = mid2[r, j], mid2[r, (j + 1) % 3]
+        use_aq = (
+            ((vertices[a, :3] - vertices[q, :3]) ** 2).sum(axis=1)
+            <= ((vertices[p, :3] - vertices[c, :3]) ** 2).sum(axis=1)
+        )[:, None]
+        corner = np.column_stack((p, b, q))
+        quad_a = np.where(use_aq, np.column_stack((a, p, q)), np.column_stack((a, p, c)))
+        quad_b = np.where(use_aq, np.column_stack((a, q, c)), np.column_stack((p, q, c)))
+        faces_two = np.vstack((corner, quad_a, quad_b))
+
+        three = count == 3
+        f3, mid3 = faces[three], face_mid[three]
+        v0, v1, v2 = f3.T
+        m0, m1, m2 = mid3.T
+        faces_three = np.column_stack(
+            (v0, m0, m2, m0, v1, m1, m2, m1, v2, m0, m1, m2)
+        ).reshape((-1, 3))
+
+        faces = np.vstack((faces_keep, faces_one, faces_two, faces_three)).astype(np.int64)
+
+    return vertices, faces
+
+
+def compute_mesh_diff(
+    old_vertices: np.ndarray,
+    old_faces: np.ndarray,
+    new_vertices: np.ndarray,
+    new_faces: np.ndarray,
+    *,
+    tolerance: float = 0.05,
+    align_mode: str = "auto",
+    max_edge: float | None = None,
+    max_vertices: int = 1_000_000,
+    progress: Callable[[str, float], None] | None = None,
+) -> MeshDiffResult:
+    """旧メッシュと新メッシュを位置合わせし、相手表面までの最短距離を計算する。"""
+    import trimesh
+
+    report = progress or (lambda stage, val: None)
+    warnings: list[str] = []
+
+    old_mesh_raw = trimesh.Trimesh(vertices=old_vertices, faces=old_faces, process=False)
+    new_mesh_raw = trimesh.Trimesh(vertices=new_vertices, faces=new_faces, process=False)
+
+    scale_warning = scale_mismatch_warning(old_mesh_raw.extents, new_mesh_raw.extents)
+    if scale_warning:
+        warnings.append(scale_warning)
+
+    report("位置合わせの計算中", 0.15)
+    alignment = align_meshes(old_mesh_raw, new_mesh_raw, mode=align_mode, tolerance=tolerance)
+    warnings.extend(alignment.warnings)
+
+    new_vertices_aligned = _transform_points(new_vertices, alignment.matrix)
+
+    diag = float(max(np.linalg.norm(old_mesh_raw.extents), np.linalg.norm(new_mesh_raw.extents), 1e-9))
+    target_max_edge = max_edge if max_edge is not None else max(diag * 0.05, 1e-3)
+
+    if target_max_edge > 0:
+        report("旧メッシュの細分化中", 0.35)
+        old_v_refined, old_f_refined = refine_mesh(old_vertices, old_faces, max_edge=target_max_edge, max_vertices=max_vertices)
+        report("新メッシュの細分化中", 0.50)
+        new_v_refined, new_f_refined = refine_mesh(new_vertices_aligned, new_faces, max_edge=target_max_edge, max_vertices=max_vertices)
+    else:
+        old_v_refined, old_f_refined = old_vertices, old_faces
+        new_v_refined, new_f_refined = new_vertices_aligned, new_faces
+
+    # 相手メッシュへの最近傍距離計算
+    old_mesh_for_dist = trimesh.Trimesh(vertices=old_vertices, faces=old_faces, process=False)
+    new_mesh_for_dist = trimesh.Trimesh(vertices=new_vertices_aligned, faces=new_faces, process=False)
+
+    report("旧メッシュの距離を計算中", 0.65)
+    _, old_distances, _ = trimesh.proximity.closest_point(new_mesh_for_dist, old_v_refined)
+
+    report("新メッシュの距離を計算中", 0.85)
+    _, new_distances, _ = trimesh.proximity.closest_point(old_mesh_for_dist, new_v_refined)
+
+    report("差分計算完了", 1.0)
+
+    old_side = DiffMeshSide(
+        vertices=np.asarray(old_v_refined, dtype=np.float64),
+        faces=np.asarray(old_f_refined, dtype=np.int64),
+        distances=np.asarray(old_distances, dtype=np.float64),
+    )
+    new_side = DiffMeshSide(
+        vertices=np.asarray(new_v_refined, dtype=np.float64),
+        faces=np.asarray(new_f_refined, dtype=np.int64),
+        distances=np.asarray(new_distances, dtype=np.float64),
+    )
+
+    return MeshDiffResult(
+        old=old_side,
+        new=new_side,
+        alignment=alignment,
+        tolerance=tolerance,
+        warnings=warnings,
+    )
+
+
+def pack_mesh_binary(
+    vertices: np.ndarray,
+    faces: np.ndarray,
+    distances: np.ndarray,
+    meta: dict | None = None,
+) -> bytes:
+    """メッシュデータ（頂点、面、頂点距離）をVDM1バイナリ形式にパックする。"""
+    vertices = np.ascontiguousarray(vertices, dtype=np.float32).reshape(-1, 3)
+    faces = np.ascontiguousarray(faces, dtype=np.uint32).reshape(-1, 3)
+    distances = np.ascontiguousarray(distances, dtype=np.float32).reshape(-1)
+
+    header = dict(meta or {})
+    header["vertex_count"] = int(len(vertices))
+    header["face_count"] = int(len(faces))
+
+    json_bytes = json.dumps(header, ensure_ascii=False).encode("utf-8")
+    json_len = len(json_bytes)
+    pad_len = (4 - (json_len % 4)) % 4
+
+    header_block = struct.pack("<4sI", b"VDM1", json_len) + json_bytes + (b"\x00" * pad_len)
+    pos_bytes = vertices.tobytes()
+    idx_bytes = faces.tobytes()
+    dist_bytes = distances.tobytes()
+
+    return header_block + pos_bytes + idx_bytes + dist_bytes
+
+
+def unpack_mesh_binary(data: bytes) -> dict:
+    """VDM1バイナリ形式からメッシュデータを復元する。"""
+    if len(data) < 8 or data[:4] != b"VDM1":
+        raise ValueError("有効なVDM1バイナリ形式ではありません。")
+    magic, json_len = struct.unpack_from("<4sI", data, 0)
+    json_bytes = data[8 : 8 + json_len]
+    header = json.loads(json_bytes.decode("utf-8"))
+    pad_len = (4 - (json_len % 4)) % 4
+    offset = 8 + json_len + pad_len
+
+    v_count = header["vertex_count"]
+    f_count = header["face_count"]
+
+    pos_size = v_count * 3 * 4
+    positions = np.frombuffer(data[offset : offset + pos_size], dtype=np.float32).reshape(-1, 3)
+    offset += pos_size
+
+    idx_size = f_count * 3 * 4
+    indices = np.frombuffer(data[offset : offset + idx_size], dtype=np.uint32).reshape(-1, 3)
+    offset += idx_size
+
+    dist_size = v_count * 4
+    distances = np.frombuffer(data[offset : offset + dist_size], dtype=np.float32)
+
+    return {
+        "header": header,
+        "positions": positions,
+        "indices": indices,
+        "distances": distances,
+    }
diff --git a/backend/app/mesh_jobs.py b/backend/app/mesh_jobs.py
new file mode 100644
index 0000000000000000000000000000000000000000..7b7df235975d6cdfb0699aa4e5982c32e9648224
--- /dev/null
+++ b/backend/app/mesh_jobs.py
@@ -0,0 +1,357 @@
+"""
+3Dメッシュ差分 非同期ジョブマネージャー仕様。
+- 重いSTEP解析・テッセレーション・距離計算を子プロセス（multiprocessing.Process）で分離実行
+- アップロードされたSTEPファイルはメッシュ化完了直後に削除
+- 計算結果（VDM1バイナリおよびステータスJSON）は一時保存ディレクトリに保持（デフォルト60分）
+- 有効期限切れジョブの自動クリーンアップおよび起動時の孤立ディレクトリ削除を提供
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import multiprocessing as mp
+import os
+import shutil
+import tempfile
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+from uuid import uuid4
+
+DEFAULT_RETENTION_MINUTES = 60
+REQUIRED_MODULES = ("OCP", "trimesh", "scipy", "rtree")
+
+
+def check_3d_availability() -> dict:
+    """3D差分に必要なライブラリが環境に揃っているかを検査する。"""
+    missing = [name for name in REQUIRED_MODULES if importlib.util.find_spec(name) is None]
+    available = len(missing) == 0
+    return {
+        "available": available,
+        "missing": missing,
+        "install_hint": ".venv/bin/python -m pip install -r requirements-3d.txt",
+    }
+
+
+def _worker_entrypoint(
+    job_dir_str: str,
+    old_step_str: str,
+    new_step_str: str,
+    old_filename: str,
+    new_filename: str,
+    quality: str,
+    align_mode: str,
+    linear_deflection: float | None,
+) -> None:
+    """子プロセス内で実行されるジョブワーカー。"""
+    job_dir = Path(job_dir_str)
+    status_file = job_dir / "status.json"
+    old_step_path = Path(old_step_str)
+    new_step_path = Path(new_step_str)
+
+    def write_status(data: dict) -> None:
+        tmp = job_dir / f"status_{uuid4().hex}.tmp"
+        tmp.write_text(json.dumps(data, ensure_ascii=False), encoding="utf-8")
+        tmp.replace(status_file)
+
+    try:
+        from .mesh_diff import compute_mesh_diff, pack_mesh_binary
+        from .step_mesh import StepConversionError, load_step_pair_as_meshes
+
+        # 段階1: STEP読み込みとメッシュ化
+        def on_step_progress(stage: str, fraction: float) -> None:
+            write_status({
+                "status": "running",
+                "stage": stage,
+                "progress": round(fraction * 0.45, 3),
+                "warnings": [],
+                "error": None,
+                "stats": None,
+            })
+
+        pair = load_step_pair_as_meshes(
+            old_step_path,
+            new_step_path,
+            quality=quality,
+            linear_deflection=linear_deflection,
+            progress=on_step_progress,
+            old_label=old_filename,
+            new_label=new_filename,
+        )
+
+        # 変換完了直後に元STEPファイルを削除（容量削減・機密保護）
+        old_step_path.unlink(missing_ok=True)
+        new_step_path.unlink(missing_ok=True)
+
+        # 段階2 & 3: 位置合わせと距離算出
+        def on_diff_progress(stage: str, fraction: float) -> None:
+            write_status({
+                "status": "running",
+                "stage": stage,
+                "progress": round(0.45 + fraction * 0.50, 3),
+                "warnings": pair.warnings,
+                "error": None,
+                "stats": None,
+            })
+
+        diff_result = compute_mesh_diff(
+            pair.old.vertices,
+            pair.old.faces,
+            pair.new.vertices,
+            pair.new.faces,
+            tolerance=pair.linear_deflection,
+            align_mode=align_mode,
+            progress=on_diff_progress,
+        )
+
+        # バイナリ保存（VDM1）
+        old_meta = {
+            "side": "old",
+            "filename": old_filename,
+            "unit": pair.old.unit,
+            "solid_count": pair.old.solid_count,
+        }
+        new_meta = {
+            "side": "new",
+            "filename": new_filename,
+            "unit": pair.new.unit,
+            "solid_count": pair.new.solid_count,
+        }
+        old_bin = pack_mesh_binary(diff_result.old.vertices, diff_result.old.faces, diff_result.old.distances, old_meta)
+        new_bin = pack_mesh_binary(diff_result.new.vertices, diff_result.new.faces, diff_result.new.distances, new_meta)
+        (job_dir / "old_mesh.vdm1").write_bytes(old_bin)
+        (job_dir / "new_mesh.vdm1").write_bytes(new_bin)
+
+        # 完了ステータスの記録
+        all_warnings = list(pair.warnings) + list(diff_result.warnings)
+        stats = {
+            "linear_deflection": pair.linear_deflection,
+            "angular_deflection": pair.angular_deflection,
+            "alignment": {
+                "matrix": diff_result.alignment.matrix.tolist(),
+                "applied": diff_result.alignment.applied,
+                "inlier_ratio": float(diff_result.alignment.inlier_ratio),
+                "rms": float(diff_result.alignment.rms),
+                "translation": diff_result.alignment.translation,
+                "rotation_deg": float(diff_result.alignment.rotation_deg),
+            },
+            "old": {
+                "vertex_count": int(len(diff_result.old.vertices)),
+                "face_count": int(len(diff_result.old.faces)),
+                "unit": pair.old.unit,
+                "solid_count": pair.old.solid_count,
+            },
+            "new": {
+                "vertex_count": int(len(diff_result.new.vertices)),
+                "face_count": int(len(diff_result.new.faces)),
+                "unit": pair.new.unit,
+                "solid_count": pair.new.solid_count,
+            },
+        }
+        write_status({
+            "status": "done",
+            "stage": "完了",
+            "progress": 1.0,
+            "warnings": all_warnings,
+            "error": None,
+            "stats": stats,
+            "finished_at": datetime.now(timezone.utc).isoformat(),
+        })
+
+    except StepConversionError as exc:
+        old_step_path.unlink(missing_ok=True)
+        new_step_path.unlink(missing_ok=True)
+        write_status({
+            "status": "error",
+            "stage": "エラー",
+            "progress": 0.0,
+            "warnings": [],
+            "error": str(exc),
+            "stats": None,
+            "finished_at": datetime.now(timezone.utc).isoformat(),
+        })
+    except Exception as exc:
+        old_step_path.unlink(missing_ok=True)
+        new_step_path.unlink(missing_ok=True)
+        write_status({
+            "status": "error",
+            "stage": "エラー",
+            "progress": 0.0,
+            "warnings": [],
+            "error": f"3D差分処理中にエラーが発生しました: {exc}",
+            "stats": None,
+            "finished_at": datetime.now(timezone.utc).isoformat(),
+        })
+
+
+class MeshDiffJobManager:
+    """3D差分ジョブのライフサイクルおよび一時ファイルの保持・削除を管理する。"""
+
+    def __init__(self, base_dir: Path | None = None, retention_minutes: int | None = None):
+        if base_dir is None:
+            self.base_dir = Path(__file__).resolve().parents[1] / ".mesh_jobs"
+        else:
+            self.base_dir = Path(base_dir)
+        self.base_dir.mkdir(parents=True, exist_ok=True)
+
+        if retention_minutes is not None:
+            self.retention_minutes = int(retention_minutes)
+        else:
+            env_val = os.environ.get("VISUAL_DIFF_3D_RETENTION_MINUTES")
+            self.retention_minutes = int(env_val) if env_val else DEFAULT_RETENTION_MINUTES
+
+        self._processes: dict[str, mp.Process] = {}
+        # 起動時に以前の実行で残った孤立ジョブを全削除する
+        self._cleanup_all_on_startup()
+
+    def _cleanup_all_on_startup(self) -> None:
+        if not self.base_dir.exists():
+            return
+        for item in self.base_dir.iterdir():
+            if item.is_dir():
+                shutil.rmtree(item, ignore_errors=True)
+
+    def job_dir(self, job_id: str) -> Path:
+        return self.base_dir / job_id
+
+    def create_job(
+        self,
+        old_filename: str,
+        old_content: bytes,
+        new_filename: str,
+        new_content: bytes,
+        *,
+        quality: str = "standard",
+        align_mode: str = "auto",
+        linear_deflection: float | None = None,
+    ) -> str:
+        """新しい差分ジョブを作成し、子プロセスで実行を開始する。"""
+        self.cleanup_expired()
+        job_id = uuid4().hex
+        j_dir = self.job_dir(job_id)
+        j_dir.mkdir(parents=True, exist_ok=True)
+
+        old_step_path = j_dir / f"input_old_{uuid4().hex[:8]}.step"
+        new_step_path = j_dir / f"input_new_{uuid4().hex[:8]}.step"
+        old_step_path.write_bytes(old_content)
+        new_step_path.write_bytes(new_content)
+
+        initial_status = {
+            "status": "running",
+            "stage": "ジョブ開始",
+            "progress": 0.0,
+            "warnings": [],
+            "error": None,
+            "stats": None,
+            "created_at": datetime.now(timezone.utc).isoformat(),
+        }
+        (j_dir / "status.json").write_text(json.dumps(initial_status, ensure_ascii=False), encoding="utf-8")
+
+        proc = mp.Process(
+            target=_worker_entrypoint,
+            args=(
+                str(j_dir),
+                str(old_step_path),
+                str(new_step_path),
+                old_filename,
+                new_filename,
+                quality,
+                align_mode,
+                linear_deflection,
+            ),
+            daemon=True,
+        )
+        proc.start()
+        self._processes[job_id] = proc
+        return job_id
+
+    def get_status(self, job_id: str) -> dict | None:
+        """ジョブの現在のステータスを返す。存在しない場合はNone。"""
+        j_dir = self.job_dir(job_id)
+        status_file = j_dir / "status.json"
+        if not status_file.exists():
+            return None
+        try:
+            data = json.loads(status_file.read_text(encoding="utf-8"))
+        except Exception:
+            return None
+
+        # プロセスが予期せず終了したか検査
+        if data.get("status") == "running":
+            proc = self._processes.get(job_id)
+            if proc and not proc.is_alive() and proc.exitcode != 0:
+                data["status"] = "error"
+                data["error"] = f"3D差分処理プロセスが異常終了しました（終了コード: {proc.exitcode}）。"
+                data["finished_at"] = datetime.now(timezone.utc).isoformat()
+                status_file.write_text(json.dumps(data, ensure_ascii=False), encoding="utf-8")
+
+        data["job_id"] = job_id
+        data["retention_minutes"] = self.retention_minutes
+        return data
+
+    def get_mesh_binary(self, job_id: str, side: str) -> bytes | None:
+        """指定側のVDM1バイナリを取得する。"""
+        if side not in ("old", "new"):
+            return None
+        bin_path = self.job_dir(job_id) / f"{side}_mesh.vdm1"
+        if not bin_path.exists():
+            return None
+        return bin_path.read_bytes()
+
+    def delete_job(self, job_id: str) -> bool:
+        """ジョブのファイルおよびプロセスを破棄する。"""
+        proc = self._processes.pop(job_id, None)
+        if proc and proc.is_alive():
+            proc.terminate()
+        j_dir = self.job_dir(job_id)
+        if j_dir.exists():
+            shutil.rmtree(j_dir, ignore_errors=True)
+            return True
+        return False
+
+    def cleanup_expired(self) -> int:
+        """保持期間を経過したジョブを削除する。"""
+        cutoff = datetime.now(timezone.utc) - timedelta(minutes=self.retention_minutes)
+        removed = 0
+        if not self.base_dir.exists():
+            return removed
+
+        for j_dir in list(self.base_dir.iterdir()):
+            if not j_dir.is_dir():
+                continue
+            status_file = j_dir / "status.json"
+            should_remove = False
+            if status_file.exists():
+                try:
+                    data = json.loads(status_file.read_text(encoding="utf-8"))
+                    ts_str = data.get("finished_at") or data.get("created_at")
+                    if ts_str:
+                        ts = datetime.fromisoformat(ts_str)
+                        if ts < cutoff:
+                            should_remove = True
+                except Exception:
+                    should_remove = True
+            else:
+                should_remove = True
+
+            if should_remove:
+                self.delete_job(j_dir.name)
+                removed += 1
+        return removed
+
+    def register_finished_job_for_test(self, finished_at: datetime) -> str:
+        """テスト用: 終了済みジョブを直接生成する。"""
+        job_id = uuid4().hex
+        j_dir = self.job_dir(job_id)
+        j_dir.mkdir(parents=True, exist_ok=True)
+        status = {
+            "status": "done",
+            "stage": "完了",
+            "progress": 1.0,
+            "warnings": [],
+            "error": None,
+            "stats": {},
+            "finished_at": finished_at.isoformat(),
+        }
+        (j_dir / "status.json").write_text(json.dumps(status, ensure_ascii=False), encoding="utf-8")
+        return job_id
diff --git a/backend/app/step_mesh.py b/backend/app/step_mesh.py
new file mode 100644
index 0000000000000000000000000000000000000000..7d347eb660e4143ca9354952ebad82973286ae38
--- /dev/null
+++ b/backend/app/step_mesh.py
@@ -0,0 +1,282 @@
+"""
+STEPファイルを三角形メッシュへ変換するモジュール（3D差分 段階1）。
+- OCP（OpenCASCADE）の STEPControl_Reader で読み込み、OCCTの設定によりmmへ換算する
+- STEPヘッダの GLOBAL_UNIT_ASSIGNED_CONTEXT などから元の長さ単位を検出し、新旧で違えば警告する
+- 新旧2ファイルに同じ線形許容差（テッセレーション精度）を適用する（精度が違うと同じ形状でも差分が出るため）
+- 失敗時は「旧ファイル(名前): 原因」の形式の StepConversionError を送出する
+OCPは重いため、このモジュールは3D差分の処理内（子プロセス）でのみimportする。
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Callable
+
+import numpy as np
+
+# 品質プリセット: 線形許容差 = 2モデルのバウンディングボックス対角長(最大) × 比率
+QUALITY_RATIOS = {"coarse": 0.002, "standard": 0.001, "fine": 0.0004}
+DEFAULT_ANGULAR_DEFLECTION = 0.35  # rad（約20°）。曲面の分割細かさの上限
+MIN_LINEAR_DEFLECTION = 1e-4  # mm
+
+ProgressCallback = Callable[[str, float], None]
+
+_SI_PREFIX_UNITS = {
+    b"$": "m",
+    b".MILLI.": "mm",
+    b".CENTI.": "cm",
+    b".DECI.": "dm",
+    b".MICRO.": "um",
+    b".KILO.": "km",
+}
+_SI_LENGTH_RE = re.compile(rb"SI_UNIT\s*\(\s*(\$|\.[A-Z]+\.)\s*,\s*\.METRE\.\s*\)")
+_CONVERSION_RE = re.compile(rb"CONVERSION_BASED_UNIT\s*\(\s*'([^']*)'")
+_GLOBAL_UNIT_RE = re.compile(rb"GLOBAL_UNIT_ASSIGNED_CONTEXT\s*\(\s*\(([^)]*)\)")
+
+
+class StepConversionError(Exception):
+    """STEPの読み込み・メッシュ化に失敗したことを表す（メッセージはUIにそのまま表示する）。"""
+
+
+@dataclass
+class StepMesh:
+    filename: str
+    vertices: np.ndarray  # (N, 3) float64, mm
+    faces: np.ndarray  # (M, 3) int64
+    unit: str | None  # STEPに記録された元の長さ単位（"mm", "inch" など）
+    solid_count: int
+    linear_deflection: float
+    bbox_diagonal: float
+
+
+@dataclass
+class StepPairMeshes:
+    old: StepMesh
+    new: StepMesh
+    linear_deflection: float
+    angular_deflection: float
+    warnings: list[str] = field(default_factory=list)
+
+
+def linear_deflection_for(diagonal: float, quality: str) -> float:
+    """モデル寸法と品質プリセットから線形許容差(mm)を求める。"""
+    if quality not in QUALITY_RATIOS:
+        raise ValueError(f"未知のメッシュ品質です: {quality}（coarse / standard / fine のいずれか）")
+    return max(float(diagonal) * QUALITY_RATIOS[quality], MIN_LINEAR_DEFLECTION)
+
+
+def detect_step_unit(content: bytes) -> str | None:
+    """STEPの内容から長さ単位を判定する。判定できなければ None。"""
+    # 1. 製品コンテキストが参照する単位エンティティを優先する（変換単位の基準SI単位を誤検出しないため）
+    for match in _GLOBAL_UNIT_RE.finditer(content):
+        for ref in re.findall(rb"#(\d+)", match.group(1)):
+            entity = re.search(rb"#" + ref + rb"\s*=\s*([^;]*);", content)
+            if entity and b"LENGTH_UNIT" in entity.group(1):
+                unit = _unit_from_entity(entity.group(1))
+                if unit:
+                    return unit
+    # 2. フォールバック: LENGTH_UNIT を含むエンティティを探す（変換単位を優先）
+    entities = [m.group(0) for m in re.finditer(rb"[^;]*LENGTH_UNIT[^;]*", content)]
+    for entity in entities:
+        if _CONVERSION_RE.search(entity):
+            return _unit_from_entity(entity)
+    for entity in entities:
+        unit = _unit_from_entity(entity)
+        if unit:
+            return unit
+    return None
+
+
+def _unit_from_entity(entity: bytes) -> str | None:
+    conversion = _CONVERSION_RE.search(entity)
+    if conversion:
+        name = conversion.group(1).decode("ascii", "ignore").strip().lower()
+        if "inch" in name:
+            return "inch"
+        if "foot" in name or "feet" in name:
+            return "ft"
+        return name or None
+    si = _SI_LENGTH_RE.search(entity)
+    if si:
+        return _SI_PREFIX_UNITS.get(si.group(1), si.group(1).decode("ascii", "ignore").strip(".").lower())
+    return None
+
+
+def load_step_pair_as_meshes(
+    old_path: str | Path,
+    new_path: str | Path,
+    *,
+    quality: str = "standard",
+    linear_deflection: float | None = None,
+    angular_deflection: float = DEFAULT_ANGULAR_DEFLECTION,
+    progress: ProgressCallback | None = None,
+    old_label: str | None = None,
+    new_label: str | None = None,
+) -> StepPairMeshes:
+    """新旧STEPを読み込み、同じ精度でメッシュ化する。"""
+    report = progress or (lambda stage, fraction: None)
+    old_path, new_path = Path(old_path), Path(new_path)
+    old_name = old_label or old_path.name
+    new_name = new_label or new_path.name
+
+    report("旧ファイルを読み込み中", 0.0)
+    old_shape, old_unit, old_solids = _read_step(old_path, f"旧ファイル({old_name})")
+    report("新ファイルを読み込み中", 0.35)
+    new_shape, new_unit, new_solids = _read_step(new_path, f"新ファイル({new_name})")
+
+    old_diag = _bbox_diagonal(old_shape)
+    new_diag = _bbox_diagonal(new_shape)
+    if linear_deflection is not None:
+        if not linear_deflection > 0:
+            raise StepConversionError("メッシュ精度(mm)には正の値を指定してください。")
+        deflection = float(linear_deflection)
+    else:
+        # 新旧どちらにも同じ値を使う（大きい方の寸法基準）
+        deflection = linear_deflection_for(max(old_diag, new_diag), quality)
+
+    report("旧形状をメッシュ化中", 0.6)
+    old_vertices, old_faces, old_missing = _tessellate(old_shape, deflection, angular_deflection, f"旧ファイル({old_name})")
+    report("新形状をメッシュ化中", 0.8)
+    new_vertices, new_faces, new_missing = _tessellate(new_shape, deflection, angular_deflection, f"新ファイル({new_name})")
+
+    old_mesh = StepMesh(old_name, old_vertices, old_faces, old_unit, old_solids, deflection, old_diag)
+    new_mesh = StepMesh(new_name, new_vertices, new_faces, new_unit, new_solids, deflection, new_diag)
+    warnings = _conversion_warnings(old_mesh, new_mesh, old_missing, new_missing)
+    report("メッシュ化完了", 1.0)
+    return StepPairMeshes(old_mesh, new_mesh, deflection, angular_deflection, warnings)
+
+
+def _conversion_warnings(old: StepMesh, new: StepMesh, old_missing: int, new_missing: int) -> list[str]:
+    warnings: list[str] = []
+    if old.unit and new.unit and old.unit != new.unit:
+        warnings.append(f"長さ単位が異なります（旧: {old.unit} / 新: {new.unit}）。読み込み時にmmへ換算して比較します。")
+    for label, mesh, missing in (("旧", old, old_missing), ("新", new, new_missing)):
+        if not mesh.unit:
+            warnings.append(f"{label}ファイルの長さ単位をSTEPから判定できませんでした（mmとして扱います）。")
+        if mesh.solid_count == 0:
+            warnings.append(f"{label}ファイルにソリッドがありません（面のみ）。面同士の距離で比較します。")
+        elif mesh.solid_count > 1:
+            warnings.append(f"{label}ファイルは{mesh.solid_count}個のソリッドを含みます。1つのメッシュとして比較します（アセンブリは主対象外）。")
+        if missing:
+            warnings.append(f"{label}ファイルの{missing}面はメッシュ化できなかったため除外しました。")
+    return warnings
+
+
+def _read_step(path: Path, label: str):
+    from OCP.IFSelect import IFSelect_RetDone
+    from OCP.Interface import Interface_Static
+    from OCP.STEPControl import STEPControl_Reader
+    from OCP.TopAbs import TopAbs_FACE, TopAbs_SOLID
+
+    try:
+        content = path.read_bytes()
+    except OSError as exc:
+        raise StepConversionError(f"{label}: ファイルを読み込めません（{exc}）") from exc
+    if b"ISO-10303-21" not in content[:1024]:
+        raise StepConversionError(f"{label}: STEPファイル（ISO-10303-21）ではありません。")
+    unit = detect_step_unit(content)
+    del content
+
+    # 読み込み結果を常にmmへ換算させる
+    Interface_Static.SetCVal_s("xstep.cascade.unit", "MM")
+    reader = STEPControl_Reader()
+    try:
+        status = reader.ReadFile(str(path))
+    except Exception as exc:  # OCCT内部例外
+        raise StepConversionError(f"{label}: STEPの解析中にエラーが発生しました（{exc}）") from exc
+    if status != IFSelect_RetDone:
+        raise StepConversionError(f"{label}: STEPファイルとして読み込めませんでした（構文エラーまたは非対応の形式）。")
+    try:
+        reader.TransferRoots()
+        shape = reader.OneShape()
+    except Exception as exc:
+        raise StepConversionError(f"{label}: 形状データへの変換に失敗しました（{exc}）") from exc
+    if shape is None or shape.IsNull() or _count(shape, TopAbs_FACE) == 0:
+        raise StepConversionError(f"{label}: 形状（面）が含まれていません。図面・PMIのみのSTEPは比較できません。")
+    return shape, unit, _count(shape, TopAbs_SOLID)
+
+
+def _count(shape, kind) -> int:
+    from OCP.TopExp import TopExp_Explorer
+
+    explorer = TopExp_Explorer(shape, kind)
+    count = 0
+    while explorer.More():
+        count += 1
+        explorer.Next()
+    return count
+
+
+def _bbox_diagonal(shape) -> float:
+    from OCP.BRepBndLib import BRepBndLib
+    from OCP.Bnd import Bnd_Box
+
+    box = Bnd_Box()
+    BRepBndLib.Add_s(shape, box)
+    if box.IsVoid():
+        return 0.0
+    # OCP 8 では Bnd_Box.Get() の戻り値型が未登録のため角点から求める
+    low, high = box.CornerMin(), box.CornerMax()
+    return float(np.linalg.norm([high.X() - low.X(), high.Y() - low.Y(), high.Z() - low.Z()]))
+
+
+def _tessellate(shape, linear: float, angular: float, label: str):
+    """全フェイスを三角形化し、(頂点, 面, メッシュ化できなかった面数) を返す。"""
+    from OCP.BRep import BRep_Tool
+    from OCP.BRepMesh import BRepMesh_IncrementalMesh
+    from OCP.TopAbs import TopAbs_FACE, TopAbs_REVERSED
+    from OCP.TopExp import TopExp_Explorer
+    from OCP.TopLoc import TopLoc_Location
+    from OCP.TopoDS import TopoDS
+
+    try:
+        # 絶対値の線形許容差（isRelative=False）、並列メッシュ化
+        BRepMesh_IncrementalMesh(shape, linear, False, angular, True)
+    except Exception as exc:
+        raise StepConversionError(f"{label}: メッシュ化に失敗しました（{exc}）") from exc
+
+    vertex_blocks: list[np.ndarray] = []
+    face_blocks: list[np.ndarray] = []
+    offset = 0
+    missing = 0
+    explorer = TopExp_Explorer(shape, TopAbs_FACE)
+    # OCP 7系は静的メソッドに "_s" が付き、8系では名前空間関数になっている
+    to_face = getattr(TopoDS, "Face_s", None) or TopoDS.Face
+    triangulation_of = getattr(BRep_Tool, "Triangulation_s", None) or BRep_Tool.Triangulation
+    while explorer.More():
+        face = to_face(explorer.Current())
+        explorer.Next()
+        location = TopLoc_Location()
+        triangulation = triangulation_of(face, location)
+        if triangulation is None or triangulation.NbTriangles() == 0:
+            missing += 1
+            continue
+        trsf = location.Transformation()
+        nodes = np.empty((triangulation.NbNodes(), 3), dtype=np.float64)
+        for index in range(1, triangulation.NbNodes() + 1):
+            point = triangulation.Node(index).Transformed(trsf)
+            nodes[index - 1] = (point.X(), point.Y(), point.Z())
+        triangles = np.empty((triangulation.NbTriangles(), 3), dtype=np.int64)
+        for index in range(1, triangulation.NbTriangles() + 1):
+            triangle = triangulation.Triangle(index)
+            triangles[index - 1] = (triangle.Value(1), triangle.Value(2), triangle.Value(3))
+        if face.Orientation() == TopAbs_REVERSED:
+            triangles = triangles[:, [0, 2, 1]]  # 法線を外向きに揃える
+        vertex_blocks.append(nodes)
+        face_blocks.append(triangles - 1 + offset)
+        offset += len(nodes)
+
+    if not face_blocks:
+        raise StepConversionError(f"{label}: メッシュ化できる面がありませんでした。")
+    vertices, faces = _weld(np.vstack(vertex_blocks), np.vstack(face_blocks))
+    return vertices, faces, missing
+
+
+def _weld(vertices: np.ndarray, faces: np.ndarray):
+    """フェイス境界で重複する頂点を統合する（距離計算・細分化の効率化のため）。"""
+    import trimesh
+
+    mesh = trimesh.Trimesh(vertices=vertices, faces=faces, process=True, validate=False)
+    return np.asarray(mesh.vertices, dtype=np.float64), np.asarray(mesh.faces, dtype=np.int64)
diff --git a/docs/3d_cad_diff_specification.md b/docs/3d_cad_diff_specification.md
new file mode 100644
index 0000000000000000000000000000000000000000..4f5c95ece058256b79a1435d792758eaba61b214
--- /dev/null
+++ b/docs/3d_cad_diff_specification.md
@@ -0,0 +1,112 @@
+# 3D CAD差分（STEP比較）技術仕様書
+
+## 1. 概要
+本機能は、CADデータ（STEP形式）の2つのバージョンを3D空間上で視覚的に比較する機能である。
+単品部品（ソリッド）を中心に、新旧形状の幾何学的差異を高速かつ正確に検出し、ブラウザ上のThree.jsキャンバスに表示する。
+完全オフライン環境で動作し、外部ネットワークへのリクエストやCDN依存は一切存在しない。
+
+- **差分表示イメージ**:
+  - 変更なし箇所: グレー（`#94a3b8`）
+  - 旧版のみ（削除）: 赤（`#ef4444`）
+  - 新版のみ（追加）: 緑（`#22c55e`）
+- **表示モード**:
+  - **重ね表示 (Overlay)**: 新版をベースに、旧版の削除部分を重ねて配置。変更なし部分はフラグメントシェーダーで discard することで Z-fighting（重なりのチラつき）を解消。
+  - **左右並べ表示 (Side-by-Side)**: 左に旧版、右に新版を並べ、OrbitControls の視点移動・回転・ズームを左右画面で完全に双方向同期。
+
+## 2. 処理パイプラインとアーキテクチャ
+図面: [three_diff_pipeline.excalidraw](file:///Users/mine/000_work/app/visual-diff-tool/docs/three_diff_pipeline.excalidraw)
+
+```
+[UI: React / Three.js] 
+       │ 1. STEP A/B アップロード (またはプリセット選択)
+       ▼
+[FastAPI: POST /api/3d/jobs] 
+       │ 2. 202 Accepted (job_id 即時返却)
+       ▼
+[子プロセス: multiprocessing.Process]
+       │ 3. OCP による STEP 読込 & mm 換算 & 単位検出 (mm/inch/m)
+       │ 4. 新旧最大バウンディングボックスから共通線形許容差を決定しメッシュ化
+       │ 5. 元STEPファイルを即時削除 (ストレージ削減 & 機密保持)
+       │ 6. 自動位置合わせ (元座標判定 → 面積重心＋慣性主軸24候補 → トリム付きICP)
+       │ 7. メッシュ細分化 & 相手面への最近傍最短距離 (diffDistance) 計算
+       │ 8. VDM1 バイナリ出力 & status.json 更新 (完了)
+       ▼
+[UI: ポーリング完了検知 & VDM1 取得]
+       │ 9. Float32Array 展開 & BufferGeometry 構築
+       │ 10. カスタムシェーダーでリアルタイム色分け (60fps)
+```
+
+## 3. 主要ロジック
+
+### 3.1 STEP→メッシュ変換 (`backend/app/step_mesh.py`)
+- **ライブラリ選定**: `cadquery-ocp-novtk`（OpenCASCADE Technology 7.8〜8.0 バインディング）。
+  - VTK や CasADi（LGPL-3.0）等の巨大依存を含まない novtk 版を採用。
+  - 同梱される OpenCASCADE 本体は LGPL-2.1（追加例外条項付き）。
+- **共通精度テッセレーション**:
+  新旧2つのモデルでテッセレーション精度が異なると、同一形状であっても離散化誤差による擬似差分が発生する。
+  そのため、新旧双方のバウンディングボックス対角長 `max(diag_old, diag_new)` から線形許容差 `linear_deflection` を1つ算出し、新旧両モデルの `BRepMesh_IncrementalMesh` に同一値を適用する。
+- **単位検出と正規化**:
+  STEPヘッダーの `SI_UNIT` および `CONVERSION_BASED_UNIT` から元の長さ単位（mm, inch, m 等）を検出。
+  OCCTの `xstep.cascade.unit = "MM"` 設定により内部形状はすべて mm に統一換算され、新旧で単位が異なる場合は警告を発行する。
+
+### 3.2 位置合わせ (`backend/app/mesh_diff.py`)
+1. **元座標優先評価**:
+   CADモデルの版違いは同一座標系で設計されるケースが多い。元座標での双方向一致率（相手面までの距離が許容誤差以下のサンプルの割合）が 60% 以上であれば、恒等変換（動かさない）を採用する。これにより、ボスを追加しただけで重心が動き、全体が意図せずズレてしまう事故を防止する。
+2. **粗合わせ（面積重心＋慣性主軸）**:
+   水密でないメッシュにも対応するため、三角形の面積重み付け重心を計算。さらに分散共分散行列の固有ベクトルから慣性主軸を算出。主軸の符号・順序の曖昧性（24通りの回転群）を全探索し、粗い距離評価で最良姿勢を選択。
+3. **トリム付きICP (Trimmed ICP)**:
+   最近傍点の距離上位 15%（変更箇所・追加形状）を除外して最小二乗剛体変換（Kabschアルゴリズム）を反復適用。形状変更部分に引っ張られずに共通形状部分で精密に密着させる。
+
+### 3.3 相手面最短距離の算出とVDM1バイナリ
+- **距離計算**: `trimesh.proximity.closest_point`（R木空間インデックス利用）により、各頂点から相手メッシュ三角形表面までの幾何学的最短距離を算出。
+- **VDM1バイナリフォーマット**:
+  - `0..3` : マジック `VDM1` (ASCII)
+  - `4..7` : JSONヘッダ長 `json_len` (UInt32 LE)
+  - `8..8+json_len` : メタデータJSON (UTF-8, 頂点数・面数・単位など)
+  - パディング (4バイト境界アラインメント)
+  - `positions` : Float32Array (`vertex_count * 3 * 4` バイト)
+  - `indices` : Uint32Array (`face_count * 3 * 4` バイト)
+  - `distances` : Float32Array (`vertex_count * 4` バイト)
+
+### 3.4 リアルタイム色分けシェーダー (`frontend/src/three-diff/materials.js`)
+- `MeshStandardMaterial` の `onBeforeCompile` を拡張。
+- 頂点シェーダーで `diffDistance` 属性を Varying `vDiffDistance` へ転送。
+- フラグメントシェーダーで `vDiffDistance > uThreshold` をピクセル単位で判定。
+- スライダー操作時は `material.userData.uniforms.uThreshold.value = newThreshold` を更新するのみで、GPUへのバッファ転送なしに即座に表示が切り替わる。
+
+## 4. APIエンドポイント仕様
+| メソッド | パス | 説明 |
+|---|---|---|
+| `GET` | `/api/3d/status` | 3D依存ライブラリのインストール状況と導入コマンド例 |
+| `GET` | `/api/3d/samples` | 検証用STEPサンプルペア一覧 |
+| `POST` | `/api/3d/samples/load` | サンプルペアの差分ジョブ作成 (202 Accepted) |
+| `POST` | `/api/3d/jobs` | STEP新旧アップロード差分ジョブ作成 (202 Accepted) |
+| `GET` | `/api/3d/jobs/{job_id}` | ジョブ状態、進捗率、警告、統計情報 |
+| `GET` | `/api/3d/jobs/{job_id}/mesh/{side}` | 位置合わせ済みVDM1バイナリ (`side`: old / new) |
+| `DELETE` | `/api/3d/jobs/{job_id}` | ジョブファイルおよびキャッシュの即時破棄 |
+
+## 5. ライセンス確認結果
+- `cadquery-ocp-novtk`: Apache-2.0（同梱 OpenCASCADE 本体: **LGPL-2.1 with Exception**）
+- `trimesh`: MIT
+- `rtree`: MIT（同梱 libspatialindex: MIT）
+- `scipy`: BSD-3-Clause
+- `three`: MIT
+- **留意事項**: 官公庁案件・商用配布時において、動的リンクでの利用であるためアプリ本体のソース開示義務は生じないが、OpenCASCADEのLGPL-2.1ライセンス文の添付およびソースコード入手先の明記が必要。GPLやAGPL等の感染性ライセンスは含まれない。
+
+## 6. 実機STEPデータによるWeb画面検証実績
+実務データであるロードセル/圧力センサーのSTEPファイルを用い、Web画面上で同一データ比較の完全一致検証を実施。
+- **対象ファイル**: `/Users/mine/000_work/obsidian-dagnetz/01_data/2026/10/06/CBES (50kg to 2000kg).step` (853 KB)
+- **ジオメトリ諸元**:
+  - ソリッド数: 1（単品部品）
+  - 単位: `mm`（STEPヘッダー SI_UNIT 由来）
+  - 頂点数: 15,021、三角面数: 29,255
+  - テッセレーション精度 (線形許容差): 0.1261 mm
+  - 警告: 微小面/退化面 17面のエラーを安全にスキップ（全体形状の破損なし）
+- **位置合わせ・差分判定**:
+  - 位置合わせ方式: `identity`（恒等変換、回転 0.0°、移動 0.0 mm）
+  - RMS 誤差: `5.05e-13 mm`
+  - 旧/新 最大表面間距離: `7.15e-12 mm`
+- **Web画面での表示結果**:
+  - 差分割合: `+追加 0.0% (0 / 15021 頂点)`、`-削除 0.0% (0 / 15021 頂点)`
+  - Three.js レンダリング: 赤（削除）や緑（追加）の差分色は一切発生せず、全面均一なグレー（一致）として正確に描画されることを確認。
+
diff --git a/docs/claude.md b/docs/claude.md
