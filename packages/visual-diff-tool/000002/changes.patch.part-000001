+#209 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
+#210 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(3.937007874016E-09),
+  #204,'distance_accuracy_value','confusion accuracy');
+#211 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#7));
+ENDSEC;
+END-ISO-10303-21;
diff --git a/scripts/generate_step_samples.py b/scripts/generate_step_samples.py
new file mode 100644
index 0000000000000000000000000000000000000000..5471640fe6c01920df965c6a3590a1eae505ea59
--- /dev/null
+++ b/scripts/generate_step_samples.py
@@ -0,0 +1,113 @@
+"""
+3D差分（STEP比較）の動作確認用サンプルSTEPペアを生成するスクリプト。
+OCP（cadquery-ocp-novtk）で単品部品を作り、samples/step/<名前>_a.step（旧版）/ _b.step（新版）へ保存する。
+
+生成するペア:
+- hole_position : 板 100x60x10 の穴(φ12)の位置が x=30 → x=60 に移動
+- dimension     : ブロックの長さが 80 → 90 に変更
+- added_boss    : 板の上面に円柱ボス(φ20 x 15)を追加
+- moved_rotated : 同一形状のL字ブラケットを回転(Z35°, X15°)＋平行移動（位置合わせの検証用）
+- unit_inch     : 同一形状の段付き軸。新版だけ長さ単位をINCHで保存（単位警告の検証用）
+
+実行: .venv/bin/python scripts/generate_step_samples.py
+"""
+
+from __future__ import annotations
+
+import math
+from pathlib import Path
+
+from OCP.BRepAlgoAPI import BRepAlgoAPI_Cut, BRepAlgoAPI_Fuse
+from OCP.BRepBuilderAPI import BRepBuilderAPI_Transform
+from OCP.BRepPrimAPI import BRepPrimAPI_MakeBox, BRepPrimAPI_MakeCylinder
+from OCP.IFSelect import IFSelect_RetDone
+from OCP.Interface import Interface_Static
+from OCP.STEPControl import STEPControl_AsIs, STEPControl_Writer
+from OCP.gp import gp_Ax1, gp_Ax2, gp_Dir, gp_Pnt, gp_Trsf, gp_Vec
+
+ROOT = Path(__file__).resolve().parents[1]
+OUTPUT_DIR = ROOT / "samples" / "step"
+
+
+def box(x: float, y: float, z: float, dx: float, dy: float, dz: float):
+    return BRepPrimAPI_MakeBox(gp_Pnt(x, y, z), dx, dy, dz).Shape()
+
+
+def cylinder(x: float, y: float, z: float, radius: float, height: float):
+    return BRepPrimAPI_MakeCylinder(gp_Ax2(gp_Pnt(x, y, z), gp_Dir(0, 0, 1)), radius, height).Shape()
+
+
+def cut(a, b):
+    return BRepAlgoAPI_Cut(a, b).Shape()
+
+
+def fuse(a, b):
+    return BRepAlgoAPI_Fuse(a, b).Shape()
+
+
+def transformed(shape, rot_z_deg: float, rot_x_deg: float, translation: tuple[float, float, float]):
+    rz = gp_Trsf()
+    rz.SetRotation(gp_Ax1(gp_Pnt(0, 0, 0), gp_Dir(0, 0, 1)), math.radians(rot_z_deg))
+    rx = gp_Trsf()
+    rx.SetRotation(gp_Ax1(gp_Pnt(0, 0, 0), gp_Dir(1, 0, 0)), math.radians(rot_x_deg))
+    tr = gp_Trsf()
+    tr.SetTranslation(gp_Vec(*translation))
+    # 適用順: Z回転 → X回転 → 平行移動
+    total = tr.Multiplied(rx.Multiplied(rz))
+    return BRepBuilderAPI_Transform(shape, total, True).Shape()
+
+
+def write_step(shape, path: Path, unit: str = "MM") -> None:
+    Interface_Static.SetCVal_s("write.step.unit", unit)
+    try:
+        writer = STEPControl_Writer()
+        writer.Transfer(shape, STEPControl_AsIs)
+        status = writer.Write(str(path))
+        if status != IFSelect_RetDone:
+            raise RuntimeError(f"STEP書き出しに失敗しました: {path}")
+    finally:
+        Interface_Static.SetCVal_s("write.step.unit", "MM")
+
+
+def plate_with_hole(hole_x: float):
+    return cut(box(0, 0, 0, 100, 60, 10), cylinder(hole_x, 30, -1, 6, 12))
+
+
+def block(length: float):
+    return cut(box(0, 0, 0, length, 40, 20), cylinder(20, 20, -1, 5, 22))
+
+
+def l_bracket():
+    base = box(0, 0, 0, 60, 40, 8)
+    wall = box(0, 0, 0, 8, 40, 50)
+    bracket = fuse(base, wall)
+    return cut(bracket, cylinder(40, 20, -1, 5, 10))
+
+
+def stepped_shaft():
+    return fuse(cylinder(0, 0, 0, 15, 40), cylinder(0, 0, 40, 10, 30))
+
+
+def build_pairs() -> dict[str, tuple]:
+    plate = box(0, 0, 0, 80, 60, 10)
+    bracket = l_bracket()
+    shaft = stepped_shaft()
+    return {
+        "hole_position": (plate_with_hole(30), plate_with_hole(60), "MM"),
+        "dimension": (block(80), block(90), "MM"),
+        "added_boss": (plate, fuse(plate, cylinder(40, 30, 10, 10, 15)), "MM"),
+        "moved_rotated": (bracket, transformed(bracket, 35, 15, (25, -10, 5)), "MM"),
+        "unit_inch": (shaft, shaft, "INCH"),
+    }
+
+
+def main() -> None:
+    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
+    for name, (shape_a, shape_b, unit_b) in build_pairs().items():
+        write_step(shape_a, OUTPUT_DIR / f"{name}_a.step")
+        write_step(shape_b, OUTPUT_DIR / f"{name}_b.step", unit=unit_b)
+        print(f"generated: {name}_a.step / {name}_b.step")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_mesh_alignment.py b/tests/test_mesh_alignment.py
new file mode 100644
index 0000000000000000000000000000000000000000..27b131dc313115009568bae5f8a8cdde0b33a290
--- /dev/null
+++ b/tests/test_mesh_alignment.py
@@ -0,0 +1,155 @@
+"""
+3D差分 段階2: 位置合わせ（重心・慣性主軸による粗合わせ＋トリム付きICP）のテスト。
+- 元座標が一致していれば変換しない（追加形状で重心がずれても全体を動かさない）
+- 平行移動・回転でずれた同一形状を復元できる
+- 変更部分を含んでいても、共通部分で位置が合う
+- mode="none" は常に恒等変換
+- バウンディングボックス比から単位不一致（inch/m）の疑いを警告する
+外部ファイルに依存しないよう、trimeshで合成したメッシュを使う。
+"""
+
+import importlib.util
+import math
+import unittest
+
+import numpy as np
+
+HAS_MESH_DEPS = all(importlib.util.find_spec(name) is not None for name in ("trimesh", "scipy", "rtree"))
+
+
+def _rotation(z_deg: float, x_deg: float) -> np.ndarray:
+    import trimesh
+
+    rz = trimesh.transformations.rotation_matrix(math.radians(z_deg), [0, 0, 1])
+    rx = trimesh.transformations.rotation_matrix(math.radians(x_deg), [1, 0, 0])
+    return rx @ rz
+
+
+def _bracket():
+    """非対称なL字ブラケット（主軸が一意に決まる形状）。"""
+    import trimesh
+
+    base = trimesh.creation.box(extents=[60, 40, 8], transform=trimesh.transformations.translation_matrix([30, 20, 4]))
+    wall = trimesh.creation.box(extents=[8, 40, 50], transform=trimesh.transformations.translation_matrix([4, 20, 25]))
+    rib = trimesh.creation.box(extents=[20, 4, 20], transform=trimesh.transformations.translation_matrix([18, 5, 18]))
+    return trimesh.util.concatenate([base, wall, rib])
+
+
+def _boss():
+    import trimesh
+
+    return trimesh.creation.cylinder(radius=8, height=12, transform=trimesh.transformations.translation_matrix([45, 30, 14]))
+
+
+def _max_vertex_error(mesh_a, mesh_b) -> float:
+    return float(np.abs(np.asarray(mesh_a.vertices) - np.asarray(mesh_b.vertices)).max())
+
+
+@unittest.skipUnless(HAS_MESH_DEPS, "requirements-3d.txt が未導入")
+class TestAlignment(unittest.TestCase):
+    def test_identical_meshes_keep_identity(self):
+        from backend.app.mesh_diff import align_meshes
+
+        old = _bracket()
+        result = align_meshes(old, old.copy(), mode="auto", tolerance=0.05)
+        self.assertEqual(result.applied, "identity")
+        np.testing.assert_allclose(result.matrix, np.eye(4), atol=1e-12)
+        self.assertGreater(result.inlier_ratio, 0.99)
+        self.assertEqual(result.warnings, [])
+
+    def test_added_feature_in_same_coordinates_does_not_shift(self):
+        import trimesh
+
+        from backend.app.mesh_diff import align_meshes
+
+        old = _bracket()
+        new = trimesh.util.concatenate([_bracket(), _boss()])
+        result = align_meshes(old, new, mode="auto", tolerance=0.05)
+        self.assertEqual(result.applied, "identity")
+        np.testing.assert_allclose(result.matrix, np.eye(4), atol=1e-12)
+
+    def test_recovers_translation_and_rotation(self):
+        from backend.app.mesh_diff import align_meshes
+
+        old = _bracket()
+        moved = old.copy()
+        moved.apply_transform(_rotation(35, 15))
+        moved.apply_translation([25, -10, 5])
+        result = align_meshes(old, moved, mode="auto", tolerance=0.05)
+        self.assertEqual(result.applied, "fit")
+        restored = moved.copy()
+        restored.apply_transform(result.matrix)
+        diag = float(np.linalg.norm(old.extents))
+        self.assertLess(_max_vertex_error(old, restored), diag * 1e-3)
+        self.assertGreater(result.inlier_ratio, 0.95)
+        self.assertTrue(any("位置合わせ" in warning for warning in result.warnings))
+        self.assertGreater(result.rotation_deg, 10)
+
+    def test_alignment_ignores_changed_region(self):
+        import trimesh
+
+        from backend.app.mesh_diff import align_meshes
+
+        old = _bracket()
+        new = trimesh.util.concatenate([_bracket(), _boss()])
+        transform = trimesh.transformations.translation_matrix([12, 30, -7]) @ _rotation(-50, 20)
+        new.apply_transform(transform)
+        result = align_meshes(old, new, mode="auto", tolerance=0.05)
+        # 共通部分（ブラケット本体）が元位置へ戻ること
+        body = _bracket()
+        body.apply_transform(transform)
+        body.apply_transform(result.matrix)
+        diag = float(np.linalg.norm(old.extents))
+        self.assertLess(_max_vertex_error(_bracket(), body), diag * 2e-3)
+
+    def test_mode_none_never_moves(self):
+        from backend.app.mesh_diff import align_meshes
+
+        old = _bracket()
+        moved = old.copy()
+        moved.apply_translation([40, 0, 0])
+        result = align_meshes(old, moved, mode="none", tolerance=0.05)
+        self.assertEqual(result.applied, "identity")
+        np.testing.assert_allclose(result.matrix, np.eye(4))
+        # 元座標で大きくずれていることを警告する
+        self.assertTrue(any("ずれ" in warning for warning in result.warnings))
+
+    def test_mode_centroid_only_translates(self):
+        from backend.app.mesh_diff import align_meshes
+
+        old = _bracket()
+        moved = old.copy()
+        moved.apply_translation([3, -4, 5])
+        result = align_meshes(old, moved, mode="centroid", tolerance=0.05)
+        self.assertEqual(result.applied, "centroid")
+        np.testing.assert_allclose(result.matrix[:3, :3], np.eye(3), atol=1e-12)
+        np.testing.assert_allclose(result.matrix[:3, 3], [-3, 4, -5], atol=1e-6)
+
+    def test_invalid_mode_raises(self):
+        from backend.app.mesh_diff import align_meshes
+
+        with self.assertRaises(ValueError):
+            align_meshes(_bracket(), _bracket(), mode="magic", tolerance=0.05)
+
+
+class TestScaleMismatchWarning(unittest.TestCase):
+    def test_warns_inch_ratio(self):
+        from backend.app.mesh_diff import scale_mismatch_warning
+
+        message = scale_mismatch_warning([100, 50, 20], [100 / 25.4, 50 / 25.4, 20 / 25.4])
+        self.assertIsNotNone(message)
+        self.assertIn("25.4", message)
+
+    def test_warns_metre_ratio(self):
+        from backend.app.mesh_diff import scale_mismatch_warning
+
+        self.assertIn("1000", scale_mismatch_warning([0.1, 0.05, 0.02], [100, 50, 20]))
+
+    def test_no_warning_for_similar_size(self):
+        from backend.app.mesh_diff import scale_mismatch_warning
+
+        self.assertIsNone(scale_mismatch_warning([100, 50, 20], [110, 50, 20]))
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_mesh_api.py b/tests/test_mesh_api.py
new file mode 100644
index 0000000000000000000000000000000000000000..5aedac628b9dcd82197344dec2326bf397f26d95
--- /dev/null
+++ b/tests/test_mesh_api.py
@@ -0,0 +1,190 @@
+"""
+3D差分 段階3（API）: 非同期ジョブAPIのテスト。
+- GET  /api/3d/status            : 3D依存の導入状況
+- POST /api/3d/jobs              : 新旧STEPを受け取り job_id を即時返却（重い処理は子プロセス）
+- GET  /api/3d/jobs/{id}         : 状態・進捗・警告・エラー・統計
+- GET  /api/3d/jobs/{id}/mesh/{side} : 位置合わせ済みメッシュと頂点距離（VDM1バイナリ）
+- DELETE /api/3d/jobs/{id}       : 結果の即時破棄
+アップロードされたSTEPは変換後に削除され、結果は保持期間経過後に削除されること。
+"""
+
+import importlib.util
+import tempfile
+import time
+import unittest
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+import numpy as np
+from fastapi.testclient import TestClient
+
+from backend.app.main import app
+
+ROOT = Path(__file__).resolve().parents[1]
+STEP_DIR = ROOT / "samples" / "step"
+HAS_3D = all(importlib.util.find_spec(name) is not None for name in ("OCP", "trimesh", "scipy", "rtree"))
+
+
+def _files(old: Path, new: Path, old_bytes: bytes | None = None):
+    return {
+        "file_old": (old.name, old_bytes if old_bytes is not None else old.read_bytes(), "application/octet-stream"),
+        "file_new": (new.name, new.read_bytes(), "application/octet-stream"),
+    }
+
+
+class TestMeshApiValidation(unittest.TestCase):
+    def setUp(self):
+        self.client = TestClient(app)
+
+    def test_status_reports_availability(self):
+        response = self.client.get("/api/3d/status")
+        self.assertEqual(response.status_code, 200)
+        body = response.json()
+        self.assertEqual(body["available"], HAS_3D)
+        self.assertIn("missing", body)
+        self.assertIn("requirements-3d.txt", body["install_hint"])
+
+    def test_rejects_non_step_extension(self):
+        files = {
+            "file_old": ("drawing.png", b"x", "image/png"),
+            "file_new": ("part_b.step", b"ISO-10303-21;", "application/octet-stream"),
+        }
+        response = self.client.post("/api/3d/jobs", files=files)
+        self.assertEqual(response.status_code, 400)
+        self.assertIn("STEP", response.json()["detail"])
+
+    @unittest.skipUnless(HAS_3D, "requirements-3d.txt が未導入")
+    def test_rejects_unknown_quality(self):
+        files = _files(STEP_DIR / "dimension_a.step", STEP_DIR / "dimension_b.step")
+        response = self.client.post("/api/3d/jobs", files=files, data={"quality": "ultra"})
+        self.assertEqual(response.status_code, 400)
+
+    def test_unknown_job_is_404(self):
+        self.assertEqual(self.client.get("/api/3d/jobs/does-not-exist").status_code, 404)
+
+
+@unittest.skipUnless(HAS_3D, "requirements-3d.txt が未導入")
+class TestMeshApiJobs(unittest.TestCase):
+    def setUp(self):
+        self.client = TestClient(app)
+
+    def _wait(self, job_id: str, timeout: float = 180.0) -> dict:
+        deadline = time.monotonic() + timeout
+        while time.monotonic() < deadline:
+            body = self.client.get(f"/api/3d/jobs/{job_id}").json()
+            if body["status"] in {"done", "error"}:
+                return body
+            time.sleep(0.2)
+        self.fail("ジョブがタイムアウトしました")
+
+    def _mesh(self, job_id: str, side: str) -> dict:
+        from backend.app.mesh_diff import unpack_mesh_binary
+
+        response = self.client.get(f"/api/3d/jobs/{job_id}/mesh/{side}")
+        self.assertEqual(response.status_code, 200)
+        self.assertEqual(response.headers["content-type"], "application/octet-stream")
+        return unpack_mesh_binary(response.content)
+
+    def test_full_job_lifecycle(self):
+        from backend.app.main import mesh_job_manager
+
+        response = self.client.post(
+            "/api/3d/jobs",
+            files=_files(STEP_DIR / "hole_position_a.step", STEP_DIR / "hole_position_b.step"),
+            data={"quality": "standard", "align_mode": "auto"},
+        )
+        self.assertEqual(response.status_code, 202)
+        job_id = response.json()["job_id"]
+        body = self._wait(job_id)
+        self.assertEqual(body["status"], "done", body.get("error"))
+        self.assertAlmostEqual(body["progress"], 1.0)
+        stats = body["stats"]
+        self.assertGreater(stats["linear_deflection"], 0)
+        self.assertEqual(stats["alignment"]["applied"], "identity")
+        self.assertIn("retention_minutes", body)
+
+        old = self._mesh(job_id, "old")
+        new = self._mesh(job_id, "new")
+        self.assertEqual(len(old["distances"]), old["header"]["vertex_count"])
+        # 穴が30mm移動しているため、旧穴の壁面は新形状から離れている（板厚10mmの中央で最大5.0mm）
+        self.assertGreaterEqual(float(old["distances"].max()), 5.0)
+        self.assertGreaterEqual(float(new["distances"].max()), 5.0)
+        # 大部分（板の面）は一致している
+        self.assertLess(float(np.median(old["distances"])), stats["linear_deflection"])
+
+        # アップロードされたSTEPは変換後に削除されている
+        job_dir = mesh_job_manager.job_dir(job_id)
+        self.assertEqual(list(job_dir.glob("*.step")) + list(job_dir.glob("*.stp")), [])
+
+        self.assertEqual(self.client.delete(f"/api/3d/jobs/{job_id}").status_code, 200)
+        self.assertEqual(self.client.get(f"/api/3d/jobs/{job_id}").status_code, 404)
+        self.assertFalse(job_dir.exists())
+
+    def test_moved_rotated_pair_is_aligned(self):
+        response = self.client.post(
+            "/api/3d/jobs",
+            files=_files(STEP_DIR / "moved_rotated_a.step", STEP_DIR / "moved_rotated_b.step"),
+            data={"quality": "standard"},
+        )
+        body = self._wait(response.json()["job_id"])
+        self.assertEqual(body["status"], "done", body.get("error"))
+        self.assertEqual(body["stats"]["alignment"]["applied"], "fit")
+        self.assertTrue(any("位置合わせ" in warning for warning in body["warnings"]))
+        new = self._mesh(body["job_id"], "new")
+        self.assertLess(float(new["distances"].max()), 0.5)
+
+    def test_broken_step_reports_readable_error(self):
+        response = self.client.post(
+            "/api/3d/jobs",
+            files=_files(STEP_DIR / "dimension_a.step", STEP_DIR / "dimension_b.step", old_bytes=b"ISO-10303-21;\nbroken"),
+        )
+        self.assertEqual(response.status_code, 202)
+        body = self._wait(response.json()["job_id"])
+        self.assertEqual(body["status"], "error")
+        self.assertIn("旧ファイル", body["error"])
+        self.assertIn("dimension_a.step", body["error"])
+        self.assertEqual(self.client.get(f"/api/3d/jobs/{body['job_id']}/mesh/old").status_code, 409)
+
+    def test_samples_endpoint_and_direct_load(self):
+        samples_res = self.client.get("/api/3d/samples")
+        self.assertEqual(samples_res.status_code, 200)
+        samples = samples_res.json()
+        self.assertGreaterEqual(len(samples), 5)
+        self.assertTrue(any(s["id"] == "hole_position" for s in samples))
+
+        load_res = self.client.post(
+            "/api/3d/samples/load",
+            json={"sample_id": "hole_position", "quality": "standard", "align_mode": "auto"},
+        )
+        self.assertEqual(load_res.status_code, 202)
+        job_id = load_res.json()["job_id"]
+        body = self._wait(job_id)
+        self.assertEqual(body["status"], "done")
+
+
+class TestMeshJobRetention(unittest.TestCase):
+    def test_expired_jobs_are_removed(self):
+        from backend.app.mesh_jobs import MeshDiffJobManager
+
+        with tempfile.TemporaryDirectory() as tmp:
+            manager = MeshDiffJobManager(Path(tmp), retention_minutes=30)
+            job_id = manager.register_finished_job_for_test(finished_at=datetime.now(timezone.utc) - timedelta(minutes=31))
+            self.assertTrue(manager.job_dir(job_id).exists())
+            removed = manager.cleanup_expired()
+            self.assertEqual(removed, 1)
+            self.assertIsNone(manager.get_status(job_id))
+            self.assertFalse(manager.job_dir(job_id).exists())
+
+    def test_orphan_directories_are_removed_on_startup(self):
+        from backend.app.mesh_jobs import MeshDiffJobManager
+
+        with tempfile.TemporaryDirectory() as tmp:
+            orphan = Path(tmp) / "orphan-job"
+            orphan.mkdir()
+            (orphan / "old.step").write_bytes(b"x")
+            MeshDiffJobManager(Path(tmp), retention_minutes=30)
+            self.assertFalse(orphan.exists())
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_mesh_distance.py b/tests/test_mesh_distance.py
new file mode 100644
index 0000000000000000000000000000000000000000..bbab1cd0ce6410d3e0bdbbbd243d633f4c150d7c
--- /dev/null
+++ b/tests/test_mesh_distance.py
@@ -0,0 +1,147 @@
+"""
+3D差分 段階3（中核ロジック）: 頂点ごとの相手メッシュ表面までの距離、細分化、バイナリ形式のテスト。
+- 同一形状は距離ほぼ0
+- 寸法変更（長さ80→90）では、延長部分だけ距離が大きい
+- 形状の位置移動では、移動した部分だけがしきい値を超える
+- 細分化は辺長上限と頂点数上限を守る
+- 位置・向きがずれた同一形状は、位置合わせ後に距離がほぼ0
+- VDM1バイナリ（ヘッダJSON＋float32座標＋uint32インデックス＋float32距離）が往復変換できる
+"""
+
+import importlib.util
+import math
+import unittest
+
+import numpy as np
+
+HAS_MESH_DEPS = all(importlib.util.find_spec(name) is not None for name in ("trimesh", "scipy", "rtree"))
+
+
+def _box(x0, y0, z0, dx, dy, dz):
+    import trimesh
+
+    return trimesh.creation.box(
+        extents=[dx, dy, dz],
+        transform=trimesh.transformations.translation_matrix([x0 + dx / 2, y0 + dy / 2, z0 + dz / 2]),
+    )
+
+
+def _plate_with_boss(boss_x):
+    import trimesh
+
+    plate = _box(0, 0, 0, 100, 60, 10)
+    boss = trimesh.creation.cylinder(radius=8, height=10, transform=trimesh.transformations.translation_matrix([boss_x, 30, 15]))
+    return trimesh.util.concatenate([plate, boss])
+
+
+@unittest.skipUnless(HAS_MESH_DEPS, "requirements-3d.txt が未導入")
+class TestSurfaceDistances(unittest.TestCase):
+    def test_identical_meshes_have_zero_distance(self):
+        from backend.app.mesh_diff import compute_mesh_diff
+
+        mesh = _plate_with_boss(30)
+        result = compute_mesh_diff(mesh.vertices, mesh.faces, mesh.vertices, mesh.faces, tolerance=0.05)
+        self.assertLess(result.old.distances.max(), 1e-6)
+        self.assertLess(result.new.distances.max(), 1e-6)
+        self.assertEqual(result.alignment.applied, "identity")
+
+    def test_dimension_change_only_extension_differs(self):
+        from backend.app.mesh_diff import compute_mesh_diff
+
+        old = _box(0, 0, 0, 80, 40, 20)
+        new = _box(0, 0, 0, 90, 40, 20)
+        result = compute_mesh_diff(old.vertices, old.faces, new.vertices, new.faces, tolerance=0.05)
+        new_x = result.new.vertices[:, 0]
+        self.assertLess(result.new.distances[new_x < 79].max(), 1e-6)
+        self.assertAlmostEqual(result.new.distances.max(), 10.0, delta=0.1)
+        old_x = result.old.vertices[:, 0]
+        self.assertLess(result.old.distances[old_x < 79].max(), 1e-6)
+        self.assertGreater(result.old.distances[old_x > 79.9].max(), 5.0)
+
+    def test_moved_feature_exceeds_threshold_only_locally(self):
+        from backend.app.mesh_diff import compute_mesh_diff
+
+        old = _plate_with_boss(20)
+        new = _plate_with_boss(70)
+        threshold = 0.2
+        result = compute_mesh_diff(old.vertices, old.faces, new.vertices, new.faces, tolerance=0.05)
+        old_v = result.old.vertices
+        near_old_boss = np.hypot(old_v[:, 0] - 20, old_v[:, 1] - 30) <= 8.5
+        far_from_bosses = (np.hypot(old_v[:, 0] - 20, old_v[:, 1] - 30) > 9) & (np.hypot(old_v[:, 0] - 70, old_v[:, 1] - 30) > 9)
+        self.assertLess(result.old.distances[far_from_bosses].max(), threshold)
+        boss_side = near_old_boss & (old_v[:, 2] > 12)
+        self.assertTrue((result.old.distances[boss_side] > threshold).all())
+        new_v = result.new.vertices
+        new_boss_top = (np.hypot(new_v[:, 0] - 70, new_v[:, 1] - 30) <= 8.5) & (new_v[:, 2] > 19.9)
+        self.assertTrue((result.new.distances[new_boss_top] > threshold).all())
+
+    def test_moved_and_rotated_identical_shape_is_near_zero_after_alignment(self):
+        import trimesh
+
+        from backend.app.mesh_diff import compute_mesh_diff
+
+        old = trimesh.util.concatenate([_box(0, 0, 0, 60, 40, 8), _box(0, 0, 0, 8, 40, 50), _box(10, 3, 8, 20, 4, 20)])
+        new = old.copy()
+        new.apply_transform(trimesh.transformations.rotation_matrix(math.radians(40), [0, 1, 1]))
+        new.apply_translation([30, -20, 15])
+        result = compute_mesh_diff(old.vertices, old.faces, new.vertices, new.faces, tolerance=0.05)
+        self.assertEqual(result.alignment.applied, "fit")
+        diag = float(np.linalg.norm(old.extents))
+        self.assertLess(result.new.distances.max(), diag * 2e-3)
+        self.assertLess(result.old.distances.max(), diag * 2e-3)
+        # 位置合わせ済み座標が返る（旧メッシュの範囲に重なる）
+        np.testing.assert_allclose(result.new.vertices.min(axis=0), old.bounds[0], atol=diag * 2e-3)
+
+    def test_progress_is_reported_monotonically(self):
+        from backend.app.mesh_diff import compute_mesh_diff
+
+        mesh = _box(0, 0, 0, 10, 10, 10)
+        reports = []
+        compute_mesh_diff(mesh.vertices, mesh.faces, mesh.vertices, mesh.faces, tolerance=0.01, progress=lambda stage, value: reports.append(value))
+        self.assertGreater(len(reports), 2)
+        self.assertEqual(reports, sorted(reports))
+        self.assertAlmostEqual(reports[-1], 1.0)
+
+
+@unittest.skipUnless(HAS_MESH_DEPS, "requirements-3d.txt が未導入")
+class TestRefineMesh(unittest.TestCase):
+    def test_respects_max_edge(self):
+        from backend.app.mesh_diff import refine_mesh
+
+        mesh = _box(0, 0, 0, 100, 60, 10)
+        vertices, faces = refine_mesh(mesh.vertices, mesh.faces, max_edge=5.0, max_vertices=1_000_000)
+        edges = vertices[faces[:, [1, 2, 0]]] - vertices[faces]
+        self.assertLessEqual(np.linalg.norm(edges, axis=2).max(), 5.0 + 1e-9)
+
+    def test_respects_vertex_cap(self):
+        from backend.app.mesh_diff import refine_mesh
+
+        mesh = _box(0, 0, 0, 100, 60, 10)
+        vertices, _ = refine_mesh(mesh.vertices, mesh.faces, max_edge=0.5, max_vertices=5000)
+        self.assertLessEqual(len(vertices), 5000)
+        self.assertGreater(len(vertices), len(mesh.vertices))
+
+
+class TestMeshBinary(unittest.TestCase):
+    def test_round_trip(self):
+        from backend.app.mesh_diff import pack_mesh_binary, unpack_mesh_binary
+
+        vertices = np.array([[0, 0, 0], [1, 0, 0], [0, 1, 0], [0, 0, 1]], dtype=np.float64)
+        faces = np.array([[0, 1, 2], [0, 2, 3]], dtype=np.int64)
+        distances = np.array([0.0, 0.5, 1.5, 2.0])
+        data = pack_mesh_binary(vertices, faces, distances, {"side": "old"})
+        self.assertEqual(data[:4], b"VDM1")
+        self.assertEqual(len(data) % 4, 0)
+        decoded = unpack_mesh_binary(data)
+        self.assertEqual(decoded["header"]["vertex_count"], 4)
+        self.assertEqual(decoded["header"]["face_count"], 2)
+        self.assertEqual(decoded["header"]["side"], "old")
+        np.testing.assert_allclose(decoded["positions"].reshape(-1, 3), vertices)
+        np.testing.assert_array_equal(decoded["indices"].reshape(-1, 3), faces)
+        np.testing.assert_allclose(decoded["distances"], distances)
+        self.assertEqual(decoded["positions"].dtype, np.float32)
+        self.assertEqual(decoded["indices"].dtype, np.uint32)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_step_mesh.py b/tests/test_step_mesh.py
new file mode 100644
index 0000000000000000000000000000000000000000..80ce41bb9d1b9eb9e4f0ad52ce31dd4120270a80
--- /dev/null
+++ b/tests/test_step_mesh.py
@@ -0,0 +1,127 @@
+"""
+3D差分 段階1: STEP→メッシュ変換のテスト。
+- samples/step/ に検証用STEPペア（穴位置・寸法・追加形状・位置ズレ・単位違い）が存在すること
+- STEPヘッダから元の長さ単位を検出できること
+- 新旧に同じテッセレーション精度（線形許容差）が適用されること
+- 不正なSTEPは原因が分かる StepConversionError になること
+OCP（requirements-3d.txt）が未導入の環境では変換系テストをスキップする。
+"""
+
+import importlib.util
+import unittest
+from pathlib import Path
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[1]
+STEP_SAMPLES_DIR = ROOT / "samples" / "step"
+EXPECTED_STEP_PAIRS = ["hole_position", "dimension", "added_boss", "moved_rotated", "unit_inch"]
+HAS_OCP = importlib.util.find_spec("OCP") is not None and importlib.util.find_spec("trimesh") is not None
+
+
+class TestStepSamples(unittest.TestCase):
+    def test_step_sample_pairs_exist(self):
+        for name in EXPECTED_STEP_PAIRS:
+            for side in ("a", "b"):
+                path = STEP_SAMPLES_DIR / f"{name}_{side}.step"
+                self.assertTrue(path.exists(), f"{path} がありません")
+                head = path.read_bytes()[:64]
+                self.assertIn(b"ISO-10303-21", head)
+
+
+class TestStepUnitDetection(unittest.TestCase):
+    def test_detects_millimetre(self):
+        from backend.app.step_mesh import detect_step_unit
+
+        content = b"#10=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );"
+        self.assertEqual(detect_step_unit(content), "mm")
+
+    def test_detects_metre_and_inch(self):
+        from backend.app.step_mesh import detect_step_unit
+
+        self.assertEqual(detect_step_unit(b"( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT($,.METRE.) )"), "m")
+        inch = b"#5=( CONVERSION_BASED_UNIT('INCH',#6) LENGTH_UNIT() NAMED_UNIT(#7) );"
+        self.assertEqual(detect_step_unit(inch), "inch")
+
+    def test_unknown_unit_returns_none(self):
+        from backend.app.step_mesh import detect_step_unit
+
+        self.assertIsNone(detect_step_unit(b"ISO-10303-21; no unit here"))
+
+    def test_quality_to_deflection_is_relative_to_size(self):
+        from backend.app.step_mesh import linear_deflection_for
+
+        standard = linear_deflection_for(100.0, "standard")
+        self.assertGreater(linear_deflection_for(100.0, "coarse"), standard)
+        self.assertLess(linear_deflection_for(100.0, "fine"), standard)
+        self.assertAlmostEqual(linear_deflection_for(200.0, "standard"), standard * 2)
+        with self.assertRaises(ValueError):
+            linear_deflection_for(100.0, "ultra")
+
+
+@unittest.skipUnless(HAS_OCP, "requirements-3d.txt が未導入")
+class TestStepConversion(unittest.TestCase):
+    def test_load_and_tessellate_pair_with_same_deflection(self):
+        from backend.app.step_mesh import load_step_pair_as_meshes
+
+        result = load_step_pair_as_meshes(
+            STEP_SAMPLES_DIR / "hole_position_a.step",
+            STEP_SAMPLES_DIR / "hole_position_b.step",
+            quality="standard",
+        )
+        self.assertGreater(result.linear_deflection, 0)
+        for side in (result.old, result.new):
+            # 新旧で同じ精度値を使ったことを記録している
+            self.assertEqual(side.linear_deflection, result.linear_deflection)
+            self.assertEqual(side.vertices.shape[1], 3)
+            self.assertEqual(side.faces.shape[1], 3)
+            self.assertGreater(len(side.faces), 10)
+            self.assertEqual(side.unit, "mm")
+            self.assertGreaterEqual(side.solid_count, 1)
+        # サンプルの板は 100 x 60 x 10 mm
+        extents = result.old.vertices.max(axis=0) - result.old.vertices.min(axis=0)
+        np.testing.assert_allclose(sorted(extents), [10, 60, 100], atol=0.05)
+
+    def test_inch_file_is_converted_to_mm_and_warned(self):
+        from backend.app.step_mesh import load_step_pair_as_meshes
+
+        result = load_step_pair_as_meshes(
+            STEP_SAMPLES_DIR / "unit_inch_a.step",
+            STEP_SAMPLES_DIR / "unit_inch_b.step",
+            quality="coarse",
+        )
+        self.assertEqual(result.old.unit, "mm")
+        self.assertEqual(result.new.unit, "inch")
+        ext_a = result.old.vertices.max(axis=0) - result.old.vertices.min(axis=0)
+        ext_b = result.new.vertices.max(axis=0) - result.new.vertices.min(axis=0)
+        # OCCTが読み込み時にmmへ換算するため寸法は一致する
+        np.testing.assert_allclose(ext_a, ext_b, atol=0.05)
+        self.assertTrue(any("単位" in warning for warning in result.warnings))
+
+    def test_explicit_deflection_overrides_quality(self):
+        from backend.app.step_mesh import load_step_pair_as_meshes
+
+        result = load_step_pair_as_meshes(
+            STEP_SAMPLES_DIR / "dimension_a.step",
+            STEP_SAMPLES_DIR / "dimension_b.step",
+            quality="standard",
+            linear_deflection=0.25,
+        )
+        self.assertAlmostEqual(result.linear_deflection, 0.25)
+
+    def test_invalid_step_raises_readable_error(self):
+        import tempfile
+
+        from backend.app.step_mesh import StepConversionError, load_step_pair_as_meshes
+
+        with tempfile.TemporaryDirectory() as tmp:
+            broken = Path(tmp) / "broken.step"
+            broken.write_bytes(b"ISO-10303-21;\nHEADER;\nthis is not valid\n")
+            with self.assertRaises(StepConversionError) as ctx:
+                load_step_pair_as_meshes(broken, STEP_SAMPLES_DIR / "dimension_b.step")
+            self.assertIn("旧ファイル", str(ctx.exception))
+            self.assertIn("broken.step", str(ctx.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
