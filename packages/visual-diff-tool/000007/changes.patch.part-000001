diff --git a/tests/test_cad_views.py b/tests/test_cad_views.py
new file mode 100644
index 0000000000000000000000000000000000000000..151caa4291130507fdd62acba389bece37e4d901
--- /dev/null
+++ b/tests/test_cad_views.py
@@ -0,0 +1,198 @@
+"""
+Markdown内の3D表示（```step / ```cad）の読み取りと、Git差分で画像として比べるためのAPIのテスト。
+"""
+
+import os
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+from io import BytesIO
+
+from fastapi.testclient import TestClient
+from PIL import Image
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "backend"))
+
+from app.cad_views import cad_view_summaries, extract_cad_views, pair_cad_views, parse_cad_view_block  # noqa: E402
+from app.main import app  # noqa: E402
+from app.mesh_jobs import check_3d_availability  # noqa: E402
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+NOTE_HEAD = """# note
+```step
+path: models/part.step
+name: 部品
+width: 600
+height: 400
+camera:
+  position: [10, -200, 150]
+  target: [10, 0, 20]
+  zoom: 1
+  viewHeight: 120
+annotations:
+  - id: a1
+    x: 1
+    y: 2
+    z: 3
+    text: 旧の注記
+    leader: true
+    ox: 90
+    oy: -60
+```
+"""
+
+NOTE_CURRENT = NOTE_HEAD.replace("旧の注記", "新しい注記") + """
+- list
+  ```cad
+  path: "[[bracket.stl|L金具]]"
+  name: 金具
+  ```
+"""
+
+STL = b"""solid t
+facet normal 0 0 1
+ outer loop
+  vertex 0 0 0
+  vertex 10 0 0
+  vertex 0 10 0
+ endloop
+endfacet
+endsolid t
+"""
+
+
+class CadViewParsingTest(unittest.TestCase):
+    def test_reads_yaml_settings_like_the_plugin(self):
+        views = extract_cad_views(NOTE_HEAD)
+        self.assertEqual(len(views), 1)
+        config = views[0]["config"]
+        self.assertEqual(config["path"], "models/part.step")
+        self.assertEqual((config["width"], config["height"]), (600, 400))
+        self.assertEqual(config["camera"]["viewHeight"], 120.0)
+        self.assertEqual(config["annotations"][0]["text"], "旧の注記")
+        self.assertEqual(config["annotations"][0]["color"], "#ffc531")  # 既定のカテゴリ色
+
+    def test_blocks_in_lists_and_callouts_and_wikilinks(self):
+        text = "> [!note]\n> ```step\n> path: a/b.step\n> ```\n" + NOTE_CURRENT
+        summaries = cad_view_summaries(text)
+        self.assertEqual([item["model"] for item in summaries], ["b.step", "part.step", "bracket.stl"])
+
+    def test_legacy_line_format(self):
+        self.assertEqual(parse_cad_view_block("models/x.stp\nheight: 300"), {"path": "models/x.stp", "height": 300})
+
+    def test_name_becomes_key_and_duplicates_are_distinguished(self):
+        text = "```step\npath: a.step\nname: 正面\n```\n```step\npath: b.step\n```\n```step\npath: c.step\nname: 正面\n```\n"
+        self.assertEqual([view["key"] for view in extract_cad_views(text)], ["正面", "#2", "正面 (2)"])
+
+    def test_pairs_by_name_even_when_blocks_are_reordered(self):
+        head = extract_cad_views("```step\npath: a.step\nname: A\n```\n```step\npath: b.step\nname: B\n```\n")
+        current = extract_cad_views("```step\npath: b.step\nname: B\n```\n```step\npath: c.step\nname: C\n```\n```step\npath: a.step\nname: A\n```\n")
+        pairs = {(p["head"] and p["head"]["key"], p["current"] and p["current"]["key"]): p["paired_by"] for p in pair_cad_views(head, current)}
+        self.assertEqual(pairs, {("B", "B"): "name", ("A", "A"): "name", (None, "C"): None})
+
+    def test_unnamed_head_blocks_pair_by_order_but_different_names_do_not(self):
+        head = extract_cad_views("```step\npath: a.step\n```\n```step\npath: b.step\nname: old\n```\n")
+        current = extract_cad_views("```step\npath: a.step\nname: 3D-1\n```\n```step\npath: b.step\nname: new\n```\n")
+        pairs = {(p["head"] and p["head"]["key"], p["current"] and p["current"]["key"]): p["paired_by"] for p in pair_cad_views(head, current)}
+        self.assertEqual(pairs, {("#1", "3D-1"): "order", (None, "new"): None, ("old", None): None})
+
+    def test_other_code_blocks_are_ignored(self):
+        self.assertEqual(extract_cad_views("```python\npath: a.step\n```\n```3d\npath: b.step\n```"), [])
+
+
+class CadViewApiTest(unittest.TestCase):
+    def setUp(self):
+        os.environ["VISUAL_DIFF_OPEN_BROWSER"] = "0"
+        self.client = TestClient(app)
+        self.tmp = tempfile.TemporaryDirectory()
+        self.repo = self.tmp.name
+        self.git("init")
+        os.makedirs(os.path.join(self.repo, "models"))
+        with open(os.path.join(ROOT, "samples", "step", "dimension_a.step"), "rb") as src:
+            self.step = src.read()
+        self.write("models/part.step", self.step)
+        self.write("bracket.stl", STL)
+        self.write("note.md", NOTE_HEAD.encode())
+        self.git("add", ".")
+        self.git("commit", "-m", "base")
+        self.write("note.md", NOTE_CURRENT.encode())
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def git(self, *args):
+        subprocess.run(["git", "-C", self.repo, "-c", "user.name=t", "-c", "user.email=t@example.com", *args], check=True, capture_output=True)
+
+    def write(self, rel, content):
+        with open(os.path.join(self.repo, rel), "wb") as file:
+            file.write(content)
+
+    def test_listing_reports_views_of_changed_notes(self):
+        body = self.client.post("/api/git/files", json={"folder": self.repo, "text_extensions": [".md"]}).json()
+        note = next(item for item in body["files"] if item["path"] == "note.md")
+        self.assertEqual(
+            note["cad_views"],
+            [
+                {"key": "部品", "name": "部品", "index": 0, "model": "part.step"},
+                {"key": "金具", "name": "金具", "index": 1, "model": "bracket.stl"},
+            ],
+        )
+
+    @unittest.skipUnless(check_3d_availability()["available"], "3D libraries are not installed")
+    def test_same_model_is_meshed_once_for_both_sides(self):
+        response = self.client.post("/api/git/cad-view/jobs", json={"folder": self.repo, "path": "note.md", "key": "部品"})
+        self.assertEqual(response.status_code, 202, response.text)
+        body = response.json()
+        self.assertEqual(body["paired_by"], "name")
+        self.assertTrue(body["same_model"])
+        self.assertEqual((body["head"]["mesh_side"], body["current"]["mesh_side"]), ("new", "new"))
+        self.assertEqual(body["head"]["config"]["annotations"][0]["text"], "旧の注記")
+        self.assertEqual(body["current"]["config"]["annotations"][0]["text"], "新しい注記")
+        self.assertNotIn("content", body["head"])
+        for _ in range(200):
+            status = self.client.get(f"/api/3d/jobs/{body['job_id']}").json()
+            if status["status"] in ("done", "error"):
+                break
+            time.sleep(0.1)
+        self.assertEqual(status["status"], "done", status)
+        self.assertEqual(self.client.get(f"/api/3d/jobs/{body['job_id']}/mesh/new").status_code, 200)
+        self.client.delete(f"/api/3d/jobs/{body['job_id']}")
+
+    def test_view_added_in_working_tree_has_only_current_side(self):
+        body = self.client.post("/api/git/cad-view/jobs", json={"folder": self.repo, "path": "note.md", "key": "金具"}).json()
+        self.assertIsNone(body["job_id"])
+        self.assertIn("「金具」の3D表示がありません", body["head"]["error"])
+        self.assertEqual(body["current"]["model_format"], "stl")
+        model = self.client.post("/api/git/cad-view/model", json={"folder": self.repo, "path": body["current"]["model_path"]})
+        self.assertEqual(model.content, STL)
+
+    def test_model_endpoint_rejects_other_files(self):
+        response = self.client.post("/api/git/cad-view/model", json={"folder": self.repo, "path": "note.md"})
+        self.assertEqual(response.status_code, 400)
+
+    def test_missing_view_is_404(self):
+        response = self.client.post("/api/git/cad-view/jobs", json={"folder": self.repo, "path": "note.md", "key": "無い名前"})
+        self.assertEqual(response.status_code, 404)
+
+    def test_rendered_images_are_compared_without_opening_a_browser(self):
+        def png(color):
+            buffer = BytesIO()
+            image = Image.new("RGB", (200, 120), "white")
+            image.paste(color, (40, 40, 90, 80))
+            image.save(buffer, format="PNG")
+            return buffer.getvalue()
+
+        response = self.client.post(
+            "/api/git/cad-view/diff",
+            files={"file_a": ("a.png", png((0, 0, 0)), "image/png"), "file_b": ("b.png", png((200, 0, 0)), "image/png")},
+            data={"category": "図面"},
+        )
+        self.assertEqual(response.status_code, 200, response.text)
+        self.assertGreater(response.json()["diff_pixels"], 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_git_commit.py b/tests/test_git_commit.py
new file mode 100644
index 0000000000000000000000000000000000000000..872e08532bf7cfa07ea4698d5ac63efd2a3e436e
--- /dev/null
+++ b/tests/test_git_commit.py
@@ -0,0 +1,110 @@
+"""
+Git差分画面からのコミット／push API（POST /api/git/commit）のテスト。
+- 選んだファイルだけをコミットする（未追跡・削除・リネームを含む。別にstage済みのファイルは巻き込まない）
+- 変更一覧にないパス・空のメッセージ・空の選択は拒否する
+- push=true ならリモートへ送り、アップストリーム未設定でもリモートが1つなら設定する
+"""
+
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+from fastapi.testclient import TestClient
+
+from backend.app.main import app
+
+
+def _git(cwd: Path, *args: str) -> str:
+    return subprocess.run(["git", "-C", str(cwd), *args], check=True, capture_output=True, text=True).stdout
+
+
+class TestGitCommit(unittest.TestCase):
+    def setUp(self):
+        self.client = TestClient(app)
+        self.temp_dir = tempfile.TemporaryDirectory()
+        root = Path(self.temp_dir.name)
+        self.remote = root / "remote.git"
+        self.repo = root / "work"
+        self.remote.mkdir()
+        self.repo.mkdir()
+        _git(self.remote, "init", "--quiet", "--bare")
+        _git(self.repo, "init", "--quiet", "-b", "main")
+        _git(self.repo, "config", "user.email", "test@example.com")
+        _git(self.repo, "config", "user.name", "Tester")
+        for name in ("a.md", "b.md", "old.md", "gone.md", "staged.md"):
+            (self.repo / name).write_text(f"{name}\n", encoding="utf-8")
+        _git(self.repo, "add", ".")
+        _git(self.repo, "commit", "--quiet", "-m", "base")
+        _git(self.repo, "remote", "add", "origin", str(self.remote))
+
+    def tearDown(self):
+        self.temp_dir.cleanup()
+
+    def _post(self, paths, message="メッセージ\n\n本文", **extra):
+        return self.client.post(
+            "/api/git/commit",
+            json={"folder": str(self.repo), "paths": paths, "message": message, "text_extensions": [".md"], **extra},
+        )
+
+    def test_commits_only_selected_files(self):
+        (self.repo / "a.md").write_text("changed\n", encoding="utf-8")
+        (self.repo / "b.md").write_text("changed\n", encoding="utf-8")
+        (self.repo / "new.md").write_text("new\n", encoding="utf-8")
+        (self.repo / "gone.md").unlink()
+        _git(self.repo, "mv", "old.md", "renamed.md")
+        (self.repo / "staged.md").write_text("staged\n", encoding="utf-8")
+        _git(self.repo, "add", "staged.md")
+
+        response = self._post(["a.md", "new.md", "gone.md", "renamed.md"])
+        self.assertEqual(response.status_code, 200, response.text)
+        body = response.json()
+        self.assertTrue(body["commit"])
+        self.assertFalse(body["pushed"])
+
+        show = _git(self.repo, "show", "--name-status", "--format=%B", "HEAD")
+        self.assertIn("メッセージ", show)
+        self.assertIn("本文", show)
+        committed = {line.split("\t", 1)[-1] for line in show.splitlines() if "\t" in line}
+        self.assertTrue({"a.md", "new.md", "gone.md"} <= committed, show)
+        self.assertNotIn("b.md", committed)
+        self.assertNotIn("staged.md", committed)
+        # 選ばなかった変更は作業ツリーに残り、別にstage済みの変更もstageのまま。
+        status = _git(self.repo, "status", "--porcelain")
+        self.assertIn(" M b.md", status)
+        self.assertIn("M  staged.md", status)
+
+    def test_rejects_unlisted_path_empty_message_and_empty_selection(self):
+        (self.repo / "a.md").write_text("changed\n", encoding="utf-8")
+        head = _git(self.repo, "rev-parse", "HEAD")
+        self.assertEqual(self._post(["b.md"]).status_code, 409)
+        self.assertEqual(self._post(["a.md"], message="  \n").status_code, 422)
+        self.assertEqual(self._post([]).status_code, 422)
+        self.assertEqual(self._post(["../outside.md"]).status_code, 409)
+        self.assertEqual(_git(self.repo, "rev-parse", "HEAD"), head)
+
+    def test_push_sets_upstream_with_single_remote(self):
+        (self.repo / "a.md").write_text("changed\n", encoding="utf-8")
+        response = self._post(["a.md"], push=True)
+        self.assertEqual(response.status_code, 200, response.text)
+        body = response.json()
+        self.assertTrue(body["pushed"], body)
+        self.assertEqual(_git(self.remote, "rev-parse", "main").strip(), _git(self.repo, "rev-parse", "HEAD").strip())
+
+        # 2回目はアップストリーム設定済みの通常のpush。
+        (self.repo / "b.md").write_text("changed\n", encoding="utf-8")
+        self.assertTrue(self._post(["b.md"], push=True).json()["pushed"])
+
+    def test_push_failure_keeps_commit(self):
+        _git(self.repo, "remote", "set-url", "origin", str(self.remote) + "-missing")
+        (self.repo / "a.md").write_text("changed\n", encoding="utf-8")
+        response = self._post(["a.md"], push=True)
+        self.assertEqual(response.status_code, 200, response.text)
+        body = response.json()
+        self.assertFalse(body["pushed"])
+        self.assertTrue(body["push_error"])
+        self.assertEqual(_git(self.repo, "log", "-1", "--format=%h").strip(), body["commit"])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_performance_and_parallel.py b/tests/test_performance_and_parallel.py
index d05533d676e7c74761d6fc7ff987460170e427ba..f6ddfb235fbaa2089fcdb1d1f68942c7e2e8fa7b 100644
--- a/tests/test_performance_and_parallel.py
+++ b/tests/test_performance_and_parallel.py
@@ -6,6 +6,7 @@ Git差分処理の高速化（無駄な繰り返しの排除・ピンポイン
 
 import subprocess
 import tempfile
+import time
 import unittest
 from pathlib import Path
 from unittest.mock import patch
@@ -266,6 +267,48 @@ class TestGitLaunchReduction(unittest.TestCase):
             self.assertIn("tracked.png", related)
             self.assertIn("ignored_dir/hidden.png", related)
 
+    def test_line_opcodes_splits_long_diffs_with_many_changes_at_unique_lines(self):
+        from backend.app.text_diff import line_opcodes
+
+        old = [f"line number {index}" for index in range(30_000)]
+        new = list(old)
+        for index in range(0, 30_000, 3):
+            new[index] = f"line number {index} changed"
+
+        started = time.perf_counter()
+        opcodes = line_opcodes(old, new)
+        elapsed = time.perf_counter() - started
+
+        # 分割しないと10秒以上かかる入力。遅いPCでも収まる余裕を持たせて確認する。
+        self.assertLess(elapsed, 2.0)
+        rebuilt_old = [line for _, i1, i2, _, _ in opcodes for line in old[i1:i2]]
+        rebuilt_new = [line for _, _, _, j1, j2 in opcodes for line in new[j1:j2]]
+        self.assertEqual(rebuilt_old, old)
+        self.assertEqual(rebuilt_new, new)
+        for tag, i1, i2, j1, j2 in opcodes:
+            if tag == "equal":
+                self.assertEqual(old[i1:i2], new[j1:j2])
+        self.assertEqual(sum(i2 - i1 for tag, i1, i2, _, _ in opcodes if tag == "equal"), 20_000)
+
+    def test_line_opcodes_keeps_sequence_matcher_result_for_ordinary_diffs(self):
+        import difflib
+
+        from backend.app.text_diff import _is_trivial_line, line_opcodes
+
+        old = [f"line {index}" for index in range(3_000)]
+        new = list(old)
+        new[10] = "changed near the top"
+        new[2_000:2_000] = ["inserted"]
+        del new[2_500]
+
+        expected = difflib.SequenceMatcher(_is_trivial_line, old, new, autojunk=True).get_opcodes()
+        self.assertEqual(sum(i2 - i1 for tag, i1, i2, _, _ in line_opcodes(old, new) if tag == "equal"),
+                         sum(i2 - i1 for tag, i1, i2, _, _ in expected if tag == "equal"))
+        self.assertEqual(
+            [opcode for opcode in line_opcodes(old, new) if opcode[0] != "equal"],
+            [opcode for opcode in expected if opcode[0] != "equal"],
+        )
+
     def test_line_opcodes_with_trimmed_context_reconstructs_both_sides(self):
         import random
 
diff --git a/tests/test_webp_support.py b/tests/test_webp_support.py
new file mode 100644
index 0000000000000000000000000000000000000000..49936dc43026331a71ffe8e44450504a62955c8d
--- /dev/null
+++ b/tests/test_webp_support.py
@@ -0,0 +1,173 @@
+"""
+WebP画像の差分テスト仕様。
+Obsidian Image Converter が作るWebP（不可逆・可逆・透過・アニメーション）を比較できること、
+Git差分で一覧・比較できること、PNGからWebPへの変換が削除＋新規に分かれず1件の変更になることを検証する。
+"""
+
+import io
+import os
+import subprocess
+import tempfile
+import unittest
+
+from fastapi.testclient import TestClient
+from PIL import Image, ImageDraw
+
+from backend.app.main import app
+
+
+def drawing(*, changed: bool = False, mode: str = "RGB") -> Image.Image:
+    image = Image.new(mode, (200, 150), "white")
+    draw = ImageDraw.Draw(image)
+    draw.rectangle((20, 20, 80, 70), fill="black")
+    if changed:
+        draw.ellipse((120, 80, 180, 140), fill="blue")
+    return image
+
+
+def encode(image: Image.Image, **options) -> bytes:
+    buffer = io.BytesIO()
+    image.save(buffer, **options)
+    return buffer.getvalue()
+
+
+class TestWebpUpload(unittest.TestCase):
+    def setUp(self):
+        self.client = TestClient(app)
+
+    def _diff(self, content_a: bytes, content_b: bytes, name_a: str = "a.webp", name_b: str = "b.webp"):
+        return self.client.post(
+            "/api/diff",
+            files={
+                "file_a": (name_a, content_a, "application/octet-stream"),
+                "file_b": (name_b, content_b, "application/octet-stream"),
+            },
+        )
+
+    def test_analyze_reports_webp_format_and_size(self):
+        response = self.client.post(
+            "/api/analyze",
+            files={"file": ("a.webp", encode(drawing(), format="WEBP"), "image/webp")},
+        )
+        self.assertEqual(response.status_code, 200, response.text)
+        body = response.json()
+        self.assertEqual(body["format"], "webp")
+        self.assertEqual((body["pages"][0]["width"], body["pages"][0]["height"]), (200, 150))
+
+    def test_diff_detects_changes_in_each_webp_encoding(self):
+        encodings = {
+            "lossy": ("RGB", {"quality": 80}),
+            "lossless": ("RGB", {"lossless": True}),
+            "alpha": ("RGBA", {"quality": 80}),
+        }
+        for name, (mode, options) in encodings.items():
+            with self.subTest(name):
+                response = self._diff(
+                    encode(drawing(mode=mode), format="WEBP", **options),
+                    encode(drawing(changed=True, mode=mode), format="WEBP", **options),
+                )
+                self.assertEqual(response.status_code, 200, response.text)
+                self.assertGreater(response.json()["diff_ratio"], 0.01)
+
+    def test_animated_webp_compares_first_frame(self):
+        animated = encode(drawing(), format="WEBP", save_all=True, append_images=[drawing(changed=True)], duration=100)
+        response = self._diff(animated, encode(drawing(), format="WEBP", lossless=True))
+        self.assertEqual(response.status_code, 200, response.text)
+        self.assertLess(response.json()["diff_ratio"], 0.01)
+
+    def test_uppercase_extension_and_png_comparison(self):
+        response = self._diff(encode(drawing(), format="PNG"), encode(drawing(), format="WEBP", lossless=True), "a.png", "B.WEBP")
+        self.assertEqual(response.status_code, 200, response.text)
+        self.assertEqual(response.json()["diff_ratio"], 0)
+
+
+class TestWebpGit(unittest.TestCase):
+    def setUp(self):
+        self.client = TestClient(app)
+        self._tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self._tmp.cleanup)
+        self.repo = self._tmp.name
+        self._git("init", "--quiet")
+        self._git("config", "user.email", "review@example.com")
+        self._git("config", "user.name", "Review")
+
+    def _git(self, *args: str) -> None:
+        subprocess.run(["git", "-C", self.repo, *args], check=True, capture_output=True)
+
+    def _write(self, name: str, content: bytes) -> None:
+        path = os.path.join(self.repo, name)
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with open(path, "wb") as file:
+            file.write(content)
+
+    def _commit(self) -> None:
+        self._git("add", "-A")
+        self._git("commit", "--quiet", "-m", "initial")
+
+    def _files(self) -> dict[str, dict]:
+        response = self.client.post("/api/git/files", json={"folder": self.repo})
+        self.assertEqual(response.status_code, 200, response.text)
+        return {item["path"]: item for item in response.json()["files"]}
+
+    def test_modified_webp_is_compared_with_head(self):
+        self._write("assets/figure.webp", encode(drawing(), format="WEBP"))
+        self._commit()
+        self._write("assets/figure.webp", encode(drawing(changed=True), format="WEBP"))
+
+        item = self._files()["assets/figure.webp"]
+        self.assertEqual(item["kind"], "image")
+        response = self.client.post("/api/git/diff", json={"folder": self.repo, **item})
+        self.assertEqual(response.status_code, 200, response.text)
+        self.assertGreater(response.json()["diff_ratio"], 0.01)
+
+    def test_new_webp_shows_single_side_preview(self):
+        self._write("seed.txt", b"seed")
+        self._commit()
+        self._write("pasted.webp", encode(drawing(), format="WEBP"))
+
+        item = self._files()["pasted.webp"]
+        self.assertEqual(item["change_type"], "untracked")
+        response = self.client.post("/api/git/item", json={"folder": self.repo, **item})
+        self.assertEqual(response.status_code, 200, response.text)
+        self.assertIsNotNone(response.json()["image_current"])
+
+    def test_png_converted_to_webp_is_one_comparable_change(self):
+        self._write("assets/figure.png", encode(drawing(), format="PNG"))
+        self._commit()
+        os.remove(os.path.join(self.repo, "assets/figure.png"))
+        self._write("assets/figure.webp", encode(drawing(), format="WEBP", lossless=True))
+
+        files = self._files()
+        self.assertNotIn("assets/figure.png", files)
+        item = files["assets/figure.webp"]
+        self.assertEqual(item["head_path"], "assets/figure.png")
+        self.assertEqual(item["change_type"], "renamed")
+        self.assertTrue(item["has_head"])
+        self.assertTrue(item["diffable"])
+
+        response = self.client.post("/api/git/diff", json={"folder": self.repo, **item})
+        self.assertEqual(response.status_code, 200, response.text)
+        self.assertEqual(response.json()["diff_ratio"], 0)
+
+    def test_conversion_is_not_paired_when_the_source_is_unclear(self):
+        self._write("figure.png", encode(drawing(), format="PNG"))
+        self._write("figure.jpg", encode(drawing(), format="JPEG"))
+        self._write("other/figure.bmp", encode(drawing(), format="BMP"))
+        self._write("diagram.svg", b'<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10"/>')
+        self._commit()
+        for name in ("figure.png", "figure.jpg", "other/figure.bmp", "diagram.svg"):
+            os.remove(os.path.join(self.repo, name))
+        self._write("figure.webp", encode(drawing(), format="WEBP"))
+        self._write("diagram.webp", encode(drawing(), format="WEBP"))
+
+        files = self._files()
+        self.assertEqual(files["figure.webp"]["change_type"], "untracked")
+        self.assertEqual(files["figure.png"]["change_type"], "deleted")
+        self.assertEqual(files["figure.jpg"]["change_type"], "deleted")
+        self.assertEqual(files["other/figure.bmp"]["change_type"], "deleted")
+        self.assertEqual(files["diagram.webp"]["change_type"], "untracked")
+        self.assertEqual(files["diagram.svg"]["change_type"], "deleted")
+
+
+if __name__ == "__main__":
+    unittest.main()
