+  assert.equal(meshBoundingBox({ new: side, old: side }), box);
+  assert.equal(meshBoundingBox({ new: side }), box);
+  assert.equal(meshBoundingBox({ old: side }), box);
+  assert.equal(meshBoundingBox({ old: { geometry: {} } }), null);
+  assert.equal(meshBoundingBox(null), null);
+});
