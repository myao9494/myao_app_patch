+MAX_COMMIT_MESSAGE_CHARS = 10_000
+GIT_PUSH_TIMEOUT_SECONDS = 60
+
+
+def _run_git_write(repo: Path, args: list[str], *, timeout: int = 30, input_text: str | None = None, env: dict | None = None) -> str:
+    """index・履歴・リモートを書き換えるgit操作を実行する。失敗時はgitのメッセージ付きで422にする。"""
+    try:
+        completed = run_git_process(
+            repo,
+            args,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+            safe_directory=repo,
+            input=input_text,
+            env=env,
+        )
+    except subprocess.TimeoutExpired as exc:
+        raise HTTPException(status_code=504, detail="gitコマンドがタイムアウトしました") from exc
+    if completed.returncode != 0:
+        detail = (completed.stderr or completed.stdout or "").strip() or "git command failed"
+        raise HTTPException(status_code=422, detail=detail)
+    return completed.stdout or ""
+
+
+def commit_paths(repo: Path, paths: list[str], message: str) -> str:
+    """指定パスだけをコミットし、短いコミットIDを返す。
+
+    - 未追跡・削除・リネームを含めて `add -A` で対象パスのindexを更新してから、
+      `commit --only -- <paths>` でそのパスだけをコミットする。すでにstage済みの別ファイルは巻き込まない。
+    - メッセージは標準入力（-F -）で渡し、改行や日本語がコマンドライン長・文字コードに左右されないようにする。
+    """
+    # 作業ツリーに無いパス（削除・リネーム前）は `add` だと「該当なし」で失敗するため、index側から外す。
+    present = [path for path in paths if os.path.lexists(repo / path)]
+    missing = [path for path in paths if path not in present]
+    if present:
+        _run_git_write(repo, ["add", "-A", "--", *present])
+    if missing:
+        _run_git_write(repo, ["rm", "--cached", "--quiet", "--ignore-unmatch", "--", *missing])
+    _run_git_write(repo, ["commit", "--quiet", "-F", "-", "--only", "--", *paths], input_text=message)
+    return _run_git_write(repo, ["rev-parse", "--short", "HEAD"]).strip()
+
+
+def push_current_branch(repo: Path) -> str:
+    """現在のブランチをpushする。アップストリーム未設定ならリモートが1つのときだけ `-u` で設定して送る。
+
+    認証入力待ちでサーバーが固まらないよう、端末への問い合わせは無効にして時間も区切る。
+    """
+    env = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}
+    has_upstream = subprocess.run(
+        git_command(repo, ["rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}"], safe_directory=repo),
+        capture_output=True,
+        timeout=10,
+    ).returncode == 0
+    if has_upstream:
+        args = ["push"]
+    else:
+        remotes = _run_git_write(repo, ["remote"]).split()
+        if len(remotes) != 1:
+            raise HTTPException(status_code=422, detail="pushするリモートを決められません（アップストリーム未設定）。先に `git push -u <remote> <branch>` を実行してください")
+        args = ["push", "-u", remotes[0], "HEAD"]
+    # pushの進捗・結果はstderrに出るため、成功時もstderrを返す。
+    try:
+        completed = run_git_process(repo, args, capture_output=True, text=True, timeout=GIT_PUSH_TIMEOUT_SECONDS, safe_directory=repo, env=env)
+    except subprocess.TimeoutExpired as exc:
+        raise HTTPException(status_code=504, detail="pushがタイムアウトしました（認証が必要な可能性があります）") from exc
+    if completed.returncode != 0:
+        raise HTTPException(status_code=422, detail=(completed.stderr or completed.stdout or "").strip() or "git push failed")
+    return (completed.stderr or completed.stdout or "").strip()
+
+
 def run_git_process(
     cwd: Path,
     args: list[str],
