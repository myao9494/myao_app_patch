diff --git a/frontend/src/cad-view/cadViewDiff.js b/frontend/src/cad-view/cadViewDiff.js
new file mode 100644
index 0000000000000000000000000000000000000000..bb3684b71de71c9ff8c7af2a35517f1a1ed18fac
--- /dev/null
+++ b/frontend/src/cad-view/cadViewDiff.js
@@ -0,0 +1,108 @@
+/**
+ * Git差分で、Markdown内の3D表示（```step / ```cad）を HEAD と作業ツリーで画像として比べる。
+ * 対応づけはコードブロックの name（無ければ出現順）で、バックエンドが行う。
+ * 1. /api/git/cad-view/jobs で両側の表示設定とモデルの読み方を受け取る（STEPはメッシュ化ジョブ、STL / OBJ はファイル）
+ * 2. ブラウザーで両側の絵を描き（renderCadView.js）、/api/git/cad-view/diff で通常の画像差分にかける
+ * 3. 片側しか描けないとき（ノートの新規・3D表示の追加・モデルが見つからない）は、描けた側だけを返す
+ * 比べるのはノートに見えている絵なので、形状の差に加えて、注記・視点・断面の変更も差分になる。
+ */
+import { API_BASE, postForm, postJson } from "../lib/api.js";
+import { parseVdm1 } from "../three-diff/vdm1.js";
+
+const JOB_POLL_INTERVAL_MS = 400;
+const JOB_TIMEOUT_MS = 10 * 60 * 1000;
+
+/**
+ * @returns {Promise<{result: object|null, item: object|null}>} 両側を描けたら result（DiffResponse）、
+ *   片側だけなら item（image_head / image_current と、描けなかった理由 head_error / current_error）
+ */
+export async function loadCadViewComparison({ folder, file, viewKey, category, diffThreshold, anchor }) {
+  const job = await postJson("/git/cad-view/jobs", {
+    folder,
+    path: file.path,
+    head_path: file.head_path,
+    has_head: file.has_head,
+    has_current: file.has_current,
+    key: viewKey,
+  });
+  const geometries = {};
+  try {
+    if (job.job_id) await waitForJob(job.job_id);
+    const render = await import("./renderCadView.js");
+    for (const sideName of ["head", "current"]) {
+      const side = job[sideName];
+      if (!side?.model_format) continue;
+      geometries[sideName] = await loadGeometry(render, job, side, sideName, folder);
+    }
+    const images = {};
+    for (const sideName of ["head", "current"]) {
+      if (geometries[sideName]) images[sideName] = await render.renderCadViewImage(geometries[sideName], job[sideName].config);
+    }
+    const warnings = ["head", "current"].map((name) => job[name]?.error).filter(Boolean);
+    if (job.paired_by === "order") {
+      warnings.push(`変更前と変更後の片方に name が無いため、「${viewKey}」は出現順で対応づけました`);
+    }
+    if (images.head && images.current) {
+      const form = new FormData();
+      form.append("file_a", images.head, `HEAD:${file.head_path}#${viewKey}.png`);
+      form.append("file_b", images.current, `${file.path}#${viewKey}.png`);
+      form.append("category", category);
+      form.append("diff_threshold", String(diffThreshold));
+      if (anchor?.region) form.append("anchor_region", JSON.stringify(anchor.region));
+      if (anchor?.region && anchor.regionB) form.append("anchor_region_b", JSON.stringify(anchor.regionB));
+      const result = await postForm("/git/cad-view/diff", form);
+      return { result: { ...result, conversion_warnings: [...warnings, ...(result.conversion_warnings ?? [])] }, item: null };
+    }
+    return {
+      result: null,
+      item: {
+        image_head: images.head ? await imagePayload(images.head) : null,
+        image_current: images.current ? await imagePayload(images.current) : null,
+        head_error: job.head?.error ?? (job.head ? null : "変更前のノートはありません"),
+        current_error: job.current?.error ?? (job.current ? null : "変更後のノートはありません"),
+      },
+    };
+  } finally {
+    Object.values(geometries).forEach((geometry) => geometry.dispose());
+    // メッシュは描き終えたら不要なので、サーバーの計算結果もすぐ消す
+    if (job.job_id) fetch(`${API_BASE}/3d/jobs/${encodeURIComponent(job.job_id)}`, { method: "DELETE" }).catch(() => {});
+  }
+}
+
+async function waitForJob(jobId) {
+  const started = Date.now();
+  while (Date.now() - started < JOB_TIMEOUT_MS) {
+    const response = await fetch(`${API_BASE}/3d/jobs/${encodeURIComponent(jobId)}`);
+    if (!response.ok) throw new Error("3D表示のメッシュ化の状況を取得できませんでした");
+    const status = await response.json();
+    if (status.status === "done") return status;
+    if (status.status === "error") throw new Error(status.error || "3D表示のモデルをメッシュ化できませんでした");
+    await new Promise((resolve) => window.setTimeout(resolve, JOB_POLL_INTERVAL_MS));
+  }
+  throw new Error("3D表示のメッシュ化が時間内に終わりませんでした");
+}
+
+async function loadGeometry(render, job, side, sideName, folder) {
+  if (side.model_format === "step") {
+    const response = await fetch(`${API_BASE}/3d/jobs/${encodeURIComponent(job.job_id)}/mesh/${side.mesh_side}`);
+    if (!response.ok) throw new Error("3D表示のメッシュを取得できませんでした");
+    return render.geometryFromVdm1(parseVdm1(await response.arrayBuffer()));
+  }
+  const response = await fetch(`${API_BASE}/git/cad-view/model`, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ folder, path: side.model_path, side: sideName }),
+  });
+  if (!response.ok) throw new Error(`3D表示のモデルを読めませんでした: ${side.model_path}`);
+  return render.geometryFromModelFile(side.model_format, await response.arrayBuffer());
+}
+
+async function imagePayload(blob) {
+  const dataUrl = await new Promise((resolve, reject) => {
+    const reader = new FileReader();
+    reader.onload = () => resolve(reader.result);
+    reader.onerror = () => reject(reader.error);
+    reader.readAsDataURL(blob);
+  });
+  return { mime_type: "image/png", data: String(dataUrl).split(",")[1] };
+}
diff --git a/frontend/src/cad-view/cadViewModel.js b/frontend/src/cad-view/cadViewModel.js
new file mode 100644
index 0000000000000000000000000000000000000000..7c73d23afbccec6300d265708b1c92085ca21366
--- /dev/null
+++ b/frontend/src/cad-view/cadViewModel.js
@@ -0,0 +1,208 @@
+/**
+ * Markdown内の3D表示（Dagnetz CAD Viewer の ```step / ```cad）を画像にするときの、DOM・WebGLに依存しない計算。
+ * - Git差分の一覧では、ノートの3D表示を表示モード "cad-view:<key>" として扱う
+ *   （key はコードブロックの name。無ければ「#出現順」。HEADと作業ツリーの対応づけもこの key で行う）
+ * - 画像の大きさ・注記の文字・折り返し・カメラの合わせ方はプラグインの印刷用画像（printLayout / LabelLayer）に合わせる
+ */
+
+export const CAD_VIEW_MODE_PREFIX = "cad-view:";
+/** 幅の指定が無い埋め込みの幅・高さ（プラグインの PRINT_DEFAULT_WIDTH / HEIGHT）。 */
+export const CAD_VIEW_DEFAULT_SIZE = { width: 700, height: 400 };
+/** 印刷用画像と同じく、最低2倍の解像度で描く。 */
+export const CAD_VIEW_PIXEL_RATIO = 2;
+export const LABEL_MAX_WIDTH = 308;
+export const LABEL_PADDING = 6;
+export const LABEL_LINE_HEIGHT = 1.4;
+
+const FONT_SIZES = { small: 12, medium: 14, large: 18, xlarge: 24 };
+const DEFAULT_FONT_PX = 14;
+const DEFAULT_TEXT_COLOR = "#111111";
+const MAX_TEXT_LUMINANCE = 0.6; // これより明るい文字色は白い背景で読めない
+const VIEW_DIRECTIONS = {
+  front: [0, 0, 1],
+  back: [0, 0, -1],
+  left: [-1, 0, 0],
+  right: [1, 0, 0],
+  top: [0, 1, 0],
+  bottom: [0, -1, 0],
+  iso: [1, 0.8, 1],
+};
+
+export function cadViewMode(key) {
+  return `${CAD_VIEW_MODE_PREFIX}${key}`;
+}
+
+/** 表示モードが3D表示なら、その key を返す。それ以外は null。 */
+export function cadViewKey(mode) {
+  if (typeof mode !== "string" || !mode.startsWith(CAD_VIEW_MODE_PREFIX)) return null;
+  return mode.slice(CAD_VIEW_MODE_PREFIX.length) || null;
+}
+
+/** 一覧などに出す名前。name があればそれ、無ければ出現順の番号。 */
+export function cadViewTitle(view) {
+  return view.name ? `3D表示「${view.name}」` : `3D表示 ${view.index + 1}`;
+}
+
+export function cadViewLabel(view) {
+  return `${cadViewTitle(view)}${view.model ? `（${view.model}）` : ""}`;
+}
+
+/** key だけからの表示名（name が無いブロックの key は「#出現順」）。 */
+export function cadViewTitleFromKey(key) {
+  return key.startsWith("#") ? `3D表示 ${key.slice(1)}` : `3D表示「${key}」`;
+}
+
+export function cadViewSize(config) {
+  return {
+    width: config?.width ?? CAD_VIEW_DEFAULT_SIZE.width,
+    height: config?.height ?? CAD_VIEW_DEFAULT_SIZE.height,
+  };
+}
+
+/** 注記の文字サイズ（small / medium / large / xlarge、数値、"16px"）を px にする。 */
+export function annotationFontPx(fontSize) {
+  if (fontSize === undefined || fontSize === null || fontSize === "") return DEFAULT_FONT_PX;
+  if (typeof fontSize === "number") return fontSize > 0 ? fontSize : DEFAULT_FONT_PX;
+  const preset = FONT_SIZES[String(fontSize).trim()];
+  if (preset) return preset;
+  const px = parseFloat(fontSize);
+  return px > 0 ? px : DEFAULT_FONT_PX;
+}
+
+/** 白い背景で読めない明るい文字色は、既定の黒に置き換える。 */
+export function readablePrintColor(color) {
+  if (!color) return DEFAULT_TEXT_COLOR;
+  const match = /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.exec(String(color).trim());
+  if (!match) return String(color);
+  const hex = match[1].length === 3 ? match[1].replace(/./g, "$&$&") : match[1];
+  const [r, g, b] = [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
+  return 0.2126 * r + 0.7152 * g + 0.0722 * b > MAX_TEXT_LUMINANCE ? DEFAULT_TEXT_COLOR : String(color);
+}
+
+/** 注記の本文（Markdown）を、ビューアに表示される文字に近い形にする。 */
+export function annotationCaption(text) {
+  return String(text ?? "")
+    .replace(/!?\[\[([^\]|]+)\|([^\]]+)\]\]/g, "$2")
+    .replace(/!?\[\[([^\]]+)\]\]/g, "$1")
+    .replace(/!?\[([^\]]*)\]\([^)]*\)/g, "$1")
+    .replace(/(\*\*|__|\*|_|~~|`)(.+?)\1/g, "$2")
+    .replace(/^\s{0,3}(#{1,6}|[-*+]|\d+\.)\s+/gm, "")
+    .replace(/\s+$/, "");
+}
+
+/** 改行を保ったまま、maxWidth に収まるよう1文字単位で折り返す（プラグインの wrapPrintText と同じ）。 */
+export function wrapPrintText(text, maxWidth, measure) {
+  const lines = [];
+  for (const paragraph of String(text).replace(/\s+$/, "").split("\n")) {
+    let line = "";
+    for (const ch of paragraph) {
+      if (line && measure(line + ch) > maxWidth) {
+        lines.push(line);
+        line = "";
+      }
+      line += ch;
+    }
+    lines.push(line);
+  }
+  return lines;
+}
+
+/**
+ * 注記の札の位置（中心）。引出線があれば錨から ox / oy だけずらし、文字が切れないよう画像の中に収める。
+ */
+export function placeLabel(anchor, annotation, box, size) {
+  const offset = annotation.leader ? { x: annotation.ox ?? 140, y: annotation.oy ?? -96 } : null;
+  const x = anchor.x + (offset?.x ?? 0);
+  const y = anchor.y + (offset?.y ?? 0);
+  return {
+    cx: Math.max(box.width / 2, Math.min(size.width - box.width / 2, x)),
+    cy: Math.max(box.height / 2, Math.min(size.height - box.height / 2, y)),
+    leader: Boolean(offset),
+  };
+}
+
+/** 視点の名前（front / iso など）の向き。カメラの指定が無いブロックで使う。 */
+export function viewDirection(view) {
+  return VIEW_DIRECTIONS[view] ?? null;
+}
+
+/**
+ * プラグインの fitCameraToObject と同じく、モデル全体が入る視野・カメラ位置を求める。
+ * box は {min: [x, y, z], max: [x, y, z]}。
+ */
+export function fitCamera(box, aspect, perspective, fovDegrees = 45, offset = 1.3) {
+  const size = box.max.map((value, i) => value - box.min[i]);
+  const center = box.max.map((value, i) => (value + box.min[i]) / 2);
+  const maxDim = Math.max(...size) || 1;
+  const direction = normalize([1, 0.8, 1]);
+  if (perspective) {
+    const distance = (maxDim / 2 / Math.tan((fovDegrees * Math.PI) / 360)) * offset;
+    return {
+      center,
+      position: center.map((value, i) => value + direction[i] * distance),
+      near: Math.max(distance / 1000, 0.001),
+      far: distance * 1000,
+    };
+  }
+  const halfHeight = (maxDim / 2) * offset;
+  const distance = maxDim * 3 + 1;
+  return {
+    center,
+    position: center.map((value, i) => value + direction[i] * distance),
+    halfHeight,
+    halfWidth: halfHeight * aspect,
+    near: 0.001,
+    far: distance * 100,
+  };
+}
+
+/**
+ * 平行投影の拡大率。viewHeight（見えている高さ）があればそれを優先し、視野の大きさが違っても同じ表示にする。
+ */
+export function orthoZoom(camera, halfHeight) {
+  if (camera?.viewHeight > 0) return (halfHeight * 2) / camera.viewHeight;
+  return camera?.zoom > 0 ? camera.zoom : 1;
+}
+
+/** 断面の位置と向き。傾けた断面（point / tilt）が無ければ、軸の範囲の offset 割合の位置で切る。 */
+export function sectionPlaneSpec(section, box) {
+  if (!section?.enabled) return null;
+  const axisIndex = { x: 0, y: 1, z: 2 }[section.axis] ?? 2;
+  let normal = [0, 0, 0];
+  let point;
+  if (section.point && section.tilt) {
+    normal = rotateByQuaternion([0, 0, 1], section.tilt);
+    point = section.point;
+  } else {
+    normal[axisIndex] = 1;
+    point = box.max.map((value, i) => (value + box.min[i]) / 2);
+    const lo = box.min[axisIndex];
+    point[axisIndex] = lo + (box.max[axisIndex] - lo) * (section.offset ?? 0.5);
+  }
+  normal = normalize(normal);
+  if (section.flipped) normal = normal.map((value) => -value);
+  // 距離 = n·p + constant が0以上の側を残す（Three.js のクリッピング平面と同じ）
+  return { normal, constant: -dot(normal, point) };
+}
+
+function normalize(vector) {
+  const length = Math.hypot(...vector) || 1;
+  return vector.map((value) => value / length);
+}
+
+function dot(a, b) {
+  return a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+}
+
+function rotateByQuaternion(vector, [x, y, z, w]) {
+  const [vx, vy, vz] = vector;
+  const ix = w * vx + y * vz - z * vy;
+  const iy = w * vy + z * vx - x * vz;
+  const iz = w * vz + x * vy - y * vx;
+  const iw = -x * vx - y * vy - z * vz;
+  return [
+    ix * w + iw * -x + iy * -z - iz * -y,
+    iy * w + iw * -y + iz * -x - ix * -z,
+    iz * w + iw * -z + ix * -y - iy * -x,
+  ];
+}
diff --git a/frontend/src/cad-view/renderCadView.js b/frontend/src/cad-view/renderCadView.js
new file mode 100644
index 0000000000000000000000000000000000000000..54ad6bb32af2974e60e4a01d1360d3af2cdf0e22
--- /dev/null
+++ b/frontend/src/cad-view/renderCadView.js
@@ -0,0 +1,325 @@
+/**
+ * Markdown内の3D表示を、プラグイン（Dagnetz CAD Viewer）の印刷用画像と同じ手順で PNG にする。
+ * - 白い背景に、モデル・注記（札と引出線）・座標軸（左下）を重ねる
+ * - 照明・材質・輪郭線・カメラ（平行投影の viewHeight、視点の名前、90°回転）はプラグインの値に合わせる
+ * - 断面はクリッピング平面とステンシルの中実キャップ（3D差分ビューアと同じ部品）で描く
+ * - HEAD と作業ツリーを同じ描き方で描くので、比べたときに違うのはノートの設定とモデルの差だけになる
+ * Three.js を含むため、Git差分で3D表示を開いたときだけ読み込む（React.lazy と同じく動的 import）。
+ */
+import * as THREE from "three";
+import { OBJLoader } from "three/addons/loaders/OBJLoader.js";
+import { STLLoader } from "three/addons/loaders/STLLoader.js";
+import { toCreasedNormals } from "three/addons/utils/BufferGeometryUtils.js";
+import { createHatchTexture, createSectionStencilGroup } from "../three-diff/sectionPlane.js";
+import {
+  CAD_VIEW_PIXEL_RATIO,
+  LABEL_LINE_HEIGHT,
+  LABEL_MAX_WIDTH,
+  LABEL_PADDING,
+  annotationCaption,
+  annotationFontPx,
+  cadViewSize,
+  fitCamera,
+  orthoZoom,
+  placeLabel,
+  readablePrintColor,
+  sectionPlaneSpec,
+  viewDirection,
+  wrapPrintText,
+} from "./cadViewModel.js";
+
+const MODEL_COLOR = 0xcccccc;
+const EDGE_COLOR = 0x222222;
+const EDGE_THRESHOLD_ANGLE = 30;
+const EDGE_TRIANGLE_BUDGET = 1_500_000; // 大きなモデルでは輪郭線を省く（プラグインと同じ上限）
+const LEADER_COLOR = "#656565";
+const ARROW_SIZE = 7;
+const PIN_RADIUS = 4;
+const AXES = [
+  { label: "X", color: "#e5484d", dir: new THREE.Vector3(1, 0, 0) },
+  { label: "Y", color: "#30a46c", dir: new THREE.Vector3(0, 1, 0) },
+  { label: "Z", color: "#3b82f6", dir: new THREE.Vector3(0, 0, 1) },
+];
+const AXIS_MARGIN = 46;
+const AXIS_LENGTH = 30;
+const AXIS_LABEL_GAP = 11;
+
+/** VDM1（バックエンドがSTEPから作ったメッシュ）を、位置と三角形だけのジオメトリにする。 */
+export function geometryFromVdm1(parsed) {
+  const geometry = new THREE.BufferGeometry();
+  geometry.setAttribute("position", new THREE.BufferAttribute(parsed.positions, 3));
+  geometry.setIndex(new THREE.BufferAttribute(parsed.indices, 1));
+  return geometry;
+}
+
+/** STL / OBJ のファイルを、ローダーの変換を焼き込んだ1つのジオメトリにする。 */
+export function geometryFromModelFile(format, buffer) {
+  if (format === "stl") return new STLLoader().parse(buffer);
+  const root = new OBJLoader().parse(new TextDecoder().decode(buffer));
+  const chunks = [];
+  root.updateMatrixWorld(true);
+  root.traverse((object) => {
+    if (!object.isMesh) return;
+    const geometry = (object.geometry.index ? object.geometry.toNonIndexed() : object.geometry.clone()).applyMatrix4(object.matrixWorld);
+    chunks.push(geometry.getAttribute("position").array);
+  });
+  const positions = new Float32Array(chunks.reduce((total, chunk) => total + chunk.length, 0));
+  chunks.reduce((offset, chunk) => {
+    positions.set(chunk, offset);
+    return offset + chunk.length;
+  }, 0);
+  const geometry = new THREE.BufferGeometry();
+  geometry.setAttribute("position", new THREE.BufferAttribute(positions, 3));
+  return geometry;
+}
+
+/** 3D表示の設定（コードブロック）とモデルのジオメトリから PNG（Blob）を作る。 */
+export async function renderCadViewImage(geometry, config) {
+  const size = cadViewSize(config);
+  const pixelRatio = Math.max(window.devicePixelRatio || 1, CAD_VIEW_PIXEL_RATIO);
+  const scene = new THREE.Scene();
+  const disposables = [];
+
+  // モデルの姿勢（90°回転など）はジオメトリへ焼き込み、注記の錨にも同じ変換を当てる
+  const rawBox = boxOf(geometry);
+  const camera = createCamera(config, rawBox, size);
+  const modelMatrix = modelTransform(config, camera.userData.target);
+  const placed = geometry.clone().applyMatrix4(modelMatrix);
+  disposables.push(placed);
+  const model = buildModel(placed, disposables);
+  scene.add(model);
+  addLights(scene);
+
+  const box = boxOf(placed);
+  const section = sectionPlaneSpec(config.section, box);
+  if (section) applySection(scene, model, section, box, disposables);
+
+  const canvas = document.createElement("canvas");
+  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, stencil: true, preserveDrawingBuffer: true });
+  try {
+    renderer.localClippingEnabled = true;
+    renderer.setPixelRatio(pixelRatio);
+    renderer.setSize(size.width, size.height, false);
+    renderer.setClearColor(0xffffff, 0);
+    renderer.render(scene, camera);
+
+    const output = document.createElement("canvas");
+    output.width = Math.round(size.width * pixelRatio);
+    output.height = Math.round(size.height * pixelRatio);
+    const ctx = output.getContext("2d");
+    ctx.fillStyle = "#ffffff";
+    ctx.fillRect(0, 0, output.width, output.height);
+    ctx.drawImage(canvas, 0, 0, output.width, output.height);
+    if (config.showAnnotations !== false) {
+      drawAnnotations(ctx, config.annotations ?? [], modelMatrix, camera, size, pixelRatio);
+    }
+    drawAxes(ctx, camera, new THREE.Quaternion().setFromRotationMatrix(modelMatrix), size.height, pixelRatio);
+    return await new Promise((resolve, reject) => {
+      output.toBlob((blob) => (blob ? resolve(blob) : reject(new Error("3D表示を画像にできませんでした"))), "image/png");
+    });
+  } finally {
+    disposables.forEach((item) => item.dispose?.());
+    renderer.dispose();
+    renderer.forceContextLoss();
+  }
+}
+
+function boxOf(geometry) {
+  geometry.computeBoundingBox();
+  const { min, max } = geometry.boundingBox;
+  return { min: min.toArray(), max: max.toArray() };
+}
+
+/** プラグインと同じく、まず全体が入るように合わせ、コードブロックの視点（位置・注視点・見えている高さ）を当てる。 */
+function createCamera(config, box, size) {
+  const aspect = size.width / size.height;
+  const perspective = Boolean(config.camera?.perspective);
+  const fit = fitCamera(box, aspect, perspective);
+  const camera = perspective
+    ? new THREE.PerspectiveCamera(45, aspect, fit.near, fit.far)
+    : new THREE.OrthographicCamera(-fit.halfWidth, fit.halfWidth, fit.halfHeight, -fit.halfHeight, fit.near, fit.far);
+  const target = new THREE.Vector3(...fit.center);
+  camera.position.set(...fit.position);
+
+  if (config.camera) {
+    camera.position.set(...config.camera.position);
+    target.set(...config.camera.target);
+    if (!perspective) camera.zoom = orthoZoom(config.camera, fit.halfHeight);
+  } else {
+    const direction = viewDirection(config.view);
+    if (direction) {
+      const distance = camera.position.distanceTo(target) || 1;
+      camera.position.copy(target).addScaledVector(new THREE.Vector3(...direction).normalize(), distance);
+    }
+  }
+  camera.lookAt(target);
+  camera.updateProjectionMatrix();
+  camera.updateMatrixWorld(true);
+  camera.userData.target = target;
+  return camera;
+}
+
+/** 保存されたモデルの位置・回転、またはカメラ指定が無いときの roll（視線まわりの90°回転）。 */
+function modelTransform(config, target) {
+  const matrix = new THREE.Matrix4();
+  const camera = config.camera;
+  if (camera?.modelPosition && camera?.modelRotation) {
+    return matrix.compose(
+      new THREE.Vector3(...camera.modelPosition),
+      new THREE.Quaternion(...camera.modelRotation),
+      new THREE.Vector3(1, 1, 1),
+    );
+  }
+  if (!camera && config.roll) {
+    const direction = viewDirection(config.view) ?? [1, 0.8, 1];
+    const axis = new THREE.Vector3(...direction).normalize().negate(); // 視線の向き（カメラ → 注視点）
+    const rotation = new THREE.Matrix4().makeRotationAxis(axis, (config.roll * Math.PI) / 2);
+    return matrix
+      .makeTranslation(target.x, target.y, target.z)
+      .multiply(rotation)
+      .multiply(new THREE.Matrix4().makeTranslation(-target.x, -target.y, -target.z));
+  }
+  return matrix;
+}
+
+function buildModel(geometry, disposables) {
+  const shaded = geometry.index ? toCreasedNormals(geometry, (EDGE_THRESHOLD_ANGLE * Math.PI) / 180) : geometry.clone();
+  if (!shaded.getAttribute("normal")) shaded.computeVertexNormals();
+  const material = new THREE.MeshStandardMaterial({ color: MODEL_COLOR, metalness: 0.1, roughness: 0.7, side: THREE.DoubleSide });
+  const mesh = new THREE.Mesh(shaded, material);
+  mesh.name = "cad-model";
+  disposables.push(shaded, material);
+
+  const triangles = (geometry.index ? geometry.index.count : geometry.getAttribute("position").count) / 3;
+  if (triangles <= EDGE_TRIANGLE_BUDGET) {
+    const edgesGeometry = new THREE.EdgesGeometry(geometry, EDGE_THRESHOLD_ANGLE);
+    const edgesMaterial = new THREE.LineBasicMaterial({ color: EDGE_COLOR });
+    const edges = new THREE.LineSegments(edgesGeometry, edgesMaterial);
+    edges.name = "cad-edges";
+    mesh.add(edges);
+    disposables.push(edgesGeometry, edgesMaterial);
+  }
+  return mesh;
+}
+
+/** プラグインの照明（環境光 0.9、主光 1.2、補助光 0.5）。光源はワールドに固定する。 */
+function addLights(scene) {
+  scene.add(new THREE.AmbientLight(0xffffff, 0.9));
+  const main = new THREE.DirectionalLight(0xffffff, 1.2);
+  main.position.set(1, 1, 1);
+  scene.add(main);
+  const fill = new THREE.DirectionalLight(0xffffff, 0.5);
+  fill.position.set(-1, -0.5, -1);
+  scene.add(fill);
+}
+
+function applySection(scene, model, spec, box, disposables) {
+  const plane = new THREE.Plane(new THREE.Vector3(...spec.normal), spec.constant);
+  model.material.clippingPlanes = [plane];
+  model.children.forEach((child) => {
+    if (child.material) child.material.clippingPlanes = [plane];
+  });
+  const hatch = createHatchTexture();
+  disposables.push(hatch);
+  const bounds = new THREE.Box3(new THREE.Vector3(...box.min), new THREE.Vector3(...box.max));
+  scene.add(createSectionStencilGroup(scene, plane, bounds, hatch));
+}
+
+/** 注記の錨（ピン）と札、引出線を描く。札の大きさと折り返しはプラグインの印刷用画像と同じ。 */
+function drawAnnotations(ctx, annotations, modelMatrix, camera, size, scale) {
+  const projected = new THREE.Vector3();
+  const labels = annotations.flatMap((annotation) => {
+    projected.set(annotation.x, annotation.y, annotation.z).applyMatrix4(modelMatrix).project(camera);
+    if (projected.z > 1 || projected.z < -1) return [];
+    const anchor = { x: (projected.x * 0.5 + 0.5) * size.width, y: (-projected.y * 0.5 + 0.5) * size.height };
+    const text = annotationCaption(annotation.text);
+    const fontPx = annotationFontPx(annotation.fontSize);
+    const font = `${fontPx * scale}px sans-serif`;
+    ctx.font = font;
+    const measure = (line) => ctx.measureText(line).width / scale;
+    const lines = text ? wrapPrintText(text, LABEL_MAX_WIDTH, measure) : [];
+    const lineHeight = fontPx * LABEL_LINE_HEIGHT;
+    const box = { width: Math.max(0, ...lines.map(measure)) + LABEL_PADDING * 2, height: lines.length * lineHeight + 4 };
+    const place = placeLabel(anchor, annotation, box, size);
+    return [{ annotation, anchor, lines, font, lineHeight, box, ...place, color: readablePrintColor(annotation.textColor) }];
+  });
+
+  ctx.save();
+  // 引出線を先に描き、ほかの札の文字の上に線が重ならないようにする
+  for (const label of labels) {
+    if (label.leader && label.lines.length) drawLeader(ctx, label.cx * scale, label.cy * scale, label.anchor.x * scale, label.anchor.y * scale, scale);
+  }
+  for (const label of labels) {
+    ctx.beginPath();
+    ctx.arc(label.anchor.x * scale, label.anchor.y * scale, PIN_RADIUS * scale, 0, Math.PI * 2);
+    ctx.fillStyle = label.annotation.color || "#ffc531";
+    ctx.fill();
+    ctx.lineWidth = scale;
+    ctx.strokeStyle = "#ffffff";
+    ctx.stroke();
+  }
+  ctx.textBaseline = "middle";
+  ctx.textAlign = "center";
+  for (const label of labels) {
+    if (!label.lines.length) continue;
+    ctx.fillStyle = "rgba(255,255,255,0.88)";
+    ctx.fillRect((label.cx - label.box.width / 2) * scale, (label.cy - label.box.height / 2) * scale, label.box.width * scale, label.box.height * scale);
+    ctx.font = label.font;
+    ctx.fillStyle = label.color;
+    label.lines.forEach((line, i) => {
+      const offset = (i - (label.lines.length - 1) / 2) * label.lineHeight;
+      ctx.fillText(line, label.cx * scale, (label.cy + offset) * scale);
+    });
+  }
+  ctx.restore();
+}
+
+function drawLeader(ctx, fromX, fromY, toX, toY, scale) {
+  const angle = Math.atan2(toY - fromY, toX - fromX);
+  const size = ARROW_SIZE * scale;
+  ctx.save();
+  ctx.strokeStyle = LEADER_COLOR;
+  ctx.fillStyle = LEADER_COLOR;
+  ctx.lineWidth = 1.5 * scale;
+  ctx.setLineDash([3 * scale, 3 * scale]);
+  ctx.beginPath();
+  ctx.moveTo(fromX, fromY);
+  ctx.lineTo(toX, toY);
+  ctx.stroke();
+  ctx.setLineDash([]);
+  ctx.beginPath();
+  ctx.moveTo(toX, toY);
+  ctx.lineTo(toX - size * Math.cos(angle - 0.45), toY - size * Math.sin(angle - 0.45));
+  ctx.lineTo(toX - size * Math.cos(angle + 0.45), toY - size * Math.sin(angle + 0.45));
+  ctx.closePath();
+  ctx.fill();
+  ctx.restore();
+}
+
+/** モデルの X/Y/Z 軸が画面で向く方向を左下に描く（奥の軸から順に）。 */
+function drawAxes(ctx, camera, modelQuaternion, height, scale) {
+  const toCamera = camera.quaternion.clone().invert();
+  const axes = AXES.map(({ label, color, dir }) => {
+    const v = dir.clone().applyQuaternion(modelQuaternion).applyQuaternion(toCamera);
+    return { label, color, x: v.x, y: v.y, depth: v.z };
+  }).sort((a, b) => a.depth - b.depth);
+  const ox = AXIS_MARGIN * scale;
+  const oy = (height - AXIS_MARGIN) * scale;
+  ctx.save();
+  ctx.lineWidth = 2 * scale;
+  ctx.lineCap = "round";
+  ctx.font = `bold ${Math.round(12 * scale)}px sans-serif`;
+  ctx.textAlign = "center";
+  ctx.textBaseline = "middle";
+  for (const axis of axes) {
+    ctx.strokeStyle = axis.color;
+    ctx.fillStyle = axis.color;
+    ctx.beginPath();
+    ctx.moveTo(ox, oy);
+    ctx.lineTo(ox + axis.x * AXIS_LENGTH * scale, oy - axis.y * AXIS_LENGTH * scale);
+    ctx.stroke();
+    const distance = (AXIS_LENGTH + AXIS_LABEL_GAP) * scale;
+    ctx.fillText(axis.label, ox + axis.x * distance, oy - axis.y * distance);
+  }
+  ctx.restore();
+}
