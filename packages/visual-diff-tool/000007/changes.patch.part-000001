+@router.post("/api/git/cad-view/diff", response_model=DiffResponse)
+def git_cad_view_diff(
+    file_a: UploadFile = File(...),
+    file_b: UploadFile = File(...),
+    category: str = Form("図面"),
+    diff_threshold: float = Form(0.1),
