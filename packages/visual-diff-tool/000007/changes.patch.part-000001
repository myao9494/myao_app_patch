+@router.post("/api/git/commit")
+def git_commit(payload: dict) -> JSONResponse:
+    """画面の変更一覧で選んだファイルだけをコミットし、希望があればpushする。
+
+    一覧（/api/git/files）と同じ範囲を再計算し、その中にあるパスだけを受け付ける。
+    一覧にないファイルは、リクエストに含まれていてもコミットしない。
+    コミットが成功したあとのpush失敗は、コミットを取り消さず `push_error` で返す。
+    """
+    folder, source_markdown = payload_git_scope(payload)
+    repo = git_repo_root(folder)
+    message = str(payload.get("message") or "").strip()
+    if not message:
+        raise HTTPException(status_code=422, detail="コミットメッセージを入力してください")
+    if len(message) > MAX_COMMIT_MESSAGE_CHARS:
+        raise HTTPException(status_code=422, detail="コミットメッセージが長すぎます")
+    requested = payload.get("paths")
+    if not isinstance(requested, list) or not requested or not all(isinstance(item, str) for item in requested):
+        raise HTTPException(status_code=422, detail="コミットするファイルを選択してください")
+
+    text_extensions = text_extensions_from_payload(payload)
+    if source_markdown:
+        files = changed_files(repo, repo, text_extensions, specific_paths=related_paths_for_markdown(repo, source_markdown))
+    else:
+        files = changed_files(repo, folder, text_extensions)
+    listed = {item["path"]: item for item in files}
+    unknown = [path for path in requested if path not in listed]
+    if unknown:
+        raise HTTPException(status_code=409, detail=f"変更一覧にないファイルは含められません。再読み込みしてください: {unknown[0]}")
+
+    # リネーム・拡張子変換は、旧パスの削除と新パスの追加を同じコミットに入れる。
+    paths: list[str] = []
+    for path in dict.fromkeys(requested):
+        item = listed[path]
+        for candidate in (item["path"], item["head_path"]):
+            if candidate not in paths:
+                paths.append(safe_git_path(repo, candidate, restrict_to_images=False))
+
+    commit_id = commit_paths(repo, paths, message)
+    response: dict = {"commit": commit_id, "paths": paths, "pushed": False, "push_error": None, "push_output": ""}
+    if bool(payload.get("push", False)):
+        try:
+            response["push_output"] = push_current_branch(repo)
+            response["pushed"] = True
+        except HTTPException as exc:
+            response["push_error"] = str(exc.detail)
+    return JSONResponse(response)
+
+
