+def pair_converted_images(files: list[dict]) -> list[dict]:
+    """拡張子だけ変えて変換された画像を、リネームと同じ1件の変更にまとめる。
+
+    `x.png` を `x.webp` へ変換すると内容が変わるためGitのリネーム検出に掛からず、
+    削除と新規の2件に分かれて比較できない。同じフォルダー・同じ名前で削除と新規が
+    1件ずつあるときだけ対応づける（複数あるとどれが元か決められないので触らない）。
+    """
+    deleted: dict[Path, list[dict]] = {}
+    created: dict[Path, list[dict]] = {}
+    for item in files:
+        path = Path(item["path"])
+        if item["kind"] != "image" or path.suffix.lower() not in RASTER_IMAGE_EXTENSIONS:
+            continue
+        if item["change_type"] == "deleted":
+            deleted.setdefault(path.with_suffix(""), []).append(item)
+        elif item["change_type"] in ("added", "untracked"):
+            created.setdefault(path.with_suffix(""), []).append(item)
+
+    merged_ids = set()
+    for stem, old_items in deleted.items():
+        new_items = created.get(stem, [])
+        if len(old_items) != 1 or len(new_items) != 1:
+            continue
+        new_items[0].update(
+            head_path=old_items[0]["path"],
+            status="R",
+            change_type="renamed",
+            has_head=True,
+            diffable=True,
+        )
+        merged_ids.add(id(old_items[0]))
+    return [item for item in files if id(item) not in merged_ids]
 
 
