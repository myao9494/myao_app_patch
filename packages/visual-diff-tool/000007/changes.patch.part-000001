@@ -187,6 +187,26 @@ export function fitCircleFrom3Points(p1, p2, p3) {
   };
 }
 
+/**
+ * 2点が主軸の平面内で45度に並んでいるか（面取りの辺らしいか）を返す。
+ * 2成分がほぼ同じ長さで残り1成分がほぼ0のときだけ true（斜めの2点をすべてCと判定しない）。
+ */
+export function isChamferEdge(p1, p2) {
+  const [small, middle, large] = [p1.x - p2.x, p1.y - p2.y, p1.z - p2.z].map(Math.abs).sort((a, b) => a - b);
+  if (large < 0.01) return false;
+  return small <= large * 0.05 && middle >= large * 0.9;
+}
+
+/**
+ * 表示中モデルのバウンディングボックスを返す（断面の範囲計算に使う）。
+ * Gitの新規追加は新版だけ、削除は旧版だけを持つため、どちらか片側しかなくても読めるようにする。
+ * @param {{new?: object, old?: object}|null} meshData
+ * @returns {object|null}
+ */
+export function meshBoundingBox(meshData) {
+  return meshData?.new?.geometry?.boundingBox || meshData?.old?.geometry?.boundingBox || null;
+}
+
 /**
  * 点群および幾何要素から寸法種別（穴径φ/円弧R/C面取り/直線）をスマート自動認識する
  * @param {Array<{x: number, y: number, z: number}>} points
@@ -217,6 +237,8 @@ export function detectSmartDimension(points, meta = {}) {
         availableTypes: ["diameter", "radius", "distance"],
       };
     }
+    // 一直線に並んだ3点は円にならないので、両端の直線距離にする
+    return detectSmartDimension([points[0], points[points.length - 1]], meta);
   }
 
   // 2. 2点の場合: 面取り判定または直線距離
@@ -227,7 +249,7 @@ export function detectSmartDimension(points, meta = {}) {
 
     if (meta.isChamferFace) {
       // 面取り幅 (C寸法)
-      const cVal = Math.min(calc.dx || calc.distance, calc.dy || calc.distance);
+      const cVal = chamferSize(calc);
       return {
         type: "chamfer",
         value: Number(cVal.toFixed(2)),
@@ -258,6 +280,32 @@ export function detectSmartDimension(points, meta = {}) {
   };
 }
 
+function chamferSize(calc) {
+  return Math.min(calc.dx || calc.distance, calc.dy || calc.distance);
+}
+
+/**
+ * 寸法バッジのピルで種別を切り替えたときの値と表示を返す。
+ * 3点指定の直径を直線の値として表示しないよう、種別ごとに測定点から求め直す。
+ * @param {object} measurement
+ * @param {string} type - "distance" | "diameter" | "radius" | "chamfer"
+ * @returns {{type: string, value: number, label: string}}
+ */
+export function measurementAs(measurement, type) {
+  const calc = calculateDistance(measurement.start, measurement.end);
+  if (type === "diameter" && measurement.diameter) {
+    return { type, value: measurement.diameter, label: `φ${measurement.diameter.toFixed(2)} mm` };
+  }
+  if (type === "radius" && measurement.radius) {
+    return { type, value: measurement.radius, label: `R${measurement.radius.toFixed(2)} mm` };
+  }
+  if (type === "chamfer") {
+    const value = chamferSize(calc);
+    return { type, value, label: `C${value.toFixed(2)} mm` };
+  }
+  return { type: "distance", value: calc.distance, label: `${calc.distance.toFixed(2)} mm` };
+}
+
 /**
  * スマート認識された寸法オブジェクトを生成する (ドラッグ移動・手動切替対応)
  * @param {string} id
diff --git a/frontend/test/cad_view.test.js b/frontend/test/cad_view.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..694a34b7aaff0d4d1f0f9d93d91782407d734675
--- /dev/null
+++ b/frontend/test/cad_view.test.js
@@ -0,0 +1,90 @@
+/**
+ * Markdown内の3D表示を画像にするときの計算（cad-view/cadViewModel.js）の単体テスト。
+ * - 表示モード名と番号の対応
+ * - 画像の大きさ・注記の文字サイズと色・折り返し・札の位置（プラグインの印刷用画像と同じ規則）
+ * - カメラの合わせ方（平行投影の viewHeight）と断面の平面
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  annotationCaption,
+  annotationFontPx,
+  cadViewKey,
+  cadViewLabel,
+  cadViewMode,
+  cadViewTitleFromKey,
+  cadViewSize,
+  fitCamera,
+  orthoZoom,
+  placeLabel,
+  readablePrintColor,
+  sectionPlaneSpec,
+  wrapPrintText,
+} from "../src/cad-view/cadViewModel.js";
+
+test("cadViewMode / cadViewKey: 表示モード名とブロックの key（name）を行き来できる", () => {
+  assert.equal(cadViewMode("3D-1"), "cad-view:3D-1");
+  assert.equal(cadViewKey("cad-view:3D-1"), "3D-1");
+  assert.equal(cadViewKey("excalidraw"), null);
+  assert.equal(cadViewKey("cad-view:"), null);
+});
+
+test("cadViewLabel: name があれば名前、無ければ出現順の番号で示す", () => {
+  assert.equal(cadViewLabel({ index: 1, key: "3D-2", name: "3D-2", model: "a.step" }), "3D表示「3D-2」（a.step）");
+  assert.equal(cadViewLabel({ index: 0, key: "#1", name: "", model: "a.step" }), "3D表示 1（a.step）");
+  assert.equal(cadViewTitleFromKey("#3"), "3D表示 3");
+  assert.equal(cadViewTitleFromKey("3D-1"), "3D表示「3D-1」");
+});
+
+test("cadViewSize: 幅・高さの指定が無ければプラグインの既定 700×400", () => {
+  assert.deepEqual(cadViewSize({}), { width: 700, height: 400 });
+  assert.deepEqual(cadViewSize({ width: 579, height: 661 }), { width: 579, height: 661 });
+});
+
+test("annotationFontPx: プリセット名・数値・px指定を解決する", () => {
+  assert.equal(annotationFontPx(undefined), 14);
+  assert.equal(annotationFontPx("large"), 18);
+  assert.equal(annotationFontPx(20), 20);
+  assert.equal(annotationFontPx("16px"), 16);
+  assert.equal(annotationFontPx("unknown"), 14);
+});
+
+test("readablePrintColor: 白背景で読めない明るい色は黒に置き換える", () => {
+  assert.equal(readablePrintColor(undefined), "#111111");
+  assert.equal(readablePrintColor("#ffc531"), "#111111");
+  assert.equal(readablePrintColor("#30a46c"), "#30a46c");
+});
+
+test("annotationCaption: Markdownの記号を外して表示される文字にする", () => {
+  assert.equal(annotationCaption("**太字** と [[note|別名]] と `code`\n"), "太字 と 別名 と code");
+});
+
+test("wrapPrintText: 改行を保ち、幅を超えたら1文字単位で折り返す", () => {
+  assert.deepEqual(wrapPrintText("abcdef\nxy", 3, (line) => line.length), ["abc", "def", "xy"]);
+});
+
+test("placeLabel: 引出線があれば錨からずらし、画像の外へはみ出さない", () => {
+  const size = { width: 400, height: 300 };
+  const box = { width: 100, height: 20 };
+  assert.deepEqual(placeLabel({ x: 100, y: 100 }, { leader: true, ox: 50, oy: -30 }, box, size), { cx: 150, cy: 70, leader: true });
+  assert.deepEqual(placeLabel({ x: 390, y: 5 }, { leader: false }, box, size), { cx: 350, cy: 10, leader: false });
+});
+
+test("fitCamera / orthoZoom: viewHeight があれば見えている高さをそろえる", () => {
+  const fit = fitCamera({ min: [0, 0, 0], max: [100, 50, 20] }, 2, false);
+  assert.equal(fit.halfHeight, 65);
+  assert.equal(fit.halfWidth, 130);
+  assert.deepEqual(fit.center, [50, 25, 10]);
+  assert.equal(orthoZoom({ viewHeight: 65 }, fit.halfHeight), 2);
+  assert.equal(orthoZoom({ zoom: 0.8 }, fit.halfHeight), 0.8);
+});
+
+test("sectionPlaneSpec: 軸の範囲の割合で切り、反転で残す側を入れ替える", () => {
+  const box = { min: [0, 0, 0], max: [10, 20, 40] };
+  assert.equal(sectionPlaneSpec({ enabled: false }, box), null);
+  assert.deepEqual(sectionPlaneSpec({ enabled: true, axis: "z", offset: 0.25 }, box), { normal: [0, 0, 1], constant: -10 });
+  const flipped = sectionPlaneSpec({ enabled: true, axis: "x", offset: 0.5, flipped: true }, box);
+  assert.deepEqual(flipped.normal.map((v) => v + 0), [-1, 0, 0]);
+  assert.equal(flipped.constant, 5);
+});
diff --git a/frontend/test/errors.test.js b/frontend/test/errors.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..85fe9bbaf00aa13c2e517087772be783db9fe825
--- /dev/null
+++ b/frontend/test/errors.test.js
@@ -0,0 +1,24 @@
+/**
+ * 想定外のエラーの扱い（lib/errors.js）の単体テスト。
+ * - 表示する文面はどんな値が投げられても文字列になる
+ * - 動作に影響しないブラウザーの警告と、中断した通信は通知しない
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import { describeError, shouldIgnoreGlobalError } from "../src/lib/errors.js";
+
+test("describeError: Error・文字列・空の値を文字列にする", () => {
+  assert.equal(describeError(new Error("壊れた")), "壊れた");
+  assert.equal(describeError("文字列"), "文字列");
+  assert.equal(describeError({ reason: 1 }), "[object Object]");
+  assert.equal(describeError(null), "原因不明のエラーです");
+  assert.equal(describeError("x".repeat(600)).length, 500);
+});
+
+test("shouldIgnoreGlobalError: 動作に影響しないものだけ無視する", () => {
+  assert.equal(shouldIgnoreGlobalError("ResizeObserver loop completed with undelivered notifications."), true);
+  assert.equal(shouldIgnoreGlobalError(Object.assign(new Error("aborted"), { name: "AbortError" })), true);
+  assert.equal(shouldIgnoreGlobalError(new TypeError("Cannot read properties of undefined")), false);
+  assert.equal(shouldIgnoreGlobalError(null), false);
+});
