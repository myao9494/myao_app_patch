+def _placed_element(element: dict, offset_x: float, offset_y: float, scale: float) -> dict:
+    """シーン座標の要素を、描画キャンバスの座標と倍率へ置き換える。"""
+    placed = dict(element)
+    placed["x"] = (float(element.get("x", 0)) + offset_x) * scale
+    placed["y"] = (float(element.get("y", 0)) + offset_y) * scale
+    placed["width"] = float(element.get("width", 0)) * scale
+    placed["height"] = float(element.get("height", 0)) * scale
+    placed["strokeWidth"] = (_float_or_zero(element.get("strokeWidth")) or 1) * scale
+    placed["fontSize"] = (_float_or_zero(element.get("fontSize")) or 20) * scale
+    if element.get("points"):
+        placed["points"] = [[float(point[0]) * scale, float(point[1]) * scale] for point in element["points"] if len(point) >= 2]
+    return placed
 
 
