r:pointer;text-align:left}.context-menu button:hover{background:var(--border-strong)}.memo-empty{width:min(560px,calc(100vw - 32px));margin:20vh auto 0;padding:24px;border:1px solid var(--border-strong);border-radius:6px;background:var(--surface-1)}.api-guide-page{min-height:100vh;background:var(--bg)}.api-guide-header{min-height:86px;padding:18px 24px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:16px;background:var(--surface-1)}.api-guide-header>div:last-child{display:flex;align-items:center;gap:8px}.api-guide-openapi{text-decoration:none}.api-guide-content{width:min(1120px,calc(100vw - 48px));margin:0 auto;padding:24px 0 40px;display:flex;flex-direction:column;gap:16px}.api-guide-section,.api-endpoint{border:1px solid var(--border);border-radius:6px;padding:18px;background:var(--surface-2)}.api-guide-section h2,.api-endpoint h2,.api-endpoint h3{margin:0 0 10px;letter-spacing:0}.api-guide-section h2{font-size:20px}.api-endpoint h3{margin-top:16px;font-size:14px;color:#bae6fd}.api-guide-section ul,.api-guide-section ol{margin:10px 0 0;padding-left:22px;color:var(--text-muted)}.api-guide-section li+li{margin-top:8px}.api-endpoint-title{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-bottom:8px}.api-method{min-width:54px;min-height:28px;padding:0 8px;border-radius:4px;display:inline-flex;align-items:center;justify-content:center;background:#0ea5e9;color:#082f49;font-size:12px;font-weight:800}code{border-radius:4px;padding:1px 5px;background:#020617;color:#bfdbfe}pre{margin:8px 0 0;max-width:100%;overflow:auto;border:1px solid var(--border);border-radius:6px;padding:12px;background:#020617;color:#dbeafe;font-size:13px;line-height:1.45}@keyframes spin{to{transform:rotate(360deg)}}@media(max-width:800px){.memo-workspace{height:auto;min-height:calc(100vh - 130px);grid-template-columns:1fr}.memo-sidebar{max-height:250px;border-right:0;border-bottom:1px solid var(--border-strong)}.memo-content{min-height:620px}}@media(max-width:640px){.app-header{grid-template-columns:auto minmax(0,1fr) auto;gap:8px;padding:0 10px}.brand-name{display:none}.mode-tabs{justify-self:stretch;min-width:0;overflow-x:auto}.mode-tabs button{flex:1;justify-content:center;padding:0 8px}.mode-tabs svg{display:none}.source-bar{grid-template-columns:minmax(0,1fr)}.api-guide-header,.memo-header,.memo-editor,.memo-sidebar,.memo-stage-wrap{padding-left:12px;padding-right:12px}.api-guide-header{align-items:flex-start;flex-direction:column}.api-guide-content{width:calc(100vw - 24px)}.memo-header{align-items:flex-start;flex-direction:column}.slider-control,.slider-control input{width:100%;min-width:0}.text-diff-heading{flex-direction:column}.text-diff-heading label{width:100%;max-width:none;flex-basis:auto}}
+:root{--bg: #0c0e13;--surface-1: #13161d;--surface-2: #191d26;--surface-3: #212633;--surface-hover: #262c3a;--border: #252a36;--border-strong: #353c4d;--text: #e8ebf1;--text-muted: #a1a9ba;--text-faint: #6e7689;--accent: #5b8cff;--accent-strong: #4374f0;--accent-soft: rgba(91, 140, 255, .14);--accent-ring: rgba(91, 140, 255, .45);--removed: #f2606b;--added: #4d9dff;--changed: #f5b53d;--success: #3ccf8e;--warning: #f5b53d;--danger: #f2606b;--radius-sm: 6px;--radius: 10px;--radius-lg: 14px;--shadow: 0 10px 30px rgba(0, 0, 0, .35);--shadow-sm: 0 2px 8px rgba(0, 0, 0, .25);--font-sans: Inter, "Hiragino Sans", "Hiragino Kaku Gothic ProN", "Noto Sans JP", "Yu Gothic UI", "Meiryo", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;--font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;font-family:var(--font-sans);font-size:14px;line-height:1.45;color:var(--text);background:var(--bg);color-scheme:dark;-webkit-font-smoothing:antialiased}*{box-sizing:border-box}body{margin:0;background:var(--bg)}button,input,select,textarea{font:inherit;color:inherit}:focus-visible{outline:2px solid var(--accent-ring);outline-offset:2px}::selection{background:#5b8cff59}*{scrollbar-width:thin;scrollbar-color:var(--border-strong) transparent}kbd{display:inline-flex;align-items:center;justify-content:center;min-width:18px;height:18px;padding:0 5px;border:1px solid var(--border-strong);border-bottom-width:2px;border-radius:4px;background:var(--surface-2);color:var(--text-muted);font:600 11px/1 var(--font-mono)}.btn{min-height:34px;padding:0 12px;display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid var(--border-strong);border-radius:var(--radius-sm);background:var(--surface-2);color:var(--text);font-weight:600;white-space:nowrap;cursor:pointer;transition:background .12s,border-color .12s,color .12s}.btn:hover:not(:disabled){background:var(--surface-hover);border-color:#46506a}.btn:disabled{opacity:.45;cur