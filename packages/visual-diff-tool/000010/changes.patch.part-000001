@@ -20,6 +20,17 @@ export function isTypingTarget(target) {
   return ["INPUT", "TEXTAREA", "SELECT"].includes(target?.tagName) || target?.isContentEditable;
 }
 
+/** Markdown のファイルか（書式の違いを無視する比較の対象）。Backend の text_diff.is_markdown_path と同じ判定。 */
+export function isMarkdownPath(path) {
+  return /\.(md|markdown)$/i.test(String(path ?? ""));
+}
+
+/** 書式だけの違い（kind "format"）しかないテキスト差分か。 */
+export function hasOnlyFormatChanges(rows) {
+  const changed = (rows ?? []).filter((row) => row.kind !== "equal");
+  return changed.length > 0 && changed.every((row) => row.kind === "format");
+}
+
 export function normalizeLineEndings(value) {
   return String(value ?? "").replace(/\r\n/g, "\n").replace(/\r/g, "\n");
 }
