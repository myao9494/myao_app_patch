@@ -217,6 +366,9 @@ def build_text_diff_rows(
 
     行番号の表示仕様: 共通行・置換行は左右同じ通し番号、追加行は新側に "A"、削除行は旧側に "D" を
     表示し、追加・削除行は通し番号を消費しない（後続の共通行番号が左右でずれない）。
+
