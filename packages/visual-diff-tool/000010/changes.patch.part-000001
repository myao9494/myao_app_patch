diff --git a/frontend/src/styles.css b/frontend/src/styles.css
index 66027a588d4f0b4d099668d65588f8034d0bfe52..d9ede13dd024de146a884939ca2b1505770e2bf3 100644
--- a/frontend/src/styles.css
+++ b/frontend/src/styles.css
@@ -2076,6 +2076,48 @@ select {
   color: #ffffff;
 }
 
+/* 書式だけの違い（Markdown の空白・空行・箇条書き記号など）。変更ではないので色を抑え、何が違うかだけ薄く示す */
+.diff-code-cell.format {
+  background: rgba(148, 163, 184, 0.08);
+  box-shadow: inset 3px 0 rgba(148, 163, 184, 0.45);
+}
+
+.diff-code-cell.format-gap {
+  background: repeating-linear-gradient(135deg, transparent 0, transparent 6px, rgba(148, 163, 184, 0.08) 6px, rgba(148, 163, 184, 0.08) 12px);
+  box-shadow: inset 3px 0 rgba(148, 163, 184, 0.45);
+}
+
+.diff-code-cell.format mark.changed,
+.diff-code-cell.format .diff-line-sizer mark.changed {
+  background: rgba(148, 163, 184, 0.28) !important;
+  border-radius: 2px;
+}
+
+.text-format-toggle {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  color: var(--text-muted);
+  font-size: 12px;
+  white-space: nowrap;
+}
+
+/* .text-diff-heading label（メモ欄）の幅・寄せを打ち消す */
+.text-diff-heading .text-format-toggle label {
+  flex: none;
+  min-width: 0;
+  max-width: none;
+  margin: 0;
+  display: inline;
+  color: inherit;
+  cursor: pointer;
+}
+
+.badge.format-only {
+  background: rgba(148, 163, 184, 0.16);
+  color: var(--text-muted);
+}
+
 .diff-action-cell {
   min-width: 42px;
   display: grid;
