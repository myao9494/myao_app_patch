+{
+  "folder": "/absolute/path/to/repo", "path": "guide.md", "head_path": "guide.md",
+  "has_head": true, "text_extensions": [".md"], "text": "編集後の全文"
+}`,response:'{ "path": "guide.md", "rows": [/* 差分行 */], "text_current": "編集後の全文" }',notes:"Git差分画面で行を編集したときのプレビューに使う。保存は /api/git/save-text で行う。"}),c.createElement(dt,{method:"POST",path:"/api/git/save-text",purpose:"編集したテキストを作業ツリーのファイルへ保存する。",request:`Content-Type: application/json
