-        if not text:
-            return
-        if segments and segments[-1]["changed"] == changed:
-            segments[-1]["text"] += text
-        else:
-            segments.append({"text": text, "changed": changed})
 
+    # 比較用の文字列が None のトークン（無視する空白）は比較せず、変更なしとして表示する
+    old_compared = [index for index, key in enumerate(old_keys) if key is not None]
+    new_compared = [index for index, key in enumerate(new_keys) if key is not None]
+    matcher = difflib.SequenceMatcher(
+        None,
+        [old_keys[index] for index in old_compared],
+        [new_keys[index] for index in new_compared],
+        autojunk=False,
+    )
+    old_changed = [False] * len(old_tokens)
+    new_changed = [False] * len(new_tokens)
     for tag, old_start, old_end, new_start, new_end in matcher.get_opcodes():
-        changed = tag != "equal"
-        append(old_segments, old_tokens[old_start:old_end], changed)
-        append(new_segments, new_tokens[new_start:new_end], changed)
-    return old_segments, new_segments
+        if tag == "equal":
+            continue
+        for index in old_compared[old_start:old_end]:
+            old_changed[index] = True
+        for index in new_compared[new_start:new_end]:
+            new_changed[index] = True
+    return _merge_segments(old_tokens, old_changed), _merge_segments(new_tokens, new_changed)
+
+
+def _merge_segments(tokens: list[str], changed: list[bool]) -> list[dict]:
+    segments: list[dict] = []
+    for token, is_changed in zip(tokens, changed):
+        if not token:
+            continue
+        if segments and segments[-1]["changed"] == is_changed:
+            segments[-1]["text"] += token
+        else:
+            segments.append({"text": token, "changed": is_changed})
+    return segments
+
+
+def _markdown_tokens(line: str) -> tuple[list[str], list[str | None]]:
+    """書式を無視した行内比較用のトークンと比較用の文字列（None は比較しない空白）。"""
+    body = line.rstrip()
+    trail = line[len(body):]
+    tokens: list[str] = []
+    keys: list[str | None] = []
+    prefix = MARKDOWN_PREFIX_RE.match(body)
+    marker_start, marker_end, marker_key = -1, -1, ""
+    if prefix and (prefix.group(3) or prefix.group(4)):
+        group = 3 if prefix.group(3) else 4
+        marker_start, marker_end = prefix.start(group), prefix.end()
+        marker_key = "\x02L" if group == 3 else "\x02O"
+    for match in MARKDOWN_TOKEN_SPLIT_RE.finditer(body):
+        token = match.group()
+        tokens.append(token)
+        if MARKDOWN_SPACE_RE.fullmatch(token):
+            keys.append(None)
+        elif marker_start <= match.start() < marker_end:
+            # 番号付きリストの「12」「.」のように複数のトークンでも、記号1つとして比べる
+            keys.append(marker_key if match.start() == marker_start else None)
+        elif token == "_":
+            keys.append("*")
+        else:
+            keys.append(token)
+    if trail:
+        tokens.append(trail)
+        keys.append(f"\x01{trail}")
+    return tokens, keys
 
 
 def _prefix_suffix_segments(old_tokens: list[str], new_tokens: list[str]) -> tuple[list[dict], list[dict]]:
diff --git a/docs/claude.md b/docs/claude.md
index 453f39c1a3e9b8f93b3e75fd86c5b86d32b7483f..93c21580c5e09d52e42969707cb110b5a732c50b 100644
--- a/docs/claude.md
+++ b/docs/claude.md
@@ -16,6 +16,10 @@
   - Git差分を開いたとき、前回のフォルダーが残っていれば1回だけ自動で読み込む。対象拡張子を変えたときは、表示中の一覧を自動で読み直す。
   - テキストに保存していない編集があるときは、別のファイルへの移動・一覧の読み直しの前に確認を出し、タブを閉じる前にはブラウザーの確認を出す（編集内容は移動すると残らない）。
   - **Git差分**: 左サイドバーにフォルダー/Markdownの指定（履歴付き）、変更ファイルの一覧（種類アイコン・変更種別バッジ・絞り込み・埋め込みExcalidraw図のサブ項目）、ファイルごとのHTML出力チェックとHTMLプレビュー作成。中央上部に現在のファイル名と前後移動（←/→）。画像はファイル差分と同じビューアと右パネル、テキストは行番号・行内強調付きの左右差分、STEPは3Dビューアで表示する。
+  - **Markdownの書式の違いを無視**: プラグインやリンターで変わりやすい書式だけの違いを変更として扱わない（テキスト差分の上部の「書式の違いを無視」。既定ON、`visual-diff-markdown-ignore-format` に保存。`.md` / `.markdown` だけ）。書式だけの違いの行は `kind: "format"` として薄い灰色で示し（何が違うかも薄く強調）、HEADへ戻すボタンは出さない。HTML出力・HTMLプレビューでも変更として扱わない。開いたファイルが書式だけの違いなら、一覧に「書式のみ」を付ける（一覧の取得時に全ファイルの差分は作らないので、開いたファイルだけ）。
+    - 無視する: 行頭・行中の空白（タブ・全角・表の位置合わせ・日本語と英字の間を含む）、空行の追加・削除（空行は行の対応づけに使わず、前後の行の間へ戻す）、箇条書き記号の種類（`-` `*` `+`）、番号付きリストの番号と `.` / `)`、強調の記号（`_` と `*`）、区切り線の書き方（`---` `***` `___`）、引用の `>` の後の空白、ファイル末尾の改行の有無。
+    - 無視しない: 行末の空白（2つで改行の意味がある）、見出しのレベル、記号の有無（`a` と `- a`、`# a` と `#a`（タグ））、箇条書きと番号付きの違い、チェックボックスの状態。フロントマターとコードブロック（``` / ~~~）の中は書式に意味があるので元のまま比べる。
+    - 本文も変わった行では、行内の強調に空白や記号の違いを含めない。
   - **Markdown内の3D表示**: Dagnetz CAD Viewer の ` ```step ` / ` ```cad ` ブロックは、Markdownの下に「3D表示 n（モデル名）」のサブ項目（`name:` があれば「3D表示「name」（モデル名）」）として並べ、ノートに見えている絵（視点・断面・注記）を画像として HEAD と作業ツリーで比べる。形状の差分（3Dビューア）と別に、注記の追加・変更や視点の変更も差分として見られる。
     - 絵はプラグインの印刷用画像（`printImage` / `composePrintImage`）と同じ手順でブラウザーが描く（`cad-view/renderCadView.js`。白い背景、照明・材質・30°の輪郭線、平行投影の `viewHeight`・視点名・90°回転・モデルの位置と回転、断面の中実キャップ、注記の札と引出線とピン、左下の座標軸、2倍の解像度）。HEAD と作業ツリーを同じ描き方で描くので、違いはノートの設定とモデルの差だけになる。プラグインのHTML出力の画像とモデルの外形の範囲が画素単位で一致することを確認済み。
     - モデルは STEP（メッシュ化ジョブで位置合わせせずに座標のまま。両側が同じファイルなら1回だけ）・STL・OBJ に対応する（FCStd は未対応）。HEAD と作業ツリーのブロックはコードブロックの `name:` で対応づける（並べ替えても同じ名前どうしを比べる。`cad_views.pair_cad_views`）。名前で対応づかなかったブロックは、片方に `name` が無いときだけ出現順で対応づけ（`name` を付ける前のHEADとも比べられるように）、警告で知らせる。名前が付いていて違うものは別の3D表示として扱う。同じ名前が重なったら2つ目以降を「name (2)」で区別する。片側にしかない・モデルが見つからないときは描けた側だけを表示し、もう片側に理由を出す。
@@ -72,7 +76,7 @@
   - `result_cache.py`: しきい値再計算用の補正済み画像キャッシュ。
   - `git_repo.py`: git の起動（Windows向けの起動回数削減）、変更ファイル一覧、HEAD側Blobの取得、パス検証。
   - `markdown_links.py`: Obsidian Markdown を起点にした関連ファイルの再帰収集とショートリンク解決。
-  - `text_diff.py`: テキスト差分の行データ生成（文字コード判定、行対応、行内ハイライト、Excalidrawデータ行の除外）。
+  - `text_diff.py`: テキスト差分の行データ生成（文字コード判定、行対応、行内ハイライト、Excalidrawデータ行の除外、Markdownの書式の違いの無視 `ignore_format`）。
   - `settings_store.py`: サーバー設定ファイルの読み書き。`file_utils.py`: 作業ツリーの安全な読み書き（上限付き読み込み、一時ファイル経由の置き換え、元の文字コードでの書き戻し）。
   - `mesh_jobs.py`: 3D差分ジョブ管理（子プロセス実行、保持期間、ジョブIDの検証）。`step_mesh.py`: STEP読み込みとメッシュ化。`mesh_diff.py`: 位置合わせ・細分化・距離計算・VDM1バイナリ。
   - `attachments.py`: 貼り付け画像の短期保存。`models.py`: APIのレスポンスモデル。
@@ -102,6 +106,7 @@
 - `POST /api/reports/save`: 設定済みのObsidianレポート保存先へ50MB以下の自己完結HTMLを保存する。保存先はリクエスト側から上書きできない。
 - Frontendの画像差分領域は左右ペインのスクロールを同期し、Ctrl+ホイール／ピンチで画像倍率を変更する。Reactの `onWheel` は preventDefault できずブラウザー自体も拡大されるため、`wheel` は `{ passive: false }` で直接登録する（`ImagePane.jsx`・`MemoDiffApp.jsx`）。アプリ表示倍率はブラウザー倍率と分離してlocalStorageへ保存する。
 - `POST /api/git/item`: 片側画像プレビュー、または構造化されたテキスト左右差分を返す。
+- テキスト差分を返す `POST /api/git/item`・`/api/git/text-diff`・`/api/git/save-text`・`/api/git/revert-line` は任意項目 `ignore_format`（Markdownのときだけ効く）で書式だけの違いを `kind: "format"` の行にする。1行復元は同じ規則で差分を作り直して照合するので、画面と同じ値を送る。
 - `POST /api/git/text-diff`: 編集中のテキストとHEADの差分行を返す（ファイルは書き換えない）。
 - `POST /api/git/save-text`: 編集したテキストを作業ツリーへ保存する。改行コード（CRLF/LF）と文字コード（UTF-8 / BOM付きUTF-8 / CP932）は元ファイルに合わせる。`base_text` と現在のファイル内容が違えば（外部で変更されていれば）409で拒否する。
 - `POST /api/git/revert-line`: プレビュー上のテキスト差分行をHEAD内容へ戻す。現在差分と行種別・内容・インデックスが一致しない場合は409で拒否する。レスポンスには復元後の全文（`text_current`）も含め、未編集ならUIの本文を更新する。
