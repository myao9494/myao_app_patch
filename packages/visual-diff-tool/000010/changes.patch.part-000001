}.memo-sticky textarea:focus{box-shadow:inset 0 0 0 2px #d97706}.sticky-delete{position:absolute;z-index:3;top:-10px;right:-10px;width:22px;height:22px;padding:0;border:1px solid #92400e;border-radius:999px;display:grid;place-items:center;background:#78350f;color:#fef3c7;cursor:pointer}.memo-annotation.cloud{border-width:7px;border-style:dotted;border-radius:18px}.memo-annotation.ellipse{border-radius:50%}.memo-annotation.highlight{min-height:2px;border:0;border-radius:4px;background:color-mix(in srgb,var(--annotation-color, #facc15) calc(var(--annotation-opacity, .28) * 100%),transparent);mix-blend-mode:multiply}.memo-annotation.arrow{min-width:18px;min-height:18px;border:0}.memo-arrow{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none}.memo-arrow line{stroke:var(--annotation-color, #ef4444);stroke-width:calc(var(--arrow-stroke-width, 4) * 1px * var(--memo-content-scale, 1));vector-effect:non-scaling-stroke;stroke-linecap:round}.memo-arrow-endpoint{position:absolute;width:18px;height:18px;padding:0;border:3px solid #ffffff;border-radius:999px;background:var(--surface-2);transform:translate(-50%,-50%);cursor:crosshair;z-index:4}.memo-arrow-endpoint.end{border-color:var(--annotation-color, #ef4444);background:#fff}.memo-annotation.selected{z-index:3}.memo-annotation.selected:after{content:"";position:absolute;inset:-6px;border:2px solid var(--accent);border-radius:4px;box-shadow:0 0 0 1px #0f172ae6,0 0 8px #38bdf8bf;pointer-events:none;z-index:2}.memo-annotation-resize{position:absolute;width:20px;height:20px;padding:0;border:1px solid #ffffff;display:grid;place-items:center;background:var(--surface-2);color:#fff;z-index:3}.memo-annotation-resize{right:-10px;bottom:-10px;border-radius:3px;cursor:nwse-resize}.memo-note{position:absolute;z-index:5;min-height:42px;padding:0;cursor:grab;display:flex;touch-action:none;transform:scale(var(--memo-content-scale, 1));transform-origin:top left}.memo-leader{position:absolute;left:-420px;top:-2