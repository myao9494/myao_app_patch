-}`,response:'{ "path": "guide.md", "rows": [/* 差分行 */], "text_current": "編集後の全文" }',notes:"Git差分画面で行を編集したときのプレビューに使う。保存は /api/git/save-text で行う。"}),c.createElement(ft,{method:"POST",path:"/api/git/save-text",purpose:"編集したテキストを作業ツリーのファイルへ保存する。",request:`Content-Type: application/json
