diff --git a/docs/three_diff_section_and_smart_dimension.excalidraw b/docs/three_diff_section_and_smart_dimension.excalidraw
new file mode 100644
index 0000000000000000000000000000000000000000..2e0723657dba8432d00ebacc8fcf94fef451431e
--- /dev/null
+++ b/docs/three_diff_section_and_smart_dimension.excalidraw
@@ -0,0 +1,88 @@
+{
+  "type": "excalidraw",
+  "version": 2,
+  "source": "https://excalidraw.com",
+  "elements": [
+    {
+      "id": "box_smart_dimension",
+      "type": "rectangle",
+      "x": 40,
+      "y": 40,
+      "width": 300,
+      "height": 170,
+      "strokeColor": "#1971c2",
+      "backgroundColor": "#e7f5ff",
+      "fillStyle": "solid",
+      "strokeWidth": 2,
+      "roughness": 0,
+      "roundness": { "type": 3 }
+    },
+    {
+      "id": "text_smart_dimension",
+      "type": "text",
+      "x": 55,
+      "y": 55,
+      "width": 270,
+      "height": 140,
+      "text": "【スマート寸法測定 & 切替】\n- 頂点スナップ (Raycaster)\n- 3点円弧指定 → 穴径(φ) / 半径(R) 自動認識\n- 45°傾斜面指定 → 面取り(C) 自動認識\n- 2点指定 → 直線距離(L, dX, dY, dZ)\n- 手動切替ピル (φ / R / 直線 / C)",
+      "fontSize": 13,
+      "fontFamily": 1,
+      "textAlign": "left",
+      "verticalAlign": "top"
+    },
+    {
+      "id": "box_drag_leader",
+      "type": "rectangle",
+      "x": 380,
+      "y": 40,
+      "width": 300,
+      "height": 170,
+      "strokeColor": "#2f9e44",
+      "backgroundColor": "#ebfbee",
+      "fillStyle": "solid",
+      "strokeWidth": 2,
+      "roughness": 0,
+      "roundness": { "type": 3 }
+    },
+    {
+      "id": "text_drag_leader",
+      "type": "text",
+      "x": 395,
+      "y": 55,
+      "width": 270,
+      "height": 140,
+      "text": "【ドラッグ位置調整 & 引き出し線】\n- 寸法バッジのマウスドラッグ移動\n- 注記カードヘッダーのドラッグ移動\n- 計測中心点/ピンから破線引き出し線追従\n- 密集箇所でも重ならず見やすく配置\n- 左右並べ画面 (Side-by-Side) 完全同期",
+      "fontSize": 13,
+      "fontFamily": 1,
+      "textAlign": "left",
+      "verticalAlign": "top"
+    },
+    {
+      "id": "box_solid_section",
+      "type": "rectangle",
+      "x": 40,
+      "y": 250,
+      "width": 640,
+      "height": 200,
+      "strokeColor": "#e8590c",
+      "backgroundColor": "#fff4e6",
+      "fillStyle": "solid",
+      "strokeWidth": 2,
+      "roughness": 0,
+      "roundness": { "type": 3 }
+    },
+    {
+      "id": "text_solid_section",
+      "type": "text",
+      "x": 55,
+      "y": 265,
+      "width": 610,
+      "height": 170,
+      "text": "【CAD中実ハッチング断面表示 (Solid Section Plane)】\n1. 操作UI: 切断軸切替 (X/Y/Z) ＋ 位置スライダー ＋ 反転 (Flip)\n2. クリッピング平面: THREE.Plane によるリアルタイム空間クリッピング\n3. 擬似中実化 (Three.js Stencil Buffer Cap):\n   - BackFace Pass: depthTest=false, IncrementWrapStencilOp (裏面カウント)\n   - FrontFace Pass: depthTest=false, DecrementWrapStencilOp (表面カウント)\n   - Cap Plane: NotEqualStencilFunc (中実ソリッド内部のみ描画)\n4. CADハッチング: 45°斜線 CanvasTexture 動的生成 (完全オフライン)",
+      "fontSize": 13,
+      "fontFamily": 1,
+      "textAlign": "left",
+      "verticalAlign": "top"
+    }
+  ]
+}
