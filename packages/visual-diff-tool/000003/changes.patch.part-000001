+++ /dev/null
@@ -1 +0,0 @@
-.three-diff-container{display:flex;flex-direction:column;width:100%;height:100%;background:var(--bg-primary, #0f172a);color:var(--text-primary, #f8fafc);overflow:hidden}.three-diff-toolbar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;padding:10px 16px;background:var(--bg-secondary, #1e293b);border-bottom:1px solid var(--border-color, #334155);font-size:13px;z-index:10}.three-diff-controls-group{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.three-diff-input-group{display:flex;align-items:center;gap:6px}.three-diff-input-group label{color:#94a3b8;font-size:12px}.three-diff-select,.three-diff-input{background:#0f172a;color:#f8fafc;border:1px solid #475569;border-radius:4px;padding:4px 8px;font-size:12px}.three-diff-btn{display:inline-flex;align-items:center;gap:6px;background:#334155;color:#f8fafc;border:1px solid #475569;border-radius:4px;padding:6px 12px;font-size:13px;cursor:pointer;transition:background .15s,border-color .15s}.three-diff-btn:hover:not(:disabled){background:#475569;border-color:#64748b}.three-diff-btn:disabled{opacity:.5;cursor:not-allowed}.three-diff-btn-primary{background:#2563eb;border-color:#3b82f6;font-weight:500}.three-diff-btn-primary:hover:not(:disabled){background:#1d4ed8;border-color:#60a5fa}.three-diff-slider-box{display:flex;align-items:center;gap:8px;background:#0f172a;padding:4px 10px;border-radius:6px;border:1px solid #334155}.three-diff-slider-box input[type=range]{width:140px;cursor:pointer;accent-color:#3b82f6}.three-diff-stat-badge{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:12px;font-size:11px;font-weight:600}.badge-added{background:#22c55e33;color:#4ade80;border:1px solid rgba(34,197,94,.4)}.badge-deleted{background:#ef444433;color:#f87171;border:1px solid rgba(239,68,68,.4)}.three-diff-workspace{display:flex;flex:1;position:relative;overflow:hidden}.three-diff-canvas-area{display:flex;flex:1;height:100%;position:relative;background:#090d16}.three-diff-viewport{position:relative;flex:1;height:100%;overflow:hidden}.three-diff-viewport canvas{width:100%!important;height:100%!important;display:block}.viewport-label{position:absolute;top:10px;left:12px;background:#0f172ad9;border:1px solid #334155;padding:4px 10px;border-radius:4px;font-size:12px;font-weight:600;pointer-events:none;z-index:5}.three-diff-setup-card{display:flex;flex-direction:column;gap:16px;max-width:680px;margin:30px auto;padding:24px;background:#1e293b;border:1px solid #334155;border-radius:8px;box-shadow:0 10px 25px #00000080}.dropzone-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}.step-dropzone{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px 16px;border:2px dashed #475569;border-radius:6px;background:#0f172a;cursor:pointer;text-align:center;transition:border-color .15s,background .15s}.step-dropzone:hover{border-color:#3b82f6;background:#131d33}.step-dropzone.has-file{border-color:#22c55e;border-style:solid}.dropzone-title{font-weight:600;font-size:14px;margin-bottom:4px}.dropzone-filename{font-size:12px;color:#94a3b8;word-break:break-all}.samples-selector{display:flex;align-items:center;gap:8px;font-size:12px;color:#94a3b8;padding-top:8px;border-top:1px solid #334155}.three-diff-warning-box{padding:8px 12px;background:#eab30826;border:1px solid rgba(234,179,8,.4);border-radius:4px;color:#fde047;font-size:12px;margin:8px 16px;display:flex;flex-direction:column;gap:4px}.three-diff-error-box{padding:10px 14px;background:#ef444426;border:1px solid rgba(239,68,68,.4);border-radius:4px;color:#fca5a5;font-size:13px;margin:12px 16px}.three-diff-progress-overlay{position:absolute;inset:0;background:#0f172ad9;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;z-index:50}.three-diff-progress-bar{width:320px;height:8px;background:#334155;border-radius:4px;overflow:hidden}.three-diff-progress-fill{height:100%;background:#3b82f6;transition:width .3s}.three-diff-stats-drawer{padding:6px 16px;background:#0f172a;border-top:1px solid #334155;font-size:11px;color:#94a3b8;display:flex;flex-wrap:wrap;gap:16px;align-items:center}
