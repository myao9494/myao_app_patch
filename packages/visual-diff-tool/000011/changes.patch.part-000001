+def annotate_history_markdown(repo: Path, commits: list[dict]) -> None:
+    """履歴の各段（Markdown）に、そのコミットでの埋め込みExcalidraw図と3D表示の一覧を付ける。
+
+    変更一覧と同じ規則（Excalidraw はどちらかの側にあれば、3D表示は変更後の側・削除なら変更前の側）。
+    コミットごとに git を起動しないよう、`cat-file --batch` の常駐1プロセスで読む。
+    """
+    from .cad_views import cad_view_summaries
+    from .text_diff import MAX_TEXT_BYTES, decode_git_text
+
+    with GitBlobBatch(repo) as batch:
+        for commit in commits:
+            commit["embedded_excalidraw"] = False
+            commit["cad_views"] = []
+            if not commit["path"].lower().endswith(".md") or commit["path"].lower().endswith(EXCALIDRAW_MARKDOWN_SUFFIXES):
+                continue
+            new = batch.read(commit["path"], MAX_TEXT_BYTES, rev=commit["new_rev"]) if commit["has_current"] else None
+            old = batch.read(commit["head_path"], MAX_TEXT_BYTES, rev=commit["old_rev"]) if commit["has_head"] else None
+            commit["embedded_excalidraw"] = any(
+                content is not None and EXCALIDRAW_PLUGIN_MARKER_RE.search(content.decode("utf-8", errors="ignore"))
+                for content in (new, old)
+            )
+            source = new if new is not None else old
+            if source and b"```" in source:
+                try:
+                    text, _ = decode_git_text(source)
+                    commit["cad_views"] = cad_view_summaries(text)
+                except HTTPException:
+                    pass
+
+
 def text_extensions_from_payload(payload: dict) -> set[str]:
