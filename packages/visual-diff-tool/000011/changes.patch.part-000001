diff --git a/frontend/test/git_history.test.js b/frontend/test/git_history.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..339978a7189e56aa39de3df1df19f1021e9b355e
--- /dev/null
+++ b/frontend/test/git_history.test.js
@@ -0,0 +1,75 @@
+/**
+ * ファイルの履歴（git/gitHistory.js）の単体テスト。
+ * - 段は古い順のコミットに、最後の「HEAD → 作業ツリー」（一覧の項目そのもの）を足したもの
+ * - Markdown の段は、そのコミットにある Excalidraw図・3D表示をサブ項目に展開する
+ * - 開いたときは、いちばん新しいコミットの本体を選ぶ
+ * - 過去の段は範囲・メモのキーを「パス@コミット」にして、作業ツリーのものと混ぜない
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  formatCommitDate,
+  gitFileTargets,
+  gitHistorySteps,
+  gitHistoryTargets,
+  gitRevisionPath,
+  initialHistoryIndex,
+  isHistoricalStep,
+  newSideTitle,
+  oldSideTitle,
+} from "../src/git/gitHistory.js";
+
+const file = {
+  path: "notes/a.md",
+  head_path: "notes/a.md",
+  kind: "text",
+  change_type: "modified",
+  has_head: true,
+  has_current: true,
+  diffable: true,
+  embedded_excalidraw: false,
+  cad_views: [],
+};
+
+const commits = [
+  { commit: "a".repeat(40), short: "aaaaaaa", parent: null, subject: "add", date: "2026-11-01T09:05:00+09:00", change_type: "added", path: "a.md", head_path: "a.md", old_rev: null, new_rev: "a".repeat(40), has_head: false, has_current: true },
+  { commit: "b".repeat(40), short: "bbbbbbb", parent: "a".repeat(40), subject: "edit", date: "2026-11-02T10:00:00+09:00", change_type: "renamed", path: "notes/a.md", head_path: "a.md", old_rev: "a".repeat(40), new_rev: "b".repeat(40), has_head: true, has_current: true, embedded_excalidraw: true, cad_views: [{ key: "part", name: "part" }] },
+];
+
+test("steps are commits oldest first, then the working-tree change", () => {
+  const steps = gitHistorySteps(file, commits);
+  assert.equal(steps.length, 3);
+  assert.equal(steps[0].commit.short, "aaaaaaa");
+  assert.equal(steps[0].diffable, false);
+  assert.equal(steps[1].head_path, "a.md");
+  assert.equal(steps[1].kind, "text");
+  assert.equal(steps[2].commit, null);
+  assert.equal(steps[2].path, file.path);
+  assert.equal(isHistoricalStep(steps[1]), true);
+  assert.equal(isHistoricalStep(steps[2]), false);
+});
+
+test("markdown steps expand embedded drawings and 3D views", () => {
+  const targets = gitHistoryTargets(gitHistorySteps(file, commits));
+  assert.deepEqual(targets.map((target) => target.mode), ["text", "text", "excalidraw", "cad-view:part", "text"]);
+  assert.deepEqual(gitFileTargets({ ...file, kind: "3d" }).map((target) => target.mode), ["3d"]);
+});
+
+test("opens at the newest commit's main view", () => {
+  const targets = gitHistoryTargets(gitHistorySteps(file, commits));
+  assert.equal(initialHistoryIndex(targets), 1);
+  assert.equal(initialHistoryIndex(gitHistoryTargets(gitHistorySteps(file, []))), 0);
+});
+
+test("past steps use their own keys and labels", () => {
+  const [added, edit, worktree] = gitHistorySteps(file, commits);
+  assert.equal(oldSideTitle(added), "変更前（なし）");
+  assert.equal(gitRevisionPath(edit), `notes/a.md@${"b".repeat(40)}`);
+  assert.equal(gitRevisionPath(worktree), "notes/a.md");
+  assert.equal(oldSideTitle(edit), "変更前（aaaaaaa）");
+  assert.equal(newSideTitle(edit), "変更後（bbbbbbb）");
+  assert.equal(oldSideTitle(worktree), "変更前（HEAD）");
+  assert.equal(newSideTitle(worktree), "変更後（作業ツリー）");
+  assert.equal(formatCommitDate("2026-11-02T10:00:00+09:00"), "2026-11-02 10:00");
+});
diff --git a/tests/test_git_file_history.py b/tests/test_git_file_history.py
new file mode 100644
index 0000000000000000000000000000000000000000..daa92ab482c042ea3d7801ff4ad109787102779b
--- /dev/null
+++ b/tests/test_git_file_history.py
@@ -0,0 +1,149 @@
+"""
+ファイルの履歴（POST /api/git/history）と、版を指定した比較（old_rev / new_rev）のテスト。
+- 履歴はファイルを変えたコミットを古い順に返し、名前の変更もたどる（1つ目は追加、その後は直前のコミットとの比較）
+- /api/git/item・/api/git/diff は old_rev / new_rev で過去のコミットどうしを比べる（未指定は HEAD と作業ツリー）
+- 版の指定は HEAD かコミットの16進IDだけ（オプションのような値は 422）
+- Markdown は各コミットでの埋め込みExcalidraw図・3D表示の一覧を付ける
+"""
+
+import io
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+from fastapi.testclient import TestClient
+from PIL import Image
+
+from backend.app.main import app
+
+
+def _git(cwd: Path, *args: str) -> str:
+    return subprocess.run(["git", "-C", str(cwd), *args], check=True, capture_output=True, text=True).stdout
+
+
+def _png(color: tuple[int, int, int], box: tuple[int, int, int, int] | None = None) -> bytes:
+    image = Image.new("RGB", (64, 48), "white")
+    if box:
+        for x in range(box[0], box[2]):
+            for y in range(box[1], box[3]):
+                image.putpixel((x, y), color)
+    buffer = io.BytesIO()
+    image.save(buffer, format="PNG")
+    return buffer.getvalue()
+
+
+class TestGitFileHistory(unittest.TestCase):
+    def setUp(self):
+        self.client = TestClient(app)
+        self.temp_dir = tempfile.TemporaryDirectory()
+        self.repo = Path(self.temp_dir.name) / "repo"
+        self.repo.mkdir()
+        _git(self.repo, "init", "--quiet", "-b", "main")
+        _git(self.repo, "config", "user.email", "test@example.com")
+        _git(self.repo, "config", "user.name", "Tester")
+        self.commits = []
+        for index, text in enumerate(["one\n", "one\ntwo\n", "one\ntwo\nthree\n"]):
+            (self.repo / "note.md").write_text(text, encoding="utf-8")
+            (self.repo / "other.txt").write_text(f"{index}\n", encoding="utf-8")
+            _git(self.repo, "add", ".")
+            _git(self.repo, "commit", "--quiet", "-m", f"step {index + 1}")
+            self.commits.append(_git(self.repo, "rev-parse", "HEAD").strip())
+        # 名前の変更
+        _git(self.repo, "mv", "note.md", "renamed.md")
+        _git(self.repo, "commit", "--quiet", "-m", "rename")
+        self.commits.append(_git(self.repo, "rev-parse", "HEAD").strip())
+        # 作業ツリーの変更（変更一覧に出る）
+        (self.repo / "renamed.md").write_text("one\ntwo\nthree\nfour\n", encoding="utf-8")
+
+    def tearDown(self):
+        self.temp_dir.cleanup()
+
+    def _history(self, path, **extra):
+        return self.client.post("/api/git/history", json={"folder": str(self.repo), "path": path, "text_extensions": [".md", ".txt"], **extra})
+
+    def test_history_lists_commits_oldest_first_and_follows_renames(self):
+        response = self._history("renamed.md")
+        self.assertEqual(response.status_code, 200, response.text)
+        commits = response.json()["commits"]
+        self.assertEqual([item["subject"] for item in commits], ["step 1", "step 2", "step 3", "rename"])
+        first, second, _, rename = commits
+        self.assertEqual(first["change_type"], "added")
+        self.assertFalse(first["has_head"])
+        self.assertEqual(first["new_rev"], self.commits[0])
+        self.assertEqual(second["old_rev"], self.commits[0])
+        self.assertEqual(second["new_rev"], self.commits[1])
+        self.assertTrue(second["diffable"])
+        self.assertEqual(rename["change_type"], "renamed")
+        self.assertEqual(rename["head_path"], "note.md")
+        self.assertEqual(rename["path"], "renamed.md")
+        # Markdown のサブ項目の情報も付く
+        self.assertIn("cad_views", second)
+        self.assertFalse(second["embedded_excalidraw"])
+
+    def test_item_compares_two_past_commits(self):
+        response = self.client.post(
+            "/api/git/item",
+            json={
+                "folder": str(self.repo),
+                "path": "note.md",
+                "head_path": "note.md",
+                "old_rev": self.commits[0],
+                "new_rev": self.commits[1],
+                "text_extensions": [".md"],
+            },
+        )
+        self.assertEqual(response.status_code, 200, response.text)
+        body = response.json()
+        self.assertEqual(body["text_head"], "one\n")
+        self.assertEqual(body["text_current"], "one\ntwo\n")
+        self.assertIn("insert", {row["kind"] for row in body["rows"]})
+
+    def test_item_without_revisions_still_compares_head_and_worktree(self):
+        response = self.client.post(
+            "/api/git/item",
+            json={"folder": str(self.repo), "path": "renamed.md", "head_path": "renamed.md", "text_extensions": [".md"]},
+        )
+        self.assertEqual(response.status_code, 200, response.text)
+        self.assertEqual(response.json()["text_current"], "one\ntwo\nthree\nfour\n")
+
+    def test_rejects_option_like_revisions(self):
+        for bad in ("--output=/tmp/x", "HEAD~1", "main", "../x"):
+            response = self.client.post(
+                "/api/git/item",
+                json={"folder": str(self.repo), "path": "note.md", "old_rev": bad, "new_rev": self.commits[1], "text_extensions": [".md"]},
+            )
+            self.assertEqual(response.status_code, 422, bad)
+
+    def test_untracked_file_has_no_commits(self):
+        (self.repo / "fresh.md").write_text("x\n", encoding="utf-8")
+        response = self._history("fresh.md", has_head=False)
+        self.assertEqual(response.status_code, 200, response.text)
+        self.assertEqual(response.json()["commits"], [])
+
+    def test_image_diff_between_past_commits(self):
+        (self.repo / "pic.png").write_bytes(_png((0, 0, 0)))
+        _git(self.repo, "add", "pic.png")
+        _git(self.repo, "commit", "--quiet", "-m", "pic 1")
+        first = _git(self.repo, "rev-parse", "HEAD").strip()
+        (self.repo / "pic.png").write_bytes(_png((255, 0, 0), (10, 10, 30, 30)))
+        _git(self.repo, "commit", "--quiet", "-am", "pic 2")
+        second = _git(self.repo, "rev-parse", "HEAD").strip()
+        # 作業ツリーは別の内容にしておき、過去の2つを比べていることを確かめる
+        (self.repo / "pic.png").write_bytes(_png((0, 0, 255), (0, 0, 64, 48)))
+
+        history = self._history("pic.png").json()["commits"]
+        self.assertEqual([item["new_rev"] for item in history], [first, second])
+
+        response = self.client.post(
+            "/api/git/diff",
+            json={"folder": str(self.repo), "path": "pic.png", "head_path": "pic.png", "old_rev": first, "new_rev": second},
+        )
+        self.assertEqual(response.status_code, 200, response.text)
+        body = response.json()
+        self.assertGreater(body["diff_pixels"], 0)
+        self.assertLess(body["diff_ratio"], 0.5)  # 作業ツリー（全面が青）と比べていない
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_git_markdown_include_links.py b/tests/test_git_markdown_include_links.py
new file mode 100644
index 0000000000000000000000000000000000000000..28522606e53b71fcf78000fbbd72a1d1b7e87ebc
--- /dev/null
+++ b/tests/test_git_markdown_include_links.py
@@ -0,0 +1,74 @@
+"""
+Markdown を起点にした Git 差分で、リンク先のファイルも含めるかを選ぶ（include_links）テスト。
+- 既定（include_links 未指定・true）は、ノートとリンク先（画像・ノート）の変更を返す（従来どおり）
+- include_links: false は、そのノートだけを返す
+- コミットも同じ範囲で照合する（false のとき、リンク先のファイルは一覧に無いので 409）
+- GET /api/git/path・/api/git/markdown は ?include_links=false で同じように絞る
+"""
+
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+from fastapi.testclient import TestClient
+
+from backend.app.main import app
+
+
+def _git(repo: Path, *args: str) -> None:
+    subprocess.run(["git", "-C", str(repo), *args], check=True, capture_output=True, text=True)
+
+
+class GitMarkdownIncludeLinksTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.client = TestClient(app)
+        self._tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self._tmp.cleanup)
+        self.repo = Path(self._tmp.name).resolve() / "repo"
+        self.repo.mkdir()
+        _git(self.repo, "init", "-q")
+        _git(self.repo, "config", "user.email", "test@example.invalid")
+        _git(self.repo, "config", "user.name", "test")
+        (self.repo / "note.md").write_text("# ノート\n\n[[child]]\n", encoding="utf-8")
+        (self.repo / "child.md").write_text("子\n", encoding="utf-8")
+        (self.repo / "unrelated.md").write_text("無関係\n", encoding="utf-8")
+        _git(self.repo, "add", "-A")
+        _git(self.repo, "commit", "-q", "-m", "init")
+        (self.repo / "note.md").write_text("# ノート\n\n[[child]]\n追記\n", encoding="utf-8")
+        (self.repo / "child.md").write_text("子を変えた\n", encoding="utf-8")
+        (self.repo / "unrelated.md").write_text("無関係も変えた\n", encoding="utf-8")
+        self.note = str(self.repo / "note.md")
+
+    def paths(self, **extra) -> list[str]:
+        response = self.client.post("/api/git/files", json={"folder": self.note, "text_extensions": [".md"], **extra})
+        self.assertEqual(response.status_code, 200, response.text)
+        return sorted(item["path"] for item in response.json()["files"])
+
+    def test_既定はリンク先も含める(self) -> None:
+        self.assertEqual(self.paths(), ["child.md", "note.md"])
+        self.assertEqual(self.paths(include_links=True), ["child.md", "note.md"])
+
+    def test_falseならノートだけ(self) -> None:
+        self.assertEqual(self.paths(include_links=False), ["note.md"])
+        body = self.client.post("/api/git/files", json={"folder": self.note, "include_links": False}).json()
+        self.assertIs(body["include_links"], False)
+
+    def test_コミットも同じ範囲で照合する(self) -> None:
+        response = self.client.post(
+            "/api/git/commit",
+            json={"folder": self.note, "include_links": False, "text_extensions": [".md"], "paths": ["child.md"], "message": "x"},
+        )
+        self.assertEqual(response.status_code, 409, response.text)
+
+    def test_GETでも絞れる(self) -> None:
+        body = self.client.get("/api/git/path", params={"path": self.note, "include_links": "false"}).json()
+        self.assertEqual([item["path"] for item in body["files"]], ["note.md"])
+        body = self.client.get("/api/git/markdown", params={"path": self.note, "include_links": "false"}).json()
+        self.assertEqual([item["path"] for item in body["files"]], ["note.md"])
+        body = self.client.get("/api/git/path", params={"path": self.note}).json()
+        self.assertEqual(sorted(item["path"] for item in body["files"]), ["child.md", "note.md"])
+
+
+if __name__ == "__main__":
+    unittest.main()
