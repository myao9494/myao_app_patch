     except OSError as exc:
-        raise HTTPException(status_code=404, detail=f"HEAD側の画像を取得できません: {rel_path}") from exc
+        raise HTTPException(status_code=404, detail=f"{label}側のファイルを取得できません: {rel_path}") from exc
 
     # 読み出しが滞った場合に備え、既存の timeout=20 と同じ時間で強制終了する。
     timed_out = threading.Event()
@@ -438,14 +471,120 @@ def git_show(repo: Path, rel_path: str, *, max_bytes: int | None = None) -> byte
         process.stdout.close()
         returncode = process.wait()
     if oversized:
-        raise HTTPException(status_code=413, detail=f"HEAD:{rel_path} が上限（{max_bytes // (1024 * 1024)} MB）を超えています")
+        raise HTTPException(status_code=413, detail=f"{label}:{rel_path} が上限（{max_bytes // (1024 * 1024)} MB）を超えています")
     if timed_out.is_set():
-        raise HTTPException(status_code=504, detail="HEADの内容の取得がタイムアウトしました")
+        raise HTTPException(status_code=504, detail=f"{label}の内容の取得がタイムアウトしました")
     if returncode != 0:
-        raise HTTPException(status_code=404, detail=f"HEAD側の画像を取得できません: {rel_path}")
+        raise HTTPException(status_code=404, detail=f"{label}側のファイルを取得できません: {rel_path}")
     return content
 
 
+# --- コミットごとの履歴 -------------------------------------------------------------
+# 履歴の各段は「あるコミット」と「その直前（1つ目の親）」の比較。API では
+#   old_rev: 変更前の版（既定 "HEAD"）
+#   new_rev: 変更後の版（既定 None = 作業ツリー）
+# で表す。どちらも "HEAD" かコミットの16進IDだけを受け付ける（`--` で始まる値などを git に渡さない）。
+REVISION_RE = re.compile(r"^(HEAD|[0-9a-f]{4,64})$")
+MAX_HISTORY_COMMITS = 300
+
+
+def normalize_revision(value) -> str | None:
+    """版の指定を検証する。None・空は None（作業ツリー）。"""
+    if value is None:
+        return None
+    text = str(value).strip()
+    if not text:
+        return None
+    if not REVISION_RE.fullmatch(text):
+        raise HTTPException(status_code=422, detail=f"版の指定が正しくありません: {text[:20]}")
+    return text
+
+
+def payload_revisions(payload: dict) -> tuple[str, str | None]:
+    """(変更前の版, 変更後の版)。変更後が None なら作業ツリー。"""
+    return normalize_revision(payload.get("old_rev")) or "HEAD", normalize_revision(payload.get("new_rev"))
+
+
+def revision_label(rev: str | None) -> str:
+    """画面やファイル名に出す版の名前（HEAD / 短いコミットID / 作業ツリー）。"""
+    if rev is None:
+        return "作業ツリー"
+    return rev if rev == "HEAD" else rev[:7]
+
+
+def read_revision_file(repo: Path, rel_path: str, rev: str | None, max_bytes: int) -> bytes:
+    """版 rev のファイルを読む。rev が None なら作業ツリーのファイル。"""
+    if rev is not None:
+        return git_show(repo, rel_path, max_bytes=max_bytes, rev=rev)
+    current_path = repo / rel_path
+    if not current_path.is_file():
+        raise HTTPException(status_code=404, detail=f"ファイルが見つかりません: {rel_path}")
+    return read_file_limited(current_path, max_bytes, rel_path)
+
+
+def file_history(repo: Path, rel_path: str, *, limit: int = MAX_HISTORY_COMMITS) -> list[dict]:
+    """ファイルを変えたコミットの一覧（古い順）。名前の変更もたどる（`--follow`）。
+
+    各コミットは「1つ目の親 → そのコミット」の比較として、両側のパスと有無を返す。
+    差分の表示されないマージコミット（このファイルを自分では変えていない）は含めない。
+    """
+    output = git_output(
+        [
+            "log", "--follow", "-M", f"-n{int(limit)}", "-z", "--name-status",
+            "--format=%x1e%H%x1f%P%x1f%an%x1f%aI%x1f%s",
+            "--", rel_path,
+        ],
+        repo,
+    )
+    commits: list[dict] = []
+    for record in output.split("\x1e"):
+        if not record.strip("\0\n"):
+            continue
+        header, _, body = record.partition("\0")
+        fields = header.split("\x1f")
+        if len(fields) != 5:
+            continue
+        sha, parents, author, date, subject = fields
+        tokens = [token for token in body.lstrip("\n").split("\0") if token]
+        if not tokens:
+            continue  # マージコミットなど、このファイルの差分が出ないもの
+        status = tokens[0]
+        if status[:1] in ("R", "C") and len(tokens) >= 3:
+            old_path, new_path = tokens[1], tokens[2]
+        elif len(tokens) >= 2:
+            old_path = new_path = tokens[1]
+        else:
+            continue
+        parent = parents.split()[0] if parents.split() else None
+        code = status[:1]
+        has_head = code != "A" and parent is not None
+        has_current = code != "D"
+        change_type = {"A": "added", "D": "deleted", "R": "renamed", "C": "copied"}.get(code, "modified")
+        if not has_head:
+            change_type = "added"
+        commits.append(
+            {
+                "commit": sha,
+                "short": sha[:7],
+                "parent": parent,
+                "author": author,
+                "date": date,
+                "subject": subject,
+                "status": status,
+                "change_type": change_type,
+                "path": new_path,
+                "head_path": old_path,
+                "old_rev": parent,
+                "new_rev": sha,
+                "has_head": has_head,
+                "has_current": has_current,
+                "diffable": has_head and has_current,
+            }
+        )
+    commits.reverse()
+    return commits
+
+
