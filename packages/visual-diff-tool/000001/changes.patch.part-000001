+}`,notes:"保存ファイルは保持期限後にcleanup対象になる。外部アプリが一時添付の追跡をしたい場合に使う。"}),c.createElement(tl,{method:"POST",path:"/api/git/images",purpose:"互換用API。指定フォルダのGit差分から変更画像を一覧する。",request:`Content-Type: application/json
