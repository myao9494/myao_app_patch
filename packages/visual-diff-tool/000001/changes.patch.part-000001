   color: #dbeafe;
   white-space: pre-wrap;
   overflow-wrap: anywhere;
+  word-break: break-word;
   tab-size: 4;
-  font: 12px/1.35 ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
+  font: 12px/1.4 ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
+  background: transparent !important;
 }
 
 .diff-line-editor-wrap {
   position: relative;
-  min-width: 0;
-  min-height: 22px;
+  width: 100%;
+  min-height: 20px;
   display: block;
 }
 
-.diff-line-highlight {
-  position: absolute;
-  inset: 0;
-  z-index: 0;
-  color: transparent;
+/* サイザー: 通常のドキュメントフロー要素として、テキストの折り返し行数に応じて物理的に親高さを押し広げる */
+.diff-line-sizer {
+  display: block;
+  width: 100%;
+  min-height: 20px;
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+  border: 0;
+  font: inherit;
+  font-family: inherit;
+  font-size: inherit;
+  line-height: inherit;
   white-space: pre-wrap;
   overflow-wrap: anywhere;
   word-break: break-word;
   tab-size: 4;
+  color: transparent;
   pointer-events: none;
+  user-select: none;
 }
 
-.diff-line-highlight mark {
+.diff-line-sizer mark.changed {
   color: transparent !important;
+  border-radius: 2px;
+}
+
+.diff-code-cell.added .diff-line-sizer mark.changed {
+  background: #4ade80 !important;
+  box-shadow: 0 0 0 1px #16a34a;
+}
+
+.diff-code-cell.removed .diff-line-sizer mark.changed {
+  background: #f87171 !important;
+  box-shadow: 0 0 0 1px #dc2626;
 }
 
+/* エディタ: サイザーが押し広げた高さに完全にフィットして重なる絶対配置 */
 .diff-line-editor {
-  position: relative;
-  z-index: 1;
+  position: absolute;
+  top: 0;
+  left: 0;
   width: 100%;
-  min-height: 22px;
+  height: 100%;
+  box-sizing: border-box;
   margin: 0;
   padding: 0;
   border: 0;
   outline: 0;
-  overflow: hidden;
   resize: none;
+  overflow: hidden;
   background: transparent;
   color: inherit;
+  font: inherit;
+  font-family: inherit;
+  font-size: inherit;
+  line-height: inherit;
   white-space: pre-wrap;
   overflow-wrap: anywhere;
   word-break: break-word;
   tab-size: 4;
-  font: inherit;
-  line-height: inherit;
+  z-index: 1;
 }
 
