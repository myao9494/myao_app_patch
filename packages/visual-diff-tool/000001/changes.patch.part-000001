+TOKEN_SPLIT_RE = re.compile(
+    r"[a-zA-Z0-9_]+"               # 英数字・アンダースコア（Python識別子、英単語）
+    r"|[\u4e00-\u9faf]+"          # 漢字の連続
+    r"|[\u3040-\u309f]+"          # ひらがなの連続
+    r"|[\u30a0-\u30ff]+"          # カタカナの連続
