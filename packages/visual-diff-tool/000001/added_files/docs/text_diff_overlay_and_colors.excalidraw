      "width": 840,
      "height": 60,
      "strokeColor": "#2b8a3e",
      "backgroundColor": "#ebfbee",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "roundness": { "type": 3 }
    },
    {
      "id": "text_title",
      "type": "text",
      "x": 60,
      "y": 45,
      "width": 800,
      "height": 30,
      "text": "テキスト差分表示スタイル改善 & CSS Gridオーバーレイ設計（重なり解消）",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "box_old_issue",
      "type": "rectangle",
      "x": 40,
      "y": 110,
      "width": 400,
      "height": 260,
      "strokeColor": "#e03131",
      "backgroundColor": "#fff5f5",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "roughness": 0,
      "roundness": { "type": 3 }
    },
    {
      "id": "title_old_issue",
      "type": "text",
      "x": 60,
      "y": 125,
      "width": 360,
      "height": 24,
      "text": "【旧仕様の課題】",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "desc_old_issue",
      "type": "text",
      "x": 60,
      "y": 160,
      "width": 360,
      "height": 190,
      "text": "1. 視認性の問題:\n   ・変更箇所の緑背景の上に「白文字」が重なり\n     コントラスト不足で読みにくい\n   ・追加行/削除行の背景が暗く一目で分かりにくい\n\n2. セルの重なりバグ:\n   ・.diff-line-highlight が position: absolute のため\n     文字が折り返されても親セルの高さを広げられない\n   ・textareaの固定高さ(24px)により、折り返された\n     2行目以降の文字が下の行に被さって潰れる",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "box_new_solution",
      "type": "rectangle",
      "x": 470,
      "y": 110,
      "width": 410,
      "height": 260,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#f4fce3",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "roughness": 0,
      "roundness": { "type": 3 }
    },
    {
      "id": "title_new_solution",
      "type": "text",
      "x": 490,
      "y": 125,
      "width": 370,
      "height": 24,
      "text": "【新仕様の解決策】",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "desc_new_solution",
      "type": "text",
      "x": 490,
      "y": 160,
      "width": 370,
      "height": 190,
      "text": "1. VS Code風の緑/赤背景 + 黒文字:\n   ・追加行: 明るい緑(#86efac) + 完全黒文字(#000000)\n   ・変更ハイライト: 鮮明緑(#4ade80) + 黒文字\n   ・削除行: 明るい赤(#fca5a5) + 完全黒文字(#000000)\n\n2. CSS Grid オーバーレイ設計 (重なり物理解消):\n   ・.diff-line-editor-wrap: display: grid (1fr / 1fr)\n   ・highlight と textarea を同一グリッドセルに重ねる\n   ・highlight が自然なブロック要素として高さを拡張\n   ・textarea はその広がった高さに 100% 完全追従",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "box_architecture",
      "type": "rectangle",
      "x": 40,
      "y": 390,
      "width": 840,
      "height": 260,
      "strokeColor": "#1971c2",
      "backgroundColor": "#e7f5ff",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "roughness": 0,
      "roundness": { "type": 3 }
    },
    {
      "id": "title_arch",
      "type": "text",
      "x": 60,
      "y": 405,
      "width": 800,
      "height": 24,
      "text": "【CSS Grid 同一セル重ね合わせ（Overlay）構造図】",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "box_wrap",
      "type": "rectangle",
      "x": 80,
      "y": 445,
      "width": 760,
      "height": 180,
      "strokeColor": "#1c7ed6",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0
    },
    {
      "id": "label_wrap",
      "type": "text",
      "x": 95,
      "y": 455,
      "width": 730,
      "height": 20,
      "text": ".diff-line-editor-wrap (display: grid; grid-template: 1fr / 1fr; width: 100%; height: auto)",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "box_layer_highlight",
      "type": "rectangle",
      "x": 100,
      "y": 485,
      "width": 350,
      "height": 120,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#d3f9d8",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0
    },
    {
      "id": "text_layer_highlight",
      "type": "text",
      "x": 115,
      "y": 495,
      "width": 320,
      "height": 100,
      "text": "背面: .diff-line-highlight (grid-area: 1/1/2/2)\n・通常フロー要素（position: static）\n・長いテキストの折り返し時に高さを自然拡張！\n・空行や末尾改行も \\u200B で高さを確実維持\n・mark.changed のみ鮮明緑/赤の背景を描画",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "box_layer_editor",
      "type": "rectangle",
      "x": 480,
      "y": 485,
      "width": 340,
      "height": 120,
      "strokeColor": "#f08c00",
      "backgroundColor": "#fff4e6",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0
    },
    {
      "id": "text_layer_editor",
      "type": "text",
      "x": 495,
      "y": 495,
      "width": 310,
      "height": 100,
      "text": "前面: <textarea>.diff-line-editor (grid-area: 1/1/2/2)\n・z-index: 1 / background: transparent\n・height: 100% でハイライトの高さにピタリ追従\n・テキスト色: #000000（純黒文字）\n・キャレット: #000000（黒カーソル）で編集可能",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    }
  ]
}
