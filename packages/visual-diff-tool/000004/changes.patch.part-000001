@@ -42,6 +42,36 @@
   gap: 4px;
 }
 
+.three-diff-git-badge {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  background: #0f172a;
+  border: 1px solid #334155;
+  border-radius: 6px;
+  padding: 4px 10px;
+  font-size: 12px;
+}
+
+.three-diff-git-tag {
+  background: #2563eb;
+  color: #ffffff;
+  font-size: 10px;
+  font-weight: 700;
+  padding: 2px 6px;
+  border-radius: 4px;
+  letter-spacing: 0.5px;
+}
+
+.three-diff-git-path {
+  color: #e2e8f0;
+  font-family: monospace;
+  max-width: 340px;
+  overflow: hidden;
