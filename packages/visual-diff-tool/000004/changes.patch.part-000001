@@ -188,6 +218,14 @@
   overflow: hidden;
 }
 
+.three-canvas-host {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  overflow: hidden;
+}
+
 .three-diff-viewport canvas {
   width: 100% !important;
   height: 100% !important;
