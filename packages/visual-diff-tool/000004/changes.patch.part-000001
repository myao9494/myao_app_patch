@@ -0,0 +1,129 @@
+"""
+3D CAD (STEP) ファイルの Git 差分連携機能の単体テスト仕様。
+- _is_git_3d_path および _git_file_kind による .step / .stp 拡張子の自動判定
+- Git 管理下での STEP ファイル変更検出 (kind: '3d', diffable: True)
+- POST /api/git/3d/jobs エンドポイントによる HEAD と作業ツリーからの3D差分ジョブ作成
+"""
+
+import os
+import shutil
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+from starlette.testclient import TestClient
+
+from backend.app.main import app, _git_file_kind, _is_git_3d_path
+
+
+class TestGit3dDiff(unittest.TestCase):
+    def setUp(self):
+        self.client = TestClient(app)
+        self.temp_dir = tempfile.mkdtemp()
+        self.repo_dir = Path(self.temp_dir) / "test_repo"
+        self.repo_dir.mkdir()
+
+        # Git 初期化
+        subprocess.run(["git", "init"], cwd=self.repo_dir, check=True, capture_output=True)
+        subprocess.run(["git", "config", "user.email", "test@example.com"], cwd=self.repo_dir, check=True, capture_output=True)
+        subprocess.run(["git", "config", "user.name", "Test User"], cwd=self.repo_dir, check=True, capture_output=True)
+
+        # サンプルの STEP データを準備
+        samples_dir = Path(__file__).resolve().parents[1] / "backend" / "app" / "samples_3d"
+        sample_old = samples_dir / "sample_a_bracket.step"
+        sample_new = samples_dir / "sample_b_hole_moved.step"
+
+        if sample_old.exists() and sample_new.exists():
+            self.step_content_old = sample_old.read_bytes()
+            self.step_content_new = sample_new.read_bytes()
+        else:
+            self.step_content_old = b"ISO-10303-21;\nHEADER;\nFILE_SCHEMA(('AUTOMOTIVE_DESIGN'));\nENDSEC;\nDATA;\nENDSEC;\nEND-ISO-10303-21;\n"
+            self.step_content_new = b"ISO-10303-21;\nHEADER;\nFILE_SCHEMA(('AUTOMOTIVE_DESIGN'));\nENDSEC;\nDATA;\n#1=DUMMY;\nENDSEC;\nEND-ISO-10303-21;\n"
+
+    def tearDown(self):
+        shutil.rmtree(self.temp_dir, ignore_errors=True)
+
+    def test_git_3d_path_detection(self):
+        """_is_git_3d_path および _git_file_kind が .step / .stp を '3d' として認識する"""
+        self.assertTrue(_is_git_3d_path("model.step"))
+        self.assertTrue(_is_git_3d_path("model.STEP"))
+        self.assertTrue(_is_git_3d_path("parts/sub/bracket.stp"))
+        self.assertTrue(_is_git_3d_path("parts/sub/bracket.STP"))
+        self.assertFalse(_is_git_3d_path("drawing.png"))
+        self.assertFalse(_is_git_3d_path("note.md"))
+
+        text_exts = {".md", ".txt"}
+        self.assertEqual(_git_file_kind("model.step", text_exts), "3d")
+        self.assertEqual(_git_file_kind("model.stp", text_exts), "3d")
+        self.assertEqual(_git_file_kind("image.png", text_exts), "image")
+        self.assertEqual(_git_file_kind("note.md", text_exts), "text")
+        self.assertIsNone(_git_file_kind("archive.zip", text_exts))
+
+    def test_changed_files_detects_3d_step(self):
+        """Git リポジトリ内の STEP ファイルの変更が kind: '3d' として検出される"""
+        step_file = self.repo_dir / "bracket.step"
+        step_file.write_bytes(self.step_content_old)
+        subprocess.run(["git", "add", "bracket.step"], cwd=self.repo_dir, check=True, capture_output=True)
+        subprocess.run(["git", "commit", "-m", "add bracket.step"], cwd=self.repo_dir, check=True, capture_output=True)
+
+        # 作業ツリーで変更
+        step_file.write_bytes(self.step_content_new)
+
+        resp = self.client.post("/api/git/files", json={"folder": str(self.repo_dir)})
+        self.assertEqual(resp.status_code, 200)
+        data = resp.json()
+        files = data.get("files", [])
+
+        step_entries = [f for f in files if f["path"] == "bracket.step"]
+        self.assertEqual(len(step_entries), 1)
+        entry = step_entries[0]
+        self.assertEqual(entry["kind"], "3d")
+        self.assertEqual(entry["change_type"], "modified")
+        self.assertTrue(entry["has_head"])
+        self.assertTrue(entry["has_current"])
+        self.assertTrue(entry["diffable"])
+
+    def test_create_git_3d_job_success(self):
+        """POST /api/git/3d/jobs により HEAD と作業ツリーから 3D 差分ジョブが作成できる"""
+        step_file = self.repo_dir / "bracket.step"
+        step_file.write_bytes(self.step_content_old)
+        subprocess.run(["git", "add", "bracket.step"], cwd=self.repo_dir, check=True, capture_output=True)
+        subprocess.run(["git", "commit", "-m", "add bracket.step"], cwd=self.repo_dir, check=True, capture_output=True)
+
+        # 作業ツリーで変更
+        step_file.write_bytes(self.step_content_new)
+
+        resp = self.client.post(
+            "/api/git/3d/jobs",
+            json={
+                "folder": str(self.repo_dir),
+                "path": "bracket.step",
+                "head_path": "bracket.step",
+                "quality": "coarse",
+                "align_mode": "auto",
+            },
+        )
+        self.assertEqual(resp.status_code, 202)
+        data = resp.json()
+        self.assertIn("job_id", data)
+        self.assertEqual(data.get("status"), "pending")
+
+    def test_create_git_3d_job_rejects_non_step(self):
+        """非 STEP ファイルのパスが指定された場合は 400 エラーを返す"""
+        text_file = self.repo_dir / "note.txt"
+        text_file.write_text("hello")
+        subprocess.run(["git", "add", "note.txt"], cwd=self.repo_dir, check=True, capture_output=True)
+        subprocess.run(["git", "commit", "-m", "add note.txt"], cwd=self.repo_dir, check=True, capture_output=True)
+
+        resp = self.client.post(
+            "/api/git/3d/jobs",
+            json={
+                "folder": str(self.repo_dir),
+                "path": "note.txt",
+            },
+        )
+        self.assertEqual(resp.status_code, 400)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_git_3d_single.py b/tests/test_git_3d_single.py
new file mode 100644
index 0000000000000000000000000000000000000000..84cfda5a9b52311bcd80c962866c9e9eef29e5df
--- /dev/null
+++ b/tests/test_git_3d_single.py
@@ -0,0 +1,110 @@
+"""
+Git管理下における単体3D CADファイル（新規追加・削除）の3D表示プレビューテスト
+- HEADが存在しない新規追加ファイル（untracked / added）の単体3Dジョブ作成とメッシュ取得
+- 作業ツリーが存在しない削除済みファイル（deleted）の単体3Dジョブ作成とメッシュ取得
+"""
+
+import subprocess
+import tempfile
+import time
+import unittest
+from pathlib import Path
+from fastapi.testclient import TestClient
+
+from backend.app.main import app, mesh_job_manager
+
+
+class TestGit3dSingleFile(unittest.TestCase):
+    def setUp(self):
+        self.client = TestClient(app)
+        self.temp_dir = tempfile.TemporaryDirectory()
+        self.repo_dir = Path(self.temp_dir.name)
+        # Gitリポジトリ初期化
+        subprocess.run(["git", "init"], cwd=self.repo_dir, check=True, capture_output=True)
+        subprocess.run(["git", "config", "user.email", "test@example.com"], cwd=self.repo_dir, check=True, capture_output=True)
+        subprocess.run(["git", "config", "user.name", "Test User"], cwd=self.repo_dir, check=True, capture_output=True)
+
+        # サンプルSTEPファイル
+        sample_path = Path(__file__).resolve().parents[1] / "samples" / "step" / "dimension_a.step"
+        self.step_bytes = sample_path.read_bytes()
+
+    def tearDown(self):
+        self.temp_dir.cleanup()
+
+    def _wait_job(self, job_id: str, timeout_sec: float = 15.0) -> dict:
+        start = time.time()
+        while time.time() - start < timeout_sec:
+            res = self.client.get(f"/api/3d/jobs/{job_id}")
+            self.assertEqual(res.status_code, 200)
+            data = res.json()
+            if data["status"] in ("done", "error"):
+                return data
+            time.sleep(0.3)
+        self.fail(f"Job {job_id} did not finish within {timeout_sec} seconds")
+
+    def test_git_3d_job_new_file(self):
+        """HEADに存在せず作業ツリーのみに存在する新規STEPファイルが単体3D表示ジョブとして完了すること"""
+        new_step_path = self.repo_dir / "new_model.step"
+        new_step_path.write_bytes(self.step_bytes)
+
+        # ジョブ作成 (HEADなし、作業ツリーあり)
+        res = self.client.post(
+            "/api/git/3d/jobs",
+            json={
+                "folder": str(self.repo_dir),
+                "path": "new_model.step",
+                "head_path": "new_model.step",
+                "has_head": False,
+                "has_current": True,
+                "quality": "coarse",
+            },
+        )
+        self.assertEqual(res.status_code, 202)
+        job_id = res.json()["job_id"]
+
+        status_data = self._wait_job(job_id)
+        self.assertEqual(status_data["status"], "done")
+        self.assertEqual(status_data.get("single_mode"), "new")
+        self.assertIsNotNone(status_data["stats"].get("new"))
+
+        # /mesh/new からVDM1バイナリを取得できること
+        mesh_res = self.client.get(f"/api/3d/jobs/{job_id}/mesh/new")
+        self.assertEqual(mesh_res.status_code, 200)
+        self.assertTrue(mesh_res.content.startswith(b"VDM1"))
+
+    def test_git_3d_job_deleted_file(self):
+        """作業ツリーで削除されHEADにのみ存在するSTEPファイルが旧版単体3D表示ジョブとして完了すること"""
+        del_step_path = self.repo_dir / "deleted_model.step"
+        del_step_path.write_bytes(self.step_bytes)
+        subprocess.run(["git", "add", "deleted_model.step"], cwd=self.repo_dir, check=True, capture_output=True)
+        subprocess.run(["git", "commit", "-m", "add deleted_model.step"], cwd=self.repo_dir, check=True, capture_output=True)
+        # 作業ツリーから削除
+        del_step_path.unlink()
+
+        res = self.client.post(
+            "/api/git/3d/jobs",
+            json={
+                "folder": str(self.repo_dir),
+                "path": "deleted_model.step",
+                "head_path": "deleted_model.step",
+                "has_head": True,
+                "has_current": False,
+                "quality": "coarse",
+            },
+        )
+        self.assertEqual(res.status_code, 202)
+        job_id = res.json()["job_id"]
+
+        status_data = self._wait_job(job_id)
+        self.assertEqual(status_data["status"], "done")
+        self.assertEqual(status_data.get("single_mode"), "old")
+        self.assertIsNotNone(status_data["stats"].get("old"))
+
+        # /mesh/old からVDM1バイナリを取得できること
+        mesh_res = self.client.get(f"/api/3d/jobs/{job_id}/mesh/old")
+        self.assertEqual(mesh_res.status_code, 200)
+        self.assertTrue(mesh_res.content.startswith(b"VDM1"))
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_markdown_cad_links.py b/tests/test_markdown_cad_links.py
new file mode 100644
index 0000000000000000000000000000000000000000..8abfed25230ba6f55acc5fc6e9c27ce0baa39b2b
--- /dev/null
+++ b/tests/test_markdown_cad_links.py
@@ -0,0 +1,70 @@
+"""
+Markdownファイル内のCADコードブロック（```step / ```cad 等）およびSTEPリンク解決のテスト
+"""
+
+import tempfile
+import unittest
+from pathlib import Path
+
+from backend.app.main import (
+    _extract_markdown_links,
+    _related_markdown_paths,
+    _resolve_obsidian_link,
+)
+
+
+class TestMarkdownCadLinks(unittest.TestCase):
+    def test_extract_step_code_block_links(self):
+        """```step や ```cad コードブロック内の path: / file: から STEP ファイルを抽出できること"""
+        md_text = """
+---
+created: 2026-10-06
+---
+```step
+path: 01_data/2026/10/06/CBES (50kg to 2000kg).step
+width: 908
+height: 629
+view: custom
+```
+
+```cad
+path: models/bracket_v2.stp
+width: 800
+```
+
+```3d
+file: parts/housing.step
+```
+
+![[drawings/gear.step]]
+[Link](components/shaft.step)
+"""
+        links = _extract_markdown_links(md_text)
+        self.assertIn("01_data/2026/10/06/CBES (50kg to 2000kg).step", links)
+        self.assertIn("models/bracket_v2.stp", links)
+        self.assertIn("parts/housing.step", links)
+        self.assertIn("drawings/gear.step", links)
+        self.assertIn("components/shaft.step", links)
+
+    def test_resolve_step_link_in_repo(self):
+        """リポジトリ内のSTEPファイルへのパスが正しく解決されること"""
+        with tempfile.TemporaryDirectory() as tmpdir:
+            repo = Path(tmpdir)
+            md_dir = repo / "01_data" / "2026" / "10" / "06"
+            md_dir.mkdir(parents=True)
+            step_file = md_dir / "test_model.step"
+            step_file.write_bytes(b"ISO-10303-21;")
+
+            md_file = md_dir / "note.md"
+            md_file.write_text(
+                "```step\npath: 01_data/2026/10/06/test_model.step\n```\n",
+                encoding="utf-8",
+            )
+
+            source_rel = "01_data/2026/10/06/note.md"
+            resolved = _related_markdown_paths(repo, source_rel)
+            self.assertIn("01_data/2026/10/06/test_model.step", resolved)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_mesh_parallel.py b/tests/test_mesh_parallel.py
new file mode 100644
index 0000000000000000000000000000000000000000..1060a56dce90cb2ea41fc1ff7ba3a43ae4abc873
--- /dev/null
+++ b/tests/test_mesh_parallel.py
@@ -0,0 +1,96 @@
+"""
+3Dメッシュ差分・STEP変換の並列計算・高速化テスト仕様
+
+1. parallel_closest_point による頂点距離計算のマルチスレッド/並列チャンク計算
+   - 単一スレッド計算と完全に同一の距離・最近傍点結果を返すこと
+   - クエリ頂点群のチャンク分割・結合が正しく機能すること
+2. compute_mesh_diff における新旧メッシュの並行処理
+   - 新旧メッシュの細分化（refine_mesh）および距離計算が並行実行され、正確な差分結果を生成すること
+   - 進捗報告（progress）が正常に通知されること
+3. load_step_pair_as_meshes における新旧STEPの並行読み込み・テッセレーション
+   - 新旧のSTEP解析・メッシュ化が並行実行され、同一のメッシュペアが返ること
+"""
+
+import importlib.util
+import unittest
+from pathlib import Path
+import numpy as np
+
+HAS_MESH_DEPS = all(importlib.util.find_spec(name) is not None for name in ("trimesh", "scipy", "rtree"))
+HAS_OCP = importlib.util.find_spec("OCP") is not None and HAS_MESH_DEPS
+
+
+@unittest.skipUnless(HAS_MESH_DEPS, "3Dメッシュ依存ライブラリ（trimesh, scipy, rtree）が未導入")
+class TestMeshParallel(unittest.TestCase):
+    def test_parallel_closest_point_matches_single_thread(self):
+        """並列closest_pointの計算結果が単一スレッド版と完全一致すること"""
+        import trimesh
+        from backend.app.mesh_diff import parallel_closest_point
+
+        mesh = trimesh.creation.icosphere(subdivisions=3, radius=10.0)
+        rng = np.random.default_rng(42)
+        query_points = rng.uniform(-15, 15, size=(4000, 3))
+
+        # 単一スレッド版
+        closest_single, dist_single, _ = trimesh.proximity.closest_point(mesh, query_points)
+
+        # 並列版（4ワーカー）
+        closest_parallel, dist_parallel, _ = parallel_closest_point(mesh, query_points, max_workers=4)
+
+        np.testing.assert_allclose(dist_parallel, dist_single, atol=1e-5)
+        np.testing.assert_allclose(closest_parallel, closest_single, atol=1e-5)
+
+    def test_compute_mesh_diff_with_parallelism(self):
+        """並列化されたcompute_mesh_diffが正確な差分を算出し進捗が報告されること"""
+        import trimesh
+        from backend.app.mesh_diff import compute_mesh_diff
+
+        old_mesh = trimesh.creation.box(
+            extents=[80, 40, 20],
+            transform=trimesh.transformations.translation_matrix([40, 20, 10]),
+        )
+        new_mesh = trimesh.creation.box(
+            extents=[90, 40, 20],
+            transform=trimesh.transformations.translation_matrix([45, 20, 10]),
+        )
+
+        progress_reports = []
+        result = compute_mesh_diff(
+            old_mesh.vertices,
+            old_mesh.faces,
+            new_mesh.vertices,
+            new_mesh.faces,
+            tolerance=0.05,
+            progress=lambda stage, val: progress_reports.append(val),
+        )
+
+        self.assertGreater(len(progress_reports), 0)
+        self.assertAlmostEqual(progress_reports[-1], 1.0)
+        # 延長された部分（X >= 80）の距離が約10mmであること
+        new_x = result.new.vertices[:, 0]
+        self.assertAlmostEqual(result.new.distances.max(), 10.0, delta=0.2)
+        self.assertLess(result.new.distances[new_x < 39].max(), 1e-4)
+
+    @unittest.skipUnless(HAS_OCP, "OCPが未導入")
+    def test_load_step_pair_as_meshes_parallel(self):
+        """新旧STEPの読み込み・メッシュ化が並行実行され、正しいメッシュペアが返ること"""
+        from backend.app.step_mesh import load_step_pair_as_meshes
+
+        root = Path(__file__).resolve().parents[1]
+        step_dir = root / "samples" / "step"
+        old_path = step_dir / "dimension_a.step"
+        new_path = step_dir / "dimension_b.step"
+
+        progress_calls = []
+        pair = load_step_pair_as_meshes(
+            old_path,
+            new_path,
+            quality="coarse",
+            progress=lambda stage, frac: progress_calls.append(frac),
+        )
+
+        self.assertEqual(pair.old.filename, "dimension_a.step")
+        self.assertEqual(pair.new.filename, "dimension_b.step")
+        self.assertGreater(len(pair.old.vertices), 0)
+        self.assertGreater(len(pair.new.vertices), 0)
+        self.assertGreater(pair.linear_deflection, 0)
