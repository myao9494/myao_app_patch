+
+    # 汎用YAML/プロパティ内の STEP ファイル指定（path: xxx.step, file: xxx.stp 等）を抽出
+    for step_prop_match in STEP_PROPERTY_RE.finditer(text):
+        val = step_prop_match.group(1).strip().strip("\"'").split("#", 1)[0].strip()
+        if val and val not in targets:
+            targets.append(val)
+
     return targets
 
 
