+\u5207\u6362\u6587\u4EF6\u5939\u548C\u6807\u7B7E\u7684\u663E\u793A/\u9690\u85CF\u4EE5\u5728\u5217\u8868\u4E2D\u663E\u793A\u3002`,SHOW_HIDE_ATTACHMENTS:"\u663E\u793A/\u9690\u85CF\u9644\u4EF6",SHOW_HIDE_VIRTUAL:"\u663E\u793A/\u9690\u85CF\u865A\u62DF\u8282\u70B9",SHOW_HIDE_INFERRED:"\u663E\u793A/\u9690\u85CF\u63A8\u65AD\u8282\u70B9",SHOW_HIDE_ALIAS:"\u663E\u793A/\u9690\u85CF\u6587\u6863\u522B\u540D",SHOW_HIDE_SIBLINGS:"\u663E\u793A/\u9690\u85CF\u5144\u5F1F\u8282\u70B9",SHOW_HIDE_EMBEDDEDCENTRAL:"\u5C06\u4E2D\u5FC3\u8282\u70B9\u663E\u793A\u4E3A\u5D4C\u5165\u5F0F\u6846\u67B6",SHOW_HIDE_FOLDER:"\u663E\u793A/\u9690\u85CF\u6587\u4EF6\u5939\u8282\u70B9",SHOW_HIDE_TAG:"\u663E\u793A/\u9690\u85CF\u6807\u7B7E\u8282\u70B9",SHOW_HIDE_PAGES:"\u663E\u793A/\u9690\u85CF\u9875\u9762\u8282\u70B9\uFF08\u5305\u62EC\u5DF2\u5B9A\u4E49\u3001\u63A8\u65AD\u3001\u865A\u62DF\u548C\u9644\u4EF6\u8282\u70B9\uFF09",PIN_LEAF:"\u94FE\u63A5 ExcaliBrain \u5230\u6700\u8FD1\u7684\u6D3B\u52A8\u53F6\u5B50"};var ni={};var si={};var ai={};var ri={};var oi={JSON_MALFORMED:"Hib\xE1s JSON",JSON_MISSING_KEYS:'A JSON-nak rendelkeznie kell az al\xE1bbi 4 kulccsal: "parents", "children", "friends", "nextFriends"',JSON_VALUES_NOT_STRING_ARRAYS:'A kulcsok \xE9rt\xE9keinek nem \xFCres string t\xF6mbnek kell lenni\xFCk. P\xE9lda: "parents": ["Sz\xFCl\u0151", "Sz\xFCl\u0151k", "feljebb"]',EXCALIBRAIN_FILE_NAME:"Excalibrain rajz f\xE1jl el\xE9r\xE9si \xFAtvonala",EXCALIBRAIN_FILE_DESC:"\u26A0 Ez a f\xE1jl fel\xFCl lesz \xEDrva a b\u0151v\xEDtm\xE9ny \xE1ltal. Ha le\xE1ll\xEDtod a szkriptet \xE9s v\xE1ltoztatsz a gr\xE1fban, akkor \xE1t kell nevezned a f\xE1jlt, hogy a m\xF3dos\xEDt\xE1said megmaradjanak. Mert amikor \xFAjra elind\xEDtod az ExcaliBrain-t, a m\xF3dos\xEDt\xE1saidat fel\xFCl\xEDrja az automatikusan gener\xE1lt ExcaliBrain gr\xE1f.",INDEX_REFRESH_FREQ_NAME:"Index friss\xEDt\xE9si gyakoris\xE1ga",INDEX_REFRESH_FREQ_DESC:"Az ExcaliBrain friss\xEDti az index\xE9t, amikor v\xE1ltasz munkat\xE9rre, abban az esetben, ha az el\u0151z\u0151 index friss\xEDt\xE9se \xF3ta megv\xE1ltozott egy f\xE1jl a Vault-odban. <br>Ez a be\xE1ll\xEDt\xE1s csak akkor \xE9rv\xE9nyes, ha egy markdown szerkeszt\u0151ben \xEDrsz (nem v\xE1ltasz f\xE1jlokat vagy t\xE9rk\xE9peket), \xE9s m\xE9gis azt szeretn\xE9d, hogy az ExcaliBrain friss\xEDtse a gr\xE1fodat ahogy g\xE9pelsz. Mivel a gyakori h\xE1tt\xE9rindex friss\xEDt\xE9sek er\u0151forr\xE1sig\xE9nyesek lehetnek, van lehet\u0151s\xE9ged n\xF6velni az index-friss\xEDt\xE9s id\u0151k\xF6z\xE9t, amely cs\xF6kkenti a rendszer terhel\xE9s\xE9t.",HIERARCHY_HEAD:"Ontol\xF3gia",HIERARCHY_DESC:"Add meg a Dataview mez\u0151neveket vessz\u0151vel elv\xE1lasztva (,) \xFAgy, hogy ezeket fogod haszn\xE1lni a link ir\xE1nyok meghat\xE1roz\xE1s\xE1hoz a gr\xE1fodban.<br>Az ontol\xF3gi\xE1t a markdown szerkeszt\u0151ben a mez\u0151 el\xE9 \xEDrva is b\u0151v\xEDtheted (p\xE9ld\xE1ul: 'Tartalmazza::') majd valamelyik parancspaletta parancs seg\xEDts\xE9g\xE9vel hozz\xE1adhatod a dataview mez\u0151t az ontol\xF3gi\xE1hoz, mint SZ\xDCL\u0150, GYERMEK, BAR\xC1T, vagy JOBBSZ\xC9L BAR\xC1T",INFER_NAME:"Az \xF6sszes implicit kapcsolat bar\xE1tk\xE9nt val\xF3 megjelen\xEDt\xE9se",INFER_DESC:"<b>Be:</b> Az \xF6sszes implcita linket a dokumentumban bar\xE1tk\xE9nt \xE9rtelmezi.<br><b>Ki:</b> Az al\xE1bbi logik\xE1t alkalmazza:<ul><li>Egy el\u0151re mutat\xF3 linket gyermekk\xE9nt \xE9rtelmez</li><li>Egy visszamutat\xF3 linket sz\xFCl\u0151k\xE9nt \xE9rtelmez</li><li>Ha k\xE9t f\xE1jl k\xF6lcs\xF6n\xF6sen hivatkozik egym\xE1sra, azok bar\xE1tok</li></ul>",REVERSE_NAME:"Ford\xEDtott k\xF6vetkeztet\u0151 logika",REVERSE_DESC:"<b>Be:</b> A visszamutat\xF3 linkeket gyerekk\xE9nt, az el\u0151re mutat\xF3kat sz\xFCl\u0151kk\xE9nt kezeli.<br><b>Ki:</b> A visszamutat\xF3 linkeket sz\xFCl\u0151kk\xE9nt, az el\u0151re mutat\xF3kat gyerekk\xE9nt kezeli</b>",PARENTS_NAME:"Sz\xFCl\u0151k",CHILDREN_NAME:"Gyermekek",LEFT_FRIENDS_NAME:"Baloldali bar\xE1tok",RIGHT_FRIENDS_NAME:"Jobboldali bar\xE1tok",PREVIOUS_NAME:"El\u0151z\u0151 (bar\xE1tok)",NEXT_NAME:"K\xF6vetkez\u0151 (bar\xE1tok)",EXCLUSIONS_NAME:"Kiz\xE1rt",EXCLUSIONS_DESC:"Dataview vagy YAML mez\u0151k, amelyek sosem ker\xFClnek felhaszn\xE1l\xE1sra az ontol\xF3gi\xE1ban",UNASSIGNED_NAME:"Nem hozz\xE1rendelt",UNASSIGNED_DESC:"A Vault-odban tal\xE1lhat\xF3 mez\u0151k, amelyek sem az ontol\xF3gia r\xE9szei, sem kiz\xE1rt mez\u0151k.",ONTOLOGY_SUGGESTER_NAME:"Ontol\xF3gia javasol\xF3",ONTOLOGY_SUGGESTER_DESC:"Aktiv\xE1lja az ontol\xF3gia javasol\xF3t a markdown szerkeszt\u0151ben. Ha enged\xE9lyezve van, akkor a paragrafus elej\xE9n \xEDrt trigger szekvenci\xE1val aktiv\xE1lhatod a javasol\xF3t, ami felsorolja az el\u0151z\u0151leg meghat\xE1rozott ontol\xF3giai mez\u0151ket.",ONTOLOGY_SUGGESTER_ALL_NAME:"Karakter szekvencia a generikus javasol\xF3 aktiv\xE1l\xE1s\xE1hoz. A generikus javasol\xF3 az \xF6sszes ontol\xF3giai mez\u0151t tartalmazza f\xFCggetlen\xFCl az ir\xE1nyukt\xF3l.",ONTOLOGY_SUGGESTER_PARENT_NAME:"Karakter szekvencia a sz\xFCl\u0151 javasol\xF3 aktiv\xE1l\xE1s\xE1hoz",ONTOLOGY_SUGGESTER_CHILD_NAME:"Karakter szekvencia a gyermek javasol\xF3 aktiv\xE1l\xE1s\xE1hoz",ONTOLOGY_SUGGESTER_LEFT_FRIEND_NAME:"Karakter szekvencia a baloldali bar\xE1t javasol\xF3 aktiv\xE1l\xE1s\xE1hoz",ONTOLOGY_SUGGESTER_RIGHT_FRIEND_NAME:"Karakter szekvencia a jobboldali bar\xE1t javasol\xF3 aktiv\xE1l\xE1s\xE1hoz",ONTOLOGY_SUGGESTER_PREVIOUS_NAME:"Karakter szekvencia az el\u0151z\u0151 (bar\xE1t) javasol\xF3 aktiv\xE1l\xE1s\xE1hoz",ONTOLOGY_SUGGESTER_NEXT_NAME:"Karakter szekvencia a k\xF6vetkez\u0151 (bar\xE1t) javasol\xF3 aktiv\xE1l\xE1s\xE1hoz",MID_SENTENCE_SUGGESTER_TRIGGER_NAME:"K\xF6ztes adatmez\u0151 javasol\xF3 kiv\xE1lt\xF3",MID_SENTENCE_SUGGESTER_TRIGGER_DESC:"Lehet\u0151s\xE9g van mez\u0151ket k\xF6ztes helyen a mondatokban hozz\xE1adni a k\xF6vetkez\u0151 k\xE9t form\xE1tum valamelyik\xE9t haszn\xE1lva:<br><code>We met at [location:: [[XYZ restaurant]]] with [candidate:: [[John Doe]]]</code><br><code>We met at (location:: [[XYZ restaurant]]) with (candidate:: [[John Doe]])</code><br>Ha ezt a kiv\xE1lt\xF3t p\xE9ld\xE1ul <code>(</code>-ra \xE1ll\xEDtod, akkor b\xE1rhol a mondatban be\xEDrva <code>(:::</code> aktiv\xE1lja a javasol\xF3t (felt\xE9ve, hogy a generikus javasol\xF3 kiv\xE1lt\xF3ja az alap\xE9rtelmezett <code>:::</code> - l\xE1sd fent).<br>Tov\xE1bbi inform\xE1ci\xF3 az inline mez\u0151kr\u0151l: [DataView Help](https://blacksmithgu.github.io/obsidian-dataview/data-annotation/)",BOLD_FIELDS_NAME:"Kijel\xF6lt mez\u0151k f\xE9lk\xF6v\xE9ren",BOLD_FIELDS_DESC:"A kijel\xF6lt mez\u0151t f\xE9lk\xF6v\xE9r t\xEDpus\xFA sz\xF6veggel adja hozz\xE1, azaz (**mez\u0151 neve**:: ) eredm\xE9nyezve (<b>mez\u0151 neve</b>:: )",DISPLAY_HEAD:"Megjelen\xEDt\xE9s",COMPACT_VIEW_NAME:"S\u0171r\u0171 n\xE9zet",COMPACT_VIEW_DESC:"A gr\xE1f megjelen\xEDt\xE9se s\u0171r\u0171 n\xE9zetben",EXCLUDE_PATHLIST_NAME:"Kiz\xE1rand\xF3 f\xE1jl el\xE9r\xE9si \xFAtvonalak",EXCLUDE_PATHLIST_DESC:"Adja meg a kiz\xE1rand\xF3 f\xE1jlok el\xE9r\xE9si \xFAtvonalait vessz\u0151vel elv\xE1lasztva.",RENDERALIAS_NAME:"Megjelen\xEDt\xE9si azonos\xEDt\xF3 ha el\xE9rhet\u0151",RENDERALIAS_DESC:"Megjelen\xEDti az oldal azonos\xEDt\xF3j\xE1t a f\xE1jln\xE9v helyett, ha az az oldal el\u0151lapj\xE1n van meghat\xE1rozva.",NODETITLE_SCRIPT_NAME:"Dataview-kifejez\xE9s a csom\xF3pontnevekhez",NODETITLE_SCRIPT_DESC:"Dataview-kifejez\xE9s a csom\xF3pont c\xEDm\xE9nek megjelen\xEDt\xE9s\xE9hez. Ha nincs r\xE1 sz\xFCks\xE9ged, hagyd \xFCresen.<br>A kifejez\xE9s a Dataview-oldalt <code>dvPage</code>, az ExcaliBrain alap\xE9rtelmezett c\xEDmk\xE9j\xE9t pedig <code>defaultName</code> n\xE9ven kapja meg.<br>P\xE9ld\xE1k:<br><code>default(dvPage.title, defaultName)</code><br><code>lower(defaultName)</code><br><code>dvPage.file.path</code>",SHOWINFERRED_NAME:"Az el\u0151\xE1ll\xEDtott kapcsolatok megjelen\xEDt\xE9se",SHOWINFERRED_DESC:"<b>Be:</b> Mind az expliciten meghat\xE1rozott, mind az el\u0151\xE1ll\xEDtott kapcsolatokat megjelen\xEDti. Az el\u0151re mutat\xF3 linkek gyerekek, a visszamutat\xF3k sz\xFCl\u0151k, ha k\xE9t oldal egym\xE1sra hivatkozik, akkor bar\xE1tokk\xE9nt lesznek kezelve. Az expliciten meghat\xE1rozott kapcsolatok mindig el\u0151nyt \xE9lveznek.<br><b>Ki:</b> Csak az expliciten meghat\xE1rozott kapcsolatokat jelen\xEDti meg.",SHOWVIRTUAL_NAME:"Virtu\xE1lis gyerek node-ok megjelen\xEDt\xE9se",SHOWVIRTUAL_DESC:"<b>Be:</b> Megjelen\xEDti a feloldatlan linkeket.<br><b>Ki:</b> Nem jelen\xEDti meg a feloldatlan linkeket.",SHOWATTACHMENTS_NAME:"Mell\xE9kletek beilleszt\xE9se",SHOWATTACHMENTS_DESC:"<b>Be:</b> Minden t\xEDpus\xFA f\xE1jlt megjelen\xEDt a gr\xE1fban. <br><b>Ki:</b> Csak a markdown f\xE1jlokat jelen\xEDti meg.",STYLE_HEAD:"St\xEDlusok",STYLE_DESC:"A st\xEDlusokat sorrendben alkalmazzuk.<br><ol><li><b>Alap</b> node st\xEDlus</li><li><b>El\u0151\xE1ll\xEDtott</b> node st\xEDlus (csak akkor alkalmaz\xF3dik, ha a node el\u0151\xE1ll\xEDtott)</li><li><b>Virtu\xE1lis</b> node st\xEDlus (csak akkor alkalmaz\xF3dik, ha a node virtu\xE1lis)</li> <li><b>K\xF6z\xE9pponti</b> node st\xEDlus (csak akkor alkalmaz\xF3dik, ha a node a k\xF6z\xE9ppontban van)</li><li><b>Testv\xE9rek</b> node st\xEDlus (csak akkor alkalmaz\xF3dik, ha a node testv\xE9r)</li> <li><b>Mell\xE9klet</b> node st\xEDlus (csak akkor alkalmaz\xF3dik, ha a node mell\xE9klet)</li><li><b>Opcion\xE1lis</b> c\xEDmk\xE9n alapul\xF3 st\xEDlus</li></ol>Az alap node st\xEDlus minden attrib\xFAtum\xE1t meg kell adni. A t\xF6bbi st\xEDlusnak r\xE9szleges defin\xEDci\xF3ja lehet. P\xE9ld\xE1ul hozz\xE1adhatsz egy el\u0151tagot \xE9s fel\xFCl\xEDrhatod az alap\xE9rtelmezett node h\xE1tt\xE9rsz\xEDn\xE9t a c\xEDmk\xE9n alapul\xF3 st\xEDlusban, a sz\xF6veg sz\xEDn\xE9t az el\u0151\xE1ll\xEDtott node st\xEDlusban \xE9s a szaggatott vonalas keretet a virtu\xE1lis node st\xEDlusban.",CANVAS_BGCOLOR:"V\xE1szon sz\xEDn",SHOW_FULL_TAG_PATH_NAME:"Teljes c\xEDmke n\xE9v megjelen\xEDt\xE9se",SHOW_FULL_TAG_PATH_DESC:"<b>Be:</b> megjelen\xEDti a teljes c\xEDmk\xE9t, p\xE9ld\xE1ul #reading/books/sci-fi</br><b>Ki:</b> a c\xEDmke aktu\xE1lis r\xE9sz\xE9t jelen\xEDti meg, p\xE9ld\xE1ul a fent eml\xEDtett c\xEDmk\xE9kn\xE9l csak #reading, #books, #sci-fi lenne l\xE1that\xF3 a gr\xE1fban a c\xEDmke hierarchia ment\xE9n navig\xE1lva.",SHOW_COUNT_NAME:"Szomsz\xE9dok sz\xE1m\xE1nak megjelen\xEDt\xE9se",SHOW_COUNT_DESC:"Megmutatja a gyermekek, sz\xFCl\u0151k, bar\xE1tok sz\xE1m\xE1t a node kapuja mellett",ALLOW_AUTOZOOM_NAME:"Automatikus nagy\xEDt\xE1s",ALLOW_AUTOZOOM_DESC:"<b>Be:</b> Enged\xE9lyezi az automatikus nagy\xEDt\xE1st<br><b>Ki:</b> Letiltja az automatikus nagy\xEDt\xE1st",ALLOW_AUTOFOCUS_ON_SEARCH_NAME:"Automatikus f\xF3kusz a keres\xE9sn\xE9l",ALLOW_AUTOFOCUS_ON_SEARCH_DESC:"<b>Be:</b> Enged\xE9lyezi az automatikus f\xF3kuszt a keres\xE9sn\xE9l<br><b>Ki:</b> Letiltja az automatikus f\xF3kuszt",ALWAYS_ON_TOP_NAME:"Alap\xE9rtelmezett 'mindig legfel\xFCl' viselked\xE9s lebegtetett ablak eset\xE9n",ALWAYS_ON_TOP_DESC:"<b>Be:</b> Ha az ExcaliBrain-t lebegtetett ablakban nyitod meg, akkor az \xFAj ablak mindig 'mindig legfel\xFCl' m\xF3dban ny\xEDlik meg.<br><b>Ki:</b> Az \xFAj ablak nem lesz 'mindig legfel\xFCl' m\xF3dban.",EMBEDDED_FRAME_WIDTH_NAME:"Be\xE1gyazott keret sz\xE9less\xE9ge",EMBEDDED_FRAME_HEIGHT_NAME:"Be\xE1gyazott keret magass\xE1ga",TAGLIST_NAME:"Form\xE1zott c\xEDmk\xE9k",TAGLIST_DESC:"K\xFCl\xF6nleges form\xE1z\xE1si szab\xE1lyokat adhatsz meg a node-okhoz c\xEDmk\xE9k alapj\xE1n. Ha az oldalon t\xF6bb c\xEDmke van jelen, az els\u0151 illeszked\u0151 specifik\xE1ci\xF3t haszn\xE1lja. <br>A c\xEDmk\xE9knek a <mark>#</mark>-al kell kezd\u0151dni\xFCk \xE9s nem teljesek is lehetnek. Teh\xE1t p\xE9ld\xE1ul <code>#book</code> illeszkedni fog #books, #book/fiction stb.-re.<br>Add meg a c\xEDmk\xE9ket vessz\u0151vel elv\xE1lasztva, majd v\xE1laszthatsz a leg\xF6rd\xFCl\u0151 list\xE1b\xF3l a form\xE1z\xE1s megv\xE1ltoztat\xE1s\xE1hoz.",MAX_ITEMCOUNT_DESC:"Maxim\xE1lis node sz\xE1m",MAX_ITEMCOUNT_NAME:"Maxim\xE1lis node-ok sz\xE1ma a elrendez\xE9s adott r\xE9sz\xE9n.Azaz a maxim\xE1lis sz\xE1m a sz\xFCl\u0151knek, a gyermekeknek, a bar\xE1toknak \xE9s a testv\xE9reknek a megjelen\xEDt\xE9shez. Ha t\xF6bb elem van, akkor nem jelennek meg a rajzon.",NODESTYLE_INCLUDE_TOGGLE:"Be: Az alap node st\xEDlus fel\xFClb\xEDr\xE1l\xE1sa ehhez az attrib\xFAtumhoz; Ki: Az alap node st\xEDlus alkalmaz\xE1sa ehhez az attrib\xFAtumhoz",NODESTYLE_PREFIX_NAME:"El\u0151tag",NODESTYLE_PREFIX_DESC:"El\u0151tag karakter vagy emojival a node c\xEDmke el\xE9",NODESTYLE_BGCOLOR:"H\xE1tt\xE9rsz\xEDn",NODESTYLE_BG_FILLSTYLE:"H\xE1tt\xE9r kit\xF6lt\xE9si st\xEDlusa",NODESTYLE_TEXTCOLOR:"Sz\xF6vegsz\xEDn",NODESTYLE_BORDERCOLOR:"Keret sz\xEDn",NODESTYLE_FONTSIZE:"Bet\u0171m\xE9ret",NODESTYLE_FONTFAMILY:"Bet\u0171csal\xE1d",NODESTYLE_MAXLABELLENGTH_NAME:"Max c\xEDmke hossza",NODESTYLE_MAXLABELLENGTH_DESC:"A node c\xEDmke maximum megjelen\xEDtett karaktereinek sz\xE1ma. Hosszabb node-ok v\xE9g\xE9n '...' jel lesz l\xE1that\xF3",NODESTYLE_ROUGHNESS:"Vonal \xE9ls\u0151s\xE9g",NODESTYLE_SHARPNESS:"Vonal \xE9less\xE9g",NODESTYLE_STROKEWIDTH:"Vonal vastags\xE1ga",NODESTYLE_STROKESTYLE:"Vonal st\xEDlusa",NODESTYLE_RECTANGLEPADDING:"A node t\xE9glalap\xE1nak kit\xF6lt\xE9se",NODESTYLE_GATE_RADIUS_NAME:"Kapu sugara",NODESTYLE_GATE_RADIUS_DESC:"A 3 kis k\xF6r sugara (alias: kapuk) a node-ok kapcsol\xF3d\xE1si pontjak\xE9nt szolg\xE1l",NODESTYLE_GATE_OFFSET_NAME:"Kapu eltol\xE1sa",NODESTYLE_GATE_OFFSET_DESC:"Az eltol\xE1s a sz\xFCl\u0151k \xE9s gyermekek kapuinak bal \xE9s jobb oldal\xE1n",NODESTYLE_GATE_COLOR:"Kapu keret sz\xEDne",NODESTYLE_GATE_BGCOLOR_NAME:"Kapu h\xE1tt\xE9rsz\xEDne",NODESTYLE_GATE_BGCOLOR_DESC:"A kapu kit\xF6lt\xE9si sz\xEDne, ha vannak gyermekek",NODESTYLE_GATE_FILLSTYLE:"Kapu h\xE1tt\xE9r kit\xF6lt\xE9si st\xEDlusa",NODESTYLE_BASE:"Alap node st\xEDlus",NODESTYLE_CENTRAL:"K\xF6z\xE9pponti node st\xEDlusa",NODESTYLE_INFERRED:"El\u0151\xE1ll\xEDtott node st\xEDlusa",NODESTYLE_VIRTUAL:"Virtu\xE1lis node st\xEDlusa",NODESTYLE_SIBLING:"Testv\xE9r node st\xEDlusa",NODESTYLE_ATTACHMENT:"Mell\xE9klet node st\xEDlusa",NODESTYLE_FOLDER:"Mappa node st\xEDlusa",NODESTYLE_TAG:"C\xEDmke node st\xEDlusa",LINKSTYLE_COLOR:"Sz\xEDn",LINKSTYLE_WIDTH:"Vastags\xE1g",LINKSTYLE_STROKE:"Vonal st\xEDlusa",LINKSTYLE_ROUGHNESS:"Vonal \xE9ls\u0151s\xE9g",LINKSTYLE_ARROWSTART:"Ny\xEDl feje kezdet\xE9n",LINKSTYLE_ARROWEND:"Ny\xEDl feje v\xE9g\xE9n",LINKSTYLE_SHOWLABEL:"C\xEDmke megjelen\xEDt\xE9se a link-en",LINKSTYLE_FONTSIZE:"C\xEDmke bet\u0171m\xE9rete",LINKSTYLE_FONTFAMILY:"C\xEDmke bet\u0171csal\xE1dja",LINKSTYLE_BASE:"Alap link st\xEDlus",LINKSTYLE_INFERRED:"El\u0151\xE1ll\xEDtott link st\xEDlusa",LINKSTYLE_FOLDER:"Mappa link st\xEDlusa",LINKSTYLE_TAG:"C\xEDmke link st\xEDlusa",DATAVIEW_NOT_FOUND:`A Dataview b\u0151v\xEDtm\xE9ny nem tal\xE1lhat\xF3. K\xE9rlek telep\xEDtsd vagy enged\xE9lyezd a Dataview-t, majd pr\xF3b\xE1ld \xFAjra ind\xEDtani a(z) ${O} alkalmaz\xE1st.`,DATAVIEW_UPGRADE:`K\xE9rlek friss\xEDtsd a Dataview-t 0.5.31 vagy \xFAjabb verzi\xF3ra. K\xE9rlek friss\xEDtsd a Dataview-t, majd pr\xF3b\xE1ld \xFAjra ind\xEDtani a(z) ${O} alkalmaz\xE1st.`,EXCALIDRAW_NOT_FOUND:`Az Excalidraw b\u0151v\xEDtm\xE9ny nem tal\xE1lhat\xF3. K\xE9rlek telep\xEDtsd vagy enged\xE9lyezd az Excalidraw-t, majd pr\xF3b\xE1ld \xFAjra ind\xEDtani a(z) ${O} alkalmaz\xE1st.`,EXCALIDRAW_MINAPP_VERSION:`Az ExcaliBrain az Excalidraw ${P} vagy \xFAjabb verzi\xF3j\xE1t ig\xE9nyli. K\xE9rlek friss\xEDtsd az Excalidraw-t, majd pr\xF3b\xE1ld \xFAjra ind\xEDtani a(z) ${O} alkalmaz\xE1st.`,COMMAND_ADD_PARENT_FIELD:"Dataview mez\u0151 hozz\xE1ad\xE1sa ontol\xF3giak\xE9nt SZ\xDCL\u0150K\xC9NT",COMMAND_ADD_CHILD_FIELD:"Dataview mez\u0151 hozz\xE1ad\xE1sa ontol\xF3giak\xE9nt GYERMEKEKK\xC9NT",COMMAND_ADD_LEFT_FRIEND_FIELD:"Dataview mez\u0151 hozz\xE1ad\xE1sa ontol\xF3giak\xE9nt BAL-OLDALI BAR\xC1TK\xC9NT",COMMAND_ADD_RIGHT_FRIEND_FIELD:"Dataview mez\u0151 hozz\xE1ad\xE1sa ontol\xF3giak\xE9nt JOBB-OLDALI BAR\xC1TK\xC9NT",COMMAND_ADD_PREVIOUS_FIELD:"Dataview mez\u0151 hozz\xE1ad\xE1sa ontol\xF3giak\xE9nt EL\u0150Z\u0150K\xC9NT",COMMAND_ADD_NEXT_FIELD:"Dataview mez\u0151 hozz\xE1ad\xE1sa ontol\xF3giak\xE9nt K\xD6VETKEZ\u0150K\xC9NT",COMMAND_START:"ExcaliBrain Norm\xE1l",COMMAND_START_HOVER:"ExcaliBrain lebeg\u0151 szerkeszt\u0151",COMMAND_START_POPOUT:"ExcaliBrain k\xFCl\xF6n\xE1ll\xF3 ablak",COMMAND_STOP:"ExcaliBrain le\xE1ll\xEDt\xE1sa",HOVER_EDITOR_ERROR:"Sajn\xE1lom. Valami hiba t\xF6rt\xE9nt. Val\xF3sz\xEDn\u0171leg a Hover Editor verzi\xF3friss\xEDt\xE9se okozta, amelyet m\xE9g nem kezeltem megfelel\u0151en az ExcaliBrain-ben. \xC1ltal\xE1ban n\xE9h\xE1ny napon bel\xFCl megoldom ezt.",OPEN_DRAWING:"Ment\xE9s szerkeszt\xE9shez",SEARCH_IN_VAULT:`A csillagozott elemek megjelennek az \xFCres keres\xE9sben.
+Keres\xE9s f\xE1jl, mappa vagy c\xEDmke szerint a Vault-ban.
+Kapcsold ki/ki a mapp\xE1kat \xE9s c\xEDmk\xE9ket a list\xE1ban t\xF6rt\xE9n\u0151 megjelen\xEDt\xE9shez.`,SHOW_HIDE_ATTACHMENTS:"Mell\xE9kletek megjelen\xEDt\xE9se/elrejt\xE9se",SHOW_HIDE_VIRTUAL:"Virtu\xE1lis node-ok megjelen\xEDt\xE9se/elrejt\xE9se",SHOW_HIDE_INFERRED:"El\u0151\xE1ll\xEDtott node-ok megjelen\xEDt\xE9se/elrejt\xE9se",SHOW_HIDE_ALIAS:"Dokumentum alias megjelen\xEDt\xE9se/elrejt\xE9se",SHOW_HIDE_SIBLINGS:"Testv\xE9r node-ok megjelen\xEDt\xE9se/elrejt\xE9se",SHOW_HIDE_EMBEDDEDCENTRAL:"K\xF6z\xE9pponti node be\xE1gyazott keretk\xE9nt megjelen\xEDt\xE9se",SHOW_HIDE_FOLDER:"Mappa node-ok megjelen\xEDt\xE9se/elrejt\xE9se",SHOW_HIDE_TAG:"C\xEDmke node-ok megjelen\xEDt\xE9se/elrejt\xE9se",SHOW_HIDE_PAGES:"Oldal node-ok megjelen\xEDt\xE9se/elrejt\xE9se (defini\xE1lt, el\u0151\xE1ll\xEDtott, virtu\xE1lis \xE9s mell\xE9klet)",PIN_LEAF:"ExcaliBrain \xF6sszekapcsol\xE1sa az akt\xEDv legut\xF3bbi elemmel"};var xi={en:mt,ar:Gt,cs:Yt,da:zt,de:Bt,"en-gb":ai,es:Ut,fr:Vt,hi:Wt,id:Kt,it:ri,ja:jt,ko:Xt,nl:Zt,nn:qt,pl:$t,pt:Jt,"pt-br":si,ro:Qt,ru:ei,tr:ti,"zh-cn":ii,"zh-tw":ni,hu:oi},St=xi[Tt.moment.locale()];function h(g){return St||M({fn:"t",where:"src/lang/helpers.ts",message:"Error: locale not found",data:Tt.moment.locale()}),St&&St[g]||mt[g]}var li=require("obsidian"),Y=class extends li.Modal{constructor(t,i,n){super(t);this.title=i;this.message=n}title;message;resolve;onOpen(){this.createForm()}onClose(){}createForm(){this.titleEl.setText(this.title),this.contentEl.createDiv({cls:"excalibrain-prompt-center",text:this.message}),this.contentEl.createDiv({cls:"excalibrain-prompt-center excalibrain-prompt-actions"},t=>{let i=t.createEl("button",{text:"Ok"});i.onclick=()=>{this.resolve(!0),this.close()};let n=t.createEl("button",{text:"Cancel"});n.onclick=()=>{this.resolve(!1),this.close()}})}show(t){this.resolve=t,this.open()}};var Mi=g=>new Promise(e=>window.setTimeout(e,g));function D(g,e){Object.assign(g.style,e)}function z(g){let e=window.ExcalidrawAutomate;if(!e