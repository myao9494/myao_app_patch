--- a/80_script/register_custom_commands/02_external_apps.js
+++ b/80_script/register_custom_commands/02_external_apps.js
@@ -243,6 +243,61 @@ const openInVsCode = async (file) => {
     }
 };
 
+/**
+ * http(s) の URL を Google Chrome で開く（既定のブラウザが別でも Chrome を指定する）
+ * @param {string} url - 開く URL
+ **/
+const openUrlInChrome = async (url) => {
+    if (typeof url !== "string" || !/^https?:\/\//i.test(url.trim())) {
+        new Notice("http(s) のリンクだけ Chrome で開けます");
+        return;
+    }
+    const targetUrl = url.trim();
+
+    try {
+        let req;
+        try { req = require; } catch (e) { req = window.require; }
+        const fs = req ? (() => { try { return req("fs"); } catch (e) { return null; } })() : null;
+        const path = req ? (() => { try { return req("path"); } catch (e) { return null; } })() : null;
+        const platform = typeof process !== "undefined" ? process.platform : "";
+        let opened = false;
+
+        if (platform === "darwin") {
+            opened = await runShellCommand("open", ["-a", "Google Chrome", targetUrl]);
+            if (!opened) {
+                opened = await runShellCommand("open", ["-b", "com.google.Chrome", targetUrl]);
+            }
+        } else if (platform === "win32") {
+            const env = typeof process !== "undefined" ? process.env || {} : {};
+            if (path && fs) {
+                const chromeCandidates = [
+                    path.join(env.ProgramFiles || "", "Google", "Chrome", "Application", "chrome.exe"),
+                    path.join(env["ProgramFiles(x86)"] || "", "Google", "Chrome", "Application", "chrome.exe"),
+                    path.join(env.LOCALAPPDATA || "", "Google", "Chrome", "Application", "chrome.exe"),
+                ].filter((cand) => fs.existsSync(cand));
+                if (chromeCandidates.length > 0) {
+                    opened = await runShellCommand(chromeCandidates[0], [targetUrl]);
+                }
+            }
+            if (!opened) {
+                opened = await runShellCommand("chrome", [targetUrl]);
+            }
+        } else if (platform === "linux") {
+            for (const command of ["google-chrome", "google-chrome-stable", "chromium", "chromium-browser"]) {
+                opened = await runShellCommand(command, [targetUrl]);
+                if (opened) break;
+            }
+        }
+
+        if (!opened) {
+            new Notice("Chrome を起動できませんでした（インストールされているか確認してください）");
+        }
+    } catch (error) {
+        console.error("Failed to open in Chrome:", error);
+        new Notice(`Chrome で開けませんでした: ${error?.message || error}`);
+    }
+};
+
 const openMarkdownDiff = async (file) => {
     if (!file?.path || file.extension !== "md" || file.name.endsWith(".excalidraw.md")) return;
     try {
diff --git a/80_script/register_custom_commands/18_file_manager_and_editor_menu.js b/80_script/register_custom_commands/18_file_manager_and_editor_menu.js
index 269bced4b50298221c0f8bc472acd45f96479da7..494114cd90eb978bd9c09e8dd4bb0cc3096fd890 100644
--- a/80_script/register_custom_commands/18_file_manager_and_editor_menu.js
+++ b/80_script/register_custom_commands/18_file_manager_and_editor_menu.js
@@ -444,4 +444,23 @@ const handleEditorMenu = (menu, editor, view) => {
 };
 
 registerWorkspaceEvent("_customEditorMenuListener", "editor-menu", withNativeMenuReorder(handleEditorMenu));
+
+/**
+ * 外部リンク（http / https）の右クリックメニューに「chrome で開く」を追加する。
+ * url-menu は閲覧モードと編集モード（ライブプレビュー）のどちらの外部リンクでも発火する。
+ * ファイルマネージャーのリンク（open-path）は、開くとファイルを開く操作になるので対象外。
+ **/
+const handleUrlMenu = (menu, url) => {
+    if (typeof url !== "string" || !/^https?:\/\//i.test(url.trim())) return;
+    if (/^https?:\/\/localhost:8001\/api\/open-path(?:[?#]|$)/i.test(url.trim())) return;
+
+    menu.addItem((item) => {
+        item
+            .setTitle("chrome で開く")
+            .setIcon("globe")
+            .onClick(() => openUrlInChrome(url));
+    });
+};
+
+registerWorkspaceEvent("_customUrlMenuListener", "url-menu", handleUrlMenu);
 console.log("Editor menu listener registered for Summary");
