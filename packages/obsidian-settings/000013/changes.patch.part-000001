\uBE14\uC785\uB2C8\uB2E4. \uAE30\uBCF8\uAC12\uC744 \uC0AC\uC6A9\uD558\uB824\uBA74 \uBE44\uC6CC \uB450\uC138\uC694.",removeModel:"{model} \uC81C\uAC70",allProviders:"\uBAA8\uB4E0 \uC81C\uACF5\uC5C5\uCCB4 ({count})",noMatch:"\uD544\uD130\uC640 \uC77C\uCE58\uD558\uB294 \uBAA8\uB378\uC774 \uC5C6\uC2B5\uB2C8\uB2E4.",loadingCatalog:"{provider} \uBAA8\uB378 \uCE74\uD0C8\uB85C\uADF8 \uB85C\uB4DC \uC911...",loadFailed:"{provider} \uBAA8\uB378 \uCE74\uD0C8\uB85C\uADF8\uB97C \uB85C\uB4DC\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. CLI \uACBD\uB85C\uC640 \uB85C\uADF8\uC778 \uC0C1\uD0DC\uB97C \uD655\uC778\uD55C \uB2E4\uC74C \uC774 \uC139\uC158\uC744 \uB2E4\uC2DC \uD3BC\uCE58\uC138\uC694.",startToLoad:"\uBAA8\uB378 \uCE74\uD0C8\uB85C\uADF8\uB97C \uB85C\uB4DC\uD558\uB824\uBA74 {provider}\uC744(\uB97C) \uD55C \uBC88 \uC2DC\uC791\uD558\uC138\uC694. \uC774\uD6C4 Grimoire\uC5D0\uC11C \uD45C\uC2DC\uD560 \uBAA8\uB378\uC744 \uC120\uD0DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.",unavailable:"\uC0AC\uC6A9 \uBD88\uAC00",unavailableTitle:"\uAD6C\uC131\uB418\uC5C8\uC9C0\uB9CC \uD604\uC7AC {provider}\uC5D0\uC11C \uBCF4\uACE0\uB418\uC9C0 \uC54A\uB294 \uBAA8\uB378"},sharedEnvironment:{name:"\uACF5\uC720 \uD658\uACBD",desc:"\uBAA8\uB4E0 \uC81C\uACF5\uC5C5\uCCB4\uC5D0\uC11C \uACF5\uC720\uD558\uB294 \uC81C\uACF5\uC5C5\uCCB4 \uC911\uB9BD \uB7F0\uD0C0\uC784 \uBCC0\uC218\uC785\uB2C8\uB2E4. PATH, \uD504\uB85D\uC2DC, \uC778\uC99D\uC11C \uBC0F \uC784\uC2DC \uB514\uB809\uD130\uB9AC \uBCC0\uC218\uC5D0 \uC0AC\uC6A9\uD558\uC138\uC694."},providerTabs:{environmentVariables:"\uD658\uACBD \uBCC0\uC218",acp:{cliPath:{name:"{provider} CLI \uACBD\uB85C",desc:"\uB85C\uCEEC {provider} \uBA85\uB839\uC758 \uC0AC\uC6A9\uC790 \uC9C0\uC815 \uACBD\uB85C\uC785\uB2C8\uB2E4. \uC790\uB3D9 \uAC10\uC9C0\uD558\uB824\uBA74 \uBE44\uC6CC \uB450\uC138\uC694."},visibleModels:{name:"\uD45C\uC2DC\uD560 \uBAA8\uB378",desc:"\uCC44\uD305 \uC120\uD0DD\uAE30\uC5D0 \uD45C\uC2DC\uD560 {provider} \uBAA8\uB378\uC744 \uC120\uD0DD\uD558\uC138\uC694. \uC81C\uACF5\uC5C5\uCCB4\uB098 \uC720\uD615\uC73C\uB85C \uD544\uD130\uB9C1\uD558\uC5EC \uAC80\uC0C9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."},commandsDesc:"{provider}\uB294 .claude/commands/\uC758 vault \uC218\uC900 Claude \uC2AC\uB798\uC2DC \uBA85\uB839\uACFC .claude/skills/, .codex/skills/, .agents/skills/\uC758 \uC2A4\uD0AC\uC744 \uC790\uB3D9 \uAC10\uC9C0\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC774\uB7EC\uD55C \uD56D\uBAA9\uC740 Claude \uB610\uB294 Codex \uC124\uC815 \uD0ED\uC5D0\uC11C \uAD00\uB9AC\uD558\uC138\uC694. \uC774 \uC124\uC815\uC740 {provider} \uB4DC\uB86D\uB2E4\uC6B4\uC758 \uD56D\uBAA9\uB9CC \uC228\uAE41\uB2C8\uB2E4.",hiddenCommandsDesc:"\uD2B9\uC815 {provider} \uBA85\uB839\uACFC \uC2A4\uD0AC\uC744 \uB4DC\uB86D\uB2E4\uC6B4\uC5D0\uC11C \uC228\uAE41\uB2C8\uB2E4. \uC55E\uC758 \uC2AC\uB798\uC2DC \uC5C6\uC774 \uC774\uB984\uC744 \uD55C \uC904\uC5D0 \uD558\uB098\uC529 \uC785\uB825\uD558\uC138\uC694.",subagentsDesc:"{root} \uBC0F \uB808\uAC70\uC2DC {legacyRoot}\uC5D0\uC11C vault \uC218\uC900 {provider} \uD558\uC704 \uC5D0\uC774\uC804\uD2B8\uB97C \uAD00\uB9AC\uD569\uB2C8\uB2E4. \uC0C8 \uD56D\uBAA9\uC740 \uD558\uC704 \uC5D0\uC774\uC804\uD2B8 \uC804\uC6A9 \uD30C\uC77C\uB85C \uC800\uC7A5\uB418\uBA70 @mention \uBA54\uB274\uC5D0 \uD45C\uC2DC\uB429\uB2C8\uB2E4.",environmentDesc:"{environmentVariable}=1\uC744 \uD3EC\uD568\uD55C {provider} \uC18C\uC720 \uB7F0\uD0C0\uC784 \uBCC0\uC218\uB9CC \uC0AC\uC6A9\uD569\uB2C8\uB2E4. \uC81C\uACF5\uC5C5\uCCB4\uBCC4 \uC124\uC815\uC5D0\uB294 \uC774 \uD56D\uBAA9\uC744 \uC0AC\uC6A9\uD558\uACE0, \uACF5\uC720 PATH, \uD504\uB85D\uC2DC, \uC778\uC99D\uC11C \uBCC0\uC218\uB294 \uACF5\uC720 \uD658\uACBD\uC5D0 \uB123\uC73C\uC138\uC694."},antigravity:{windowsLimitations:{name:"Windows CLI \uC81C\uD55C \uC0AC\uD56D",desc:"Windows\uC5D0\uC11C \uD604\uC7AC agy \uBE4C\uB4DC\uB294 \uBAA8\uB378 \uAC80\uC0C9 \uBC0F \uCD9C\uB825 \uC751\uB2F5\uC5D0 \uBE48 stdout\uC744 \uBC18\uD658\uD558\uBA74\uC11C\uB3C4 \uC131\uACF5\uC801\uC73C\uB85C \uC885\uB8CC\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4. Grimoire\uB294 \uAC00\uB2A5\uD55C \uACBD\uC6B0 \uAE30\uB85D, \uC124\uC815 \uBC0F \uB300\uCCB4 \uBCF5\uAD6C\uB97C \uC0AC\uC6A9\uD558\uC9C0\uB9CC Antigravity\uB294 macOS\uB098 Linux\uBCF4\uB2E4 Windows\uC5D0\uC11C \uB35C \uC548\uC815\uC801\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4."},cliPath:{name:"Antigravity CLI \uACBD\uB85C",desc:"\uB85C\uCEEC agy \uBA85\uB839\uC758 \uC0AC\uC6A9\uC790 \uC9C0\uC815 \uACBD\uB85C\uC785\uB2C8\uB2E4. \uC790\uB3D9 \uAC10\uC9C0\uD558\uB824\uBA74 \uBE44\uC6CC \uB450\uC138\uC694."},customModels:{name:"\uC0AC\uC6A9\uC790 \uC9C0\uC815 \uBAA8\uB378",desc:"Antigravity \uBAA8\uB378 \uB808\uC774\uBE14\uC744 \uC120\uD0DD\uAE30\uC5D0 \uD55C \uC904\uC5D0 \uD558\uB098\uC529 \uCD94\uAC00\uD558\uC138\uC694. Windows \uAC80\uC0C9\uC774 \uBD88\uC644\uC804\uD55C \uACBD\uC6B0 agy \uBAA8\uB378 \uC804\uD658\uAE30\uC5D0 \uD45C\uC2DC\uB41C \uC815\uD655\uD55C \uB808\uC774\uBE14\uC744 \uC0AC\uC6A9\uD558\uC138\uC694."},environmentDesc:"GOOGLE_CLOUD_PROJECT\uC640 \uAC19\uC774 Antigravity CLI\uC5D0 \uC804\uB2EC\uD560 \uCD94\uAC00 \uD658\uACBD \uBCC0\uC218\uC785\uB2C8\uB2E4."},gemini:{cliPath:{name:"Gemini CLI \uACBD\uB85C",desc:"\uB85C\uCEEC Gemini CLI\uC758 \uC0AC\uC6A9\uC790 \uC9C0\uC815 \uACBD\uB85C\uC785\uB2C8\uB2E4. PATH\uC5D0\uC11C `gemini`\uB97C \uC2DC\uC791\uD558\uB824\uBA74 \uBE44\uC6CC \uB450\uC138\uC694."},environmentDesc:"GEMINI_API_KEY \uB610\uB294 GOOGLE_CLOUD_PROJECT\uC640 \uAC19\uC774 Gemini CLI\uC5D0 \uC804\uB2EC\uD560 \uCD94\uAC00 \uD658\uACBD \uBCC0\uC218\uC785\uB2C8\uB2E4."},claude:{advancedSummary:"\uBA85\uB839, \uC5D0\uC774\uC804\uD2B8, MCP, \uD658\uACBD \uBC0F \uC2E4\uD5D8",environmentDesc:"Claude \uC18C\uC720 \uB7F0\uD0C0\uC784 \uBCC0\uC218\uB9CC \uC0AC\uC6A9\uD569\uB2C8\uB2E4. ANTHROPIC_* \uBC0F Claude \uC804\uC6A9 \uD1A0\uAE00\uC5D0 \uC0AC\uC6A9\uD558\uC138\uC694."},codex:{installationMethod:{name:"\uC124\uCE58 \uBC29\uC2DD",desc:"Grimoire\uAC00 Windows\uC5D0\uC11C Codex\uB97C \uC2DC\uC791\uD558\uB294 \uBC29\uC2DD\uC785\uB2C8\uB2E4. \uB124\uC774\uD2F0\uBE0C Windows\uB294 Windows \uC2E4\uD589 \uD30C\uC77C \uACBD\uB85C\uB97C \uC0AC\uC6A9\uD569\uB2C8\uB2E4. WSL\uC740 \uC120\uD0DD\uD55C \uBC30\uD3EC\uD310 \uB0B4\uBD80\uC5D0\uC11C Linux CLI\uB97C \uC2DC\uC791\uD569\uB2C8\uB2E4.",nativeWindows:"\uB124\uC774\uD2F0\uBE0C Windows"},cliPath:{name:"Codex CLI \uACBD\uB85C",desc:"\uB85C\uCEEC Codex CLI\uC758 \uC0AC\uC6A9\uC790 \uC9C0\uC815 \uACBD\uB85C\uC785\uB2C8\uB2E4. PATH\uC5D0\uC11C \uC790\uB3D9 \uAC10\uC9C0\uD558\uB824\uBA74 \uBE44\uC6CC \uB450\uC138\uC694.",descWindows:"\uB85C\uCEEC Codex CLI\uC758 \uC0AC\uC6A9\uC790 \uC9C0\uC815 \uACBD\uB85C\uC785\uB2C8\uB2E4. PATH\uC5D0\uC11C \uC790\uB3D9 \uAC10\uC9C0\uD558\uB824\uBA74 \uBE44\uC6CC \uB450\uC138\uC694. \uC77C\uBC18\uC801\uC73C\uB85C `codex.exe`\uC778 \uB124\uC774\uD2F0\uBE0C Windows \uC2E4\uD589 \uD30C\uC77C \uACBD\uB85C\uB97C \uC0AC\uC6A9\uD558\uC138\uC694.",descWsl:"WSL \uB0B4\uBD80\uC5D0\uC11C \uC2E4\uD589\uD560 Linux \uCE21 Codex \uBA85\uB839 \uB610\uB294 \uC808\uB300 \uACBD\uB85C\uC785\uB2C8\uB2E4. \uC120\uD0DD\uD55C \uBC30\uD3EC\uD310\uC5D0\uC11C PATH\uB97C \uC870\uD68C\uD558\uB824\uBA74 \uBE44\uC6CC \uB450\uC138\uC694.",wslValidation:"WSL \uBAA8\uB4DC\uC5D0\uB294 Windows \uC2E4\uD589 \uD30C\uC77C \uACBD\uB85C\uAC00 \uC544\uB2CC Linux \uBA85\uB839 \uB610\uB294 Linux \uC808\uB300 \uACBD\uB85C\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4."},wslDistro:{name:"WSL \uBC30\uD3EC\uD310 \uC7AC\uC815\uC758",desc:"\uC120\uD0DD\uC801 \uACE0\uAE09 \uC7AC\uC815\uC758\uC785\uB2C8\uB2E4. \uAC00\uB2A5\uD55C \uACBD\uC6B0 WSL \uC791\uC5C5 \uACF5\uAC04 \uACBD\uB85C\uC5D0\uC11C \uBC30\uD3EC\uD310\uC744 \uCD94\uB860\uD558\uB824\uBA74 \uBE44\uC6CC \uB450\uACE0, \uADF8\uB807\uC9C0 \uC54A\uC73C\uBA74 \uAE30\uBCF8 WSL \uBC30\uD3EC\uD310\uC744 \uC0AC\uC6A9\uD569\uB2C8\uB2E4."},customModels:{name:"\uC0AC\uC6A9\uC790 \uC9C0\uC815 \uBAA8\uB378",desc:"\uCD94\uAC00 Codex \uBAA8\uB378 ID\uB97C \uC120\uD0DD\uAE30\uC5D0 \uD55C \uC904\uC5D0 \uD558\uB098\uC529 \uCD94\uAC00\uD569\uB2C8\uB2E4. \uC124\uC815\uB41C \uACBD\uC6B0 `OPENAI_MODEL`\uC774 \uACC4\uC18D \uC6B0\uC120\uD569\uB2C8\uB2E4."},reasoning:{name:"\uCD94\uB860 \uC694\uC57D",desc:"\uC0AC\uACE0 \uBE14\uB85D\uC5D0 \uBAA8\uB378 \uCD94\uB860 \uACFC\uC815\uC758 \uC694\uC57D\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4.",auto:"\uC790\uB3D9",concise:"\uAC04\uB7B5",detailed:"\uC0C1\uC138",off:"\uB054"},advancedSummary:"\uC2A4\uD0AC, \uD558\uC704 \uC5D0\uC774\uC804\uD2B8, MCP \uBC0F \uC2DC\uC791 \uC124\uC815",skills:{name:"Codex \uC2A4\uD0AC",desc:".codex/skills/ \uB610\uB294 .agents/skills/\uC5D0 \uC800\uC7A5\uB41C vault \uC218\uC900 Codex \uC2A4\uD0AC\uC744 \uAD00\uB9AC\uD569\uB2C8\uB2E4. \uD648 \uC218\uC900 \uC2A4\uD0AC\uC740 \uC5EC\uAE30\uC5D0\uC11C \uC81C\uC678\uB429\uB2C8\uB2E4."},hiddenSkills:{name:"\uC228\uACA8\uC9C4 \uC2A4\uD0AC",desc:"\uD2B9\uC815 Codex \uC2A4\uD0AC\uC744 \uB4DC\uB86D\uB2E4\uC6B4\uC5D0\uC11C \uC228\uAE41\uB2C8\uB2E4. \uC55E\uC758 $ \uC5C6\uC774 \uC2A4\uD0AC \uC774\uB984\uC744 \uD55C \uC904\uC5D0 \uD558\uB098\uC529 \uC785\uB825\uD558\uC138\uC694."},subagents:{name:"Codex \uD558\uC704 \uC5D0\uC774\uC804\uD2B8",desc:".codex/agents/\uC5D0 \uC800\uC7A5\uB41C vault \uC218\uC900 Codex \uD558\uC704 \uC5D0\uC774\uC804\uD2B8\uB97C \uAD00\uB9AC\uD569\uB2C8\uB2E4. \uAC01 TOML \uD30C\uC77C\uC740 \uD558\uB098\uC758 \uC0AC\uC6A9\uC790 \uC9C0\uC815 \uC5D0\uC774\uC804\uD2B8\uB97C \uC815\uC758\uD569\uB2C8\uB2E4."},mcp:{beforeCommand:"Codex\uB294 \uC790\uCCB4 CLI\uB97C \uD1B5\uD574 MCP \uC11C\uBC84\uB97C \uAD00\uB9AC\uD569\uB2C8\uB2E4. \uB2E4\uC74C \uBA85\uB839\uC73C\uB85C \uAD6C\uC131\uD558\uBA74 ",afterCommand:" Grimoire\uC5D0\uC11C \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. "},environment:{name:"Codex \uD658\uACBD",desc:"Codex \uC18C\uC720 \uB7F0\uD0C0\uC784 \uBCC0\uC218\uB9CC \uC0AC\uC6A9\uD569\uB2C8\uB2E4. OPENAI_* \uBC0F CODEX_* \uC124\uC815\uC5D0 \uC0AC\uC6A9\uD558\uC138\uC694. \uC790\uB3D9 \uAC10\uC9C0\uC5D0 \uB3C4\uC6C0\uC774 \uD544\uC694\uD558\uBA74 Codex \uC124\uCE58 \uB514\uB809\uD130\uB9AC\uB97C \uB300\uC2E0 \uACF5\uC720 \uD658\uACBD PATH\uC5D0 \uCD94\uAC00\uD558\uC138\uC694."}},qwen:{cliPath:{name:"Qwen CLI \uACBD\uB85C",desc:"\uB85C\uCEEC Qwen CLI\uC758 \uC0AC\uC6A9\uC790 \uC9C0\uC815 \uACBD\uB85C\uC785\uB2C8\uB2E4. PATH\uC5D0\uC11C `qwen`\uB97C \uC2DC\uC791\uD558\uB824\uBA74 \uBE44\uC6CC \uB450\uC138\uC694."},advancedSummary:"\uC2A4\uD0AC, \uBA85\uB839, \uD558\uC704 \uC5D0\uC774\uC804\uD2B8, MCP \uBC0F \uD658\uACBD",hiddenCommands:{name:"\uC228\uACA8\uC9C4 \uBA85\uB839",desc:"Qwen Code ACP\uC5D0\uC11C \uBCF4\uACE0\uD55C \uD2B9\uC815 \uBA85\uB839\uC744 \uC228\uAE41\uB2C8\uB2E4. \uC55E\uC758 \uC2AC\uB798\uC2DC \uC5C6\uC774 \uC774\uB984\uC744 \uD55C \uC904\uC5D0 \uD558\uB098\uC529 \uC785\uB825\uD558\uC138\uC694.",placeholder:`compact
+claude-opus-4-5-20251101`},refreshModels:{name:"\uBAA8\uB378 \uC0C8\uB85C \uACE0\uCE68",desc:"{provider}\uC5D0 \uD604\uC7AC \uBAA8\uB378 \uBAA9\uB85D\uC744 \uC694\uCCAD\uD569\uB2C8\uB2E4. \uADF8 \uC678\uC5D0\uB294 CLI\uB098 \uD658\uACBD\uC774 \uBC14\uB014 \uB54C\uB9CC Grimoire\uAC00 \uB2E4\uC2DC \uD655\uC778\uD569\uB2C8\uB2E4.",button:"\uC0C8\uB85C \uACE0\uCE68",done:"\uBAA8\uB378 \uBAA9\uB85D\uC744 \uC0C8\uB85C \uACE0\uCCE4\uC2B5\uB2C8\uB2E4: \uBAA8\uB378 {count}\uAC1C."},refreshCommands:{name:"\uBA85\uB839 \uC0C8\uB85C \uACE0\uCE68",desc:"Claude Code\uC5D0 \uD604\uC7AC \uBA85\uB839 \uBC0F \uC2A4\uD0AC \uBAA9\uB85D\uC744 \uC694\uCCAD\uD569\uB2C8\uB2E4. \uADF8\uB807\uC9C0 \uC54A\uC73C\uBA74 Grimoire\uB294 CLI\uB098 \uADF8 \uD658\uACBD\uC774 \uBC14\uB014 \uB54C\uAE4C\uC9C0 \uAE30\uC874 \uBAA9\uB85D\uC744 \uC7AC\uC0AC\uC6A9\uD569\uB2C8\uB2E4.",button:"\uC0C8\uB85C \uACE0\uCE68",done:"\uBA85\uB839 \uBAA9\uB85D\uC744 \uC0C8\uB85C \uACE0\uCCE4\uC2B5\uB2C8\uB2E4: {count}\uAC1C."},respectProjectSettings:{name:"Claude Code \uC124\uC815 \uC900\uC218",desc:"Claude Code \uC0AC\uC6A9\uC790 \uBC0F \uD504\uB85C\uC81D\uD2B8 \uC124\uC815\uC758 \uBAA8\uB378\uACFC \uD658\uACBD\uC744 \uC0AC\uC6A9\uD569\uB2C8\uB2E4. MiniMax, Z.ai \uBC0F \uB2E4\uB978 Anthropic \uD638\uD658 \uAC8C\uC774\uD2B8\uC6E8\uC774\uC758 \uC0AC\uC6A9\uC790 \uC9C0\uC815 \uBAA8\uB378\uC744 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. Grimoire\uC758 \uBA85\uC2DC\uC801 \uC120\uD0DD\uC740 \uACC4\uC18D \uC6B0\uC120\uD569\uB2C8\uB2E4."},enableChrome:{name:"Chrome \uD655\uC7A5 \uD504\uB85C\uADF8\uB7A8 \uD65C\uC131\uD654",desc:"claude-in-chrome \uD655\uC7A5 \uD504\uB85C\uADF8\uB7A8\uC744 \uD1B5\uD574 Claude\uAC00 Chrome\uACFC \uC0C1\uD638\uC791\uC6A9\uD560 \uC218 \uC788\uB3C4\uB85D \uD569\uB2C8\uB2E4. \uD655\uC7A5 \uD504\uB85C\uADF8\uB7A8\uC774 \uC124\uCE58\uB418\uC5B4 \uC788\uC5B4\uC57C \uD569\uB2C8\uB2E4. \uC138\uC158 \uC7AC\uC2DC\uC791\uC774 \uD544\uC694\uD569\uB2C8\uB2E4."},enableBangBash:{name:"bash \uBAA8\uB4DC (!) \uD65C\uC131\uD654",desc:"\uC785\uB825\uCC3D\uC774 \uBE44\uC5B4 \uC788\uC744 \uB54C !\uB97C \uC785\uB825\uD558\uBA74 bash \uBAA8\uB4DC\uB85C \uB4E4\uC5B4\uAC11\uB2C8\uB2E4. Node.js child_process\uB97C \uD1B5\uD574 \uBA85\uB839\uC744 \uC9C1\uC811 \uC2E4\uD589\uD569\uB2C8\uB2E4. \uBCF4\uAE30\uB97C \uB2E4\uC2DC \uC5F4\uC5B4\uC57C \uD569\uB2C8\uB2E4.",validation:{noNode:"PATH\uC5D0\uC11C Node.js\uB97C \uCC3E\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. Node.js\uB97C \uC124\uCE58\uD558\uAC70\uB098 PATH \uC124\uC815\uC744 \uD655\uC778\uD558\uC138\uC694."}},maxTabs:{name:"\uCD5C\uB300 \uCC44\uD305 \uD0ED \uC218",desc:"\uB3D9\uC2DC\uC5D0 \uC5F4 \uC218 \uC788\uB294 \uCD5C\uB300 \uCC44\uD305 \uD0ED \uC218(1-10). \uAC01 \uD0ED\uC740 \uBCC4\uB3C4\uC758 Claude \uC138\uC158\uC744 \uC0AC\uC6A9\uD569\uB2C8\uB2E4.",warning:"5\uAC1C \uD0ED\uC744 \uCD08\uACFC\uD558\uBA74 \uC131\uB2A5 \uBC0F \uBA54\uBAA8\uB9AC \uC0AC\uC6A9\uB7C9\uC5D0 \uC601\uD5A5\uC744 \uC904 \uC218 \uC788\uC2B5\uB2C8\uB2E4."},showPanelLabels:{name:"\uD328\uB110 \uC774\uB984 \uD45C\uC2DC",desc:"\uB300\uD654 \uC704 \uC804\uD658\uAE30\uC5D0\uC11C \uAC01 \uD328\uB110\uC758 \uC774\uB984\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4. \uD604\uC7AC \uD328\uB110\uC740 \uD56D\uC0C1 \uC774\uB984\uC774 \uB098\uC624\uACE0, \uB098\uBA38\uC9C0\uB294 \uCF1C\uAE30 \uC804\uAE4C\uC9C0 \uC544\uC774\uCF58\uC73C\uB85C\uB9CC \uD45C\uC2DC\uB429\uB2C8\uB2E4."},tabBarPosition:{name:"\uD0ED \uBC14 \uC704\uCE58",desc:"\uD0ED \uBC30\uC9C0\uC640 \uC791\uC5C5 \uBC84\uD2BC\uC758 \uD45C\uC2DC \uC704\uCE58 \uC120\uD0DD",input:"\uC785\uB825\uCC3D \uC704(\uAE30\uBCF8\uAC12)",header:"\uD5E4\uB354\uC5D0"},enableAutoScroll:{name:"\uC2A4\uD2B8\uB9AC\uBC0D \uC911 \uC790\uB3D9 \uC2A4\uD06C\uB864",desc:"Claude\uAC00 \uC751\uB2F5\uC744 \uC2A4\uD2B8\uB9AC\uBC0D\uD558\uB294 \uB3D9\uC548 \uC790\uB3D9\uC73C\uB85C \uC544\uB798\uB85C \uC2A4\uD06C\uB864\uD569\uB2C8\uB2E4. \uBE44\uD65C\uC131\uD654\uD558\uBA74 \uC0C1\uB2E8\uC5D0 \uBA38\uBB3C\uB7EC \uCC98\uC74C\uBD80\uD130 \uC77D\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."},deferMathRenderingDuringStreaming:{name:"\uC2A4\uD2B8\uB9AC\uBC0D \uC911 \uC218\uC2DD \uB80C\uB354\uB9C1 \uC9C0\uC5F0",desc:"\uC751\uB2F5\uC774 \uC2A4\uD2B8\uB9AC\uBC0D\uB418\uB294 \uB3D9\uC548 \uC6D0\uBCF8 LaTeX\uB97C \uD45C\uC2DC\uD558\uACE0 \uAC01 \uD14D\uC2A4\uD2B8 \uBE14\uB85D\uC774 \uC644\uB8CC\uB418\uBA74 \uC218\uC2DD\uC744 \uD55C \uBC88 \uB80C\uB354\uB9C1\uD569\uB2C8\uB2E4."},chatViewPlacement:{name:"Grimoire \uC5F4 \uC704\uCE58",desc:"\uCC44\uD305 \uD328\uB110\uC774 \uC0DD\uC131\uB420 \uB54C \uC5F4\uB9B4 \uC704\uCE58\uB97C \uC120\uD0DD\uD569\uB2C8\uB2E4",rightSidebar:"\uC624\uB978\uCABD \uC0AC\uC774\uB4DC\uBC14",leftSidebar:"\uC67C\uCABD \uC0AC\uC774\uB4DC\uBC14",mainTab:"\uBA54\uC778 \uD3B8\uC9D1\uAE30 \uD0ED"},cliPath:{name:"Claude CLI \uACBD\uB85C",desc:"Claude Code CLI\uC758 \uC0AC\uC6A9\uC790 \uC815\uC758 \uACBD\uB85C. \uBE44\uC6CC\uB450\uBA74 \uC790\uB3D9 \uAC10\uC9C0 \uC0AC\uC6A9.",descWindows:"\uB124\uC774\uD2F0\uBE0C \uC124\uCE58 \uD504\uB85C\uADF8\uB7A8\uC758 \uACBD\uC6B0 claude.exe\uB97C \uC0AC\uC6A9\uD558\uC138\uC694. npm/pnpm/yarn \uB610\uB294 \uAE30\uD0C0 \uD328\uD0A4\uC9C0 \uAD00\uB9AC\uC790 \uC124\uCE58\uC758 \uACBD\uC6B0 cli-wrapper.cjs \uACBD\uB85C\uB97C \uC0AC\uC6A9\uD558\uC138\uC694 (claude.cmd\uAC00 \uC544\uB2D8).",descUnix:'"which claude"\uC758 \uCD9C\uB825\uC744 \uBD99\uC5EC\uB123\uC73C\uC138\uC694 - \uB124\uC774\uD2F0\uBE0C \uBC0F npm/pnpm/yarn \uC124\uCE58 \uBAA8\uB450\uC5D0\uC11C \uC791\uB3D9\uD569\uB2C8\uB2E4.',validation:{notExist:"\uACBD\uB85C\uAC00 \uC874\uC7AC\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4",isDirectory:"\uACBD\uB85C\uAC00 \uB514\uB809\uD1A0\uB9AC\uC785\uB2C8\uB2E4 \uD30C\uC77C\uC774 \uC544\uB2D9\uB2C8\uB2E4"}},language:{name:"\uC5B8\uC5B4",desc:"\uD50C\uB7EC\uADF8\uC778 \uC778\uD130\uD398\uC774\uC2A4\uC758 \uD45C\uC2DC \uC5B8\uC5B4 \uBCC0\uACBD"},contextEngine:{name:"\uCEE8\uD14D\uC2A4\uD2B8 \uC5D4\uC9C4",desc:"\uBCF4\uAD00\uC18C \uAC80\uC0C9\uACFC \uAD00\uB828 \uB178\uD2B8 \uC