9 \u0438 \u043C\u0443\u043B\u044C\u0442\u0438\u0432\u0435\u043D\u0434\u043E\u0440\u043D\u044B\u0439. \u041F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u0430\u043C\u044B\u0439 \u0448\u0438\u0440\u043E\u043A\u0438\u0439 \u043A\u0430\u0442\u0430\u043B\u043E\u0433 \u043C\u043E\u0434\u0435\u043B\u0435\u0439."},mimocode:{desc:"\u0424\u043E\u0440\u043A OpenCode \u043E\u0442 Xiaomi \u0441 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E\u0439 \u043F\u0430\u043C\u044F\u0442\u044C\u044E \u0438 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C \u043A\u043E\u043D\u0442\u0435\u043A\u0441\u0442\u043E\u043C."},kimicode:{desc:"\u041C\u0443\u043B\u044C\u0442\u0438\u043F\u0440\u043E\u0432\u0430\u0439\u0434\u0435\u0440\u043D\u0430\u044F \u0430\u0433\u0435\u043D\u0442\u0441\u043A\u0430\u044F CLI MoonshotAI. \u041F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 Kimi, OpenAI, Anthropic \u0438 Gemini."},qwen:{desc:"Alibaba Qwen Code \u0447\u0435\u0440\u0435\u0437 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E \u0441\u0440\u0435\u0434\u0443 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F Agent Client Protocol."},devin:{desc:"Devin CLI \u043E\u0442 Cognition \u0447\u0435\u0440\u0435\u0437 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E \u0441\u0440\u0435\u0434\u0443 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F Agent Client Protocol."},reasonix:{desc:"\u041E\u0442\u043A\u0440\u044B\u0442\u044B\u0439 \u0430\u0433\u0435\u043D\u0442 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F Reasonix \u0447\u0435\u0440\u0435\u0437 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E \u0441\u0440\u0435\u0434\u0443 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F Agent Client Protocol."},commandcode:{desc:"\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0443\u0441\u0442\