 /* nosourcemap */
\ No newline at end of file
diff --git a/.obsidian/plugins/terminal/manifest.json b/.obsidian/plugins/terminal/manifest.json
index a4eaae6fd3e0a8d7fe26f51dd2b103a403dbca99..a844ad0dd8a36460b951cc981b3153f7aa219835 100644
--- a/.obsidian/plugins/terminal/manifest.json
+++ b/.obsidian/plugins/terminal/manifest.json
@@ -10,5 +10,5 @@
   "isDesktopOnly": false,
   "minAppVersion": "1.4.11",
   "name": "Terminal",
-  "version": "3.27.2"
+  "version": "3.28.0"
 }
diff --git a/.obsidian/snippets/excalidraw-embed-width.css b/.obsidian/snippets/excalidraw-embed-width.css
index a475eccb9322e39dcf8c4bd71a65c9b11aec5d88..a11c60d8779af786e69305414a2233f0713d12d2 100644
--- a/.obsidian/snippets/excalidraw-embed-width.css
+++ b/.obsidian/snippets/excalidraw-embed-width.css
@@ -195,3 +195,10 @@ iframe[src*="Excalidraw"] {
     z-index: 9999;
 }
 
+
+/* 幅の指定が%・自動のままでも、図が幅0に潰れて消えないようにする（Windowsで発生） */
+.media-embed[data-figure-kind="excalidraw"] :is(img, svg, canvas),
+.internal-embed[data-figure-kind="excalidraw"] :is(img, svg, canvas),
+.excalidraw-svg[data-figure-kind="excalidraw"] :is(img, svg, canvas) {
+    min-width: 50px;
+}
