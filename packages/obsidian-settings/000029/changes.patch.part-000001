ds:{},example:{}},status:{description:"Inspect readiness and available runtime capabilities",fields:{},example:{}},schema:{description:"Inspect one command's fields and side effects",fields:{action:"Command to describe"},example:{action:"create"}},api:{description:"Search EA documentation or the supported installed Lib reference",fields:{surface:"ea (default) or lib",name:"Exact method name",query:"Case-insensitive search"},example:{surface:"ea",name:"addText"}},list:{description:"List drawing paths without opening them",fields:{folder:"Optional exact folder",...DD},example:{limit:50}},selection:{description:"Capture up to 500 selected live elements and bound labels as a stable agent handoff packet; no clipboard or drawing writes",fields:{...xD},example:{path:"Drawings/Flow.excalidraw.md",view:"from-open-or-read"}},read:{description:"Read an explicit live or disk drawing; no base64 asset bodies",fields:{...xD,...CD,...DD,detail:"summary (default), elements, or images (asset metadata only)",selectedOnly:"Live selection only",ids:"JSON array of element IDs"},example:{path:"Drawings/Flow.excalidraw.md",source:"live",detail:"elements"}},open:{description:"Explicitly open a ready Excalidraw view; normal drawing scripts can run",fields:{...xD},example:{path:"Drawings/Flow.excalidraw.md"}},create:{description:"Create an exact new path using EA's serializer; never overwrite",fields:{...kD,path:xD.path,template:"Optional exact drawing template; no picker",elements:"Validated batch of installed Excalidraw skeletons",icons:"Optional array of at most 100 grouped native Lucide icons with unique logical IDs"},writes:!0,example:{requestId:"flow-1",path:"Drawings/Flow.excalidraw.md",elements:[{id:"a",type:"rectangle",x:0,y:0,width:200,height:80,label:{text:"Start"}}]}},apply:{description:"Apply one bounded edit to an explicit live revision and report its save outcome",fields:{...kD,...xD,expectedRevision:"Fresh revision from live read",operations:"Array of add, update, delete, connect, group, ungroup, image, imageMetadata, latex, or lucide operations"},writes:!0,example:{requestId:"flow-2",path:"Drawings/Flow.excalidraw.md",expectedRevision:"from-read",operations:[{op:"update",id:"actual-id",set:{backgroundColor:"#e7f5ff"}}]}},export:{description:"Render SVG/PNG to an explicit vault path; existing remote assets may use normal network permissions",fields:{...kD,...xD,...CD,out:"Exact .svg or .png output path",overwrite:"Explicit permission to replace an existing output",selectedOnly:"Live selection only",theme:"light or dark",padding:"0 to 200, default 10",scale:"PNG scale 0.1 to 4, default 1",maxWidth:"Optional output maximum pixel width",maxHeight:"Optional output maximum pixel height",maxPixels:"Optional maximum output pixels",maxArtifactBytes:"Optional cap, 1024 to 33554432",imagePolicy:"Optional JSON {default,rules,thumbnailMaxDimension,labels}; no loss unless requested",area:"JSON object with x,y,width,height"},writes:!0,example:{requestId:"preview-1",path:"Drawings/Flow.excalidraw.md",out:"Drawings/Flow.png"}},script:{description:"Run an explicitly trusted local EA script once; arbitrary code is not transactional or sandboxed",fields:{...kD,...xD,script:"Exact existing .md or enabled .js script path",trusted:"Required explicit true",args:"JSON passed as utils.input; never interpolated into code"},writes:!0,example:{requestId:"script-1",script:"Scripts/Inspect.md",trusted:!0,args:{}}},skill:{description:"Return offline portable agent instructions without installing them",fields:{format:"json (default) or markdown for native stdout"},example:{format:"markdown"}},result:{description:"Look up a session-only operation receipt after a client timeout",fields:{requestId:kD.requestId},example:{requestId:"flow-2"}}};function PD(e){return Object.fromEntries(Object.entries({...MD[e].fields,input:"Vault-relative UTF-8 JSON request; exclusive with json",json:"Small inline JSON request; exclusive with input"}).map(([e,t])=>[e,{description:t,...["trusted","overwrite","selectedOnly"].includes(e)?{}:{value:`<${e}>`}}]))}const RD=[{name:"convertToExcalidrawElements",signature:"convertToExcalidrawElements(skeletons, {regenerateIds})",description:"Construct a batch with labels, bindings and frames. It is not an existing-scene patcher."},{name:"getCommonBounds",signature:"getCommonBounds(elements)",description:"Return [minX,minY,maxX,maxY]."},{name:"mutateElement",signature:"mutateElement(element, elementsMap, updates)",description:"Maintain element versions/nonces when mutating an EA workbench copy."},{name:"exportToSvg",signature:"exportToSvg({elements, appState, files})",description:"Low-level SVG export; prefer the CLI export action for Obsidian assets."},{name:"exportToBlob",signature:"exportToBlob({elements, appState, files, mimeType})",description:"Low-level raster export; prefer CLI export for Obsidian assets."}],LD='---\nname: obsidian-excalidraw-cli\ndescription: Create, inspect, edit and render Obsidian Excalidraw drawings through the running app\'s native CLI.\n---\n\nUse a local terminal with Obsidian running and CLI enabled (API 1.12.2+).\nAlways put vault="<name or ID>" before the command. Native root: obsidian-excalidraw-plugin.\nStart with obsidian vault="<vault>" obsidian-excalidraw-plugin:help, then :schema action=create.\nAll results use apiVersion 1. Check ok, mutation and persistence; process exit zero alone does not prove success.\nPut large requests in a visible vault-relative JSON file and pass input="<file>". Inline json is for small requests.\nRequests in files include apiVersion:1; the native command supplies command. The in-process ea.executeCLI request also includes command.\nUse exact drawing paths including extensions. Never assume an active drawing. :open explicitly creates a tab and can run configured drawing scripts.\nLoop: :read source=live detail=elements (or detail=images to inventory) → :apply with expectedRevision and a unique requestId → check persistence=saved → :export → inspect the image file.\nFor selected targets use :selection with an explicit path/view, or the drawing command Copy selected elements for agent. Retain packet IDs (including bound-label IDs), read those IDs at the packet revision, and apply only authorized targets. A stale packet needs inspection and a fresh revision, never guessed replacement IDs.\nFor duplicate views use the view ID from :open or :read. Refresh after STALE_REVISION; retry BUSY with the same requestId only when refused before execution; unknown outcomes require read-back.\nNew skeleton IDs are local labels; use returned idMap actual IDs for updates. Updates reject identity, bindings and asset internals.\nEvery write requires requestId. Repeat the identical effective request to retrieve its receipt; different content with the same ID fails.\n:result requestId=<id> recovers a receipt after lost stdout. Receipts expire after 15 minutes/reload; unknown outcome requires read-back before another write.\n:api surface=ea name=<method> gives existing EA signatures. :api surface=lib lists the supported installed Lib reference; advanced exports remain available to scripts.\n:icons query=<name> discovers installed canonical Lucide names (paged); create icons / apply op=lucide insert editable native groups. groupMap maps logical icon aliases to groupId/elementIds; idMap remains single-element only. Defaults: size=96, strokeColor=#1e1e1e, roughness=1, opacity=100; optional strokeWidth is final scene units. No trusted script is required.\n:script requires trusted=true and an explicit existing local script file. utils.input contains args; utils.excalidrawLib is the installed runtime. Await all work; completion does not imply saved drawing.\n:status ready describes plugin startup. Inspect extras.components for optional service versions, active/compatible flags and requirements; extras may be null during startup. mindMapBuilder reports the resident script API\'s available/ready flags without starting it or selecting a view.\nOne-shot ea.addMermaid preflights Extras and rejects unavailable dependencies with DEPENDENCY_UNAVAILABLE instead of opening an activation modal. Inspect any earlier script writes before retrying.\nOne-shot EA is cleaned up; utility prompts fail INTERACTION_REQUIRED. Trusted code can still invoke other interactive APIs: this is not a sandbox, timeout cancellation or transaction.\nExport names an explicit out=.svg/.png; overwrite=true is required for existing outputs. Live exports never implicitly save. Disk exports require local Vault assets; use a loaded live source or placeholders for remote assets.\nFor cheap previews: :read detail=images, then :export imagePolicy={"default":"placeholder","rules":[{"ids":["wanted-id"],"mode":"original"}]}. This is lossless for the underlying drawing, not the preview.\nimageMetadata apply operations set bounded descriptive label/tags, with null clearing; request-only imagePolicy.labels does not persist. Thumbnail mode uses thumbnailMaxDimension=512 by default; only PNG/JPEG/WebP with safe preflight dimensions are decoded (24 MiB / 16 million pixels maximum).\nmaxWidth/maxHeight/maxPixels bound output dimensions; maxArtifactBytes caps final bytes. Source revision covers originals; representationId identifies the preview. SVG width controls display size, not embedded raster payload size; use imagePolicy for that.\nUse :schema for exact fields, operation limits, and runnable examples. Do not edit compressed drawing Markdown directly or install another Excalidraw CLI.\n';function ND(e,t=new WeakSet,i=0){if(!e||"object"!=typeof e)return e;if(i>60||t.has(e))throw new Hr("INTERNAL_ERROR","Live metadata could not be inspected safely.");let n;if(t.add(e),e instanceof Date)n=e.getTime();else if(e instanceof Map)n=new Map([...e].map(([e,n])=>[ND(e,t,i+1),ND(n,t,i+1)]));else if(e instanceof Set)n=new Set([...e].map(e=>ND(e,t,i+1)));else if(ArrayBuffer.isView(e))n=Array.from(new Uint8Array(e.buffer,e.byteOffset,e.byteLength));else if(e i