hange this image or all copies?",PREVIEW_SHARED_HELP:'"{drawing}" appears in {count} images in this scene. Apply your changes to all of them?',PREVIEW_ALL:"All {count} images",PREVIEW_ONLY:"Only this image",PREVIEW_APPLY:"Apply",PREVIEW_CURRENT:"Current reference",FRAME_NAVIGATE:"Navigate to frame",FRAME_PICK:"Choose frame",FRAME_DEFAULT:"Default thumbnail",FRAME_WHOLE:"Whole scene",FRAME_UNNAMED:"Unnamed frame",FRAME_UNNAMED_MARKER:"Unnamed marker frame",FRAME_SET_THUMBNAIL:"Set as drawing thumbnail",FRAME_CLEAR_THUMBNAIL:"Clear drawing thumbnail",FRAME_THUMBNAIL_HELP:"Use this frame for drawing previews. Its name is saved in the excalidraw-thumbnail document property.",FRAME_NEEDS_NAME:"Give this frame a unique name first.",FRAME_RENAME_POLICY:"When the thumbnail frame is renamed",FRAME_RENAME_DESC:"Choose whether to update the excalidraw-thumbnail document property when its frame is renamed.",FRAME_RENAME_UNSET:"Ask on first rename",FRAME_RENAME_ALWAYS:"Always update the thumbnail property",FRAME_RENAME_ASK:"Ask each time",FRAME_RENAME_NEVER:"Do nothing",FRAME_RENAME_CONFIRM:"Update the drawing thumbnail property to the frame's new name?",EMBED_OPEN_MODIFIER:"{keys}+click: {action}",EMBED_ACTIONS:"Drawing embed actions",EMBED_ADJUST_PADDING:"Adjust padding",EMBED_RESET_PADDING:"Use default padding",EMBED_OPEN_DRAWING:"Open drawing",EMBED_EDIT_SOURCE:"Edit embed syntax",EMBED_RESET_SIZE:"Reset embed size",EMBED_RESIZE:"Resize drawing embed. Use arrow keys to resize, Home to reset, or Escape to cancel.",EMBED_SOURCE_CHANGED:"This embed changed. Wait for its preview to refresh and try again.",EMBED_PREVIEW_TITLE:"Drawing preview",EMBED_PREVIEW_ZOOM_OUT:"Zoom out",EMBED_PREVIEW_ZOOM_IN:"Zoom in",EMBED_PREVIEW_FIT:"Fit preview",EMBED_PREVIEW_CLOSE:"Close preview",EMBED_PREVIEW_PAN:"Drawing preview. Drag to pan. Use + or - to zoom, 0 to fit, or Escape to close.",EMBED_PREVIEW_LOADING:"Loading preview…",EMBED_PREVIEW_FAILED:"Could not load this drawing preview.",CLI_HELP:"Show CLI and agent instructions",CLI_COPY_SKILL:"Copy agent instructions",CLI_AGENT_INSTRUCTIONS:`Read: ${T.GITHUB_COM_ZSVICZIAN_OBSIDIAN_EXCALIDRAW_CLI}\n\n<<user instructions>>`,CLI_DESCRIPTION:"Native Excalidraw CLI",CLI_COPY_SELECTION:"Copy selected elements for agent",CLI_COPY_SELECTION_ERROR:"Could not copy the selected elements. Select fewer elements and try again.",INITIALIZATION_MESSAGE:"Excalidraw is waiting for Obsidian to initialize all of your plugins...",SELECT_FILE_TO_INSERT:"Select a file to insert",ERROR_INITIALIZING_EA:"Error initializing Excalidraw Automate",SETTINGS_DATA_INVALID:"Excalidraw is waiting for a valid replacement data.json. Setting changes will not be saved until that file is restored, or you restart Obsidian and choose Reset to defaults.",SETTINGS_DATA_REPAIRED_FROM_MEMORY:"An empty or unreadable Excalidraw settings file was received and rejected. The active settings were written back to repair data.json.",SETTINGS_DATA_RECOVERED:"Excalidraw data.json was empty or unreadable. The last known good settings were restored automatically.",SETTINGS_RECOVERY_MISSING_TITLE:"Excalidraw settings file is missing",SETTINGS_RECOVERY_MISSING_DESC:"A last known good settings backup exists on this device. Restore that backup, or reset Excalidraw to factory defaults. Closing this message restores the backup.",SETTINGS_RECOVERY_CORRUPT_TITLE:"Excalidraw settings file is corrupted",SETTINGS_RECOVERY_CORRUPT_DESC:"The settings file is empty or unreadable, and no recovery backup is available on this device. Reset Excalidraw to factory defaults, or leave the file unchanged while you restore a valid data.json from another source. Closing this message waits for a replacement file.",SETTINGS_RECOVERY_RESTORE_BACKUP:"Restore backup",SETTINGS_RECOVERY_RESET_DEFAULTS:"Reset to defaults",SETTINGS_RECOVERY_WAIT_FOR_FILE:"Wait for restored file",CONVERT_URL_TO_FILE:"Save image from URL to local file",UNZIP_CURRENT_FILE:"Decompress current Excalidraw file",PUBLI