+            '# メモ',
+            '```step',
+            'path: 01_data/2026/10/06/CBES (50kg to 2000kg).step',
+            'width: 645',
+            'annotations:',
+            '  - id: a1',
+            '    text: "path: これは注記"',
+            '```',
+        ].join('\n');
+        assert.deepStrictEqual(extractCadCodeBlockPaths(text), ['01_data/2026/10/06/CBES (50kg to 2000kg).step']);
+    });
+
+    test('```cad、引用符・[[ ]] 付き、キーの無い1行目のパスも読む', () => {
+        const text = [
+            '```cad',
+            "path: '[[model.stl]]'",
+            '```',
+            '~~~step',
+            'part.stp',
+            'height: 400',
+            '~~~',
+        ].join('\n');
+        assert.deepStrictEqual(extractCadCodeBlockPaths(text), ['model.stl', 'part.stp']);
+    });
+
+    test('他の言語のコードブロックと、その中の ```step 風の行は対象外', () => {
+        const text = [
+            '````md',
+            '```step',
+            'path: inside.step',
+            '```',
+            '````',
+            '```yaml',
+            'path: other.step',
+            '```',
+        ].join('\n');
+        assert.deepStrictEqual(extractCadCodeBlockPaths(text), []);
+    });
+
+    test('path の無いブロックでは、注記やカメラの入れ子の値をパスと取り違えない', () => {
+        const text = [
+            '```step',
+            'camera:',
+            '  position:',
+            '    - -22.85',
+            'annotations:',
+            '  - path: nested.step',
+            '```',
+        ].join('\\n');
+        assert.deepStrictEqual(extractCadCodeBlockPaths(text), []);
+    });
+
+    test('同じファイルを複数回呼び出しても1件にまとめる', () => {
+        const block = '```step\npath: a.step\n```';
+        assert.deepStrictEqual(extractCadCodeBlockPaths(`${block}\n\n${block}`), ['a.step']);
+    });
+
+    const files: Record<string, { path: string; extension: string }> = {
+        'models/a.step': { path: 'models/a.step', extension: 'step' },
+        'models/b.stp': { path: 'models/b.stp', extension: 'stp' },
+    };
+    const metadataCache = {
+        getFirstLinkpathDest: (linktext: string) => linktext === 'a' ? files['models/a.step'] : null,
+    };
+    const getFileByPath = (path: string) => files[path] ?? null;
+
+    test('リンクとして解決できないパスは Vault のパスとして探す', () => {
+        assert.strictEqual(resolveCadCodeBlockPath(metadataCache, getFileByPath, 'a', 'note.md')?.path, 'models/a.step');
+        assert.strictEqual(resolveCadCodeBlockPath(metadataCache, getFileByPath, 'models/b.stp', 'note.md')?.path, 'models/b.stp');
+        assert.strictEqual(resolveCadCodeBlockPath(metadataCache, getFileByPath, 'missing.step', 'note.md'), null);
+    });
+
+    test('STEP を呼び出しているノートを逆向きに探す', () => {
+        const index = new Map<string, string[]>([
+            ['note1.md', ['models/a.step']],
+            ['note2.md', ['a', 'models/b.stp']],
+            ['note3.md', ['models/b.stp']],
+        ]);
+        assert.deepStrictEqual(
+            getCadCodeBlockBacklinkPaths(index, metadataCache, getFileByPath, 'models/a.step'),
+            ['note1.md', 'note2.md'],
+        );
+    });
+});
