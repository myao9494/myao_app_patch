uC0C1\uD55C\uC744 \uC5C6\uC560\uB824\uBA74 0\uC744 \uC785\uB825\uD558\uC138\uC694."},sessionIdleTimeout:{name:"\uC720\uD734 \uD504\uB85C\uC138\uC2A4 \uC81C\uD55C \uC2DC\uAC04",desc:"\uC2E4\uD589 \uC911\uC778 \uD134\uC774 \uC5C6\uB294 \uB300\uD654\uAC00 \uACF5\uAE09\uC790 \uD504\uB85C\uC138\uC2A4\uB97C \uC720\uC9C0\uD558\uB294 \uC2DC\uAC04(\uBD84)\uC785\uB2C8\uB2E4. \uC774 \uC2DC\uAC04\uC774 \uC9C0\uB098\uBA74 Grimoire\uAC00 \uD504\uB85C\uC138\uC2A4\uB97C \uD574\uC81C\uD569\uB2C8\uB2E4. \uB300\uD654\uB294 \uC720\uC9C0\uB418\uACE0 \uB2E4\uC74C \uD134\uC5D0\uC11C \uC7AC\uAC1C\uB418\uBBC0\uB85C \uCF5C\uB4DC \uC2A4\uD0C0\uD2B8 \uD55C \uBC88\uC758 \uBE44\uC6A9\uB9CC \uB4ED\uB2C8\uB2E4. \uD0ED\uC774 \uC5F4\uB824 \uC788\uB294 \uB3D9\uC548 \uD504\uB85C\uC138\uC2A4\uB97C \uC720\uC9C0\uD558\uB824\uBA74 0\uC744 \uC785\uB825\uD558\uC138\uC694."},navMappings:{name:"Vim \uC2A4\uD0C0\uC77C \uB124\uBE44\uAC8C\uC774\uC158 \uB9E4\uD551",desc:'\uD55C \uC904\uC5D0 \uD558\uB098\uC758 \uB9E4\uD551. \uD615\uC2DD: "map <\uD0A4> <\uB3D9\uC791>" (\uB3D9\uC791: scrollUp, scrollDown, focusInput).'},requireCommandOrControlEnterToSend:{name:"\uBC84\uD2BC\uC73C\uB85C\uB9CC \uBCF4\uB0B4\uAE30",desc:"\uD65C\uC131\uD654\uD558\uBA74 Enter\uC640 Command/Ctrl+Enter\uB294 \uBCF4\uB0B4\uC9C0 \uC54A\uACE0 \uC904\uBC14\uAFC8\uC744 \uC0BD\uC785\uD569\uB2C8\uB2E4. \uBCF4\uB0B4\uB824\uBA74 Send \uBC84\uD2BC\uC744 \uC0AC\uC6A9\uD558\uC138\uC694."},theme:{name:"\uD14C\uB9C8",followsObsidian:"Obsidian\uC744 \uB530\uB984"},usageIndicators:{name:"\uC0AC\uC6A9\uB7C9 \uD45C\uC2DC\uAE30",desc:"\uBAA8\uB378 \uC120\uD0DD\uAE30 \uC606\uACFC \uBAA8\uB378 \uBA54\uB274 \uC548\uC5D0 \uC694\uAE08\uC81C \uC0AC\uC6A9\uB7C9 \uBC0F API \uC9C0\uCD9C \uD45C\uC2DC\uAE30\uB97C \uBCF4\uC5EC \uC90D\uB2C8\uB2E4."},debugLogging:{name:"\uB514\uBC84\uADF8 \uB85C\uAE45",desc:"\uD65C\uC131\uD654\uB41C \uB3D9\uC548\uC5D0\uB9CC \uC815\uB9AC\uB41C \uAE30\uC220 \uB85C\uADF8\uB97C .grimoire/logs/YYYY-MM-DD.jsonl\uC5D0 \uC501\uB2C8\uB2E4. \uD504\u