@@ -280,6 +306,54 @@ const handleMiddleMouseDown = (e) => {
 registerDocumentListener("_customMiddleButtonPanListener", "mousedown", handleMiddleMouseDown);
 console.log("Global Middle-click Pan listener registered for Mindmap");
 
+/**
+ * 日本語IMEの変換を確定する Enter を、MarkMind に渡さない。
+ * MarkMind は Enter（keydown と keyup）で「編集を終えて次の兄弟ノードを作る」ため、確定の Enter でも
+ * 編集が終わってしまう。変換の途中でノードが入れ替わると、IME の状態が編集中の要素から外れ、
+ * 次の入力が候補ウィンドウだけ（画面左上）に出て、ノートへ入らなくなる。
+ * 確定の Enter は IME だけに任せ、次の Enter で従来どおり編集を終える。
+ **/
+const MINDMAP_CONTAINER_SELECTOR =
+    ".mm-app-container, .markmind-container, .cm-mindmap-container, .cm-mindmap, .mindmapview, [data-type='mindmapview']";
+const IME_COMPOSITION_END_WINDOW_MS = 50;
+let lastCompositionEndAt = 0;
+let imeEnterKeydownSwallowed = false;
+
+const isMindmapEditingTarget = (target) =>
+    target instanceof Element &&
+    !!target.closest(MINDMAP_CONTAINER_SELECTOR) &&
+    !!target.closest("[contenteditable='true']");
+
+const handleMindmapImeEnter = (e) => {
+    if (e.key !== "Enter" && e.keyCode !== 229 && e.keyCode !== 13) return;
+    if (!isMindmapEditingTarget(e.target)) return;
+
+    if (e.type === "keydown") {
+        // 変換中の Enter は isComposing か keyCode 229。Safari 系は変換終了後に keydown が来るため、
+        // 直前に変換が終わっていたか（compositionend の記録）も見る。
+        const justComposed = Date.now() - lastCompositionEndAt < IME_COMPOSITION_END_WINDOW_MS;
+        if (!e.isComposing && e.keyCode !== 229 && !justComposed) {
+            imeEnterKeydownSwallowed = false;
+            return;
+        }
+        imeEnterKeydownSwallowed = true;
+        e.stopImmediatePropagation();
+        return;
+    }
+    // keyup: keydown を止めた Enter を離したときも、MarkMind が編集を終えたり次のノードを作ったりしない。
+    if (imeEnterKeydownSwallowed) {
+        imeEnterKeydownSwallowed = false;
+        e.stopImmediatePropagation();
+    }
+};
+
+const handleMindmapCompositionEnd = (e) => {
+    if (isMindmapEditingTarget(e.target)) lastCompositionEndAt = Date.now();
+};
+
+registerDocumentListener("_customMindmapImeEnterListener", ["keydown", "keyup"], handleMindmapImeEnter);
+registerDocumentListener("_customMindmapCompositionEndListener", "compositionend", handleMindmapCompositionEnd);
+
 /**
  * Excalidraw埋め込み時にMarkMindが二重描画して競合するのを防止するパッチ
  **/
@@ -320,6 +394,10 @@ patchMarkMindPostProcessor();
