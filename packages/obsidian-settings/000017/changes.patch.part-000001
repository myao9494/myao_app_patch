 ]);
 
+// CAD Viewer のコードブロック（```step / ```cad）の言語名
+const CAD_CODE_BLOCK_LANGUAGES = new Set(['step', 'cad']);
+
 const IMAGE_EXTENSIONS = new Set([
     'png',
     'jpg',
@@ -254,6 +263,113 @@ export function collectLinkedFiles(
     return { markdownFiles, attachmentFiles };
 }
 
+function stripCadPathValue(value: string): string {
+    let path = value.trim();
+    const quoted = path.match(/^(['"])(.*)\1$/);
+    if (quoted) {
+        path = quoted[2];
+    }
+    return path.replace(/^\[\[/, '').replace(/\]\]$/, '').trim();
+}
+
+/**
+ * ノート本文から CAD Viewer のコードブロック（```step / ```cad）が表示するファイルのパスを取り出す。
+ * コードブロックはリンクではないため metadataCache の links / embeds に載らず、関連ファイルに出すにはこれで補う。
+ * パスの読み方は CAD Viewer の parseStepCodeBlock に合わせる（`path:` の行、無ければキーの無い最初の行）。
+ */
+export function extractCadCodeBlockPaths(text: string): string[] {
+    const paths: string[] = [];
+    let fence: { char: string; length: number; isCad: boolean; lines: string[] } | null = null;
+
+    const finishBlock = (lines: string[]) => {
+        let path = '';
+        for (const line of lines) {
+            // 注記などの入れ子のキーと取り違えないよう、字下げの無い行だけを見る
+            const match = line.match(/^path\s*:\s*(.+)$/i);
+            if (match) {
+                path = stripCadPathValue(match[1]);
+                break;
+            }
+        }
+        if (!path) {
+            const bareLine = lines.find(line => /^[^\s#-]/.test(line) && !/^[\w-]+\s*:/.test(line));
+            path = bareLine ? stripCadPathValue(bareLine) : '';
+        }
+        if (path && !paths.includes(path)) {
+            paths.push(path);
+        }
+    };
+
+    for (const line of text.split(/\r?\n/)) {
+        if (!fence) {
+            const open = line.match(/^\s*(`{3,}|~{3,})\s*([\w-]*)/);
+            if (open) {
+                fence = {
+                    char: open[1][0],
+                    length: open[1].length,
+                    isCad: CAD_CODE_BLOCK_LANGUAGES.has(open[2].toLowerCase()),
+                    lines: [],
+                };
+            }
+            continue;
+        }
+
+        const close = line.trim().match(/^(`{3,}|~{3,})$/);
+        if (close && close[1][0] === fence.char && close[1].length >= fence.length) {
+            if (fence.isCad) {
+                finishBlock(fence.lines);
+            }
+            fence = null;
+            continue;
+        }
+
+        if (fence.isCad) {
+            fence.lines.push(line);
+        }
+    }
+
+    return paths;
+}
+
+/**
+ * CAD Viewer のコードブロックに書かれたパスを実ファイルへ解決する（CAD Viewer の resolveFile と同じ順序）。
+ */
+export function resolveCadCodeBlockPath(
+    metadataCache: any,
+    getFileByPath: (path: string) => { path: string; extension: string } | null,
+    linktext: string,
+    sourcePath: string,
+): { path: string; extension: string } | null {
+    const dest = metadataCache.getFirstLinkpathDest?.(linktext, sourcePath);
+    if (dest) {
+        return dest;
+    }
+    return getFileByPath(linktext);
+}
+
+/**
+ * CAD Viewer のコードブロックで targetPath のファイルを表示しているノートのパスを返す。
+ * cadPathsBySource はノートのパスから、そのノートのコードブロックに書かれたパスへの対応。
+ */
+export function getCadCodeBlockBacklinkPaths(
+    cadPathsBySource: Map<string, string[]>,
+    metadataCache: any,
+    getFileByPath: (path: string) => { path: string; extension: string } | null,
+    targetPath: string,
+): string[] {
+    const sources: string[] = [];
+    for (const [sourcePath, linktexts] of cadPathsBySource) {
+        if (sourcePath === targetPath) continue;
+        const refersToTarget = linktexts.some(linktext =>
+            resolveCadCodeBlockPath(metadataCache, getFileByPath, linktext, sourcePath)?.path === targetPath
+        );
+        if (refersToTarget) {
+            sources.push(sourcePath);
+        }
+    }
+    return sources;
+}
+
 /**
  * ファイルの拡張子や名前に応じて、ドラッグ＆ドロップ用（エディタ挿入用）のテキストを生成する
  */
