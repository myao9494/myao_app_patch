+    );
+    if (!existingSearchKey || String((_c = cachedFrontmatter[existingSearchKey]) != null ? _c : "") !== query) {
+      if (!shouldContinue()) return { status: "cancelled" };
+      await app.fileManager.processFrontMatter(file, (frontmatter) => {
+        const frontmatterKey = Object.keys(frontmatter).find(
+          (key) => key.toLowerCase().replace(/\s+/g, "") === "searchquery"
+        );
+        frontmatter[frontmatterKey || "Search Query"] = query;
+      });
+    }
+    if (!shouldContinue()) return { status: "cancelled" };
+    const originalFileContent = await app.vault.read(file);
+    const fileContent = (_d = replaceNoteListSection(originalFileContent, noteListContent)) != null ? _d : insertNoteListAfterFrontmatter(originalFileContent, noteListContent);
+    if (fileContent !== originalFileContent) {
+      if (!shouldContinue()) return { status: "cancelled" };
+      await app.vault.modify(file, fileContent);
+    }
+    return { status: "updated", matchCount: matches.length };
+  } catch (error) {
+    return { status: "error", error };
