diff --git a/.obsidian/snippets/excalidraw-embed-width.css b/.obsidian/snippets/excalidraw-embed-width.css
index a11c60d8779af786e69305414a2233f0713d12d2..bfa7131d03d74cbce8f058206a274e1ccf9a4b9c 100644
--- a/.obsidian/snippets/excalidraw-embed-width.css
+++ b/.obsidian/snippets/excalidraw-embed-width.css
@@ -202,3 +202,59 @@ iframe[src*="Excalidraw"] {
 .excalidraw-svg[data-figure-kind="excalidraw"] :is(img, svg, canvas) {
     min-width: 50px;
 }
+
+/* PDF埋め込みのドラッグリサイズ（右端: 幅、下端: 高さ、右下隅: 幅と高さ）
+   幅はスクリプトが埋め込み要素へ px で当てる。狭いペインでははみ出さないよう親の幅までに抑える。 */
+.markdown-source-view .internal-embed.pdf-embed,
+.markdown-preview-view .internal-embed.pdf-embed {
+    max-width: 100%;
+}
+
+.custom-pdf-resizer-handle {
+    position: absolute !important;
+    z-index: 100;
+    opacity: 0;
+    transition: opacity 0.15s ease;
+    box-sizing: border-box;
+    user-select: none;
+    -webkit-user-drag: none;
+}
+
+/* 右上のツールバーのボタンと、右下隅のハンドルには重ねない */
+.custom-pdf-resizer-handle.mod-right {
+    top: 44px;
+    right: 0;
+    bottom: 16px;
+    width: 6px;
+    cursor: ew-resize !important;
+    border-right: 3px solid var(--interactive-accent);
+}
+
+.custom-pdf-resizer-handle.mod-bottom {
+    left: 0;
+    right: 16px;
+    bottom: 0;
+    height: 6px;
+    cursor: ns-resize !important;
+    border-bottom: 3px solid var(--interactive-accent);
+}
+
+.custom-pdf-resizer-handle.mod-corner {
+    right: 0;
+    bottom: 0;
+    width: 16px;
+    height: 16px;
+    cursor: nwse-resize !important;
+    border-right: 3px solid var(--interactive-accent);
+    border-bottom: 3px solid var(--interactive-accent);
+    border-radius: 0 0 3px 0;
+}
+
+.internal-embed.pdf-embed:hover > .custom-pdf-resizer-handle {
+    opacity: 0.5;
+}
+
+.custom-pdf-resizer-handle:hover,
+.internal-embed.pdf-embed.is-pdf-resizing > .custom-pdf-resizer-handle {
+    opacity: 1 !important;
+}
