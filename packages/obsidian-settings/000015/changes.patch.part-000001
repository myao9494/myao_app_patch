 export const NOTE_LIST_MARKER_START = "<!-- custom-note-list:start -->";
@@ -28,3 +29,169 @@ export function replaceNoteListSection(fileContent: string, noteListContent: str
 
     return null;
 }
+
+/** ノート一覧の1行分のデータ */
+export interface NoteListRow {
+    path: string;
+    name: string;
+    tags: string[];
+    excerpt: string;
+    ctime: string;
+    mtime: string;
+}
+
+/** タグ検索・ノート一覧の対象パスか。対象フォルダが空なら Vault 全体（node_modules 配下は除く）。 */
+export function isTagTargetPath(path: string, targetFolders: string[]): boolean {
+    if (path.includes("/node_modules/") || path.startsWith("node_modules/")) return false;
+    return targetFolders.length === 0 || targetFolders.some(folder => path === folder || path.startsWith(`${folder}/`));
+}
+
+/** 「冒頭」列に出す本文の抜粋（先頭100文字）。フロントマター・一覧自身・埋め込み・リンク記法を除く。 */
+export function extractNoteExcerpt(content: string): string {
+    let clean = content;
+    // YAMLフロントマターを除去
+    clean = clean.replace(/^---\r?\n[\s\S]*?\r?\n---\r?\n?/, "");
+    // # note一覧 セクションを除去 (次の大見出し # まで、またはファイルの終わりまで)
+    clean = clean.replace(/#\s+note一覧[\s\S]*?(?=\n#\s|$)/i, "");
+
+    return clean
+        .replace(/!\[\[[^\]]*\]\]/g, "")
+        .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
+        .replace(/<img\b[^>]*>/gi, "")
+        .replace(/\[\[([^\]|]+)\|([^\]]+)\]\]/g, "$2")
+        .replace(/\[\[([^\]]+)\]\]/g, "$1")
+        .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
+        .replace(/<[^>]+>/g, " ")
+        .replace(/\s+/g, " ")
+        .trim()
+        .slice(0, 100)
+        .replace(/#/g, "\\#");
+}
+
+/** タグを「#タグ」の形にそろえ、大文字小文字の違いだけの重複を1つにまとめる（最初の表記を残す）。 */
+export function uniqueNoteListTags(rawTags: string[]): string[] {
+    const seen = new Set<string>();
+    const uniqueTags: string[] = [];
+    for (const t of rawTags) {
+        const clean = t.startsWith("#") ? t.substring(1) : t;
+        const normalized = "#" + clean.trim();
+        const lower = normalized.toLowerCase();
+        if (!seen.has(lower)) {
+            seen.add(lower);
+            uniqueTags.push(normalized);
+        }
+    }
+    return uniqueTags;
+}
+
+/** 作成日・編集日の表示（ローカル時刻の YYYY-MM-DD HH:mm） */
+export function formatNoteListDate(timestamp: number): string {
+    const date = new Date(timestamp);
+    const pad = (value: number) => String(value).padStart(2, "0");
+    return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}`;
+}
+
+/**
+ * ノートへ書き込む「# note一覧」セクション（検索ボックス付きの DataviewJS ブロック）を組み立てる。
+ * ※ 出力はノートに保存される。1文字でも変えると、一覧を持つ全ノートが次回の自動更新で書き換わる。
+ */
+export function buildNoteListContent(rows: NoteListRow[]): string {
+    const noteListData = JSON.stringify(rows);
+    return `# note一覧
+${NOTE_LIST_MARKER_START}
+
+\`\`\`dataviewjs
+// Sidebar Explorer Tagの更新後も、検索ボックスを含む表を再生成する。
+const noteListRows = ${noteListData};
+const sourcePath = dv.current().file.path;
+const searchInput = dv.el("input", "", {
+    attr: {
+        type: "search",
+        placeholder: "ノート名で検索…",
+        "aria-label": "ノート名で検索"
+    }
+});
+searchInput.style.marginBottom = "0.75em";
+searchInput.style.width = "min(100%, 28em)";
+
+const tableContainer = dv.el("div", "");
+const renderNoteList = () => {
+    const keywords = searchInput.value.trim().toLocaleLowerCase()
+        .split(/[\\s\\u3000]+/).filter(Boolean);
+    const filteredRows = noteListRows.filter(row => {
+        const name = row.name.toLocaleLowerCase();
+        return keywords.every(keyword => name.includes(keyword));
+    });
+
+    tableContainer.empty();
+    const table = tableContainer.createEl("table", { cls: "dataview table-view-table" });
+    const headerRow = table.createEl("thead").createEl("tr");
+    ["名称", "タグ", "冒頭", "作成日", "編集日"].forEach(title => headerRow.createEl("th", { text: title }));
+    const body = table.createEl("tbody");
+
+    if (filteredRows.length === 0) {
+        const row = body.createEl("tr");
+        row.createEl("td", { text: "該当するノートがありません", attr: { colspan: "5" } });
+        return;
+    }
+
+    filteredRows.forEach(rowData => {
+        const row = body.createEl("tr");
+        const nameCell = row.createEl("td");
+        const linkButton = nameCell.createEl("button", { text: rowData.name });
+        linkButton.type = "button";
+        linkButton.style.cssText = "padding:0;border:0;background:transparent;color:var(--link-color);cursor:pointer;text-decoration:var(--link-decoration);font:inherit;text-align:left;";
+        linkButton.addEventListener("click", event => {
+            event.preventDefault();
+            event.stopImmediatePropagation();
+            const targetFile = app.vault.getAbstractFileByPath(rowData.path);
+            if (targetFile && typeof window._openNoteListLinkInRightPane === "function") {
+                void window._openNoteListLinkInRightPane(targetFile, sourcePath);
+            } else if (targetFile) {
+                const targetLeaf = app.workspace.getLeaf("split", "vertical");
+                if (targetLeaf) void targetLeaf.openFile(targetFile, { active: true });
+            }
+        });
+        const tagCell = row.createEl("td");
+        (Array.isArray(rowData.tags) ? rowData.tags : String(rowData.tags || "").split(/\\s+/))
+            .filter(Boolean)
+            .forEach(tag => {
+                const tagName = String(tag).replace(/^#/, "");
+                const tagLink = tagCell.createEl("a", {
+                    cls: "tag",
+                    text: "#" + tagName,
+                    attr: { href: "#" + tagName, "data-href": tagName }
+                });
+                tagLink.style.marginRight = "0.35em";
+            });
+        row.createEl("td", { text: rowData.excerpt });
+        row.createEl("td", { text: rowData.ctime });
+        row.createEl("td", { text: rowData.mtime });
+    });
+};
+
+searchInput.addEventListener("input", renderNoteList);
+renderNoteList();
+\`\`\`
+
+${NOTE_LIST_MARKER_END}
+`;
+}
+
+/** 一覧がまだ無いノートへ、フロントマターの直後（無ければ先頭）に一覧を挿入する。 */
+export function insertNoteListAfterFrontmatter(fileContent: string, noteListContent: string): string {
+    const hasFrontmatter = fileContent.startsWith("---\n") || fileContent.startsWith("---\r\n");
+    let insertIndex = 0;
+    if (hasFrontmatter) {
+        const secondTripleDash = fileContent.indexOf("\n---", 3);
+        if (secondTripleDash !== -1) {
+            const endOfLine = fileContent.indexOf("\n", secondTripleDash + 4);
+            if (endOfLine !== -1) {
+                insertIndex = endOfLine + 1;
+            } else {
+                insertIndex = secondTripleDash + 4;
+            }
+        }
+    }
+    return fileContent.slice(0, insertIndex) + noteListContent + "\n" + fileContent.slice(insertIndex);
+}
diff --git a/.obsidian/plugins/obsidian-sidebar-explorer-tag/noteListUpdater.test.ts b/.obsidian/plugins/obsidian-sidebar-explorer-tag/noteListUpdater.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..898d62d6aa435b21d8cc960a7cacb4408148cbf0
--- /dev/null
+++ b/.obsidian/plugins/obsidian-sidebar-explorer-tag/noteListUpdater.test.ts
@@ -0,0 +1,155 @@
+/**
+ * 仕様: ノートの「# note一覧」の追加・更新（noteListUpdater.ts）のテスト
+ * 1. 対象フォルダ外のノート（10_summary のサマリーなど）は、タグが合っても一覧に載せないこと
+ * 2. 本文タグは設定「本文のタグを有効にする」がオフなら判定に使わないこと
+ * 3. topタグ付きノートは除外条件を免除し、書き込み先のノート自身は載せないこと
+ * 4. Search Query を設定し、一覧が無ければフロントマターの直後へ挿入すること
+ * 5. 内容に差分が無ければ書き込まないこと
+ * 6. shouldContinue が false なら書き込まずに中断すること
+ * 7. 検索条件が空・Markdown 以外は何もしないこと
+ * 8. 検索条件の先頭の # は判定のときだけ取り除くこと
+ */
+import { describe, it } from "node:test";
+import { strict as assert } from "node:assert";
+import { findNoteListFiles, stripTagHashes, updateNoteListForFile } from "./noteListUpdater";
+
+type FakeFile = { path: string; name: string; basename: string; extension: string; stat: { ctime: number; mtime: number } };
+
+const makeFile = (path: string, mtime = 0): FakeFile => {
+    const name = path.split("/").pop()!;
+    return { path, name, basename: name.replace(/\.md$/, ""), extension: "md", stat: { ctime: 0, mtime } };
+};
+
+const makeApp = (entries: { file: FakeFile; frontmatter?: Record<string, unknown>; bodyTags?: string[]; content?: string }[]) => {
+    const contents = new Map(entries.map(e => [e.file.path, e.content ?? ""]));
+    const frontmatters = new Map(entries.map(e => [e.file.path, e.frontmatter]));
+    const writes: string[] = [];
+    const app = {
+        vault: {
+            getMarkdownFiles: () => entries.map(e => e.file),
+            cachedRead: async (file: FakeFile) => contents.get(file.path) ?? "",
+            read: async (file: FakeFile) => contents.get(file.path) ?? "",
+            modify: async (file: FakeFile, data: string) => { writes.push(file.path); contents.set(file.path, data); },
+        },
+        metadataCache: {
+            getFileCache: (file: FakeFile) => {
+                const entry = entries.find(e => e.file.path === file.path);
+                return {
+                    frontmatter: frontmatters.get(file.path),
+                    tags: (entry?.bodyTags ?? []).map(tag => ({ tag })),
+                };
+            },
+        },
+        fileManager: {
+            processFrontMatter: async (file: FakeFile, fn: (fm: Record<string, unknown>) => void) => {
+                const fm = { ...(frontmatters.get(file.path) ?? {}) };
+                fn(fm);
+                frontmatters.set(file.path, fm);
+            },
+        },
+    };
+    return { app: app as any, contents, frontmatters, writes };
+};
+
+const scope = { tagTargetFolders: ["01_data", "02_MOC"], enableBodyTags: false };
+
+describe("findNoteListFiles", () => {
+    const top = makeFile("02_MOC/project_top.md");
+    const note = makeFile("01_data/2026/10/a.md", 2);
+    const older = makeFile("01_data/2026/09/b.md", 1);
+    const summary = makeFile("10_summary/project_summary.md", 3);
+    const bodyOnly = makeFile("01_data/2026/10/c.md");
+    const otherTop = makeFile("02_MOC/other_top.md");
+    const { app } = makeApp([
+        { file: top, frontmatter: { tags: ["project", "top"] } },
+        { file: note, frontmatter: { tags: ["project"] } },
+        { file: older, frontmatter: { tags: ["project"] } },
+        { file: summary, frontmatter: { tags: ["project"] } },
+        { file: bodyOnly, bodyTags: ["#project"] },
+        { file: otherTop, frontmatter: { tags: ["project", "top", "done"] } },
+    ]);
+
+    it("1. 対象フォルダ外のサマリーは載せず、更新日時の降順に並べること", () => {
+        const paths = findNoteListFiles(app, scope, "project -done", top as any).map(f => f.path);
+        assert.ok(!paths.includes(summary.path), "10_summary のサマリーは載せない");
+        assert.deepEqual(paths.slice(0, 2), [note.path, older.path]);
+    });
+
+    it("2. 本文タグは設定がオフなら使わず、オンなら使うこと", () => {
+        assert.ok(!findNoteListFiles(app, scope, "project", top as any).some(f => f.path === bodyOnly.path));
+        assert.ok(findNoteListFiles(app, { ...scope, enableBodyTags: true }, "project", top as any).some(f => f.path === bodyOnly.path));
+    });
+
+    it("3. topタグ付きノートは除外条件を免除し、書き込み先自身は載せないこと", () => {
+        const paths = findNoteListFiles(app, scope, "project -done", top as any).map(f => f.path);
+        assert.ok(paths.includes(otherTop.path));
+        assert.ok(!paths.includes(top.path));
+    });
+});
+
+describe("updateNoteListForFile", () => {
+    it("4. Search Query を設定し、フロントマターの直後へ一覧を挿入すること", async () => {
+        const top = makeFile("02_MOC/project_top.md");
+        const note = makeFile("01_data/a.md");
+        const summary = makeFile("10_summary/project_summary.md");
+        const { app, contents, frontmatters } = makeApp([
+            { file: top, frontmatter: { tags: ["top"] }, content: "---\ntags: [top]\n---\n本文\n" },
+            { file: note, frontmatter: { tags: ["project"] }, content: "ノートA" },
+            { file: summary, frontmatter: { tags: ["project"] }, content: "サマリー" },
+        ]);
+
+        const result = await updateNoteListForFile(app, scope, top as any, " project ");
+        assert.deepEqual(result, { status: "updated", matchCount: 1 });
+        assert.equal(frontmatters.get(top.path)?.["Search Query"], "project");
+        const written = contents.get(top.path)!;
+        assert.ok(written.startsWith("---\ntags: [top]\n---\n# note一覧\n"));
+        assert.ok(written.includes('"path":"01_data/a.md"'));
+        assert.ok(!written.includes("project_summary"), "サマリーは一覧に入らない");
+        assert.ok(written.endsWith("本文\n"));
+    });
+
+    it("5. 内容に差分が無ければ書き込まないこと", async () => {
+        const top = makeFile("02_MOC/project_top.md");
+        const note = makeFile("01_data/a.md");
+        const { app, writes } = makeApp([
+            { file: top, frontmatter: { tags: ["top"], "Search Query": "project" }, content: "本文\n" },
+            { file: note, frontmatter: { tags: ["project"] }, content: "ノートA" },
+        ]);
+        await updateNoteListForFile(app, scope, top as any, "project");
+        await updateNoteListForFile(app, scope, top as any, "project");
+        assert.deepEqual(writes, [top.path]);
+    });
+
+    it("6. shouldContinue が false なら書き込まずに中断すること", async () => {
+        const top = makeFile("02_MOC/project_top.md");
+        const { app, writes, frontmatters } = makeApp([{ file: top, frontmatter: { tags: ["top"] }, content: "本文\n" }]);
+        const result = await updateNoteListForFile(app, scope, top as any, "project", { shouldContinue: () => false });
+        assert.deepEqual(result, { status: "cancelled" });
+        assert.deepEqual(writes, []);
+        assert.equal(frontmatters.get(top.path)?.["Search Query"], undefined);
+    });
+
+    it("7. 検索条件が空・Markdown 以外は何もしないこと", async () => {
+        const top = makeFile("02_MOC/project_top.md");
+        const drawing = makeFile("02_MOC/図.excalidraw.md");
+        const { app, writes } = makeApp([{ file: top }, { file: drawing }]);
+        assert.deepEqual(await updateNoteListForFile(app, scope, top as any, "  "), { status: "empty-query" });
+        assert.deepEqual(await updateNoteListForFile(app, scope, drawing as any, "project"), { status: "not-markdown" });
+        assert.deepEqual(await updateNoteListForFile(app, scope, null, "project"), { status: "not-markdown" });
+        assert.deepEqual(writes, []);
+    });
+});
+
+describe("stripTagHashes", () => {
+    it("8. 検索条件の先頭の # は判定のときだけ取り除くこと", async () => {
+        assert.equal(stripTagHashes("#todo  -#done　#a#b"), "todo -done a#b");
+        const top = makeFile("02_MOC/todo_top.md");
+        const note = makeFile("01_data/a.md");
+        const { app, frontmatters } = makeApp([
+            { file: top, content: "本文\n" },
+            { file: note, frontmatter: { tags: ["todo"] } },
+        ]);
+        assert.deepEqual(await updateNoteListForFile(app, scope, top as any, "#todo"), { status: "updated", matchCount: 1 });
+        assert.equal(frontmatters.get(top.path)?.["Search Query"], "#todo");
+    });
+});
diff --git a/.obsidian/plugins/obsidian-sidebar-explorer-tag/noteListUpdater.ts b/.obsidian/plugins/obsidian-sidebar-explorer-tag/noteListUpdater.ts
new file mode 100644
index 0000000000000000000000000000000000000000..62293eaa5183fcf0a3f9943af9e14e1f6e41a53e
--- /dev/null
+++ b/.obsidian/plugins/obsidian-sidebar-explorer-tag/noteListUpdater.ts
@@ -0,0 +1,131 @@
+/**
+ * ノートの「# note一覧」の追加・更新
+ *
+ * 仕様:
+ * - 検索条件（Search Query）に合うノートを、設定「タグの対象フォルダ」（既定: 01_data, 02_MOC）の中から集める。
+ *   10_summary のサマリーなど、対象フォルダ外のノートは一覧に載せない。
+ * - タグの判定は tag_key の検索と同じ（設定「本文のタグを有効にする」に従う）。topタグ付きノートは除外条件（-tag）を免除する。
+ * - 一覧を書き込むノート自身は一覧に載せない。並び順は更新日時の降順。
+ * - タグの右クリックメニューから渡る「#todo」のような先頭の # は、判定のときだけ取り除く（Search Query には渡された値を保存する）。
+ * - ノートの Search Query プロパティを検索条件に合わせ、既存の「# note一覧」を置き換える（無ければフロントマターの直後へ挿入）。
+ * - 差分が無いときは書き込まない（他プラグインの再処理を起こさない）。
+ * - shouldContinue が false を返したら、書き込む前に中断する（タブを移動した後の自動更新など）。
+ * - サイドバーの「ノート一覧を追加」と、ノートを開いたときの自動更新（RegisterCustomCommands.md）の両方がこれを使う。
+ **/
+import type { App, TFile } from "obsidian";
+import { filterFilesByTagQuery, extractTagsFromMetadata } from "./utils";
+import {
+    buildNoteListContent,
+    extractNoteExcerpt,
+    formatNoteListDate,
+    insertNoteListAfterFrontmatter,
+    isTagTargetPath,
+    replaceNoteListSection,
+    uniqueNoteListTags,
+    type NoteListRow,
+} from "./noteListSection";
+
+export interface NoteListScope {
+    tagTargetFolders: string[];
+    enableBodyTags: boolean;
+}
+
+export interface NoteListUpdateOptions {
+    shouldContinue?: () => boolean;
+}
+
+export type NoteListUpdateResult =
+    | { status: "updated"; matchCount: number }
+    | { status: "empty-query" | "not-markdown" | "cancelled" }
+    | { status: "error"; error: unknown };
+
+export function isNoteListTargetFile(file: TFile | null | undefined): file is TFile {
+    return !!file && file.extension === "md" && !file.name.endsWith(".excalidraw.md");
+}
+
+/** 検索条件の各キーワードから先頭の # を取り除く（「-#tag」は「-tag」にする）。 */
+export function stripTagHashes(query: string): string {
+    return query.split(/[\s\u3000]+/)
+        .map(keyword => keyword.replace(/^(-?)#+/, "$1"))
+        .filter(keyword => keyword.length > 0)
+        .join(" ");
+}
+
+/** 一覧に載せるノート（書き込み先のノート自身を除く。更新日時の降順） */
+export function findNoteListFiles(app: App, scope: NoteListScope, query: string, targetFile: TFile): TFile[] {
+    const files = app.vault.getMarkdownFiles()
+        .filter(file => isTagTargetPath(file.path, scope.tagTargetFolders));
+    return filterFilesByTagQuery(files, stripTagHashes(query), (file) => {
+        const cache = app.metadataCache.getFileCache(file);
+        return extractTagsFromMetadata(cache, scope.enableBodyTags);
+    }, {
+        // MOC用のtopノートは、除外タグを持っていても一覧に残す。
+        includeTopTaggedExcluded: true,
+    }).filter(file => file.path !== targetFile.path);
+}
+
+async function buildNoteListRow(app: App, file: TFile): Promise<NoteListRow> {
+    const cache = app.metadataCache.getFileCache(file);
+    const content = await app.vault.cachedRead(file);
+    return {
+        path: file.path,
+        name: file.basename,
+        // note一覧のタグ列は、ノート上部のプロパティに設定したタグだけを表示する。
+        // 文字列にまとめず配列のまま渡し、DataviewJS 側で Obsidian のタグ要素として描画する。
+        tags: uniqueNoteListTags(extractTagsFromMetadata(cache, false)),
+        excerpt: extractNoteExcerpt(content),
+        ctime: formatNoteListDate(file.stat.ctime),
+        mtime: formatNoteListDate(file.stat.mtime),
+    };
+}
+
+export async function updateNoteListForFile(
+    app: App,
+    scope: NoteListScope,
+    file: TFile | null | undefined,
+    rawQuery: unknown,
+    options: NoteListUpdateOptions = {},
+): Promise<NoteListUpdateResult> {
+    const shouldContinue = options.shouldContinue ?? (() => true);
+    const query = String(rawQuery ?? "").trim();
+    if (!query) return { status: "empty-query" };
+    if (!isNoteListTargetFile(file)) return { status: "not-markdown" };
+    if (!shouldContinue()) return { status: "cancelled" };
+
+    const matches = findNoteListFiles(app, scope, query, file);
+    const rows = await Promise.all(matches.map(match => buildNoteListRow(app, match)));
+    if (!shouldContinue()) return { status: "cancelled" };
+    const noteListContent = buildNoteListContent(rows);
+
+    try {
+        const cachedFrontmatter = app.metadataCache.getFileCache(file)?.frontmatter || {};
+        const existingSearchKey = Object.keys(cachedFrontmatter).find(key =>
+            key.toLowerCase().replace(/\s+/g, "") === "searchquery"
+        );
+        // 同じ値を毎回書き戻すと他プラグインの再処理を起こすため、差分があるときだけ更新する。
+        if (!existingSearchKey || String(cachedFrontmatter[existingSearchKey] ?? "") !== query) {
+            if (!shouldContinue()) return { status: "cancelled" };
+            await app.fileManager.processFrontMatter(file, (frontmatter) => {
+                const frontmatterKey = Object.keys(frontmatter).find(key =>
+                    key.toLowerCase().replace(/\s+/g, "") === "searchquery"
+                );
+                frontmatter[frontmatterKey || "Search Query"] = query;
+            });
+        }
+
+        if (!shouldContinue()) return { status: "cancelled" };
+        const originalFileContent = await app.vault.read(file);
+        const fileContent = replaceNoteListSection(originalFileContent, noteListContent)
+            ?? insertNoteListAfterFrontmatter(originalFileContent, noteListContent);
+
+        if (fileContent !== originalFileContent) {
+            if (!shouldContinue()) return { status: "cancelled" };
+            // vault.modify による標準のファイル更新通知へ任せる。previewMode.rerender(true) を
+            // 併用すると Windows では Dataview の既存 DOM が残り、一覧が重複することがある。
+            await app.vault.modify(file, fileContent);
+        }
+        return { status: "updated", matchCount: matches.length };
+    } catch (error) {
+        return { status: "error", error };
+    }
+}
