+        assert.ok(content.startsWith(`# note一覧\n${NOTE_LIST_MARKER_START}\n`));
+        assert.ok(content.endsWith(`${NOTE_LIST_MARKER_END}\n`));
+        assert.ok(content.includes("```dataviewjs"));
