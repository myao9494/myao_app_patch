alla",conversations:"Conversaciones",content:"Contenido",input:"Entrada",diagnostics:"Diagn\xF3stico",setup:"Configuraci\xF3n",models:"Modelos",experimental:"Experimental",userName:{name:"\xBFC\xF3mo deber\xEDa Grimoire llamarte?",desc:"Tu nombre para saludos personalizados (dejar vac\xEDo para saludos gen\xE9ricos)"},excludedTags:{name:"Etiquetas excluidas",desc:"Las notas con estas etiquetas no se cargar\xE1n autom\xE1ticamente como contexto (una por l\xEDnea, sin #)"},excludedFolders:{name:"Carpetas excluidas",desc:"Las notas de estas carpetas de la b\xF3veda quedan excluidas del acceso del agente, salvo que se incluyan expl\xEDcitamente con @ (una ruta relativa a la b\xF3veda por l\xEDnea)"},mediaFolder:{name:"Carpeta de medios",desc:"Carpeta que contiene archivos adjuntos/imagenes. Cuando las notas usan ![[image.jpg]], Claude buscar\xE1 aqu\xED. Dejar vac\xEDo para la ra\xEDz del dep\xF3sito.",placeholder:"Adjuntos"},systemPrompt:{name:"Prompt de sistema personalizado",desc:"Instrucciones adicionales a\xF1adidas al prompt de sistema por defecto"},autoTitle:{name:"Generar autom\xE1ticamente t\xEDtulos de conversaci\xF3n",desc:"Genera autom\xE1ticamente t\xEDtulos de conversaci\xF3n despu\xE9s del primer mensaje del usuario."},titleModel:{name:"Modelo de generaci\xF3n de t\xEDtulos",desc:"Modelo utilizado para generar autom\xE1ticamente t\xEDtulos de conversaci\xF3n.",auto:"Autom\xE1tico (proveedor activo)"},runAbsoluteTimeout:{name:"Duraci\xF3n m\xE1xima de un turno",desc:"Minutos que un turno puede ejecutarse antes de detenerse, por muy activo que siga. Un turno en silencio se detiene antes, tras diez minutos sin decir nada. Aumenta este valor para trabajos ag\xE9nticos largos, o pon 0 para quitar el l\xEDmite."},sessionIdleTimeout:{name:"Tiempo de espera de procesos inactivos",desc:"Minutos que una conversaci\xF3n sin un turno en curso conserva su proceso del proveedor antes de que Grimoire lo libere. La conversaci\xF3n se mantiene y el siguiente turno la reanuda, as\xED que cuesta un arranque en fr\xEDo. Pon 0 para conservar cada proceso mientras su pesta\xF1a est\xE9 abierta."},navMappings:{name:"Mapeos de navegaci\xF3n estilo Vim",desc:'Un mapeo por l\xEDnea. Formato: "map <tecla> <acci\xF3n>" (acciones: scrollUp, scrollDown, focusInput).'},requireCommandOrControlEnterToSend:{name:"Enviar solo con el bot\xF3n",desc:"Cuando est\xE1 activado, Enter y Command/Ctrl+Enter insertan saltos de l\xEDnea en lugar de enviar. Usa el bot\xF3n Send para enviar."},theme:{name:"Tema",followsObsidian:"Sigue Obsidian"},usageIndicators:{name:"Indicadores de uso",desc:"Muestra indicadores de uso del plan y gasto de API junto al selector de modelo y en su men\xFA."},debugLogging:{name:"Registro de depuraci\xF3n",desc:"Escribe registros t\xE9cnicos saneados en .grimoire/logs/YYYY-MM-DD.jsonl solo mientras est\xE9 activado. Se redactan prompts, respuestas, contenido de notas, rutas, valores de entorno y secretos."},hotkeys:"Atajos de teclado",inlineEditHotkey:{name:"Edici\xF3n en l\xEDnea",descWithKey:"Atajo actual: {hotkey}",descNoKey:"Sin atajo configurado",btnChange:"Cambiar",btnSet:"Configurar"},openChatHotkey:{name:"Abrir chat",descWithKey:"Atajo actual: {hotkey}",descNoKey:"Sin atajo configurado",btnChange:"Cambiar",btnSet:"Configurar"},newSessionHotkey:{name:"Nueva sesi\xF3n",descWithKey:"Atajo actual: {hotkey}",descNoKey:"Sin atajo configurado",btnChange:"Cambiar",btnSet:"Configurar"},newTabHotkey:{name:"Nueva pesta\xF1a",descWithKey:"Atajo actual: {hotkey}",descNoKey:"Sin atajo configurado",btnChange:"Cambiar",btnSet:"Configurar"},closeTabHotkey:{name:"Cerrar pesta\xF1a",descWithKey:"Atajo actual: {hotkey}",descNoKey:"Sin atajo configurado",btnChange:"Cambiar",btnSet:"Configurar"},slashCommands:{name:"Comandos y habilidades",desc:"Administra comandos y habilidades a nivel de vault almacenados en .claude/commands/ y .claude/skills/. Activados por /nombre."},hiddenSlashCommands:{name:"Comandos y habilidades ocultos",desc:"Oculta coma