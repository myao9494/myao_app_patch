diff --git a/00_templates/From Clipboard.md b/00_templates/From Clipboard.md
index a65e4fbf1693a0758bab13eb87b76ef64f8e2fe3..d26bbfffcf54f0adfe15a93e87c5f8ce472744d8 100644
--- a/00_templates/From Clipboard.md	
+++ b/00_templates/From Clipboard.md	
@@ -212,6 +212,30 @@ const isProbablyCode = (text) => {
         || /^\s{2,}\S/m.test(normalized);
 };
 
+// SharePoint（ホスト名が ghi で始まる http/https の URL）を UNC パスに変換する。変換できなければ null。
+// 例: http://ghi1.example/Forms/AllItems.aspx?id=%2FDoc%2FA → \\ghi1.example@80\Doc\A
+const convertSharePointUrlToUnc = (urlString) => {
+    try {
+        const urlObj = new URL(urlString);
+        if (urlObj.protocol !== "http:" && urlObj.protocol !== "https:") return null;
+        if (!urlObj.hostname.toLowerCase().startsWith("ghi")) return null;
+
+        const isHttps = urlObj.protocol === "https:";
+        const connection = urlObj.port
+            ? (isHttps ? `SSL@${urlObj.port}` : urlObj.port)
+            : (isHttps ? "SSL" : "80");
+
+        let pathValue = urlObj.searchParams.get("id") || decodeURIComponent(urlObj.pathname);
+        if (!pathValue.startsWith("/")) pathValue = `/${pathValue}`;
+        pathValue = pathValue.replace(/\//g, "\\").replace(/\\+$/g, "");
+        if (!pathValue) return null;
+
+        return `\\\\${urlObj.hostname}@${connection}${pathValue}`;
+    } catch (e) {
+        return null;
+    }
+};
+
 const buildMarkdownLink = async (rawClipboardContent) => {
     let clipboardContent = rawClipboardContent.trim();
     if (clipboardContent.includes("\n") || clipboardContent.includes("\r")) {
@@ -219,8 +243,12 @@ const buildMarkdownLink = async (rawClipboardContent) => {
     }
 
     clipboardContent = clipboardContent.replace(/^["']|["']$/g, "");
+    // 末尾の %0d（URLに混入した改行）と空白を取り除く
+    clipboardContent = clipboardContent.replace(/(?:%0d|\s)+$/i, "").trim();
+    const uncPath = /^https?:/i.test(clipboardContent) ? convertSharePointUrlToUnc(clipboardContent) : null;
+    if (uncPath) clipboardContent = uncPath;
     const originalClipboardContent = clipboardContent;
-    const normalizedClipboardContent = clipboardContent.replace(/\\/g, "/");
+    const normalizedClipboardContent = uncPath || clipboardContent.replace(/\\/g, "/");
 
     let linkText = "Link";
     let linkUrl = clipboardContent;
diff --git a/00_templates/RegisterCustomCommands.md b/00_templates/RegisterCustomCommands.md
index 007d54d5d08d197567ee1ff86f35df424896043d..2f6b256c183400b69e4283cd5b8e173f4d9e68a9 100644
--- a/00_templates/RegisterCustomCommands.md
+++ b/00_templates/RegisterCustomCommands.md
@@ -38,6 +38,7 @@
  *   24_html_pdf_export.js               HTML / PDF 出力（画像のインライン化、ExcalidrawのPNG化、出力用HTMLの生成）
  *   25_tag_menu_top_notes_drop.js       タグメニュー、topタグ付きノートの自動更新、ファイルマネージャーからのドロップ
  *   26_gantt_task.js                    ganttに追加（ノートを gantt のタスクにし、ファイル名へタスクIDを付ける）
+ *   27_drawio_to_excalidraw.js          draw.io の図を Excalidraw の図（図形ごとに編集できる .excalidraw.md）へ変換
  *
  * 主な機能:
  * - From Clipboard: クリップボードの内容をMarkdownへ変換（表変換、コードブロック化、リンク貼り付け）
@@ -91,6 +92,7 @@ const CUSTOM_COMMAND_SCRIPT_FILES = [
     "24_html_pdf_export.js",
     "25_tag_menu_top_notes_drop.js",
     "26_gantt_task.js",
+    "27_drawio_to_excalidraw.js",
 ];
 
 // セクションのファイルを読み込み、上の一覧の順に連結して返す。
