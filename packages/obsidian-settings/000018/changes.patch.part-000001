 \u0440\u0430\u0437\u0434\u0435\u043B.",startToLoad:"\u0417\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0435 {provider} \u043E\u0434\u0438\u043D \u0440\u0430\u0437, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u043A\u0430\u0442\u0430\u043B\u043E\u0433 \u043C\u043E\u0434\u0435\u043B\u0435\u0439. \u041F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E Grimoire \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442 \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0432\u0438\u0434\u0438\u043C\u044B\u0435 \u043C\u043E\u0434\u0435\u043B\u0438.",unavailable:"\u041D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E",unavailableTitle:"\u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u0430\u044F \u043C\u043E\u0434\u0435\u043B\u044C \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0435 \u0441\u043E\u043E\u0431\u0449\u0430\u0435\u0442\u0441\u044F {provider}"},sharedEnvironment:{name:"\u041E\u0431\u0449\u0430\u044F \u0441\u0440\u0435\u0434\u0430",desc:"\u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0435 \u043A \u043F\u0440\u043E\u0432\u0430\u0439\u0434\u0435\u0440\u0443 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435 \u0441\u0440\u0435\u0434\u044B \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F, \u043E\u0431\u0449\u0438\u0435 \u0434\u043B\u044F \u0432\u0441\u0435\u0445 \u043F\u0440\u043E\u0432\u0430\u0439\u0434\u0435\u0440\u043E\u0432. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0434\u043B\u044F PATH, \u043F\u0440\u043E\u043A\u0441\u0438, \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0432 \u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445 \u043A\u0430\u0442\u0430\u043B\u043E\u0433\u043E\u0432."},providerTabs:{environmentVariables:"\u041F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435 \u0441\u0440\u0435\u0434\u044B",acp:{cliPath:{name:"\u041F\u0443\u0442\u044C \u043A CLI {provider}",desc:"\u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0439 \u043F\u0443\u0442\u044C \u043A \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u0435 {provider}. \u041E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u043F\u0443\u0441\u0442\u044B\u043C \u0434\u043B\u044F \u0430\u0432\u0442\u043E\u043F\u043E\u0438\u0441\u043A\u0430."},visibleModels:{name:"\u0412\u0438\u0434\u0438\u043C\u044B\u0435 \u043C\u043E\u0434\u0435\u043B\u0438",desc:"\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043C\u043E\u0434\u0435\u043B\u0438 {provider}, \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u043C\u044B\u0435 \u0432 \u0441\u0435\u043B\u0435\u043A\u0442\u043E\u0440\u0435 \u0447\u0430\u0442\u0430. \u0414\u043B\u044F \u043F\u043E\u0438\u0441\u043A\u0430 \u0444\u0438\u043B\u044C\u0442\u0440\u0443\u0439\u0442\u0435 \u043F\u043E \u043F\u0440\u043E\u0432\u0430\u0439\u0434\u0435\u0440\u0443 \u0438\u043B\u0438 \u0442\u0438\u043F\u0443."},commandsDesc:"{provider} \u043C\u043E\u0436\u0435\u0442 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0442\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u044B Claude \u0443\u0440\u043E\u0432\u043D\u044F vault \u0438\u0437 .claude/commands/ \u0438 \u043D\u0430\u0432\u044B\u043A\u0438 \u0438\u0437 .claude/skills/, .codex/skills/ \u0438 .agents/skills/. \u0423\u043F\u0440\u0430\u0432\u043B\u044F\u0439\u0442\u0435 \u0438\u043C\u0438 \u043D\u0430 \u0432\u043A\u043B\u0430\u0434\u043A\u0435 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043A Claude \u0438\u043B\u0438 Codex. \u042D\u0442\u043E\u0442 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B \u0438\u0437 \u043C\u0435\u043D\u044E {provider}.",hiddenCommandsDesc:"\u0421\u043A\u0440\u044B\u0442\u044C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435 \u043A\u043E\u043C\u0430\u043D\u0434\u044B \u0438 \u043D\u0430\u0432\u044B\u043A\u0438 {provider} \u0438\u0437 \u043C\u0435\u043D\u044E. \u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u0438\u043C\u0435\u043D\u0430 \u0431\u0435\u0437 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0439 \u043A\u043E\u0441\u043E\u0439 \u0447\u0435\u0440\u0442\u044B, \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443 \u0432 \u0441\u0442\u0440\u043E\u043A\u0435.",subagentsDesc:"\u0423\u043F\u0440\u0430\u0432\u043B\u044F\u0439\u0442\u0435 \u043F\u043E\u0434\u0430\u0433\u0435\u043D\u0442\u0430\u043C\u0438 {provider} \u0443\u0440\u043E\u0432\u043D\u044F vault \u0438\u0437 {root} \u0438 \u0443\u0441\u0442\u0430\u0440\u0435\u0432\u0448\u0435\u0433\u043E {legacyRoot}. \u041D\u043E\u0432\u044B\u0435 \u0437\u0430\u043F\u0438\u0441\u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442\u0441\u044F \u0432 \u0444\u0430\u0439\u043B\u0430\u0445 \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F \u043F\u043E\u0434\u0430\u0433\u0435\u043D\u0442\u043E\u0432 \u0438 \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u044E\u0442\u0441\u044F \u0432 \u043C\u0435\u043D\u044E @mention.",environmentDesc:"\u0422\u043E\u043B\u044C\u043A\u043E \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435 \u0441\u0440\u0435\u0434\u044B \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F, \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u0449\u0438\u0435 {provider}, \u0432\u043A\u043B\u044E\u0447\u0430\u044F {environmentVariable}=1. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0434\u043B\u044F \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043A \u043F\u0440\u043E\u0432\u0430\u0439\u0434\u0435\u0440\u0430; \u043E\u0431\u0449\u0438\u0435 PATH, \u043F\u0440\u043E\u043A\u0441\u0438 \u0438 \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u043A\u0430\u0442\u044B \u0443\u043A\u0430\u0436\u0438\u0442\u0435 \u0432 \u041E\u0431\u0449\u0435\u0439 \u0441\u0440\u0435\u0434\u0435."},antigravity:{windowsLimitations:{name:"\u041E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u044F CLI \u0432 Windows",desc:"\u0412 Windows \u0442\u0435\u043A\u0443\u0449\u0438\u0435 \u0441\u0431\u043E\u0440\u043A\u0438 agy \u043C\u043E\u0433\u0443\u0442 \u0443\u0441\u043F\u0435\u0448\u043D\u043E \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u0442\u044C\u0441\u044F, \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044F \u043F\u0443\u0441\u0442\u043E\u0439 stdout \u043F\u0440\u0438 \u043F\u043E\u0438\u0441\u043A\u0435 \u043C\u043E\u0434\u0435\u043B\u0435\u0439 \u0438 \u0432\u044B\u0432\u043E\u0434\u0435 \u043E\u0442\u0432\u0435\u0442\u043E\u0432. Grimoire \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u0436\u0443\u0440\u043D\u0430\u043B\u044B, \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u0438 \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0435 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435, \u043D\u043E Antigravity \u0432 Windows \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u043C\u0435\u043D\u0435\u0435 \u043D\u0430\u0434\u0451\u0436\u0435\u043D, \u0447\u0435\u043C \u0432 macOS \u0438\u043B\u0438 Linux."},cliPath:{name:"\u041F\u0443\u0442\u044C \u043A CLI Antigravity",desc:"\u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0439 \u043F\u0443\u0442\u044C \u043A \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u0435 agy. \u041E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u043F\u0443\u0441\u0442\u044B\u043C \u0434\u043B\u044F \u0430\u0432\u0442\u043E\u043F\u043E\u0438\u0441\u043A\u0430."},customModels:{name:"\u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0435 \u043C\u043E\u0434\u0435\u043B\u0438",desc:"\u0414\u043E\u0431\u0430\u0432\u044C\u0442\u0435 \u043C\u0435\u0442\u043A\u0438 \u043C\u043E\u0434\u0435\u043B\u0435\u0439 Antigravity \u0432 \u0441\u0435\u043B\u0435\u043A\u0442\u043E\u0440, \u043F\u043E \u043E\u0434\u043D\u043E\u0439 \u0432 \u0441\u0442\u0440\u043E\u043A\u0435. \u041F\u0440\u0438 \u043D\u0435\u043F\u043E\u043B\u043D\u043E\u043C \u043F\u043E\u0438\u0441\u043A\u0435 \u0432 Windows \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0442\u043E\u0447\u043D\u044B\u0435 \u043C\u0435\u0442\u043A\u0438 \u0438\u0437 \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0442\u0435\u043B\u044F \u043C\u043E\u0434\u0435\u043B\u0435\u0439 agy."},environmentDesc:"\u0414\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435 \u0441\u0440\u0435\u0434\u044B \u0434\u043B\u044F CLI Antigravity, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440 GOOGLE_CLOUD_PROJECT."},gemini:{cliPath:{name:"\u041F\u0443\u0442\u044C \u043A CLI Gemini",desc:"\u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0439 \u043F\u0443\u0442\u044C \u043A \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u043E\u0439 CLI Gemini. \u041E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u043F\u0443\u0441\u0442\u044B\u043C, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C `gemini` \u0438\u0437 PATH."},environmentDesc:"\u0414\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435 \u0441\u0440\u0435\u0434\u044B \u0434\u043B\u044F CLI Gemini, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440 GEMINI_API_KEY \u0438\u043B\u0438 GOOGLE_CLOUD_PROJECT."},claude:{advancedSummary:"\u041A\u043E\u043C\u0430\u043D\u0434\u044B, \u0430\u0433\u0435\u043D\u0442\u044B, MCP, \u0441\u0440\u0435\u0434\u0430 \u0438 \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u044B",environmentDesc:"\u0422\u043E\u043B\u044C\u043A\u043E \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435 \u0441\u0440\u0435\u0434\u044B \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F Claude. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0434\u043B\u044F ANTHROPIC_* \u0438 \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0442\u0435\u043B\u0435\u0439 Claude."},codex:{installationMethod:{name:"\u0421\u043F\u043E\u0441\u043E\u0431 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438",desc:"\u041A\u0430\u043A Grimoire \u0434\u043E\u043B\u0436\u0435\u043D \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0442\u044C Codex \u0432 Windows. \u041D\u0430\u0442\u0438\u0432\u043D\u044B\u0439 Windows \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u043F\u0443\u0442\u044C \u043A \u0438\u0441\u043F\u043E\u043B\u043D\u044F\u0435\u043C\u043E\u043C\u0443 \u0444\u0430\u0439\u043B\u0443 Windows. WSL \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0435\u0442 Linux CLI \u0432 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u043C \u0434\u0438\u0441\u0442\u0440\u0438\u0431\u0443\u0442\u0438\u0432\u0435.",nativeWindows:"\u041D\u0430\u0442\u0438\u0432\u043D\u044B\u0439 Windows"},cliPath:{name:"\u041F\u0443\u0442\u044C \u043A CLI Codex",desc:"\u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0439 \u043F\u0443\u0442\u044C \u043A \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u043E\u0439 CLI Codex. \u041E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u043F\u0443\u0441\u0442\u044B\u043C \u0434\u043B\u044F \u0430\u0432\u0442\u043E\u043F\u043E\u0438\u0441\u043A\u0430 \u0438\u0437 PATH.",descWindows:"\u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0439 \u043F\u0443\u0442\u044C \u043A \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u043E\u0439 CLI Codex. \u041E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u043F\u0443\u0441\u0442\u044B\u043C \u0434\u043B\u044F \u0430\u0432\u0442\u043E\u043F\u043E\u0438\u0441\u043A\u0430 \u0438\u0437 PATH. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u043F\u0443\u0442\u044C \u043A \u043D\u0430\u0442\u0438\u0432\u043D\u043E\u043C\u0443 \u0438\u0441\u043F\u043E\u043B\u043D\u044F\u0435\u043C\u043E\u043C\u0443 \u0444\u0430\u0439\u043B\u0443 Windows, \u043E\u0431\u044B\u0447\u043D\u043E `codex.exe`.",descWsl:"\u041A\u043E\u043C\u0430\u043D\u0434\u0430 Codex \u043D\u0430 \u0441\u0442\u043E\u0440\u043E\u043D\u0435 Linux \u0438\u043B\u0438 \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u044B\u0439 \u043F\u0443\u0442\u044C \u0434\u043B\u044F \u0437\u0430\u043F\u0443\u0441\u043A\u0430 \u0432 WSL. \u041E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u043F\u0443\u0441\u0442\u044B\u043C \u0434\u043B\u044F \u043F\u043E\u0438\u0441\u043A\u0430 \u0432 PATH \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0433\u043E \u0434\u0438\u0441\u0442\u0440\u0438\u0431\u0443\u0442\u0438\u0432\u0430.",wslValidation:"\u0420\u0435\u0436\u0438\u043C WSL \u043E\u0436\u0438\u0434\u0430\u0435\u0442 \u043A\u043E\u043C\u0430\u043D\u0434\u0443 Linux \u0438\u043B\u0438 \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u044B\u0439 \u043F\u0443\u0442\u044C Linux, \u0430 \u043D\u0435 \u043F\u0443\u0442\u044C \u043A \u0438\u0441\u043F\u043E\u043B\u043D\u044F\u0435\u043C\u043E\u043C\u0443 \u0444\u0430\u0439\u043B\u0443 Windows."},wslDistro:{name:"\u041F\u0435\u0440\u0435\u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u0434\u0438\u0441\u0442\u0440\u0438\u0431\u0443\u0442\u0438\u0432\u0430 WSL",desc:"\u041D\u0435\u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u043D\u043E\u0435 \u043F\u0435\u0440\u0435\u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0435. \u041E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u043F\u0443\u0441\u0442\u044B\u043C, \u0447\u0442\u043E\u0431\u044B \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C \u0434\u0438\u0441\u0442\u0440\u0438\u0431\u0443\u0442\u0438\u0432 \u0438\u0437 \u043F\u0443\u0442\u0438 \u0440\u0430\u0431\u043E\u0447\u0435\u0433\u043E \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430 WSL; \u0438\u043D\u0430\u0447\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u0434\u0438\u0441\u0442\u0440\u0438\u0431\u0443\u0442\u0438\u0432 WSL \u043F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E."},customModels:{name:"\u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0435 \u043C\u043E\u0434\u0435\u043B\u0438",desc:"\u0414\u043E\u0431\u0430\u0432\u044C\u0442\u0435 ID \u043C\u043E\u0434\u0435\u043B\u0435\u0439 Codex \u0432 \u0441\u0435\u043B\u0435\u043A\u0442\u043E\u0440, \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443 \u0432 \u0441\u0442\u0440\u043E\u043A\u0435. \u041F\u0440\u0438 \u0437\u0430\u0434\u0430\u043D\u043D\u043E\u043C \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0438 `OPENAI_MODEL` \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442 \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442."},reasoning:{name:"\u0421\u0432\u043E\u0434\u043A\u0430 \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043D\u0438\u0439",desc:"\u041F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u0441\u0432\u043E\u0434\u043A\u0443 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0430 \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043D\u0438\u0439 \u043C\u043E\u0434\u0435\u043B\u0438 \u0432 \u0431\u043B\u043E\u043A\u0435 \u0440\u0430\u0437\u043C\u044B\u0448\u043B\u0435\u043D\u0438\u0439.",auto:"\u0410\u0432\u0442\u043E",concise:"\u041A\u0440\u0430\u0442\u043A\u043E",detailed:"\u041F\u043E\u0434\u0440\u043E\u0431\u043D\u043E",off:"\u0412\u044B\u043A\u043B."},advancedSummary:"\u041D\u0430\u0432\u044B\u043A\u0438, \u043F\u043E\u0434\u0430\u0433\u0435\u043D\u0442\u044B, MCP \u0438 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u0437\u0430\u043F\u0443\u0441\u043A\u0430",skills:{name:"\u041D\u0430\u0432\u044B\u043A\u0438 Codex",desc:"\u0423\u043F\u0440\u0430\u0432\u043B\u044F\u0439\u0442\u0435 \u043D\u0430\u0432\u044B\u043A\u0430\u043C\u0438 Codex \u0443\u0440\u043E\u0432\u043D\u044F vault, \u0445\u0440\u0430\u043D\u044F\u0449\u0438\u043C\u0438\u0441\u044F \u0432 .codex/skills/ \u0438\u043B\u0438 .agents/skills/. \u041D\u0430\u0432\u044B\u043A\u0438 \u0434\u043E\u043C\u0430\u0448\u043D\u0435\u0433\u043E \u0443\u0440\u043E\u0432\u043D\u044F \u0437\u0434\u0435\u0441\u044C \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u044B."},hiddenSkills:{name:"\u0421\u043A\u0440\u044B\u0442\u044B\u0435 \u043D\u0430\u0432\u044B\u043A\u0438",desc:"\u0421\u043A\u0440\u044B\u0442\u044C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435 \u043D\u0430\u0432\u044B\u043A\u0438 Codex \u0438\u0437 \u043C\u0435\u043D\u044E. \u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u0438\u043C\u0435\u043D\u0430 \u043D\u0430\u0432\u044B\u043A\u043E\u0432 \u0431\u0435\u0437 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0433\u043E $, \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443 \u0432 \u0441\u0442\u0440\u043E\u043A\u0435."},subagents:{name:"\u041F\u043E\u0434\u0430\u0433\u0435\u043D\u0442\u044B Codex",desc:"\u0423\u043F\u0440\u0430\u0432\u043B\u044F\u0439\u0442\u0435 \u043F\u043E\u0434\u0430\u0433\u0435\u043D\u0442\u0430\u043C\u0438 Codex \u0443\u0440\u043E\u0432\u043D\u044F vault \u0438\u0437 .codex/agents/. \u041A\u0430\u0436\u0434\u044B\u0439 \u0444\u0430\u0439\u043B TOML \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442 \u043E\u0434\u043D\u043E\u0433\u043E \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0433\u043E \u0430\u0433\u0435\u043D\u0442\u0430."},mcp:{beforeCommand:"Codex \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u0435\u0440\u0432\u0435\u0440\u0430\u043C\u0438 MCP \u0447\u0435\u0440\u0435\u0437 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E CLI. \u041D\u0430\u0441\u0442\u0440\u043E\u0439\u0442\u0435 \u0438\u0445 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E ",afterCommand:", \u0438 \u043E\u043D\u0438 \u0441\u0442\u0430\u043D\u0443\u0442 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B \u0432 Grimoire. "},environment:{name:"\u0421\u0440\u0435\u0434\u0430 Codex",desc:"\u0422\u043E\u043B\u044C\u043A\u043E \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435 \u0441\u0440\u0435\u0434\u044B \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F Codex. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0434\u043B\u044F \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043A OPENAI_* \u0438 CODEX_*. \u0415\u0441\u043B\u0438 \u0430\u0432\u0442\u043E\u043F\u043E\u0438\u0441\u043A\u0443 \u043D\u0443\u0436\u043D\u0430 \u043F\u043E\u043C\u043E\u0449\u044C, \u0434\u043E\u0431\u0430\u0432\u044C\u0442\u0435 \u043A\u0430\u0442\u0430\u043B\u043E\u0433 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 Codex \u0432 PATH \u041E\u0431\u0449\u0435\u0439 \u0441\u0440\u0435\u0434\u044B."}},qwen:{cliPath:{name:"\u041F\u0443\u0442\u044C \u043A CLI Qwen",desc:"\u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0439 \u043F\u0443\u0442\u044C \u043A \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u043E\u0439 CLI Qwen. \u041E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u043F\u0443\u0441\u0442\u044B\u043C, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C `qwen` \u0438\u0437 PATH."},advancedSummary:"\u041D\u0430\u0432\u044B\u043A\u0438, \u043A\u043E\u043C\u0430\u043D\u0434\u044B, \u043F\u043E\u0434\u0430\u0433\u0435\u043D\u0442\u044B, MCP \u0438 \u0441\u0440\u0435\u0434\u0430",hiddenCommands:{name:"\u0421\u043A\u0440\u044B\u0442\u044B\u0435 \u043A\u043E\u043C\u0430\u043D\u0434\u044B",desc:"\u0421\u043A\u0440\u044B\u0442\u044C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435 \u043A\u043E\u043C\u0430\u043D\u0434\u044B, \u0441\u043E\u043E\u0431\u0449\u0430\u0435\u043C\u044B\u0435 Qwen Code ACP. \u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u0438\u043C\u0435\u043D\u0430 \u0431\