+export default function (pi) {
+  for (const spec of ${JSON.stringify(Ns)}) {
+    pi.registerTool({
+      name: spec.name,
+      label: spec.name,
+      description: spec.description,
+      parameters: spec.inputSchema,
+      async execute(toolCallId, args, signal, onUpdate, ctx) {
