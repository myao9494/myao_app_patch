u043E\u0432\u0430\u044F \u0440\u0430\u0431\u043E\u0447\u0430\u044F \u043E\u0431\u043B\u0430\u0441\u0442\u044C",changeFailed:"\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u043F\u0440\u043E\u0435\u043A\u0442\u043D\u0443\u044E \u0440\u0430\u0431\u043E\u0447\u0443\u044E \u043E\u0431\u043B\u0430\u0441\u0442\u044C"},providers:{selectionHint:"\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u043A\u0430\u0440\u0442\u043E\u0447\u043A\u0443 \u043F\u0440\u043E\u0432\u0430\u0439\u0434\u0435\u0440\u0430, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0435\u0433\u043E \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u043D\u0438\u0436\u0435.",grok:{desc:"Agentic coding CLI \u043E\u0442 xAI \u0441 plan mode, subagents, skills \u0438 MCP."},claude:{desc:"\u0410\u0433\u0435\u043D\u0442\u0441\u043A\u0430\u044F CLI Anthropic. \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u043C\u044B\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u043F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E."},codex:{desc:"\u0410\u0433\u0435\u043D\u0442 OpenAI \u0434\u043B\u044F \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F."},antigravity:{desc:"\u041D\u043E\u0432\u0430\u044F \u043C\u0443\u043B\u044C\u0442\u0438\u043C\u043E\u0434\u0435\u043B\u044C\u043D\u0430\u044F \u0430\u0433\u0435\u043D\u0442\u0441\u043A\u0430\u044F CLI Google. \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u043C\u044B\u0439 \u043F\u0440\u043E\u0432\u0430\u0439\u0434\u0435\u0440 Google."},gemini:{desc:"\u0423\u0441\u0442\u0430\u0440\u0435\u0432\u0448\u0430\u044F CLI Gemini \u0434\u043B\u044F \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u0439 Standard, Enterprise \u0438 \u043F\u043B\u0430\u0442\u043D\u044B\u0445 API-\u043A\u043B\u044E\u0447\u0435\u0439."},opencode:{desc:"\u041E\u0442\u043A\u0440\u044B\u0442\u044B\u0439 \u0438 \u043C\u0443\u043B\u044C\u0442\u0438\u0432\u0435\u043D\u0434\u043E\u0440\u043D\u044B\u0439. \u041F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u0430\u043C\u044B\u0439 \u0448\u0438\u0440\u043E\u043A\u0438\u0439 \u043A\u0430\u0442\u0430\u043B\u043E\u0433 \u043C\u043E\u0434\u0435\u043B\u0435\u0439."},mimocode:{desc:"\u0424\u043E\u0440\u043A OpenCode \u043E\u0442 Xiaomi \u0441 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E\u0439 \u043F\u0430\u043C\u044F\u0442\u044C\u044E \u0438 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C \u043A\u043E\u043D\u0442\u0435\u043A\u0441\u0442\u043E\u043C."},kimicode:{desc:"\u041C\u0443\u043B\u044C\u0442\u0438\u043F\u0440\u043E\u0432\u0430\u0439\u0434\u0435\u0440\u043D\u0430\u044F \u0430\u0433\u0435\u043D\u0442\u0441\u043A\u0430\u044F CLI MoonshotAI. \u041F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 Kimi, OpenAI, Anthropic \u0438 Gemini."},qwen:{desc:"Alibaba Qwen Code \u0447\u0435\u0440\u0435\u0437 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E \u0441\u0440\u0435\u0434\u0443 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F Agent Client Protocol."},devin:{desc:"Devin CLI \u043E\u0442 Cognition \u0447\u0435\u0440\u0435\u0437 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E \u0441\u0440\u0435\u0434\u0443 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F Agent Client Protocol."},reasonix:{desc:"\u041E\u0442\u043A\u0440\u044B\u0442\u044B\u0439 \u0430\u0433\u0435\u043D\u0442 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F Reasonix \u0447\u0435\u0440\u0435\u0437 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E \u0441\u0440\u0435\u0434\u0443 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F Agent Client Protocol."},commandcode:{desc:"\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0443\u0441\u0442\