+
+describe("表のセルの結合と文字参照", () => {
+    test("colspan の分だけ列を空けること", () => {
+        const md = convertHtmlTablesToMarkdown("<table><tr><td>A</td><td>B</td><td>C</td></tr><tr><td colspan=2>横</td><td>右</td></tr></table>");
+        assert.ok(md.includes("| 横 |  | 右 |"), md);
+    });
+
+    test("rowspan の分だけ下の行の列を空けること", () => {
+        const md = convertHtmlTablesToMarkdown('<table><tr><td rowspan="2">縦</td><td>B1</td></tr><tr><td>B2</td></tr></table>');
+        assert.ok(md.includes("| 縦 | B1 |"), md);
+        assert.ok(md.includes("|  | B2 |"), md);
+    });
+
+    test("数値の文字参照を文字に戻すこと", () => {
+        const md = convertHtmlTablesToMarkdown("<table><tr><td>&#9312;</td><td>&#x3042;</td></tr><tr><td>&amp;lt;</td><td>&apos;</td></tr></table>");
+        assert.ok(md.includes("| ① | あ |"), md);
+        assert.ok(md.includes("| &lt; | ' |"), md);
+    });
+});
+
+describe("HTML本文のプレーンテキスト化", () => {
+    test("表の中の $& などを置換の特殊文字として扱わないこと", () => {
+        const text = htmlToPlainText("<table><tr><td>a$&b</td><td>$'c</td></tr><tr><td>1</td><td>2</td></tr></table>");
+        assert.ok(text.includes("| a$&b | $'c |"), text);
+    });
+
+    test("本文の数値の文字参照を文字に戻すこと", () => {
+        assert.strictEqual(htmlToPlainText("<p>&#9312;&#x3042;</p>"), "①あ");
+    });
+});
+
+describe("文字化けの復旧（recoverStringIfGarbled）", () => {
+    test("半角カナを含む正しい文字列を書き換えないこと", () => {
+        assert.strictEqual(recoverStringIfGarbled("ｱﾝｹｰﾄ"), "ｱﾝｹｰﾄ");
+        assert.strictEqual(recoverStringIfGarbled("ｱﾝｹｰﾄのお願い"), "ｱﾝｹｰﾄのお願い");
+    });
+
+    test("latin1 で読まれた Shift-JIS を復旧すること", () => {
+        assert.strictEqual(recoverStringIfGarbled(Buffer.from([0x82, 0xa2, 0x82, 0xa2]).toString("latin1")), "いい");
+    });
+
