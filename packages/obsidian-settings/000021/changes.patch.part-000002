+ * Image Converter はノート内の画像の右クリックに自分のメニューを出す。自作のメニューも開くと2つ重なるため、
+ * Image Converter が扱う画像では、そのメニューへ自作の項目を足して1つにする。
+ * 無効にされた場合や、内部の構造が変わった場合は、これまでどおり自作のメニューを開く。
+ **/
+const getImageConverterContextMenu = () => {
+    const plugin = app.plugins?.plugins?.["image-converter"];
+    const contextMenu = plugin?.contextMenu;
+    if (!plugin?.settings?.enableContextMenu) return null;
+    return typeof contextMenu?.createContextMenuItems === "function" ? contextMenu : null;
+};
+
+// Image Converter の右クリックの判定（handleContextMenuEvent）と同じ条件
+const isImageConverterMenuTarget = (e) => {
+    const contextMenu = getImageConverterContextMenu();
+    if (!contextMenu) return false;
+    try {
+        const obsidianView = getObsidianModule()?.View;
+        if (app.workspace.getActiveViewOfType(obsidianView)?.getViewType() === "canvas") return false;
+        const imgEl = contextMenu.resolveImageFromTarget(e.target);
+        if (!imgEl) return false;
+        const plugin = app.plugins.plugins["image-converter"];
+        if (plugin.supportedImageFormats?.isExcalidrawImage?.(imgEl)) return false;
+        return Boolean(imgEl.closest(".markdown-preview-view") || imgEl.closest(".markdown-source-view"));
+    } catch (error) {
+        console.warn("Failed to check Image Converter context menu target:", error);
+        return false;
+    }
+};
+
+const addCustomItemsToImageConverterMenu = (menu, imgEl) => {
