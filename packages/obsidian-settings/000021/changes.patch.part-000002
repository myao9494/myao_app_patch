":"\u30A2\u30EB\u30D5\u30A1\u30D9\u30C3\u30C8\u306E\u6607\u9806","Descending Alphabetical":"\u30A2\u30EB\u30D5\u30A1\u30D9\u30C3\u30C8\u306E\u964D\u9806","multi-line":"\u8907\u6570\u884C","single-line":"\u5358\u4E00\u884C","single string to single-line":"\u5358\u4E00\u6587\u5B57\u5217\u304B\u3089\u5358\u4E00\u884C\u3078","single string to multi-line":"\u5358\u4E00\u6587\u5B57\u5217\u304B\u3089\u8907\u6570\u884C\u3078","single string comma delimited":"\u5358\u4E00\u6587\u5B57\u5217\u30AB\u30F3\u30DE\u533A\u5207\u308A","single string space delimited":"\u5358\u4E00\u6587\u5B57\u5217\u30B9\u30DA\u30FC\u30B9\u533A\u5207\u308A","single-line space delimited":"\u5358\u4E00\u884C\u30B9\u30DA\u30FC\u30B9\u533A\u5207\u308A","first-h1":"\u6700\u521D\u306EH1","first-h1-or-filename-if-h1-missing":"\u6700\u521D\u306EH1 \u307E\u305F\u306F H1\u304C\u306A\u3044\u5834\u5408\u306F\u30D5\u30A1\u30A4\u30EB\u540D",filename:"\u30D5\u30A1\u30A4\u30EB\u540D",never:"\u306A\u3057","after 5 seconds":"5\u79D2\u5F8C","after 10 seconds":"10\u79D2\u5F8C","after 15 seconds":"15\u79D2\u5F8C","after 30 seconds":"30\u79D2\u5F8C","after 1 minute":"1\u5206\u5F8C","file system":"\u30D5\u30A1\u30A4\u30EB\u30B7\u30B9\u30C6\u30E0",frontmatter:"YAML frontmatter","user or Linter edits":"Obsidian\u3067\u306E\u5909\u66F4","''":"''","\u2018\u2019":"\u2018\u2019",'""':'""',"\u201C\u201D":"\u201C\u201D","\\":"\\","<br>":"<br>","  ":"  ","<br/>":"<br/>"}};var wf={};var xf={};var Lf={};var Sf={};var Ef={};var Tf={commands:{"lint-file":{name:"Executar o linter no arquivo atual","error-message":"Erro ao executar o linter no Arquivo"},"lint-file-unless-ignored":{name:"Executar o linter no arquivo atual (se n\xE3o for ignorado)"},"lint-all-files":{name:"Executar o linter em todos os arquivos do cofre","error-message":"Erro ao executar o linter em massa no Arquivo","success-message":"Linter executado em todos os arquivos","errors-message-singular":"Linter executado em todos os arquivos com 1 erro.","errors-message-plural":"Linter executado em todos os arquivos com {NUM} erros.","start-message":"Isso editar\xE1 todos os seus arquivos e pode introduzir erros.","submit-button-text":"Executar em Todos","submit-button-notice-text":"Executando o linter em todos os arquivos..."},"lint-all-files-in-folder":{name:"Executar o linter em todos os arquivos da pasta atual","start-message":"Isso editar\xE1 todos os seus arquivos em {FOLDER_NAME}, incluindo arquivos em suas subpastas, o que pode introduzir erros.","submit-button-text":"Executar em todos os arquivos em {FOLDER_NAME}","submit-button-notice-text":"Executando o linter em todos os arquivos em {FOLDER_NAME}...","error-message":"Erro ao executar o linter em todos os arquivos da pasta no Arquivo","success-message":"Linter executado em todos os {NUM} arquivos em {FOLDER_NAME}.","message-singular":"Linter executado em todos os {NUM} arquivos em {FOLDER_NAME} e houve 1 erro.","message-plural":"Linter executado em todos os {FILE_COUNT} arquivos em {FOLDER_NAME} e houve {ERROR_COUNT} erros."},"paste-as-plain-text":{name:"Colar como Texto Simples e sem Modifica\xE7\xF5es"},"ignore-folder":{name:"Ignorar pasta"},"ignore-file":{name:"Ignorar arquivo"},"lint-file-pop-up-menu-text":{name:"Executar linter no arquivo"},"lint-folder-pop-up-menu-text":{name:"Executar linter na pasta"},"ignore-file-pop-up-menu-text":{name:"Ignorar arquivo no Linter"},"ignore-folder-pop-up-menu-text":{name:"Ignorar pasta no Linter"}},logs:{"plugin-load":"Carregando o plugin","plugin-unload":"Descarregando o plugin","folder-lint":"Executando linter na pasta ","linter-run":"Executando o linter","file-change-yaml-lint-run":"Executando linter de YAML nas altera\xE7\xF5es de conte\xFAdo do editor","file-change-yaml-lint-skipped":"Nenhuma altera\xE7\xE3o de arquivo detectada, portanto, o linter de YAML foi desconsiderado","file-change-yaml-lint-warning":"Nenhuma informa\xE7\xE3o de arquivo presente, mas o debounce foi executado. Algo deu errado em algum lugar.","paste-link-warning":"execu\xE7\xE3o do linter ao colar abortada pois o conte\xFAdo da \xE1rea de transfer\xEAncia \xE9 um link e isso evita conflitos com outros plugins que modificam a a\xE7\xE3o de colar.","see-console":"Verifique o console para mais detalhes.","unknown-error":"Ocorreu um erro desconhecido durante a execu\xE7\xE3o do linter.","moment-locale-not-found":"Tentando alterar a localidade do Moment.js para {MOMENT_LOCALE}, obteve-se {CURRENT_LOCALE}","file-change-lint-message-start":"Linter executado","custom-command-callback-warning":"Por favor, defina o callback de comando personalizado apenas para testes de integra\xE7\xE3o.","pre-rules":"regras anteriores \xE0s regras regulares","post-rules":"regras posteriores \xE0s regras regulares","rule-running":"regras em execu\xE7\xE3o","custom-regex":"regras de regex personalizadas","running-custom-regex":"Executando Regex Personalizada","running-custom-lint-command":"Executando Comandos Personalizados do Linter","custom-lint-duplicate-warning":'Voc\xEA n\xE3o pode executar o mesmo comando ("{COMMAND_NAME}") como uma regra personalizada do linter duas vezes.',"custom-lint-error-message":"Comando Personalizado do Linter","disabled-text":"est\xE1 desativado","run-rule-text":"Executando","timing-key-not-found":"a chave de temporiza\xE7\xE3o '{TIMING_KEY}' n\xE3o existe na lista de informa\xE7\xF5es de temporiza\xE7\xE3o, portanto foi ignorada","milliseconds-abbreviation":"ms","invalid-date-format-error":"O formato da data de cria\xE7\xE3o '{DATE}' n\xE3o p\xF4de ser analisado ou determinado, portanto a data de cria\xE7\xE3o n\xE3o foi modificada em '{FILE_NAME}'","invalid-delimiter-error-message":"o delimitador deve ser apenas um \xFAnico caractere","missing-footnote-error-message":"A nota de rodap\xE9 '{FOOTNOTE}' n\xE3o tem uma refer\xEAncia de nota de rodap\xE9 correspondente antes do conte\xFAdo da nota de rodap\xE9 e n\xE3o pode ser processada. Por favor, certifique-se de que todas as notas de rodap\xE9 tenham uma refer\xEAncia correspondente antes do conte\xFAdo da nota de rodap\xE9.","too-many-footnotes-error-message":"A chave da nota de rodap\xE9 '{FOOTNOTE_KEY}' tem mais de uma nota de rodap\xE9 fazendo refer\xEAncia a ela. Por favor, atualize as notas de rodap\xE9 para que haja apenas uma nota de rodap\xE9 por chave.","wrapper-yaml-error":"erro no YAML: {ERROR_MESSAGE}","wrapper-unknown-error":"erro desconhecido: {ERROR_MESSAGE}"},"notice-text":{"empty-clipboard":"N\xE3o h\xE1 conte\xFAdo na \xE1rea de transfer\xEAncia.","characters-added":"caracteres adicionados","characters-removed":"caracteres removidos"},"all-rules-option":"Todas","linter-title":"Linter","empty-search-results-text":"Nenhuma configura\xE7\xE3o correspondente \xE0 pesquisa","warning-text":"Aviso","file-backup-text":"Certifique-se de ter feito backup dos seus arquivos.","custom-command-warning":"Executar o linter em m\xFAltiplos arquivos com comandos personalizados ativados \xE9 um processo lento que requer a habilidade de abrir pain\xE9is no painel lateral. \xC9 notavelmente mais lento do que executar sem os comandos personalizados ativados. Por favor, proceda com cautela.","cancel-button-text":"Cancelar","do-not-show-again":"N\xE3o mostrar esta confirma\xE7\xE3o novamente","disabled-other-rule-notice":"Se voc\xEA ativar <code>{NAME_1}</code>, isso desativar\xE1 <code>{NAME_2}</code>. Deseja prosseguir?","disabled-conflicting-rule-notice":"{NAME_1} entra em conflito com {NAME_2}, portanto foi desativada. Voc\xEA pode alternar qual configura\xE7\xE3o est\xE1 desativada na aba de configura\xE7\xF5es.",ok:"Ok","parse-results-heading-text":"Valores Personalizados Analisados","file-parse-description-text":"A seguir est\xE1 a lista de substitui\xE7\xF5es personalizadas encontradas em {FILE}.","no-parsed-values-found-text":"Nenhuma substitui\xE7\xE3o personalizada encontrada em {FILE}. Por favor, certifique-se de que todas as tabelas com substitui\xE7\xF5es personalizadas em {FILE} tenham apenas duas colunas e que todas as linhas comecem e terminem com uma barra vertical (ou seja, |).","find-header-text":"Palavra a Localizar","replace-header-text":"Palavra de Substitui\xE7\xE3o","close-button-text":"Fechar",tabs:{names:{general:"Geral",custom:"Personalizado",yaml:"YAML",heading:"Cabe\xE7alho",content:"Conte\xFAdo",footnote:"Nota de rodap\xE9",spacing:"Espa\xE7amento",paste:"Colar",debug:"Depura\xE7\xE3o"},general:{"lint-on-save":{name:"Executar linter ao salvar",description:"Executa o linter ao salvar o arquivo manualmente (quando <code>Ctrl + S</code> \xE9 pressionado ou quando <code>:w</code> \xE9 executado usando atalhos do vim)"},"display-message":{name:"Exibir mensagem ao executar linter",description:"Exibe o n\xFAmero de caracteres alterados ap\xF3s a execu\xE7\xE3o do linter"},"suppress-message-when-no-change":{name:"Suprimir mensagem quando n\xE3o houver altera\xE7\xE3o",description:"Se ativado, nenhuma mensagem ser\xE1 mostrada quando nenhuma altera\xE7\xE3o real ocorrer."},"lint-on-file-change":{name:"Executar linter ao alterar o arquivo focado",description:"Quando um arquivo \xE9 fechado ou um novo arquivo \xE9 selecionado, o linter \xE9 executado no arquivo anterior."},"display-lint-on-file-change-message":{name:"Exibir mensagem de execu\xE7\xE3o do linter na altera\xE7\xE3o de arquivo",description:"Exibe uma mensagem quando <code>Executar linter ao alterar o arquivo focado</code> ocorre"},"folders-to-ignore":{name:"Pastas a ignorar",description:"Pastas a ignorar ao executar o linter em todos os arquivos ou ao salvar.","folder-search-placeholder-text":"Nome da pasta","add-input-button-text":"Adicionar outra pasta para ignorar"},"files-to-ignore":{name:"Arquivos a ignorar",description:"Arquivos a ignorar ao executar o linter em todos os arquivos ou ao salvar.","file-search-placeholder-text":"regex para arquivos a ignorar","add-input-button-text":"Adicionar outra regex de arquivo para ignorar","label-placeholder-text":"r\xF3tulo","flags-placeholder-text":"flags"},"additional-file-extensions":{name:"Extens\xF5es de arquivo adicionais",description:"Extens\xF5es de arquivo para executar o linter al\xE9m de md. Por exemplo, mdx ou svx. N\xE3o inclua o ponto inicial. <b>Nota: Apenas os arquivos que o Obsidian considera como markdown (seja nativamente ou por meio de outros plugins) sofrer\xE3o a execu\xE7\xE3o do linter, independentemente das extens\xF5es adicionadas.</b>","extension-placeholder":"ex. mdx","add-input-button-text":"Adicionar outra extens\xE3o"},"override-locale":{name:"Substituir localidade",description:"Defina isso se desejar usar uma localidade diferente do padr\xE3o"},"same-as-system-locale":"Mesmo que o sistema ({SYS_LOCALE})","yaml-aliases-section-style":{name:"Estilo da se\xE7\xE3o de aliases do YAML",description:"O estilo da se\xE7\xE3o de aliases do YAML"},"yaml-tags-section-style":{name:"Estilo da se\xE7\xE3o de tags do YAML",description:"O estilo da se\xE7\xE3o de tags do YAML"},"default-array-style":{name:"Estilo de se\xE7\xE3o padr\xE3o do array no YAML",description:"O estilo de outros arrays no YAML que n\xE3o s\xE3o <code>tags</code>, <code>aliases</code> ou que n\xE3o estejam em <code>For\xE7ar valores das chaves a serem arrays de linha \xFAnica</code> e <code>For\xE7ar valores das chaves a serem arrays de m\xFAltiplas linhas</code>"},"default-escape-character":{name:"Caractere de escape padr\xE3o",description:"O caractere padr\xE3o a ser usado para escapar valores no YAML quando aspas simples e duplas n\xE3o estiverem presentes."},"remove-unnecessary-escape-chars-in-multi-line-arrays":{name:"Remover caracteres de escape desnecess\xE1rios em formato de array multilinha",description:"Caracteres de escape para arrays multilinha no YAML n\xE3o precisam do mesmo escape que arrays de linha \xFAnica, portanto, ao estar em formato de multilinha, os escapes extras desnecess\xE1rios ser\xE3o removidos"},"number-of-dollar-signs-to-indicate-math-block":{name:"N\xFAmero de cifr\xF5es para indicar bloco matem\xE1tico",description:"A quantidade de cifr\xF5es para considerar o conte\xFAdo matem\xE1tico como um bloco matem\xE1tico em vez de matem\xE1tica inline"}},debug:{"log-level":{name:"N\xEDvel de log",description:"Os tipos de logs que o servi\xE7o ter\xE1 permiss\xE3o para registrar. O padr\xE3o \xE9 ERROR."},"linter-config":{name:"Configura\xE7\xE3o do linter",description:"O conte\xFAdo do data.json para o Linter no momento do carregamento da p\xE1gina de configura\xE7\xF5es"},"log-collection":{name:"Coletar logs ao executar linter ao salvar e no arquivo atual",description:"Coleta logs quando voc\xEA realiza <code>Executar linter ao salvar</code> e ao executar o linter no arquivo atual. Esses logs podem ser \xFAteis para depura\xE7\xE3o e cria\xE7\xE3o de relat\xF3rios de bugs."},"linter-logs":{name:"Logs do linter",description:"Os logs do \xFAltimo <code>Executar linter ao salvar</code> ou da \xFAltima execu\xE7\xE3o do linter no arquivo atual, se ativado."}}},options:{"custom-command":{name:"Comandos personalizados",description:"Comandos personalizados s\xE3o comandos do Obsidian que s\xE3o executados ap\xF3s o linter finalizar a execu\xE7\xE3o de suas regras regulares. Isso significa que eles n\xE3o s\xE3o executados antes da l\xF3gica de timestamp do YAML, ent\xE3o podem fazer com que o timestamp do YAML seja acionado na pr\xF3xima execu\xE7\xE3o do linter. Voc\xEA pode selecionar um comando do Obsidian apenas uma vez.","add-input-button-text":"Adicionar novo comando","command-search-placeholder-text":"Comando do Obsidian"},"custom-replace":{name:"Substitui\xE7\xE3o de regex personalizada",description:"A substitui\xE7\xE3o de regex personalizada pode ser usada para substituir qualquer coisa que corresponda \xE0 regex de busca pelo valor de substitui\xE7\xE3o. Os valores de substitui\xE7\xE3o e de busca precisar\xE3o ser valores de regex v\xE1lidos.","add-input-button-text":"Adicionar nova substitui\xE7\xE3o de regex","regex-to-find-placeholder-text":"regex de busca","flags-placeholder-text":"flags","regex-to-replace-placeholder-text":"regex de substitui\xE7\xE3o","label-placeholder-text":"r\xF3tulo"},"custom-auto-correct":{"delete-tooltip":"Excluir","show-parsed-contents-tooltip":"Visualizar substitui\xE7\xF5es analisadas","custom-row-parse-warning":'"{ROW}" n\xE3o \xE9 uma linha v\xE1lida de substitui\xE7\xF5es personalizadas. Ela deve ter exatamente 2 colunas.',"file-search-placeholder-text":"Nome do arquivo","add-new-replacement-file-tooltip":"Adicionar outro arquivo personalizado","warning-text":"Arquivos selecionados ter\xE3o {NAME} desativada automaticamente.","refresh-tooltip-text":"Recarregar substitui\xE7\xF5es personalizadas"}},rules:{"auto-correct-common-misspellings":{name:"Corrigir automaticamente erros ortogr\xE1ficos comuns",description:'Usa um dicion\xE1rio de erros ortogr\xE1ficos comuns para convert\xEA-los automaticamente para a ortografia correta. Veja o <a href="https://github.com/platers/obsidian-linter/tree/master/src/utils/default-misspellings.md">mapa de corre\xE7\xE3o autom\xE1tica</a> para a lista completa das palavras corrigidas automaticamente. <b>Nota: essa lista pode funcionar em texto de v\xE1rios idiomas, mas esta mesma lista ser\xE1 aplicada, n\xE3o importa o idioma que esteja em uso.</b>',"ignore-words":{name:"Ignorar palavras",description:"Uma lista separada por v\xEDrgulas de palavras em min\xFAsculas a serem ignoradas na corre\xE7\xE3o autom\xE1tica"},"extra-auto-correct-files":{name:"Arquivos extras de corre\xE7\xE3o autom\xE1tica",description:"Estes s\xE3o arquivos que cont\xEAm uma tabela em markdown com a palavra inicial e a palavra para a qual deve ser corrigida (s\xE3o corre\xE7\xF5es sem distin\xE7\xE3o de mai\xFAsculas e min\xFAsculas). <b>Nota: as tabelas utilizadas devem ter os indicadores <code>|</code> iniciais e finais presentes em cada linha.</b>"},"skip-words-with-multiple-capitals":{name:"Pular palavras com v\xE1rias mai\xFAsculas",description:"Ir\xE1 ignorar quaisquer palavras que tenham uma letra mai\xFAscula al\xE9m da primeira letra. Acr\xF4nimos e algumas outras palavras podem se beneficiar disso. Isso pode causar problemas com a corre\xE7\xE3o adequada de nomes pr\xF3prios."},"default-install":"Voc\xEA est\xE1 usando <code>Corrigir automaticamente erros ortogr\xE1ficos comuns</code>. Para isso, os erros ortogr\xE1ficos padr\xE3o ser\xE3o baixados. Isso deve ocorrer apenas uma vez. Por favor, aguarde...","default-install-failed":"Falha ao baixar {URL}. Desativando <code>Corrigir automaticamente erros ortogr\xE1ficos comuns</code>.","defaults-missing":"Falha ao encontrar o arquivo de corre\xE7\xE3o autom\xE1tica padr\xE3o: {FILE}."},"add-blank-line-after-yaml":{name:"Adicionar linha em branco ap\xF3s YAML",description:"Adiciona uma linha em branco ap\xF3s o bloco YAML se ele n\xE3o for o final do arquivo ou n\xE3o for seguido por pelo menos 1 linha em branco"},"add-blockquote-indentation-on-paste":{name:"Adicionar recuo de cita\xE7\xE3o ao colar",description:"Adiciona cita\xE7\xF5es (blockquotes) a todas as linhas, exceto a primeira, quando o cursor estiver em uma linha de cita\xE7\xE3o/destaque durante a colagem"},"blockquote-style":{name:"Estilo de cita\xE7\xE3o",description:"Garante que o estilo de cita\xE7\xE3o seja consistente.",style:{name:"Estilo",description:"O estilo usado nos indicadores de cita\xE7\xE3o"}},"capitalize-headings":{name:"Capitalizar cabe\xE7alhos",description:"Os cabe\xE7alhos devem ser formatados com capitaliza\xE7\xE3o",style:{name:"Estilo",description:"O estilo de capitaliza\xE7\xE3o a usar"},"ignore-case-words":{name:"Ignorar palavras com mai\xFAsculas",description:"Aplica o estilo Title Case apenas em palavras que estejam totalmente em min\xFAsculas"},"ignore-words":{name:"Ignorar palavras",description:"Uma lista separada por v\xEDrgulas de palavras a serem ignoradas na capitaliza\xE7\xE3o"},"lowercase-words":{name:"Palavras em min\xFAsculas",description:"Uma lista separada por v\xEDrgulas de palavras a manter em min\xFAsculas"},"starting-word-ignore-characters":{name:"Caracteres a ignorar no in\xEDcio de palavras potenciais",description:"Caracteres que podem preceder uma ou mais letras, aspas simples ou tra\xE7os para que o conjunto seja considerado uma palavra"},"ending-word-ignore-characters":{name:"Caracteres a ignorar no final de palavras potenciais",description:"Caracteres que podem seguir uma ou mais letras, aspas simples ou tra\xE7os para que o conjunto seja considerado uma palavra"}},"compact-yaml":{name:"YAML compacto",description:"Remove linhas em branco no in\xEDcio e no final do frontmatter YAML.","inner-new-lines":{name:"Novas linhas internas",description:"Remove novas linhas que n\xE3o est\xE3o no in\xEDcio ou no final do YAML"}},"consecutive-blank-lines":{name:"Linhas em branco consecutivas",description:"Deve haver no m\xE1ximo uma linha em branco consecutiva."},"convert-bullet-list-markers":{name:"Converter marcadores de listas de t\xF3picos",description:"Converte s\xEDmbolos de marcadores de lista comuns para marcadores de lista em markdown."},"convert-spaces-to-tabs":{name:"Converter espa\xE7os em tabs",description:"Converte espa\xE7os iniciais em tabs.",tabsize:{name:"Tamanho do tab",description:"N\xFAmero de espa\xE7os que ser\xE3o convertidos para uma tabula\xE7\xE3o (tab)"}},"dedupe-yaml-array-values":{name:"Desduplicar valores de array no YAML",description:"Remove valores de array duplicados distinguindo mai\xFAsculas de min\xFAsculas.","dedupe-alias-key":{name:"Desduplicar a se\xE7\xE3o de aliases no YAML",description:"Ativa a remo\xE7\xE3o de aliases duplicados."},"dedupe-tag-key":{name:"Desduplicar a se\xE7\xE3o de tags no YAML",description:"Ativa a remo\xE7\xE3o de tags duplicadas."},"dedupe-array-keys":{name:"Desduplicar as se\xE7\xF5es de array no YAML",description:"Ativa a remo\xE7\xE3o de valores duplicados para arrays regulares no YAML"},"ignore-keys":{name:"Chaves do YAML a ignorar para Desduplicar valores de array no YAML",description:"Uma lista de chaves do YAML, sem os dois pontos finais e em linhas separadas, cujos valores duplicados n\xE3o devem ser removidos."}},"default-language-for-code-fences":{name:"Linguagem padr\xE3o para blocos de c\xF3digo",description:"Adiciona uma linguagem padr\xE3o a blocos de c\xF3digo que n\xE3o t\xEAm uma linguagem especificada.","default-language":{name:"Linguagem de programa\xE7\xE3o",description:'Deixe em branco para n\xE3o fazer nada. Tags de linguagens podem ser encontradas <a href="https://prismjs.com/#supported-languages">aqui</a>.'}},"emphasis-style":{name:"Estilo de \xEAnfase",description:"Garante que o estilo de \xEAnfase (it\xE1lico) seja consistente.",style:{name:"Estilo",description:"O estilo usado para denotar conte\xFAdo com \xEAnfase"}},"empty-line-around-blockquotes":{name:"Linha vazia ao redor de cita\xE7\xF5es",description:"Garante que haja uma linha vazia ao redor de cita\xE7\xF5es (blockquotes) a menos que elas iniciem ou terminem um documento. <b>Nota: uma linha vazia \xE9 um n\xEDvel a menos de aninhamento para cita\xE7\xF5es ou um caractere de nova linha.</b>"},"empty-line-around-code-fences":{name:"Linha vazia ao redor de blocos de c\xF3digo",description:"Garante que haja uma linha vazia ao redor de blocos de c\xF3digo a menos que eles iniciem ou terminem um documento."},"empty-line-around-math-blocks":{name:"Linha vazia ao redor de blocos matem\xE1ticos",description:"Garante que haja uma linha vazia ao redor de blocos matem\xE1ticos usando <code>N\xFAmero de cifr\xF5es para indicar bloco matem\xE1tico</code> para determinar quantos cifr\xF5es indicam um bloco matem\xE1tico em matem\xE1tica de linha \xFAnica."},"empty-line-around-tables":{name:"Linha vazia ao redor de tabelas",description:"Garante que haja uma linha vazia ao redor de tabelas no estilo GitHub, a menos que elas iniciem ou terminem um documento."},"escape-yaml-special-characters":{name:"Escapar caracteres especiais no YAML",description:`Faz o escape de dois-pontos seguidos por um espa\xE7o (: ), aspas simples (') e aspas duplas (") no YAML.`,"try-to-escape-single-line-arrays":{name:"Tentar escapar arrays de linha \xFAnica",description:'Tenta fazer o escape de valores de array presumindo que o array come\xE7a com "[", termina com "]" e possui itens delimitados por ",".'}},"file-name-heading":{name:"Cabe\xE7alho de nome do arquivo",description:"Insere o nome do arquivo como um cabe\xE7alho H1 se nenhum cabe\xE7alho H1 existir."},"footnote-after-punctuation":{name:"Nota de rodap\xE9 ap\xF3s pontua\xE7\xE3o",description:"Garante que as refer\xEAncias a notas de rodap\xE9 sejam colocadas ap\xF3s a pontua\xE7\xE3o, e n\xE3o antes."},"force-yaml-escape":{name:"For\xE7ar escape no YAML",description:"Faz o escape dos valores das chaves YAML especificadas.","force-yaml-escape-keys":{name:"For\xE7ar escape em chaves do YAML",description:"Usa o caractere de escape do YAML nas chaves especificadas, separadas por uma quebra de linha, se ainda n\xE3o tiverem escape. N\xE3o use em arrays do YAML."}},"format-tags-in-yaml":{name:"Formatar tags no YAML",description:"Remove hashtags (#) das tags no frontmatter YAML, pois elas tornam as tags inv\xE1lidas."},"format-yaml-array":{name:"Formatar array no YAML",description:"Permite a formata\xE7\xE3o de arrays regulares no YAML como linha m\xFAltipla ou linha \xFAnica e permite que <code>tags</code> e <code>aliases</code> tenham alguns formatos do YAML espec\xEDficos do Obsidian. <b>Nota: de string \xFAnica para linha \xFAnica converte uma entrada de string \xFAnica em um array de linha \xFAnica se houver mais de 1 entrada. O mesmo \xE9 v\xE1lido de string \xFAnica para m\xFAltiplas linhas, exceto que se torna um array multilinha.</b>","alias-key":{name:"Formatar se\xE7\xE3o de aliases no YAML",description:"Ativa a formata\xE7\xE3o para a se\xE7\xE3o de aliases do YAML. Voc\xEA n\xE3o deve ativar esta op\xE7\xE3o junto com a regra <code>Alias do t\xEDtulo no YAML</code>, pois podem n\xE3o funcionar bem em conjunto ou podem ter estilos de formato diferentes selecionados causando resultados inesperados."},"tag-key":{name:"Formatar se\xE7\xE3o de tags no YAML",description:"Ativa a formata\xE7\xE3o para a se\xE7\xE3o de tags do YAML."},"default-array-keys":{name:"Formatar se\xE7\xE3o de array no YAML",description:"Ativa a formata\xE7\xE3o para arrays regulares no YAML"},"force-single-line-array-style":{name:"For\xE7ar valores das chaves a serem arrays de linha \xFAnica",description:"For\xE7a os arrays no YAML correspondentes \xE0s chaves (separadas por novas linhas) a usarem o formato de linha \xFAnica (deixe em branco para desativar)"},"force-multi-line-array-style":{name:"For\xE7ar valores das chaves a serem arrays de m\xFAltiplas linhas",description:"For\xE7a os arrays no YAML correspondentes \xE0s chaves (separadas por novas linhas) a usarem o formato de m\xFAltiplas linhas (deixe em branco para desativar)"}},"header-increment":{name:"Incremento de cabe\xE7alho",description:"N\xEDveis de cabe\xE7alho devem ser incrementados apenas em um n\xEDvel por vez","start-at-h2":{name:"Iniciar incremento de cabe\xE7alho a partir do n\xEDvel 2",description:"Torna o cabe\xE7alho de n\xEDvel 2 o n\xEDvel m\xEDnimo em um arquivo para incremento e altera todos os cabe\xE7alhos de acordo, de forma a come\xE7arem no m\xEDnimo a partir do n\xEDvel 2."}},"heading-blank-lines":{name:"Linhas em branco em cabe\xE7alhos",description:"Todos os cabe\xE7alhos devem ter uma linha em branco tanto antes quanto depois (exceto quando o cabe\xE7alho estiver no in\xEDcio ou no fim do documento).",bottom:{name:"Depois",description:"Garante uma linha em branco ap\xF3s os cabe\xE7alhos (quando desativado n\xE3o remove linhas em branco depois dos cabe\xE7alhos)"},"empty-line-after-yaml":{name:"Linha vazia entre YAML e cabe\xE7alho",description:"Mant\xE9m a linha em branco entre o frontmatter YAML e o cabe\xE7alho"}},"headings-start-line":{name:"Cabe\xE7alhos no in\xEDcio da linha",description:"Cabe\xE7alhos que n\xE3o iniciam uma linha ter\xE3o os espa\xE7os em branco precedentes removidos, garantindo que sejam reconhecidos como cabe\xE7alhos."},"insert-yaml-attributes":{name:"Inserir atributos YAML",description:"Insere os atributos YAML informados no frontmatter YAML. Coloque cada atributo em uma \xFAnica linha.","text-to-insert":{name:"Texto a inserir",description:"Texto a ser inserido no frontmatter YAML"}},"line-break-at-document-end":{name:"Quebra de linha ao final do documento",description:"Garante que haja exatamente uma quebra de linha ao final do documento, se a nota n\xE3o estiver vazia."},"move-footnotes-to-the-bottom":{name:"Mover notas de rodap\xE9 para o fim",description:"Move todas as notas de rodap\xE9 para o final do documento e garante que elas sejam organizadas com base na ordem em que s\xE3o referenciadas no corpo do arquivo.","include-blank-line-between-footnotes":{name:"Incluir linha em branco entre notas de rodap\xE9",description:"Inclui uma linha em branco entre as notas de rodap\xE9 quando ativado."}},"move-math-block-indicators-to-their-own-line":{name:"Mover indicadores de blocos matem\xE1ticos para linha pr\xF3pria",description:"Move todos os indicadores de in\xEDcio e fim de blocos matem\xE1ticos para suas pr\xF3prias linhas, usando o <code>N\xFAmero de cifr\xF5es para indicar bloco matem\xE1tico</code> para determinar quantos cifr\xF5es indicam um bloco matem\xE1tico para express\xF5es em linha \xFAnica."},"move-tags-to-yaml":{name:"Mover tags para o YAML",description:"Move todas as tags para o frontmatter YAML do documento.","how-to-handle-existing-tags":{name:"Opera\xE7\xE3o na tag no corpo do texto",description:"O que fazer com as tags n\xE3o ignoradas no corpo do arquivo ap\xF3s terem sido movidas para o frontmatter"},"tags-to-ignore":{name:"Tags a ignorar",description:"As tags que n\xE3o ser\xE3o movidas para o array de tags ou removidas do conte\xFAdo do corpo caso <code>Remover a hashtag de tags no corpo do conte\xFAdo</code> esteja ativado. Cada tag deve estar em uma nova linha e sem o <code>#</code>. <b>Certifique-se de n\xE3o incluir a hashtag no nome da tag.</b>"}},"no-bare-urls":{name:"Sem URLs sem delimitadores",description:"Envolve as URLs soltas com sinais de menor e maior (< >) exceto quando em crases, colchetes, aspas simples ou aspas duplas.","no-bare-uris":{name:"Sem URIs sem delimitadores",description:"Tenta envolver URIs soltas com sinais de menor e maior (< >) exceto quando em crases, colchetes, aspas simples ou aspas duplas."}},"ordered-list-style":{name:"Estilo de lista ordenada",description:"Garante que as listas ordenadas sigam o estilo especificado. <b>Nota: 2 espa\xE7os ou 1 tabula\xE7\xE3o s\xE3o considerados como um n\xEDvel de indenta\xE7\xE3o.</b>","number-style":{name:"Estilo num\xE9rico",description:"O estilo num\xE9rico usado em indicadores de lista ordenada"},"list-end-style":{name:"Estilo do sufixo do indicador de lista",description:"O caractere final do indicador de lista ordenada"},"preserve-start":{name:"Preservar n\xFAmero inicial",description:"Se o n\xFAmero inicial de uma lista ordenada deve ser preservado. Isso pode ser usado para ter uma lista ordenada com conte\xFAdo inserido entre os itens da lista."}},"paragraph-blank-lines":{name:"Linhas em branco nos par\xE1grafos",description:"Todos os par\xE1grafos devem ter exatamente uma linha em branco tanto antes quanto depois."},"prevent-double-checklist-indicator-on-paste":{name:"Prevenir duplo indicador de checklist ao colar",description:"Remove o indicador inicial de checklist do texto a colar se a linha onde o cursor est\xE1 j\xE1 tiver um indicador de checklist"},"prevent-double-list-item-indicator-on-paste":{name:"Prevenir duplo indicador de item de lista ao colar",description:"Remove o indicador inicial de lista do texto a colar se a linha onde o cursor est\xE1 j\xE1 tiver um indicador de lista"},"proper-ellipsis-on-paste":{name:"Retic\xEAncias adequadas ao colar",description:"Substitui os tr\xEAs pontos consecutivos por retic\xEAncias, mesmo que haja espa\xE7o entre elas, no texto a ser colado"},"proper-ellipsis":{name:"Retic\xEAncias adequadas",description:"Substitui tr\xEAs pontos consecutivos por retic\xEAncias."},"quote-style":{name:"Estilo de aspas",description:"Atualiza as aspas no conte\xFAdo do corpo para os estilos especificados de aspas simples e duplas.","single-quote-enabled":{name:"Ativar Estilo de aspas simples",description:"Especifica que o estilo selecionado para aspas simples deve ser utilizado."},"single-quote-style":{name:"Estilo de aspas simples",description:"O estilo de aspas simples a ser utilizado."},"double-quote-enabled":{name:"Ativar Estilo de aspas duplas",description:"Especifica que o estilo selecionado para aspas duplas deve ser utilizado."},"double-quote-style":{name:"Estilo de aspas duplas",description:"O estilo de aspas duplas a ser utilizado."}},"re-index-footnotes":{name:"Reindexar notas de rodap\xE9",description:"Reindexa as chaves e notas de rodap\xE9, baseando-se na ordem das refer\xEAncias no arquivo. <b>Nota: Esta regra <i>n\xE3o</i> funciona se houver mais de uma nota de rodap\xE9 para a mesma chave.</b>"},"remove-consecutive-list-markers":{name:"Remover marcadores de lista consecutivos",description:"Remove marcadores de lista consecutivos. \xDAtil ao copiar e colar itens de lista."},"remove-empty-lines-between-list-markers-and-checklists":{name:"Remover linhas vazias entre marcadores e checklists",description:"N\xE3o deve haver linhas vazias entre marcadores de lista e checklists."},"remove-empty-list-markers":{name:"Remover marcadores de lista vazios",description:"Remove marcadores de lista vazios, ou seja, itens de lista sem conte\xFAdo."},"empty-line-around-horizontal-rules":{name:"Linha vazia ao redor de r\xE9guas horizontais",description:"Garante que haja uma linha vazia ao redor das r\xE9guas horizontais a menos que iniciem ou terminem o documento."},"remove-hyphenated-line-breaks":{name:"Remover quebras de linha hifenizadas",description:"Remove quebras de linha com h\xEDfen. \xDAtil ao colar textos de livros."},"remove-hyphens-on-paste":{name:"Remover h\xEDfens ao colar",description:"Remove h\xEDfens do texto ao colar"},"remove-leading-or-trailing-whitespace-on-paste":{name:"Remover espa\xE7os em branco iniciais ou finais ao colar",description:"Remove quaisquer espa\xE7os em branco iniciais (exceto tabula\xE7\xF5es) e todos os espa\xE7os em branco finais do texto ao colar"},"remove-leftover-footnotes-from-quote-on-paste":{name:"Remover notas de rodap\xE9 restantes em cita\xE7\xF5es ao colar",description:"Remove quaisquer refer\xEAncias a notas de rodap\xE9 restantes no texto a colar"},"remove-link-spacing":{name:"Remover espa\xE7amento de links",description:"Remove o espa\xE7amento ao redor do texto do link."},"remove-multiple-blank-lines-on-paste":{name:"Remover v\xE1rias linhas em branco ao colar",description:"Condensa v\xE1rias linhas em branco em apenas uma para o texto a colar"},"remove-multiple-spaces":{name:"Remover espa\xE7os m\xFAltiplos",description:"Remove dois ou mais espa\xE7os consecutivos. Ignora espa\xE7os no in\xEDcio e no fim da linha. "},"remove-space-around-characters":{name:"Remover espa\xE7o ao redor de caracteres",description:"Garante que determinados caracteres n\xE3o estejam cercados por espa\xE7os em branco (seja espa\xE7o simples ou tabula\xE7\xE3o). <b>Nota: isso pode causar problemas de formata\xE7\xE3o no markdown em alguns casos.</b>","include-fullwidth-forms":{name:"Incluir formas de largura completa (fullwidth)",description:'Inclui o <a href="https://en.wikipedia.org/wiki/Halfwidth_and_Fullwidth_Forms_(Unicode_block)">bloco Unicode de Formas de Largura Meia e Completa</a>'},"include-cjk-symbols-and-punctuation":{name:"Incluir s\xEDmbolos e pontua\xE7\xE3o CJK",description:'Inclui o <a href="https://en.wikipedia.org/wiki/CJK_Symbols_and_Punctuation">bloco Unicode de S\xEDmbolos e Pontua\xE7\xE3o CJK</a>'},"include-dashes":{name:"Incluir tra\xE7os",description:"Inclui o tra\xE7o curto (\u2013) e o travess\xE3o (\u2014)"},"other-symbols":{name:"Outros s\xEDmbolos",description:"Outros s\xEDmbolos a incluir"}},"remove-space-before-or-after-characters":{name:"Remover espa\xE7o antes ou depois de caracteres",description:"Remove o espa\xE7o antes e depois dos caracteres especificados. <b>Nota: isso pode causar problemas de formata\xE7\xE3o em markdown em alguns casos.</b>","characters-to-remove-space-before":{name:"Remover espa\xE7o antes de caracteres",description:"Remove espa\xE7o antes dos caracteres especificados. <b>Nota: usar <code>{</code> ou <code>}</code> na lista de caracteres afetar\xE1 inesperadamente os arquivos, pois s\xE3o usados na sintaxe de ignorar nos bastidores.</b>"},"characters-to-remove-space-after":{name:"Remover espa\xE7o ap\xF3s caracteres",description:"Remove o espa\xE7o ap\xF3s os caracteres especificados. <b>Nota: usar <code>{</code> ou <code>}</code> na lista de caracteres afetar\xE1 inesperadamente os arquivos, pois s\xE3o usados na sintaxe de ignorar nos bastidores.</b>"}},"remove-trailing-punctuation-in-heading":{name:"Remover pontua\xE7\xE3o final em cabe\xE7alhos",description:'Remove as pontua\xE7\xF5es especificadas do fim dos cabe\xE7alhos, certificando-se de ignorar o ponto e v\xEDrgula no fim de <a href="https://en.wikipedia.org/wiki/List_of_XML_and_HTML_character_entity_references">refer\xEAncias e entidades HTML</a>.',"punctuation-to-remove":{name:"Pontua\xE7\xE3o final",description:"A pontua\xE7\xE3o final a ser removida dos cabe\xE7alhos do arquivo."}},"remove-yaml-keys":{name:"Remover chaves do YAML",description:"Remove as chaves especificadas do YAML","yaml-keys-to-remove":{name:"Chaves do YAML a remover",description:"As chaves do YAML a serem removidas do frontmatter, com ou sem dois-pontos"}},"sort-yaml-array-values":{name:"Ordenar valores de array no YAML",description:"Ordena os valores dos arrays no YAML com base na ordem de classifica\xE7\xE3o especificada.","sort-alias-key":{name:"Ordenar a se\xE7\xE3o de aliases do YAML",description:"Ativa a ordena\xE7\xE3o de aliases."},"sort-tag-key":{name:"Ordenar a se\xE7\xE3o de tags do YAML",description:"Ativa a ordena\xE7\xE3o de tags."},"sort-array-keys":{name:"Ordenar se\xE7\xF5es de arrays no YAML",description:"Ativa a ordena\xE7\xE3o de valores para arrays regulares no YAML"},"ignore-keys":{name:"Chaves do YAML a ignorar para Ordenar valores de array no YAML",description:"Uma lista de chaves do YAML sem os dois pontos finais em linhas pr\xF3prias que n\xE3o devem ter seus valores ordenados."},"sort-order":{name:"Ordem de classifica\xE7\xE3o",description:"A forma de ordenar os valores do array do YAML."}},"space-after-list-markers":{name:"Espa\xE7os ap\xF3s marcadores de lista",description:"Deve haver um \xFAnico espa\xE7o ap\xF3s os marcadores de lista e checkboxes."},"space-between-chinese-japanese-or-korean-and-english-or-numbers":{name:"Espa\xE7o entre Chin\xEAs, Japon\xEAs ou Coreano e Ingl\xEAs ou n\xFAmeros",description:'Garante que os idiomas Chin\xEAs, Japon\xEAs ou Coreano e Ingl\xEAs ou n\xFAmeros sejam separados por um \xFAnico espa\xE7o. Segue essas <a href="https://github.com/sparanoid/chinese-copywriting-guidelines">diretrizes</a>',"english-symbols-punctuation-before":{name:"S\xEDmbolos e pontua\xE7\xF5es do ingl\xEAs antes de CJK",description:'A lista de pontua\xE7\xF5es e s\xEDmbolos n\xE3o-letras a considerar como sendo do Ingl\xEAs quando encontrados antes de caracteres Chineses, Japoneses ou Coreanos. <b>Nota: "*" \xE9 sempre considerado como sendo Ingl\xEAs e \xE9 necess\xE1rio para lidar adequadamente com algumas sintaxes de markdown.</b>'},"english-symbols-punctuation-after":{name:"S\xEDmbolos e pontua\xE7\xF5es do ingl\xEAs depois de CJK",description:'A lista de pontua\xE7\xF5es e s\xEDmbolos n\xE3o-letras a considerar como sendo do Ingl\xEAs quando encontrados depois de caracteres Chineses, Japoneses ou Coreanos. <b>Nota: "*" \xE9 sempre considerado como sendo Ingl\xEAs e \xE9 necess\xE1rio para lidar adequadamente com algumas sintaxes de markdown.</b>'}},"strong-style":{name:"Estilo de negrito",description:"Garante que o estilo de negrito seja consistente.",style:{name:"Estilo",description:"O estilo usado para denotar conte\xFAdo em negrito"}},"trailing-spaces":{name:"Espa\xE7os finais",description:"Remove espa\xE7os extras no final de todas as linhas.","two-space-line-break":{name:"Quebra de linha com dois espa\xE7os",description:'Ignora dois espa\xE7os seguidos de uma quebra de linha ("Regra dos Dois Espa\xE7os").'}},"two-spaces-between-lines-with-content":{name:"Quebra de linha entre linhas com conte\xFAdo",description:"Garante que a quebra de linha especificada seja adicionada aos fins de linhas com conte\xFAdo que continuam na pr\xF3xima linha para par\xE1grafos, blockquotes e itens de lista","line-break-indicator":{name:"Indicador de quebra de linha",description:"O indicador de quebra de linha a ser utilizado."}},"unordered-list-style":{name:"Estilo de lista n\xE3o ordenada",description:"Garante que as listas n\xE3o ordenadas sigam o estilo especificado.","list-style":{name:"Estilo de item de lista",description:"O estilo de item de lista a usar em listas n\xE3o ordenadas"}},"yaml-key-sort":{name:"Ordenar chaves do YAML",description:"Ordena as chaves do YAML baseando-se na ordem e prioridade especificadas. <b>Nota: tamb\xE9m pode remover linhas em branco. Funciona apenas em chaves n\xE3o aninhadas.</b>","yaml-key-priority-sort-order":{name:"Ordem de classifica\xE7\xE3o e prioridade de chaves do YAML",description:"A ordem pela qual classificar as chaves, colocando uma em cada linha, sendo ordenadas conforme aparecem na lista"},"priority-keys-at-start-of-yaml":{name:"Chaves priorit\xE1rias no in\xEDcio do YAML",description:'Posiciona as chaves da "Ordem de Classifica\xE7\xE3o de Chaves do YAML" no in\xEDcio do frontmatter YAML'},"yaml-sort-order-for-other-keys":{name:"Ordem de classifica\xE7\xE3o do YAML para outras chaves",description:"A forma de classificar as chaves que n\xE3o se encontram na \xE1rea de texto de Ordem de Classifica\xE7\xE3o de Chaves do YAML"}},"yaml-timestamp":{name:"Timestamp no YAML",description:"Acompanha a data em que o arquivo foi editado pela \xFAltima vez no frontmatter YAML. Obt\xE9m as datas a partir dos metadados do arquivo.","date-created":{name:"Data de cria\xE7\xE3o",description:"Inserir a data de cria\xE7\xE3o do arquivo"},"date-created-key":{name:"Chave de data de cria\xE7\xE3o",description:"Qual chave do YAML usar para a data de cria\xE7\xE3o"},"date-created-source-of-truth":{name:"Fonte da verdade da data de cria\xE7\xE3o",description:"Especifica de onde obter o valor da data de cria\xE7\xE3o se ela j\xE1 estiver presente no frontmatter."},"date-modified-source-of-truth":{name:"Fonte da verdade da data de modifica\xE7\xE3o",description:"Especifica qual m\xE9todo deve ser usado para determinar quando a data de modifica\xE7\xE3o deve ser atualizada caso ela esteja presente no frontmatter."},"date-modified":{name:"Data de modifica\xE7\xE3o",description:"Inserir a data em que o arquivo foi modificado pela \xFAltima vez"},"date-modified-key":{name:"Chave da data de modifica\xE7\xE3o",description:"Qual chave do YAML usar para a data de modifica\xE7\xE3o"},format:{name:"Formato",description:'Formato de data do Moment a utilizar (veja as <a href="https://momentjscom.readthedocs.io/en/latest/moment/04-displaying/01-format/">op\xE7\xF5es de formato do Moment</a>)'},"convert-to-utc":{name:"Converter hor\xE1rio local para UTC",description:"Usa a equival\xEAncia em UTC para datas salvas em vez do hor\xE1rio local"},"update-on-file-contents-updated":{name:"Atualizar timestamp no YAML ao atualizar o conte\xFAdo do arquivo",description:"Quando a nota atualmente ativa for modificada, o <code>Timestamp no YAML</code> ser\xE1 executado na nota. Isso deve atualizar o timestamp da nota se diferir do valor atual em mais de 5 segundos."}},"yaml-title-alias":{name:"Alias do t\xEDtulo no YAML",description:"Insere ou atualiza o t\xEDtulo do arquivo na se\xE7\xE3o de aliases do frontmatter YAML. Obt\xE9m o t\xEDtulo do primeiro H1 ou do nome do arquivo.","preserve-existing-alias-section-style":{name:"Preservar estilo da se\xE7\xE3o de aliases existentes",description:"Se definido, a configura\xE7\xE3o <code>Estilo da se\xE7\xE3o de aliases no YAML</code> ser\xE1 aplicada apenas nas se\xE7\xF5es rec\xE9m-criadas"},"keep-alias-that-matches-the-filename":{name:"Manter alias que corresponda ao nome do arquivo",description:"Tais aliases geralmente s\xE3o redundantes"},"use-yaml-key-to-keep-track-of-old-filename-or-heading":{name:"Usar a chave do YAML especificada por Chave auxiliar de alias para ajudar com altera\xE7\xF5es no nome do arquivo e cabe\xE7alho",description:"Se ativado, ao alterar o primeiro cabe\xE7alho H1 (ou o nome do arquivo, caso n\xE3o haja H1), o alias antigo guardado nessa chave ser\xE1 substitu\xEDdo pelo novo valor em vez de apenas inserir uma nova entrada no array de aliases"},"alias-helper-key":{name:"Chave auxiliar de alias",description:"A chave a ser utilizada para ajudar a rastrear qual foi o \xFAltimo nome de arquivo ou cabe\xE7alho salvo no frontmatter por esta regra."}},"yaml-title":{name:"T\xEDtulo no YAML",description:"Insere o t\xEDtulo do arquivo no frontmatter YAML. Obt\xE9m o t\xEDtulo baseando-se no modo selecionado.","title-key":{name:"Chave de t\xEDtulo",description:"Qual chave do YAML usar para o t\xEDtulo"},mode:{name:"Modo",description:"O m\xE9todo a usar para obter o t\xEDtulo"}}},enums:{"Title Case":"Title Case","ALL CAPS":"TUDO EM MAI\xDASCULAS","First letter":"Primeira letra",".":".",")":")",ERROR:"erro",TRACE:"trace",DEBUG:"debug",INFO:"info",WARN:"aviso",SILENT:"silencioso",ascending:"ascendente",lazy:"lazy",preserve:"preservar",Nothing:"Nada","Remove hashtag":"Remover hashtag","Remove whole tag":"Remover tag inteira",asterisk:"asterisco",underscore:"sublinhado",consistent:"consistente","-":"-","*":"*","+":"+",space:"espa\xE7o","no space":"sem espa\xE7o",None:"Nenhum","Ascending Alphabetical":"Alfab\xE9tica Ascendente","Descending Alphabetical":"Alfab\xE9tica Descendente","multi-line":"v\xE1rias linhas","single-line":"linha \xFAnica","single string to single-line":"string \xFAnica para linha \xFAnica","single string to multi-line":"string \xFAnica para v\xE1rias linhas","single string comma delimited":"string \xFAnica delimitada por v\xEDrgulas","single string space delimited":"string \xFAnica delimitada por espa\xE7os","single-line space delimited":"linha \xFAnica delimitada por espa\xE7os","first-h1":"Primeiro H1","first-h1-or-filename-if-h1-missing":"Primeiro H1 ou Nome do Arquivo se H1 estiver ausente",filename:"Nome do arquivo",never:"Nunca","after 5 seconds":"Ap\xF3s 5 segundos","after 10 seconds":"Ap\xF3s 10 segundos","after 15 seconds":"Ap\xF3s 15 segundos","after 30 seconds":"Ap\xF3s 30 segundos","after 1 minute":"Ap\xF3s 1 minuto","file system":"Sistema de arquivos",frontmatter:"Frontmatter YAML","user or Linter edits":"Altera\xE7\xF5es no Obsidian","''":"''","\u2018\u2019":"\u2018\u2019",'""':'""',"\u201C\u201D":"\u201C\u201D","\\":"\\","<br>":"<br>","  ":"  ","<br/>":"<br/>"}};var Mf={};var Of={commands:{"lint-file":{name:"\u041B\u0438\u043D\u0442 \u0442\u0435\u043A\u0443\u0449\u0435\u0433\u043E \u0444\u0430\u0439\u043B\u0430","error-message":"\u041E\u0448\u0438\u0431\u043A\u0430 \u043F\u0440\u0438 \u043B\u0438\u043D\u0442\u0435 \u0442\u0435\u043A\u0443\u0449\u0435\u0433\u043E \u0444\u0430\u0439\u043B\u0430"},"lint-file-unless-ignored":{name:"\u041B\u0438\u043D\u0442 \u0442\u0435\u043A\u0443\u0449\u0435\u0433\u043E \u0444\u0430\u0439\u043B\u0430, \u0435\u0441\u043B\u0438 \u043E\u043D \u043D\u0435 \u0438\u0433\u043D\u043E\u0440\u0438\u0440\u0443\u0435\u0442\u0441\u044F"},"lint-all-files":{name:"\u041B\u0438\u043D\u0442 \u0432\u0441\u0435\u0445 \u0444\u0430\u0439\u043B\u043E\u0432 \u0432 \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435","error-message":"\u041E\u0448\u0438\u0431\u043A\u0430 \u043F\u0440\u0438 \u043B\u0438\u043D\u0442\u0435 \u0432\u0441\u0435\u0445 \u0444\u0430\u0439\u043B\u043E\u0432","success-message":"\u041B\u0438\u043D\u0442 \u0432\u0441\u0435\u0445 \u0444\u0430\u0439\u043B\u043E\u0432 \u043F\u0440\u043E\u0448\u0435\u043B \u0443\u0441\u043F\u0435\u0448\u043D\u043E","errors-message-singular":"\u041B\u0438\u043D\u0442\u0435\u0440 \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0432\u0441\u0435 \u0444\u0430\u0439\u043B\u044B \u0441 1 \u043E\u0448\u0438\u0431\u043A\u043E\u0439.","errors-message-plural":"\u041B\u0438\u043D\u0442\u0435\u0440 \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0432\u0441\u0435 \u0444\u0430\u0439\u043B\u044B \u0441 {NUM} \u043E\u0448\u0438\u0431\u043E\u043A.","start-message":"\u042D\u0442\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u0442 \u0432\u0441\u0435 \u0432\u0430\u0448\u0438 \u0444\u0430\u0439\u043B\u044B \u0438 \u043C\u043E\u0436\u0435\u0442 \u0432\u044B\u0437\u0432\u0430\u0442\u044C \u043E\u0448\u0438\u0431\u043A\u0438.","submit-button-text":"\u041B\u0438\u043D\u0442 \u0432\u0441\u0435\u0433\u043E","submit-button-notice-text":"\u041B\u0438\u043D\u0442 \u0432\u0441\u0435\u0445 \u0444\u0430\u0439\u043B\u043E\u0432..."},"lint-all-files-in-folder":{name:"\u041B\u0438\u043D\u0442 \u0432\u0441\u0435\u0445 \u0444\u0430\u0439\u043B\u043E\u0432 \u0432 \u0442\u0435\u043A\u0443\u0449\u0435\u0439 \u043F\u0430\u043F\u043A\u0435","start-message":"\u042D\u0442\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u0442 \u0432\u0441\u0435 \u0444\u0430\u0439\u043B\u044B \u0432 {FOLDER_NAME}, \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u0444\u0430\u0439\u043B\u044B \u0432 \u043F\u043E\u0434\u043F\u0430\u043F\u043A\u0430\u0445, \u0447\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u0432\u044B\u0437\u0432\u0430\u0442\u044C \u043E\u0448\u0438\u0431\u043A\u0438.","submit-button-text":"\u041B\u0438\u043D\u0442 \u0432\u0441\u0435\u0445 \u0444\u0430\u0439\u