diff --git a/.obsidian/plugins/touchpad-swipe-nav/main.js b/.obsidian/plugins/touchpad-swipe-nav/main.js
index 11ed766a3c3edb9a21d13b75249b49dbef3bcf9b..3047d0a2d6cb44a0f2588a44273e9faf2c608b9a 100644
--- a/.obsidian/plugins/touchpad-swipe-nav/main.js
+++ b/.obsidian/plugins/touchpad-swipe-nav/main.js
@@ -1,6 +1,7 @@
 /**
- * Obsidian Plugin: Touchpad Swipe Navigation
- * Handles 2-finger swipe gestures for history navigation (Back/Forward).
+ * タッチパッドの2本指の横スワイプで、履歴の戻る・進むを行うプラグイン
+ * - 横スクロールできる表やコード、Excalidraw、CAD の図の上では、スクロールや移動を優先して戻る・進むにしない
+ * - 戻る・進むは Obsidian のコマンドで行う（新しいタブを作らない）
  */
 const { Plugin, Notice } = require('obsidian');
 
@@ -33,6 +34,11 @@ module.exports = class TouchpadSwipeNavPlugin extends Plugin {
             return;
         }
 
+        if (this.isHorizontalPanTarget(e.target)) {
+            this.accumulatedDeltaX = 0;
+            return;
+        }
+
         const now = Date.now();
 
         // Reset accumulation if too much time passed
@@ -60,21 +66,20 @@ module.exports = class TouchpadSwipeNavPlugin extends Plugin {
         }
     }
 
-    triggerBack() {
-        const leaf = this.app.workspace.getLeaf();
-        if (leaf && leaf.history) {
-            leaf.history.back();
-        } else {
-            this.app.commands.executeCommandById('app:go-back');
+    // 横へのスクロールや移動に使う場所か（図の上、または横にはみ出してスクロールできる要素の中）
+    isHorizontalPanTarget(target) {
+        for (let el = target; el && el.nodeType === 1; el = el.parentElement) {
+            if (el.matches('.excalidraw, .step-viewer-embed, .step-viewer-content, canvas')) return true;
+            if (el.scrollWidth > el.clientWidth + 1 && /auto|scroll/.test(getComputedStyle(el).overflowX)) return true;
         }
+        return false;
+    }
+
+    triggerBack() {
+        this.app.commands.executeCommandById('app:go-back');
     }
 
     triggerForward() {
-        const leaf = this.app.workspace.getLeaf();
-        if (leaf && leaf.history) {
-            leaf.history.forward();
-        } else {
-            this.app.commands.executeCommandById('app:go-forward');
-        }
+        this.app.commands.executeCommandById('app:go-forward');
     }
 }
