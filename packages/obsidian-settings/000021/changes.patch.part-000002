+describe('getFileDisplayName', () => {
+    test('ノートは拡張子なしで表示する', () => {
+        assert.strictEqual(getFileDisplayName({ basename: 'メモ', extension: 'md' }), 'メモ');
+        assert.strictEqual(getFileDisplayName({ basename: '図.excalidraw', extension: 'md' }), '図.excalidraw');
+    });
+
+    test('ノート以外は拡張子を付けて表示する', () => {
+        assert.strictEqual(getFileDisplayName({ basename: 'sample-1793589932156', extension: 'webp' }), 'sample-1793589932156.webp');
+        assert.strictEqual(getFileDisplayName({ basename: '資料', extension: 'PDF' }), '資料.PDF');
+    });
+
+    test('拡張子が空なら名前のまま表示する', () => {
+        assert.strictEqual(getFileDisplayName({ basename: 'LICENSE', extension: '' }), 'LICENSE');
+    });
+});
diff --git a/.obsidian/plugins/obsidian-sidebar-explorer/utils.ts b/.obsidian/plugins/obsidian-sidebar-explorer/utils.ts
index eae57755909da0f52d7fed9ea333e354ef236ade..e96dc2927c7a4dc189486d20e4406dcef2b43b37 100644
--- a/.obsidian/plugins/obsidian-sidebar-explorer/utils.ts
+++ b/.obsidian/plugins/obsidian-sidebar-explorer/utils.ts
@@ -181,6 +181,15 @@ export function isAttachmentFile(file: { extension: string }): boolean {
     return file.extension.toLowerCase() !== 'md' && ATTACHMENT_EXTENSIONS.has(file.extension.toLowerCase());
 }
 
+/**
+ * サイドバーに出すファイル名。ノート（.md）は拡張子なし、それ以外は拡張子付きにして画像・PDF などと見分けられるようにする。
+ */
+export function getFileDisplayName(file: { basename: string; extension: string }): string {
+    const extension = file.extension;
+    if (!extension || extension.toLowerCase() === 'md') return file.basename;
+    return `${file.basename}.${extension}`;
+}
+
 export function isImageFile(file: { extension: string }): boolean {
     return IMAGE_EXTENSIONS.has(file.extension.toLowerCase());
 }
