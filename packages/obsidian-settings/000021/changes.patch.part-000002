diff --git a/.obsidian/snippets/excalidraw-embed-width.css b/.obsidian/snippets/excalidraw-embed-width.css
index bfa7131d03d74cbce8f058206a274e1ccf9a4b9c..911f05750b8571a1ad3358547e3e1396f277055d 100644
--- a/.obsidian/snippets/excalidraw-embed-width.css
+++ b/.obsidian/snippets/excalidraw-embed-width.css
@@ -79,6 +79,21 @@ iframe[src*="Excalidraw"] {
     vertical-align: top;
 }
 
+/* Image Converter の整列を優先する。上の inline-flex のままだと中央揃え・右揃えが効かないため、
+   枠の幅は画像に合わせたまま（リサイズハンドルが画像の角に付くように）枠ごと寄せる。 */
+.image-embed.image-position-center[data-figure-name]:not([data-figure-kind="excalidraw"]) {
+    display: flex !important;
+    width: fit-content;
+    margin-inline: auto !important;
+}
+
+.image-embed.image-position-right.image-no-wrap[data-figure-name]:not([data-figure-kind="excalidraw"]) {
+    display: flex !important;
+    width: fit-content;
+    margin-left: auto !important;
+    margin-right: 0 !important;
+}
+
 /* Excalidraw変換の前後とも縦配置にし、本体の幅指定には触れない。 */
 .media-embed[data-figure-name][data-figure-kind="excalidraw"],
 .internal-embed[data-figure-name][data-figure-kind="excalidraw"],
@@ -204,12 +219,17 @@ iframe[src*="Excalidraw"] {
 }
 
 /* PDF埋め込みのドラッグリサイズ（右端: 幅、下端: 高さ、右下隅: 幅と高さ）
-   幅はスクリプトが埋め込み要素へ px で当てる。狭いペインでははみ出さないよう親の幅までに抑える。 */
+   幅はスクリプトが CSS 変数 --pdf-embed-width で渡す。狭いペインでははみ出さないよう親の幅までに抑える。 */
 .markdown-source-view .internal-embed.pdf-embed,
 .markdown-preview-view .internal-embed.pdf-embed {
     max-width: 100%;
 }
 
+/* 指定された幅。heading-level-indent が文字入力のたびに style.width を上書きしても動かないよう !important で当てる */
+.internal-embed.pdf-embed.is-pdf-width-fixed {
+    width: var(--pdf-embed-width) !important;
+}
+
 .custom-pdf-resizer-handle {
     position: absolute !important;
     z-index: 100;
@@ -258,3 +278,48 @@ iframe[src*="Excalidraw"] {
 .internal-embed.pdf-embed.is-pdf-resizing > .custom-pdf-resizer-handle {
     opacity: 1 !important;
 }
+
+/* iframe 埋め込みのドラッグリサイズ（右下隅。縦横比は固定）と Option + ホイールの拡大縮小
+   ハンドルの位置はスクリプトが iframe の右下隅へ合わせる。狭いペインでははみ出さないよう親の幅までに抑える。 */
+.markdown-source-view iframe,
+.markdown-preview-view iframe {
+    max-width: 100%;
+}
+
+.custom-iframe-resize-host {
+    position: relative;
+}
+
+.custom-iframe-resizer-handle {
+    position: absolute !important;
+    z-index: 100;
+    width: 18px;
+    height: 18px;
+    opacity: 0;
+    transition: opacity 0.15s ease;
+    box-sizing: border-box;
+    cursor: nwse-resize !important;
+    border-right: 4px solid var(--interactive-accent);
+    border-bottom: 4px solid var(--interactive-accent);
+    border-radius: 0 0 4px 0;
+    user-select: none;
+    -webkit-user-drag: none;
+}
+
+.custom-iframe-resize-host:hover > .custom-iframe-resizer-handle {
+    opacity: 0.6;
+}
+
+.custom-iframe-resizer-handle:hover,
+.custom-iframe-resizer-handle.is-resizing {
+    opacity: 1 !important;
+}
+
+/* iframe の中ではホイールもマウス操作も iframe が受け取り、ノートへ届かない。
+   Option を押している間と、ドラッグ中だけ iframe のマウス操作を無効にして、外側で受け取る。
+   画像の iframe は、中の文書（srcdoc）が自分でホイールを受け取るため、Option を押している間は無効にしない。 */
+body.custom-iframe-alt-held .markdown-source-view iframe:not(.custom-iframe-image-viewer),
+body.custom-iframe-alt-held .markdown-preview-view iframe:not(.custom-iframe-image-viewer),
+body.custom-iframe-dragging iframe {
+    pointer-events: none;
+}
