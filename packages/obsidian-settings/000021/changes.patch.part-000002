u043E\u0431\u044B \u0431\u044B\u043B\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u043D\u0430 \u0441\u043D\u043E\u0441\u043A\u0430 \u043D\u0430 \u043A\u043B\u044E\u0447 \u0441\u043D\u043E\u0441\u043A\u0438.","wrapper-yaml-error":"\u043E\u0448\u0438\u0431\u043A\u0430 \u0432 YAML: {ERROR_MESSAGE}","wrapper-unknown-error":"\u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430\u044F \u043E\u0448\u0438\u0431\u043A\u0430: {ERROR_MESSAGE}"},"notice-text":{"empty-clipboard":"\u041D\u0435\u0442 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0433\u043E \u0432 \u0431\u0443\u0444\u0435\u0440\u0435 \u043E\u0431\u043C\u0435\u043D\u0430.","characters-added":"\u0441\u0438\u043C\u0432\u043E\u043B\u043E\u0432 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u043E","characters-removed":"\u0441\u0438\u043C\u0432\u043E\u043B\u043E\u0432 \u0443\u0434\u0430\u043B\u0435\u043D\u043E"},"all-rules-option":"\u0412\u0441\u0435","linter-title":"\u041B\u0438\u043D\u0442\u0435\u0440","empty-search-results-text":"\u041D\u0435\u0442 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043A, \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0445 \u043F\u043E\u0438\u0441\u043A\u0443","warning-text":"\u041F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435","file-backup-text":"\u0423\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044C, \u0447\u0442\u043E \u0432\u044B \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438 \u0441\u0432\u043E\u0438 \u0444\u0430\u0439\u043B\u044B.","custom-command-warning":"\u041B\u0438\u043D\u0442 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445 \u0444\u0430\u0439\u043B\u043E\u0432 \u0441 \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u043D\u044B\u043C\u0438 \u043A\u0430\u0441\u0442\u043E\u043C\u043D\u044B\u043C\u0438 \u043A\u043E\u043C\u0430\u043D\u0434\u0430\u043C\u0438 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u043C \u043F\u0440\