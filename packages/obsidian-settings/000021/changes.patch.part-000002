+    reorderMenuItemsLater(menu, 50, { prepend: IMAGE_MENU_PREPEND_TITLES });
+    flushNativeMenuReorders(menu);
+};
+
+const patchImageConverterContextMenu = () => {
+    const contextMenu = getImageConverterContextMenu();
+    if (!contextMenu) return;
+    // テンプレートを読み直しても二重に足さないよう、元の関数から包み直す
+    const original = contextMenu._customOriginalCreateContextMenuItems || contextMenu.createContextMenuItems;
+    contextMenu._customOriginalCreateContextMenuItems = original;
+    contextMenu.createContextMenuItems = function (menu, imgEl, ...rest) {
