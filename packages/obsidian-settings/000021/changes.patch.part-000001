-MM/DD/YYYY h:mm:ss a → 01/04/2025 2:30:45 PM`},supportDevelopment:{name:"Support development",desc:"If you love using Notebook Navigator, please consider supporting its continued development.",buttonText:"❤️ Sponsor",coffeeButton:"☕️ Buy me a coffee"},otherPlugins:{name:"Check out my other plugins",betterPaste:"Clean up pasted text, links and images",pixelPerfectImage:"Exact image resizing and more"},checkForNewVersionOnStart:{name:"Check for new version on start",desc:"Checks for new plugin releases on startup and shows a notification when an update is available. Checks occur at most once per day.",status:"New version available: {version}"},startupDebugLogging:{name:"Startup debug logging",desc:"Write startup diagnostics to a timestamped markdown file in the vault root, then stop after startup settles. The file may sync and can include file paths."},whatsNew:{name:"What's new in Notebook Navigator {version}",desc:"See recent updates and improvements",buttonText:"View recent updates"},showReleaseNotes:{name:"Show release notes after updating",desc:"Disable to stop the What's new dialog from opening automatically after updates."},masteringVideo:{name:"Mastering Notebook Navigator (video)",desc:"This video covers everything you need to be productive in Notebook Navigator, including hot keys, search, tags and advanced customization."},cacheStatistics:{localCache:"Local cache",items:"items",withTags:"with tags",withPreviewText:"with preview text",withFeatureImage:"with feature image",withMetadata:"with metadata"},metadataInfo:{successfullyParsed:"Successfully parsed",itemsWithName:"items with name",withCreatedDate:"with created date",withModifiedDate:"with modified date",withIcon:"with icon",withColor:"with color",failedToParse:"Failed to parse",createdDates:"created dates",modifiedDates:"modified dates",checkTimestampFormat:"Check your timestamp format.",exportFailed:"Export errors"}}},whatsNew:{title:"What's new in Notebook Navigator",openBannerImage:"Open release banner image",supportMessage:"If you find Notebook Navigator helpful, please consider supporting its development.",supportButton:"Buy me a coffee",thanksButton:"Thanks!"}}});var OL,bu,GN=z(()=>{OL="e6a5d8c3eab9e80fbbe70fcf4e6aeb2af21bc18cf28fed432a25954f02b36918",bu={ar:{dateFormat:"D MMM YYYY",timeFormat:"h:mm a",defaultVaultProfileName:"افتراضي",bootstrap:{downloading:"جارٍ تنزيل اللغات…",continueInEnglish:"المتابعة بالإنجليزية",downloadFailed:"تعذّر تنزيل اللغات. يستخدم Notebook Navigator اللغة الإنجليزية."},formatters:{"paneHeader.applySortAndGroupToDescendants":t=>`تطبيق الفرز والتجميع على ${t}`,"paneHeader.applyAppearanceToDescendants":t=>`تطبيق المظهر على ${t}`,"paneHeader.resetAppearanceInDescendants":t=>`إعادة تعيين المظهر في ${t}`,"folderAppearance.titleRows.option":t=>t===1?"صف عنوان واحد":t===2?"صفا عنوان":`${t} صفوف عنوان`,"folderAppearance.previewRows.option":t=>t===1?"صف معاينة واحد":t===2?"صفا معاينة":`${t} صفوف معاينة`,"modals.bulkApply.applySortAndGroupTitle":t=>`تطبيق الفرز والتجميع على ${t}؟`,"modals.bulkApply.applyAppearanceTitle":t=>`تطبيق المظهر على ${t}؟`,"modals.bulkApply.resetAppearanceTitle":t=>`إعادة تعيين المظهر في ${t}؟`,"modals.bulkApply.applyAppearanceMessage":(t,e)=>`سيتغير المظهر لـ ${t} من العناصر. المظاهر المخصصة الحالية التي ستُستبدل: ${e}. تُنسخ تفضيلات المظهر المحفوظة مرة واحدة؛ ويُحتفظ بالفرز والتجميع. لا ترتبط التغييرات المستقبلية والعناصر الفرعية الجديدة.`,"modals.bulkApply.resetAppearanceMessage":t=>`سيُعاد تعيين المظهر لـ ${t} من العناصر. يُحتفظ بالفرز والتجميع. هذا تغيير لمرة واحدة؛ ولا ترتبط التغييرات المستقبلية والعناصر الفرعية الجديدة.`,"modals.bulkApply.affectedCountMessage":t=>`التجاوزات الحالية التي ستتغير: ${t}.`,"modals.manualSortConfirm.propertySortMessage":(t,e)=>`يبدّل العرض الحالي إلى الفرز اليدوي باستخدام "${t}". تحرير الترتيب يكتب قيم فهرس رقمية إلى تلك الخاصية في ${e} من الملاحظات حسب الحاجة.`,"modals.manualSortConfirm.removePropertyMessage":(t,e)=>`يؤدي هذا إلى إزالة "${t}" من ${e} من الملاحظات في القائمة الحالية. سيتم مسح ترتيب الفرز اليدوي لتلك الملاحظات.`,"modals.manualSortConfirm.compactMessage":t=>`إعادة الترتيب هذه تحتاج إلى مساحة رقمية أكبر. ${t} من الملاحظات ستحصل على قيم فهرس جديدة.`,"modals.navRainbowSection.title":t=>`ألوان قوس قزح: ${t}`,"modals.folderSuggest.placeholder":t=>`نقل ${t} إلى مجلد...`,"modals.folderSuggest.multipleFilesLabel":t=>`${t} من الملفات`}},de:{dateFormat:"DD.MM.YYYY",timeFormat:"HH:mm",defaultVaultProfileName:"Standard",bootstrap:{downloading:"Sprachen werden heruntergeladen…",continueInEnglish:"Auf Englisch fortfahren",downloadFailed:"Sprachdownload fehlgeschlagen. Notebook Navigator verwendet Englisch."},formatters:{"paneHeader.applySortAndGroupToDescendants":t=>`Sortierung und Gruppierung auf ${t} anwenden`,"paneHeader.applyAppearanceToDescendants":t=>`Darstellung auf ${t} anwenden`,"paneHeader.resetAppearanceInDescendants":t=>`Darstellung für ${t} zurücksetzen`,"folderAppearance.titleRows.option":t=>`${t} Titelzeile${t===1?"":"n"}`,"folderAppearance.previewRows.option":t=>`${t} Vorschauzeile${t===1?"":"n"}`,"modals.bulkApply.applySortAndGroupTitle":t=>`Sortierung und Gruppierung auf ${t} anwenden?`,"modals.bulkApply.applyAppearanceTitle":t=>`Darstellung auf ${t} anwenden?`,"modals.bulkApply.resetAppearanceTitle":t=>`Darstellung für ${t} zurücksetzen?`,"modals.bulkApply.applyAppearanceMessage":(t,e)=>`Die Darstellung ändert sich für ${t} ${t===1?"Element":"Elemente"}. Ersetzte vorhandene Anpassungen: ${e}. Gespeicherte Darstellungseinstellungen werden einmalig kopiert; Sortierung und Gruppierung bleiben erhalten. Künftige Änderungen und neue Unterelemente sind nicht verknüpft.`,"modals.bulkApply.resetAppearanceMessage":t=>`Die Darstellung wird für ${t} ${t===1?"Element":"Elemente"} zurückgesetzt. Sortierung und Gruppierung bleiben erhalten. Dies ist eine einmalige Änderung; künftige Änderungen und neue Unterelemente sind nicht verknüpft.`,"modals.bulkApply.affectedCountMessage":t=>`Vorhandene Überschreibungen, die sich ändern: ${t}.`,"modals.manualSortConfirm.propertySortMessage":(t,e)=>`Wechselt die aktuelle Ansicht zur manuellen Sortierung mit „${t}“. Beim Bearbeiten der Reihenfolge werden numerische Indexwerte bei Bedarf in diese Eigenschaft in ${e} ${e===1?"Notiz":"Notizen"} geschrieben.`,"modals.manualSortConfirm.removePropertyMessage":(t,e)=>`Entfernt „${t}“ aus ${e} ${e===1?"Notiz":"Notizen"} in der aktuellen Liste. Die manuelle Sortierreihenfolge dieser Notizen wird gelöscht.`,"modals.manualSortConfirm.compactMessage":t=>`Diese Neuanordnung benötigt mehr numerischen Raum. ${t} ${t===1?"Notiz erhält":"Notizen erhalten"} neue Indexwerte.`,"modals.navRainbowSection.title":t=>`Regenbogenfarben: ${t}`,"modals.folderSuggest.placeholder":t=>`In Ordner verschieben: ${t}...`,"modals.folderSuggest.multipleFilesLabel":t=>`${t} Dateien`}},en:{dateFormat:"MMM D, YYYY",timeFormat:"h:mm a",defaultVaultProfileName:"Default",bootstrap:{downloading:"Downloading languages…",continueInEnglish:"Continue in English",downloadFailed:"Language download failed. Notebook Navigator is using English."},formatters:{"paneHeader.applySortAndGroupToDescendants":t=>`Apply sort and group to ${t}`,"paneHeader.applyAppearanceToDescendants":t=>`Apply appearance to ${t}`,"paneHeader.resetAppearanceInDescendants":t=>`Reset appearance in ${t}`,"folderAppearance.titleRows.option":t=>`${t} title row${t===1?"":"s"}`,"folderAppearance.previewRows.option":t=>`${t} preview row${t===1?"":"s"}`,"modals.bulkApply.applySortAndGroupTitle":t=>`Apply sort and group to ${t}?`,"modals.bulkApply.applyAppearanceTitle":t=>`Apply appearance to ${t}?`,"modals.bulkApply.resetAppearanceTitle":t=>`Reset appearance in ${t}?`,"modals.bulkApply.applyAppearanceMessage":(t,e)=>`Appearance will change for ${t} ${t===1?"item":"items"}. Existing custom appearances replaced: ${e}. Saved appearance preferences are copied once; sort and grouping are preserved. Future changes and new descendants are not linked.`,"modals.bulkApply.resetAppearanceMessage":t=>`Appearance will be reset for ${t} ${t===1?"item":"items"}. Sort and grouping are preserved. This is a one-time change; future changes and new descendants are not linked.`,"modals.bulkApply.affectedCountMessage":t=>`Existing overrides that will change: ${t}.`,"modals.manualSortConfirm.propertySortMessage":(t,e)=>`This switches the current view to manual sort using "${t}". Editing the order writes numeric index values to that property in ${e} ${e===1?"note":"notes"} as needed.`,"modals.manualSortConfirm.removePropertyMessage":(t,e)=>`This removes "${t}" from ${e} ${e===1?"note":"notes"} in the current list. Manual sort order will be cleared for those notes.`,"modals.manualSortConfirm.compactMessage":t=>`This reorder needs more numeric space. ${t} ${t===1?"note":"notes"} will receive new index values.`,"modals.navRainbowSection.title":t=>`Rainbow colors: ${t}`,"modals.folderSuggest.placeholder":t=>`Move ${t} to folder...`,"modals.folderSuggest.multipleFilesLabel":t=>`${t} files`}},es:{dateFormat:"D [de] MMMM [de] YYYY",timeFormat:"HH:mm",defaultVaultProfileName:"Predeterminado",bootstrap:{downloading:"Descargando idiomas…",continueInEnglish:"Continuar en inglés",downloadFailed:"No se pudieron descargar los idiomas. Notebook Navigator usa inglés."},formatters:{"paneHeader.applySortAndGroupToDescendants":t=>`Aplicar orden y agrupación a ${t}`,"paneHeader.applyAppearanceToDescendants":t=>`Aplicar apariencia a ${t}`,"paneHeader.resetAppearanceInDescendants":t=>`Restablecer la apariencia en ${t}`,"folderAppearance.titleRows.option":t=>`${t} fila${t===1?"":"s"} de título`,"folderAppearance.previewRows.option":t=>`${t} fila${t===1?"":"s"} de vista previa`,"modals.bulkApply.applySortAndGroupTitle":t=>`¿Aplicar orden y agrupación a ${t}?`,"modals.bulkApply.applyAppearanceTitle":t=>`¿Aplicar apariencia a ${t}?`,"modals.bulkApply.resetAppearanceTitle":t=>`¿Restablecer la apariencia en ${t}?`,"modals.bulkApply.applyAppearanceMessage":(t,e)=>`La apariencia cambiará para ${t} ${t===1?"elemento":"elementos"}. Apariencias personalizadas existentes reemplazadas: ${e}. Las preferencias de apariencia guardadas se copian una vez; se conservan la ordenación y la agrupación. Los cambios futuros y los nuevos descendientes no quedan vinculados.`,"modals.bulkApply.resetAppearanceMessage":t=>`La apariencia se restablecerá para ${t} ${t===1?"elemento":"elementos"}. Se conservan la ordenación y la agrupación. Es un cambio único; los cambios futuros y los nuevos descendientes no quedan vinculados.`,"modals.bulkApply.affectedCountMessage":t=>`Anulaciones existentes que cambiarán: ${t}.`,"modals.manualSortConfirm.propertySortMessage":(t,e)=>`Esto cambia la vista actual al orden manual usando "${t}". Editar el orden escribe valores numéricos de índice en esa propiedad en ${e} ${e===1?"nota":"notas"} según sea necesario.`,"modals.manualSortConfirm.removePropertyMessage":(t,e)=>`Esto elimina "${t}" de ${e} ${e===1?"nota":"notas"} en la lista actual. Se borrará el orden manual de esas notas.`,"modals.manualSortConfirm.compactMessage":t=>`Esta reordenación necesita más espacio numérico. ${t} ${t===1?"nota recibirá":"notas recibirán"} nuevos valores de índice.`,"modals.navRainbowSection.title":t=>`Colores arcoíris: ${t}`,"modals.folderSuggest.placeholder":t=>`Mover ${t} a carpeta...`,"modals.folderSuggest.multipleFilesLabel":t=>`${t} archivos`}},fa:{dateFormat:"YYYY/MM/DD",timeFormat:"HH:mm",defaultVaultProfileName:"پیش‌فرض",bootstrap:{downloading:"در حال دانلود زبان‌ها…",continueInEnglish:"ادامه به انگلیسی",downloadFailed:"دانلود زبان‌ها ناموفق بود. Notebook Navigator از انگلیسی استفاده می‌کند."},formatters:{"paneHeader.applySortAndGroupToDescendants":t=>`اعمال مرتب‌سازی و گروه‌بندی به ${t}`,"paneHeader.applyAppearanceToDescendants":t=>`اعمال ظاهر به ${t}`,"paneHeader.resetAppearanceInDescendants":t=>`بازنشانی ظاهر در ${t}`,"folderAppearance.titleRows.option":t=>`${t} ردیف عنوان`,"folderAppearance.previewRows.option":t=>`${t} ردیف پیش‌نمایش`,"modals.bulkApply.applySortAndGroupTitle":t=>`مرتب‌سازی و گروه‌بندی به ${t} اعمال شود؟`,"modals.bulkApply.applyAppearanceTitle":t=>`ظاهر به ${t} اعمال شود؟`,"modals.bulkApply.resetAppearanceTitle":t=>`ظاهر در ${t} بازنشانی شود؟`,"modals.bulkApply.applyAppearanceMessage":(t,e)=>`ظاهر ${t} مورد تغییر می‌کند. ظاهرهای سفارشی موجود که جایگزین می‌شوند: ${e}. ترجیحات ذخیره‌شدهٔ ظاهر یک‌بار کپی می‌شوند؛ مرتب‌سازی و گروه‌بندی حفظ می‌شوند. تغییرات آینده و موارد فرزند جدید پیوند داده نمی‌شوند.`,"modals.bulkApply.resetAppearanceMessage":t=>`ظاهر ${t} مورد بازنشانی می‌شود. مرتب‌سازی و گروه‌بندی حفظ می‌شوند. این تغییر یک‌باره است؛ تغییرات آینده و موارد فرزند جدید پیوند داده نمی‌شوند.`,"modals.bulkApply.affectedCountMessage":t=>`بازنویسی‌های موجود که تغییر خواهند کرد: ${t}.`,"modals.manualSortConfirm.propertySortMessage":(t,e)=>`این کار نمای فعلی را به مرتب‌سازی دستی با استفاده از «${t}» تغییر می‌دهد. ویرایش ترتیب، مقادیر شاخص عددی را در صورت نیاز در این ویژگی برای ${e} یادداشت می‌نویسد.`,"modals.manualSortConfirm.removePropertyMessage":(t,e)=>`این کار «${t}» را از ${e} یادداشت در فهرست فعلی حذف می‌کند. ترتیب مرتب‌سازی دستی برای آن یادداشت‌ها پاک خواهد شد.`,"modals.manualSortConfirm.compactMessage":t=>`این بازآرایی به فضای عددی بیشتری نیاز دارد. ${t} یادداشت مقادیر شاخص جدید دریافت می‌کند.`,"modals.navRainbowSection.title":t=>`رنگ‌های رنگین‌کمان: ${t}`,"modals.folderSuggest.placeholder":t=>`انتقال ${t} به پوشه...`,"modals.folderSuggest.multipleFilesLabel":t=>`${t} فایل`}},fr:{dateFormat:"D MMMM YYYY",timeFormat:"HH:mm",defaultVaultProfileName:"Par défaut",bootstrap:{downloading:"Téléchargement des langues…",continueInEnglish:"Continuer en anglais",downloadFailed:"Le téléchargement des langues a échoué. Notebook Navigator utilise l’anglais."},formatters:{"paneHeader.applySortAndGroupToDescendants":t=>`Appliquer le tri et le regroupement aux ${t}`,"paneHeader.applyAppearanceToDescendants":t=>`Appliquer l'apparence aux ${t}`,"paneHeader.resetAppearanceInDescendants":t=>`Réinitialiser l’apparence dans les ${t}`,"folderAppearance.titleRows.option":t=>`${t} ligne${t===1?"":"s"} de titre`,"folderAppearance.previewRows.option":t=>`${t} ligne${t===1?"":"s"} d'aperçu`,"modals.bulkApply.applySortAndGroupTitle":t=>`Appliquer le tri et le regroupement aux ${t} ?`,"modals.bulkApply.applyAppearanceTitle":t=>`Appliquer l'apparence aux ${t} ?`,"modals.bulkApply.resetAppearanceTitle":t=>`Réinitialiser l’apparence dans les ${t} ?`,"modals.bulkApply.applyAppearanceMessage":(t,e)=>`L’apparence changera pour ${t} ${t===1?"élément":"éléments"}. Apparences personnalisées existantes remplacées : ${e}. Les préférences d’apparence enregistrées sont copiées une seule fois ; le tri et le regroupement sont conservés. Les changements futurs et les nouveaux descendants ne sont pas liés.`,"modals.bulkApply.resetAppearanceMessage":t=>`L’apparence sera réinitialisée pour ${t} ${t===1?"élément":"éléments"}. Le tri et le regroupement sont conservés. Cette modification est ponctuelle ; les changements futurs et les nouveaux descendants ne sont pas liés.`,"modals.bulkApply.affectedCountMessage":t=>`Remplacements existants qui seront modifiés : ${t}.`,"modals.manualSortConfirm.propertySortMessage":(t,e)=>`Ceci bascule la vue actuelle sur le tri manuel en utilisant « ${t} ». La modification de l'ordre écrit des valeurs numériques dans cette propriété sur ${e} ${e===1?"note":"notes"} au besoin.`,"modals.manualSortConfirm.removePropertyMessage":(t,e)=>`Ceci supprime « ${t} » de ${e} ${e===1?"note":"notes"} dans la liste actuelle. L'ordre de tri manuel sera effacé pour ces notes.`,"modals.manualSortConfirm.compactMessage":t=>`Cette réorganisation nécessite plus d'espace numérique. ${t} ${t===1?"note recevra":"notes recevront"} de nouvelles valeurs numériques.`,"modals.navRainbowSection.title":t=>`Couleurs arc-en-ciel : ${t}`,"modals.folderSuggest.placeholder":t=>`Déplacer ${t} vers le dossier...`,"modals.folderSuggest.multipleFilesLabel":t=>`${t} fichiers`}},id:{dateFormat:"D MMM YYYY",timeFormat:"HH:mm",defaultVaultProfileName:"Default",bootstrap:{downloading:"Mengunduh bahasa…",continueInEnglish:"Lanjutkan dalam bahasa Inggris",downloadFailed:"Unduhan bahasa gagal. Notebook Navigator menggunakan bahasa Inggris."},formatters:{"paneHeader.applySortAndGroupToDescendants":t=>`Terapkan urutan dan grup ke ${t}`,"paneHeader.applyAppearanceToDescendants":t=>`Terapkan tampilan ke ${t}`,"paneHeader.resetAppearanceInDescendants":t=>`Atur ulang tampilan di ${t}`,"folderAppearance.titleRows.option":t=>`${t} baris judul`,"folderAppearance.previewRows.option":t=>`${t} baris pratinjau`,"modals.bulkApply.applySortAndGroupTitle":t=>`Terapkan urutan dan grup ke ${t}?`,"modals.bulkApply.applyAppearanceTitle":t=>`Terapkan tampilan ke ${t}?`,"modals.bulkApply.resetAppearanceTitle":t=>`Atur ulang tampilan di ${t}?`,"modals.bulkApply.applyAppearanceMessage":(t,e)=>`Tampilan akan berubah untuk ${t} item. Tampilan khusus yang ada dan diganti: ${e}. Preferensi tampilan tersimpan disalin satu kali; pengurutan dan pengelompokan dipertahankan. Perubahan mendatang dan turunan baru tidak ditautkan.`,"modals.bulkApply.resetAppearanceMessage":t=>`Tampilan akan diatur ulang untuk ${t} item. Pengurutan dan pengelompokan dipertahankan. Ini adalah perubahan satu kali; perubahan mendatang dan turunan baru tidak ditautkan.`,"modals.bulkApply.affectedCountMessage":t=>`Penimpaan yang ada dan akan berubah: ${t}.`,"modals.manualSortConfirm.propertySortMessage":(t,e)=>`Ini akan mengalihkan tampilan saat ini ke urutan manual menggunakan "${t}". Mengedit urutan akan menulis nilai indeks numerik ke properti tersebut di ${e} catatan sesuai kebutuhan.`,"modals.manualSortConfirm.removePropertyMessage":(t,e)=>`Ini akan menghapus "${t}" dari ${e} catatan di daftar saat ini. Urutan manual akan dihapus untuk catatan tersebut.`,"modals.manualSortConfirm.compactMessage":t=>`Pengaturan ulang ini memerlukan lebih banyak ruang numerik. ${t} catatan akan menerima nilai indeks baru.`,"modals.navRainbowSection.title":t=>`Warna pelangi: ${t}`,"modals.folderSuggest.placeholder":t=>`Pindahkan ${t} ke folder...`,"modals.folderSuggest.multipleFilesLabel":t=>`${t} file`}},it:{dateFormat:"D MMM YYYY",timeFormat:"HH:mm",defaultVaultProfileName:"Predefinito",bootstrap:{downloading:"Download delle lingue…",continueInEnglish:"Continua in inglese",downloadFailed:"Download delle lingue non riuscito. Notebook Navigator usa l’inglese."},formatters:{"paneHeader.applySortAndGroupToDescendants":t=>`Applica ordinamento e raggruppamento a ${t}`,"paneHeader.applyAppearanceToDescendants":t=>`Applica aspetto a ${t}`,"paneHeader.resetAppearanceInDescendants":t=>`Reimposta aspetto in ${t}`,"folderAppearance.titleRows.option":t=>`${t} ${t===1?"riga":"righe"} titolo`,"folderAppearance.previewRows.option":t=>`${t} ${t===1?"riga":"righe"} anteprima`,"modals.bulkApply.applySortAndGroupTitle":t=>`Applicare ordinamento e raggruppamento a ${t}?`,"modals.bulkApply.applyAppearanceTitle":t=>`Applicare aspetto a ${t}?`,"modals.bulkApply.resetAppearanceTitle":t=>`Reimpostare aspetto in ${t}?`,"modals.bulkApply.applyAppearanceMessage":(t,e)=>`L'aspetto cambierà per ${t} ${t===1?"elemento":"elementi"}. Aspetti personalizzati esistenti sostituiti: ${e}. Le preferenze di aspetto salvate vengono copiate una sola volta; ordinamento e raggruppamento restano invariati. Le modifiche future e i nuovi discendenti non sono collegati.`,"modals.bulkApply.resetAppearanceMessage":t=>`L'aspetto verrà reimpostato per ${t} ${t===1?"elemento":"elementi"}. Ordinamento e raggruppamento restano invariati. È una modifica una tantum; le modifiche future e i nuovi discendenti non sono collegati.`,"modals.bulkApply.affectedCountMessage":t=>`Sostituzioni esistenti che cambieranno: ${t}.`,"modals.manualSortConfirm.propertySortMessage":(t,e)=>`Questo cambia la vista corrente all'ordinamento manuale usando "${t}". La modifica dell'ordine scrive valori indice numerici in quella proprietà in ${e} ${e===1?"nota":"note"} secondo necessità.`,"modals.manualSortConfirm.removePropertyMessage":(t,e)=>`Questo rimuove "${t}" da ${e} ${e===1?"nota":"note"} nella lista corrente. L'ordinamento manuale verrà cancellato per quelle note.`,"modals.manualSortConfirm.compactMessage":t=>`Questo riordino richiede più spazio numerico. ${t} ${t===1?"nota riceverà":"note riceveranno"} nuovi valori indice.`,"modals.navRainbowSection.title":t=>`Colori arcobaleno: ${t}`,"modals.folderSuggest.placeholder":t=>`Sposta ${t} nella cartella...`,"modals.folderSuggest.multipleFilesLabel":t=>`${t} file`}},ja:{dateFormat:"YYYY年M月D日",timeFormat:"HH:mm",defaultVaultProfileName:"デフォルト",bootstrap:{downloading:"言語をダウンロード中…",continueInEnglish:"英語で続行",downloadFailed:"言語のダウンロードに失敗しました。Notebook Navigator は英語を使用しています。"},formatters:{"paneHeader.applySortAndGroupToDescendants":t=>`${t}に並べ替えとグループ化を適用`,"paneHeader.applyAppearanceToDescendants":t=>`${t}に外観を適用`,"paneHeader.resetAppearanceInDescendants":t=>`${t}の外観をリセット`,"folderAppearance.titleRows.option":t=>`タイトル${t}行`,"folderAppearance.previewRows.option":t=>`プレビュー${t}行`,"modals.bulkApply.applySortAndGroupTitle":t=>`${t}に並べ替えとグループ化を適用しますか？`,"modals.bulkApply.applyAppearanceTitle":t=>`${t}に外観を適用しますか？`,"modals.bulkApply.resetAppearanceTitle":t=>`${t}の外観をリセットしますか？`,"modals.bulkApply.applyAppearanceMessage":(t,e)=>`${t}件の外観が変更されます。既存のカスタム外観の置換数：${e}。保存済みの外観設定が一度だけコピーされ、並べ替えとグループ化は保持されます。今後の変更や新しい子項目は連動しません。`,"modals.bulkApply.resetAppearanceMessage":t=>`${t}件の外観がリセットされます。並べ替えとグループ化は保持されます。これは一度限りの変更で、今後の変更や新しい子項目は連動しません。`,"modals.bulkApply.affectedCountMessage":t=>`変更される既存のオーバーライド: ${t}。`,"modals.manualSortConfirm.propertySortMessage":(t,e)=>`現在のビューを「${t}」を使った手動並べ替えに切り替えます。並び順を編集すると、必要に応じて ${e} 件のノートのそのプロパティに数値インデックス値が書き込まれます。`,"modals.manualSortConfirm.removePropertyMessage":(t,e)=>`現在のリストの ${e} 件のノートから「${t}」を削除します。それらのノートの手動並べ替え順はクリアされます。`,"modals.manualSortConfirm.compactMessage":t=>`この並べ替えにはより多くの数値領域が必要です。${t} 件のノートに新しいインデックス値が割り当てられます。`,"modals.navRainbowSection.title":t=>`レインボーカラー: ${t}`,"modals.folderSuggest.placeholder":t=>`${t} をフォルダに移動...`,"modals.folderSuggest.multipleFilesLabel":t=>`${t} 個のファイル`}},ko:{dateFormat:"YYYY년 M월 D일",timeFormat:"a h:mm",defaultVaultProfileName:"기본",bootstrap:{downloading:"언어 다운로드 중…",continueInEnglish:"영어로 계속",downloadFailed:"언어를 다운로드하지 못했습니다. Notebook Navigator가 영어를 사용합니다."},formatters:{"paneHeader.applySortAndGroupToDescendants":t=>`${t}에 정렬 및 그룹 적용`,"paneHeader.applyAppearanceToDescendants":t=>`${t}에 모양 적용`,"paneHeader.resetAppearanceInDescendants":t=>`${t}의 모양 재설정`,"folderAppearance.titleRows.option":t=>`${t}개 제목 행`,"folderAppearance.previewRows.option":t=>`${t}개 미리보기 행`,"modals.bulkApply.applySortAndGroupTitle":t=>`${t}에 정렬 및 그룹을 적용하시겠습니까?`,"modals.bulkApply.applyAppearanceTitle":t=>`${t}에 모양을 적용하시겠습니까?`,"modals.bulkApply.resetAppearanceTitle":t=>`${t}의 모양을 재설정하시겠습니까?`,"modals.bulkApply.applyAppearanceMessage":(t,e)=>`${t}개 항목의 모양이 변경됩니다. 교체되는 기존 사용자 지정 모양: ${e}개. 저장된 모양 설정이 한 번 복사되며 정렬과 그룹화는 유지됩니다. 이후 변경 사항과 새 하위 항목은 연결되지 않습니다.`,"modals.bulkApply.resetAppearanceMessage":t=>`${t}개 항목의 모양이 재설정됩니다. 정렬과 그룹화는 유지됩니다. 일회성 변경이며 이후 변경 사항과 새 하위 항목은 연결되지 않습니다.`,"modals.bulkApply.affectedCountMessage":t=>`변경될 기존 재정의: ${t}.`,"modals.manualSortConfirm.propertySortMessage":(t,e)=>`현재 보기를 "${t}"을(를) 사용한 수동 정렬로 전환합니다. 순서를 편집하면 필요에 따라 ${e}개 노트의 해당 속성에 숫자 인덱스 값이 기록됩니다.`,"modals.manualSortConfirm.removePropertyMessage":(t,e)=>`현재 목록의 ${e}개 노트에서 "${t}"을(를) 제거합니다. 해당 노트의 수동 정렬 순서가 초기화됩니다.`,"modals.manualSortConfirm.compactMessage":t=>`이 재정렬에는 더 많은 숫자 공간이 필요합니다. ${t}개 노트에 새로운 인덱스 값이 할당됩니다.`,"modals.navRainbowSection.title":t=>`무지개 색상: ${t}`,"modals.folderSuggest.placeholder":t=>`${t}을(를) 폴더로 이동...`,"modals.folderSuggest.multipleFilesLabel":t=>`${t}개의 파일`}},nl:{dateFormat:"D MMM YYYY",timeFormat:"HH:mm",defaultVaultProfileName:"Standaard",bootstrap:{downloading:"Talen downloaden…",continueInEnglish:"Doorgaan in het Engels",downloadFailed:"Talen downloaden mislukt. Notebook Navigator gebruikt Engels."},formatters:{"paneHeader.applySortAndGroupToDescendants":t=>`Sortering en groepering toepassen op ${t}`,"paneHeader.applyAppearanceToDescendants":t=>`Uiterlijk toepassen op ${t}`,"paneHeader.resetAppearanceInDescendants":t=>`Uiterlijk in ${t} herstellen`,"folderAppearance.titleRows.option":t=>`${t} titelrij${t===1?"":"en"}`,"folderAppearance.previewRows.option":t=>`${t} voorbeeldrij${t===1?"":"en"}`,"modals.bulkApply.applySortAndGroupTitle":t=>`Sortering en groepering toepassen op ${t}?`,"modals.bulkApply.applyAppearanceTitle":t=>`Uiterlijk toepassen op ${t}?`,"modals.bulkApply.resetAppearanceTitle":t=>`Uiterlijk in ${t} herstellen?`,"modals.bulkApply.applyAppearanceMessage":(t,e)=>`Het uiterlijk verandert voor ${t} ${t===1?"item":"items"}. Bestaande aangepaste uiterlijkinstellingen vervangen: ${e}. Opgeslagen voorkeuren voor uiterlijk worden eenmaal gekopieerd; sortering en groepering blijven behouden. Toekomstige wijzigingen en nieuwe onderliggende items worden niet gekoppeld.`,"modals.bulkApply.resetAppearanceMessage":t=>`Het uiterlijk wordt hersteld voor ${t} ${t===1?"item":"items"}. Sortering en groepering blijven behouden. Dit is een eenmalige wijziging; toekomstige wijzigingen en nieuwe onderliggende items worden niet gekoppeld.`,"modals.bulkApply.affectedCountMessage":t=>`Bestaande overschrijvingen die wijzigen: ${t}.`,"modals.manualSortConfirm.propertySortMessage":(t,e)=>`Dit schakelt de huidige weergave over naar handmatig sorteren met "${t}". Bij het bewerken van de volgorde worden indien nodig numerieke indexwaarden naar die eigenschap geschreven in ${e} ${e===1?"notitie":"notities"}.`,"modals.manualSortConfirm.removePropertyMessage":(t,e)=>`Dit verwijdert "${t}" uit ${e} ${e===1?"notitie":"notities"} in de huidige lijst. Voor die notities wordt de handmatige sorteervolgorde gewist.`,"modals.manualSortConfirm.compactMessage":t=>`Deze herordening heeft meer numerieke ruimte nodig. ${t} ${t===1?"notitie krijgt":"notities krijgen"} nieuwe indexwaarden.`,"modals.navRainbowSection.title":t=>`Regenboogkleuren: ${t}`,"modals.folderSuggest.placeholder":t=>`Verplaats ${t} naar map...`,"modals.folderSuggest.multipleFilesLabel":t=>`${t} bestanden`}},pl:{dateFormat:"DD.MM.YYYY",timeFormat:"HH:mm",defaultVaultProfileName:"Domyślny",bootstrap:{downloading:"Pobieranie języków…",continueInEnglish:"Kontynuuj po angielsku",downloadFailed:"Nie udało się pobrać języków. Notebook Navigator używa języka angielskiego."},formatters:{"paneHeader.applySortAndGroupToDescendants":t=>`Zastosuj sortowanie i grupowanie dla ${t}`,"paneHeader.applyAppearanceToDescendants":t=>`Zastosuj wygląd dla ${t}`,"paneHeader.resetAppearanceInDescendants":t=>`Zresetuj wygląd dla ${t}`,"folderAppearance.titleRows.option":t=>`${t} ${t===1?"wiersz":t===2||t===3||t===4?"wiersze":"wierszy"} tytułu`,"folderAppearance.previewRows.option":t=>`${t} ${t===1?"wiersz":t===2||t===3||t===4?"wiersze":"wierszy"} podglądu`,"modals.bulkApply.applySortAndGroupTitle":t=>`Zastosuj sortowanie i grupowanie dla ${t}?`,"modals.bulkApply.applyAppearanceTitle":t=>`Zastosuj wygląd dla ${t}?`,"modals.bulkApply.resetAppearanceTitle":t=>`Zresetować wygląd dla ${t}?`,"modals.bulkApply.applyAppearanceMessage":(t,e)=>`Wygląd zmieni się dla ${t} ${t===1?"elementu":"elementów"}. Zastąpione istniejące niestandardowe wyglądy: ${e}. Zapisane preferencje wyglądu zostaną skopiowane jednorazowo; sortowanie i grupowanie pozostaną bez zmian. Przyszłe zmiany i nowe elementy podrzędne nie będą połączone.`,"modals.bulkApply.resetAppearanceMessage":t=>`Wygląd zostanie zresetowany dla ${t} ${t===1?"elementu":"elementów"}. Sortowanie i grupowanie pozostaną bez zmian. Jest to jednorazowa zmiana; przyszłe zmiany i nowe elementy podrzędne nie będą połączone.`,"modals.bulkApply.affectedCountMessage":t=>`Istniejące nadpisania do zmiany: ${t}.`,"modals.manualSortConfirm.propertySortMessage":(t,e)=>`Przełącza bieżący widok na sortowanie ręczne z użyciem „${t}”. Edycja kolejności w razie potrzeby zapisuje wartości indeksu liczbowego do tego atrybutu w ${e} ${e===1?"notatce":"notatkach"}.`,"modals.manualSortConfirm.removePropertyMessage":(t,e)=>`Usuwa „${t}” z ${e} ${e===1?"notatki":"notatek"} na bieżącej liście. Kolejność sortowania ręcznego zostanie wyczyszczona dla tych notatek.`,"modals.manualSortConfirm.compactMessage":t=>`Ta zmiana kolejności wymaga więcej miejsca na wartości liczbowe. ${t} ${t===1?"notatka otrzyma":t%10>=2&&t%10<=4&&(t%100<12||t%100>14)?"notatki otrzymają":"notatek otrzyma"} nowe wartości indeksu.`,"modals.navRainbowSection.title":t=>`Kolory tęczy: ${t}`,"modals.folderSuggest.placeholder":t=>`Przenieś ${t} do folderu...`,"modals.folderSuggest.multipleFilesLabel":t=>`${t} ${t===1?"plik":t%10>=2&&t%10<=4&&(t%100<12||t%100>14)?"pliki":"plików"}`}},pt:{dateFormat:"D MMM YYYY",timeFormat:"HH:mm",defaultVaultProfileName:"Predefinido",bootstrap:{downloading:"A transferir idiomas…",continueInEnglish:"Continuar em inglês",downloadFailed:"A transferência dos idiomas falhou. O Notebook Navigator está a usar inglês."},formatters:{"paneHeader.applySortAndGroupToDescendants":t=>`Aplicar ordenação e agrupamento a ${t}`,"paneHeader.applyAppearanceToDescendants":t=>`Aplicar aparência a ${t}`,"paneHeader.resetAppearanceInDescendants":t=>`Repor aparência em ${t}`,"folderAppearance.titleRows.option":t=>`${t} linha${t===1?"":"s"} de título`,"folderAppearance.previewRows.option":t=>`${t} linha${t===1?"":"s"} de pré-visualização`,"modals.bulkApply.applySortAndGroupTitle":t=>`Aplicar ordenação e agrupamento a ${t}?`,"modals.bulkApply.applyAppearanceTitle":t=>`Aplicar aparência a ${t}?`,"modals.bulkApply.resetAppearanceTitle":t=>`Repor aparência em ${t}?`,"modals.bulkApply.applyAppearanceMessage":(t,e)=>`A aparência será alterada para ${t} ${t===1?"item":"itens"}. Aparências personalizadas existentes substituídas: ${e}. As preferências de aparência guardadas são copiadas uma vez; a ordenação e o agrupamento são preservados. Alterações futuras e novos descendentes não ficam associados.`,"modals.bulkApply.resetAppearanceMessage":t=>`A aparência será reposta para ${t} ${t===1?"item":"itens"}. A ordenação e o agrupamento são preservados. Esta é uma alteração única; alterações futuras e novos descendentes não ficam associados.`,"modals.bulkApply.affectedCountMessage":t=>`Substituições existentes que serão alteradas: ${t}.`,"modals.manualSortConfirm.propertySortMessage":(t,e)=>`Isto muda a vista atual para ordenação manual usando "${t}". Editar a ordem escreve valores de índice numéricos nessa propriedade em ${e} ${e===1?"nota":"notas"} conforme necessário.`,"modals.manualSortConfirm.removePropertyMessage":(t,e)=>`Isto remove "${t}" de ${e} ${e===1?"nota":"notas"} na lista atual. A ordem de ordenação manual será apagada para essas notas.`,"modals.manualSortConfirm.compactMessage":t=>`Esta reordenação precisa de mais espaço numérico. ${t} ${t===1?"nota receberá":"notas receberão"} novos valores de índice.`,"modals.navRainbowSection.title":t=>`Cores arco-íris: ${t}`,"modals.folderSuggest.placeholder":t=>`Mover ${t} para pasta...`,"modals.folderSuggest.multipleFilesLabel":t=>`${t} ficheiros`}},pt_br:{dateFormat:"DD/MM/YYYY",timeFormat:"HH:mm",defaultVaultProfileName:"Padrão",bootstrap:{downloading:"Baixando idiomas…",continueInEnglish:"Continuar em inglês",downloadFailed:"Não foi possível baixar os idiomas. O Notebook Navigator está usando inglês."},formatters:{"paneHeader.applySortAndGroupToDescendants":t=>`Aplicar classificação e agrupamento a ${t}`,"paneHeader.applyAppearanceToDescendants":t=>`Aplicar aparência a ${t}`,"paneHeader.resetAppearanceInDescendants":t=>`Redefinir aparência em ${t}`,"folderAppearance.titleRows.option":t=>`${t} linha${t===1?"":"s"} de título`,"folderAppearance.previewRows.option":t=>`${t} linha${t===1?"":"s"} de visualização`,"modals.bulkApply.applySortAndGroupTitle":t=>`Aplicar classificação e agrupamento a ${t}?`,"modals.bulkApply.applyAppearanceTitle":t=>`Aplicar aparência a ${t}?`,"modals.bulkApply.resetAppearanceTitle":t=>`Redefinir aparência em ${t}?`,"modals.bulkApply.applyAppearanceMessage":(t,e)=>`A aparência mudará para ${t} ${t===1?"item":"itens"}. Aparências personalizadas existentes substituídas: ${e}. As preferências de aparência salvas são copiadas uma vez; a ordenação e o agrupamento são preservados. Alterações futuras e novos descendentes não ficam vinculados.`,"modals.bulkApply.resetAppearanceMessage":t=>`A aparência será redefinida para ${t} ${t===1?"item":"itens"}. A ordenação e o agrupamento são preservados. Esta é uma alteração única; alterações futuras e novos descendentes não ficam vinculados.`,"modals.bulkApply.affectedCountMessage":t=>`Substituições existentes que serão alteradas: ${t}.`,"modals.manualSortConfirm.propertySortMessage":(t,e)=>`Isso muda a visualização atual para classificação manual usando "${t}". Editar a ordem grava valores numéricos de índice nessa propriedade em ${e} ${e===1?"nota":"notas"} conforme necessário.`,"modals.manualSortConfirm.removePropertyMessage":(t,e)=>`Isso remove "${t}" de ${e} ${e===1?"nota":"notas"} na lista atual. A ordem de classificação manual será limpa para essas notas.`,"modals.manualSortConfirm.compactMessage":t=>`Esta reordenação precisa de mais espaço numérico. ${t} ${t===1?"nota receberá":"notas receberão"} novos valores de índice.`,"modals.navRainbowSection.title":t=>`Cores arco-íris: ${t}`,"modals.folderSuggest.placeholder":t=>`Mover ${t} para pasta...`,"modals.folderSuggest.multipleFilesLabel":t=>`${t} arquivos`}},ru:{dateFormat:"D MMMM YYYY",timeFormat:"HH:mm",defaultVaultProfileName:"По умолчанию",bootstrap:{downloading:"Загрузка языков…",continueInEnglish:"Продолжить на английском",downloadFailed:"Не удалось загрузить языки. Notebook Navigator использует английский."},formatters:{"paneHeader.applySortAndGroupToDescendants":t=>`Применить сортировку и группировку для ${t}`,"paneHeader.applyAppearanceToDescendants":t=>`Применить оформление для ${t}`,"paneHeader.resetAppearanceInDescendants":t=>`Сбросить оформление для ${t}`,"folderAppearance.titleRows.option":t=>`${t} ${t===1?"строка":t<5?"строки":"строк"} заголовка`,"folderAppearance.previewRows.option":t=>`${t} ${t===1?"строка":t<5?"строки":"строк"} превью`,"modals.bulkApply.applySortAndGroupTitle":t=>`Применить сортировку и группировку для ${t}?`,"modals.bulkApply.applyAppearanceTitle":t=>`Применить оформление для ${t}?`,"modals.bulkApply.resetAppearanceTitle":t=>`Сбросить оформление для ${t}?`,"modals.bulkApply.applyAppearanceMessage":(t,e)=>`Оформление изменится для ${t} ${t%10===1&&t%100!==11?"элемента":"элементов"}. Заменено существующих индивидуальных оформлений: ${e}. Сохранённые настройки оформления копируются один раз; сортировка и группировка сохраняются. Будущие изменения и новые дочерние элементы не связываются.`,"modals.bulkApply.resetAppearanceMessage":t=>`Оформление будет сброшено для ${t} ${t%10===1&&t%100!==11?"элемента":"элементов"}. Сортировка и группировка сохраняются. Это разовое изменение; будущие изменения и новые дочерние элементы не связываются.`,"modals.bulkApply.affectedCountMessage":t=>`Существующих переопределений, которые изменятся: ${t}.`,"modals.manualSortConfirm.propertySortMessage":(t,e)=>`Переключает текущий вид на ручную сортировку с использованием «${t}». При изменении порядка числовые значения индекса записываются в это свойство в ${e} ${e%10===1&&e%100!==11?"заметке":"заметках"} по мере необходимости.`,"modals.manualSortConfirm.removePropertyMessage":(t,e)=>`Это удалит «${t}» из ${e} ${e%10===1&&e%100!==11?"заметки":"заметок"} в текущем списке. Порядок ручной сортировки будет сброшен для этих заметок.`,"modals.manualSortConfirm.compactMessage":t=>`Эта перестановка требует больше числового пространства. ${t} ${t%10===1&&t%100!==11?"заметка получит":t%10>=2&&t%10<=4&&(t%100<12||t%100>14)?"заметки получат":"заметок получат"} новые значения индекса.`,"modals.navRainbowSection.title":t=>`Цвета радуги: ${t}`,"modals.folderSuggest.placeholder":t=>`Переместить ${t} в папку...`,"modals.folderSuggest.multipleFilesLabel":t=>`${t} ${t%10===1&&t%100!==11?"файл":t%10>=2&&t%10<=4&&(t%100<12||t%100>14)?"файла":"файлов"}`}},th:{dateFormat:"D MMM YYYY",timeFormat:"HH:mm",defaultVaultProfileName:"ค่าเริ่มต้น",bootstrap:{downloading:"กำลังดาวน์โหลดภาษา…",continueInEnglish:"ดำเนินการต่อเป็นภาษาอังกฤษ",downloadFailed:"ดาวน์โหลดภาษาไม่สำเร็จ Notebook Navigator กำลังใช้ภาษาอังกฤษ"},formatters:{"paneHeader.applySortAndGroupToDescendants":t=>`ใช้การเรียงและการจัดกลุ่มกับ${t}`,"paneHeader.applyAppearanceToDescendants":t=>`ใช้ลักษณะกับ${t}`,"paneHeader.resetAppearanceInDescendants":t=>`รีเซ็ตลักษณะใน${t}`,"folderAppearance.titleRows.option":t=>`${t} แถวชื่อเรื่อง`,"folderAppearance.previewRows.option":t=>`${t} แถวตัวอย่าง`,"modals.bulkApply.applySortAndGroupTitle":t=>`ใช้การเรียงและการจัดกลุ่มกับ${t}?`,"modals.bulkApply.applyAppearanceTitle":t=>`ใช้ลักษณะกับ${t}?`,"modals.bulkApply.resetAppearanceTitle":t=>`รีเซ็ตลักษณะใน${t}?`,"modals.bulkApply.applyAppearanceMessage":(t,e)=>`ลักษณะจะเปลี่ยนสำหรับ ${t} รายการ ลักษณะแบบกำหนดเองเดิมที่จะถูกแทนที่: ${e} ค่าลักษณะที่บันทึกไว้จะถูกคัดลอกครั้งเดียว โดยคงการเรียงลำดับและการจัดกลุ่มไว้ การเปลี่ยนแปลงในอนาคตและรายการย่อยใหม่จะไม่เชื่อมโยงกัน`,"modals.bulkApply.resetAppearanceMessage":t=>`ลักษณะจะถูกรีเซ็ตสำหรับ ${t} รายการ โดยคงการเรียงลำดับและการจัดกลุ่มไว้ นี่เป็นการเปลี่ยนแปลงครั้งเดียว การเปลี่ยนแปลงในอนาคตและรายการย่อยใหม่จะไม่เชื่อมโยงกัน`,"modals.bulkApply.affectedCountMessage":t=>`การแทนที่ที่มีอยู่ซึ่งจะเปลี่ยนแปลง: ${t}`,"modals.manualSortConfirm.propertySortMessage":(t,e)=>`จะสลับมุมมองปัจจุบันเป็นการจัดเรียงด้วยตนเองโดยใช้ "${t}" การแก้ไขลำดับจะเขียนค่าดัชนีตัวเลขลงในคุณสมบัตินั้นใน ${e} โน้ต ตามความจำเป็น`,"modals.manualSortConfirm.removePropertyMessage":(t,e)=>`จะลบ "${t}" ออกจาก ${e} โน้ตในรายการปัจจุบัน ลำดับการจัดเรียงด้วยตนเองของโน้ตเหล่านั้นจะถูกล้าง`,"modals.manualSortConfirm.compactMessage":t=>`การจัดเรียงใหม่นี้ต้องการพื้นที่ตัวเลขเพิ่มเติม ${t} โน้ต จะได้รับค่าดัชนีใหม่`,"modals.navRainbowSection.title":t=>`สีรุ้ง: ${t}`,"modals.folderSuggest.placeholder":t=>`ย้าย ${t} ไปยังโฟลเดอร์...`,"modals.folderSuggest.multipleFilesLabel":t=>`${t} ไฟล์`}},tr:{dateFormat:"D MMM YYYY",timeFormat:"HH:mm",defaultVaultProfileName:"Varsayılan",bootstrap:{downloading:"Diller indiriliyor…",continueInEnglish:"İngilizce devam et",downloadFailed:"Diller indirilemedi. Notebook Navigator İngilizce kullanıyor."},formatters:{"paneHeader.applySortAndGroupToDescendants":t=>`Sıralama ve gruplandırmayı ${t} için uygula`,"paneHeader.applyAppearanceToDescendants":t=>`Görünümü ${t} için uygula`,"paneHeader.resetAppearanceInDescendants":t=>`${t} için görünümü sıfırla`,"folderAppearance.titleRows.option":t=>`${t} başlık satırı`,"folderAppearance.previewRows.option":t=>`${t} önizleme satırı`,"modals.bulkApply.applySortAndGroupTitle":t=>`Sıralama ve gruplandırma ${t} için uygulansın mı?`,"modals.bulkApply.applyAppearanceTitle":t=>`Görünüm ${t} için uygulansın mı?`,"modals.bulkApply.resetAppearanceTitle":t=>`${t} için görünüm sıfırlansın mı?`,"modals.bulkApply.applyAppearanceMessage":(t,e)=>`Görünüm ${t} öğe için değişecek. Değiştirilecek mevcut özel görünümler: ${e}. Kayıtlı görünüm tercihleri bir kez kopyalanır; sıralama ve gruplama korunur. Gelecekteki değişiklikler ve yeni alt öğeler bağlanmaz.`,"modals.bulkApply.resetAppearanceMessage":t=>`Görünüm ${t} öğe için sıfırlanacak. Sıralama ve gruplama korunur. Bu tek seferlik bir değişikliktir; gelecekteki değişiklikler ve yeni alt öğeler bağlanmaz.`,"modals.bulkApply.affectedCountMessage":t=>`Değişecek mevcut geçersiz kılmalar: ${t}.`,"modals.manualSortConfirm.propertySortMessage":(t,e)=>`Bu, geçerli görünümü "${t}" kullanarak manuel sıralamaya geçirir. Sıralamayı düzenlemek, gerektiğinde ${e} nottaki bu özelliğe sayısal indeks değerleri yazar.`,"modals.manualSortConfirm.removePropertyMessage":(t,e)=>`Bu işlem, geçerli listedeki ${e} nottan "${t}" özelliğini kaldırır. Bu notlar için manuel sıralama düzeni temizlenecek.`,"modals.manualSortConfirm.compactMessage":t=>`Bu yeniden sıralama daha fazla sayısal alana ihtiyaç duyar. ${t} not yeni indeks değerleri alacak.`,"modals.navRainbowSection.title":t=>`Gökkuşağı renkleri: ${t}`,"modals.folderSuggest.placeholder":t=>`${t} öğesini klasöre taşı...`,"modals.folderSuggest.multipleFilesLabel":t=>`${t} dosya`}},uk:{dateFormat:"D MMM YYYY",timeFormat:"HH:mm",defaultVaultProfileName:"За замовчуванням",bootstrap:{downloading:"Завантаження мов…",continueInEnglish:"Продовжити англійською",downloadFailed:"Не вдалося завантажити мови. Notebook Navigator використовує англійську."},formatters:{"paneHeader.applySortAndGroupToDescendants":t=>`Застосувати сортування та групування для ${t}`,"paneHeader.applyAppearanceToDescendants":t=>`Застосувати оформлення для ${t}`,"paneHeader.resetAppearanceInDescendants":t=>`Скинути оформлення для ${t}`,"folderAppearance.titleRows.option":t=>`${t} ${t===1?"рядок":t<5?"рядки":"рядків"} заголовка`,"folderAppearance.previewRows.option":t=>`${t} ${t===1?"рядок":t<5?"рядки":"рядків"} попереднього перегляду`,"modals.bulkApply.applySortAndGroupTitle":t=>`Застосувати сортування та групування для ${t}?`,"modals.bulkApply.applyAppearanceTitle":t=>`Застосувати оформлення для ${t}?`,"modals.bulkApply.resetAppearanceTitle":t=>`Скинути оформлення для ${t}?`,"modals.bulkApply.applyAppearanceMessage":(t,e)=>`Оформлення зміниться для ${t} ${t%10===1&&t%100!==11?"елемента":"елементів"}. Замінено наявних власних оформлень: ${e}. Збережені налаштування оформлення копіюються один раз; сортування й групування зберігаються. Майбутні зміни та нові дочірні елементи не пов’язуються.`,"modals.bulkApply.resetAppearanceMessage":t=>`Оформлення буде скинуто для ${t} ${t%10===1&&t%100!==11?"елемента":"елементів"}. Сортування й групування зберігаються. Це одноразова зміна; майбутні зміни та нові дочірні елементи не пов’язуються.`,"modals.bulkApply.affectedCountMessage":t=>`Наявних перевизначень, які зміняться: ${t}.`,"modals.manualSortConfirm.propertySortMessage":(t,e)=>`Перемикає поточний вигляд на ручне сортування з використанням «${t}». Редагування порядку записує числові значення індексу в цю властивість у ${e} ${e%10===1&&e%100!==11?"нотатці":"нотатках"} за потреби.`,"modals.manualSortConfirm.removePropertyMessage":(t,e)=>`Це вилучить «${t}» з ${e} ${e%10===1&&e%100!==11?"нотатки":"нотаток"} у поточному списку. Порядок ручного сортування буде очищено для цих нотаток.`,"modals.manualSortConfirm.compactMessage":t=>`Це перевпорядкування потребує більше числового простору. ${t} ${t%10===1&&t%100!==11?"нотатка отримає":t%10>=2&&t%10<=4&&(t%100<12||t%100>14)?"нотатки отримають":"нотаток отримають"} нові значення індексу.`,"modals.navRainbowSection.title":t=>`Кольори веселки: ${t}`,"modals.folderSuggest.placeholder":t=>`Перемістити ${t} до теки...`,"modals.folderSuggest.multipleFilesLabel":t=>`${t} ${t%10===1&&t%100!==11?"файл":t%10>=2&&t%10<=4&&(t%100<12||t%100>14)?"файли":"файлів"}`}},vi:{dateFormat:"D MMM YYYY",timeFormat:"HH:mm",defaultVaultProfileName:"Mặc định",bootstrap:{downloading:"Đang tải ngôn ngữ…",continueInEnglish:"Tiếp tục bằng tiếng Anh",downloadFailed:"Không tải được ngôn ngữ. Notebook Navigator đang sử dụng tiếng Anh."},formatters:{"paneHeader.applySortAndGroupToDescendants":t=>`Áp dụng sắp xếp và nhóm cho ${t}`,"paneHeader.applyAppearanceToDescendants":t=>`Áp dụng giao diện cho ${t}`,"paneHeader.resetAppearanceInDescendants":t=>`Đặt lại giao diện trong ${t}`,"folderAppearance.titleRows.option":t=>`${t} dòng tiêu đề`,"folderAppearance.previewRows.option":t=>`${t} dòng xem trước`,"modals.bulkApply.applySortAndGroupTitle":t=>`Áp dụng sắp xếp và nhóm cho ${t}?`,"modals.bulkApply.applyAppearanceTitle":t=>`Áp dụng giao diện cho ${t}?`,"modals.bulkApply.resetAppearanceTitle":t=>`Đặt lại giao diện trong ${t}?`,"modals.bulkApply.applyAppearanceMessage":(t,e)=>`Giao diện sẽ thay đổi cho ${t} mục. Giao diện tùy chỉnh hiện có bị thay thế: ${e}. Các tùy chọn giao diện đã lưu được sao chép một lần; cách sắp xếp và nhóm được giữ nguyên. Thay đổi trong tương lai và mục con mới không được liên kết.`,"modals.bulkApply.resetAppearanceMessage":t=>`Giao diện sẽ được đặt lại cho ${t} mục. Cách sắp xếp và nhóm được giữ nguyên. Đây là thay đổi một lần; thay đổi trong tương lai và mục con mới không được liên kết.`,"modals.bulkApply.affectedCountMessage":t=>`Ghi đè hiện có sẽ thay đổi: ${t}.`,"modals.manualSortConfirm.propertySortMessage":(t,e)=>`Việc này chuyển chế độ xem hiện tại sang sắp xếp thủ công bằng "${t}". Việc chỉnh sửa thứ tự sẽ ghi giá trị chỉ số vào thuộc tính đó trong ${e} ghi chú khi cần.`,"modals.manualSortConfirm.removePropertyMessage":(t,e)=>`Việc này xóa "${t}" khỏi ${e} ghi chú trong danh sách hiện tại. Thứ tự sắp xếp thủ công sẽ bị xóa cho các ghi chú đó.`,"modals.manualSortConfirm.compactMessage":t=>`Việc sắp xếp lại này cần thêm khoảng trống số. ${t} ghi chú sẽ nhận giá trị chỉ số mới.`,"modals.navRainbowSection.title":t=>`Màu cầu vồng: ${t}`,"modals.folderSuggest.placeholder":t=>`Di chuyển ${t} đến thư mục...`,"modals.folderSuggest.multipleFilesLabel":t=>`${t} tệp`}},zh_cn:{dateFormat:"YYYY年M月D日",timeFormat:"HH:mm",defaultVaultProfileName:"默认",bootstrap:{downloading:"正在下载语言…",continueInEnglish:"继续使用英语",downloadFailed:"语言下载失败。Notebook Navigator 正在使用英语。"},formatters:{"paneHeader.applySortAndGroupToDescendants":t=>`将排序和分组应用到${t}`,"paneHeader.applyAppearanceToDescendants":t=>`将外观应用到${t}`,"paneHeader.resetAppearanceInDescendants":t=>`重置${t}中的外观`,"folderAppearance.titleRows.option":t=>`标题${t}行`,"folderAppearance.previewRows.option":t=>`预览${t}行`,"modals.bulkApply.applySortAndGroupTitle":t=>`将排序和分组应用到${t}？`,"modals.bulkApply.applyAppearanceTitle":t=>`将外观应用到${t}？`,"modals.bulkApply.resetAppearanceTitle":t=>`重置${t}中的外观？`,"modals.bulkApply.applyAppearanceMessage":(t,e)=>`将更改 ${t} 项的外观。将替换现有自定义外观：${e}。已保存的外观偏好只复制一次；排序和分组保持不变。以后所做的更改和新建的后代项目不会联动。`,"modals.bulkApply.resetAppearanceMessage":t=>`将重置 ${t} 项的外观。排序和分组保持不变。这是一次性更改；以后所做的更改和新建的后代项目不会联动。`,"modals.bulkApply.affectedCountMessage":t=>`将更改的现有覆盖：${t}。`,"modals.manualSortConfirm.propertySortMessage":(t,e)=>