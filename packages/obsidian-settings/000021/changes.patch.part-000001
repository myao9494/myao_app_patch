+  const result = updateStepBlockInMarkdown(markdown, "a.step", { path: "a.step", height: 500, view: "iso" }, { originalSource: source });
+  assert.ok(result.includes("> ```step\n> path: a.step\n> height: 500\n"), result);
+});
+
+test("行番号で指定したブロックも字下げを保って書き換えること", () => {
+  const markdown = "    ```step\n    path: a.step\n    ```";
+  const result = updateStepBlockInMarkdown(markdown, "a.step", { path: "a.step", height: 500, view: "iso" }, { lineStart: 0, lineEnd: 2 });
+  assert.equal(result, "    ```step\n    path: a.step\n    height: 500\n    view: iso\n    ```");
+});
+
+test("記号を含むパスのコードブロックを読み戻せること", () => {
+  assert.equal(parseStepCodeBlock(serializeStepCodeBlock({ path: "dir/a #1.step" })).path, "dir/a #1.step");
+});
+
+test("CADファイルの移動で、コードブロックのパスだけを書き換えること", () => {
+  const markdown = [
+    "path: 01/a.step は本文",
