+  const result = updateStepBlockInMarkdown(markdown, "a.step", { path: "a.step", height: 500, view: "iso" }, { originalSource: source });
+  assert.ok(result.includes("    ```step\n    path: a.step\n    height: 500\n    view: iso\n    ```\n"), result);
+});
+
+test("コールアウトの中のコードブロックを、> を保って書き換えること", () => {
+  const source = "path: a.step\nheight: 300\nview: iso";
