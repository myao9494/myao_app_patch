index 1655e17b4ce15b28630fcbec4844c931dc2ecbe4..ddb4563db7891137b0589ddf40dbeddef017754e 100644
--- a/.obsidian/plugins/cad-viewer/styles.css
+++ b/.obsidian/plugins/dagnetz-cad-viewer/styles.css
@@ -747,6 +747,53 @@
   box-sizing: border-box;
 }
 
+/* 埋め込みの名前（図のキャプションと同じ見た目で、埋め込みの中央の下に出す） */
+.step-viewer-embed-caption {
+  display: block;
+  margin-top: 0.7em;
+  max-width: 100%;
+  box-sizing: border-box;
+  text-align: center;
+  color: var(--text-normal);
+  font-size: var(--font-ui-small);
+  line-height: 1.3;
+  opacity: 0.9;
+  overflow-wrap: anywhere;
+  cursor: default;
+}
+
+.step-viewer-embed-caption.is-empty {
+  display: none;
+}
+
+/* クリックで選択した埋め込み（R キーで名前を変更できる）。
+   外側の輪郭線はエディタの行の枠で切れるため、内側に重ねた枠で示す */
+.step-viewer-embed.is-name-selected .step-viewer-embed-wrapper::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  border: 2px solid var(--interactive-accent);
+  border-radius: var(--radius-m);
+  pointer-events: none;
+  z-index: 20;
+}
+
+.step-viewer-name-modal .step-viewer-name-modal-handle {
+  cursor: grab;
+  user-select: none;
+}
+
+.step-viewer-name-modal .step-viewer-name-input {
+  width: 100%;
+}
+
+.step-viewer-name-modal .step-viewer-name-error {
+  min-height: 1.4em;
+  margin-top: var(--size-2-2);
+  color: var(--text-error);
+  font-size: var(--font-ui-small);
+}
+
 .step-viewer-embed-wrapper.is-resizing {
   user-select: none;
 }
