+  ].join("\n");
+  const result = replaceCadPathInMarkdown(markdown, "01/a.step", "02/新しい #1.step");
+  assert.deepEqual(result.split("\n"), [
+    "path: 01/a.step は本文",
+    "```step",
+    'path: "02/新しい #1.step"',
+    "height: 300",
+    "```",
+    "```cad",
+    'path: "02/新しい #1.step"',
+    "```",
+    "```step",
+    "path: 01/b.step",
+    "```",
+    "```js",
+    "path: 01/a.step",
+    "```",
+  ]);
+});
+
+test("CADファイルの移動で、注記と寸法を新しいパスへ移すこと", () => {
+  const data: Record<string, unknown> = {
+    annotations: { "a.step": [{ id: "1" }], "b.step": [{ id: "2" }] },
+    measurements: { "a.step": [{ id: "3" }] },
+  };
+  moveCadFileData(data, "a.step", "c.step");
+  assert.deepEqual(data, {
+    annotations: { "b.step": [{ id: "2" }], "c.step": [{ id: "1" }] },
+    measurements: { "c.step": [{ id: "3" }] },
+  });
+});
