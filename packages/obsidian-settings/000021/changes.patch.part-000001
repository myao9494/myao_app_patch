diff --git a/.obsidian/plugins/dagnetz-cad-viewer/src/viewer/printCompose.ts b/.obsidian/plugins/dagnetz-cad-viewer/src/viewer/printCompose.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1fd28759fc8e49de27a6b3bef6e2ce62fc6bb71d
--- /dev/null
+++ b/.obsidian/plugins/dagnetz-cad-viewer/src/viewer/printCompose.ts
@@ -0,0 +1,67 @@
+/**
+ * 印刷用画像の合成
+ *
+ * 1. 白い背景の上に、モデル、注記と寸法の文字、座標軸を重ねて PNG にする
+ * 2. 座標軸（X/Y/Z）は左下に描く。ビューアの ViewCube と同じくモデルの座標系で、90°回転にも追従する
+ **/
+
+import { LabelLayer } from "../ui/LabelLayer";
+import { ViewerController } from "./ViewerController";
+import { PRINT_MIN_PIXEL_RATIO, screenAxes } from "./printLayout";
+
+const AXIS_MARGIN = 46;
+const AXIS_LENGTH = 30;
+const AXIS_LABEL_GAP = 11;
+
+/** 座標軸を左下に描く（`h` は CSS px、`scale` は CSS px → canvas px）。 */
+function drawAxes(
+  ctx: CanvasRenderingContext2D,
+  controller: ViewerController,
+  h: number,
+  scale: number,
+): void {
+  const axes = screenAxes(controller.getCamera().quaternion, controller.getModelQuaternion());
+  const ox = AXIS_MARGIN * scale;
+  const oy = (h - AXIS_MARGIN) * scale;
+  ctx.save();
+  ctx.lineWidth = 2 * scale;
+  ctx.lineCap = "round";
+  ctx.font = `bold ${Math.round(12 * scale)}px sans-serif`;
+  ctx.textAlign = "center";
+  ctx.textBaseline = "middle";
+  for (const axis of axes) {
+    ctx.strokeStyle = axis.color;
+    ctx.fillStyle = axis.color;
+    ctx.beginPath();
+    ctx.moveTo(ox, oy);
+    ctx.lineTo(ox + axis.x * AXIS_LENGTH * scale, oy - axis.y * AXIS_LENGTH * scale);
+    ctx.stroke();
+    const labelDistance = (AXIS_LENGTH + AXIS_LABEL_GAP) * scale;
+    ctx.fillText(axis.label, ox + axis.x * labelDistance, oy - axis.y * labelDistance);
+  }
+  ctx.restore();
+}
+
+/** 白い背景の上に、モデル・注記・座標軸を描いた PNG を作る（`w` `h` は CSS px）。 */
+export function composePrintImage(
+  controller: ViewerController,
+  labelLayer: LabelLayer,
+  w: number,
+  h: number,
+): string {
+  const pixelRatio = Math.max(window.devicePixelRatio || 1, PRINT_MIN_PIXEL_RATIO);
+  const model = controller.renderForPrint(pixelRatio);
+
+  const canvas = activeDocument.createElement("canvas");
+  canvas.width = Math.round(w * pixelRatio);
+  canvas.height = Math.round(h * pixelRatio);
+  const ctx = canvas.getContext("2d");
+  if (!ctx) throw new Error("no 2d context");
+
+  ctx.fillStyle = "#ffffff";
+  ctx.fillRect(0, 0, canvas.width, canvas.height);
+  ctx.drawImage(model, 0, 0, canvas.width, canvas.height);
+  labelLayer.drawForPrint(ctx, controller.getCamera(), w, h, pixelRatio);
+  drawAxes(ctx, controller, h, pixelRatio);
+  return canvas.toDataURL("image/png");
+}
diff --git a/.obsidian/plugins/dagnetz-cad-viewer/src/viewer/printImage.ts b/.obsidian/plugins/dagnetz-cad-viewer/src/viewer/printImage.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7d29444c79d2d097ec5c1f678ec9a7de99eb093b
--- /dev/null
+++ b/.obsidian/plugins/dagnetz-cad-viewer/src/viewer/printImage.ts
@@ -0,0 +1,93 @@
+/**
+ * コードブロックの3D表示を、印刷用の画像（PNG）にする
+ *
+ * 1. HTML 出力・PDF 出力・印刷から呼ばれる（WebGL の canvas は HTML へ持ち出せないため画像にする）
+ * 2. 画面外にビューアを1つ作り、コードブロックの視点・断面・注記を復元して描画する
+ * 3. 大きさはコードブロックの幅・高さを踏襲する
+ **/
+
+import { Plugin } from "obsidian";
+import { OcctLoader } from "./OcctLoader";
+import { loadNonStepModel } from "./loadNonStepModel";
+import { mountModel, mountViewer, MountOptions, ViewerHandle } from "./mountViewer";
+import { cacheKey, CACHE_MIN_BYTES } from "./GeometryCache";
+import { hasRenderableMeshes } from "./StepToThree";
+import { paramsForDeflection } from "./params";
+import { printSize } from "./printLayout";
+import { embedDeflection, resolveEmbedFile } from "../embed/embedFile";
+import { parseStepCodeBlock } from "../embed/StepCodeBlockUtils";
+import { HasStepSettings } from "../settings";
+
+export interface PrintImage {
+  dataUrl: string;
+  width: number;
+  height: number;
+}
+
+type PrintPlugin = Plugin & HasStepSettings;
+
+/** 埋め込みと同じ手順でファイルを読み、ビューアを `host` に作る。 */
+async function mountForPrint(
+  plugin: PrintPlugin,
+  host: HTMLElement,
+  source: string,
+  sourcePath: string,
+): Promise<ViewerHandle> {
+  const config = parseStepCodeBlock(source);
+  const file = resolveEmbedFile(plugin, config.path, sourcePath);
+  if (!file) throw new Error(`CAD file not found: ${config.path}`);
+
+  const options: MountOptions = {
+    plugin,
+    filePath: file.path,
+    showAnnotations: config.showAnnotations,
+    initialView: config.view,
+    initialRoll: config.roll,
+    initialCamera: config.camera,
+    initialSection: config.section,
+    initialAnnotations: config.annotations,
+    healFaces: plugin.stepSettings.healFaces,
+  };
+
+  const deflection = embedDeflection(plugin, config.quality, file.stat.size);
+  const model = await loadNonStepModel(plugin.app, file, deflection);
+  if (model) return mountModel(host, model, options);
+
+  const settings = plugin.stepSettings;
+  if (settings.cacheEnabled && file.stat.size >= CACHE_MIN_BYTES) {
+    const key = cacheKey(file.path, file.stat.mtime, file.stat.size, deflection);
+    const cached = await plugin.geometryCache.get(key);
+    if (cached && hasRenderableMeshes(cached)) return mountViewer(host, cached, options);
+  }
+
+  const bytes = new Uint8Array(await plugin.app.vault.readBinary(file));
+  const { result } = await OcctLoader.parseStep(bytes, paramsForDeflection(deflection));
+  if (!hasRenderableMeshes(result)) throw new Error(`No usable geometry: ${file.path}`);
+  return mountViewer(host, result, options);
+}
+
+/** ```step / ```cad コードブロックの中身から、印刷用の画像を作る。 */
+export async function renderPrintImage(
+  plugin: PrintPlugin,
+  source: string,
+  sourcePath: string,
+): Promise<PrintImage> {
+  const size = printSize(parseStepCodeBlock(source));
+
+  // 埋め込みと同じ大きさで描くため、実際の大きさを持つ要素を画面外に置く
+  const host = activeDocument.body.createDiv({ cls: "step-viewer-embed step-viewer-print-host" });
+  host.style.position = "fixed";
+  host.style.left = "-100000px";
+  host.style.top = "0";
+  host.style.width = `${size.width}px`;
+  host.style.height = `${size.height}px`;
+
+  let viewer: ViewerHandle | null = null;
+  try {
+    viewer = await mountForPrint(plugin, host, source, sourcePath);
+    return { dataUrl: await viewer.capturePrintImage(), ...size };
+  } finally {
+    viewer?.dispose();
+    host.remove();
+  }
+}
diff --git a/.obsidian/plugins/dagnetz-cad-viewer/src/viewer/printLayout.test.ts b/.obsidian/plugins/dagnetz-cad-viewer/src/viewer/printLayout.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7f377d90cdb60f4dd1d5dc7adb68a11d7487c10c
--- /dev/null
+++ b/.obsidian/plugins/dagnetz-cad-viewer/src/viewer/printLayout.test.ts
@@ -0,0 +1,93 @@
+/**
+ * 印刷用画像のレイアウト計算のテスト
+ *
+ * 1. 画像の大きさはコードブロックの幅・高さに従う
+ * 2. 白い背景で読めない文字色を置き換える
+ * 3. 注記の折り返し
+ * 4. 座標軸の画面上の向き
+ **/
+
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import * as THREE from "three";
+import {
+  PRINT_DEFAULT_HEIGHT,
+  PRINT_DEFAULT_WIDTH,
+  printSize,
+  readablePrintColor,
+  screenAxes,
+  wrapPrintText,
+} from "./printLayout";
+
+test("printSize: コードブロックの幅と高さをそのまま使う", () => {
+  assert.deepEqual(printSize({ width: 579, height: 661 }), { width: 579, height: 661 });
+});
+
+test("printSize: 指定が無いときは既定の大きさにする", () => {
+  assert.deepEqual(printSize({}), { width: PRINT_DEFAULT_WIDTH, height: PRINT_DEFAULT_HEIGHT });
+  assert.deepEqual(printSize({ height: 300 }), { width: PRINT_DEFAULT_WIDTH, height: 300 });
+});
+
+test("readablePrintColor: 指定の無い文字は濃い色にする（ダークテーマの白文字を持ち込まない）", () => {
+  assert.equal(readablePrintColor(undefined), "#111111");
+});
+
+test("readablePrintColor: 白・黄色は白い背景で読めないため濃い色にする", () => {
+  assert.equal(readablePrintColor("#ffffff"), "#111111");
+  assert.equal(readablePrintColor("#fff"), "#111111");
+  assert.equal(readablePrintColor("#ffc531"), "#111111");
+});
+
+test("readablePrintColor: 読める色はそのまま使う", () => {
+  assert.equal(readablePrintColor("#000000"), "#000000");
+  assert.equal(readablePrintColor("#e5484d"), "#e5484d");
+  assert.equal(readablePrintColor("#30a46c"), "#30a46c");
+  assert.equal(readablePrintColor("rebeccapurple"), "rebeccapurple");
+});
+
+test("wrapPrintText: 幅に収まる行は折り返さない", () => {
+  assert.deepEqual(wrapPrintText("abc", 10, (s) => s.length), ["abc"]);
+});
+
+test("wrapPrintText: 改行を保ち、長い行は文字単位で折り返す", () => {
+  assert.deepEqual(wrapPrintText("abcde\nあいう", 2, (s) => s.length), ["ab", "cd", "e", "あい", "う"]);
+});
+
+test("wrapPrintText: 末尾の空行は出さない", () => {
+  assert.deepEqual(wrapPrintText("thnalktnha\n", 100, (s) => s.length), ["thnalktnha"]);
+});
+
+test("wrapPrintText: 途中の空行は残す", () => {
+  assert.deepEqual(wrapPrintText("a\n\nb", 100, (s) => s.length), ["a", "", "b"]);
+});
+
+const axisOf = (axes: ReturnType<typeof screenAxes>, label: string) => {
+  const axis = axes.find((a) => a.label === label);
+  assert.ok(axis);
+  return axis;
+};
+
+test("screenAxes: 正面から見ると X は右、Y は上、Z は手前を向く", () => {
+  const axes = screenAxes(new THREE.Quaternion(), new THREE.Quaternion());
+  assert.ok(Math.abs(axisOf(axes, "X").x - 1) < 1e-9);
+  assert.ok(Math.abs(axisOf(axes, "Y").y - 1) < 1e-9);
+  assert.ok(Math.abs(axisOf(axes, "Z").depth - 1) < 1e-9);
+});
+
+test("screenAxes: カメラを右へ90度回すと X は手前を向かず奥へ向く", () => {
+  const camera = new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(0, 1, 0), -Math.PI / 2);
+  const axes = screenAxes(camera, new THREE.Quaternion());
+  assert.ok(Math.abs(axisOf(axes, "X").depth + 1) < 1e-9);
+  assert.ok(Math.abs(axisOf(axes, "Z").x - 1) < 1e-9);
+});
+
+test("screenAxes: モデルの回転（90°回転ボタン）を反映する", () => {
+  const model = new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(0, 0, 1), Math.PI / 2);
+  const axes = screenAxes(new THREE.Quaternion(), model);
+  assert.ok(Math.abs(axisOf(axes, "X").y - 1) < 1e-9);
+});
+
+test("screenAxes: 手前の軸が最後に描かれるよう、奥から順に並べる", () => {
+  const axes = screenAxes(new THREE.Quaternion(), new THREE.Quaternion());
+  assert.equal(axes[axes.length - 1].label, "Z");
+});
diff --git a/.obsidian/plugins/dagnetz-cad-viewer/src/viewer/printLayout.ts b/.obsidian/plugins/dagnetz-cad-viewer/src/viewer/printLayout.ts
new file mode 100644
index 0000000000000000000000000000000000000000..96f720691ba645a83e0d6314c7d69be56c05fc82
--- /dev/null
+++ b/.obsidian/plugins/dagnetz-cad-viewer/src/viewer/printLayout.ts
@@ -0,0 +1,96 @@
+/**
+ * 印刷用画像のレイアウト計算（DOM・WebGL に依存しない部分）
+ *
+ * 1. コードブロックの幅・高さから画像の大きさを決める（幅の指定が無いときはノートの本文幅）
+ * 2. 白い背景で読めない文字色を、読める色へ置き換える
+ * 3. 注記の文字を、ビューアの注記カードと同じ幅で折り返す
+ * 4. モデルの座標軸（X/Y/Z）が画面上で向く方向を求める
+ **/
+
+import * as THREE from "three";
+
+/** 幅の指定が無い埋め込みの幅（Obsidian の読みやすい行幅）。 */
+export const PRINT_DEFAULT_WIDTH = 700;
+export const PRINT_DEFAULT_HEIGHT = 400;
+/** 画面の解像度が低くても、印刷で粗くならないよう最低2倍で描く。 */
+export const PRINT_MIN_PIXEL_RATIO = 2;
+
+const DEFAULT_TEXT_COLOR = "#111111";
+/** これより明るい文字色は白い背景で読めない。 */
+const MAX_TEXT_LUMINANCE = 0.6;
+
+const AXES = [
+  { label: "X", color: "#e5484d", dir: new THREE.Vector3(1, 0, 0) },
+  { label: "Y", color: "#30a46c", dir: new THREE.Vector3(0, 1, 0) },
+  { label: "Z", color: "#3b82f6", dir: new THREE.Vector3(0, 0, 1) },
+];
+
+export interface PrintSize {
+  width: number;
+  height: number;
+}
+
+export interface ScreenAxis {
+  label: string;
+  color: string;
+  /** 画面上の向き（右が +x、上が +y。長さは 0〜1）。 */
+  x: number;
+  y: number;
+  /** 手前へ向く大きさ。奥の軸から順に描くために使う。 */
+  depth: number;
+}
+
+export function printSize(config: { width?: number; height?: number }): PrintSize {
+  return {
+    width: config.width ?? PRINT_DEFAULT_WIDTH,
+    height: config.height ?? PRINT_DEFAULT_HEIGHT,
+  };
+}
+
+/** `#rgb` / `#rrggbb` の明るさ（0〜1）。それ以外の書き方は null。 */
+function hexLuminance(color: string): number | null {
+  const m = /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.exec(color.trim());
+  if (!m) return null;
+  const hex = m[1].length === 3 ? m[1].replace(/./g, "$&$&") : m[1];
+  const [r, g, b] = [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
+  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
+}
+
+export function readablePrintColor(color: string | undefined): string {
+  if (!color) return DEFAULT_TEXT_COLOR;
+  const luminance = hexLuminance(color);
+  return luminance !== null && luminance > MAX_TEXT_LUMINANCE ? DEFAULT_TEXT_COLOR : color;
+}
+
+/** 改行を保ったまま、`maxWidth` に収まるよう1文字単位で折り返す（ビューアの word-break: break-word 相当）。 */
+export function wrapPrintText(
+  text: string,
+  maxWidth: number,
+  measure: (line: string) => number,
+): string[] {
+  const lines: string[] = [];
+  for (const paragraph of text.replace(/\s+$/, "").split("\n")) {
+    let line = "";
+    for (const ch of paragraph) {
+      if (line && measure(line + ch) > maxWidth) {
+        lines.push(line);
+        line = "";
+      }
+      line += ch;
+    }
+    lines.push(line);
+  }
+  return lines;
+}
+
+/** モデルの X/Y/Z 軸が画面上で向く方向を、奥の軸から順に返す。 */
+export function screenAxes(
+  cameraQuaternion: THREE.Quaternion,
+  modelQuaternion: THREE.Quaternion,
+): ScreenAxis[] {
+  const toCamera = cameraQuaternion.clone().invert();
+  return AXES.map(({ label, color, dir }) => {
+    const v = dir.clone().applyQuaternion(modelQuaternion).applyQuaternion(toCamera);
+    return { label, color, x: v.x, y: v.y, depth: v.z };
+  }).sort((a, b) => a.depth - b.depth);
+}
