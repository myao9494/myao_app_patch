+        titleEl.title = "ドラッグして移動（画像を見ながら名前を入力できます）";
+
+        // 背景暗転の透過度を下げて後ろの画像を見やすくする
+        const modalBg = modalEl.parentElement?.querySelector?.(".modal-bg");
+        if (modalBg) {
+            modalBg.style.opacity = "0.2";
