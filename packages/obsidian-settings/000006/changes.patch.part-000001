+
+/* マークダウン上で選択中の画像ハイライト（rキーでリネーム可能であることを明示） */
+.custom-selected-markdown-image {
+    outline: 2px solid var(--interactive-accent) !important;
+    outline-offset: 2px !important;
+    border-radius: 4px;
+}
