+        ],
     });
 
     // Excalidrawが非同期で画像を生成するため、生成直後にも幅を再計測する。
@@ -5035,6 +5924,7 @@ const handleFileMenu = (menu, file, source, leaf) => {
                 const items = Array.from(menu.dom.querySelectorAll(".menu-item"));
                 const copyUrlItem = items.find(el => el.textContent.includes("保管庫からのパスをコピー"));
                 const copyImageItem = items.find(el => el.textContent.includes("画像をクリップボードにコピー"));
+                const compressItem = items.find(el => el.textContent.includes("画像の容量を縮小"));
                 const moveItem = items.find(el => el.textContent.includes("共通画像フォルダへ移動"));
                 const compareItem = items.find(el => el.textContent.includes("クリップボードの画像との比較"));
                 const replaceItem = items.find(el => el.textContent.includes("クリップボードの画像と差し替え"));
@@ -5046,6 +5936,7 @@ const handleFileMenu = (menu, file, source, leaf) => {
                 if (replaceItem) menu.dom.prepend(replaceItem);
                 if (compareItem) menu.dom.prepend(compareItem);
                 if (moveItem) menu.dom.prepend(moveItem);
+                if (compressItem) menu.dom.prepend(compressItem);
                 if (drawioItem) menu.dom.prepend(drawioItem);
                 if (copyUrlItem) menu.dom.prepend(copyUrlItem);
                 if (copyImageItem) menu.dom.prepend(copyImageItem);
diff --git a/docs/image_compress_flow.excalidraw.md b/docs/image_compress_flow.excalidraw.md
new file mode 100644
index 0000000000000000000000000000000000000000..30e0ae181132533849c16f19d9534c3a2774400f
--- /dev/null
+++ b/docs/image_compress_flow.excalidraw.md
@@ -0,0 +1,527 @@
+<!--
+/**
+ * 画像右クリックメニュー「画像の容量を縮小」機能 処理フロー図
+ * 
+ * 1. 画像右クリック: マークダウン内またはファイルメニューで「画像の容量を縮小」を選択
+ * 2. モーダル起動: 目標容量入力（KB）とプリセットボタン、ドラッグ移動可能なUI
+ * 3. 圧縮プレビュー: 二分探索で最適な解像度・品質を計算し、プレビュー画像と削減率を表示
+ * 4. 置換実行: プレビュー確認後に「置き換える」を押下し、元ファイルを上書き保存して画面同期
+ **/
+-->
+---
+
+excalidraw-plugin: parsed
+tags: [excalidraw]
+
+---
+==⚠  Switch to EXCALIDRAW VIEW in the MORE OPTIONS menu of this document. ⚠== You can decompress Drawing data with the command palette: 'Decompress current Excalidraw file'. For more info check in plugin settings under 'Saving'
+
+# Excalidraw Data
+
+## Text Elements
+画像の容量を縮小 処理フロー図 ^title
+① 画像を右クリック ^step1-title
+マークダウン内またはファイルメニューで「画像の容量を縮小」を選択 ^step1-desc
+② 全画面3/4の特大モーダルが開く ^step2-title
+全画面約3/4サイズでプレビューも特大表示。タイトルバーを掴んでドラッグ移動可能 ^step2-desc
+③ 目標容量（KB）の指定 ^step3-title
+数値入力またはプリセットボタン（100KB/300KB/500KB/1MB等）で指定 ^step3-desc
+④ 自動圧縮・大画面プレビュー ＆ 比較表示 ^step4-title
+「縮小後」「元画像」「左右並べて比較」で画質の違いを一目で判別可能 ^step4-desc
+⑤ プレビューを目視確認して「置き換える」 ^step5-title
+app.vault.modifyBinary で上書き保存し、画面内の画像表示を即座に更新 ^step5-desc
+
+## Drawing
