+{
+	"id": "obsidian42-text-transporter",
+	"name": "Text Transporter",
+	"version": "1.0.12",
+	"minAppVersion": "1.7.2",
+	"description": "Advanced text tools for working with text in your vault",
+	"author": "TfTHacker",
+	"authorUrl": "https://github.com/TfTHacker/obsidian42-text-transporter",
+	"helpUrl": "https://tfthacker.com/transporter",
+	"isDesktopOnly": false,
+	"fundingUrl": {
+		"Sponsor my work": "https://tfthacker.com/sponsor"
+	}
+}
