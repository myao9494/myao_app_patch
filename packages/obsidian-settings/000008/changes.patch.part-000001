+      name: "Toggle Complement automatically",
+      callback: async () => {
+        await this.settingTab.toggleComplementAutomatically();
+      }
+    });
+    this.addCommand({
+      id: "show-suggestions",
+      name: "Show suggestions",
+      hotkeys: [{ modifiers: ["Mod"], key: " " }],
