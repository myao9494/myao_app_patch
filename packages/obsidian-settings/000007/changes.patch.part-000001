-        const maxCols = Math.max(...rows.map(r => r.length));
-        if (maxCols === 0) return "";
+    const headerRow = normalizedRows[0];
+    const separatorRow = new Array(maxCols).fill("---");
+    const dataRows = normalizedRows.slice(1);
 
