-            const padded = [...r];
-            while (padded.length < maxCols) padded.push("");
-            return padded;
-        });
+    const markdownTableLines = [
+        `| ${headerRow.join(" | ")} |`,
+        `| ${separatorRow.join(" | ")} |`,
+        ...dataRows.map(row => `| ${row.join(" | ")} |`)
+    ];
 
-        const headerRow = normalizedRows[0];
