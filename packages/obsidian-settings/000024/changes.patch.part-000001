ardDesc:"\uBCF4\uB4DC\uB97C \uCC44\uC6B8 \uCE74\uB4DC\uB97C \uC120\uD0DD\uD569\uB2C8\uB2E4. \uB2E4\uB978 \uCE74\uB4DC\uB3C4 \uBCF4\uB4DC\uC5D0 \uB0A8\uC544 \uC788\uC73C\uBA70 \uCE74\uB4DC \uC720\uD615\uC73C\uB85C \uB3CC\uC544\uC624\uBA74 \uB2E4\uC2DC \uD45C\uC2DC\uB429\uB2C8\uB2E4.",singleCardEdit:"\uCE74\uB4DC \uD3B8\uC9D1",singleCardAdd:"\uC0C8 \uCE74\uB4DC \uCD94\uAC00",pluginViewType:"\uBCF4\uAE30",pluginViewTypeDesc:"\uBCF4\uB4DC\uB97C \uCC44\uC6B8 \uB4F1\uB85D\uB41C \uBCF4\uAE30\uB97C \uC120\uD0DD\uD569\uB2C8\uB2E4. \uBAA9\uB85D\uC740 \uD604\uC7AC \uD65C\uC131\uD654\uB41C \uD50C\uB7EC\uADF8\uC778\uC5D0 \uB530\uB77C \uB2EC\uB77C\uC9D1\uB2C8\uB2E4.",pluginViewTypeNone:"\uBCF4\uAE30 \uC120\uD0DD\u2026",pluginViewFile:"\uD30C\uC77C",pluginViewFileDesc:"Canvas\uB098 Excalidraw \uADF8\uB9BC \uB4F1 \uD2B9\uC815 \uD30C\uC77C\uC5D0\uC11C \uBCF4\uAE30\uB97C \uC5FD\uB2C8\uB2E4. \uBE44\uC6CC \uB450\uBA74 \uBCF4\uAE30 \uC790\uCCB4\uB97C \uD45C\uC2DC\uD569\uB2C8\uB2E4.",pluginViewFileRequiredDesc:"\uC774 \uBCF4\uAE30\uC5D0\uB294 \uD30C\uC77C\uC774 \uD544\uC694\uD569\uB2C8\uB2E4. \uB300\uC2DC\uBCF4\uB4DC\uC5D0\uC11C \uC5F4 \uB178\uD2B8, PDF \uB610\uB294 \uC774\uBBF8\uC9C0\uB97C \uC120\uD0DD\uD558\uC138\uC694.",pluginViewHideHeader:"\uBCF4\uAE30\uC758 \uBA38\uB9AC\uAE00 \uC228\uAE30\uAE30",pluginViewHideHeaderDesc:"\uBCF4\uAE30\uC758 \uACBD\uB85C \uD45C\uC2DC, \uB4A4\uB85C/\uC55E\uC73C\uB85C \uD654\uC0B4\uD45C, \uBA54\uB274\uB97C \uC228\uAE41\uB2C8\uB2E4. \uBCF4\uAE30 \uC790\uCCB4\uC758 \uB3C4\uAD6C \uBAA8\uC74C\uACFC \uD0ED\uC740 \uC720\uC9C0\uB429\uB2C8\uB2E4.",pluginViewKeepMounted:"\uBC31\uADF8\uB77C\uC6B4\uB4DC\uC5D0\uC11C \uACC4\uC18D \uC2E4\uD589",pluginViewKeepMountedDesc:"\uB2E4\uB978 \uB300\uC2DC\uBCF4\uB4DC\uB97C \uBCF4\uB294 \uB3D9\uC548\uC5D0\uB3C4 \uB85C\uB4DC\uB41C \uC0C1\uD0DC\uB85C \uC720\uC9C0\uD574 \uB2E4\uC2DC \uB3CC\uC544\uC62C \uB54C \uBC14\uB85C \uD45C\uC2DC\uD569\uB2C8\uB2E4. \uBB34\uAC70\uC6B4 \uD50C\uB7EC\uADF8\uC778\uC774\uB77C\uBA74 \uB044\uC138\uC694. \uB3D9\uC2DC\uC5D0 \uC720\uC9C0\uB418\uB294 \uBCF4\uB4DC \uC218\uC5D0\uB294 \uC81C\uD55C\uC774 \uC788\uC2B5\uB2C8\uB2E4.",pluginViewFocusable:"\uBCF4\uAE30\uC5D0 \uD3EC\uCEE4\uC2A4 \uD5C8\uC6A9 (\uC2E4\uD5D8\uC801)",pluginViewFocusableDesc:"\uC791\uC5C5 \uC911\uC778 \uBCF4\uAE30\uB97C \uD65C\uC131 \uD328\uB110\uB85C \uC124\uC815\uD574 \uD50C\uB7EC\uADF8\uC778 \uBA85\uB839\uACFC \uB2E8\uCD95\uD0A4\uAC00 \uC791\uB3D9\uD558\uAC8C \uD569\uB2C8\uB2E4. Obsidian\uC740 \uD65C\uC131 \uD328\uB110\uC5D0\uC11C \uB178\uD2B8\uB97C \uC5F4\uAE30 \uB54C\uBB38\uC5D0 \uB9C1\uD06C\uB97C \uD074\uB9AD\uD558\uBA74 \uBCF4\uAE30\uAC00 \uBC14\uB014 \uC218 \uC788\uC2B5\uB2C8\uB2E4.",pluginViewPerfNote:"\uD638\uC2A4\uD305\uB41C \uBCF4\uAE30\uB294 \uBBF8\uB9AC \uBCF4\uAE30\uAC00 \uC544\uB2C8\uB77C \uD50C\uB7EC\uADF8\uC778\uC758 \uC804\uCCB4 \uAE30\uB2A5\uC744 \uC2E4\uD589\uD569\uB2C8\uB2E4. \uC790\uCCB4 \uD0ED\uC5D0\uC11C \uB290\uB9B0 \uBCF4\uAE30\uB294 \uC5EC\uAE30\uC11C\uB3C4 \uB290\uB9BD\uB2C8\uB2E4.",switcherIcon:"\uC804\uD658\uAE30 \uC544\uC774\uCF58",switcherIconDesc:"\uC804\uD658\uAE30 \uBC84\uD2BC\uC5D0 \uD45C\uC2DC\uD560 \uC774\uBAA8\uC9C0\uB098 \uC9E7\uC740 \uD14D\uC2A4\uD2B8\uC785\uB2C8\uB2E4. \uBE44\uC6CC \uB450\uBA74 \uBC88\uD638\uB97C \uD45C\uC2DC\uD569\uB2C8\uB2E4.",switcherLucide:"\uC804\uD658\uAE30 Lucide \uC544\uC774\uCF58",switcherLucideDesc:"Lucide \uC544\uC774\uCF58(\uC608: home, star, layout-dashboard)\uC744 \uC120\uD0DD\uD558\uAC70\uB098 ID\uB97C \uC785\uB825\uD558\uC138\uC694. \uC704\uC758 \uC774\uBAA8\uC9C0\uBCF4\uB2E4 \uC6B0\uC120\uD569\uB2C8\uB2E4.",linkedWorkspace:"\uC5F0\uACB0\uB41C \uC791\uC5C5 \uACF5\uAC04",linkedWorkspaceDesc:"\uC791\uC5C5 \uACF5\uAC04\uC744 \uBD88\uB7EC\uC62C \uB54C \uC774 \uB300\uC2DC\uBCF4\uB4DC\uB85C \uC790\uB3D9 \uC804\uD658\uD569\uB2C8\uB2E4. \uAE30\uBCF8 Workspaces \uD50C\uB7EC\uADF8\uC778\uC774 \uD544\uC694\uD569\uB2C8\uB2E4.",linkedWorkspaceNone:"\uC5C6\uC74C",mobileDefault:"\uBAA8\uBC14\uC77C \uAE30\uBCF8\uAC12",mobileDefaultDesc:"