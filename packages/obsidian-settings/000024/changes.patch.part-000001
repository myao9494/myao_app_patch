esignDesc:"\uD074\uB798\uC2DD\uD55C \uADF8\uB9BC \uC2A4\uD0C0\uC77C \uB610\uB294 \uC5B8\uB355, \uAD6C\uB984, \uC6C0\uC9C1\uC774\uB294 \uD574\uAC00 \uC788\uB294 Material 3 Expressive \uC2A4\uD0C0\uC77C\uC785\uB2C8\uB2E4.",wallpaperDesignDesc:"Hearth\uAC00 \uADF8\uB9B0 \uD074\uB798\uC2DD \uC5B8\uB355\uACFC \uC624\uB450\uB9C9 \uB610\uB294 \uAC15\uC870 \uC0C9\uC0C1 \uACC4\uC5F4\uC758 Material 3 Expressive \uBC30\uACBD\uC785\uB2C8\uB2E4. \uB2E4\uC6B4\uB85C\uB4DC\uB294 \uBC1C\uC0DD\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.",skyDesignClassic:"\uD074\uB798\uC2DD (\uADF8\uB9BC)",skyDesignExpressive:"Expressive (\uB2E8\uC0C9 \uB3C4\uD615)"},behaviour:{...A.settings.behaviour,heading:"\uB3D9\uC791",headingDesc:"Hearth\uB97C \uC5EC\uB294 \uC2DC\uC810\uACFC \uC704\uCE58, \uBAA8\uBC14\uC77C \uAC80\uC0C9 \uC804\uC6A9 \uBAA8\uB4DC\uB97C \uC124\uC815\uD569\uB2C8\uB2E4.",openOnStartup:"\uC2DC\uC791\uD560 \uB54C \uC5F4\uAE30",openOnStartupDesc:"\uBCF4\uAD00\uD568\uC744 \uBD88\uB7EC\uC62C \uB54C \uD648 \uD654\uBA74\uC744 \uC5FD\uB2C8\uB2E4.",replaceNewTabs:"\uC0C8 \uD0ED \uB300\uC2E0 \uC5F4\uAE30",replaceNewTabsDesc:"\uBE48 \uC0C8 \uD0ED \uB300\uC2E0 \uD648 \uD654\uBA74\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4.",focusSearchOnOpen:"\uC5F4 \uB54C \uAC80\uC0C9\uCC3D\uC5D0 \uD3EC\uCEE4\uC2A4",focusSearchOnOpenDesc:"\uD648 \uD654\uBA74\uC744 \uC5F4 \uB54C \uAC80\uC0C9\uCC3D\uC5D0 \uCEE4\uC11C\uB97C \uB450\uC5B4 \uBC14\uB85C \uC785\uB825\uD560 \uC218 \uC788\uAC8C \uD569\uB2C8\uB2E4. \uB370\uC2A4\uD06C\uD1B1 \uC804\uC6A9\uC785\uB2C8\uB2E4.",liveRefresh:"\uBCF4\uAD00\uD568 \uBCC0\uACBD \uC2DC \uC2E4\uC2DC\uAC04 \uAC31\uC2E0",liveRefreshDesc:"\uBCF4\uAD00\uD568\uC774 \uBC14\uB00C\uBA74 \uCD5C\uADFC \uD56D\uBAA9, \uBD81\uB9C8\uD06C, \uC800\uC7A5\uB41C \uAC80\uC0C9 \uCE74\uB4DC \uB4F1\uC744 \uAC31\uC2E0\uD569\uB2C8\uB2E4. Hearth \uD0ED\uC73C\uB85C \uB3CC\uC544\uC624\uBA74 \uC774 \uC124\uC815\uACFC \uAD00\uACC4\uC5C6\uC774 \uAC31\uC2E0\uB429\uB2C8\uB2E4.",liveSettingsSync:"\uB3D9\uAE30\uD654\uB41C \uBCC0\