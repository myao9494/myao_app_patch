ems in this feed",error:"Couldn't load this feed",disabled:"Feeds are off (external calls disabled)",refresh:"Refresh",nothingToOpen:"This entry has no link or text to open.",allFeeds:"All feeds",allRead:"All caught up",unreadOnly:"Show unread only",showAll:"Show all entries",markAllRead:"Mark all as read",markRead:"Mark as read",markUnread:"Mark as unread",readHere:"Read in Hearth",openTab:"Read in a new tab",openBrowser:"Open in browser",saveNote:"Save as note",openNote:"Open saved note",copyLink:"Copy link",linkCopied:"Link copied",reader:{title:"Reader",gone:"This feed card no longer exists.",noItems:"Nothing to read here.",toggleList:"Show or hide the list",prevFeed:"Previous feed",nextFeed:"Next feed",popOut:"Open in a tab",prev:"Previous",next:"Next",position:(e,t)=>`${e} of ${t}`,keys:"\u2190 \u2192 entries \xB7 [ ] feeds \xB7 o open \xB7 s save \xB7 u unread \xB7 i pictures \xB7 l list",imagesBlocked:e=>e===1?"1 picture not loaded.":`${e} pictures not loaded.`,loadImages:"Load pictures",noteSaved:e=>`Saved as ${e}`,noteFailed:"Couldn't create the note."}},market:{types:{equity:"Stock",etf:"ETF",fund:"Fund",index:"Index",currency:"Currency",crypto:"Crypto",future:"Future",other:""},states:{open:"Open",pre:"Pre-market",post:"After hours",closed:"Closed"},ranges:{"1d":"1D","5d":"5D","1mo":"1M","6mo":"6M","1y":"1Y","5y":"5Y"},rangeNames:{"1d":"One day","5d":"Five days","1mo":"One month","6mo":"Six months","1y":"One year","5y":"Five years"},sources:{yahoo:"Yahoo Finance",tencent:"Tencent",eastmoney:"Eastmoney",coingecko:"CoinGecko",frankfurter:"ECB (Frankfurter)"},updated:e=>`Updated ${e}`,loadingShort:"Loading\u2026",unavailable:"Unavailable",disabled:"External calls are off \u2014 quotes can't be fetched",noChart:"No chart for this range",dayRange:"Day's range",yearRange:"52-week range",open:"Open",prevClose:"Previous close",volume:"Volume",currency:"Currency",source:"Source",asOf:"As of",totalValue:"Total value",noHoldings:"Set how many units you hold in card settings",today:"Today",totalGain:"Total",notConverted:e=>e===1?"1 holding left out: no exchange rate for its currency":`${e} holdings left out: no exchange rate for their currency`,units:e=>`${e.toLocaleString()} units`,position:"Your position",unitsLabel:"Units",value:"Value",avgCost:"Average cost",costBasis:"Cost basis",openInBrowser:"Open in browser",refresh:"Refresh",searchPlaceholder:"Search a stock, fund, currency or coin",searchDisabled:"Search is off while external calls are disabled",searching:"Searching\u2026",noResults:"Nothing found",lookupHint:"Search for anything above \u2014 a name, a ticker, a fund code, a currency pair \u2014 and add it with one click.",back:"Back",addToCard:"Add to card",onCard:"On the card",added:e=>`Added ${e}`},tension:{title:"World tension",bands:{cool:"Cool",mild:"Mild",warm:"Warm",hot:"Hot",burning:"Burning"},loading:"Reading the news\u2026",error:"Couldn't load the World Tension index",disabled:"World tension is off (external calls disabled)",none:"Kagi has no World Tension index published right now",open:"Open the World Tension index on Kagi News",aria:(e,t)=>`World tension ${e} of 100, ${t}`,source:"AI assessment \xB7 Kagi News",updated:e=>`Updated ${e}`,historyTip:(e,t,n)=>`Last ${e} days: ${t}\u2013${n}`,changeTip:"Change since the day before"},weather:{loading:"Loading forecast\u2026",error:"Couldn't load the forecast",disabled:"Weather is off (external calls disabled)",now:"Now",todayLabel:"Today",feelsLike:e=>`Feels like ${e}`,highLow:(e,t)=>`H ${e} \xB7 L ${t}`,updated:e=>`Updated ${e}`,humidity:"Humidity",wind:"Wind",precip:"Precipitation",uv:"UV",pressure:"Pressure",sunrise:"Sunrise",sunset:"Sunset",compass:["N","NE","E","SE","S","SW","W","NW"],duration:(e,t)=>e?`${e} h ${t} min`:`${t} min`,moon:{label:"Moon",phases:{new:"New moon",waxingCrescent:"Waxing crescent",firstQuarter:"First quarter",waxingGibbous:"Waxing gibbous",full:"Full moon",waningGibbous:"Waning gibbous",lastQuarter:"Last quarter",waningCrescent:"