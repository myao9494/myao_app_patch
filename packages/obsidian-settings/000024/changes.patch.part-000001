+	background: var(--x-container);
+	color: var(--x-on-container);
+}
+
+/* Matrix: quadrants as tonal containers in their own colour, the counts as
+ * pills, the axes in the accent's tone — the Kanban columns' recipe. */
+:is(.hearth-card.is-expressive, .hearth-x-modal) .hearth-matrix {
