+}
+
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-agenda-evbadge.is-timeblock {
+	border: none;
+	background: var(--x-container);
+	color: var(--x-on-container);
+}
+
+/* ---- RSS ------------------------------------------------------------ */
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-rss-tab {
+	padding: 3px 12px;
+	background: var(--x-surface-high);
+	color: var(--x-on-container);
+	font-weight: 600;
+}
+
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-rss-tab.is-active {
+	background: var(--x-primary);
+	color: var(--x-on-primary);
+}
+
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-rss-tabmore {
+	height: 24px;
+	background: var(--x-surface-high);
+	color: var(--x-on-container);
+	font-weight: 650;
+}
+
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-rss-refresh,
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-jira-refresh,
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-git-refresh {
+	border-radius: 999px;
+	background: var(--x-surface-high);
+	color: var(--x-on-container);
+	box-shadow: none;
+}
+
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-rss-refresh:hover,
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-jira-refresh:hover,
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-git-refresh:hover {
+	background: var(--x-container);
+	color: var(--x-on-container);
+}
+
+/* Items as the grouped list's tonal rows. */
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-rss-content {
+	gap: 3px;
+}
+
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-rss-item {
+	padding: 8px 12px;
+	border-bottom: none;
+	border-radius: 6px;
+	background: var(--x-surface);
+	transition: background 120ms ease, border-radius 160ms ease;
+}
+
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-rss-item:first-child {
+	border-top-left-radius: 20px;
+	border-top-right-radius: 20px;
+}
+
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-rss-item:last-child {
+	border-bottom-left-radius: 20px;
+	border-bottom-right-radius: 20px;
+}
+
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-rss-item:hover {
+	background: var(--x-surface-highest);
+	border-radius: 20px;
+}
+
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-rss-title {
+	font-weight: 700;
+	letter-spacing: -0.01em;
+}
+
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-rss-meta {
+	color: var(--x-on-container);
+	font-weight: 600;
+	opacity: 0.8;
+}
+
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-rss-thumb {
+	border-radius: 16px;
+}
+
+/* ---- Jira ----------------------------------------------------------- */
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-jira-filter > summary {
+	padding: 4px 12px;
+	border: none;
+	background: var(--x-surface-high);
