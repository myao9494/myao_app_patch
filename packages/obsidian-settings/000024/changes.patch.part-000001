uB85C \uD654\uC0B4\uD45C, \uBA54\uB274)\uC744 \uC228\uAE41\uB2C8\uB2E4. \uCE74\uB4DC\uC5D0 \uD30C\uC77C \uD558\uB098\uB9CC \uD45C\uC2DC\uD560 \uB54C \uC720\uC6A9\uD569\uB2C8\uB2E4.",perfLabel:"\uC131\uB2A5",perfNote:"Hearth\uC5D0\uC11C \uAC00\uC7A5 \uBB34\uAC70\uC6B4 \uCE74\uB4DC\uC785\uB2C8\uB2E4. \uB2E4\uB978 \uD50C\uB7EC\uADF8\uC778\uC758 \uC804\uCCB4 \uBCF4\uAE30\uB97C \uB300\uC2DC\uBCF4\uB4DC \uC548\uC5D0\uC11C \uC2E4\uC2DC\uAC04\uC73C\uB85C \uC2E4\uD589\uD558\uBBC0\uB85C, \uBCF4\uB4DC\uAC00 \uC5F4\uB824 \uC788\uB294 \uB3D9\uC548 \uD574\uB2F9 \uD50C\uB7EC\uADF8\uC778\uC758 \uD0C0\uC774\uBA38, \uB9AC\uC2A4\uB108, \uB80C\uB354\uB9C1\uC774 \uACC4\uC18D \uB3D9\uC791\uD558\uBA70 \uC774 \uCE74\uB4DC\uB97C \uCD94\uAC00\uD560 \uB54C\uB9C8\uB2E4 \uADF8 \uBE44\uC6A9\uC774 \uB2E4\uC2DC \uB4ED\uB2C8\uB2E4. \uD55C\uB450 \uAC1C\uAE4C\uC9C0\uB9CC \uC0AC\uC6A9\uD558\uACE0, \uC0AC\uC591\uC774 \uB0AE\uC740 \uAE30\uAE30\uC5D0\uC11C\uB294 \uB300\uC2DC\uBCF4\uB4DC\uAC00 \uB290\uB824\uC9C8 \uC218 \uC788\uC74C\uC744 \uAC10\uC548\uD558\uC138\uC694.",perfNoteTier:"\uC131\uB2A5 \uB4F1\uAE09\uC744 \uB0AE\uCDC4\uC2B5\uB2C8\uB2E4. \uAC00\uC838\uC628 \uBCF4\uAE30\uB294 \uC2A4\uC2A4\uB85C \uAD00\uB9AC\uB418\uBBC0\uB85C \uC131\uB2A5 \uB4F1\uAE09\uC73C\uB85C \uC774 \uCE74\uB4DC\uB97C \uAC00\uBCCD\uAC8C \uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uB300\uC2DC\uBCF4\uB4DC\uAC00 \uC5EC\uC804\uD788 \uBB34\uAC81\uAC8C \uB290\uAEF4\uC9C4\uB2E4\uBA74 \uC774 \uCE74\uB4DC\uB97C \uC81C\uAC70\uD558\uB294 \uAC83\uC774 \uAC00\uC7A5 \uD6A8\uACFC\uC801\uC785\uB2C8\uB2E4.",note:"\uBCA0\uD0C0",noteDesc:"\uB2E4\uB978 \uD50C\uB7EC\uADF8\uC778\uC758 \uBCF4\uAE30\uB97C \uCE74\uB4DC \uC548\uC5D0\uC11C \uD45C\uC2DC\uD569\uB2C8\uB2E4. \uC77C\uBD80 \uBCF4\uAE30\uB294 \uC0AC\uC774\uB4DC\uBC14\uB97C \uC804\uC81C\uB85C \uD558\uBBC0\uB85C \uC5EC\uAE30\uC11C\uB294 \uD45C\uC2DC\uB098 \uD06C\uAE30\uAC00 \uC5B4\uC0C9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."},pet:{...A.editors.pet,species:"\uB3D9\uBB3C",name:"\uC774\uB984",nameDesc:"\uD3AB\uC758 \uC774\uB984\uC785\uB2C8\uB2E4. \uBE44\uC6CC \uB450\uBA74 \uB3D9\uBB3C \uC774\uB984\uC744 \uC0AC\uC6A9\uD569\uB2C8\uB2E4.",colors:"\uC0C9\uC0C1",colorsDesc:"\uBAB8 \uC0C9\uC0C1\uACFC \uAC15\uC870 \uC0C9\uC0C1\uC785\uB2C8\uB2E4. \uC724\uACFD\uC120, \uC74C\uC601, \uBC30 \uC0C9\uC0C1\uC740 \uBAB8 \uC0C9\uC0C1\uC5D0\uC11C \uB9CC\uB4E4\uC5B4\uC9D1\uB2C8\uB2E4.",colorsReset:"\uC774 \uB3D9\uBB3C\uC758 \uAE30\uBCF8 \uC0C9\uC0C1\uC73C\uB85C \uB418\uB3CC\uB9AC\uAE30",size:"\uD06C\uAE30",sizeSmall:"\uC791\uAC8C",sizeMedium:"\uBCF4\uD1B5",sizeLarge:"\uD06C\uAC8C",metric:"\uBA39\uC774",metricDesc:"\uD3AB\uC758 \uAE30\uBD84\uC774 \uB530\uB77C\uAC08 \uBCF4\uAD00\uD568 \uD65C\uB3D9\uC785\uB2C8\uB2E4.",metricModified:"\uD3B8\uC9D1\uD55C \uB178\uD2B8",metricCreated:"\uB9CC\uB4E0 \uB178\uD2B8",moods:"\uAE30\uBD84",moodsDesc:"\uAC01 \uAE30\uBD84\uC774 \uC2DC\uC791\uB418\uB294 \uAE30\uC900\uC785\uB2C8\uB2E4. \uC5B4\uB5A4 \uC124\uC815\uC73C\uB85C\uB3C4 \uD3AB\uC774 \uC544\uD504\uAC70\uB098 \uC0AC\uB77C\uC9C0\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uBCF4\uAD00\uD568\uC774 \uC870\uC6A9\uD558\uBA74 \uC7A0\uB4E4 \uBFD0\uC774\uBA70, \uBB34\uC5C7\uC774\uB4E0 \uC791\uC131\uD558\uBA74 \uACE7\uBC14\uB85C \uAE68\uC5B4\uB0A9\uB2C8\uB2E4.",moodsReset:"\uAE30\uBCF8 \uAE30\uBD84 \uC124\uC815\uC73C\uB85C \uB418\uB3CC\uB9AC\uAE30",excitedAt:"\uC2E0\uB098\uC11C \uB6F0\uC5B4\uB178\uB294 \uAE30\uC900",excitedAtDesc:"\uC624\uB298 \uB2E4\uB8EC \uB178\uD2B8 \uC218\uAC00 \uC774 \uAC12 \uC774\uC0C1\uC77C \uB54C\uC785\uB2C8\uB2E4.",happyAt:"\uD589\uBCF5\uD55C \uAE30\uC900",happyAtDesc:"\uC624\uB298 \uB2E4\uB8EC \uB178\uD2B8 \uC218\uC785\uB2C8\uB2E4 \u2014 \uC88B\uC740 \uD558\uB8E8\uC758 \uAE30\uC900\uC785\uB2C8\uB2E4.",contentAt:"\uB9CC\uC871\uD558\uB294 \uAE30\uC900",contentAtDesc:"\uC624\uB298 \uB2E4\uB8EC \uB178\uD2B8 \uC218\uC785\uB2C8\uB2E4. \uC774\uBCF4\uB2E4 \uC801\uC73C\uBA74 \uD3AB\uC774 \uC9C0\uB8E8\uD574\uD569\uB2C8\uB2E4.",sleepyAfter:"\uC7A0\uB4DC\uB294 \uC2DC\uAC04",sleepyAfterDesc:"\uBCF4\uAD00\uD568\uC5D0\uC11C \uC544\uBB34\uAC83\uB3C4 \uAC74\uB4DC\uB9AC\uC9C0 \uC54A\uC740 \uC2DC\uAC04(\uBD84)\uC785\uB2C8\uB2E4. \uAE30\uBD84\uC774\uB098 \uD558\uB8E8\uAC00 \uC5BC\uB9C8\uB098 \uC88B\uC558\uB294\uC9C0\uC640 \uAD00\uACC4\uC5C6\uC774 \uD3AB\uC774 \uC7A0\uB4E4\uBA70, \uD65C\uB3D9\uC774 \uC0DD\uAE30\uBA74 \uD558\uB8E8 \uC0C1\uD0DC \uADF8\uB300\uB85C \uB2E4\uC2DC \uAE68\uC5B4\uB0A9\uB2C8\uB2E4.",pettedFor:"\uC4F0\uB2E4\uB4EC\uAE30 \uC9C0\uC18D \uC2DC\uAC04",pettedForDesc:"\uD3AB\uC744 \uD074\uB9AD\uD55C \uB4A4 \uD589\uBCF5\uD55C \uC0C1\uD0DC\uAC00 \uBCF4\uC7A5\uB418\uB294 \uC2DC\uAC04(\uBD84)\uC785\uB2C8\uB2E4.",nightSleep:"\uBC24 \uC2DC\uAC04",nightSleepDesc:"\uC2DC\uACC4\uAC00 \uD3AB\uC5D0 \uC601\uD5A5\uC744 \uC904 \uC218 \uC788\uB294 \uBC94\uC704\uC785\uB2C8\uB2E4. \uC0C8\uBCBD\uC5D0 \uD65C\uB3D9\uC774 \uC801\uC740 \uAC83\uC740 \uC2DC\uAC04 \uB54C\uBB38\uC774\uC9C0 \uBC29\uCE58\uAC00 \uC544\uB2D9\uB2C8\uB2E4. \uC88B\uC740 \uD558\uB8E8\uB294 \uC5EC\uC804\uD788 \uC88B\uC740 \uD558\uB8E8\uB85C \uD45C\uC2DC\uB418\uBA70, \uC5EC\uAE30 \uC124\uC815\uACFC \uAD00\uACC4\uC5C6\uC774 \uC4F0\uB2E4\uB4EC\uC73C\uBA74 \uD3AB\uC774 \uAE68\uC5B4\uB0A9\uB2C8\uB2E4.",nightOff:"\uC5C6\uC74C \u2014 \uBCF4\uAD00\uD568 \uD65C\uB3D9\uB9CC \uBC18\uC601",nightQuiet:"\uC9C0\uB8E8\uD558\uAC70\uB098 \uB9CC\uC871\uD55C \uD3AB\uC740 \uB300\uC2E0 \uC7A0\uB4E6",nightAlways:"\uBC24\uC5D0\uB294 \uD56D\uC0C1 \uC7A0\uB4E6",nightWindow:"\uBC24 \uC2DC\uAC04 \uBC94\uC704",nightWindowDesc:"\uD604\uC9C0 \uC2DC\uAC04 \uAE30\uC900\uC785\uB2C8\uB2E4. \uC790\uC815\uC744 \uB118\uACA8\uB3C4 \uB429\uB2C8\uB2E4.",eyesFollow:"\uB208\uC774 \uD3EC\uC778\uD130\uB97C \uB530\uB77C\uAC10",eyesFollowDesc:"\uC7A0\uB4E0 \uD3AB\uC740 \uC774 \uC124\uC815\uACFC \uAD00\uACC4\uC5C6\uC774 \uB208\uC744 \uAC10\uACE0 \uC788\uC2B5\uB2C8\uB2E4.",eyesOff:"\uC0AC\uC6A9 \uC548 \uD568",eyesCard:"\uC790\uAE30 \uCE74\uB4DC \uC704\uC5D0\uC11C",eyesBoard:"\uB300\uC2DC\uBCF4\uB4DC \uC5B4\uB514\uC11C\uB098",showName:"\uC774\uB984 \uD4