index 25d1991a955fea58881a7f8c646472bd60b340bb..e530a63537980505d2702d605deb6310b7abb051 100644
--- a/80_script/register_custom_commands/13_commands.js
+++ b/80_script/register_custom_commands/13_commands.js
@@ -87,6 +87,26 @@ const runWithActiveFile = (action) => {
     action(activeFile);
 };
 
+// アクティブな Markdown のノートを、人間用HTMLとして temp/<ノート名>.html に保存する。
+// 設定モーダルも保存ダイアログも出さない（API など、人が操作しない実行のため）。見出し番号は付けない。
+// 同名のファイルがあれば上書きする（temp は作業用のフォルダ）。
+const exportHtmlHumanToTemp = async (file) => {
+    if (file.extension !== "md") {
+        new Notice("Markdown のノートだけ、HTMLで出力できます");
+        return null;
+    }
+    const tempDirPath = ensureTempDirExists();
+    if (!tempDirPath) {
+        new Notice("temp フォルダを作成できませんでした");
+        return null;
+    }
+    const path = require("path");
+    return exportHtml(file, "human", {
+        skipPromptSelection: true,
+        savePath: path.join(tempDirPath, file.basename + ".html"),
+    });
+};
+
 // 現在のノートのタグ（frontmatter とインライン）を、topを除いて重複なく集める
