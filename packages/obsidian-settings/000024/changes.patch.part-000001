+}
+
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-agenda-label {
+	font-weight: 650;
+}
+
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-agenda-events {
+	gap: 3px;
+	padding-bottom: 6px;
+}
+
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-agenda-event {
+	align-items: center;
+	gap: 8px;
+	margin: 0;
+	padding: 5px 10px;
+	border-radius: 6px;
+	background: var(--x-surface);
+	transition: background 120ms ease, border-radius 160ms ease;
+}
+
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-agenda-event:first-child {
+	border-top-left-radius: 16px;
+	border-top-right-radius: 16px;
+}
+
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-agenda-event:last-child {
+	border-bottom-left-radius: 16px;
+	border-bottom-right-radius: 16px;
+}
+
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-agenda-event:hover {
+	border-radius: 16px;
+	background: var(--x-surface-highest);
+}
+
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-agenda-evbullet {
+	width: 9px;
+	height: 9px;
+}
+
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-agenda-taskbullet {
+	border-radius: 3px;
+}
+
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-agenda-evtime {
+	color: var(--x-on-container);
+	font-weight: 650;
+}
+
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-agenda-evtitle {
+	font-weight: 550;
+}
+
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-agenda-evbadge {
+	padding: 1px 8px;
+	border-radius: 999px;
+	background: var(--x-surface-highest);
+	color: var(--x-on-container);
+	font-weight: 650;
+}
+
+:is(.hearth-card.is-expressive, .hearth-x-modal, .hearth-search-wrap.is-expressive) .hearth-agenda-evbadge.is-due {
+	background: var(--ev-color, var(--color-red));
