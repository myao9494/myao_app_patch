E44\uC6CC \uB450\uBA74 \uC124\uC815 \u2192 \uAC80\uC0C9\uC758 \uBB38\uAD6C\uB97C \uC0AC\uC6A9\uD569\uB2C8\uB2E4.",filters:"\uD544\uD130 \uD589",filtersDesc:"\uC785\uB825\uB780 \uC544\uB798\uC5D0 \uBA38\uB9AC\uAE00 \uAC80\uC0C9\uCC3D\uACFC \uAC19\uC740 \uD30C\uC77C \uC720\uD615 \uCE69\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4. \uCE69\uC744 \uD45C\uC2DC\uD558\uB824\uBA74 \uCE74\uB4DC \uB192\uC774\uAC00 \uB354 \uCEE4\uC57C \uD569\uB2C8\uB2E4.",filterTypes:"\uD544\uD130 \uCE69",filterTypesDesc:"\uC774 \uCE74\uB4DC\uC5D0 \uD45C\uC2DC\uD560 \uCE69\uC785\uB2C8\uB2E4. \uBCF4\uAD00\uD568\uC5D0 \uD574\uB2F9 \uC720\uD615\uC758 \uD30C\uC77C\uC774 \uC2E4\uC81C\uB85C \uC788\uC744 \uB54C\uB9CC \uCE69\uC774 \uB098\uD0C0\uB0A9\uB2C8\uB2E4.",filterTypeGlobalOff:"\uC124\uC815 \u2192 \uD544\uD130\uC5D0\uC11C \uBAA8\uB4E0 \uAC80\uC0C9\uCC3D\uC5D0 \uB300\uD574 \uC228\uACA8\uC838 \uC788\uC2B5\uB2C8\uB2E4.",instantAnswers:"\uC989\uC2DC \uB2F5\uBCC0",instantAnswersDesc:"\uC774 \uAC80\uC0C9\uCC3D\uC758 \uB2F5\uBCC0\uC744 \uB055\uB2C8\uB2E4. \uBCF4\uB4DC\uB098 \uBCF4\uAD00\uD568 \uC804\uCCB4\uC5D0\uC11C \uB048 \uB2F5\uBCC0\uC740 \uC5EC\uAE30\uC11C\uB3C4 \uAEBC\uC9C4 \uC0C1\uD0DC\uB85C \uC720\uC9C0\uB429\uB2C8\uB2E4.",instantAnswerOff:"\uC774 \uBCF4\uB4DC \uB610\uB294 \uBCF4\uAD00\uD568 \uC804\uCCB4\uC5D0\uC11C \uAEBC\uC838 \uC788\uC2B5\uB2C8\uB2E4.",instantAnswersVaultOff:"\uC124\uC815 \u2192 \uAC80\uC0C9\uC5D0\uC11C \uC989\uC2DC \uB2F5\uBCC0\uC774 \uBCF4\uAD00\uD568 \uC804\uCCB4\uC5D0 \uB300\uD574 \uAEBC\uC838 \uC788\uC2B5\uB2C8\uB2E4.",button:"\uBC84\uD2BC",buttonDesc:"\uC785\uB825\uB780 \uC606\uC758 \uB3D9\uC791 \uBC84\uD2BC\uC785\uB2C8\uB2E4. \uC0C8 \uB178\uD2B8\uB97C \uB9CC\uB4E4\uAC70\uB098 \uC785\uB825\uD55C \uB0B4\uC6A9\uC744 \uC6F9\uC5D0\uC11C \uAC80\uC0C9\uD569\uB2C8\uB2E4.",buttonNone:"\uC5C6\uC74C",buttonNewNote:"\uC0C8 \uB178\uD2B8",buttonSearchOnline:"\uC628\uB77C\uC778 \uAC80\uC0C9",seamless:"\uD14C\uB450\uB9AC \uC5C6\uC74C",seamlessDesc:"\uCE74\uB4DC \uD2C0(\uD14C\uB450\uB9AC, \uBC30\uACBD, \uC81C\uBAA9 \uD589)\uC744 \uC5C6\uC560 \uBCF4\uB4DC \uC704\uC5D0\uC11C \uB3C5\uB9BD\uB41C \uAC80\uC0C9\uCC3D\uCC98\uB7FC \uBCF4\uC774\uAC8C \uD569\uB2C8\uB2E4.",sizeNote:"\uC785\uB825\uB780\uC758 \uB450\uAED8\uB294 \uCE74\uB4DC \uB192\uC774\uC640 \uAC19\uC2B5\uB2C8\uB2E4. \uBC30\uCE58 \uBAA8\uB4DC\uC5D0\uC11C \uCE74\uB4DC \uAC00\uC7A5\uC790\uB9AC\uB97C \uB04C\uC5B4 \uAC80\uC0C9\uCC3D\uC744 \uB450\uAECD\uAC70\uB098 \uC587\uAC8C \uC870\uC808\uD558\uC138\uC694."},tiles:{...A.editors.tiles,heading:"\uBC84\uD2BC",sizing:"\uBC84\uD2BC \uD06C\uAE30 \uBC29\uC2DD",sizingDesc:"\uBC84\uD2BC\uC774 \uCE74\uB4DC\uB97C \uCC44\uC6B8\uC9C0(\uCE74\uB4DC \uD06C\uAE30\uC640 \uAD00\uACC4\uC5C6\uC774 \uBAA8\uB4E0 \uBC84\uD2BC\uC774 \uBCF4\uC774\uBA70 \uCE74\uB4DC\uC5D0 \uB9DE\uCDB0 \uCEE4\uC9C0\uACE0 \uC791\uC544\uC9D0), \uC544\uB2C8\uBA74 \uACE0\uC815 \uD53D\uC140 \uD06C\uAE30\uB97C \uC720\uC9C0\uD574 \uCE74\uB4DC\uAC00 \uC791\uC73C\uBA74 \uC2A4\uD06C\uB864\uD560\uC9C0 \uC815\uD569\uB2C8\uB2E4. \uCC44\uC6B0\uAE30 \uBC29\uC2DD\uC758 \uBC84\uD2BC\uC740 \uB108\uBB34 \uC791\uC544\uC838 \uC4F0\uAE30 \uC5B4\uB824\uC6CC\uC9C0\uAE30 \uC804\uC5D0 \uB354 \uC904\uC5B4\uB4E4\uC9C0 \uC54A\uC73C\uBA70, \uADF8 \uD06C\uAE30\uB85C\uB3C4 \uB2E4 \uB4E4\uC5B4\uAC00\uC9C0 \uC54A\uC73C\uBA74 \uCE74\uB4DC\uAC00 \uC2A4\uD06C\uB864\uB429\uB2C8\uB2E4. \uC774 \uC124\uC815\uC774 \uC0DD\uAE30\uAE30 \uC804\uC5D0 \uB9CC\uB4E0 \uCE74\uB4DC\uB294 \uC9C1\uC811 \uBC14\uAFB8\uAE30 \uC804\uAE4C\uC9C0 \uACE0\uC815 \uBC29\uC2DD\uC744 \uC720\uC9C0\uD569\uB2C8\uB2E4. \uBC29\uC2DD\uB9C8\uB2E4 \uD06C\uAE30\uB97C \uB530\uB85C \uAE30\uC5B5\uD558\uBBC0\uB85C \uB2E4\uC2DC \uC804\uD658\uD558\uBA74 \uC774\uC804 \uD06C\uAE30\uAC00 \uBCF5\uC6D0\uB429\uB2C8\uB2E4.",sizingScale:"\uCE74\uB4DC \uCC44\uC6B0\uAE30",sizingFixed:"\uACE0\uC815 \uD06C\uAE30 (\uAE30\uC874 \uBC29\uC2DD)",across:"\uAC00\uB85C \uBC84\uD2BC \uC218",acrossDesc:"\uCE74\uB4DC \uAC00\uB85C\uC5D0 \uB4E4\uC5B4\uAC08 \uBC84\uD2BC \uC218\uC774\uBA70, \uC774\uC5D0 \uB530\uB77C \uBC84\uD2BC \uD558\uB098\uC758 \uB108\uBE44(\uCE74\uB4DC\uC758 \uC77C\uC815 \uBE44\uC728, \uCD5C\uC18C \uD06C\uAE30\uAE4C\uC9C0)\uAC00 \uC815\uD574\uC9D1\uB2C8\uB2E4. \uB192\uC774\uB3C4 \uAC19\uC740 \uBC29\uC2DD\uC73C\uB85C \uAC01 \uD589\uC774 \uCE74\uB4DC \uB192\uC774\uB97C \uB098\uB220 \uAC00\uC9C0\uBBC0\uB85C, \uCE74\uB4DC\uAC00 \uB0AE\uC544\uC9C0\uBA74 \uBC84\uD2BC\uC774 \uC228\uACA8\uC9C0\uB294 \uB300\uC2E0 \uB0AE\uC544\uC9D1\uB2C8\uB2E4. \uBC30\uCE58 \uBAA8\uB4DC\uC5D0\uC11C \uBC84\uD2BC\uC758 \uC624\uB978\uCABD \uC544\uB798 \uBAA8\uC11C\uB9AC\uB97C \uB04C\uC5B4 \uB450\uC138 \uCE78 \uB108\uBE44(\uB610\uB294 \uB192\uC774)\uB85C \uB9CC\uB4E4 \uC218 \uC788\uC73C\uBA70, \uACA9\uC790\uAC00 \uC591\uBC29\uD5A5\uC73C\uB85C \uBC18 \uCE78 \uB2E8\uC704\uB97C \uC9C0\uC6D0\uD558\uBBC0\uB85C \uBC18 \uCE78 \uD06C\uAE30\uB3C4 \uAC00\uB2A5\uD569\uB2C8\uB2E4.",minSize:"\uCD5C\uC18C \uBC84\uD2BC \uD06C\uAE30",minSizeDesc:"\uBC84\uD2BC \uD558\uB098\uAC00 \uC904\uC5B4\uB4E4 \uC218 \uC788\uB294 \uCD5C\uC18C \uD06C\uAE30(\uD53D\uC140)\uC785\uB2C8\uB2E4. \uC774\uBCF4\uB2E4 \uC791\uC544\uC838\uC57C \uD558\uBA74 \uCE74\uB4DC\uAC00 \uC2A4\uD06C\uB864\uB429\uB2C8\uB2E4. \uBC18 \uCE78 \uBC84\uD2BC\uC740 \uC774 \uAC12\uC758 \uC808\uBC18\uC5D0\uC11C \uBA48\uCDA5\uB2C8\uB2E4. \uC2A4\uD06C\uB864 \uB9C9\uB300\uBCF4\uB2E4 \uBC84\uD2BC\uC774 \uB9DE\uCDB0\uC9C0\uB3C4\uB85D \uAE30\uBCF8\uAC12\uC740 \uB0AE\uAC8C \uC124\uC815\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4. \uC790\uC8FC \uC791\uAC8C \uC4F0\uB294 \uCE74\uB4DC\uC5D0\uC11C \uBC84\uD2BC\uC744 \uB109\uB109\uD558\uAC8C \uC720\uC9C0\uD558\uB824\uBA74 \uAC12\uC744 \uC62C\uB9AC\uC138\uC694. \uBC84\uD2BC\uC774 \uB354 \uC774\uC0C1 \uB4E4\uC5B4\uAC00\uC9C0 \uC54A\uC73C\uBA74 \uCE74\uB4DC\uAC00 \uC2A4\uD06C\uB864\uB429\uB2C8\uB2E4."},calendar:{...A.editors.calendar,view:"\uB808\uC774\uC544\uC6C3",viewDesc:"\uC6D4\uAC04 \uBCF4\uAE30\uB294 \uACA9\uC790\uB85C, \uC77C\uC815 \uBCF4\uAE30\uB294 \uB2E4\uAC00\uC624\uB294 \uB0A0\uC9DC \uBAA9\uB85D\uC73C\uB85C \uD45C\uC2DC\uD569\uB2C8\uB2E4.",viewMonth:"\uC6D4\uAC04 \uACA9\uC790",viewAgenda:"\uC77C\uC815 \uBAA9\uB85D",agendaDays:"\uC55E\uC73C\uB85C \uD45C\uC2DC\uD560 \uB0A0\uC9DC",agendaDaysDesc:"\uC624\uB298\uBD80\uD130 \uC77C\uC815 \uBAA9\uB85D\uC5D0 \uD45C\uC2DC\uD560 \uB0A0\uC9DC \uC218\uC785\uB2C8\uB2E4.",weekNumbers:"\uC8FC \uBC88\uD638",weekNumbersDesc:"\uC67C\uCABD\uC5D0 ISO \uC8FC \uBC88\uD638 \uC5F4\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4.",heatmap:"\uD788\uD2B8\uB9F5",heatmapDesc:"\uAC01 \uB0A0\uC9DC\uC758 \uB178\uD2B8 \uD65C\uB3D9\uB7C9\uC5D0 \uB530\uB77C \uBC30\uACBD\uC0C9\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4.",heatmapCounts:"\uD788\uD2B8\uB9F5 \uAC1C\uC218",externalCalendars:"\uC678\uBD80 \uCE98\uB9B0\uB354",externalCalendarsDesc:"ICS/iCal \uD53C\uB4DC(Google, iCloud, Fastmail, Nextcloud \uB4F1)\uB97C \uAD6C\uB3C5\uD569\uB2C8\uB2E4. \uC774\uBCA4\uD2B8\uB294 \uACA9\uC790\uC5D0 \uC0C9 \uC810\uC73C\uB85C \uD45C\uC2DC\uB418\uACE0 \uC77C\uC815 \uBAA9\uB85D\uC5D0 \uB098\uC635\uB2C8\uB2E4.",operonTasks:"Operon \uC791\uC5C5 \uD45C\uC2DC",operonTasksDesc:"Operon \uC791\uC5C5\uC758 \uB9C8\uAC10\uC77C\uC744 \uD45C\uC2DC\uD558\uACE0 \uC77C\uC815 \uBAA9\uB85D\uC5D0 \uC791\uC5C5\uC744 \uB098\uC5F4\uD569\uB2C8\uB2E4. Operon \uAC1C\uBC1C\uC790 API\uB97C \uC0AC\uC6A9\uD558\uBBC0\uB85C \uC124\uC815 \u2192 Hearth \u2192 \uC5F0\uB3D9\uC5D0\uC11C Operon \uC0AC\uC6A9\uC744 \uC2B9\uC778\uD574\uC57C \uD569\uB2C8\uB2E4. \uB9C8\uAC10\uC77C \uC5C6\uC774 \uC608\uC815\uB9CC \uB41C \uC791\uC5C5\uC740 \uD3EC\uD568\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.",operonTaskColor:"Operon \uC791\uC5C5 \uC0C9\uC0C1",operonTaskColorDesc:"\uC791\uC5C5 \uD45C\uC2DC\uC5D0 \uC0AC\uC6A9\uD560 \uC0C9\uC0C1\uC785\uB2C8\uB2E4. \uAE30\uBCF8\uAC12\uC740 \uAC15\uC870 \uC0C9\uC0C1\uC785\uB2C8\uB2E4.",sourceNamePlaceholder:"\uC774\uB984",sourceUrlPlaceholder:"ICS/iCal URL (https:// \uB610\uB294 webcal://)",sourceShow:"\uC774 \uCE98\uB9B0\uB354 \uD45C\uC2DC",sourceHide:"\uC774 \uCE98\uB9B0\uB354 \uC228\uAE30\uAE30",sourceRemove:"\uCE98\uB9B0\uB354 \uC81C\uAC70",addCalendar:"\uCE98\uB9B0\uB354 \uCD94\uAC00",refresh:"\uC0C8\uB85C \uACE0\uCE68 \uAC04\uACA9",refreshDesc:"\uCE98\uB9B0\uB354\uB97C \uB2E4\uC2DC \uAC00\uC838\uC62C \uAC04\uACA9(\uBD84)\uC785\uB2C8\uB2E4. 0\uC774\uBA74 \uC5F4 \uB54C\uB9CC \uAC00\uC838\uC635\uB2C8\uB2E4.",eventNoteHeading:"\uC774\uBCA4\uD2B8 \uB178\uD2B8",eventNoteDesc:"\uC774\uBCA4\uD2B8 \uD31D\uC5C5\uC5D0\uC11C \u2018\uB178\uD2B8 \uB9CC\uB4E4\uAE30\u2019\uB97C \uB20C\uB800\uC744 \uB54C \uC0DD\uC131\uD560 \uB178\uD2B8\uC785\uB2C8\uB2E4. Obsidian Web Clipper \uD15C\uD50C\uB9BF\uCC98\uB7FC \uC774\uB984, \uD3F4\uB354, \uC720\uD615\uC774 \uC9C0\uC815\uB41C \uC18D\uC131, \uBCF8\uBB38\uC5D0 {{\uBCC0\uC218}}\uC640 \uD544\uD130\uB97C \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.",eventNoteEnabled:"\u2018\uB178\uD2B8 \uB9CC\uB4E4\uAE30\u2019 \uD45C\uC2DC",eventNoteEnabledDesc:"\uC774\uBCA4\uD2B8 \uC0C1\uC138 \uD31D\uC5C5\uC5D0 \uB178\uD2B8 \uB9CC\uB4E4\uAE30 \uBC84\uD2BC\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4.",chipsHeading:"\uC77C\uC815 \uD56D\uBAA9 \uC138\uBD80 \uC815\uBCF4",chipsDesc:"\uAC01 \uC77C\uC815 \uD56D\uBAA9\uC758 \uC81C\uBAA9 \uC606\uC5D0 \uD45C\uC2DC\uD560 \uC815\uBCF4\uB97C \uC120\uD0DD\uD569\uB2C8\uB2E4. \uC881\uC740 \uCE74\uB4DC\uC5D0\uC11C\uB294 \uD45C\uC2DC \uD56D\uBAA9\uC774 \uC81C\uBAA9 \uACF5\uAC04\uC744 \uCC28\uC9C0\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.",chipTime:"\uC2DC\uAC04",chipTimeDesc:"\uC2DC\uC791 \uC2DC\uAC04 \uB610\uB294 \u2018\uC885\uC77C\u2019\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4.",chipSource:"\uCE98\uB9B0\uB354 \uC774\uB984",chipSourceDesc:"\uD56D\uBAA9\uC774 \uC5B4\uB290 \uCE98\uB9B0\uB354\uC5D0\uC11C \uC654\uB294\uC9C0 \uD45C\uC2DC\uD569\uB2C8\uB2E4. \uCE98\uB9B0\uB354\uB97C \uB450 \uAC1C \uC774\uC0C1 \uAD6C\uB3C5\uD55C \uACBD\uC6B0\uC5D0\uB9CC \uBCF4\uC785\uB2C8\uB2E4.",chipStatus:"\uC0C1\uD0DC",chipStatusDesc:"TaskNotes \uC791\uC5C5 \uC0C1\uD0DC(\uC608: \u2018\uC9C4\uD589 \uC911\u2019)\uB97C \uD45C\uC2DC\uD569\uB2C