5D0 \uB098\uD0C0\uB0A9\uB2C8\uB2E4."},jira:{...A.settings.integrations.items.jira,name:"Jira",desc:"Jira \uCE74\uB4DC\uB294 \uCE74\uB4DC\uC5D0 \uC785\uB825\uD55C \uC778\uC99D \uC815\uBCF4\uB85C Jira Cloud \uB610\uB294 Server \uC778\uC2A4\uD134\uC2A4\uC758 REST API\uC5D0\uC11C \uC774\uC288\uB97C \uAC00\uC838\uC635\uB2C8\uB2E4."},rss:{...A.settings.integrations.items.rss,name:"RSS \uBC0F Atom \uD53C\uB4DC",desc:"RSS \uCE74\uB4DC\uB294 \uC9C0\uC815\uD55C RSS 2.0 \uB610\uB294 Atom \uD53C\uB4DC\uB97C \uAC00\uC838\uC640 \uD574\uC11D\uD569\uB2C8\uB2E4."},ics:{...A.settings.integrations.items.ics,name:"iCalendar \uD53C\uB4DC",desc:"\uBBF8\uB2C8 \uB2EC\uB825 \uCE74\uB4DC\uC5D0\uC11C Google, iCloud, Fastmail, Nextcloud \uB4F1\uC758 \uC678\uBD80 ICS/webcal \uCE98\uB9B0\uB354\uB97C \uAD6C\uB3C5\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."},currency:{...A.settings.integrations.items.currency,name:"\uD658\uC728",desc:"\uACC4\uC0B0\uAE30 \uCE74\uB4DC\uB294 \uD0A4\uAC00 \uD544\uC694 \uC5C6\uB294 \uBB34\uB8CC Frankfurter API\uC758 ECB \uD658\uC728\uB85C \uD1B5\uD654\uB97C \uBCC0\uD658\uD569\uB2C8\uB2E4."},markets:{...A.settings.integrations.items.markets,name:"\uC2DC\uC7A5 \uC2DC\uC138",desc:"\uC2DC\uC7A5 \uCE74\uB4DC\uB294 \uD0A4\uAC00 \uD544\uC694 \uC5C6\uB294 \uBB34\uB8CC \uC18C\uC2A4\uC5D0\uC11C \uC2DC\uC138\uB97C \uC77D\uC2B5\uB2C8\uB2E4. \uC804 \uC138\uACC4 \uB300\uBD80\uBD84\uC758 \uAC70\uB798\uC18C, \uC678\uD658, \uAC00\uC0C1\uC790\uC0B0\uC740 Yahoo Finance, \uC0C1\uD558\uC774\xB7\uC120\uC804\xB7\uBCA0\uC774\uC9D5\xB7\uD64D\uCF69 \uC0C1\uC7A5 \uC885\uBAA9\uC740 Tencent, \uC911\uAD6D \uC7A5\uC678 \uD380\uB4DC\uB294 Eastmoney, \uCF54\uC778\uC740 CoinGecko, \uD1B5\uD654 \uC30D\uC740 Frankfurter\uB97C \uD1B5\uD55C ECB\uB97C \uC0AC\uC6A9\uD569\uB2C8\uB2E4. \uBAA8\uB450 \uACF5\uC2DD API\uAC00 \uC544\uB2C8\uBBC0\uB85C \uD55C \uC18C\uC2A4\uAC00 \uC2E4\uD328\uD558\uBA74 \uB2E4\uB978 \uC18C\uC2A4\uB85C \uB300\uCCB4\uD569\uB2C8\uB2E4. \uCE74\uB4DC\uC5D0 \uC788\uB294 \uC885\uBAA9 \uAE30\uD638\uB9CC \uC804\uC1A1\uD569\uB2C8\uB2E4."},weather:{...A.settings.integrations.items.weather,name:"\uC77C\uAE30 \uC608\uBCF4",desc:"\uB0A0\uC528 \uCE74\uB4DC\uC640 \uC2E4\uC2DC\uAC04 \uD558\uB298 \uBC30\uACBD\uC740 Open-Meteo\uC5D0\uC11C \uB0A0\uC528\uB97C \uAC00\uC838\uC635\uB2C8\uB2E4. \uBB34\uB8CC\uC774\uBA70 \uD0A4\uB098 \uACC4\uC815\uC774 \uD544\uC694 \uC5C6\uC2B5\uB2C8\uB2E4. \uC120\uD0DD\uD55C \uC88C\uD45C\uB9CC \uC804\uC1A1\uD558\uBA70, \uD55C \uAC00\uC9C0 \uB0A0\uC528\uB85C \uACE0\uC815\uD55C \uD558\uB298\uC740 \uC704\uCE58\uAC00 \uC804\uD600 \uD544\uC694 \uC5C6\uC2B5\uB2C8\uB2E4."},tension:{...A.settings.integrations.items.tension,name:"\uC138\uACC4 \uAE34\uC7A5\uB3C4",desc:"\uC138\uACC4 \uAE34\uC7A5\uB3C4 \uCE74\uB4DC\uB294 kite.kagi.com\uC5D0\uC11C Kagi News\uC758 World Tension \uC9C0\uC218\uB97C \uC77D\uC2B5\uB2C8\uB2E4. \uADF8\uB0A0\uC758 \uC138\uACC4 \uB274\uC2A4\uB97C \uC5B8\uC5B4 \uBAA8\uB378\uC774 0\u2013100\uC73C\uB85C \uD3C9\uAC00\uD55C \uAC12\uC785\uB2C8\uB2E4. \uBB34\uB8CC\uC774\uBA70 \uD0A4\uB098 \uACC4\uC815\uC774 \uD544\uC694 \uC5C6\uACE0, \uC0AC\uC6A9\uC790\uB098 \uBCF4\uAD00\uD568\uC5D0 \uAD00\uD55C \uC815\uBCF4\uB294 \uC804\uC1A1\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."},webSearch:{...A.settings.integrations.items.webSearch,name:"\uC628\uB77C\uC778 \uAC80\uC0C9",desc:"\uAC80\uC0C9\uCC3D \uBC84\uD2BC\uC73C\uB85C \uB178\uD2B8\uB97C \uB9CC\uB4DC\uB294 \uB300\uC2E0 \uCFFC\uB9AC\uB97C DuckDuckGo\uB85C \uBCF4\uB0BC \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uAC80\uC0C9 \u2192 \uAC80\uC0C9\uCC3D\uC5D0\uC11C \uC804\uD658\uD558\uC138\uC694."}}},tasks:{...A.settings.tasks,heading:"\uC791\uC5C5 / TaskNotes",headingDesc:"TaskNotes \uBAA8\uB4DC\uC758 \uC791\uC5C5 \uCE74\uB4DC\uC5D0\uC11C \uC77D\uB294 \uD544\uB4DC \uC774\uB984\uC785\uB2C8\uB2E4. TaskNotes \uC790\uCCB4 \uC124\uC815\uC758 frontmatter \uD544\uB4DC\uC640 \uC77C\uCE58\uC2DC\uCF1C\uC57C \uD569\uB2C8\uB2E4.",statusField:"\uC0C1\uD0DC \uD544\uB4DC",statusFieldDesc:"\uC791\uC5C5 \uC0C1\uD0DC\uB97C \uC77D\uC744 frontmatter \uD544\uB4DC\uC785\uB2C8\uB2E4.",dueField:"\uB9C8\uAC10\uC77C \uD544\uB4DC",dueFieldDesc:"\uC791\uC5C5 \uB9C8\uAC10\uC77C\uC744 \uC77D\uC744 frontmatter \uD544\uB4DC\uC785\uB2C8\uB2E4.",priorityField:"\uC6B0\uC120\uC21C\uC704 \uD544\uB4DC",priorityFieldDesc:"\uC791\uC5C5 \uC6B0\uC120\uC21C\uC704\uB97C \uC77D\uC744 frontmatter \uD544\uB4DC\uC785\uB2C8\uB2E4.",doneValue:"\u2018\uC644\uB8CC\u2019 \uC0C1\uD0DC \uAC12",doneValueDesc:"TaskNotes \uC791\uC5C5\uC744 \uC644\uB8CC\uB85C \uD45C\uC2DC\uD558\uB294 \uC0C1\uD0DC \uAC12\uC785\uB2C8\uB2E4.",fieldsEnable:"\uC791\uC5C5 \uD544\uB4DC \uC0AC\uC6A9\uC790 \uC9C0\uC815",fieldsEnableDesc:"\uD45C\uC2DC\uD560 frontmatter \uC18D\uC131\uC744 \uC9C1\uC811 \uC120\uD0DD\uD558\uACE0 \uC774\uB984, \uC0C9\uC0C1, \uC21C\uC11C\uB97C \uC124\uC815\uD569\uB2C8\uB2E4. \uCF1C\uBA74 \uC791\uC5C5\uC5D0\uB294 \uCD94\uAC00\uD55C \uD544\uB4DC\uB9CC \uD45C\uC2DC\uB429\uB2C8\uB2E4.",fields:"\uC791\uC5C5\uC5D0 \uD45C\uC2DC\uD560 \uD544\uB4DC",fieldsDesc:"\uBAA8\uB4E0 \uC791\uC5C5 \uCE74\uB4DC\uC5D0 \uD45C\uC2DC\uD560 \uD544\uB4DC\uC785\uB2C8\uB2E4. \uCE74\uB4DC\uBCC4 \uC124\uC815\uC5D0\uC11C \uB530\uB85C \uC9C0\uC815\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."},fileIcons:{...A.settings.fileIcons,heading:"\uD30C\uC77C \uC544\uC774\uCF58 / Iconic / Iconize",headingDesc:"Iconic \uB610\uB294 Iconize\uC5D0\uC11C \uC124\uC815\uD55C \uD30C\uC77C\uBCC4 \uC544\uC774\uCF58\uC744 \uCD5C\uADFC \uD56D\uBAA9, \uC990\uACA8\uCC3E\uAE30, \uAC80\uC0C9 \uACB0\uACFC \uB4F1 Hearth\uC758 \uD30C\uC77C \uBAA9\uB85D\uC5D0 \uC0AC\uC6A9\uD569\uB2C8\uB2E4.",enable:"Iconic / Iconize \uC544\uC774\uCF58 \uC0AC\uC6A9",enableDesc:"\uB044\uBA74 \uB450 \uD50C\uB7EC\uADF8\uC778\uACFC \uAD00\uACC4\uC5C6\uC774 Hearth\uC758 \uD30C\uC77C \uC720\uD615 \uC544\uC774\uCF58\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4.",enableDescNoPlugin:"Iconic\uACFC Iconize\uAC00 \uBAA8\uB450 \uBE44\uD65C\uC131\uD654\uB418\uC5B4 \uC788\uC5B4 \uC544\uB798 frontmatter \uC635\uC158\uC774 \uAEBC\uC838 \uC788\uC73C\uBA74 Hearth\uC758 \uD30C\uC77C \uC720\uD615 \uC544\uC774\uCF58\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4. \uC774 \uC124\uC815\uC740 \uCF1C \uB46C\uB3C4 \uD50C\uB7EC\uADF8\uC778\uC744 \uC124\uCE58\uD558\uBA74 \uC801\uC6A9\uB429\uB2C8\uB2E4.",property:"Iconize frontmatter \uC18D\uC131",propertyDesc:"\uBA54\uB274 \uB300\uC2E0 frontmatter\uB85C \uC124\uC815\uD55C \uC544\uC774\uCF58\uC5D0 \uC0AC\uC6A9\uD560 \uC18D\uC131\uC785\uB2C8\uB2E4. \uC27C\uD45C\uB85C \uAD6C\uBD84\uD574 \uC5EC\uB7EC \uC18D\uC131\uC744 \uC9C0\uC815\uD560 \uC218 \uC788\uC5B4 \uB2E4\uB978 \uD50C\uB7EC\uADF8\uC778\uC774 \uC4F0\uB294 \uC18D\uC131\uC744 \uB367\uBD99\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4. Iconize\uC758 \uC18D\uC131 \uC774\uB984\uACFC \uC77C\uCE58\uC2DC\uD0A4\uC138\uC694. \uAE30\uBCF8\uAC12\uC740 icon\uC785\uB2C8\uB2E4.",frontmatterWithoutPlugin:"\uC544\uC774\uCF58 \uD50C\uB7EC\uADF8\uC778 \uC5C6\uC774 frontmatter \uC544\uC774\uCF58 \uC77D\uAE30",frontmatterWithoutPluginDesc:"Iconic\uC774\uB098 Iconize\uAC00 \uC5C6\uC5B4\uB3C4 \uB178\uD2B8\uC758 frontmatter\uC5D0 \uC801\uD78C \uC544\uC774\uCF58\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4. \uB2E4\uB978 \uD50C\uB7EC\uADF8\uC778(Notebook Navigator, Pretty Properties, AutoIcon)\uC774\uB098 \uC9C1\uC811 \uC801\uC740 \uC544\uC774\uCF58\uC5D0 \uC720\uC6A9\uD569\uB2C8\uB2E4. \uAE30\uBCF8\uAC12\uC740 \uAEBC\uC9D0\uC785\uB2C8\uB2E4. icon\uC740 \uD754\uD55C \uC18D\uC131 \uC774\uB984\uC774\uB77C \uB2E4\uB978 \uC6A9\uB3C4\uB85C \uC4F0\uB294 \uBCF4\uAD00\uC18C\uC5D0\uC11C\uB294 \uADF8 \uAC12\uC774 \uC544\uC774\uCF58\uC73C\uB85C \uD45C\uC2DC\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4. Obsidian\uC774 \uC544\uB294 \uC544\uC774\uCF58 ID\uC640 \uC774\uBAA8\uC9C0\uB9CC \uD45C\uC2DC\uD558\uBA70, \uADF8 \uBC16\uC758 \uAC12\uC740 Hearth\uC758 \uD30C\uC77C \uC720\uD615 \uC544\uC774\uCF58\uC744 \uC720\uC9C0\uD569\uB2C8\uB2E4."},frontMatterTitle:{...A.settings.frontMatterTitle,heading:"Front Matter Title",headingDesc:"Front Matter Title \uD50C\uB7EC\uADF8\uC778\uC774 \uC81C\uBAA9\uC744 \uC81C\uACF5\uD55C \uB178\uD2B8\uB97C \uD30C\uC77C \uC774\uB984 \uB300\uC2E0 \uD574\uB2F9 \uC81C\uBAA9\uC73C\uB85C \uD45C\uC2DC\uD569\uB2C8\uB2E4.",enable:"Front Matter Title \uC81C\uBAA9 \uC0AC\uC6A9",enableDesc:"\uB044\uBA74 \uD50C\uB7EC\uADF8\uC778\uC744 \uBB34\uC2DC\uD558\uACE0 \uD30C\uC77C \uC774\uB984\uC73C\uB85C \uB178\uD2B8\uB97C \uD45C\uC2DC\uD569\uB2C8\uB2E4.",enableDescNoPlugin:"Front Matter Title\uC774 \uBE44\uD65C\uC131\uD654\uB418\uC5B4 \uD30C\uC77C \uC774\uB984\uC73C\uB85C \uB178\uD2B8\uB97C \uD45C\uC2DC\uD569\uB2C8\uB2E4. \uD50C\uB7EC\uADF8\uC778\uC744 \uC124\uCE58\uD558\uBA74 \uC774 \uC124\uC815\uC774 \uC801\uC6A9\uB429\uB2C8\uB2E4."},operon:{...A.settings.operon,heading:"Operon",headingDesc:"Operon \uAC1C\uBC1C\uC790 API\uB85C \uC791\uC5C5, \uBCF4\uB4DC, \uC77C\uC815, \uC2E4\uD589 \uC911\uC778 \uD0C0\uC774\uBA38\uB97C \uC77D\uC2B5\uB2C8\uB2E4. \uB370\uC774\uD130\uC758 \uC6D0\uBCF8\uC740 Operon\uC774\uBA70 Hearth\uB294 \uACB0\uACFC\uB9CC \uD45C\uC2DC\uD569\uB2C8\uB2E4.",enable:"Operon \uC5F0\uACB0",enableDesc:"\uB044\uBA74 Operon \uCE74\uB4DC\uAC00 \uB370\uC774\uD130\uB97C \uC77D\uC9C0 \uC54A\uC73C\uBA70 Hearth\uB294 \uC811\uADFC\uC744 \uC694\uCCAD\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uB300\uC2DC\uBCF4\uB4DC\uC5D0 Operon \uCE74\uB4DC\uAC00 \uC788\uC744 \uB54C\uB9CC \uC811\uADFC\uC744 \uC694\uCCAD\uD569\uB2C8\uB2E4.",status:"\uC5F0\uACB0 \uC0C1\uD0DC",statusAbsent:"Operon\uC774 \uC124\uCE58\uB418\uC5B4 \uC788\uAC70\uB098 \uD65C\uC131\uD654\uB418\uC5B4 \uC788\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.",statusUnsupported:"Operon \uAC1C\uBC1C\uC790 API\uB294 \uB370\uC2A4\uD06C\uD1B1 \uC804\uC6A9\uC774\uBA70 Obsidian 1.12.2 \uC774\uC0C1\uC774 \uD544\uC694\uD569\uB2C8\uB2E4.",statusBooting:"Operon\uC774 \uC2E4\uD589 \uC911\uC774\uBA70 \uC2DC\uC791\uD558\uB294 \uC911\uC785\uB2C8\uB2E4.",statusPending:"\uC2B9\uC778\uC744 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uC124\uC815 \u2192 Operon \u2192 Core \u2192 General \u2192 Developer API Integrations\uC5D0\uC11C Hearth\uB97C \uC2B9\uC778\uD558\uC138\uC694.",statusSuspended:"\uC811\uADFC\uC774 \uC77C\uC2DC \uC911\uC9C0\uB418\uC5C8\uC2B5\uB2C8\uB2E4. Operon\uC758 Developer API Integrations\uC5D0\uC11C Hearth\uC758 \uB300\uAE30 \uC911\uC778 \uAD8C\uD55C\uC744 \uD655\uC778\uD558\uC138\uC694.",statusRevoked:"\uC811\uADFC \uAD8C\uD55C\uC774 \uCDE8\uC18C\uB418\uC5C8\uC2B5\uB2C8\uB2E4. Operon\uC758 Developer API Integrations\uC5D0\uC11C \uB2E4\uC2DC \uD5C8\uC6A9\uD558\uC138\uC694.",statusReady:"\uC5F0\uACB0\uB428 \u2014 Operon \uCE74\uB4DC\uC5D0\uC11C \uC791\uC5C5\uC744 \uC77D\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.",statusIdle:"\uC544\uC9C1 \uC5F0\uACB0\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4. Operon \uCE74\uB4DC\uB97C \uCD94\uAC00\uD558\uBA74 \uC5F0\uACB0\uC744 \uC2DC\uC791\uD569\uB2C8\uB2E4.",statusOff:"\uC5F0\uB3D9\uC774 \uAEBC\uC838 \uC788\uC5B4 Hearth\uAC00 Operon\uC5D0\uC11C \uB370\uC774\uD130\uB97C \uC77D\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.",statusError:"Operon\uC5D0\uC11C \uC5F0\uACB0\uC744 \uAC70\uBD80\uD588\uC2B5\uB2C8\uB2E4.",detail:"Operon \uC751\uB2F5",install:"\uCEE4\uBBA4\uB2C8\uD2F0 \uD50C\uB7EC\uADF8\uC778\uC5D0\uC11C Operon \uC5F4\uAE30",writes:"\uBCC0\uACBD \uD5C8\uC6A9",writesDesc:"\uBCF4\uB4DC \uCE74\uB4DC\uC5D0\uC11C \uC791\uC5C5\uC744 \uB2E4\uB978 \uC0C1\uD0DC\uB85C \uC62E\uAE30\uACE0 \uC0C8 \uC791\uC5C5\uC744 \uB9CC\uB4E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uBCC0\uACBD \uD5C8\uC6A9 \uC2DC Operon\uC758 Developer API Integrations\uC5D0\uC11C \uB2E4\uC2DC \uC2B9\uC778\uD574\uC57C \uD569\uB2C8\uB2E4. \uB044\uBA74 \uC77D\uAE30 \uC804\uC6A9\uC785\uB2C8\uB2E4.",writesPending:"\uC77D\uAE30\uB294 \uAC00\uB2A5\uD558\uC9C0\uB9CC \uBCC0\uACBD \uAD8C\uD55C\uC740 \uC544\uC9C1 \uC5C6\uC2B5\uB2C8\uB2E4. Operon\uC758 Developer API Integrations\uC5D0\uC11C Hearth\uB97C \uB2E4\uC2DC \uC2B9\uC778\uD558\uC138\uC694.",capabilities:"\uC694\uCCAD \uAD8C\uD55C",capabilitiesDesc:"Operon\uC740 \uC77C\uBD80 \uAD8C\uD55C\uB9CC \uC2B9\uC778\uD558\uB294 \uC5F0\uACB0\uC744 \