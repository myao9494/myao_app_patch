+function buildFileManagerWebUrl(folderFullPath) {
+  return `http://localhost:8001/?path=${encodeURIComponent(folderFullPath)}`;
+}
+async function openInVsCode(targetPath, customExecutable) {
+  const fs = require("fs");
+  const os = require("os");
+  const path = require("path");
+  const { execFile } = require("child_process");
+  const run = (command, args) => new Promise((resolve) => {
+    execFile(command, args, (error) => resolve(!error));
+  });
+  const platform = os.platform();
+  let opened = false;
+  const vscodeExecutable = customExecutable == null ? void 0 : customExecutable.trim();
+  if (vscodeExecutable && fs.existsSync(vscodeExecutable)) {
+    opened = await run(vscodeExecutable, [targetPath]);
+    if (opened)
+      return true;
+  }
+  if (platform === "darwin") {
+    opened = await run("open", ["-a", "Visual Studio Code", targetPath]);
+    if (!opened) {
+      opened = await run("code", [targetPath]);
+    }
+  } else if (platform === "win32") {
+    const env = process.env;
+    const codeCandidates = [
+      path.join(env.LOCALAPPDATA || "", "Programs", "Microsoft VS Code", "Code.exe"),
+      path.join(env.ProgramFiles || "", "Microsoft VS Code", "Code.exe"),
+      path.join(env["ProgramFiles(x86)"] || "", "Microsoft VS Code", "Code.exe")
+    ].filter((candidate) => fs.existsSync(candidate));
+    opened = codeCandidates.length > 0 ? await run(codeCandidates[0], [targetPath]) : await run("code", [targetPath]);
+  } else {
+    opened = await run("code", [targetPath]);
+  }
+  return opened;
+}
 
