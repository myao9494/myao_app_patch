+                        flushTable();
+                    }
+                } else if (word === "emdash") {
+                    appendText("—");
+                } else if (word === "endash") {
+                    appendText("–");
+                }
+                i += wordMatch[0].length;
+                continue;
+            }
+
+            i++;
+            continue;
+        }
+
+        appendText(char);
+        i++;
+    }
+
+    if (currentTableRows.length > 0) flushTable();
+    if (currentCellText) outputChars.push(currentCellText);
