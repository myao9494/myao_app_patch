+
+        const menu = new Menu();
+
+        // 1. web アプリで開く
+        menu.addItem((item: MenuItem) => {
+            item
+                .setTitle("web アプリで開く")
+                .setIcon("globe")
+                .onClick(() => {
+                    const url = buildFileManagerWebUrl(fullPath);
+                    window.open(url, "_blank");
