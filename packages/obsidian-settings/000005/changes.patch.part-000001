+
+            // winmail.dat (TNEF) カプセル化ファイルの自動展開
+            const isTnef = attachment.FileName.toLowerCase() === "winmail.dat" ||
+                attachment.MimeType.toLowerCase().includes("ms-tnef");
+            if (isTnef) {
+                try {
