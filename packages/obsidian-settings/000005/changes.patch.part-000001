+function filterFolderFiles(files, query) {
+  const sorted = [...files].sort((a, b) => {
+    var _a, _b, _c, _d;
+    return ((_b = (_a = b.stat) == null ? void 0 : _a.mtime) != null ? _b : 0) - ((_d = (_c = a.stat) == null ? void 0 : _c.mtime) != null ? _d : 0);
+  });
+  if (!query) {
+    return sorted;
+  }
+  const keywords = query.trim().split(/[\s\u3000]+/).filter((k) => k.length > 0).map((k) => k.toLowerCase());
+  if (keywords.length === 0) {
