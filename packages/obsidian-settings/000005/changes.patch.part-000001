diff --git a/.obsidian/plugins/nested-markdown-renderer/manifest.json b/.obsidian/plugins/nested-markdown-renderer/manifest.json
new file mode 100644
index 0000000000000000000000000000000000000000..67f916cc9b896ea0bc7c81e4a3c89d65de31aa18
--- /dev/null
+++ b/.obsidian/plugins/nested-markdown-renderer/manifest.json
@@ -0,0 +1,10 @@
+{
+	"id": "nested-markdown-renderer",
+	"name": "Nested Markdown Renderer",
+	"version": "0.2.1",
+	"minAppVersion": "1.12.7",
+	"description": "Renders nested GFM tables and repairs indented callouts in Live Preview.",
+	"author": "JoeChen2me",
+	"authorUrl": "https://github.com/JoeChen2me",
+	"isDesktopOnly": true
+}
diff --git a/.obsidian/plugins/nested-markdown-renderer/styles.css b/.obsidian/plugins/nested-markdown-renderer/styles.css
new file mode 100644
index 0000000000000000000000000000000000000000..5e1d3b0b0274354d9c6d1885bac288b12ba47486
--- /dev/null
+++ b/.obsidian/plugins/nested-markdown-renderer/styles.css
@@ -0,0 +1,26 @@
+.markdown-source-view.mod-cm6
+	.cm-content
+	> .cm-line.nmr-hidden-table-line {
+	display: none;
+}
+
+.nmr-table-widget {
+	box-sizing: border-box;
+	display: inline-block;
+	width: 100%;
+	max-width: 100%;
+	overflow-x: auto;
+	padding-block: var(--size-2-1, 4px);
+	vertical-align: top;
+}
+
+.nmr-table-widget > table {
+	width: max-content;
+	min-width: 100%;
+	margin-block: 0;
+}
+
+.nmr-table-widget.nmr-render-error > pre {
+	margin: 0;
+	white-space: pre-wrap;
+}
