C8\uB2E4."},where:{section:"\uC774 \uD0ED \uC544\uB798\uC758 \uC124\uC815\uC785\uB2C8\uB2E4.",tab:e=>`${e} \uC124\uC815\uC5D0 \uC788\uC2B5\uB2C8\uB2E4.`,card:"\uB300\uC2DC\uBCF4\uB4DC\uC758 \uCE74\uB4DC \uC124\uC815\uC5D0\uC11C \uAD6C\uC131\uD569\uB2C8\uB2E4.",pluginSettings:"\uD574\uB2F9 \uD50C\uB7EC\uADF8\uC778\uC758 \uC124\uC815\uC744 \uC0AC\uC6A9\uD569\uB2C8\uB2E4. Hearth\uC5D0\uC11C \uB530\uB85C \uC124\uC815\uD560 \uD56D\uBAA9\uC740 \uC5C6\uC2B5\uB2C8\uB2E4.",none:"\uC124\uC815\uD560 \uD56D\uBAA9\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."},install:"\uC124\uCE58",installTooltip:"Obsidian \uCEE4\uBBA4\uB2C8\uD2F0 \uD50C\uB7EC\uADF8\uC778\uC5D0\uC11C \uC774 \uD50C\uB7EC\uADF8\uC778\uC744 \uC5FD\uB2C8\uB2E4.",goToSection:"\uD45C\uC2DC",goToTab:"\uC5F4\uAE30",items:{...M.settings.integrations.items,stereo:{name:"Stereo",desc:"\uC74C\uC545 \uCE74\uB4DC\uAC00 Stereo \uD50C\uB7EC\uADF8\uC778\uC758 Navidrome/Subsonic \uD50C\uB808\uC774\uC5B4\uB97C \uC81C\uC5B4\uD560 \uC218 \uC788\uAC8C \uD569\uB2C8\uB2E4 \u2014 \uD604\uC7AC \uD2B8\uB799, \uB300\uAE30\uC5F4, \uC7AC\uC0DD \uCEE8\uD2B8\uB864."},omnisearch:{...M.settings.integrations.items.omnisearch,name:"Omnisearch",desc:"Hearth \uB0B4\uC7A5 \uAC80\uC0C9 \uB300\uC2E0 Omnisearch\uC758 \uD37C\uC9C0 \uC804\uBB38 \uAC80\uC0C9 \uC778\uB371\uC2A4\uB97C \uC0AC\uC6A9\uD569\uB2C8\uB2E4. \uAC80\uC0C9 \u2192 \uAC80\uC0C9\uCC3D\uC5D0\uC11C \uC5D4\uC9C4\uC744 \uC120\uD0DD\uD558\uC138\uC694."},tasknotes:{...M.settings.integrations.items.tasknotes,name:"TaskNotes",desc:"TaskNotes\uC758 \uC791\uC5C5\uBCC4 \uB178\uD2B8\uC5D0\uC11C \uC0C1\uD0DC, \uB9C8\uAC10\uC77C, \uC6B0\uC120\uC21C\uC704\uB97C frontmatter\uB85C \uC77D\uC2B5\uB2C8\uB2E4."},dataview:{...M.settings.integrations.items.dataview,name:"Dataview",desc:"Dataview \uCE74\uB4DC\uC5D0\uC11C DQL \uCFFC\uB9AC\uC640 DataviewJS \uBE14\uB85D\uC744 \uC2E4\uD589\uD558\uACE0 \uC778\uB371\uC2A4 \uBCC0\uACBD\uC5D0 \uB530\uB77C \uAC31\uC2E0\uD569\uB2C8\uB2E4."},datacore:{...M.settings.integrations.items.datacore,name:"Datacore",desc:"Dataview\uC758 \uD6C4\uC18D \uD50C\uB7EC\uADF8\uC778\uC785\uB2C8\uB2E4. \uCFFC\uB9AC \uB610\uB294 JS/JSX/TS/TSX \uC2A4\uD06C\uB9BD\uD2B8\uB97C \uC2E4\uD589\uD569\uB2C8\uB2E4."},templater:{...M.settings.integrations.items.templater,name:"Templater",desc:"Templater \uD15C\uD50C\uB9BF\uC73C\uB85C \uB178\uD2B8\uB97C \uB9CC\uB4DC\uB294 \uBC84\uD2BC\uC744 \uC81C\uACF5\uD569\uB2C8\uB2E4. \uD15C\uD50C\uB9BF, \uB300\uC0C1 \uD3F4\uB354, \uD30C\uC77C \uC774\uB984 \uD615\uC2DD\uC744 \uAC01\uAC01 \uC124\uC815\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."},periodicNotes:{...M.settings.integrations.items.periodicNotes,name:"Periodic Notes",desc:"Periodic Notes \uD50C\uB7EC\uADF8\uC778\uC73C\uB85C \uC774\uBC88 \uC8FC, \uC6D4, \uBD84\uAE30, \uC5F0\uB3C4\uC758 \uB178\uD2B8\uB97C \uCC3E\uC544 \uB9CC\uB4E4\uACE0 \uD45C\uC2DC\uD569\uB2C8\uB2E4."},journals:{...M.settings.integrations.items.journals,name:"Journals",desc:"Journals \uD50C\uB7EC\uADF8\uC778\uC758 API\uB97C \uD1B5\uD574 \uC800\uB110\uC758 \uD604\uC7AC \uB178\uD2B8\uB97C \uCC3E\uC544 \uB9CC\uB4E4\uACE0 \uD45C\uC2DC\uD569\uB2C8\uB2E4."},git:{...M.settings.integrations.items.git,name:"Git",desc:"\uC800\uC7A5\uC18C \uBE0C\uB79C\uCE58, \uBCC0\uACBD \uC0AC\uD56D, \uCD5C\uADFC \uCEE4\uBC0B\uC744 \uD45C\uC2DC\uD558\uACE0 Git \uD50C\uB7EC\uADF8\uC778\uC73C\uB85C \uCEE4\uBC0B \uBC0F \uB3D9\uAE30\uD654\uD569\uB2C8\uB2E4."},operon:{...M.settings.integrations.items.operon,name:"Operon",desc:"Operon\uC758 \uAC1C\uBC1C\uC790 API\uB85C \uC791\uC5C5, \uBCF4\uB4DC, \uC77C\uC815, \uD0C0\uC774\uBA38\uB97C \uC77D\uC2B5\uB2C8\uB2E4. \uB370\uC2A4\uD06C\uD1B1\uACFC Obsidian 1.12.2 \uC774\uC0C1\uC774 \uD544\uC694\uD558\uBA70 Operon\uC5D0\uC11C \uC811\uADFC\uC744 \uC2B9\uC778\uD574\uC57C \uD569\uB2C8\uB2E4."},iconic:{...M.settings.integrations.items.iconic,name:"Iconic",desc:"Iconic\uC73C\uB85C \uC124\uC815\uD55C \uD30C\uC77C\uBCC4 \uC544\uC774\uCF58\uC744 \uCD5C\uADFC \uD56D\uBAA9, \uC990\uACA8\uCC3E\uAE30, \uC800\uC7A5\uB41C \uAC80\uC0C9, \uAC80\uC0C9 \uACB0\uACFC \uB4F1 Hearth\uAC00 \uD30C\uC77C\uC744 \uB098\uC5F4\uD558\uB294 \uBAA8\uB4E0 \uACF3\uC5D0 \uD45C\uC2DC\uD569\uB2C8\uB2E4."},iconize:{...M.settings.integrations.items.iconize,name:"Iconize",desc:"Iconize(\uC774\uC804 \uC774\uB984 Obsidian Icon Folder)\uC5D0\uB3C4 \uB3D9\uC77C\uD558\uAC8C \uC801\uC6A9\uB418\uBA70, frontmatter \uC18D\uC131\uC73C\uB85C \uC124\uC815\uD55C \uC544\uC774\uCF58\uB3C4 \uD3EC\uD568\uD569\uB2C8\uB2E4."},frontMatterTitle:{...M.settings.integrations.items.frontMatterTitle,name:"Front Matter Title",desc:"\uD3F4\uB354 \uCE74\uB4DC\uC640 \uD3F4\uB354 \uD0D0\uC0C9\uAE30\uC5D0\uC11C \uB178\uD2B8\uB97C \uD30C\uC77C \uC774\uB984 \uB300\uC2E0 Front Matter Title\uC774 \uD30C\uC77C \uD0D0\uC0C9\uAE30\uC5D0 \uD45C\uC2DC\uD558\uB294 \uC81C\uBAA9\uC73C\uB85C \uB098\uC5F4\uD569\uB2C8\uB2E4."},vaultPet:{...M.settings.integrations.items.vaultPet,name:"Vault Pet",desc:"Vault Pet \uCE74\uB4DC\uAC00 \uBCF4\uB4DC\uC5D0 \uD50C\uB7EC\uADF8\uC778\uC744 \uB2F4\uC2B5\uB2C8\uB2E4. \uD074\uB9AD\uD560 \uC218 \uC788\uB294 \uC2E4\uC2DC\uAC04 \uD3AB \uCE74\uB4DC \uB610\uB294 \uD018\uC2A4\uD2B8, \uB3C4\uAC10, \uBC30\uC9C0, \uD1B5\uACC4\uAC00 \uC788\uB294 \uD3AB \uD558\uC6B0\uC2A4 \uC804\uCCB4\uB97C \uD45C\uC2DC\uD569\uB2C8\uB2E4. \uD3AB\uACFC \uACBD\uD5D8\uCE58, \uC7A0\uAE08 \uD574\uC81C\uD55C \uBAA8\uB4E0 \uD56D\uBAA9\uC740 Vault Pet\uC758 \uAC83\uC774\uBA70 Hearth\uB294 \uACF5\uAC04\uB9CC \uC81C\uACF5\uD569\uB2C8\uB2E4."},excalidraw:{...M.settings.integrations.items.excalidraw,name:"Excalidraw",desc:"\uC0BD\uC785 \uCE74\uB4DC\uC5D0\uC11C Excalidraw \uADF8\uB9BC\uC744 \uC2E4\uC2DC\uAC04\uC73C\uB85C \uB80C\uB354\uB9C1\uD558\uBA70, \u2018\uC0C8 \uADF8\uB9BC\u2019 \uB3D9\uC791\uC740 Excalidraw \uC790\uCCB4 \uBA85\uB839\uC73C\uB85C \uADF8\uB9BC\uC744 \uB9CC\uB4ED\uB2C8\uB2E4."},bases:{...M.settings.integrations.items.bases,name:"Bases",desc:"\uC0BD\uC785 \uCE74\uB4DC\uC5D0\uC11C \uB300\uC2DC\uBCF4\uB4DC\uC5D0 Bases(.base) \uBCF4\uAE30\uB97C \uD45C\uC2DC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."},canvas:{...M.settings.integrations.items.canvas,name:"Canvas",desc:"\uC0BD\uC785 \uCE74\uB4DC\uC5D0\uC11C Canvas\uB97C \uAC00\uC7A5\uC790\uB9AC\uAE4C\uC9C0 \uAF49 \uCC44\uC6CC \uC0C1\uD638\uC791\uC6A9 \uAC00\uB2A5\uD558\uAC8C \uD45C\uC2DC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."},dailyNotes:{...M.settings.integrations.items.dailyNotes,name:"\uB370\uC77C\uB9AC \uB178\uD2B8",desc:"\uB370\uC77C\uB9AC \uB178\uD2B8, \uBBF8\uB2C8 \uB2EC\uB825, \uBCF4\uAD00\uD568 \uD1B5\uACC4 \uCE74\uB4DC\uB294 \uB370\uC77C\uB9AC \uB178\uD2B8 \uD50C\uB7EC\uADF8\uC778\uC758 \uD3F4\uB354, \uB0A0\uC9DC \uD615\uC2DD, \uD15C\uD50C\uB9BF\uC744 \uC0AC\uC6A9\uD574 \uC624\uB298\uC758 \uB178\uD2B8\uB97C \uCC3E\uC2B5\uB2C8\uB2E4."},bookmarks:{...M.settings.integrations.items.bookmarks,name:"\uBD81\uB9C8\uD06C",desc:"\uBD81\uB9C8\uD06C \uCE74\uB4DC\uC5D0 \uADF8\uB8F9\uC744 \uD3EC\uD568\uD55C Obsidian \uBD81\uB9C8\uD06C \uC804\uCCB4\uB97C \uB098\uC5F4\uD569\uB2C8\uB2E4."},globalSearch:{...M.settings.integrations.items.globalSearch,name:"\uAC80\uC0C9",desc:"\uC804\uCCB4 \uACB0\uACFC\uB97C \uC694\uCCAD\uD558\uBA74 \uCFFC\uB9AC\uB97C Obsidian\uC758 \uAC80\uC0C9 \uCC3D\uC73C\uB85C \uB118\uAE41\uB2C8\uB2E4."},fileExplorer:{...M.settings.integrations.items.fileExplorer,name:"\uD30C\uC77C \uD0D0\uC0C9\uAE30",desc:"Hearth \uAC80\uC0C9 \uACB0\uACFC\uC758 \u2018\uD30C\uC77C \uD0D0\uC0C9\uAE30\uC5D0\uC11C \uD45C\uC2DC\u2019 \uAE30\uB2A5\uC5D0 \uC0AC\uC6A9\uD569\uB2C8\uB2E4."},workspaces:{...M.settings.integrations.items.workspaces,name:"\uC791\uC5C5 \uACF5\uAC04",desc:"\uB300\uC2DC\uBCF4\uB4DC\uB97C \uC5F4 \uB54C \uC800\uC7A5\uB41C \uC791\uC5C5 \uACF5\uAC04\uC73C\uB85C \uC804\uD658\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."},audioRecorder:{...M.settings.integrations.items.audioRecorder,name:"\uC624\uB514\uC624 \uB179\uC74C\uAE30",desc:"\uBAA8\uBC14\uC77C \uB3D9\uC791 \uBC84\uD2BC \u2018\uC74C\uC131 \uB179\uC74C\u2019\uC73C\uB85C Obsidian \uC790\uCCB4 \uB179\uC74C\uAE30\uB97C \uC2DC\uC791\uD558\uACE0 \uC911\uC9C0\uD569\uB2C8\uB2E4."},leafViews:{...M.settings.integrations.items.leafViews,name:"\uC0AC\uC774\uB4DC \uD328\uB110\uC774 \uC788\uB294 \uBAA8\uB4E0 \uD50C\uB7EC\uADF8\uC778",desc:"\uD50C\uB7EC\uADF8\uC778 \uBCF4\uAE30 \uCE74\uB4DC\uB294 \uB2EC\uB825, Kanban \uBCF4\uB4DC, \uAC1C\uC694, \uD0DC\uADF8 \uCC3D \uB4F1 \uB2E4\uB978 \uD50C\uB7EC\uADF8\uC778\uC774 \uB4F1\uB85D\uD55C \uBCF4\uAE30\uB97C \uCE74\uB4DC \uC548\uC5D0 \uBC14\uB85C \uD45C\uC2DC\uD569\uB2C8\uB2E4. \uC124\uCE58\uB41C \uBCF4\uAE30\uB294 \uCE74\uB4DC\uC758 \uBCF4\uAE30 \uC120\uD0DD\uAE30\uC5D0 \uB098\uD0C0\uB0A9\uB2C8\uB2E4."},jira:{...M.settings.integrations.items.jira,name:"Jira",desc:"Jira \uCE74\uB4DC\uB294 \uCE74\uB4DC\uC5D0 \uC785\uB825\uD55C \uC778\uC99D \uC815\uBCF4\uB85C Jira Cloud \uB610\uB294 Server \uC778\uC2A4\uD134\uC2A4\uC758 REST API\uC5D0\uC11C \uC774\uC288\uB97C \uAC00\uC838\uC635\uB2C8\uB2E4."},rss:{...M.settings.integrations.items.rss,name:"RSS \uBC0F Atom \uD53C\uB4DC",desc:"RSS \uCE74\uB4DC\uB294 \uC9C0\uC815\uD55C RSS 2.0 \uB610\uB294 Atom \uD53C\uB4DC\uB97C \uAC00\uC838\uC640 \uD574\uC11D\uD569\uB2C8\uB2E4."},ics:{...M.settings.integrations.items.ics,name:"iCalendar \uD53C\uB4DC",desc:"\uBBF8\uB2C8 \uB2EC\uB825 \uCE74\uB4DC\uC5D0\uC11C Google, iCloud, Fastmail, Nextcloud \uB4F1\uC758 \uC678\uBD80 ICS/webcal \uCE98\uB9B0\uB354\uB97C \uAD6C\uB3C5\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."},currency:{...M.settings.integrations.items.currency,name:"\uD658\uC728",desc:"\uACC4\uC0B0\uAE30 \uCE74\uB4DC\uC640 \uAC80\uC0C9\uCC3D\uC740 \uC720\uB7FD\uC911\uC559\uC740\uD589\uC774 \uB9E4\uC77C \uBC1C\uD45C\uD558\uB294 \uAE30\uC900 \uD658\uC728\uB85C \uD1B5\uD654\uB97C \uBCC0\uD658\uD558\uBA70, \uD658\uC728\uC740 \uC720\uB7FD\uC911\uC559\uC740\uD589\uC5D0\uC11C \uC9C1\uC811 \uAC00\uC838\uC624\uACE0 Frankfurter\uB294 \uB300\uCCB4 \uC18C\uC2A4\uB85C\uB9CC \uC0AC\uC6A9\uD569\uB2C8\uB2E4."},markets:{...M.settings.integrations.items.markets,name:"\uC2DC\uC7A5 \uC2DC\uC138",desc:"\uC2DC\uC7A5 \uCE74\uB4DC\uB294 \uD0A4\uAC00 \uD544\uC694 \uC5C6\uB294 \uBB34\uB8CC \uC18C\uC2A4\uC5D0\uC11C \uC2DC\uC138\uB97C \uC77D\uC2B5\uB2C8\uB2E4. \uC804 \uC138\uACC4 \uB300\uBD80\uBD84\uC758 \uAC70\uB798\uC18C, \uC678\uD658, \uAC00\uC0C1\uC790\uC0B0\uC740 Yahoo Finance, \uC0C1\uD558\uC774\xB7\uC120\uC804\xB7\uBCA0\uC774\uC9D5\xB7\uD64D\uCF69 \uC0C1\uC7A5 \uC885\uBAA9\uC740 Tencent, \uC911\uAD6D \uC7A5\uC678 \uD380\uB4DC\uB294 Eastmoney, \uCF54\uC778\uC740 CoinGecko, \uD1B5\uD654 \uC30D\uC740 Frankfurter\uB97C \uD1B5\uD55C ECB\uB97C \uC0AC\uC6A9\uD569\uB2C8\uB2E4. \uBAA8\uB450 \uACF5\uC2DD API\uAC00 \uC544\uB2C8\uBBC0\uB85C \uD55C \uC18C\uC2A4\uAC00 \uC2E4\uD328\uD558\uBA74 \uB2E4\uB978 \uC18C\uC2A4\uB85C \uB300\uCCB4\uD569\uB2C8\uB2E4. \uCE74\uB4DC\uC5D0 \uC788\uB294 \uC885\uBAA9 \uAE30\uD638\uB9CC \uC804\uC1A1\uD569\uB2C8\uB2E4."},weather:{...M.settings.integrations.items.weather,name:"\uC77C\uAE30 \uC608\uBCF4",desc:"\uB0A0\uC528 \uCE74\uB4DC\uC640 \uC2E4\uC2DC\uAC04 \uD558\uB298 \uBC30\uACBD\uC740 Open-Meteo\uC5D0\uC11C \uB0A0\uC528\uB97C \uAC00\uC838\uC635\uB2C8\uB2E4. \uBB34\uB8CC\uC774\uBA70 \uD0A4\uB098 \uACC4\uC815\uC774 \uD544\uC694 \uC5C6\uC2B5\uB2C8\uB2E4. \uC120\uD0DD\uD55C \uC88C\uD45C\uB9CC \uC804\uC1A1\uD558\uBA70, \uD55C \uAC00\uC9C0 \uB0A0\uC528\uB85C \uACE0\uC815\uD55C \uD558\uB298\uC740 \uC704\uCE58\uAC00 \uC804\uD600 \uD544\uC694 \uC5C6\uC2B5\uB2C8\uB2E4."},tension:{...M.settings.integrations.items.tension,name:"\uC138\uACC4 \uAE34\uC7A5\uB3C4",desc:"\uC138\uACC4 \uAE34\uC7A5\uB3C4 \uCE74\uB4DC\uB294 kite.kagi.com\uC5D0\uC11C Kagi News\uC758 World Tension \uC9C0\uC218\uB97C \uC77D\uC2B5\uB2C8\uB2E4. \uADF8\uB0A0\uC758 \uC138\uACC4 \uB274\uC2A4\uB97C \uC5B8\uC5B4 \uBAA8\uB378\uC774 0\u2013100\uC73C\uB85C \uD3C9\uAC00\uD55C \uAC12\uC785\uB2C8\uB2E4. \uBB34\uB8CC\uC774\uBA70 \uD0A4\uB098 \uACC4\uC815\uC774 \uD544\uC694 \uC5C6\uACE0, \uC0AC\uC6A9\uC790\uB098 \uBCF4\uAD00\uD568\uC5D0 \uAD00\uD55C \uC815\uBCF4\uB294 \uC804\uC1A1\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."},webSearch:{...M.settings.integrations.items.webSearch,name:"\uC628\uB77C\uC778 \uAC80\uC0C9",desc:"\uAC80\uC0C9\uCC3D \uBC84\uD2BC\uC73C\uB85C \uB178\uD2B8\uB97C \uB9CC\uB4DC\uB294 \uB300\uC2E0 \uCFFC\uB9AC\uB97C DuckDuckGo\uB85C \uBCF4\uB0BC \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uAC80\uC0C9 \u2192 \uAC80\uC0C9\uCC3D\uC5D0\uC11C \uC804\uD658\uD558\uC138\uC694."}}},tasks:{...M.settings.tasks,heading:"\uC791\uC5C5 / TaskNotes",headingDesc:"TaskNotes \uBAA8\uB4DC\uC758 \uC791\uC5C5 \uCE74\uB4DC\uC5D0\uC11C \uC77D\uB294 \uD544\uB4DC \uC774\uB984\uC785\uB2C8\uB2E4. TaskNotes \uC790\uCCB4 \uC124\uC815\uC758 frontmatter \uD544\uB4DC\uC640 \uC77C\uCE58\uC2DC\uCF1C\uC57C \uD569\uB2C8\uB2E4.",statusField:"\uC0C1\uD0DC \uD544\uB4DC",statusFieldDesc:"\uC791\uC5C5 \uC0C1\uD0DC\uB97C \uC77D\uC744 frontmatter \uD544\uB4DC\uC785\uB2C8\uB2E4.",dueField:"\uB9C8\uAC10\uC77C \uD544\uB4DC",dueFieldDesc:"\uC791\uC5C5 \uB9C8\uAC10\uC77C\uC744 \uC77D\uC744 frontmatter \uD544\uB4DC\uC785\uB2C8\uB2E4.",priorityField:"\uC6B0\uC120\uC21C\uC704 \uD544\uB4DC",priorityFieldDesc:"\uC791\uC5C5 \uC6B0\uC120\uC21C\uC704\uB97C \uC77D\uC744 frontmatter \uD544\uB4DC\uC785\uB2C8\uB2E4.",doneValue:"\u2018\uC644\uB8CC\u2019 \uC0C1\uD0DC \uAC12",doneValueDesc:"TaskNotes \uC791\uC5C5\uC744 \uC644\uB8CC\uB85C \uD45C\uC2DC\uD558\uB294 \uC0C1\uD0DC \uAC12\uC785\uB2C8\uB2E4.",fieldsEnable:"\uC791\uC5C5 \uD544\uB4DC \uC0AC\uC6A9\uC790 \uC9C0\uC815",fieldsEnableDesc:"\uD45C\uC2DC\uD560 frontmatter \uC18D\uC131\uC744 \uC9C1\uC811 \uC120\uD0DD\uD558\uACE0 \uC774\uB984, \uC0C9\uC0C1, \uC21C\uC11C\uB97C \uC124\uC815\uD569\uB2C8\uB2E4. \uCF1C\uBA74 \uC791\uC5C5\uC5D0\uB294 \uCD94\uAC00\uD55C \uD544\uB4DC\uB9CC \uD45C\uC2DC\uB429\uB2C8\uB2E4.",fields:"\uC791\uC5C5\uC5D0 \uD45C\uC2DC\uD560 \uD544\uB4DC",fieldsDesc:"\uBAA8\uB4E0 \uC791\uC5C5 \uCE74\uB4DC\uC5D0 \uD45C\uC2DC\uD560 \uD544\uB4DC\uC785\uB2C8\uB2E4. \uCE74\uB4DC\uBCC4 \uC124\uC815\uC5D0\uC11C \uB530\uB85C \uC9C0\uC815\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."},fileIcons:{...M.settings.fileIcons,heading:"\uD30C\uC77C \uC544\uC774\uCF58 / Iconic / Iconize",headingDesc:"Iconic \uB610\uB294 Iconize\uC5D0\uC11C \uC124\uC815\uD55C \uD30C\uC77C\uBCC4 \uC544\uC774\uCF58\uC744 \uCD5C\uADFC \uD56D\uBAA9, \uC990\uACA8\uCC3E\uAE30, \uAC80\uC0C9 \uACB0\uACFC \uB4F1 Hearth\uC758 \uD30C\uC77C \uBAA9\uB85D\uC5D0 \uC0AC\uC6A9\uD569\uB2C8\uB2E4.",enable:"Iconic / Iconize \uC544\uC774\uCF58 \uC0AC\uC6A9",enableDesc:"\uB044\uBA74 \uB450 \uD50C\uB7EC\uADF8\uC778\uACFC \uAD00\uACC4\uC5C6\uC774 Hearth\uC758 \uD30C\uC77C \uC720\uD615 \uC544\uC774\uCF58\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4.",enableDescNoPlugin:"Iconic\uACFC Iconize\uAC00 \uBAA8\uB450 \uBE44\uD65C\uC131\uD654\uB418\uC5B4 \uC788\uC5B4 \uC544\uB798 frontmatter \uC635\uC158\uC774 \uAEBC\uC838 \uC788\uC73C\uBA74 Hearth\uC758 \uD30C\uC77C \uC720\uD615 \uC544\uC774\uCF58\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4. \uC774 \uC124\uC815\uC740 \uCF1C \uB46C\uB3C4 \uD50C\uB7EC\uADF8\uC778\uC744 \uC124\uCE58\uD558\uBA74 \uC801\uC6A9\uB429\uB2C8\uB2E4.",property:"Iconize frontmatter \uC18D\uC131",propertyDesc:"\uBA54\uB274 \uB300\uC2E0 frontmatter\uB85C \uC124\uC815\uD55C \uC544\uC774\uCF58\uC5D0 \uC0AC\uC6A9\uD560 \uC18D\uC131\uC785\uB2C8\uB2E4. \uC27C\uD45C\uB85C \uAD6C\uBD84\uD574 \uC5EC\uB7EC \uC18D\uC131\uC744 \uC9C0\uC815\uD560 \uC218 \uC788\uC5B4 \uB2E4\uB978 \uD50C\uB7EC\uADF8\uC778\uC774 \uC4F0\uB294 \uC18D\uC131\uC744 \uB367\uBD99\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4. Iconize\uC758 \uC18D\uC131 \uC774\uB984\uACFC \uC77C\uCE58\uC2DC\uD0A4\uC138\uC694. \uAE30\uBCF8\uAC12\uC740 icon\uC785\uB2C8\uB2E4.",frontmatterWithoutPlugin:"\uC544\uC774\uCF58 \uD50C\uB7EC\uADF8\uC778 \uC5C6\uC774 frontmatter \uC544\uC774\uCF58 \uC77D\uAE30",frontmatterWithoutPluginDesc:"Iconic\uC774\uB098 Iconize\uAC00 \uC5C6\uC5B4\uB3C4 \uB178\uD2B8\uC758 frontmatter\uC5D0 \uC801\uD78C \uC544\uC774\uCF58\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4. \uB2E4\uB978 \uD50C\uB7EC\uADF8\uC778(Notebook Navigator, Pretty Properties, AutoIcon)\uC774\uB098 \uC9C1\uC811 \uC801\uC740 \uC544\uC774\uCF58\uC5D0 \uC720\uC6A9\uD569\uB2C8\uB2E4. \uAE30\uBCF8\uAC12\uC740 \uAEBC\uC9D0\uC785\uB2C8\uB2E4. icon\uC740 \uD754\uD55C \uC18D\uC131 \uC774\uB984\uC774\uB77C \uB2E4\uB978 \uC6A9\uB3C4\uB85C \uC4F0\uB294 \uBCF4\uAD00\uC18C\uC5D0\uC11C\uB294 \uADF8 \uAC12\uC774 \uC544\uC774\uCF58\uC73C\uB85C \uD45C\uC2DC\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4. Obsidian\uC774 \uC544\uB294 \uC544\uC774\uCF58 ID\uC640 \uC774\uBAA8\uC9C0\uB9CC \uD45C\uC2DC\uD558\uBA70, \uADF8 \uBC16\uC758 \uAC12\uC740 Hearth\uC758 \uD30C\uC77C \uC720\uD615 \uC544\uC774\uCF58\uC744 \uC720\uC9C0\uD569\uB2C8\uB2E4."},frontMatterTitle:{...M.settings.frontMatterTitle,heading:"Front Matter Title",headingDesc:"Front Matter Title \uD50C\uB7EC\uADF8\uC778\uC774 \uC81C\uBAA9\uC744 \uC81C\uACF5\uD55C \uB178\uD2B8\uB97C \uD30C\uC77C \uC774\uB984 \uB300\uC2E0 \uD574\uB2F9 \uC81C\uBAA9\uC73C\uB85C \uD45C\uC2DC\uD569\uB2C8\uB2E4.",enable:"Front Matter Title \uC81C\uBAA9 \uC0AC\uC6A9",enableDesc:"\uB044\uBA74 \uD50C\uB7EC\uADF8\uC778\uC744 \uBB34\uC2DC\uD558\uACE0 \uD30C\uC77C \uC774\uB984\uC73C\uB85C \uB178\uD2B8\uB97C \uD45C\uC2DC\uD569\uB2C8\uB2E4.",enableDescNoPlugin:"Front Matter Title\uC774 \uBE44\uD65C\uC131\uD654\uB418\uC5B4 \uD30C\uC77C \uC774\uB984\uC73C\uB85C \uB178\uD2B8\uB97C \uD45C\uC2DC\uD569\uB2C8\uB2E4. \uD50C\uB7EC\uADF8\uC778\uC744 \uC124\uCE58\uD558\uBA74 \uC774 \uC124\uC815\uC774 \uC801\uC6A9\uB429\uB2C8\uB2E4."},operon:{...M.settings.operon,heading:"Operon",headingDesc:"Operon \uAC1C\uBC1C\uC790 API\uB85C \uC791\uC5C5, \uBCF4\uB4DC, \uC77C\uC815, \uC2E4\uD589 \uC911\uC778 \uD0C0\uC774\uBA38\uB97C \uC77D\uC2B5\uB2C8\uB2E4. \uB370\uC774\uD130\uC758 \uC6D0\uBCF8\uC740 Operon\uC774\uBA70 Hearth\uB294 \uACB0\uACFC\uB9CC \uD45C\uC2DC\uD569\uB2C8\uB2E4.",enable:"Operon \uC5F0\uACB0",enableDesc:"\uB044\uBA74 Operon \uCE74\uB4DC\uAC00 \uB370\uC774\uD130\uB97C \uC77D\uC9C0 \uC54A\uC73C\uBA70 Hearth\uB294 \uC811\uADFC\uC744 \uC694\uCCAD\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uB300\uC2DC\uBCF4\uB4DC\uC5D0 Operon \uCE74\uB4DC\uAC00 \uC788\uC744 \uB54C\uB9CC \uC811\uADFC\uC744 \uC694\uCCAD\uD569\uB2C8\uB2E4.",status:"\uC5F0\uACB0 \uC0C1\uD0DC",statusAbsent:"Operon\uC774 \uC124\uCE58\uB418\uC5B4 \uC788\uAC70\uB098 \uD65C\uC131\uD654\uB418\uC5B4 \uC788\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.",statusUnsupported:"Operon \uAC1C\uBC1C\uC790 API\uB294 \uB370\uC2A4\uD06C\uD1B1 \uC804\uC6A9\uC774\uBA70 Obsidian 1.12.2 \uC774\uC0C1\uC774 \uD544\uC694\uD569\uB2C8\uB2E4.",statusBooting:"Operon\uC774 \uC2E4\uD589 \uC911\uC774\uBA70 \uC2DC\uC791\uD558\uB294 \uC911\uC785\uB2C8\uB2E4.",statusPending:"\uC2B9\uC778\uC744 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uC124\uC815 \u2192 Operon \u2192 Core \u2192 General \u2192 Developer API Integrations\uC5D0\uC11C Hearth\uB97C \uC2B9\uC778\uD558\uC138\uC694.",statusSuspended:"\uC811\uADFC\uC774 \uC77C\uC2DC \uC911\uC9C0\uB418\uC5C8\uC2B5\uB2C8\uB2E4. Operon\uC758 Developer API Integrations\uC5D0\uC11C Hearth\uC758 \uB300\uAE30 \uC911\uC778 \uAD8C\uD55C\uC744 \uD655\uC778\uD558\uC138\uC694.",statusRevoked:"\uC811\uADFC \uAD8C\uD55C\uC774 \uCDE8\uC18C\uB418\uC5C8\uC2B5\uB2C8\uB2E4. Operon\uC758 Developer API Integrations\uC5D0\uC11C \uB2E4\uC2DC \uD5C8\uC6A9\uD558\uC138\uC694.",statusReady:"\uC5F0\uACB0\uB428 \u2014 Operon \uCE74\uB4DC\uC5D0\uC11C \uC791\uC5C5\uC744 \uC77D\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.",statusIdle:"\uC544\uC9C1 \uC5F0\uACB0\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4. Operon \uCE74\uB4DC\uB97C \uCD94\uAC00\uD558\uBA74 \uC5F0\uACB0\uC744 \uC2DC\uC791\uD569\uB2C8\uB2E4.",statusOff:"\uC5F0\uB3D9\uC774 \uAEBC\uC838 \uC788\uC5B4 Hearth\uAC00 Operon\uC5D0\uC11C \uB370\uC774\uD130\uB97C \uC77D\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.",statusError:"Operon\uC5D0\uC11C \uC5F0\uACB0\uC744 \uAC70\uBD80\uD588\uC2B5\uB2C8\uB2E4.",detail:"Operon \uC751\uB2F5",install:"\uCEE4\uBBA4\uB2C8\uD2F0 \uD50C\uB7EC\uADF8\uC778\uC5D0\uC11C Operon \uC5F4\uAE30",writes:"\uBCC0\uACBD \uD5C8\uC6A9",writesDesc:"\uBCF4\uB4DC \uCE74\uB4DC\uC5D0\uC11C \uC791\uC5C5\uC744 \uB2E4\uB978 \uC0C1\uD0DC\uB85C \uC62E\uAE30\uACE0 \uC0C8 \uC791\uC5C5\uC744 \uB9CC\uB4E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uBCC0\uACBD \uD5C8\uC6A9 \uC2DC Operon\uC758 Developer API Integrations\uC5D0\uC11C \uB2E4\uC2DC \uC2B9\uC778\uD574\uC57C \uD569\uB2C8\uB2E4. \uB044\uBA74 \uC77D\uAE30 \uC804\uC6A9\uC785\uB2C8\uB2E4.",writesPending:"\uC77D\uAE30\uB294 \uAC00\uB2A5\uD558\uC9C0\uB9CC \uBCC0\uACBD \uAD8C\uD55C\uC740 \uC544\uC9C1 \uC5C6\uC2B5\uB2C8\uB2E4. Operon\uC758 Developer API Integrations\uC5D0\uC11C Hearth\uB97C \uB2E4\uC2DC \uC2B9\uC778\uD558\uC138\uC694.",capabilities:"\uC694\uCCAD \uAD8C\uD55C",capabilitiesDesc:"Operon\uC740 \uC77C\uBD80 \uAD8C\uD55C\uB9CC \uC2B9\uC778\uD558\uB294 \uC5F0\uACB0\uC744 \uC9C0\uC6D0\uD558\uC9C0 \uC54A\uC544 \uAD8C\uD55C\uC744 \uD55C \uBC88\uC5D0 \uC694\uCCAD\uD569\uB2C8\uB2E4. \u2018\uBCC0\uACBD \uD5C8\uC6A9\u2019\uC744 \uCF1C\uBA74 \uC791\uC5C5 \uC0C1\uD0DC \uBCC0\uACBD\uACFC \uC0DD\uC131 \uAD8C\uD55C\uB3C4 \uC694\uCCAD\uD569\uB2C8\uB2E4.",missing:e=>`\uC544\uC9C1 \uD5C8\uC6A9\uB418\uC9C0 \uC54A\uC74C: ${e}`,recheck:"\uB2E4\uC2DC \uD655\uC778",recheckDesc:"Operon\uC744 \uC2B9\uC778, \uCDE8\uC18C \uB610\uB294 \uB2E4\uC2DC \uBD88\uB7EC\uC628 \uB4A4 \uC5F0\uACB0\uC744 \uB2E4\uC2DC \uC5FD\uB2C8\uB2E4.",recheckAction:"\uC9C0\uAE08 \uB2E4\uC2DC \uD655\uC778"},filters:{...M.settings.filters,heading:"\uD544\uD130 \uCE69",headingDesc:"\uBCF4\uAD00\uD568 \uD30C\uC77C \uC720\uD615\uC744 \uAC10\uC9C0\uD574 \uCE69\uC744 \uC790\uB3D9\uC73C\uB85C \uD45C\uC2DC\uD569\uB2C8\uB2E4. \uD544\uC694 \uC5C6\uB294 \uCE69\uC740 \uC228\uAE30\uACE0, \uC228\uAE38 \uB54C \uADF8 \uC720\uD615\uC744 \uAC80\uC0C9 \uACB0\uACFC\uC5D0\uC11C\uB3C4 \uC81C\uC678\uD560\uC9C0 \uC120\uD0DD\uD558\uC138\uC694.",strict:"\uD45C\uC2DC\uB41C \uC720\uD615\uB9CC \uAC80\uC0C9",strictDesc:"\uB044\uBA74 \uC228\uAE34 \uCE69\uC740 \uC904\uC5D0\uC11C\uB9CC \uC0AC\uB77C\u