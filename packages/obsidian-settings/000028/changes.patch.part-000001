 	pointer-events: none;
 }
 
+/* A video backdrop (see applyVaultVideo in background.ts). It fills the layer
+ * the way a picture does, cropping to cover — the layer already carries the
+ * opacity and blur, so nothing about them is repeated here. Whether it plays or
+ * holds still is the performance tier's call, not this stylesheet's: a paused
+ * video keeps painting its current frame, which is exactly what a frozen
+ * backdrop should look like. */
+.hearth-bg > .hearth-bg-video {
+	position: absolute;
+	inset: 0;
+	width: 100%;
+	height: 100%;
+	object-fit: cover;
+	pointer-events: none;
+}
+
 /* ---- Hearth's own wallpaper -------------------------------------------
  *
  * The "default" background, drawn in wallpaper.ts. The SVG only names its
@@ -3568,7 +3583,14 @@ button.hearth-kofi-btn:focus-visible {
  * does the same on its sizer. In a full tab that lets the last line reach the
  * top; in a card it means the note always overflows, however short it is and
  * however tall the card — a scrollbar that just rescales as the card grows.
- * !important because the padding is an inline style the editor rewrites. */
+ * !important because the padding is an inline style the editor rewrites:
+ * CodeMirror's scroll-past-end extension writes `paddingBottom` onto the content
+ * element itself, reading mode writes `min-height` onto its sizer, and no
+ * selector outranks an inline style, so higher specificity cannot replace this
+ * (see the `:not(#hearth-boost)` note at the top of this file, which covers the
+ * rules that only have to beat other stylesheets). Removing the flags brings the
+ * scrollbar back, so the plugin review's "avoid !important" note stays — this is
+ * the one place where it cannot be honoured. */
 .hearth-jot-live .cm-content,
 .hearth-jot-live .markdown-preview-sizer {
 	padding-bottom: 0 !important;
@@ -10810,6 +10832,51 @@ body.is-tablet button.hearth-gallery-icon-btn {
 	padding: 8px var(--hearth-card-pad-x);
 }
 
+/* ---- Flush spacing -------------------------------------------------- */
+
+/* The third step of the spacing setting. Flush is *compact minus the side and
+ * bottom gutters*: the board runs to the pane's left and right edges and its
+ * cards reach the bottom edge instead of stopping short, while the top of the
+ * page, the rhythm under the header and the padding inside cards keep the
+ * compact values — view.ts puts `.hearth-compact` on the root for flush too,
+ * so this block only has to say what is different.
+ *
+ * The width ceiling is the other half of "no side margin" and it lives in
+ * view.ts: the inner's `max-width` is not applied on a flush board, because a
+ * centred 1600px column leaves exactly the gutter this tier removes.
+ *
+ * Nothing else is zeroed. "Flush" on a board means no wasted margin where the
+ * pane ends, not a card with its title against the border: the first build of
+ * this tier dropped every inset and read as a clipped card, not as a choice.
+ *
+ * The space *between* cards is untouched as well: on the free-form board it is
+ * not a gap but part of each card's stored geometry (`GRID_GAP` in
+ * src/grid.ts), so zeroing it here would either do nothing (the cards are
+ * absolutely positioned) or, done properly, rewrite every saved position. See
+ * `BoardDensity` in types.ts.
+ *
+ * Written at the specificity of the compact rule rather than above it, so the
+ * narrow-board rule (which keeps the phone's safe-area bottom) still wins. */
+.hearth-flush.hearth-view,
+.hearth-flush .hearth-scroll,
+.hearth-flush .hearth-inner,
+.hearth-flush .hearth-dashboard,
+.hearth-flush .hearth-grid {
+	padding-left: 0;
+	padding-right: 0;
+}
+
+.hearth-flush .hearth-scroll {
+	--hearth-scroll-pad-x: 0px;
+	/* The page's own top gutter goes too: on a board whose first row is the
+	 * dashboard switcher it reads as a gap above the controls, not as breathing
+	 * room. The space *inside* the column — the header's gap and the gap between
+	 * the header and the cards — stays at the compact values. */
+	--hearth-scroll-pad-top: 0px;
+	padding-top: 0;
+	padding-bottom: 0;
+}
+
 /* ---- Calendar: week numbers & heatmap ------------------------------- */
 .hearth-calendar-wk {
 	display: flex;
@@ -11970,6 +12037,17 @@ body.hearth-dv-resizing {
 	object-fit: contain;
 }
 
+/* A note slide: the note's own rendering filling the card, scrolling on its own
+ * when the note is longer than the card. `box-sizing` because Hearth has no
+ * global border-box and the padding would otherwise push the content out. */
+.hearth-slide-note {
+	position: absolute;
+	inset: 0;
+	box-sizing: border-box;
+	overflow: auto;
+	padding: 1rem 1.25rem;
+}
+
 /* Crossfade */
 .hearth-slideshow.is-trans-fade > .hearth-slide.is-in-next,
 .hearth-slideshow.is-trans-fade > .hearth-slide.is-in-prev {
@@ -12249,6 +12327,17 @@ body.hearth-dv-resizing {
 	cursor: pointer;
 }
 
+/* A card that was given its own grid colour (#430): the same fade, its own hue.
+ * `heatTint()` sets `--heat-color` and `has-tint` on the wrap, so a card with no
+ * colour never reaches this rule and paints exactly as it always has. */
+.hearth-heatmap.has-tint .hearth-heatmap-cell.has-heat {
+	background-color: color-mix(
+		in srgb,
+		var(--heat-color) calc(15% + var(--heat, 0) * 21.25%),
+		transparent
+	);
+}
+
 .hearth-heatmap-legend {
 	display: flex;
 	align-items: center;
@@ -15801,6 +15890,15 @@ body.hearth-dv-resizing {
