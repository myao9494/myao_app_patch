 note",">toggle"]}},features:{...A.search.tips.features,calc:{title:"\uACC4\uC0B0\uAE30",desc:"\uD569\uACC4, \uBC31\uBD84\uC728, \uB2E8\uC704 \uBCC0\uD658\uACFC \uC9C4\uBC95 \uACC4\uC0B0\uC744 \uD569\uB2C8\uB2E4. =\uC73C\uB85C \uC2DC\uC791\uD558\uBA74 \uACC4\uC0B0\uC744 \uAC15\uC81C\uD569\uB2C8\uB2E4.",examples:["1+1","20% of 150","10 km to mi","FF hex to decimal"]},currency:{title:"\uD1B5\uD654",desc:"\uC624\uB298 \uD658\uC728\uB85C \uBCC0\uD658\uD558\uACE0 \uB450 \uD1B5\uD654\uC758 \uCC28\uD2B8\uB97C \uD655\uC778\uD569\uB2C8\uB2E4.",examples:["20 CZK to EUR","100 euros in dollars","eur/usd"]},market:{title:"\uC8FC\uC2DD, \uD380\uB4DC, \uAC00\uC0C1\uC790\uC0B0",desc:"\uC2E4\uC2DC\uAC04 \uC2DC\uC138\uC640 \uCC28\uD2B8\uB97C \uBD05\uB2C8\uB2E4. $ \uAE30\uD638\uB098 \uC8FC\uC2DD, \uAC00\uACA9 \uAC19\uC740 \uB2E8\uC5B4\uB97C \uC0AC\uC6A9\uD558\uC138\uC694.",examples:["$AAPL","apple stock","bitcoin price"]},weather:{title:"\uB0A0\uC528",desc:"\uC5B4\uB514\uC11C\uB4E0 \uD604\uC7AC \uB0A0\uC528\uC640 \uBA70\uCE60 \uB4A4 \uC608\uBCF4\uB97C \uD655\uC778\uD569\uB2C8\uB2E4.",examples:["weather Prague","london forecast"]},wiki:{title:"\uC704\uD0A4\uBC31\uACFC",desc:"\uBB38\uC11C \uC694\uC57D\uC744 \uD655\uC778\uD569\uB2C8\uB2E4. :ko, :de\uCC98\uB7FC \uC5B8\uC5B4 \uCF54\uB4DC\uB97C \uBD99\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4.",examples:["wiki Alan Turing","wiki:de Prag"]},chance:{title:"\uB3D9\uC804, \uC8FC\uC0AC\uC704, \uB09C\uC218",desc:"\uB3D9\uC804 \uB358\uC9C0\uAE30, \uC8FC\uC0AC\uC704 \uAD74\uB9AC\uAE30, \uB09C\uC218\uB97C \uBF51\uC2B5\uB2C8\uB2E4.",examples:["coin flip","roll 2d6","random 1-10"]},date:{title:"\uB0A0\uC9DC",desc:"\uB0A0\uC9DC \uC0AC\uC774\uC758 \uC77C\uC218\uC640 \uB0A0\uC9DC \uACC4\uC0B0\uC744 \uD569\uB2C8\uB2E4.",examples:["days until 2026-12-24","today + 45 days","next friday"]},time:{title:"\uB2E4\uB978 \uC9C0\uC5ED\uC758 \uC2DC\uAC04",desc:"\uB3C4\uC2DC\uC758 \uD604\uC7AC \uC2DC\uAC01\uACFC \uC774\uACF3\uACFC\uC758 \uC2DC\uCC28\uB97C \uD655\uC778\uD