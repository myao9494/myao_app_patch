"\uBC24\uC0D8 \uC791\uC5C5 \uC911\uC774\uC2E0\uAC00\uC694?","\uBCF4\uAD00\uD568\uC740 \uC7A0\uB4E4\uC9C0 \uC54A\uB294\uAD70\uC694.","\uC774\uC81C \uC7A0\uC790\uB9AC\uC5D0 \uB4E4 \uC2DC\uAC04 \uC544\uB2D0\uAE4C\uC694?"],["\uC774\uB807\uAC8C \uC77C\uCC0D\uBD80\uD130 \uC791\uC5C5\uD558\uC2DC\uB098\uC694?","\uD574 \uB730 \uB54C \uC77C\uC5B4\uB098\uC168\uB124\uC694.","\uC6B0\uC120 \uCEE4\uD53C \uD55C \uC794 \uC5B4\uB5A0\uC138\uC694?","\uC77C\uCC0D \uC77C\uC5B4\uB098\uC168\uAD70\uC694."],["\uC88B\uC740 \uC544\uCE68\uC785\uB2C8\uB2E4. \uC0DD\uC0B0\uC801\uC778 \uD558\uB8E8\uC778 \uCC99\uD574 \uBCFC\uAE4C\uC694?","\uB178\uD2B8\uAC00 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uC5B4\uC694.","\uB2E4\uC2DC \uC2DC\uC791\uD574 \uBD05\uC2DC\uB2E4.","\uC0C8\uB85C\uC6B4 \uD558\uB8E8, \uC0C8\uB85C\uC6B4 \uBCF4\uAD00\uD568\uC774\uB124\uC694."],["\uC624\uD6C4 \uC791\uC5C5 \uC2DC\uAC04\uC785\uB2C8\uB2E4.","\uC544\uC9C1 \uC791\uC5C5 \uC911\uC774\uC138\uC694?","\uC810\uC2EC \uB4A4\uC758 \uC0DD\uC0B0\uC131\uC774\uB77C\uB2C8 \uB300\uB2E8\uD558\uB124\uC694.","\uC544\uB9C8 \uC808\uBC18\uCBE4 \uC654\uACA0\uC8E0."],["\uB610 \uC624\uC168\uB124\uC694?","\uC800\uB141\uC785\uB2C8\uB2E4. \uB9C8\uBB34\uB9AC \uC911\uC778\uAC00\uC694, \uC774\uC81C \uC2DC\uC791\uC778\uAC00\uC694?","\uB178\uD2B8\uB97C \uD558\uB098\uB9CC \uB354 \uBCFC\uAE4C\uC694?","\uD558\uB8E8\uB294 \uC800\uBB3C\uC5B4 \uAC00\uB294\uB370 \uC544\uC9C1 \uAE68\uC5B4 \uACC4\uC2DC\uB124\uC694."],["\uB610 \uB2A6\uC740 \uC2DC\uAC04\uAE4C\uC9C0 \uACC4\uC2DC\uB124\uC694.","\uD558\uB8E8\uB294 \uB05D\uB098\uB3C4 \uC544\uC774\uB514\uC5B4\uB294 \uACC4\uC18D\uB418\uC8E0.","\uC774\uC81C \uC26C\uC5B4\uC57C \uD558\uC9C0 \uC54A\uC744\uAE4C\uC694?","\uBC24\uB0AE\uC5C6\uC774 \uC791\uC5C5\uD558\uACE0 \uACC4\uC2DC\uB124\uC694."]]},templates:{...A.templates,note:"\uC0BD\uC785\uB41C \uB178\uD2B8",image:"\uC0BD\uC785\uB41C \uC774\uBBF8\uC9C0",slideshow:"\uC2AC\uB77C\uC774\uB4DC \uC1FC",base:"\uC0BD\uC785\uB41C Base",excalidraw:"Excalidraw \uADF8\uB9BC",canvas:"\uC0BD\