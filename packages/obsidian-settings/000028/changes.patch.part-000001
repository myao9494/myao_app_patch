,omnisearch:{name:"Omnisearch",desc:"\u628A\u641C\u5C0B\u5217\u5207\u63DB\u5230 Omnisearch \u7684\u6A21\u7CCA\u5168\u6587\u7D22\u5F15\uFF0C\u53D6\u4EE3 Hearth \u7684\u5167\u5EFA\u5F15\u64CE\u3002\u8ACB\u5728 \u641C\u5C0B \u2192 \u641C\u5C0B\u5217 \u4E0B\u9078\u64C7\u5F15\u64CE\uFF1B\u8A72\u9078\u64C7\u50C5\u5728 Omnisearch \u555F\u7528\u6642\u4FDD\u6301\u6709\u6548\u3002"},tasknotes:{name:"TaskNotes",desc:"\u8B93\u4EFB\u52D9\u5361\u7247\u8B80\u53D6 TaskNotes\u300C\u4E00\u4EFB\u52D9\u4E00\u7B46\u8A18\u300D\u7684\u5132\u5B58\u5EAB\u2014\u2014\u72C0\u614B\u3001\u5230\u671F\u65E5\u548C\u512A\u5148\u9806\u5E8F\u76F4\u63A5\u4F86\u81EA frontmatter\u3002"},dataview:{name:"Dataview",desc:"Dataview \u5361\u7247\u57F7\u884C DQL \u67E5\u8A62\u548C DataviewJS \u7A0B\u5F0F\u78BC\u5340\u584A\uFF0C\u4F7F\u7528 Dataview \u81EA\u5DF1\u7684\u8F49\u8B6F\u5668\u5448\u73FE\uFF0C\u4E26\u96A8\u5176\u7D22\u5F15\u8B8A\u5316\u91CD\u65B0\u6574\u7406\u3002"},datacore:{name:"Datacore",desc:"Dataview \u7684\u5F8C\u7E7C\u8005\u3002Datacore \u5361\u7247\u57F7\u884C Datacore \u67E5\u8A62\u2014\u2014\u6216 JS/JSX/TS/TSX \u6307\u4EE4\u78BC\u2014\u2014\u4E26\u7528 Datacore \u81EA\u5DF1\u7684\u5373\u6642\u6AA2\u8996\u8F49\u8B6F\u3002"},templater:{name:"Templater",desc:"\u300C\u5F9E\u7BC4\u672C\u65B0\u589E\u7B46\u8A18\u300D\u5361\u7247\u628A\u60A8\u7684 Templater \u7BC4\u672C\u8B8A\u6210\u6309\u9215\uFF1A\u6BCF\u500B\u5716\u78DA\u651C\u5E36\u81EA\u5DF1\u7684\u7BC4\u672C\u3001\u76EE\u6A19\u8CC7\u6599\u593E\u548C\u6A94\u540D\u683C\u5F0F\uFF0C\u4E00\u9375\u5373\u53EF\u5EFA\u7ACB\u7B46\u8A18\u3002\u7BC4\u672C\u8655\u7406\u7531 Templater \u5B8C\u6210\u2014\u2014\u60A8\u7684\u4F7F\u7528\u8005\u6307\u4EE4\u78BC\u3001tp.system.prompt() \u5C0D\u8A71\u6846\u548C\u6E38\u6A19\u5B9A\u4F4D\u7684\u884C\u70BA\u90FD\u8207\u5F9E\u5B83\u81EA\u5DF1\u7684\u547D\u4EE4\u547C\u53EB\u6642\u4E00\u81F4\u3002"},periodicNotes:{name:"Periodic Notes",desc:"\u300C\u9031\u671F\u7B46\u8A18\u300D\u5361\u7247\u986F\u793A\u672C\u9031\u3001\u672C\u6708\u3001\u672C\u5B63\u6216\u4ECA\u5E74\u7684\u7B46\u8A18\u2014\u2014\u5B9A\u4F4D\u7531 Periodic Notes \u5B8C\u6210\uFF0C\u7F3A\u5C11\u7684\u7B46\u8A18\u4E5F\u7531\u5B83\u4F9D\u60A8\u81EA\u5DF1\u7684\u7BC4\u672C\u5EFA\u7ACB\u3002"},journals:{name:"Journals",desc:"\u540C\u4E00\u5F35\u5361\u7247\u4E5F\u53EF\u4EE5\u8B80\u53D6 Journals\uFF1A\u9078\u64C7\u60A8\u7684\u67D0\u500B\u65E5\u8A8C\uFF0C\u5B83\u5C31\u6703\u986F\u793A\u8A72\u65E5\u8A8C\u76EE\u524D\u9031\u671F\u7684\u7B46\u8A18\u2014\u2014\u5B9A\u4F4D\u8207\u5EFA\u7ACB\u90FD\u900F\u904E Journals \u5916\u639B\u81EA\u8EAB\u7684 API \u5B8C\u6210\uFF0C\u6CBF\u7528\u5B83\u7684\u7BC4\u672C\u8207\u5EFA\u7ACB\u63D0\u554F\u3002"},git:{name:"Git",desc:"Git \u5361\u7247\u986F\u793A Git \u5132\u5B58\u5EAB\u7684\u5206\u652F\u3001\u8B8A\u66F4\u548C\u6700\u8FD1\u63D0\u4EA4\uFF0C\u4E26\u900F\u904E Git \u5916\u639B\u672C\u8EAB\u9032\u884C\u63D0\u4EA4\u3001\u540C\u6B65\u3001\u63A8\u9001\u548C\u62C9\u53D6\u2014\u2014\u5B83\u7684\u9060\u7AEF\u3001\u6191\u8B49\u548C\u63D0\u4EA4\u8A0A\u606F\u7BC4\u672C\u90FD\u539F\u6A23\u9069\u7528\u3002"},operon:{name:"Operon",desc:"Operon \u5361\u7247\u2014\u2014\u4EFB\u52D9\u3001\u770B\u677F\u3001\u884C\u7A0B\u548C\u8A08\u6642\u5668\u2014\u2014\u900F\u904E Operon \u81EA\u5DF1\u7684\u958B\u767C\u8005 API \u8B80\u53D6\u8CC7\u6599\uFF0C\u56E0\u6B64\u72C0\u614B\u3001\u512A\u5148\u9806\u5E8F\u548C\u91CD\u8907\u898F\u5247\u4ECD\u7531\u5B83\u5B9A\u7FA9\u3002\u50C5\u684C\u9762\u7248\uFF0C\u9700\u8981 Obsidian 1.12.2 \u6216\u66F4\u65B0\u7248\u672C\uFF0C\u4E14 Operon \u5FC5\u9808\u6838\u51C6 Hearth \u7684\u8B80\u53D6\u8ACB\u6C42\u3002"},iconic:{name:"Iconic",desc:"\u7528 Iconic \u8A2D\u5B9A\u7684\u500B\u5225\u6A94\u6848\u5716\u793A\u6703\u51FA\u73FE\u5728 Hearth \u5217\u51FA\u6A94\u6848\u7684\u4EFB\u4F55\u4F4D\u7F6E\u2014\u2014\u6700\u8FD1\u3001\u6211\u7684\u6700\u611B\u3001\u5DF2\u5132\u5B58\u641C\u5C0B\u548C\u641C\u5C0B\u7D50\u679C\u3002"},iconize:{name:"Iconize",desc:"\u5C0D Iconize\uFF08\u539F Obsidian Icon Folder\uFF09\u540C\u6A23\u9069\u7528\uFF0C\u5305\u62EC\u900F\u904E frontmatter \u5C6C\u6027\u8A2D\u5B9A\u7684\u5716\u793A\u3002"},frontMatterTitle:{name:"Front Matter Title",desc:"\u8CC7\u6599\u593E\u5361\u7247\u548C\u8CC7\u6599\u593E\u700F\u89BD\u9801\u6703\u7528 Front Matter Title \u5728\u6A94\u6848\u6E05\u55AE\u4E2D\u986F\u793A\u7684\u6A19\u984C\u4F86\u5217\u51FA\u7B46\u8A18\uFF0C\u800C\u4E0D\u662F\u6A94\u540D\u3002"},vaultPet:{name:"Vault Pet",desc:"Vault Pet \u5361\u7247\u628A\u8A72\u5916\u639B\u5B89\u7F6E\u5728\u60A8\u7684\u5100\u8868\u677F\u4E0A\uFF1A\u65E2\u53EF\u4EE5\u662F\u5B83\u81EA\u5DF1\u7684\u5BF5\u7269\u5361\u7247\uFF0C\u6D3B\u751F\u751F\u4E14\u53EF\u9EDE\u64CA\uFF0C\u4E5F\u53EF\u4EE5\u662F\u5B83\u5B8C\u6574\u7684\u5C0F\u5C4B\uFF0C\u542B\u4EFB\u52D9\u3001\u5716\u9451\u3001\u5FBD\u7AE0\u8207\u7D71\u8A08\u3002\u5BF5\u7269\u3001\u7D93\u9A57\u4EE5\u53CA\u89E3\u9396\u7684\u4E00\u5207\u90FD\u5C6C\u65BC Vault Pet\uFF0CHearth \u53EA\u63D0\u4F9B\u7A7A\u9593\u3002"},excalidraw:{name:"Excalidraw",desc:"\u5D4C\u5165\u5361\u7247\u53EF\u5373\u6642\u8F49\u8B6F Excalidraw \u7E6A\u5716\uFF0C\u300C\u65B0\u589E\u7E6A\u5716\u300D\u64CD\u4F5C\u5247\u900F\u904E Excalidraw \u81EA\u5DF1\u7684\u547D\u4EE4\u5EFA\u7ACB\u3002"},bases:{name:"Bases",desc:"\u5D4C\u5165\u5361\u7247\u53EF\u4EE5\u5728\u5100\u8868\u677F\u4E0A\u986F\u793A Bases\uFF08.base\uFF09\u6AA2\u8996\u3002"},canvas:{name:"\u767D\u677F",desc:"\u5D4C\u5165\u5361\u7247\u53EF\u4EE5\u986F\u793A\u767D\u677F\uFF0C\u53EF\u4E92\u52D5\u4E14\u92EA\u6EFF\u6574\u5F35\u5361\u7247\u3002"},dailyNotes:{name:"\u65E5\u8A18",desc:"\u65E5\u8A18\u3001\u8FF7\u4F60\u884C\u4E8B\u66C6\u548C\u5132\u5B58\u5EAB\u7D71\u8A08\u5361\u7247\u6703\u4F9D\u64DA\u65E5\u8A18\u5916\u639B\u81EA\u5DF1\u7684\u8CC7\u6599\u593E\u3001\u65E5\u671F\u683C\u5F0F\u548C\u7BC4\u672C\u4F86\u5B9A\u4F4D\u4ECA\u5929\u7684\u7B46\u8A18\u3002"},bookmarks:{name:"\u66F8\u7C64",desc:"\u66F8\u7C64\u5361\u7247\u5217\u51FA\u60A8\u7684 Obsidian \u66F8\u7C64\uFF0C\u7FA4\u