560 \uC774\uBAA8\uC9C0, \uC9E7\uC740 \uBB38\uC790, Lucide \uC544\uC774\uCF58 ID, \uBCF4\uAD00\uD568 \uC774\uBBF8\uC9C0 \uACBD\uB85C \uB610\uB294 \uC774\uBBF8\uC9C0 URL\uC785\uB2C8\uB2E4. \uBE44\uC6CC \uB450\uBA74 Hearth \uD06C\uB9AC\uC2A4\uD138\uC744 \uC0AC\uC6A9\uD569\uB2C8\uB2E4.",themeColor:"\uD14C\uB9C8 \uAC15\uC870 \uC0C9\uC0C1 \uC0AC\uC6A9",themeColorDesc:"\uBE0C\uB79C\uB4DC \uD45C\uC2DC\uC758 \uC5B4\uB290 \uBD80\uBD84\uC5D0 \uD14C\uB9C8 \uC0C9\uC0C1\uC744 \uC801\uC6A9\uD560\uC9C0 \uC120\uD0DD\uD569\uB2C8\uB2E4.",themeColorOptions:{none:"\uC0AC\uC6A9 \uC548 \uD568",icon:"\uC544\uC774\uCF58",title:"\uC81C\uBAA9",both:"\uBAA8\uB450"},showSearch:"\uAC80\uC0C9\uCC3D \uD45C\uC2DC",showSearchDesc:"\uC81C\uBAA9 \uC544\uB798\uC5D0 \uAC80\uC0C9 \uBC0F \uBA85\uB839 \uC785\uB825\uB780\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4."},look:{...M.setup.look,designHeading:"\uB514\uC790\uC778",designNote:"\uC774 \uC124\uC815\uC740 \uD604\uC7AC \uBCF4\uB4DC\uBFD0 \uC544\uB2C8\uB77C Hearth \uC804\uCCB4\uC5D0 \uC801\uC6A9\uB429\uB2C8\uB2E4. \uC124\uC815 \u2192 Hearth \u2192 \uBAA8\uC591\uC5D0\uC11C \uC5B8\uC81C\uB4E0 \uBCC0\uACBD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.",terminalNote:"\uD130\uBBF8\uB110 \uBAA8\uB4DC\uB294 \uBAA8\uB4E0 \uBCF4\uB4DC\uC5D0 \uC801\uC6A9\uB429\uB2C8\uB2E4. \uBC30\uACBD\uD654\uBA74\uACFC \uCE74\uB4DC \uD45C\uBA74\uC744 \uADF8\uB9AC\uC9C0 \uC54A\uB294 \uC2E4\uD5D8\uC801 \uAE30\uB2A5\uC785\uB2C8\uB2E4. \uC124\uC815 \u2192 Hearth \u2192 \uBAA8\uC591\uC5D0\uC11C \uB04C \uC218 \uC788\uC2B5\uB2C8\uB2E4.",surfaceHeading:"\uCE74\uB4DC",backgroundHeading:"\uBC30\uACBD",color:"\uC0C9\uC0C1",colorDesc:"\uBCF4\uB4DC \uB4A4\uC5D0 \uD45C\uC2DC\uD560 \uB2E8\uC0C9\uC785\uB2C8\uB2E4.",weatherDesc:"\uC120\uD0DD\uD55C \uC9C0\uC5ED\uC758 \uC2E4\uC2DC\uAC04 \uD558\uB298 \uB610\uB294 \uACE0\uC815\uB41C \uB0A0\uC528\uB97C \uD45C\uC2DC\uD569\uB2C8\uB2E4.",layout:"\uBC30\uACBD \uBC30\uCE58",layoutDesc:"\uBCF4\uB4DC \uC804\uCCB4 \uBC30\uACBD\uC774\uB098 \uC0C1\uB2E8 \uBC30\uB108\uB85C \u