p.designs.terminal,name:"\uD130\uBBF8\uB110",desc:"\uBB38\uC790 \uACA9\uC790\uC640 \uC0C1\uC790\uD615 \uCE74\uB4DC, \uD0A4\uBCF4\uB4DC \uC870\uC791\uC73C\uB85C \uBCF4\uB4DC\uB97C \uD45C\uC2DC\uD569\uB2C8\uB2E4. \uC2E4\uD5D8\uC801 \uAE30\uB2A5\uC774\uBA70 \uC77C\uBD80 \uCE74\uB4DC\uB294 \uC774\uBBF8\uC9C0\uB85C \uD45C\uC2DC\uB429\uB2C8\uB2E4."}},backgrounds:{...A.setup.backgrounds,default:{...A.setup.backgrounds.default,name:"Hearth \uBC30\uACBD\uD654\uBA74",desc:"\uD14C\uB9C8\uC5D0 \uB9DE\uCDB0 \uB0AE\uC774\uB098 \uBC24\uC73C\uB85C \uD45C\uC2DC\uD558\uB294 Hearth \uC81C\uC791 \uC5B8\uB355 \uBC30\uACBD\uC785\uB2C8\uB2E4."},harbour:{...A.setup.backgrounds.harbour,name:"\uD56D\uAD6C \uB9C8\uC744",desc:"\uAC15\uC870 \uC0C9\uC0C1\uC758 Expressive \uB3C4\uD615\uC73C\uB85C \uB4F1\uB300, \uBC30, \uC5B8\uB355 \uC704 \uC9D1\uC744 \uADF8\uB9BD\uB2C8\uB2E4."},weather:{...A.setup.backgrounds.weather,name:"\uC2E4\uC2DC\uAC04 \uD558\uB298",desc:"\uD604\uC7AC \uC9C0\uC5ED\uC758 \uB0A0\uC528\uB97C \uADF8\uB9B0 \uD558\uB298 \uB610\uB294 \uC9C1\uC811 \uACE0\uC815\uD55C \uD558\uB298\uC785\uB2C8\uB2E4."},color:{...A.setup.backgrounds.color,name:"\uB2E8\uC0C9",desc:"\uC774\uBBF8\uC9C0 \uC5C6\uC774 \uD55C \uAC00\uC9C0 \uC0C9\uC0C1\uB9CC \uC0AC\uC6A9\uD569\uB2C8\uB2E4."},none:{...A.setup.backgrounds.none,name:"\uC5C6\uC74C",desc:"\uD14C\uB9C8\uC758 \uAE30\uBCF8 \uBC30\uACBD\uC744 \uADF8\uB300\uB85C \uC0AC\uC6A9\uD569\uB2C8\uB2E4."}},purposes:{...A.setup.purposes,daily:{name:"\uB370\uC77C\uB9AC \uB178\uD2B8\uC640 \uC77C\uAE30",desc:"\uC624\uB298\uC758 \uB178\uD2B8\uB97C \uC911\uC2EC\uC5D0 \uD45C\uC2DC\uD558\uACE0 \uB2EC\uB825\uC73C\uB85C \uB0A0\uC9DC\uB97C \uC774\uB3D9\uD569\uB2C8\uB2E4."},tasks:{name:"\uC791\uC5C5\uACFC \uD560 \uC77C",desc:"\uBCF4\uAD00\uD568 \uCCB4\uD06C\uBC15\uC2A4\uB098 \uC791\uC5C5 \uD50C\uB7EC\uADF8\uC778\uC758 \uC791\uC5C5 \uBAA9\uB85D\uC785\uB2C8\uB2E4."},planning:{name:"\uACC4\uD68D\uACFC \uCE98\uB9B0\uB354",desc:"\uAD6C\uB3C5 \uD53C\uB4DC\uB97C \uD3EC\uD568\uD55C \uC6D4\xB7\uC8FC\xB7\uC77C \uCE98\uB9B0\uB354\uC785\uB2C8\uB2E4."},browsing:{name:"\uB178\uD2B8 \uCC3E\uAE30",desc:"\uCD5C\uADFC\uC5D0 \uC5F0 \uD56D\uBAA9\uACFC \uC990\uACA8\uCC3E\uAE30 \uBAA8\uC74C\uC785\uB2C8\uB2E4."},capture:{name:"\uBE60\uB978 \uAE30\uB85D\uACFC \uC2E4\uD589",desc:"\uC0C8 \uB178\uD2B8, \uAC80\uC0C9, \uBA85\uB839 \uD314\uB808\uD2B8 \uB4F1\uC758 \uBE60\uB978 \uC791\uC5C5\uC785\uB2C8\uB2E4."},insights:{name:"\uBCF4\uAD00\uD568 \uD1B5\uACC4",desc:"\uBCF4\uAD00\uD568 \uD06C\uAE30\uC640 \uC0AC\uC6A9 \uD65C\uB3D9\uC744 \uBCF4\uC5EC\uC90D\uB2C8\uB2E4."},reading:{name:"\uC77D\uAE30\uC640 \uD53C\uB4DC",desc:"\uAD6C\uB3C5 \uC911\uC778 \uC0AC\uC774\uD2B8\uC758 RSS \uCE74\uB4DC\uC785\uB2C8\uB2E4."},ambience:{name:"\uBD84\uC704\uAE30",desc:"\uD604\uC7AC \uC9C0\uC5ED\uC758 \uB0A0\uC528\uC640 \uBCF4\uB4DC\uC5D0 \uD568\uAED8\uD558\uB294 \uC791\uC740 \uD3AB\uC785\uB2C8\uB2E4."}},purpose:{...A.setup.purpose,count:e=>`\uD604\uC7AC \uCE74\uB4DC ${e}\uAC1C`,integrationsHeading:"\uBCF4\uAD00\uD568\uC5D0\uC11C \uBC1C\uACAC\uD55C \uC5F0\uB3D9",feed:"\uAD6C\uB3C5\uD560 \uD53C\uB4DC",feedDesc:"\uC77D\uACE0 \uC2F6\uC740 \uC0AC\uC774\uD2B8\uC758 RSS \uB610\uB294 Atom \uC8FC\uC18C\uC785\uB2C8\uB2E4. \uCE74\uB4DC\uC5D0\uC11C \uB354 \uCD94\uAC00\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.",feedMissing:"\uD53C\uB4DC \uC8FC\uC18C\uB97C \uCD94\uAC00\uD558\uBA74 \uC77D\uAE30 \uCE74\uB4DC\uAC00 \uBCF4\uB4DC\uC5D0 \uD3EC\uD568\uB429\uB2C8\uB2E4.",weatherPlace:"\uB0A0\uC528 \uC704\uCE58",weatherMissing:"\uC9C0\uC5ED\uC744 \uC120\uD0DD\uD558\uBA74 \uB0A0\uC528 \uCE74\uB4DC\uAC00 \uBCF4\uB4DC\uC5D0 \uD3EC\uD568\uB429\uB2C8\uB2E4."},integrations:{...A.setup.integrations,lead:"\uC5EC\uAE30\uC11C \uD65C\uC131\uD654\uD558\uB294 \uAC01 \uD56D\uBAA9\uC740 \uD604\uC7AC \uBCF4\uB4DC\uC5D0 \uB9DE\uAC8C \uAD6C\uC131\uB41C \uCE74\uB4DC\uB97C \uCD94\uAC00\uD569\uB2C8\uB2E4. \uB2E4\uB978 \uD50C\uB7EC\uADF8\uC778\uC744 \uC124\uCE58\uD558\uAC70\uB098 \uBCC0\uACBD\uD558\uC9C0 \uC54A\uC73C\uBA70 \uC774 \uB3