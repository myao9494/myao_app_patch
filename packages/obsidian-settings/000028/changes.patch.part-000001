=markiert==","Hervorhebung"],["`Code`","Code in der Zeile"],["[[Notiz]]","Link auf eine Notiz"],["[Seite](https://example.com)","Weblink"],["#tag","Tag"]],failsItems:[["# \xDCberschrift","\xDCberschriften"],["- [ ] Schritt","Checkboxen \u2013 sie werden zur Unteraufgabe"],["> Zitat","Zitate"],["```","Codebl\xF6cke"],["| a | b |","Tabellen"],["![[bild.png]]","Einbettungen und Bilder"],["  einger\xFCckt","Einr\xFCckung \u2013 Zeilen werden flach"]],issues:{heading:"\xDCberschriften bleiben nicht \u2013 sie erscheint als Text mit #.",checkbox:"eine Checkbox macht die Zeile zur Unteraufgabe statt zur Beschreibung.",quote:"Zitate bleiben nicht \u2013 sie erscheint als Text mit >.",codeblock:"Codebl\xF6cke bleiben nicht \u2013 jede Zeile wird ein eigener Punkt.",table:"Tabellen bleiben nicht \u2013 jede Zeile wird ein eigener Punkt.",rule:"eine Trennlinie erscheint als einfache Striche.",embed:"Einbettungen erscheinen als Linktext, nicht als Bild oder Notiz.",indent:"die Einr\xFCckung entf\xE4llt \u2013 alle Zeilen stehen auf einer Ebene."},issueLine:(e,t)=>`Zeile ${e}: ${t}`,moreIssues:e=>`\u2026und ${e} weitere`},createNote:"Notiz erstellen",createNoteSaveFirst:"Erst die \xC4nderungen speichern \u2013 das Erstellen der Notiz schreibt die Aufgabe aus der Datei neu.",createNoteDefaultFolder:"dem Standardordner",createNoteTooltip:e=>`Aus dieser Aufgabe eine Notiz in ${e} machen und hier verlinken`,createNoteTooltipTemplate:(e,t)=>`Aus dieser Aufgabe eine Notiz in ${e} aus ${t} machen und hier verlinken`,matrix:{do:"Erledigen",schedule:"Planen",delegate:"Delegieren",eliminate:"Streichen",urgent:"Dringend",notUrgent:"Nicht dringend",important:"Wichtig",notImportant:"Nicht wichtig",unsorted:"Nicht zugeordnet",unsortedHint:"Kein Quadrant enth\xE4lt ihre Priorit\xE4t \u2013 in die Matrix ziehen",empty:"Aufgaben hier ablegen",moveTo:e=>`Verschieben nach ${e}`,renameHint:"Doppelklick zum Umbenennen"},tags:"Tags",tagsPlaceholder:"#arbeit #zuhause/besorgungen",renameColumnHint:"Doppelklicken zum Umbenennen",editTitle:"Titel bearbeiten",editTitleHint:"Doppelklicken zum Bearbeiten",titlePlaceholder:"Kartentitel\u2026",priority:"Priorit\xE4t",priorityNone:"Keine Priorit\xE4t",priorityHighest:"H\xF6chste Priorit\xE4t",priorityHigh:"Hohe Priorit\xE4t",priorityMedium:"Mittlere Priorit\xE4t",priorityLow:"Niedrige Priorit\xE4t",priorityLowest:"Niedrigste Priorit\xE4t",sort:"Sortieren",sortReverse:"Reihenfolge umkehren",sortLabels:{smart:"Smart",due:"F\xE4lligkeitsdatum",priority:"Priorit\xE4t",created:"Erstelldatum",alpha:"Alphabetisch"},sortCustom:"Benutzerdefiniert",sortCustomOption:"Benutzerdefiniert sortieren\u2026",sortTitle:"Benutzerdefinierte Sortierung",sortHint:"Sortiere Aufgaben nach diesen Regeln der Reihe nach - die erste ist die Hauptsortierung, jede weitere entscheidet bei Gleichstand.",sortFields:{due:"F\xE4lligkeitsdatum",scheduled:"Geplantes Datum",priority:"Priorit\xE4t",created:"Erstelldatum",alpha:"Alphabetisch",status:"Status"},sortAscending:"Aufsteigend",sortDescending:"Absteigend",sortLevelFirst:"Sortieren nach",sortLevelNext:"dann nach",sortAddRule:"Regel hinzuf\xFCgen",sortRemoveRule:"Regel entfernen",sortMoveUp:"Nach oben",sortMoveDown:"Nach unten",sortEmpty:"Noch keine Regeln - f\xFCge eine hinzu, sonst gilt die Standard-Sortierung Smart.",filter:"Filter",filterTitle:"Aufgaben filtern",filterPresets:{overdue:"\xDCberf\xE4llig",today:"Heute",week:"Diese Woche",highPriority:"Hohe Priorit\xE4t",noDate:"Kein Datum"},filterDue:"Datum",filterDueDesc:"Trifft auf F\xE4lligkeits- oder geplantes Datum einer Aufgabe zu.",filterDueAny:"Beliebig",filterDueHasDate:"Hat ein Datum",filterPriority:"Priorit\xE4t",filterPriorityLevels:{high:"Hoch",medium:"Mittel",low:"Niedrig",none:"Keine"},filterStatus:"Status",filterContexts:"Kontexte",filterProjects:"Projekte",filterTags:"Tags",filterText:"Text enth\xE4lt",filterTextPlaceholder:"Aufgabentext suchen\u2026",filterApply:"Anwenden",filterClear:"Zur\xFCcksetzen",valueChange:"Wert \xE4ndern",dateTitle:"Datum festlegen",dateOn:"Datum",dateToday:"Heute",dateTomorrow:"Morgen",dateNextWeek:"N\xE4chste Woche",dateClear:"Datum l\xF6schen",valueCustom:"Anderer Wert\u2026",valueCustomTitle:"Wert festlegen",valueClear:"Wert l\xF6schen"}},dates:{today:"Heute",tomorrow:"Morgen",yesterday:"Gestern",daysAgo:e=>`vor ${e} Tagen`,nextWeekday:e=>`N\xE4chsten ${e}`,lastWeekday:e=>`Letzten ${e}`},recurrence:{repeats:"Wiederholt sich",units:{day:"Tag",week:"Woche",month:"Monat",year:"Jahr"},everyOne:e=>`Wiederholt sich ${nU[e]??`pro ${e}`}`,everyMany:(e,t)=>`Wiederholt sich alle ${e} ${tU(t)}`},clock:{greetingMorning:"Guten Morgen",greetingAfternoon:"Guten Nachmittag",greetingEvening:"Guten Abend",playfulGreetings:[["Noch wach?","Brennst du noch Mitternachts\xF6l?","Der Vault schl\xE4ft nie, was?","Du solltest wahrscheinlich schlafen."],["Schon so fr\xFCh am Arbeiten?","Mit der Sonne aufgestanden, was?","Erst mal Kaffee, oder?","Mutig, schon wach zu sein."],["Morgen. Tun wir mal so, als w\xE4ren wir produktiv.","Die Notizen haben dich vermisst.","Weiter geht's.","Neuer Tag, neuer Vault."],["Der Nachmittagstrott.","Immer noch dabei?","Produktiv nach dem Mittagessen - ehrgeizig.","Halb geschafft, wahrscheinlich."],["Du schon wieder?","Abend. H\xF6rst du auf oder f\xE4ngst du erst an?","Noch eine Notiz, dann?","Der Tag klingt aus. Du nicht."],["Schon wieder sp\xE4t?","Der Tag ist vorbei, die Ideen nicht.","Solltest du dich nicht ausruhen?","Du brennst die Kerze an beiden Enden ab."]]},templates:{music:"Musik","music-stereo":"Musik (Stereo)",note:"Eingebettete Notiz",image:"Eingebettetes Bild",slideshow:"Diashow","slideshow-notes":"Notizen-Diashow",base:"Eingebettete Base",excalidraw:"Excalidraw-Zeichnung",canvas:"Eingebettetes Canvas",daily:"Tagesnotiz (heute)",periodic:"Periodische Notiz",journal:"Journalnotiz",web:"Webseite (iframe)",bookmarks:"Lesezeichen",favorites:"Favoriten",recent:"Zuletzt verwendete Dateien",folder:"Ordner",links:"Links / Zentrale",templater:"Neue Notiz aus Vorlage",clock:"Uhr & Begr\xFC\xDFung",tasks:"Aufgaben",calendar:"Minikalender",schedule:"Kalender",stats:"Vault-Statistiken",search:"Abfrage",searchbar:"Suchleiste",heatmap:"Aktivit\xE4tskarte",text:"Text / Kurznotiz",calculator:"Rechner",dataview:"Dataview-Abfrage",datacore:"Datacore-Abfrage",rss:"RSS-Feed",jira:"Jira-Filter",weather:"Wetter",market:"B\xF6rse",tension:"Weltspannung",git:"Git","operon-tasks":"Operon-Aufgaben","operon-board":"Operon-Board","operon-agenda":"Operon-Agenda","operon-timer":"Operon-Timer",leaf:"Plugin-Ansicht (Beta)",pet:"Haustier","vault-pet":"Vault Pet","vault-pet-house":"Vault-Pet-Haus",taskchute:"TaskChute","taskchute-overview":"TaskChute-\xDCbersicht","taskchute-heatmap":"TaskChute-Heatmap"},templateDescriptions:{music:"Spielt die Audiodateien eines Vault-Ordners ab, mit Warteschlange auf der Karte","music-stereo":"Fernbedienung f\xFCr den Navidrome-Player des Stereo-Plugins",note:"Jede Notiz, live auf dem Board dargestellt",image:"Ein Bild aus dem Vault, randlos",slideshow:"Bilder aus einer Liste oder einem Ordner oder die Notizen eines Ordners, im Wechsel per Timer","slideshow-notes":"Die Notizen eines Ordners, Seite f\xFCr Seite",base:"Eine .base-Datei, dargestellt durch Obsidians Bases",excalidraw:"Eine Excalidraw-Zeichnung mit nativem Verschieben und Zoomen",canvas:"Ein Canvas, in dem du direkt schwenken kannst",daily:"Immer die heutige Notiz, beim ersten Klick erstellt",periodic:"Die Notiz dieser Woche, dieses Monats oder Jahres, aus Periodic Notes",journal:"Die aktuelle Notiz eines Journals, aus dem Journals-Plugin",web:"Eine Webseite in einem iframe, per Timer aktualisiert",bookmarks:"Deine Obsidian-Lesezeichen, einen Klick entfernt",favorites:"Die Notizen, die du in Hearth markiert hast",recent:"Die Dateien, die du zuletzt ge\xF6ffnet hast",folder:"Was in einem Ordner liegt, eine Ebene tief, mit Browser dahinter",links:"Eine Zentrale f\xFCr Links, Notizen, Befehle und Ordner",templater:"Schaltfl\xE4chen, die aus einer Templater-Vorlage eine Notiz in einem Ordner deiner Wahl erstellen",clock:"Uhrzeit, Datum und Begr\xFC\xDFung",tasks:"Kontrollk\xE4stchen aus deinem Vault, als Liste oder Board",calendar:"Ein Monat im \xDCberblick, mit deinen Notizen darauf",schedule:"Monat, Woche, Tag und Liste, mit deinen Terminen darin",stats:"Notiz-, Wort- und Dateianzahl f\xFCr den Vault",search:"Eine gespeicherte Abfrage, live gehalten",searchbar:"Ein Suchfeld auf dem Board, mit oder ohne Rahmen",heatmap:"Ein Jahr Vault-Aktivit\xE4t, Tag f\xFCr Tag",text:"Ein Notizzettel, der auf dem Dashboard lebt",calculator:"Summen, Einheitenumrechnung und Wechselkurse",dataview:"Eine DQL- oder DataviewJS-Abfrage, dargestellt von Dataview",datacore:"Eine Datacore-Abfrage oder ein Skript",rss:"Schlagzeilen aus den Feeds, denen du folgst",jira:"Vorg\xE4nge aus einem Jira-Filter oder einer JQL-Suche",weather:"Die Vorhersage f\xFCr einen Ort deiner Wahl",market:"Aktien, Fonds, Devisen und Krypto, live",tension:"Die KI-Einsch\xE4tzung von Kagi News, wie angespannt die Welt ist",git:"Repository-Status, mit Commit, Pull und Push","operon-tasks":"Deine Operon-Aufgaben, gefiltert nach deinen W\xFCnschen","operon-board":"Operons Pipeline-Status als Board-Spalten","operon-agenda":"Die n\xE4chsten Tage Operon-Arbeit, Tag f\xFCr Tag","operon-timer":"Operons laufende Zeiterfassung, live tickend",leaf:"Die Seitenleiste eines anderen Plugins, eingebettet in einer Karte",pet:"Ein kleiner Begleiter, der auf deinem Board lebt","vault-pet":"Das Haustier des Vault-Pet-Plugins, das mit dem Schreiben w\xE4chst","vault-pet-house":"Das Haus von Vault Pet - Quests, Dex, Abzeichen und Statistik",taskchute:"Die heutigen TaskChute-Aufgaben \u2014 starten, stoppen, sehen was als N\xE4chstes kommt","taskchute-overview":"Eine Woche TaskChute: erledigt, Minuten, Tag f\xFCr Tag","taskchute-heatmap":"TaskChute-Aktivit\xE4t als Heatmap der Minuten pro Tag"},cardPicker:{title:"Karte hinzuf\xFCgen",searchPlaceholder:"Karten suchen\u2026",allCards:"Alle Karten",noMatches:"Keine Karte passt dazu.",requires:e=>`Braucht ${e}`,missingNotice:e=>`${e} ist nicht verf\xFCgbar - die Karte zeigt bis dahin einen Hinweis.`,installLink:e=>`${e} installieren`,categories:{notes:"Notizen & Dateien",planning:"Planung",vault:"Vault-Einblicke",tools:"Werkzeuge",integrations:"Integrationen",fun:"Spa\xDF"},request:{railLabel:"Karte vorschlagen",heading:"Karte vorschlagen",intro:"Fehlt dir etwas? Beschreibe die Karte, die du dir in Hearth w\xFCnschst - was sie zeigen soll und woher ihre Daten kommen.",footPrompt:"Nicht das, was du gesucht hast?",footLink:"Karte vorschlagen",githubTitle:"GitHub-Issue er\xF6ffnen",githubDesc:"\xD6ffentlich, durchsuchbar und der beste Ort, um die Idee zu diskutieren. Braucht ein GitHub-Konto.",githubAction:"GitHub \xF6ffnen",emailTitle:"E-Mail senden",emailDesc:"Direkt an den Maintainer, wenn du GitHub lieber nicht nutzt. \xD6ffnet dein Mailprogramm.",emailAction:"E-Mail \xF6ffnen",prefilledNote:"Beide \xF6ffnen vorausgef\xFCllt mit ein paar Fragen und deinen Hearth- und Obsidian-Versionen - bearbeite alles vor dem Senden."}},fileTypes:{folders:"Ordner",markdown:"Notizen",excalidraw:"Excalidraw",canvas:"Canvas",bases:"Bases",images:"Bilder",videos:"Videos",audio:"Audio",pdf:"PDF",documents:"Dokumente",spreadsheets:"Tabellen",presentations:"Folien",threeD:"3D",other:"Sonstiges"},portable:{exportModal:{title:"Dashboard teilen",saveFile:"Datei speichern",publishRemovesTitle:"Entfernt, bevor es diesen Vault verl\xE4sst",publishRemovesTune:"Die Details unten listen dieselben Gruppen, mit den genauen Werten darunter, und lassen dich \xE4ndern, was mitgeht.",publishRemoves:["Notiz- und Ordnerpfade - alles, worauf das Board in deinem Vault zeigt","Kalender-Feeds, private Hosts, dein Standort und Best\xE4nde","Text, den du auf dem Board getippt hast - der Inhalt einer Textkarte, die letzte Summe eines Rechners","Zugangsdaten - ein Jira-Token und alles andere, was eine Karte enthalten kann"],publishKeeps:"Bleibt erhalten, weil es das Board ausmacht: das Layout, das Styling, die Farben, die Bilder, die Karteneinstellungen, Suchen und Abfragen sowie jede \xF6ffentliche Seite oder jeder Feed, die es zeigt. \xD6ffne die Details unten, um die genauen Werte zu sehen und zu \xE4ndern, was mitgeht.",intro:"Speichert dieses eine Dashboard als Datei. Alles, was sein Aussehen betrifft, reist mit, damit es in einem anderen Vault gleich aussieht.",name:"Name",nameDesc:"Wie dieses Dashboard in der Datei hei\xDFt. Standard ist der eigene Name des Boards.",description:"Beschreibung",descriptionDesc:"Optional. Ein oder zwei Zeilen dazu, wof\xFCr dieses Dashboard gedacht ist.",snapshot:"Bild dieses Boards",snapshotDesc:"Ein Screenshot des Boards, wie es gerade aussieht - durchgescrollt, sodass ein langes Board vollst\xE4ndig erfasst wird. Was in deinen Karten steht, wird zuerst unkenntlich gemacht; Kopfzeile, Werkzeugleiste und der eigene Titel jeder Karte bleiben, ebenso eine Karte ohne Inhalte von dir, wie eine Uhr.",snapshotCheck:"Schau es dir an, bevor du ver\xF6ffentlichst. Alles, was du darin lesen kannst, kann jeder - klicke darauf, um es in voller Gr\xF6\xDFe zu sehen.",snapshotTake:"Bild aufnehmen",snapshotRetake:"Nochmals aufnehmen",snapshotWorking:"Nehme Bild auf\u2026",snapshotEnlarge:"Bild in voller Gr\xF6\xDFe \xF6ffnen",snapshotTaken:e=>`${e} KB - genau das wird ver\xF6ffentlicht, und genau das sehen alle, die die Galerie durchst\xF6bern.`,snapshotConfirm:"Ich habe geschaut - nichts Privates ist darin lesbar",snapshotConfirmDesc:"Klicke auf das Bild, um es in voller Gr\xF6\xDFe zu sehen und zu lesen. Kartentitel, Kopfzeile und alles, was eine Karte zeigt und nicht von dir ist, soll da sein; der Text einer Notiz, eine Aufgabe, ein Dateiname, ein Termin, eine Zahl aus deinem Leben nicht. Das Ver\xF6ffentlichen wartet, bis du es gesagt hast.",snapshotConfirmRequired:"Schau dir zuerst das Bild an, dann schalte \u201EIch habe geschaut\u201C ein.",snapshotLeak:"Wenn etwas von dir darin lesbar ist, ver\xF6ffentliche dieses Board nicht: Das Bild l\xE4sst sich nicht zur\xFCckholen, sobald es jemand installiert hat. Sag uns stattdessen Bescheid - das ist ein Fehler im Schw\xE4rzen, und es lohnt sich, ihn zu beheben, bevor es jemand anderem passiert.",snapshotLeakReport:"Auf GitHub melden",snapshotFailed:"Hearth konnte kein Bild des Boards aufnehmen.",snapshotRequired:"Ein Galerieeintrag braucht ein Bild des Boards. Nimm zuerst eines auf - du kannst es dir ansehen, bevor es rausgeht.",snapshotUnavailable:"Zum Ver\xF6ffentlichen braucht es ein Bild des Boards, und dieser Build kann keines aufnehmen - Screenshots brauchen die Desktop-App. Du kannst das Dashboard trotzdem als Datei speichern und aus einem Desktop-Vault ver\xF6ffentlichen.",snapshotNotActive:"Zum Ver\xF6ffentlichen braucht es ein Bild des Boards, und Hearth kann nur das ge\xF6ffnete Board fotografieren. Wechsle zuerst zu diesem Dashboard, dann ver\xF6ffentliche es.",theme:"Empfohlen mit meinem Theme",themeDesc:e=>`Sagt, dass das Board f\xFCr ${e} gedacht ist, das Theme, das du nutzt. Es ist ein Hinweis f\xFCr alle, die es installieren - auf ihrer Seite wird nichts installiert oder ge\xE4ndert.`,themeNone:"Du nutzt Obsidians Standardaussehen, also gibt es kein Theme zu empfehlen. Wechsle zuerst zu einem Community-Theme, wenn das Board f\xFCr eines gebaut ist.",tags:"Tags",tagsDesc:"Optional, per Komma getrennt. N\xFCtzlich, wenn das Dashboard dorthin geht, wo man es durchst\xF6bern kann.",tagsPlaceholder:"schreiben, minimal, dunkel",identity:"Ver\xF6ffentlicht als",identityDesc:"F\xFCr dich erstellt aus einem Schl\xFCssel, der in diesem Vault bleibt. Es ist dieselbe Kennung bei allem, was du ver\xF6ffentlichst, und sie sagt nichts dar\xFCber, wer du bist, und weil jede Datei mit diesem Schl\xFCssel signiert ist, kann niemand sonst darunter ver\xF6ffentlichen. Kopiere den Schl\xFCssel, um die Kennung auf eine andere Installation mitzunehmen.",identityNew:"Du hast noch keinen. Es ist eine anonyme Kennung aus einem Schl\xFCssel, der diesen Vault nie verl\xE4sst - kein Konto, keine E-Mail, nichts dar\xFCber, wer du bist.",identityCreate:"Meine Kennung erstellen",identityCreated:e=>`Du ver\xF6ffentlichst als ${e}. Kopiere deinen Wiederherstellungsschl\xFCssel und bewahre ihn sicher auf - es ist der einzige Weg, diese Kennung zur\xFCckzubekommen.`,identityCopy:"Meinen Wiederherstellungsschl\xFCssel kopieren",identityUnsaved:"Speichere deinen Wiederherstellungsschl\xFCssel sicher, bevor du ihn brauchst. Er liegt nirgendwo au\xDFer in diesem Vault, also gibt es bei Verlust kein Zur\xFCcksetzen und niemanden zu fragen - die Kennung und alles, was du darunter ver\xF6ffentlicht hast, w\xE4re weg.",identityCopied:"Wiederherstellungsschl\xFCssel kopiert. Bewahre ihn sicher auf - es ist der einzige Weg, diese Kennung zur\xFCckzubekommen.",identityCopyFailed:e=>`Dein Wiederherstellungsschl\xFCssel: ${e}`,identityRestore:"Schl\xFCssel aus einer anderen Installation verwenden",identityReplaceTitle:"Deine Kennung ersetzen?",identityReplaceWarning:"Du hast deinen aktuellen Wiederherstellungsschl\xFCssel noch nicht kopiert, und einen anderen dar\xFCber einzuf\xFCgen l\xE4sst sich nicht r\xFCckg\xE4ngig machen - dieser Vault h\xE4lt die einzige Kopie. Alles, was du bereits unter der aktuellen Kennung ver\xF6ffentlicht hast, bliebe ver\xF6ffentlicht, aber du k\xF6nntest nie wieder darunter posten. Kopiere den Schl\xFCssel zuerst, falls du ihn zur\xFCckhaben willst.",identityReplaceConfirm:"Ersetzen",identityRestoreLabel:"Wiederherstellungsschl\xFCssel",identityRestored:e=>`Du ver\xF6ffentlichst jetzt als ${e}.`,identityRestoreFailed:"Das ist kein Hearth-Wiederherstellungsschl\xFCssel.",contents:"Was enthalten sein soll",embedAssets:"Hintergrund und Bilder einbetten",embedAssetsDesc:"Tr\xE4gt das Hintergrundbild des Boards, alle Bildsymbole und alle festen Diashow-Bilder in der Datei mit, damit es in einem Vault richtig aussieht, der sie nie gesehen hat. Macht die Datei gr\xF6\xDFer. Schalte es aus f\xFCr eine Sicherung deines eigenen Vaults, wo die Bilder schon vorhanden sind.",referenceNote:(e,t)=>{let n=[];return e>0&&n.push(e===1?"1 Pfad aus diesem Vault":`${e} Pfade aus diesem Vault`),t>0&&n.push(t===1?"1 Kalender-Feed-URL":`${t} Kalender-Feed-URLs`),`So wie es ist, wird diese Datei ${n.join(" und ")} erw\xE4hnen. Das macht sie als eigene Sicherung funktionsf\xE4hig - und was der Schalter oben f\xFCr ein Board herausnimmt, das du ver\xF6ffentlichst.`},stripPrivate:"Meine privaten Informationen weglassen",stripPrivateDesc:"Entfernt die Teile dieses Boards, die dich betreffen statt das Design: die Notiz- und Ordnerpfade, auf die es zeigt, Kalender-Feed-Links, deinen Standort und alles, was du auf eine Textkarte getippt hast. Das Board sieht weiter genau gleich aus - die Karten kommen nur an und zeigen auf nichts, was ohnehin jeder ausf\xFCllen muss, der es l\xE4dt. Lass es aus f\xFCr eine Kopie deines eigenen Boards, die ihre Pfade braucht, um weiter zu funktionieren.",detailsSummary:"Genau sehen und anpassen, was mitgeht",flatten:"Erscheinungsbild-Einstellungen dieses Vaults auf das Dashboard kopieren",flattenDesc:"Das meiste, was ein Board ausmacht - Raster, Abst\xE4nde, Kartenfl\xE4chen, Hintergrund, Kopfzeile - ist eine vaultweite Einstellung, und das Board speichert nur, was es \xFCberschreibt. Dies schreibt die aufgel\xF6sten Werte auf das Dashboard selbst, damit es im Vault einer anderen Person gleich aussieht, statt dessen Einstellungen zu \xFCbernehmen. Schalte es aus, und das Board tr\xE4gt nur seine eigenen \xDCberschreibungen und passt sich an, wo es landet.",groupPinned:"Wird beim Ver\xF6ffentlichen immer entfernt.",stripIntro:"Jede Gruppe unten kommt aus der Datei heraus. Was sie entfernt, steht darunter - das ist die tats\xE4chliche Liste, gelesen aus diesem Board.",carriedIntro:"Es wird nichts weggelassen, dies ist also alles, was in der Datei nach au\xDFen zeigt. Schalte oben \u201EMeine privaten Informationen weglassen\u201C ein, um die ersten drei Gruppen zu entfernen.",carriedNothing:"Dieses Board zeigt auf nichts au\xDFerhalb seiner selbst.",groups:{paths:"Notiz- und Ordnerpfade entfernen",private:"Kalender-Feeds, private Hosts, deinen Standort und Best\xE4nde entfernen",content:"Text entfernen, den du auf dem Board getippt hast",queries:"Suchen und Dataview-Abfragen entfernen",plugins:"Befehls-IDs und Ansichtstypen entfernen"},groupDesc:{paths:"Alles, worauf dieses Board in deinem Vault zeigt, und der Ordner, aus dem jedes eingebettete Bild kam. Die Bilder selbst reisen weiter mit, wenn der Hintergrund-Schalter oben an ist - es ist der Ordner, in dem sie lagen, der geht.",private:"ICS-Kalender-Links (wer einen hat, kann diesen Kalender lesen), ein interner Jira-Host, der Ort, auf den eine Wetterkarte eingestellt ist, sowie Anteile und Einstandskurse eines Portfolios.",content:"Der Inhalt einer Textkarte und die letzte Eingabe eines Rechners - was auch immer du auf dein eigenes Dashboard gekritzelt hast.",queries:"Standardm\xE4\xDFig aus: Ein Board ohne seine Abfragen tut nichts mehr. Lohnt sich einzuschalten, wenn eine Abfrage einen privaten Ordner nennt.",plugins:"Standardm\xE4\xDFig aus: Diese nennen Plugins, nicht dich. Sie zu entfernen l\xE4sst die Schaltfl\xE4chen, die sie ausf\xFChrten, ohne Funktion."},groupEmpty:"Nichts auf diesem Board.",stripTotal:e=>e===0?"Es w\xFCrde nichts von diesem Board entfernt.":e===1?"1 Wert wird entfernt.":`${e} Werte werden entfernt.`,stripResidual:e=>`Exportiert, aber ${e} Wert${e===1?"":"e"} sehen weiter wie Vault-Pfade aus. Lohnt sich, die Datei zu \xF6ffnen, bevor du sie teilst.`,signFailed:"Exportiert, aber es konnte nicht signiert werden, also wird es ohne Autor importiert. Dein Wiederherstellungsschl\xFCssel ist vielleicht besch\xE4digt - versuche, ihn erneut einzuf\xFCgen.",exportButton:"Exportieren",assetsSkipped:e=>`Exportiert, aber diese Bilder wurden weggelassen (zu gro\xDF oder nicht mehr im Vault): ${e}`},importModal:{title:"Importieren",kinds:{dashboard:"Ein Dashboard",layout:"Ein Dashboard-Layout",settings:"Eine vollst\xE4ndige Einstellungs-Sicherung"},by:e=>`von ${e}`,signatureInvalid:"Diese Datei nennt einen Autor, aber ihre Signatur stimmt nicht - sie wurde entweder nach dem Signieren bearbeitet, oder jemand hat die Kennung eines anderen Erstellers darauf gesetzt. Sie wird ohne Autor gezeigt. Alles andere am Import ist unber\xFChrt.",madeWith:e=>`Hearth ${e}`,cardCount:e=>e===1?"1 Kartenart":`${e} Kartenarten`,assetCount:e=>e===1?"Bringt 1 Bild mit":`Bringt ${e} Bilder mit`,pathCount:e=>e===1?"Zeigt auf 1 Pfad in einem Vault":`Zeigt auf ${e} Pfade in einem Vault`,needsPlugins:e=>`Braucht diese Plugins: ${e}`,mode:"Wie es importiert werden soll",modeDesc:"Hinzuf\xFCgen l\xE4sst alle deine eigenen Einstellungen unber\xFChrt.",modeAdd:"Als neues Dashboard hinzuf\xFCgen",modeAddBoards:"Seine Dashboards zu meinen hinzuf\xFCgen",modeReplaceBoard:e=>`\u201E${e}\u201C an Ort und Stelle aktualisieren`,modeReplaceAll:"Alle meine Einstellungen ersetzen",replaceAllWarning:"Dies ersetzt deine Dashboards und jede Hearth-Einstellung durch die aus dieser Datei. Es l\xE4sst sich nicht r\xFCckg\xE4ngig machen.",heads:"Wissenswert",missingPlugins:e=>`Hier nicht installiert oder nicht aktiviert: ${e}. Diese Karten bleiben leer, bis sie es sind.`,missingPaths:(e,t)=>`${e} Notiz${e===1?"":"en"} oder Ordner, worauf dieses Board zeigt, ${e===1?"ist":"sind"} nicht in deinem Vault (${t}${e>3?", \u2026":""}).`,remoteContent:e=>e===1?"Es l\xE4dt 1 Sache aus dem Internet, wenn du es \xF6ffnest.":`Es l\xE4dt ${e} Sachen aus dem Internet, wenn du es \xF6ffnest.`,missingFine:"Nichts davon stoppt den Import - die Karten kommen durch und du kannst sie auf deine eigenen Notizen zeigen lassen.",importButton:"Importieren",addedOne:e=>`\u201E${e}\u201C hinzugef\xFCgt.`,addedMany:e=>`${e} Dashboards hinzugef\xFCgt.`,replacedOne:e=>`\u201E${e}\u201C aktualisiert.`,restored:"Einstellungen wiederhergestellt.",assetsWritten:e=>e===1?"1 Bild in deinem Vault gespeichert.":`${e} Bilder in deinem Vault gespeichert.`,warnMissingPaths:e=>`${e} referenzierte${e===1?"r":""} Pfad${e===1?"":"e"} hier nicht gefunden.`,warnMissingPlugins:e=>`${e} Plugin${e===1?", das es will, ist":"e, die es will, sind"} nicht aktiviert.`,warnTaskFields:"Seine Aufgabenkarten nutzen eigene Felder - schalte die Aufgabenfeld-Anpassung in Einstellungen \u2192 Integrationen ein, um sie zu sehen.",warnUnknownCards:"Manche Karten brauchen ein neueres Hearth und wurden weggelassen.",warnAssets:"Manche seiner Bilder fehlten in der Datei."}},gallery:{categories:{productivity:"Dinge erledigen",planning:"Planung & Kalender",study:"Lernen & Recherche",writing:"Schreiben & Tagebuch",work:"Arbeit & Projekte",personal:"Privat & Zuhause",minimal:"Minimal",dense:"Informationsdicht",other:"Alles andere"},sorts:{trending:"Im Trend",top:"Bestbewertet",new:"Neueste",downloads:"Meistinstalliert"},browse:{title:"Dashboard-Galerie",openLabel:"Galerie",openAria:"Dashboard-Galerie durchst\xF6bern",searchPlaceholder:"Dashboards suchen\u2026",all:"Alle Dashboards",mine:"Von mir ver\xF6ffentlicht",scopeLabel:"Kategorie",sortLabel:"Sortieren nach",refresh:"Aktualisieren",publish:"Dashboard ver\xF6ffentlichen",loading:"L\xE4dt\u2026",empty:"Hier ist noch nichts.",emptySearch:e=>`Nichts passt zu \u201E${e}\u201C.`,emptyMine:"Du hast noch nichts ver\xF6ffentlicht. Ver\xF6ffentliche ein Board und es erscheint hier.",results:(e,t)=>t>e?`${e} von ${t}`:`${e} Dashboard${e===1?"":"s"}`,more:"Mehr anzeigen",byAuthor:e=>`von ${e}`,anonymous:"ohne Angabe",downloads:e=>`${e} Installation${e===1?"":"en"}`,score:e=>`${e>0?"+":""}${e}`,cardCount:e=>`${e} Karte${e===1?"":"n"}`,pluginBoard:"Beherbergt eine Plugin-Ansicht",noPicture:"Kein Bild",needsIdentity:"Du kannst ohne einen st\xF6bern und installieren, aber Abstimmen und Ver\xF6ffentlichen brauchen eine Kennung. Hearth erstellt dir eine anonyme aus einem Schl\xFCssel, der diesen Vault nie verl\xE4sst.",needsIdentityVote:"Abstimmen braucht eine Kennung. Hearth erstellt dir eine anonyme aus einem Schl\xFCssel, der diesen Vault nie verl\xE4sst - kein Konto und nichts dar\xFCber, wer du bist. Jetzt einen erstellen?"},detail:{install:"Installieren",installing:"L\xE4dt herunter\u2026",installAria:e=>`${e} installieren`,enlarge:"Bild in voller Gr\xF6\xDFe \xF6ffnen",profile:e=>`Alles von ${e} ansehen`,upvoteAria:"Hochw\xE4hlen",downvoteAria:"Runterw\xE4hlen",published:e=>`Ver\xF6ffentlicht ${e}`,updated:e=>`Aktualisiert ${e}`,version:e=>`Version des Autors ${e}`,theme:e=>`Empfohlen mit dem Theme ${e}`,madeWith:e=>`Erstellt mit Hearth ${e}`,contents:"Was auf diesem Board ist",requires:"Was es braucht",requiresPlugins:"Plugins",requiresViews:"Gehostete Ansichten",requiresSettings:"Einstellungen",nothingRequired:"Nichts au\xDFer Hearth selbst.",size:e=>`${e} KB`,remote:e=>e===1?"Eine Sache auf diesem Board wird aus dem Internet geladen.":`${e} Sachen auf diesem Board werden aus dem Internet geladen.`,noRemote:"Nichts auf diesem Board wird aus dem Internet geladen.",unverified:"Dieses Board kam ohne pr\xFCfbare Signatur an, also l\xE4sst sich nicht feststellen, wer es erstellt hat.",tags:"Tags"},profile:{title:e=>e,subtitle:"Eine anonyme Kennung, abgeleitet aus einem Signierschl\xFCssel. Sie sagt nichts dar\xFCber, wer jemand ist - nur, dass dieselbe Hand all dies erstellt hat.",karma:"Karma",karmaHint:"Jede positive Bewertung \xFCber alles, was sie ver\xF6ffentlicht haben, minus jede negative Bewertung.",totalDownloads:"Installationen",published:e=>`${e} Dashboard${e===1?"":"s"}`,firstSeen:e=>`Zuerst ver\xF6ffentlicht ${e}`,empty:"Nichts unter dieser Kennung ver\xF6ffentlicht."},comments:{heading:e=>e===1?"1 Kommentar":`${e} Kommentare`,headingEmpty:"Kommentare",none:"Noch nichts. Sag das Erste.",placeholder:"Frag etwas oder sag, wie es bei dir funktioniert hat\u2026",post:"Posten",remove:"Diesen Kommentar entfernen"},publish:{title:"In der Galerie ver\xF6ffentlichen",intro:"Stellt dieses Dashboard in die Galerie, wo jeder, der diese Hearth-Galerie nutzt, es finden und installieren kann.",category:"Kategorie",categoryDesc:"Wof\xFCr dieses Board gedacht ist. So finden es die Leute.",button:"Ver\xF6ffentlichen",publishing:"Wird ver\xF6ffentlicht\u2026",warning:"Dieses Board wird \xF6ffentlich: Jeder, der diese Galerie nutzt, kann es finden und installieren. Du kannst es jederzeit zur\xFCckziehen, doch wer es bereits installiert hat, beh\xE4lt seine Kopie.",needsName:"Gib dem Dashboard einen Namen, bevor du es ver\xF6ffentlichst.",residual:e=>`Zur\xFCckgehalten: ${e} Wert${e===1?"":"e"} sehen nach dem Entfernen weiter wie Pfade aus deinem Vault aus. Pr\xFCfe den Details-Bereich vor dem Ver\xF6ffentlichen.`,done:e=>`\u201E${e}\u201C in der Galerie ver\xF6ffentlicht.`,doneHeld:e=>`Die Galerie hat \u201E${e}\u201C angenommen, h\xE4lt es aber zur Pr\xFCfung zur\xFCck - etwas darin sieht weiter wie ein Pfad aus deinem Vault aus. Es wird erst gelistet, wenn dort jemand draufgeschaut hat.`,doneUpdate:e=>`\u201E${e}\u201C in der Galerie aktualisiert.`,update:"Aktualisieren",updateChecking:"Pr\xFCfe\u2026",updateDesc:"Ver\xF6ffentliche dieses Board erneut, \xFCber diesen Eintrag.",updateMissing:"Dieser Vault hat das Board nicht, von dem aus dies ver\xF6ffentlicht wurde - es wurde gel\xF6scht oder es lebt in einem anderen Vault. Von hier zu ver\xF6ffentlichen w\xFCrde einen zweiten Eintrag erzeugen, also gibt es nichts zu aktualisieren.",updateUnknown:"Hearth wei\xDF noch nicht, welches deiner Boards dieser Eintrag ist. Dr\xFCcke Aktualisieren und es liest den Eintrag, um es herauszufinden.",unpublish:"Aus der Galerie entfernen",unpublishConfirm:e=>`\u201E${e}\u201C aus der Galerie entfernen? Wer es bereits installiert hat, beh\xE4lt seine Kopie; niemand Neues kann es finden.`,unpublished:"Aus der Galerie entfernt."},settings:{heading:"Dashboard-Galerie",host:"Galerieadresse",hostDesc:"Die Galerie, in der Hearth st\xF6bert und wohin es ver\xF6ffentlicht. Nichts wird abgerufen, bis du sie \xF6ffnest, und nichts gesendet, bis du ver\xF6ffentlichst. Leere dieses Feld, um die Galerie ganz auszuschalten - sie bleibt aus. Nur https (oder http auf localhost, f\xFCr eine Galerie, die du selbst betreibst).",hostPlaceholder:"https://gallery.example.com",hostInvalid:"Das ist keine Adresse, mit der Hearth spricht. Nutze https oder http auf localhost.",hostCleared:"Galerie ausgeschaltet.",hostSet:e=>`Galerie gesetzt auf ${e}.`,browse:"Galerie durchst\xF6bern",browseDesc:"Dashboards, die andere ver\xF6ffentlicht haben, und die, die du selbst ver\xF6ffentlicht hast.",browseButton:"Galerie \xF6ffnen"},errors:{noHost:"Keine Galerie eingerichtet. Trage eine Galerieadresse in Hearths Einstellungen ein, unter Dashboard-Galerie.",externalCallsOff:"Die Galerie ist ein Server im Internet, und dieser Vault hat \u201EExterne Aufrufe deaktivieren\u201C eingeschaltet. Schalte das aus, um zu st\xF6bern oder zu ver\xF6ffentlichen.",offline:"Die Galerie war nicht erreichbar. Sie ist vielleicht ausgefallen, oder dieses Ger\xE4t ist offline.",badResponse:"Diese Adresse hat geantwortet, aber nicht wie eine Hearth-Galerie.",unauthorized:"Die Galerie hat die Identit\xE4t dieses Vaults nicht akzeptiert.",forbidden:"Die Galerie hat dieser Vault-Identit\xE4t das nicht erlaubt.",rateLimited:"Die Galerie bittet dich, es langsamer anzugehen. Versuche es in ein paar Minuten erneut.",tooLarge:"Dieses Dashboard ist zu gro\xDF f\xFCr diese Galerie. Schalte den Hintergrund aus oder verkleinere ihn.",rejected:e=>`Die Galerie hat es abgelehnt: ${e}`,notFound:"Die Galerie hat das nicht.",server:"Die Galerie hatte ein Problem mit dieser Anfrage.",unsigned:"Hearth konnte die Datei nicht signieren, also wurde sie nicht ver\xF6ffentlicht - ein unsigniertes Board hat keinen nachweisbaren Autor."}},layout:{invalidJson:"Das ist kein g\xFCltiges JSON.",notAnObject:"Das Layout muss ein JSON-Objekt sein.",noValidDashboards:"Das Layout enthielt keine g\xFCltigen Dashboards.",noValidCards:"Das Layout enthielt keine g\xFCltigen Karten.",notAHearthLayout:"Kein Hearth-Layout - kein \u201Edashboards\u201C- oder \u201Ecards\u201C-Array gefunden.",notHearthSettings:"Keine Hearth-Einstellungs-Sicherung - kein \u201EhearthSettings\u201C-Marker oder Layout gefunden."},views:{switcherAria:"Ansichten",switchTo:e=>`Wechseln zu ${e}`,chooseView:"Ansicht w\xE4hlen",nextViewAria:e=>`N\xE4chste Ansicht zeigen (${e})`,merged:"Zusammengef\xFChrt. In den Einstellungen der Karte unter Ansichten l\xE4sst sie sich wieder herausl\xF6sen.",tuiHelp:"N\xE4chste oder vorige Ansicht einer Karte mit Ansichten",editor:{tab:"Ansichten",heading:"Ansichten",headingDesc:"Eine Karte kann mehrere Ansichten enthalten \u2013 jede eine Karte beliebigen Typs \u2013 und zwischen ihnen wechseln. Jede Ansicht beh\xE4lt ihren eigenen Inhalt; Gr\xF6\xDFe, Farben und Fl\xE4che geh\xF6ren der Karte.",kindShown:e=>`${e} \xB7 wird angezeigt`,edit:"Inhalt dieser Ansicht bearbeiten",show:"Diese Ansicht auf der Karte zeigen",moveUp:"Nach oben",moveDown:"Nach unten",detach:"Als eigene Karte herausl\xF6sen",detached:"Als eigene Karte auf das Board gelegt.",remove:"Diese Ansicht l\xF6schen",removeTitle:"Diese Ansicht l\xF6schen?",removeMessage:e=>`\u201E${e}\u201C und ihr Inhalt werden aus dieser Karte gel\xF6scht.`,removeConfirm:"L\xF6schen",add:"Ansicht hinzuf\xFCgen",addDesc:"Eine neue Karte beliebigen Typs als n\xE4chste Ansicht dieser Karte.",addNew:"Neue Ansicht\u2026",merge:"Eine Karte hier einf\xFCgen",mergeDesc:"Eine Karte, die schon auf diesem Board liegt, wird zur n\xE4chsten Ansicht dieser Karte und beh\xE4lt ihren Inhalt. Beim Anordnen eine Karte \xFCber einer anderen halten und loslassen bewirkt dasselbe.",mergeButton:"Einf\xFCgen",withViews:(e,t)=>`${e}, ${t} Ansichten`,split:"In einzelne Karten aufteilen",splitDesc:"Jede Ansicht kommt als eigene Karte zur\xFCck auf das Board.",splitButton:"Aufteilen",splitTitle:"Diese Karte aufteilen?",splitMessage:e=>`Ihre ${e} Ansichten werden zu ${e} einzelnen Karten auf dem Board.`,splitConfirm:"Aufteilen",editing:"Bearbeitete Ansicht",editingDesc:"Welche Ansicht die Einstellungen darunter \xE4ndern.",label:"Beschriftung im Umschalter",labelDesc:"Leer benennt der Umschalter die Ansicht nach ihrem Inhalt oder Typ.",icon:"Symbol im Umschalter",iconDesc:"Ein Lucide-Symbolname. Leer entscheidet der Typ der Ansicht.",switcher:"Umschalter",placement:"Position",placementDesc:"Wo der Umschalter sitzt. Automatisch setzt ihn bei einer Karte mit Titel in die Kopfzeile und bei einer ohne Titel in die obere rechte Ecke.",placements:{auto:"Automatisch",header:"In der Kopfzeile","top-left":"Ecke oben links","top-right":"Ecke oben rechts","bottom-left":"Ecke unten links","bottom-right":"Ecke unten rechts",hidden:"Ausgeblendet"},hiddenNote:"Es wird kein Umschalter gezeichnet. Ansichten wechseln per Wischen, per Rotation oder in den Einstellungen der Karte.",style:"Stil",styleDesc:"Wie die Auswahl gezeichnet wird. Ein Ausklappmen\xFC passt zu vielen Ansichten auf einer schmalen Karte.",styles:{tabs:"Reiter",dropdown:"Ausklappmen\xFC",dots:"Punkte",icons:"Symbole"},labelStyle:"Reiter zeigen",labelStyleDesc:"Was jeder Reiter tr\xE4gt.",labels:{label:"Beschriftung",icon:"Symbol",both:"Symbol und Beschriftung"},reveal:"Umschalter zeigen",revealDesc:"Ein Umschalter in einer Ecke kann unsichtbar bleiben, bis der Zeiger \xFCber der Karte ist.",reveals:{always:"Immer",hover:"Beim \xDCberfahren"},rotate:"Rotieren alle (Sekunden)",rotateDesc:"Nach einem Zeitplan zur n\xE4chsten Ansicht wechseln, pausiert, solange der Zeiger auf der Karte ist oder darin getippt wird. Leer ist aus; mindestens 3 Sekunden.",rotateOff:"Aus",swipe:"Wischen zum Wechseln",swipeDesc:"Auf einem Touchscreen wechselt ein seitliches Wischen \xFCber die Karte zur n\xE4chsten oder vorigen Ansicht.",remember:"Angezeigte Ansicht merken",rememberDesc:"Mit der zuletzt gezeigten Ansicht beginnen, auch nach einem Neustart. Jeder Wechsel wird dann gespeichert, was ein synchronisierter Vault als \xC4nderung erh\xE4lt.",narrow:"Auf einem schmalen Board",narrowDesc:"Den Umschalter behalten oder jede Ansicht als eigene Karte untereinander zeigen.",narrows:{switcher:"Umschalter behalten",split:"Eine Karte pro Ansicht"}}},fileMenu:{newNote:"Neue Notiz",newFolder:"Neuer Ordner",rename:"Umbenennen \u2026",makeCopy:"Kopie erstellen",delete:"L\xF6schen",untitled:"Unbenannt",folderName:"Ordnername",newName:"Neuer Name",exists:e=>`\u201E${e}\u201C existiert bereits.`,invalidName:"Ein Name darf weder / noch \\ oder : enthalten."},tui:{boardLabel:"Dashboard, Terminalmodus",cardMenu:"Kartenmen\xFC",removeCard:"Karte entfernen",resize:"Zum \xC4ndern der Gr\xF6\xDFe ziehen",moveUp:"Nach oben",moveDown:"Nach unten",moveBoardLeft:"Board nach links",moveBoardRight:"Board nach rechts",moreBoards:e=>e===1?"1 weiteres Board \u2014 alle Boards auflisten":`${e} weitere Boards \u2014 alle Boards auflisten`,emptyBoard:"Dieses Board ist leer.",emptyBoardHint:"F7 oder n f\xFCgt eine Karte hinzu.",moved:e=>`${e} verschoben`,scroll:(e,t)=>`${e}/${t}`,arrangeFoot:"Pfeile verschieben \xB7 Umschalt+Pfeile \xE4ndern die Gr\xF6\xDFe \xB7 x entfernt",arrangeHint:"Einen Rahmen ziehen verschiebt ihn, seine Ecke \xE4ndert die Gr\xF6\xDFe.",arranging:"Anordnen",arrange:"Anordnen",doneArranging:"Fertig",arrangeOn:"Anordnen. Pfeile verschieben die fokussierte Karte; F2 beendet.",arrangeOff:"Layout gespeichert.",menuDetail:"Gr\xF6\xDFere Ansicht \xF6ffnen",menuZoom:"Zoomen",menuRefresh:"Aktualisieren",menuSettings:"Karteneinstellungen",menuPin:"An jedes Board anheften",menuUnpin:"Von jedem Board l\xF6sen",menuDuplicate:"Duplizieren",menuRemove:"Karte entfernen",searchLabel:"Suche:",restingHint:"Tab wechselt die Karte \xB7 \u2191\u2193 darin \xB7 Enter \xF6ffnet \xB7 m Men\xFC \xB7 F1 Hilfe",cardCount:e=>e===1?"1 Karte":`${e} Karten`,refreshed:e=>e===1?"1 Karte aktualisiert.":`${e} Karten aktualisiert.`,noSearch:"Der Suchbereich ist auf diesem Boar