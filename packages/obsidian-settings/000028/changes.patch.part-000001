C9C0 \uACBD\uB85C \uB610\uB294 \uC6F9 \uC774\uBBF8\uC9C0 URL\uC744 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uBE44\uC6CC \uB450\uBA74 Hearth \uD06C\uB9AC\uC2A4\uD138\uC744 \uC0AC\uC6A9\uD569\uB2C8\uB2E4. \uB300\uC2DC\uBCF4\uB4DC\uBCC4\uB85C \uC7AC\uC815\uC758\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.",tabIcon:"\uD0ED \uC544\uC774\uCF58",tabIconDesc:"Hearth \uD0ED \uBA38\uB9AC\uAE00\uACFC \uB9AC\uBCF8 \uBC84\uD2BC\uC5D0 \uD45C\uC2DC\uD560 Lucide \uC544\uC774\uCF58\uC785\uB2C8\uB2E4. \uBE44\uC6CC \uB450\uBA74 Hearth \uD06C\uB9AC\uC2A4\uD138\uC744 \uC0AC\uC6A9\uD569\uB2C8\uB2E4.",themeColorTarget:"\uD14C\uB9C8 \uC544\uC774\uCF58 \uC0C9\uC0C1 \uC0AC\uC6A9",themeColorTargetDesc:"\uD06C\uB9AC\uC2A4\uD138 \uC544\uC774\uCF58 \uBC0F/\uB610\uB294 \uC81C\uBAA9\uC5D0 \uAE30\uBCF8 \uBCF4\uB77C\uC0C9 \uB300\uC2E0 \uD14C\uB9C8\uC758 \uC544\uC774\uCF58 \uC0C9\uC0C1\uC744 \uC0AC\uC6A9\uD569\uB2C8\uB2E4.",themeColorNone:"\uB044\uAE30",themeColorIcon:"\uC544\uC774\uCF58",themeColorTitle:"\uC81C\uBAA9",themeColorBoth:"\uC544\uC774\uCF58\uACFC \uC81C\uBAA9",searchPlaceholder:"\uAC80\uC0C9 \uC548\uB0B4 \uBB38\uAD6C",searchInstantAnswers:"\uC989\uC11D \uB2F5\uBCC0",searchInstantAnswersDesc:"\uB178\uD2B8 \uC704\uC5D0 \uACC4\uC0B0, \uD658\uC728, \uC8FC\uAC00, \uB0A0\uC528, \uC704\uD0A4\uBC31\uACFC \uC694\uC57D \uB4F1\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4. \uC628\uB77C\uC778 \uB2F5\uBCC0\uC740 \uC694\uCCAD\uD558\uB294 \uAC80\uC0C9\uC5D0\uB9CC \uAC00\uC838\uC635\uB2C8\uB2E4.",searchTips:"\uAC80\uC0C9 \uB3C4\uC6C0\uB9D0",searchTipsDesc:"\uAC80\uC0C9\uCC3D\uC774 \uC774\uD574\uD558\uB294 \uAE30\uB2A5\uACFC \uC608\uC2DC\uB97C \uD655\uC778\uD569\uB2C8\uB2E4.",searchTipsButton:"\uBCF4\uAE30",searchContents:"\uB178\uD2B8 \uB0B4\uC6A9 \uAC80\uC0C9",searchContentsDesc:"\uC774\uB984, \uD0DC\uADF8, \uC18D\uC131\uBFD0 \uC544\uB2C8\uB77C \uB178\uD2B8 \uBCF8\uBB38\uB3C4 \uAC80\uC0C9\uD569\uB2C8\uB2E4. \uBCF8\uBB38 \uC77C\uCE58 \uD56D\uBAA9\uC740 \uC774\uB984 \uC77C\uCE58 \uD56D\uBAA9 \uB4A4\uC5D0 \uBBF8\uB9AC\uBCF4\uAE30\uC640 \uD568\uAED8 \uD45C\uC2DC\uB429\uB2C8\uB2E4.",searchEngine:"\uAC80\uC0C9 \uC5D4\uC9C4",searchEngineDesc:"\uAC80\uC0C9\uCC3D\uC5D0\uC11C \uC0AC\uC6A9\uD560 \uC5D4\uC9C4\uC785\uB2C8\uB2E4. Quick switcher\uB294 Obsidian \uBC29\uC2DD\uC73C\uB85C \uD30C\uC77C\uACFC \uBCC4\uCE6D\uB9CC \uAC80\uC0C9\uD569\uB2C8\uB2E4. Omnisearch\uB97C \uC0AC\uC6A9\uD558\uB824\uBA74 \uD574\uB2F9 \uCEE4\uBBA4\uB2C8\uD2F0 \uD50C\uB7EC\uADF8\uC778\uC744 \uC124\uCE58\uD558\uACE0 \uD65C\uC131\uD654\uD574\uC57C \uD569\uB2C8\uB2E4.",searchEngineBuiltin:"Hearth (\uB0B4\uC7A5)",searchEngineOmnisearch:"Omnisearch",searchEngineQuickSwitcher:"\uBE60\uB978 \uC804\uD658\uAE30",omnisearchMissing:"Omnisearch\uAC00 \uC124\uCE58\uB418\uC5B4 \uC788\uAC70\uB098 \uD65C\uC131\uD654\uB418\uC5B4 \uC788\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uC124\uCE58\uD558\uACE0 \uD65C\uC131\uD654\uD55C \uB4A4 \uB2E4\uC2DC \uC120\uD0DD\uD558\uC138\uC694.",omnisearchInstallLink:"\uCEE4\uBBA4\uB2C8\uD2F0 \uD50C\uB7EC\uADF8\uC778\uC5D0\uC11C Omnisearch \uC5F4\uAE30",showNewNoteButton:"\u2018\uC0C8 \uB178\uD2B8\u2019 \uBC84\uD2BC \uD45C\uC2DC",showNewNoteButtonDesc:"\uAC80\uC0C9\uCC3D \uC606\uC5D0 \uC791\uC5C5 \uBC84\uD2BC\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4.",newNoteButtonMode:"\uAC80\uC0C9\uCC3D \uBC84\uD2BC",newNoteButtonModeDesc:"\uAC80\uC0C9\uCC3D \uC606 \uBC84\uD2BC\uC758 \uB3D9\uC791\uC744 \uC120\uD0DD\uD569\uB2C8\uB2E4. \uC0C8 \uB178\uD2B8\uB97C \uB9CC\uB4E4\uAC70\uB098 \uD604\uC7AC \uAC80\uC0C9\uC5B4\uB97C \uC6F9\uC5D0\uC11C \uAC80\uC0C9\uD569\uB2C8\uB2E4.",newNoteButtonModeNewNote:"\uC0C8 \uB178\uD2B8",newNoteButtonModeSearchOnline:"\uC628\uB77C\uC778 \uAC80\uC0C9",webSearchEngine:"\uC628\uB77C\uC778 \uAC80\uC0C9 \uC5D4\uC9C4",webSearchEngineDesc:"\u2018\uC628\uB77C\uC778 \uAC80\uC0C9\u2019 \uBC84\uD2BC\uC5D0\uC11C \uC5F4 \uAC80\uC0C9 \uC5D4\uC9C4\uC785\uB2C8\uB2E4. \uBC84\uD2BC \uC606 \uD654\uC0B4\uD45C\uB85C \uC774\uBC88 \uAC80\uC0C9\uC5D0 \uD55C\uD574 \uB2E4\uB978 \uC5D4\uC9C4\uC744 \uC120\uD0DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.",newNoteHeading:"\u2018\uC0C8 \uB178\uD2B8\u2019 \uBC84\uD2BC",newNoteHeadingDesc:"\uBC84\uD2BC\uC73C\uB85C \uB9CC\uB4E4 \uD56D\uBAA9\uACFC \uC704\uCE58\uB97C \uC124\uC815\uD569\uB2C8\uB2E4. \uAC80\uC0C9\uCC3D \uBC84\uD2BC, \uAC80\uC0C9\uCC3D \uCE74\uB4DC \uBC84\uD2BC, Hearth\uC758 \u2018\uC0C8 \uB178\uD2B8 \uB9CC\uB4E4\uAE30\u2019 \uBA85\uB839\uC5D0 \uC801\uC6A9\uB429\uB2C8\uB2E4.",newNoteButtonLabel:"\uBC84\uD2BC \uD14D\uC2A4\uD2B8",newNoteButtonLabelDesc:"\uBC84\uD2BC\uC5D0 \uD45C\uC2DC\uD560 \uD14D\uC2A4\uD2B8\uC785\uB2C8\uB2E4. \uBE44\uC6CC \uB450\uBA74 \u2018\uC0C8 \uB178\uD2B8\u2019\uB97C \uD45C\uC2DC\uD569\uB2C8\uB2E4.",newNoteTemplate:"\uD15C\uD50C\uB9BF",newNoteTemplateDesc:"\uBE48 \uB178\uD2B8 \uB300\uC2E0 Templater \uD15C\uD50C\uB9BF\uC73C\uB85C \uB178\uD2B8\uB97C \uB9CC\uB4ED\uB2C8\uB2E4. \uC0AC\uC6A9\uC790 \uC2A4\uD06C\uB9BD\uD2B8, tp.system.prompt() \uB300\uD654\uC0C1\uC790, \uCEE4\uC11C \uC704\uCE58\uB294 Templater \uBA85\uB839\uACFC \uB3D9\uC77C\uD558\uAC8C \uC791\uB3D9\uD569\uB2C8\uB2E4.",newNoteTemplateNone:"\uBE48 \uB178\uD2B8",newNoteTemplatePick:"\uD15C\uD50C\uB9BF \uC120\uD0DD\u2026",newNoteTemplateClear:"\uBE48 \uB178\uD2B8 \uC0AC\uC6A9",newNoteTemplaterMissing:"Templater\uAC00 \uBE44\uD65C\uC131\uD654\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4. \uD15C\uD50C\uB9BF\uC744 \uC0AC\uC6A9\uD558\uB824\uBA74 \uC124\uCE58 \uBC0F \uD65C\uC131\uD654\uD558\uC138\uC694. \uADF8\uC804\uAE4C\uC9C0 \uBC84\uD2BC\uC740 \uBE48 \uB178\uD2B8\uB97C \uB9CC\uB4ED\uB2C8\uB2E4.",newNoteFolder:"\uC704\uCE58",newNoteFolderDesc:"\uC0C8 \uB178\uD2B8\uB97C \uC800\uC7A5\uD560 \uD3F4\uB354\uC785\uB2C8\uB2E4. \uD3F4\uB354\uAC00 \uC5C6\uC73C\uBA74 \uB9CC\uB4ED\uB2C8\uB2E4. \u2018\uAE30\uBCF8 \uC704\uCE58\u2019\uB294 Obsidian\uC758 \uC0C8 \uB178\uD2B8 \uC800\uC7A5 \uC704\uCE58\uB97C \uC0AC\uC6A9\uD569\uB2C8\uB2E4.",newNoteFolderClear:"\uAE30\uBCF8 \uC704\uCE58 \uC0AC\uC6A9",newNoteFilename:"\uD30C\uC77C \uC774\uB984",newNoteFilenameDesc:"\uD655\uC7A5\uC790\uB97C \uC81C\uC678\uD55C \uB178\uD2B8 \uC774\uB984\uC785\uB2C8\uB2E4. {{date}}, {{date:FMT}}, {{time}}, {{time:FMT}}, {{prompt}}\uB97C \uCE58\uD658\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. {{prompt}}\uB294 \uD074\uB9AD\uD560 \uB54C\uB9C8\uB2E4 \uC774\uB984\uC744 \uBB3B\uC2B5\uB2C8\uB2E4. \uBE44\uC6CC \uB450\uBA74 \u2018\uC81C\uBAA9 \uC5C6\uC74C\u2019\uC744 \uC0AC\uC6A9\uD569\uB2C8\uB2E4.",newNoteFilenamePlaceholder:"\uC81C\uBAA9 \uC5C6\uC74C",newNoteDestination:e=>`${e}\uC5D0 \uB9CC\uB4ED\uB2C8\uB2E4`,contentWidth:"\uCF58\uD150\uCE20 \uB108\uBE44",contentWidthDesc:"\uD648 \uCF58\uD150\uCE20\uC758 \uCD5C\uB300 \uB108\uBE44\uB97C \uD53D\uC140\uB85C \uC9C0\uC815\uD569\uB2C8\uB2E4. \uC774 \uAC12\uC740 \uC0C1\uD55C\uC774\uBA70, \uB354 \uC881\uC740 \uD328\uB110\uC5D0\uC11C\uB294 \uCF58\uD150\uCE20\uB3C4 \uD568\uAED8 \uC904\uC5B4\uB4ED\uB2C8\uB2E4.",fullWidth:"\uC804\uCCB4 \uB108\uBE44",fullWidthDesc:"\uC544\uB798 \uC9C0\uC815\uD55C \uB108\uBE44\uC5D0\uC11C \uBA48\uCD94\uC9C0 \uC54A\uACE0 \uD328\uB110\uC744 \uCC44\uC6C1\uB2C8\uB2E4. \uCE74\uB4DC \uBE44\uC728\uC740 \uC720\uC9C0\uB418\uC9C0\uB9CC \uD14D\uC2A4\uD2B8 \uD06C\uAE30\uB294 \uCEE4\uC9C0\uC9C0 \uC54A\uC544 \uB9E4\uC6B0 \uB113\uC740 \uBCF4\uB4DC\uB294 \uC5EC\uBC31\uC774 \uCEE4 \uBCF4\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4."},performance:{...M.settings.performance,tier:"\uC131\uB2A5 \uB2E8\uACC4",tierDesc:"\uB2E8\uACC4\uB97C \uB0AE\uCD9C \uB54C\uB9C8\uB2E4 \uBCF4\uB4DC\uC5D0\uC11C \uAC00\uC7A5 \uBD80\uD558\uAC00 \uD070 \uD6A8\uACFC\uBD80\uD130 \uC904\uC785\uB2C8\uB2E4. \uB0AE\uC740 \uB2E8\uACC4\uC5D0\uC11C\uB3C4 \uC124\uC815\uC740 \uBCF4\uC874\uB418\uBA70 \uB2E4\uC2DC \uC62C\uB9AC\uBA74 \uBCF5\uC6D0\uB429\uB2C8\uB2E4.",tierFull:"\uCD5C\uACE0 \u2014 \uBAA8\uB4E0 \uD6A8\uACFC \uC0AC\uC6A9",tierBalanced:"\uADE0\uD615 \u2014 \uBC30\uACBD \uD6A8\uACFC \uAC10\uC18C",tierReduced:"\uB0AE\uC74C \u2014 \uC6C0\uC9C1\uC784 \uB044\uAE30",tierMinimal:"\uCD5C\uC18C \u2014 \uB2E8\uC21C \uC815\uC9C0 \uD654\uBA74",tierFullDesc:"\uBAA8\uB4E0 \uD6A8\uACFC\uB97C \uCD5C\uB300 \uC218\uC900\uC73C\uB85C \uC0AC\uC6A9\uD569\uB2C8\uB2E4. \uB0A0\uC528 \uBC30\uACBD\uC774 \uAC00\uC7A5 \uD070 \uBD80\uD558\uB97C \uC720\uBC1C\uD569\uB2C8\uB2E4.",tierBalancedDesc:"\uB0A0\uC528 \uBC30\uACBD\uC744 \uC808\uBC18 \uBC00\uB3C4\uB85C \uADF8\uB9BD\uB2C8\uB2E4. \uD6A8\uACFC\uB97C \uB044\uC9C0 \uC54A\uACE0 \uD654\uBA74\uC5D0 \uD45C\uC2DC\uB418\uB294 \uC591\uC744 \uC904\uC5EC \uBD80\uD558\uB97C \uB0AE\uCDA5\uB2C8\uB2E4.",tierReducedDesc:"\uBCF4\uB4DC \uC560\uB2C8\uBA54\uC774\uC158\uACFC \uCE74\uB4DC\uC758 \uBC18\uD22C\uBA85 \uD750\uB9BC \uD6A8\uACFC\uB97C \uB055\uB2C8\uB2E4. \uBC30\uACBD\uACFC \uCE74\uB4DC \uC0C8\uB85C \uACE0\uCE68\uC740 \uC720\uC9C0\uB429\uB2C8\uB2E4.",tierMinimalDesc:"\uBC30\uACBD \uC774\uBBF8\uC9C0\uB97C \uB2E8\uC0C9\uC73C\uB85C \uBC14\uAFB8\uACE0 \uCE74\uB4DC \uBD88\uD22C\uBA85\uB3C4, \uC6C0\uC9C1\uC784, \uC790\uB3D9 \uC0C8\uB85C \uACE0\uCE68\uC744 \uB055\uB2C8\uB2E4.",pauseWhenUnfocused:"Obsidian\uC774 \uBE44\uD65C\uC131 \uC0C1\uD0DC\uC77C \uB54C \uC560\uB2C8\uBA54\uC774\uC158 \uC77C\uC2DC \uC911\uC9C0",pauseWhenUnfocusedDesc:"\uB2E4\uB978 \uC571\uC774\uB098 \uCC3D\uC5D0\uC11C \uC791\uC5C5\uD560 \uB54C \uC560\uB2C8\uBA54\uC774\uC158\uC744 \uBA48\uCDA5\uB2C8\uB2E4. \uBCF4\uC870 \uD654\uBA74\uC5D0\uC11C \uB300\uC2DC\uBCF4\uB4DC\uB97C \uACC4\uC18D \uC2E4\uD589\uD558\uB824\uBA74 \uB044\uC138\uC694.",color:"\uCD5C\uC18C \uBC30\uACBD \uC0C9\uC0C1",colorDesc:"\uCD5C\uC18C \uC131\uB2A5 \uB2E8\uACC4\uC5D0\uC11C \uD648 \uD654\uBA74 \uB4A4\uC5D0 \uD45C\uC2DC\uD560 \uB2E8\uC0C9\uC785\uB2C8\uB2E4. \uC608: #4a4459",effects:"\uC774 \uB2E8\uACC4\uC5D0\uC11C \uC801\uC6A9\uB418\uB294 \uD6A8\uACFC:",effectSkyHalf:"\uB0A0\uC528 \uBC30\uACBD\uC744 \uC808\uBC18 \uBC00\uB3C4\uB85C \uD45C\uC2DC",effectBackground:"\uC774\uBBF8\uC9C0, GIF, \uD22C\uBA85\uB3C4, \uD750\uB9BC \uC5C6\uC774 \uB2E8\uC0C9 \uBC30\uACBD \uC0AC\uC6A9",effectOpaque:"\uBC18\uD22C\uBA85 \uB300\uC2E0 \uBD88\uD22C\uBA85\uD55C \uCE74\uB4DC \uC0AC\uC6A9",effectFrost:"\uCE74\uB4DC \uB4A4 \uBC18\uD22C\uBA85 \uC720\uB9AC \uD750\uB9BC \uD6A8\uACFC \uB044\uAE30",effectMotion:"\uC804\uD658, \uB9C8\uC6B0\uC2A4 \uC624\uBC84 \uC774\uB3D9, \uADF8\uB9BC\uC790, \uC560\uB2C8\uBA54\uC774\uC158 \uB044\uAE30",effectRefresh:"\uC6F9, RSS, \uCE98\uB9B0\uB354 \uAD6C\uB3C5, Jira \uCE74\uB4DC\uC758 \uC790\uB3D9 \uC0C8\uB85C \uACE0\uCE68 \uC911\uC9C0 (\uC218\uB3D9 \uC0C8\uB85C \uACE0\uCE68 \uAC00\uB2A5)",effectLiveRefresh:"\uBCF4\uAD00\uD568 \uBCC0\uACBD \uC2DC \uB300\uC2DC\uBCF4\uB4DC \uC790\uB3D9 \uAC31\uC2E0 \uC911\uC9C0",effectClock:"\uC2DC\uACC4 \uCE74\uB4DC\uC5D0\uC11C \uCD08\uC640 \uCD08\uCE68 \uC228\uAE30\uAE30",effectSlideshow:"\uC2AC\uB77C\uC774\uB4DC \uC1FC \uCE74\uB4DC\uC5D0\uC11C \uD55C \uC774\uBBF8\uC9C0 \uACE0\uC815",vibrancyFrost:"Obsidian\uC758 \uBC18\uD22C\uBA85 \uCC3D\uC774 \uCF1C\uC838 \uC788\uC744 \uB54C \uD750\uB9BC \uD6A8\uACFC\uB97C \uB055\uB2C8\uB2E4. \uC124\uC815\uC740 \uC720\uC9C0\uB418\uBA70 \uBC18\uD22C\uBA85 \uCC3D\uC744 \uB044\uBA74 \uB2E4\uC2DC \uC801\uC6A9\uB429\uB2C8\uB2E4.",overridden:"\uD604\uC7AC \uC131\uB2A5 \uB2E8\uACC4\uAC00 \uC774 \uC124\uC815\uC744 \uC7AC\uC815\uC758\uD569\uB2C8\uB2E4. \uC124\uC815\uAC12\uC740 \uBCF4\uC874\uB418\uBA70 \uB2E8\uACC4\uB97C \uB192\uC774\uBA74 \uB2E4\uC2DC \uC801\uC6A9\uB429\uB2C8\uB2E4."},background:{...M.settings.background,heading:"\uBC30\uACBD",headingDesc:"\uD648 \uD654\uBA74 \uBC30\uACBD\uACFC \uBC30\uACBD\uC774 \uBE44\uCE58\uB294 \uC815\uB3C4\uB97C \uC124\uC815\uD569\uB2C8\uB2E4.",type:"\uBC30\uACBD \uC720\uD615",typeDesc:"\uD648 \uD654\uBA74 \uB4A4\uC5D0 \uD45C\uC2DC\uD560 \uD56D\uBAA9\uC785\uB2C8\uB2E4.",value:"\uBC30\uACBD \uAC12",valueColorDesc:"CSS \uC0C9\uC0C1\uC785\uB2C8\uB2E4. \uC608: #1e1e2e \uB610\uB294 rgb(30,30,46)",valueImageDesc:"\uBCF4\uAD00\uD568 \uC774\uBBF8\uC9C0 \uACBD\uB85C\uC785\uB2C8\uB2E4. \uC608: Attachments/bg.png",valueUrlDesc:"\uC9C1\uC811 \uC5F0\uACB0\uB418\uB294 \uC774\uBBF8\uC9C0 URL\uC785\uB2C8\uB2E4.",valueVideoDesc:"\uBCF4\uAD00\uD568 \uB3D9\uC601\uC0C1 \uACBD\uB85C\uC785\uB2C8\uB2E4. \uC608: Attachments/loop.mp4. \uC18C\uB9AC \uC5C6\uC774 \uBC18\uBCF5 \uC7AC\uC0DD\uB429\uB2C8\uB2E4.",videoNote:"\uB3D9\uC601\uC0C1 \uBC30\uACBD\uC740 Hearth\uAC00 \uADF8\uB9B4 \uC218 \uC788\uB294 \uAC83 \uC911 \uAC00\uC7A5 \uBB34\uAC81\uC2B5\uB2C8\uB2E4. \uBCF4\uB4DC\uAC00 \uC5F4\uB824 \uC788\uB294 \uB3D9\uC548 \uACC4\uC18D \uD504\uB808\uC784\uC744 \uB514\uCF54\uB529\uD569\uB2C8\uB2E4. \uC131\uB2A5 \uB2E8\uACC4\uAC00 \uC804\uCCB4\uC77C \uB54C\uB9CC \uC7AC\uC0DD\uB418\uACE0, \uADE0\uD615 \uC774\uD558\uC5D0\uC11C\uB294 \uCCAB \uD504\uB808\uC784\uC5D0\uC11C \uBA48\uCDB0 \uC788\uC2B5\uB2C8\uB2E4.",externalCallsDisabled:"\uB3D9\uC791 \u2192 \uAC1C\uC778\uC815\uBCF4 \uBC0F \uB124\uD2B8\uC6CC\uD06C\uC5D0\uC11C \uC678\uBD80 \uC694\uCCAD\uC744 \uB044\uBA74 \uC6F9 \uBC30\uACBD\uC744 \uAC00\uC838\uC62C \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uBCF4\uAD00\uD568 \uC774\uBBF8\uC9C0\uB97C \uC120\uD0DD\uD558\uAC70\uB098 \uC124\uC815\uC744 \uCF1C\uC138\uC694.",opacity:"\uBD88\uD22C\uBA85\uB3C4",opacityDesc:"\uBC30\uACBD\uC774 \uBE44\uCE58\uB294 \uC815\uB3C4\uC785\uB2C8\uB2E4. \uB0AE\uC744\uC218\uB85D \uC740\uC740\uD558\uAC8C \uD45C\uC2DC\uB429\uB2C8\uB2E4.",blur:"\uD750\uB9BC",blurDesc:"\uBC30\uACBD \uD750\uB9BC \uC815\uB3C4\uB97C \uD53D\uC140 \uB2E8\uC704\uB85C \uC124\uC815\uD569\uB2C8\uB2E4.",layout:"\uBC30\uACBD \uBC30\uCE58",layoutDesc:"\uBC30\uACBD\uC744 \uD654\uBA74 \uC804\uCCB4\uC5D0 \uD45C\uC2DC\uD558\uAC70\uB098 \uB178\uD2B8\uC758 \uD45C\uC9C0\uCC98\uB7FC \uBCF4\uB4DC \uC0C1\uB2E8 \uBC30\uB108\uB85C \uD45C\uC2DC\uD569\uB2C8\uB2E4. \uB300\uC2DC\uBCF4\uB4DC\uBCC4\uB85C \uC7AC\uC815\uC758\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.",layoutLabels:{full:"\uC804\uCCB4 \uBC30\uACBD",banner:"\uBC30\uB108"},bannerHeight:"\uBC30\uB108 \uB192\uC774",bannerHeightDesc:"\uBC30\uB108 \uB192\uC774\uB97C \uD53D\uC140 \uB2E8\uC704\uB85C \uC124\uC815\uD569\uB2C8\uB2E4.",bannerFade:"\uC544\uB798\uCABD \uAC00\uC7A5\uC790\uB9AC \uD750\uB9AC\uAE30",ba