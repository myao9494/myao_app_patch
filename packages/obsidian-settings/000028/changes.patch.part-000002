-        const listEnd = listUnderSelectionFrom.getContentEndIncludingChildren();
-        this.stopPropagation = true;
-        this.updated = true;
-        if (selectionFrom.line === contentStart.line &&
-            selectionFrom.ch === contentStart.ch &&
