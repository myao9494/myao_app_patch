+			"roundness": null,
+			"text": "① Webアプリからドラッグ＆ドロップ",
+			"fontSize": 18,
+			"fontFamily": 1,
+			"textAlign": "left",
+			"verticalAlign": "top",
+			"rawText": "① Webアプリからドラッグ＆ドロップ"
+		},
+		{
+			"type": "text",
+			"version": 1,
+			"versionNonce": 1,
+			"isDeleted": false,
+			"id": "step1-desc",
+			"fillStyle": "solid",
+			"strokeWidth": 2,
+			"strokeStyle": "solid",
+			"roughness": 1,
+			"opacity": 100,
+			"angle": 0,
+			"x": 60,
+			"y": 165,
+			"strokeColor": "#212529",
+			"backgroundColor": "transparent",
+			"width": 750,
+			"height": 20,
+			"seed": 105,
+			"groupIds": [],
+			"roundness": null,
+			"text": "JSONデータを解析し localhost:8001 の open-path リンクを即座に挿入",
+			"fontSize": 14,
+			"fontFamily": 1,
+			"textAlign": "left",
+			"verticalAlign": "top",
+			"rawText": "JSONデータを解析し localhost:8001 の open-path リンクを即座に挿入"
+		},
+		{
+			"type": "text",
+			"version": 1,
+			"versionNonce": 1,
+			"isDeleted": false,
+			"id": "step1-link",
+			"fillStyle": "solid",
+			"strokeWidth": 2,
+			"strokeStyle": "solid",
+			"roughness": 1,
+			"opacity": 100,
+			"angle": 0,
