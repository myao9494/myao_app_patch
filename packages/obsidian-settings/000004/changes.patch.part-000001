+			"fontFamily": 1,
+			"text": "サマリー作成時のMSGメール本文クリーン展開フロー",
+			"textAlign": "left",
+			"verticalAlign": "top",
+			"containerId": null,
+			"originalText": "サマリー作成時のMSGメール本文クリーン展開フロー"
+		},
+		{
+			"type": "rectangle",
+			"version": 1,
+			"versionNonce": 1,
+			"isDeleted": false,
+			"id": "box-step1",
