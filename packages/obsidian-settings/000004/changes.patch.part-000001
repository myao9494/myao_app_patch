 }
 window._customTopNoteListLinkClickListener = handleTopNoteListLinkClick;
 document.addEventListener("click", window._customTopNoteListLinkClickListener, true);
+
+/**
+ * ファイルマネージャーからのドラッグ＆ドロップを検知し、localhost:8001リンクを挿入する
+ **/
+const handleFileManagerDrop = (e) => {
+    if (!e.dataTransfer) return;
+    const text = e.dataTransfer.getData("text/plain");
+    const items = parseFileManagerData(text);
+    if (!items || items.length === 0) return;
+
+    // ドロップ対象がエディタ内か、またはアクティブなエディタがあるか確認
+    const MarkdownViewClass = tp?.obsidian?.MarkdownView || window?.obsidian?.MarkdownView;
+    const activeView = (typeof app !== "undefined" && app.workspace.getActiveViewOfType)
+        ? app.workspace.getActiveViewOfType(MarkdownViewClass)
+        : null;
+    const editor = activeView?.editor;
+    if (!editor) return;
+
+    e.preventDefault();
+    e.stopPropagation();
+    e.stopImmediatePropagation();
+
+    const linkMarkdown = generateFileManagerMarkdown(items);
+
+    let insertPos = null;
+    const cm = editor.cm;
+    if (cm && typeof cm.posAtCoords === "function") {
+        const offset = cm.posAtCoords({ x: e.clientX, y: e.clientY });
+        if (offset !== null) {
+            insertPos = editor.offsetToPos(offset);
+        }
+    }
+    if (!insertPos && typeof editor.posAtCoords === "function") {
+        insertPos = editor.posAtCoords({ x: e.clientX, y: e.clientY });
+    }
+    if (!insertPos) {
+        insertPos = editor.getCursor();
+    }
+
+    editor.replaceRange(linkMarkdown, insertPos);
+};
+
+if (window._customFileManagerDropListener) {
+    document.removeEventListener("drop", window._customFileManagerDropListener, true);
+}
+window._customFileManagerDropListener = handleFileManagerDrop;
+document.addEventListener("drop", window._customFileManagerDropListener, true);
+
+/**
+ * 閲覧モード（Reading View）等で open-path リンクを右クリックした際のコンテキストメニュー
+ **/
+const handleFileManagerLinkContextMenu = (e) => {
+    const linkEl = e.target?.closest?.("a[href*='localhost:8001/api/open-path']");
+    if (!linkEl) return;
+
+    const href = linkEl.getAttribute("href") || linkEl.href;
+    const sourcePath = extractOpenPathFromLink(href);
+    if (!sourcePath) return;
+
+    const MenuClass = tp?.obsidian?.Menu || window?.obsidian?.Menu || (typeof Menu !== "undefined" ? Menu : null);
+    if (!MenuClass) return;
+
+    const activeFile = typeof app !== "undefined" ? app.workspace.getActiveFile() : null;
+    if (!activeFile) return;
+
+    e.preventDefault();
+    e.stopPropagation();
+
+    const menu = new MenuClass();
+    menu.addItem((item) => {
+        item
+            .setTitle("コピーして同一フォルダーに保存")
+            .setIcon("folder-input")
+            .onClick(async () => {
+                const res = await executeCopyAndConvertLink({
+                    sourceFilePath: sourcePath,
+                    originalLinkText: href
+                });
+                if (res?.success && res.newLink) {
+                    const fileContent = await app.vault.read(activeFile);
+                    const escapedHref = href.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+                    const linkRegex = new RegExp(`(?:\\[[^\\]]*\\]\\(${escapedHref}\\)|${escapedHref})`);
+                    const updatedContent = fileContent.replace(linkRegex, res.newLink);
+                    if (updatedContent !== fileContent) {
+                        await app.vault.modify(activeFile, updatedContent);
+                    }
+                }
+            });
+    });
+    menu.showAtMouseEvent(e);
+};
+
+if (window._customFileManagerLinkContextMenuListener) {
+    document.removeEventListener("contextmenu", window._customFileManagerLinkContextMenuListener, true);
+}
+window._customFileManagerLinkContextMenuListener = handleFileManagerLinkContextMenu;
+document.addEventListener("contextmenu", window._customFileManagerLinkContextMenuListener, true);
 %>
diff --git a/docs/create_summary.md b/docs/create_summary.md
index 6b8149ef7e781af9e282b8a9277d61fa325f1ed5..c886c447bac2b059cb78ae52243ab98c357df388 100644
--- a/docs/create_summary.md
+++ b/docs/create_summary.md
@@ -59,7 +59,11 @@ Obsidian上で開いているマークダウンファイル（通常の `.md` 
      - **件名**: `Subject` (プロパティ `0037`)
      - **送信者**: `SenderName` (プロパティ `0C1A`)
      - **送信日時**: `SentOn` (プロパティ `0039` = PR_CLIENT_SUBMIT_TIME を優先、フォールバック: `0E06` = PR_MESSAGE_DELIVERY_TIME。通常、OutlookのMSGファイル内ではこれら8バイト値は個別ファイルではなく `__properties_version1.0` ストリームにインラインで格納されるため、同ストリームから直接解析します。FILETIME 8バイト値から UTC 基準で解析し `YYYY-MM-DD HH:mm:ss` 形式で表示)
-     - **本文**: `Body` (プロパティ `1000`)。もしプレーンテキストの本文（プロパティ `1000`）が存在しない、あるいは空の場合は、HTML本文（プロパティ `1013` = `PR_HTML`、特に `10130102` などの PT_BINARY ストリーム）の取得を試み、HTMLタグ（`<script>`や`<style>`を含む）を簡易除去したプレーンテキストを本文としてフォールバック採用します。
+     - **本文**: `Body` (プロパティ `1000`)。
+       - プレーンテキストの本文が存在し、埋め込み画像がない場合は、タグの誤爆や文字化けを防ぐため、整ったプレーンテキスト（`parsed.Body`）を最優先でサマリーに採用します。
+       - 埋め込み画像を含む場合、またはプレーンテキスト本文が存在しない場合はHTML本文（プロパティ `1013` = `PR_HTML`）を解析します。
+       - HTML本文をテキスト/Markdown化する際は、`sanitizeOutlookHtml` により Outlook/Office 特有のメタデータ・コメント（`<!--[if ...]>...<![endif]-->`、`<xml>...</xml>`、`<o:p>...</o:p>`、`<head>`、`<style>`、MSOクラス等）を完全除去し、「`< >`」タグの残骸や文字化けがサマリー内に露出するのを確実に防止します。
+       - メール本文中の山括弧は安全にエスケープされ、Obsidian上での意図しないHTML再実行を防ぎます。
    - デコード時の文字コード対応：
      - UTF-16LE 形式 (`001F` 系のストリーム) だけでなく、Windows のクラシック Outlook からドラッグ＆ドロップされた Shift-JIS / CP932 形式 (`001E` 系のストリーム) の ANSI 文字列、さらには HTML 本文などに用いられる `PT_BINARY` 形式 (`0102` 系のストリーム。主に `PR_HTML` 向け) も文字化けなく正常に復号します。
      - `PT_BINARY` ストリームのデコード時は、まず UTF-8 で仮デコードして HTML 内の `charset` 設定（例: `charset=utf-8` や `charset=shift_jis`）を検出し、指定されたエンコーディングがある場合は `TextDecoder` で再デコードします。
diff --git a/docs/file_manager_dnd_and_copy_diagram.excalidraw.md b/docs/file_manager_dnd_and_copy_diagram.excalidraw.md
new file mode 100644
index 0000000000000000000000000000000000000000..3fe7521bd38ed0ef703e7b812a05e57d35debf6d
--- /dev/null
+++ b/docs/file_manager_dnd_and_copy_diagram.excalidraw.md
@@ -0,0 +1,472 @@
+<!--
+/**
+ * ファイルマネージャー連携（ドラッグ＆ドロップと同一フォルダー保存）の処理フロー設計図
+ * 
+ * 1. Webアプリ (localhost:8001) からObsidianへDnD -> [name](http://localhost:8001/api/open-path?path=...) リンク生成
+ * 2. リンクを右クリック -> 「コピーして同一フォルダーに保存」メニュー表示
+ * 3. 実行 -> リンク先ファイルをノートと同階層にコピー -> Obsidianリンク (![[...]] / [[...]]) に置換
+ **/
+-->
+---
+
+excalidraw-plugin: parsed
+tags: [excalidraw]
+
+---
+==⚠  Switch to EXCALIDRAW VIEW in the MORE OPTIONS menu of this document. ⚠== You can decompress Drawing data with the command palette: 'Decompress current Excalidraw file'. For more info check in plugin settings under 'Saving'
+
+# Excalidraw Data
+
+## Text Elements
+ファイルマネージャー連携（DnDリンク生成 ＆ 同一フォルダ保存） ^title
+① Webアプリからドラッグ＆ドロップ ^step1-title
+JSONデータを解析し localhost:8001 の open-path リンクを即座に挿入 ^step1-desc
+[aaa.md](http://localhost:8001/api/open-path?path=/Users/...) ^step1-link
+② 右クリックメニューの追加 ^step2-title
+エディタ（editor-menu）＆ 閲覧モード（contextmenu）の両方に対応 ^step2-desc
+「コピーして同一フォルダーに保存」 ^step2-menu
+③ 同一フォルダへのコピー ＆ Obsidianリンク変換 ^step3-title
+1. 元ファイルの存在確認（なければNotice通知） ^step3-p1
+2. 同階層に同名ファイルがあれば上書き確認ダイアログ ^step3-p2
+3. fs.copyFileSync でノートと同じフォルダーへ安全コピー（関連画像・添付ファイルも一括コピー！） ^step3-p3
+4. 画像は ![[xxx.png]]、他は [[xxx.md]] に自動置換！ ^step3-p4
+
+## Drawing
+```json
+{
+	"type": "excalidraw",
+	"version": 2,
+	"source": "https://excalidraw.com",
+	"elements": [
+		{
+			"type": "rectangle",
+			"version": 1,
+			"versionNonce": 1,
+			"isDeleted": false,
+			"id": "box-header",
+			"fillStyle": "solid",
+			"strokeWidth": 2,
+			"strokeStyle": "solid",
+			"roughness": 1,
+			"opacity": 100,
+			"angle": 0,
+			"x": 40,
+			"y": 30,
+			"strokeColor": "#1971c2",
+			"backgroundColor": "#1864ab22",
+			"width": 860,
+			"height": 60,
+			"seed": 101,
+			"groupIds": [],
+			"roundness": { "type": 3 }
+		},
+		{
+			"type": "text",
+			"version": 1,
+			"versionNonce": 1,
+			"isDeleted": false,
+			"id": "title",
+			"fillStyle": "solid",
+			"strokeWidth": 2,
+			"strokeStyle": "solid",
+			"roughness": 1,
+			"opacity": 100,
+			"angle": 0,
+			"x": 60,
+			"y": 45,
+			"strokeColor": "#1864ab",
+			"backgroundColor": "transparent",
+			"width": 700,
+			"height": 30,
+			"seed": 102,
+			"groupIds": [],
+			"roundness": null,
+			"text": "ファイルマネージャー連携（DnDリンク生成 ＆ 同一フォルダ保存）",
+			"fontSize": 22,
+			"fontFamily": 1,
+			"textAlign": "left",
+			"verticalAlign": "top",
+			"rawText": "ファイルマネージャー連携（DnDリンク生成 ＆ 同一フォルダ保存）"
+		},
+		{
+			"type": "rectangle",
+			"version": 1,
+			"versionNonce": 1,
+			"isDeleted": false,
+			"id": "card-step1",
+			"fillStyle": "solid",
+			"strokeWidth": 2,
+			"strokeStyle": "solid",
+			"roughness": 1,
+			"opacity": 100,
+			"angle": 0,
+			"x": 40,
+			"y": 120,
+			"strokeColor": "#2b8a3e",
