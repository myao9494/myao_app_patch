diff --git a/.obsidian/plugins/step-viewer/manifest.json b/.obsidian/plugins/step-viewer/manifest.json
new file mode 100644
index 0000000000000000000000000000000000000000..87764d459a3750a675595fb5734dad87f29fd6be
--- /dev/null
+++ b/.obsidian/plugins/step-viewer/manifest.json
@@ -0,0 +1,10 @@
+{
+  "id": "step-viewer",
+  "name": "STEP Viewer",
+  "version": "1.13.0",
+  "minAppVersion": "1.5.0",
+  "description": "Open and view STEP (.step/.stp), FreeCAD (.FCStd), OBJ and STL CAD models in an interactive 3D viewer.",
+  "author": "Ondřej Uhnavý",
+  "authorUrl": "https://github.com/ondreu",
+  "isDesktopOnly": false
+}
diff --git a/.obsidian/plugins/step-viewer/styles.css b/.obsidian/plugins/step-viewer/styles.css
new file mode 100644
index 0000000000000000000000000000000000000000..9e994c5bef8149fc901b66316da4b4d4fd5ed723
--- /dev/null
+++ b/.obsidian/plugins/step-viewer/styles.css
@@ -0,0 +1,1043 @@
+/* STEP Viewer plugin styles (design doc §8).
+   Uses Obsidian CSS variables so the viewer matches the active theme. */
+
+.step-viewer-content {
+  padding: 0;
+  height: 100%;
+}
+
+.step-viewer-host {
+  position: relative;
+  width: 100%;
+  height: 100%;
+  overflow: hidden;
+  background-color: var(--background-primary);
+}
+
+.step-viewer-canvas {
+  display: block;
+  width: 100%;
+  height: 100%;
+}
+
+/* --- Toolbar overlay --- */
+/* Right-side rail: view cube, roll arrows and toolbar stacked top-right. */
+.step-viewer-rail {
+  position: absolute;
+  top: var(--size-4-2);
+  right: var(--size-4-2);
+  display: flex;
+  flex-direction: column;
+  align-items: flex-end;
+  gap: var(--size-4-2);
+  z-index: 10;
+}
+
+.step-viewer-viewcube {
+  width: 96px;
+  height: 96px;
+  cursor: pointer;
+}
+
+.step-viewer-roll {
+  display: flex;
+  gap: var(--size-2-1);
+  padding: var(--size-2-1);
+  border-radius: var(--radius-m);
+  background-color: var(--background-secondary);
+  box-shadow: var(--shadow-s);
+}
+
+.step-viewer-toolbar {
+  display: flex;
+  flex-direction: column;
+  gap: var(--size-2-1);
+  padding: var(--size-2-1);
+  border-radius: var(--radius-m);
+  background-color: var(--background-secondary);
+  box-shadow: var(--shadow-s);
+}
+
+
+.step-viewer-btn {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  cursor: pointer;
+  color: var(--text-muted);
+}
+
+.step-viewer-btn:hover {
+  color: var(--text-normal);
+  background-color: var(--background-modifier-hover);
+}
+
+.step-viewer-btn.is-active {
+  color: var(--text-accent);
+  background-color: var(--background-modifier-active-hover);
+}
+
+/* --- Measurement / annotate cursor --- */
+.step-viewer-host.is-measuring .step-viewer-canvas,
+.step-viewer-host.is-annotating .step-viewer-canvas {
+  cursor: crosshair;
+}
+
+/* --- Immersive (walk / fly) mode: centre crosshair + controls hint --- */
+.step-viewer-host.is-immersive .step-viewer-canvas {
+  cursor: none;
+}
+.step-viewer-host.is-immersive::after {
+  content: "";
+  position: absolute;
+  left: 50%;
+  top: 50%;
+  width: 14px;
+  height: 14px;
+  transform: translate(-50%, -50%);
+  border: 1.5px solid rgba(255, 255, 255, 0.85);
+  border-radius: 50%;
+  box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.5);
+  pointer-events: none;
+  z-index: 20;
+}
+.step-viewer-host.is-immersive::before {
+  content: "WASD move · Q/E down/up · Shift faster · mouse look · Esc exit";
+  position: absolute;
+  left: 50%;
+  bottom: 14px;
+  transform: translateX(-50%);
+  padding: 4px 10px;
+  font-size: 11px;
+  color: var(--text-on-accent, #fff);
+  background: rgba(0, 0, 0, 0.55);
+  border-radius: 6px;
+  white-space: nowrap;
+  pointer-events: none;
+  z-index: 20;
+}
+
+/* --- Projected HTML labels (measurement numbers + annotations) --- */
+.step-viewer-labels {
+  position: absolute;
+  inset: 0;
+  overflow: hidden;
+  pointer-events: none;
+}
+
+.step-viewer-labels > * {
+  position: absolute;
+  top: 0;
+  left: 0;
+  will-change: transform;
+}
+
+/* Labels whose anchor is behind the camera / outside the depth range. The
+   two-class selector outweighs the per-label display rules (e.g. annotations
+   use display:flex) without needing !important. */
+.step-viewer-labels > .step-viewer-label-offscreen {
+  display: none;
+}
+
+.step-viewer-mlabel {
+  padding: 1px 6px;
+  border-radius: var(--radius-s);
+  background-color: var(--background-secondary);
+  box-shadow: var(--shadow-s);
+  font-size: var(--font-ui-smaller);
+  font-weight: var(--font-semibold);
+  font-variant-numeric: tabular-nums;
+  white-space: nowrap;
+}
+
+.step-viewer-annot {
+  display: flex;
+  align-items: flex-start;
+  gap: var(--size-2-1);
+  max-width: 200px;
+  padding: var(--size-2-1) var(--size-2-2);
+  border-radius: var(--radius-s);
+  border: 1px solid var(--background-modifier-border);
+  background-color: var(--background-secondary);
+  box-shadow: var(--shadow-s);
+  pointer-events: auto;
+}
+
+.step-viewer-annot-body {
+  display: flex;
+  flex-direction: column;
+  gap: var(--size-2-1);
+  min-width: 0;
+}
+
+.step-viewer-annot-tools {
+  display: flex;
+  align-items: center;
+  gap: var(--size-2-1);
+  padding-bottom: var(--size-2-1);
+  border-bottom: 1px solid var(--background-modifier-border);
+}
+
+.step-viewer-annot-tool {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 22px;
+  height: 22px;
+  padding: 0;
+  border: none;
+  border-radius: var(--radius-s);
+  background: transparent;
+  color: var(--text-muted);
+  cursor: pointer;
+}
+
+.step-viewer-annot-tool:hover {
+  color: var(--text-normal);
+  background-color: var(--background-modifier-hover);
+}
+
+.step-viewer-annot-tool.is-active {
+  color: var(--text-on-accent);
+  background-color: var(--interactive-accent);
+}
+
+.step-viewer-annot-tool svg {
+  width: 15px;
+  height: 15px;
+}
+
+/* Delete button sits at the far right of the tools row. */
+.step-viewer-annot-del {
+  margin-left: auto;
+}
+
+/* Colour swatch button + palette popover. */
+.step-viewer-annot-swatch {
+  border: 1px solid var(--background-modifier-border);
+}
+
+.step-viewer-annot-swatch:hover {
+  background-color: inherit; /* keep the swatch colour on hover */
+}
+
+.step-viewer-annot-palette {
+  display: flex;
+  gap: var(--size-2-1);
+  padding: var(--size-2-1) 0;
+}
+
+.step-viewer-annot-palette-swatch {
+  width: 20px;
+  height: 20px;
+  padding: 0;
+  border: 1px solid var(--background-modifier-border);
+  border-radius: var(--radius-s);
+  cursor: pointer;
+}
+
+.step-viewer-annot-palette-swatch:hover {
+  outline: 2px solid var(--interactive-accent);
+  outline-offset: 1px;
+}
+
+/* Custom-colour picker sitting alongside the preset swatches. */
+.step-viewer-annot-palette-custom {
+  width: 22px;
+  height: 20px;
+  padding: 0;
+  border: 1px solid var(--background-modifier-border);
+  border-radius: var(--radius-s);
+  cursor: pointer;
+  background: none;
+}
+
+.step-viewer-annot-palette-custom::-webkit-color-swatch-wrapper {
+  padding: 2px;
+}
+
+.step-viewer-annot-palette-custom::-webkit-color-swatch {
+  border: none;
+  border-radius: 2px;
+}
+
+/* Leader arrowhead (points at the anchor). */
+.step-viewer-leader-arrow {
+  fill: var(--text-muted);
+}
+
+.step-viewer-annot-text {
+  min-width: 60px;
+  font-size: var(--font-ui-smaller);
+  color: var(--text-normal);
+  outline: none;
+  white-space: pre-wrap;
+  word-break: break-word;
+}
+
+.step-viewer-annot-text:empty::before {
+  content: attr(data-placeholder);
+  color: var(--text-faint);
+}
+
+.step-viewer-annot-del {
+  flex: 0 0 auto;
+  width: 18px;
+  height: 18px;
+  padding: 0;
+  line-height: 1;
+  border: none;
+  border-radius: var(--radius-s);
+  background: transparent;
+  color: var(--text-muted);
+  cursor: pointer;
+}
+
+.step-viewer-annot-del:hover {
+  color: var(--text-error);
+  background-color: var(--background-modifier-hover);
+}
+
+.step-viewer-annot.is-hidden {
+  display: none;
+}
+
+.step-viewer-annot.is-flash {
+  outline: 2px solid var(--interactive-accent);
+  outline-offset: 1px;
+}
+
+/* Collapsed marker used in hover-only mode. */
+.step-viewer-annot-dot {
+  display: none;
+  flex: 0 0 auto;
+  width: 11px;
+  height: 11px;
+  border-radius: 50%;
+  background-color: #ffc531;
+  box-shadow: 0 0 0 2px var(--background-primary);
+}
+
+/* Hover-only: collapse to just the dot; expand the note on hover. */
+.step-viewer-annot.is-hover-only {
+  padding: 0;
+  border-color: transparent;
+  background-color: transparent;
+  box-shadow: none;
+}
+
+.step-viewer-annot.is-hover-only .step-viewer-annot-dot {
+  display: block;
+}
+
+.step-viewer-annot.is-hover-only .step-viewer-annot-body {
+  display: none;
+}
+
+.step-viewer-annot.is-hover-only:hover {
+  padding: var(--size-2-1) var(--size-2-2);
+  border-color: var(--background-modifier-border);
+  background-color: var(--background-secondary);
+  box-shadow: var(--shadow-s);
+}
+
+.step-viewer-annot.is-hover-only:hover .step-viewer-annot-dot {
+  display: none;
+}
+
+.step-viewer-annot.is-hover-only:hover .step-viewer-annot-body {
+  display: flex;
+}
+
+/* Leader mode: the toolbar strip doubles as a drag handle. */
+.step-viewer-annot.is-leader .step-viewer-annot-tools {
+  cursor: move;
+}
+
+.step-viewer-annot.is-dragging {
+  opacity: 0.85;
+  user-select: none;
+}
+
+/* Leader connector lines (drawn behind the labels). */
+.step-viewer-leaders {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  overflow: visible;
+  pointer-events: none;
+}
+
+.step-viewer-leader-line {
+  stroke: var(--text-muted);
+  stroke-width: 1.5;
+  stroke-dasharray: 3 3;
+  opacity: 0.85;
+}
+
+/* Leader line hidden while its label is off-screen or pinned on the anchor. */
+.step-viewer-leader-line.is-hidden {
+  display: none;
+}
+
+/* Pinned (persistent) measurement labels. */
+.step-viewer-mpinned {
+  display: flex;
+  align-items: center;
+  gap: var(--size-2-1);
+  padding: 1px var(--size-2-1) 1px var(--size-2-2);
+  border-radius: var(--radius-s);
+  border: 1px solid var(--background-modifier-border);
+  background-color: var(--background-secondary);
+  box-shadow: var(--shadow-s);
+  font-size: var(--font-ui-smaller);
+  font-weight: var(--font-semibold);
+  font-variant-numeric: tabular-nums;
+  white-space: nowrap;
+  pointer-events: auto;
+}
+
+.step-viewer-mpinned-text {
+  color: #ff5500;
+}
+
+.step-viewer-mpinned-del {
+  width: 16px;
+  height: 16px;
+  padding: 0;
+  line-height: 1;
+  border: none;
+  border-radius: var(--radius-s);
+  background: transparent;
+  color: var(--text-muted);
+  cursor: pointer;
+}
+
+.step-viewer-mpinned-del:hover {
+  color: var(--text-error);
+  background-color: var(--background-modifier-hover);
+}
+
+.step-viewer-mpinned.is-hidden {
+  display: none;
+}
+
+.step-viewer-mpinned.is-flash {
+  outline: 2px solid var(--interactive-accent);
+  outline-offset: 1px;
+}
+
+/* --- Annotations list panel --- */
+.step-viewer-annots {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  max-height: 45vh;
+  width: 240px;
+  border-radius: var(--radius-m);
+  background-color: var(--background-secondary);
+  box-shadow: var(--shadow-s);
+  overflow: hidden;
+}
+
+/* --- Measurements section in the annotations list --- */
+.step-viewer-annots-subhead {
+  padding: var(--size-2-2) var(--size-4-2) var(--size-2-1);
+  font-size: var(--font-ui-smaller);
+  font-weight: var(--font-semibold);
+  color: var(--text-muted);
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+  border-top: 1px solid var(--background-modifier-border);
+}
+
+.step-viewer-annots-mdot {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 14px;
+  height: 14px;
+  margin-top: 2px;
+  background: none;
+  color: var(--text-muted);
+}
+
+.step-viewer-annots-mdot svg {
+  width: 14px;
+  height: 14px;
+}
+
+/* --- Resize grip (structure tree + annotations panels) --- */
+.step-viewer-resize-grip {
+  position: absolute;
+  right: 0;
+  bottom: 0;
+  width: 16px;
+  height: 16px;
+  cursor: nwse-resize;
+  z-index: 2;
+  /* A subtle diagonal-corner glyph drawn with a gradient of two hairlines. */
+  background-image: linear-gradient(
+    135deg,
+    transparent 0 45%,
+    var(--background-modifier-border) 45% 55%,
+    transparent 55% 70%,
+    var(--background-modifier-border) 70% 80%,
+    transparent 80%
+  );
+  opacity: 0.7;
+}
+
+.step-viewer-resize-grip:hover {
+  opacity: 1;
+}
+
+.step-viewer-tree.is-resizing,
+.step-viewer-annots.is-resizing {
+  user-select: none;
+}
+
+.step-viewer-annots-header {
+  display: flex;
+  align-items: center;
+  gap: var(--size-2-2);
+  padding: var(--size-2-1) var(--size-2-2) var(--size-2-1) var(--size-4-2);
+  border-bottom: 1px solid var(--background-modifier-border);
+}
+
+.step-viewer-annots-header .step-viewer-tree-title {
+  margin-right: auto;
+}
+
+.step-viewer-annots-opacity {
+  width: 70px;
+}
+
+.step-viewer-annots-body {
+  flex: 1;
+  min-height: 0;
+  overflow: auto;
+  padding: var(--size-2-1) 0;
+}
+
+.step-viewer-annots-empty {
+  padding: var(--size-2-2) var(--size-4-2);
+  font-size: var(--font-ui-smaller);
+  color: var(--text-muted);
+}
+
+.step-viewer-annots-row {
+  display: flex;
+  align-items: flex-start;
+  gap: var(--size-2-1);
+  padding: var(--size-2-1) var(--size-2-2) var(--size-2-1) var(--size-4-2);
+}
+
+.step-viewer-annots-row:hover {
+  background-color: var(--background-modifier-hover);
+}
+
+.step-viewer-annots-main {
+  flex: 1;
+  min-width: 0;
+  cursor: pointer;
+}
+
+.step-viewer-annots-text {
+  font-size: var(--font-ui-small);
+  color: var(--text-normal);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.step-viewer-annots-part {
+  font-size: var(--font-ui-smaller);
+  color: var(--text-muted);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.step-viewer-annots-del {
+  flex: 0 0 auto;
+}
+
+/* --- Note embeds --- */
+.step-viewer-embed-host {
+  position: relative;
+  width: 100%;
+  overflow: hidden;
+  border-radius: var(--radius-m);
+  border: 1px solid var(--background-modifier-border);
+  background-color: var(--background-primary);
+}
+
+.step-viewer-embed-placeholder {
+  gap: var(--size-2-2);
+}
+
+.step-viewer-measure-readout {
+  position: absolute;
+  left: var(--size-4-2);
+  bottom: var(--size-4-2);
+  display: flex;
+  align-items: center;
+  gap: var(--size-2-2);
+  padding: var(--size-2-2) var(--size-4-2);
+  border-radius: var(--radius-m);
+  background-color: var(--background-secondary);
+  box-shadow: var(--shadow-s);
+  color: var(--text-normal);
+  font-size: var(--font-ui-small);
+  font-variant-numeric: tabular-nums;
+  z-index: 10;
+  pointer-events: none;
+}
+
+/* The readout is click-through, but the "pin" button must accept clicks. */
+.step-viewer-measure-keep {
+  flex: 0 0 auto;
+  pointer-events: auto;
+}
+
+/* --- Measurement-type strip (under the toolbar while measuring) --- */
+.step-viewer-measure-modes {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: flex-end;
+  gap: var(--size-2-1);
+  max-width: 190px;
+  padding: var(--size-2-1);
+  border-radius: var(--radius-m);
+  background-color: var(--background-secondary);
+  box-shadow: var(--shadow-s);
+}
+
+.step-viewer-mode-btn {
+  min-width: 26px;
+  height: 26px;
+  font-size: var(--font-ui-medium);
+  line-height: 1;
+}
+
+/* --- Floating view controls (section, explode) at bottom-centre --- */
+.step-viewer-viewctls {
+  position: absolute;
+  bottom: var(--size-4-2);
+  left: 50%;
+  transform: translateX(-50%);
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: var(--size-2-2);
+  z-index: 10;
+  pointer-events: none;
+}
+
+.step-viewer-viewctl {
+  display: flex;
+  align-items: center;
+  gap: var(--size-2-2);
+  padding: var(--size-2-1) var(--size-4-2);
+  border-radius: var(--radius-m);
+  background-color: var(--background-secondary);
+  box-shadow: var(--shadow-s);
+  pointer-events: auto;
+}
+
+.step-viewer-viewctl-title {
+  font-size: var(--font-ui-smaller);
+  font-weight: var(--font-semibold);
+  color: var(--text-muted);
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+}
+
+.step-viewer-viewctl-axes {
+  display: flex;
+  gap: var(--size-2-1);
+}
+
+.step-viewer-viewctl-axis,
+.step-viewer-viewctl-flip {
+  min-width: 26px;
+  height: 24px;
+  padding: 0 var(--size-2-2);
+  font-size: var(--font-ui-smaller);
+}
+
+.step-viewer-viewctl-slider {
+  width: 150px;
+}
+
+.step-viewer-viewctl-hint {
+  font-size: var(--font-ui-smaller);
+  color: var(--text-muted);
+}
+
+/* --- Annotation extras: colour swatch, link, markdown --- */
+.step-viewer-annot-dot {
+  background-color: var(--annot-color, #ffc531);
+}
+
+.step-viewer-annot-swatch {
+  width: 14px;
+  height: 14px;
+  border-radius: 50%;
+  border: 1px solid var(--background-modifier-border);
+}
+
+.step-viewer-annot-link {
+  display: block;
+  font-size: var(--font-ui-smaller);
+  color: var(--text-accent);
+  cursor: pointer;
+  pointer-events: auto;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  max-width: 180px;
+}
+
+.step-viewer-annot-linkrow {
+  display: flex;
+}
+
+.step-viewer-annot-linkrow input {
+  width: 100%;
+  font-size: var(--font-ui-smaller);
+}
+
+.step-viewer-annot-render {
+  font-size: var(--font-ui-smaller);
+  color: var(--text-normal);
+  pointer-events: auto;
+  cursor: text;
+  max-width: 200px;
+  word-break: break-word;
+}
+
+.step-viewer-annot-render > *:first-child {
+  margin-top: 0;
+}
+
+.step-viewer-annot-render > *:last-child {
+  margin-bottom: 0;
+}
+
+/* --- Annotations panel: category filter + row dots --- */
+.step-viewer-annots-filter {
+  display: flex;
+  align-items: center;
+  gap: var(--size-2-1);
+  padding: var(--size-2-1) var(--size-4-2);
+  border-bottom: 1px solid var(--background-modifier-border);
+}
+
+.step-viewer-annots-chip {
+  min-width: 22px;
+  height: 20px;
+  padding: 0 var(--size-2-1);
+  font-size: var(--font-ui-smaller);
+  border-radius: var(--radius-s);
+  border: 1px solid var(--background-modifier-border);
+  cursor: pointer;
+  opacity: 0.5;
+}
+
+.step-viewer-annots-chip.is-active {
+  opacity: 1;
+  outline: 2px solid var(--interactive-accent);
+  outline-offset: 1px;
+}
+
+.step-viewer-annots-dot {
+  flex: 0 0 auto;
+  width: 12px;
+  height: 12px;
+  margin-top: 3px;
+  padding: 0;
+  border: 1px solid var(--background-modifier-border);
+  border-radius: 50%;
+  cursor: pointer;
+}
+
+button.step-viewer-annots-dot:hover {
+  outline: 2px solid var(--interactive-accent);
+  outline-offset: 1px;
+}
+
+/* Measurement rows use the dot slot for a ruler glyph, not a colour button. */
+.step-viewer-annots-mdot {
+  cursor: default;
+  border: none;
+}
+
+button.step-viewer-annots-mdot:hover {
+  outline: none;
+}
+
+/* Colour-picker popover opened from a list row's dot. */
+.step-viewer-annots-pop {
+  position: fixed;
+  z-index: 100;
+  display: flex;
+  gap: var(--size-2-1);
+  padding: var(--size-2-1);
+  border-radius: var(--radius-s);
+  border: 1px solid var(--background-modifier-border);
+  background-color: var(--background-secondary);
+  box-shadow: var(--shadow-m);
+}
+
+/* --- Part info panel (hover) --- */
+.step-viewer-info {
+  position: absolute;
+  right: var(--size-4-2);
+  bottom: var(--size-4-2);
+  max-width: 260px;
+  padding: var(--size-2-2) var(--size-4-2);
+  border-radius: var(--radius-m);
+  background-color: var(--background-secondary);
+  box-shadow: var(--shadow-s);
+  z-index: 10;
+  pointer-events: none;
+}
+
+.step-viewer-info-name {
+  font-size: var(--font-ui-small);
+  font-weight: var(--font-semibold);
+  color: var(--text-normal);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.step-viewer-info-meta {
+  font-size: var(--font-ui-smaller);
+  color: var(--text-muted);
+  font-variant-numeric: tabular-nums;
+}
+
+.step-viewer-info-path {
+  color: var(--text-faint);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.step-viewer-info-mat {
+  display: flex;
+  align-items: center;
+  gap: var(--size-2-1);
+  color: var(--text-normal);
+}
+
+.step-viewer-info-swatch {
+  flex: 0 0 auto;
+  width: 10px;
+  height: 10px;
+  border-radius: 2px;
+  border: 1px solid var(--background-modifier-border);
+}
+
+/* --- Left rail: stacked side panels (tree, annotations) --- */
+.step-viewer-left {
+  position: absolute;
+  top: var(--size-4-2);
+  left: var(--size-4-2);
+  display: flex;
+  flex-direction: column;
+  gap: var(--size-4-2);
+  max-height: calc(100% - var(--size-4-4));
+  z-index: 10;
+}
+
+/* --- Structure tree panel --- */
+.step-viewer-tree {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  max-height: 45vh;
+  width: 240px;
+  border-radius: var(--radius-m);
+  background-color: var(--background-secondary);
+  box-shadow: var(--shadow-s);
+  overflow: hidden;
+}
+
+.step-viewer-tree-header {
+  display: flex;
+  align-items: center;
+  gap: var(--size-2-2);
+  padding: var(--size-2-1) var(--size-2-2) var(--size-2-1) var(--size-4-2);
+  border-bottom: 1px solid var(--background-modifier-border);
+}
+
+.step-viewer-tree-count {
+  font-size: var(--font-ui-smaller);
+  color: var(--text-muted);
+  font-variant-numeric: tabular-nums;
+}
+
+.step-viewer-tree-actions {
+  display: flex;
+  align-items: center;
+  gap: var(--size-2-1);
+  margin-left: auto;
+}
+
+.step-viewer-tree-actions .step-viewer-btn {
+  width: 24px;
+  height: 24px;
+}
+
+.step-viewer-tree-filter {
+  margin: var(--size-2-1) var(--size-2-2);
+  padding: var(--size-2-1) var(--size-2-2);
+  font-size: var(--font-ui-smaller);
+}
+
+.step-viewer-tree-row.is-filtered-out {
+  display: none;
+}
+
+.step-viewer-tree-title {
+  font-size: var(--font-ui-smaller);
+  font-weight: var(--font-semibold);
+  color: var(--text-muted);
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+}
+
+.step-viewer-tree-body {
+  flex: 1;
+  min-height: 0;
+  overflow: auto;
+  padding: var(--size-2-1) 0;
+}
+
+.step-viewer-tree-row {
+  display: flex;
+  align-items: center;
+  gap: var(--size-2-1);
+  padding: 1px var(--size-4-2) 1px 0;
+  font-size: var(--font-ui-small);
+  white-space: nowrap;
+}
+
+.step-viewer-tree-row.is-active {
+  background-color: var(--background-modifier-active-hover);
+  border-radius: var(--radius-s);
+}
+
+.step-viewer-tree-caret {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 16px;
+  height: 16px;
+  flex: 0 0 auto;
+  color: var(--text-muted);
+  cursor: pointer;
+}
+
+.step-viewer-tree-caret:empty {
+  cursor: default;
+}
+
+.step-viewer-tree-check {
+  flex: 0 0 auto;
+  margin: 0;
+}
+
+.step-viewer-tree-label {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  cursor: pointer;
+  color: var(--text-normal);
+}
+
+.step-viewer-tree-label:hover {
+  color: var(--text-accent);
+}
+
+/* --- Overlays (loading / empty / error) --- */
+.step-viewer-overlay {
+  position: absolute;
+  inset: 0;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: var(--size-4-2);
+  padding: var(--size-4-4);
+  text-align: center;
+  pointer-events: none;
+}
+
+/* Overlays are click-through, but interactive controls inside them (e.g. the
+   mobile "Open anyway" button) must still receive taps. */
+.step-viewer-overlay button {
+  pointer-events: auto;
+}
+
+.step-viewer-message {
+  color: var(--text-normal);
+  font-size: var(--font-ui-medium);
+}
+
+.step-viewer-message-sub {
+  color: var(--text-muted);
+  font-size: var(--font-ui-smaller);
+  max-width: 40ch;
+}
+
+.step-viewer-error .step-viewer-message {
+  color: var(--text-error);
+}
+
+/* --- Loading spinner --- */
+.step-viewer-spinner {
+  width: 28px;
+  height: 28px;
+  border: 3px solid var(--background-modifier-border);
+  border-top-color: var(--interactive-accent);
+  border-radius: 50%;
+  animation: step-viewer-spin 0.8s linear infinite;
+}
+
+@keyframes step-viewer-spin {
+  to {
+    transform: rotate(360deg);
+  }
+}
+
+/* --- Mobile layout ---------------------------------------------------------
+   Scoped to Obsidian's body.is-mobile so the desktop layout is untouched.
+   Shrinks the fixed-size overlays and enlarges tap targets so the viewer is
+   usable on a narrow touchscreen. */
+body.is-mobile .step-viewer-viewcube {
+  width: 64px;
+  height: 64px;
+}
+
+/* Fixed-width side panels must never exceed the viewport on a narrow screen. */
+body.is-mobile .step-viewer-tree,
+body.is-mobile .step-viewer-annots {
+  width: min(240px, calc(100vw - var(--size-4-8)));
+}
+
+/* Comfortable tap targets for the toolbar / roll / view-cube buttons. */
+body.is-mobile .step-viewer-btn {
+  min-width: 40px;
+  min-height: 40px;
+}
+
+/* Keep the corner readouts within the viewport width. */
+body.is-mobile .step-viewer-info,
+body.is-mobile .step-viewer-measure-readout {
+  max-width: calc(100vw - var(--size-4-8));
+}
