+import trimesh
+import trimesh.visual
+import numpy as np
+import sys
+import os
+import re
+import json
+import struct
+import shutil
+import tempfile
+
+src = r"__AI3D_SOURCE_PATH__"
+out = r"__AI3D_OUTPUT_PATH__"
+source_ext = "__AI3D_SOURCE_EXT__"
+src_occt = src
+try:
+    src.encode('ascii')
+except UnicodeEncodeError:
