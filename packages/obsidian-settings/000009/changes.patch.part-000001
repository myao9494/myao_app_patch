+@media (max-width: 760px) {
+  .ai3d-workspace-track-top {
+    grid-template-columns: 1fr;
+    grid-template-rows: minmax(0, 1fr) 4px auto;
+  }
+  .ai3d-resize-handle-h {
+    cursor: row-resize;
