+  opacity: 0.55;
+}
+
+.ai3d-direct-workbench-knowledge {
+  gap: 4px;
+}
+
+.ai3d-direct-workbench-registered {
+  gap: 6px;
+}
+
+.ai3d-direct-workbench-registered-body {
