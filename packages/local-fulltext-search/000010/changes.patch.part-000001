diff --git a/backend/tests/test_search_service.py b/backend/tests/test_search_service.py
index ae93893f24a2cb5eaf3709af2c38c26f1df4a586..025f107cfb9f591203200140788270ce2a4ba78c 100644
--- a/backend/tests/test_search_service.py
+++ b/backend/tests/test_search_service.py
@@ -3254,3 +3254,58 @@ def test_search_excludes_results_when_filename_contains_exclude_keyword(tmp_path
     )
     assert result_folder.total == 1
     assert [item.file_name for item in result_folder.items] == ["normal_report.md"]
+
+
+def test_search_without_path_ignores_conflict_when_indexing_is_running(tmp_path: Path) -> None:
+    """
+    フォルダ未指定検索時（full_path="", skip_refresh=False）、裏でバックグラウンド更新中（409 Conflict）であっても、
+    例外で検索を中断せず既存インデックスから検索結果を返す。
+    """
+    from fastapi import HTTPException, status
+
+    connection = _create_connection(tmp_path)
+    service = SearchService(connection=connection)
+    workspace = tmp_path / "workspace"
+    workspace.mkdir()
+    now = datetime.now(tz=UTC)
+
+    # ターゲット登録
+    connection.execute(
+        """
+        INSERT INTO targets (full_path, index_depth, source_type, is_search_target_enabled, created_at, updated_at)
+        VALUES (?, 5, 'local', 1, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)
+        """,
+        (str(workspace),),
+    )
+    connection.commit()
+
+    # 既存インデックスを登録
+    _insert_indexed_markdown(
+        connection=connection,
+        file_name="existing_doc.md",
+        full_path=str(workspace / "existing_doc.md"),
+        created_at=now,
+        mtime=now,
+        body="sample content keyword_target",
+        click_count=0,
+        source_type="local",
+    )
+
+    # ensure_fresh_target が 409 CONFLICT を投げるようにモック化（バックグラウンド更新中を模倣）
+    def mock_ensure_fresh_target(**kwargs):
+        raise HTTPException(status_code=status.HTTP_409_CONFLICT, detail="Indexing is already running.")
+
+    service.index_service.ensure_fresh_target = mock_ensure_fresh_target
+
+    # full_path="" かつ skip_refresh=False（macOSランチャー等の標準リクエスト）で検索
+    result = service.search(
+        SearchQueryParams(
+            q="keyword_target",
+            full_path="",
+            search_all_enabled=False,
+            skip_refresh=False,
+        )
+    )
+
+    assert result.total == 1
+    assert [item.file_name for item in result.items] == ["existing_doc.md"]
