+/* AIインプット ステップ2候補テーブル（画面縦幅いっぱいに拡大表示） */
+.ai-candidate-table-container {
+  height: calc(100vh - 210px);
+  min-height: 480px;
+  overflow-y: auto;
+  border: 1px solid rgba(255, 255, 255, 0.08);
+  border-radius: 8px;
+  background: rgba(15, 23, 42, 0.4);
+}
+
 .ai-export-preview-iframe {
   width: 100%;
   height: 500px;
@@ -2223,5 +2233,71 @@ button.search-type-button.active {
   gap: 6px;
 }
 
+/* ツリー開閉トグルボタン & ツリー階層スタイル (spoon_feeder2 風) */
+.ai-tree-toggle-btn {
+  background: rgba(255, 255, 255, 0.06);
+  border: 1px solid rgba(255, 255, 255, 0.12);
+  border-radius: 4px;
+  color: #a5b4fc;
+  width: 18px;
+  height: 18px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  cursor: pointer;
+  font-size: 9px;
+  padding: 0;
+  flex-shrink: 0;
+  line-height: 1;
+  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
+}
+
+.ai-tree-toggle-btn:hover {
+  background: rgba(99, 102, 241, 0.25);
+  border-color: rgba(99, 102, 241, 0.5);
+  color: #ffffff;
+}
+
+.ai-tree-spacer {
+  width: 18px;
+  height: 18px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+}
+
+.ai-child-nodes-container {
+  margin-left: 28px;
+  margin-top: 4px;
+  margin-bottom: 8px;
+  border-left: 2px dashed rgba(99, 102, 241, 0.35);
+  padding-left: 8px;
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+
+.ai-child-tree-subgroup {
+  margin-left: 14px;
+  margin-top: 3px;
+  margin-bottom: 3px;
+  border-left: 1px dashed rgba(99, 102, 241, 0.3);
+  padding-left: 8px;
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+
+.ai-child-node-item {
+  transition: background-color 0.12s ease, border-color 0.12s ease;
+}
+
+.ai-child-node-item:hover {
+  background-color: rgba(99, 102, 241, 0.15) !important;
+  border-color: rgba(99, 102, 241, 0.35) !important;
+}
+
+
 
 
