diff --git a/launcher/windows/LocalSearchLauncher/MarkdownLite.cs b/launcher/windows/LocalSearchLauncher/MarkdownLite.cs
new file mode 100644
index 0000000000000000000000000000000000000000..6af31c7330dae99cdd084ea98ad62ddffa62f8ae
--- /dev/null
+++ b/launcher/windows/LocalSearchLauncher/MarkdownLite.cs
@@ -0,0 +1,117 @@
+/**
+ * OpenCode の応答（Markdown）を、ランチャーの小さなペインで表示するための簡易 Markdown 解析。
+ * Python 版（launcher_app/markdown_lite.py）と同じ約束で動く。
+ *
+ * 【仕様】
+ * - ブロック: 段落・見出し（# 〜 ######、Level=深さ）・箇条書き（- * +、Level=字下げ 2 文字ごとの階層）・
+ *   番号付き（1. 、Level=番号）・引用（> ）・コード（``` で囲む。言語名を持ち、中身は解釈しない）。
+ * - 空行で段落を分け、段落内の改行は残す。閉じていないコードブロックは最後までコードとして扱う。
+ * - 行内: `コード` と **太字** だけを分ける。閉じていない記号は文字のまま残す。
+ **/
+using System.Text.RegularExpressions;
+
+namespace LocalSearchLauncher;
+
+internal enum MdBlockKind { Paragraph, Heading, Bullet, Numbered, Quote, Code }
+
+internal enum MdInlineStyle { Plain, Bold, Code }
+
+/// <summary>行内の文字列と書式。</summary>
+internal sealed record MdInline(string Text, MdInlineStyle Style = MdInlineStyle.Plain);
+
+/// <summary>ブロック 1 つ。Code は Text / Language を、それ以外は Inlines を持つ。</summary>
+internal sealed record MdBlock(MdBlockKind Kind, IReadOnlyList<MdInline> Inlines, int Level = 0, string Text = "", string Language = "");
+
+internal static class MarkdownLite
+{
+    private static readonly Regex Heading = new(@"^(#{1,6})\s+(.*)$", RegexOptions.Compiled);
+    private static readonly Regex Bullet = new(@"^(\s*)[-*+]\s+(.*)$", RegexOptions.Compiled);
+    private static readonly Regex Numbered = new(@"^\s*(\d+)[.)]\s+(.*)$", RegexOptions.Compiled);
+    private static readonly Regex Quote = new(@"^>\s?(.*)$", RegexOptions.Compiled);
+    private static readonly Regex Fence = new(@"^\s*```\s*([\w+#.-]*)\s*$", RegexOptions.Compiled);
+    private static readonly Regex Inline = new(@"`([^`\n]+)`|\*\*([^*\n](?:[^\n]*?[^*\s])?)\*\*", RegexOptions.Compiled);
+
+    /// <summary>行内コードと太字を分ける。</summary>
+    public static IReadOnlyList<MdInline> ParseInlines(string text)
+    {
+        var result = new List<MdInline>();
+        int position = 0;
+        foreach (Match match in Inline.Matches(text ?? ""))
+        {
+            if (match.Index > position) result.Add(new MdInline(text![position..match.Index]));
+            result.Add(match.Groups[1].Success
+                ? new MdInline(match.Groups[1].Value, MdInlineStyle.Code)
+                : new MdInline(match.Groups[2].Value, MdInlineStyle.Bold));
+            position = match.Index + match.Length;
+        }
+        if (position < (text ?? "").Length) result.Add(new MdInline(text![position..]));
+        return result;
+    }
+
+    /// <summary>Markdown をブロックの並びへ分ける。</summary>
+    public static IReadOnlyList<MdBlock> Parse(string text)
+    {
+        string[] lines = (text ?? "").Replace("\r\n", "\n").Replace("\r", "\n").Split('\n');
+        var blocks = new List<MdBlock>();
+        var paragraph = new List<string>();
+
+        void FlushParagraph()
+        {
+            if (paragraph.Count == 0) return;
+            blocks.Add(new MdBlock(MdBlockKind.Paragraph, ParseInlines(string.Join("\n", paragraph))));
+            paragraph.Clear();
+        }
+
+        for (int index = 0; index < lines.Length; index++)
+        {
+            string line = lines[index];
+            var fence = Fence.Match(line);
+            if (fence.Success)
+            {
+                FlushParagraph();
+                var code = new List<string>();
+                index++;
+                while (index < lines.Length && !Fence.IsMatch(lines[index]))
+                {
+                    code.Add(lines[index]);
+                    index++;
+                }
+                blocks.Add(new MdBlock(MdBlockKind.Code, [], Text: string.Join("\n", code), Language: fence.Groups[1].Value));
+                continue;
+            }
+            if (line.Trim().Length == 0)
+            {
+                FlushParagraph();
+                continue;
+            }
+            Match match;
+            if ((match = Heading.Match(line)).Success)
+            {
+                FlushParagraph();
+                blocks.Add(new MdBlock(MdBlockKind.Heading, ParseInlines(match.Groups[2].Value.Trim()), match.Groups[1].Length));
+            }
+            else if ((match = Bullet.Match(line)).Success)
+            {
+                FlushParagraph();
+                int indent = match.Groups[1].Value.Replace("\t", "  ").Length;
+                blocks.Add(new MdBlock(MdBlockKind.Bullet, ParseInlines(match.Groups[2].Value.Trim()), indent / 2));
+            }
+            else if ((match = Numbered.Match(line)).Success)
+            {
+                FlushParagraph();
+                blocks.Add(new MdBlock(MdBlockKind.Numbered, ParseInlines(match.Groups[2].Value.Trim()), int.Parse(match.Groups[1].Value)));
+            }
+            else if ((match = Quote.Match(line)).Success)
+            {
+                FlushParagraph();
+                blocks.Add(new MdBlock(MdBlockKind.Quote, ParseInlines(match.Groups[1].Value.Trim())));
+            }
+            else
+            {
+                paragraph.Add(line.TrimEnd());
+            }
+        }
+        FlushParagraph();
+        return blocks;
+    }
+}
diff --git a/launcher/windows/LocalSearchLauncher/OpenCodeChat.cs b/launcher/windows/LocalSearchLauncher/OpenCodeChat.cs
new file mode 100644
index 0000000000000000000000000000000000000000..d3444079c608d7adee9f2da8a097bf0f8eeef947
--- /dev/null
+++ b/launcher/windows/LocalSearchLauncher/OpenCodeChat.cs
@@ -0,0 +1,627 @@
+/**
+ * WPF ランチャーの OpenCode ペインのチャット表示モデル（Obsidian の Claudian プラグイン風）と、表示用の書式・解析。
+ * Python 版（launcher_app/opencode_chat.py）と同じ約束で動く。
+ *
+ * 【仕様】
+ * - 会話は表示項目（ChatEntry）の並び。種類は User（自分の指示）/ Text（応答本文・Markdown）/
+ *   Reasoning（思考。既定で折りたたみ、見出しに「思考（n秒）」）/ Tool（ツール実行カード。見出しは「状態アイコン ツール名 要約」、
+ *   既定で折りたたみ、開くと入力と出力）/ Notice（中断・失敗などのお知らせ。Status は info / error）。
+ * - opencode run --format json の NDJSON を ApplyLine で取り込む。text / reasoning / tool_use は part ID ごとに 1 項目で、
+ *   同じ ID なら更新する（ツールは partID を優先）。step_finish は最後のトークン数をコンテキスト使用量とし、費用は合計する。
+ *   error はエラーのお知らせ、その他の制御イベントは表示しない。JSON でない行は ANSI を除いて本文として残す。
+ * - opencode session export の JSON から過去の会話を復元できる（FromExport）。
+ * - 項目は不変の record。更新するたびに Revision を上げた新しい record に差し替える（画面は Id と Revision で差分だけ描き直す）。
+ * - opencode の出力を読むスレッドと UI スレッドの両方から触るため、更新と Snapshot はロックで守る。
+ **/
+using System.Text.Json;
+using System.Text.RegularExpressions;
+using System.Windows.Input;
+
+namespace LocalSearchLauncher;
+
+/// <summary>表示項目の種類。</summary>
+internal enum ChatEntryKind { User, Text, Reasoning, Tool, Notice }
+
+/// <summary>会話の表示項目 1 つ（不変）。</summary>
+internal sealed record ChatEntry(
+    string Id,
+    ChatEntryKind Kind,
+    string Text = "",
+    string Tool = "",
+    string Status = "",
+    string Summary = "",
+    string DetailInput = "",
+    string DetailOutput = "",
+    double? DurationSeconds = null,
+    bool Expanded = false,
+    int Revision = 0);
+
+/// <summary>会話一覧の 1 件（opencode session list --format json）。</summary>
+internal sealed record OpenCodeSessionSummary(string Id, string Title, long UpdatedMs);
+
+/// <summary>OpenCode ペインに表示する会話。</summary>
+internal sealed class ChatTranscript
+{
+    private const int DetailLimit = 4000;
+    private static readonly JsonSerializerOptions IndentedJson = new()
+    {
+        WriteIndented = true,
+        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
+    };
+    private readonly object _lock = new();
+    private readonly List<ChatEntry> _entries = [];
+    private int _nextId = 1;
+
+    public long ContextTokens { get; private set; }
+    public double Cost { get; private set; }
+    public string Title { get; private set; } = "";
+
+    /// <summary>今の表示項目の写し。</summary>
+    public IReadOnlyList<ChatEntry> Snapshot()
+    {
+        lock (_lock) return _entries.ToArray();
+    }
+
+    public bool IsEmpty
+    {
+        get { lock (_lock) return _entries.Count == 0; }
+    }
+
+    /// <summary>表示と使用量を消す。</summary>
+    public void Clear()
+    {
+        lock (_lock)
+        {
+            _entries.Clear();
+            ContextTokens = 0;
+            Cost = 0;
+            Title = "";
+        }
+    }
+
+    /// <summary>表示・使用量・題名を other の内容へ置き換える（過去の会話の読み込み）。</summary>
+    public void ReplaceWith(ChatTranscript other)
+    {
+        var restored = other.Snapshot();
+        lock (_lock)
+        {
+            _entries.Clear();
+            _entries.AddRange(restored);
+            ContextTokens = other.ContextTokens;
+            Cost = other.Cost;
+            Title = other.Title;
+            _nextId = restored.Count + 1;
+        }
+    }
+
+    private string NewId(string prefix)
+    {
+        lock (_lock) return $"{prefix}{_nextId++}";
+    }
+
+    /// <summary>同じ ID があれば Revision を上げて差し替え、なければ末尾へ足す。</summary>
+    private ChatEntry Upsert(string id, Func<ChatEntry?, ChatEntry> build)
+    {
+        lock (_lock)
+        {
+            int index = _entries.FindIndex(entry => entry.Id == id);
+            if (index < 0)
+            {
+                var created = build(null);
+                _entries.Add(created);
+                return created;
+            }
+            var updated = build(_entries[index]) with { Revision = _entries[index].Revision + 1 };
+            _entries[index] = updated;
+            return updated;
+        }
+    }
+
+    /// <summary>自分の指示を吹き出しとして足す。</summary>
+    public ChatEntry AddUser(string text)
+    {
+        string id = NewId("user_");
+        string cleaned = (text ?? "").Trim();
+        return Upsert(id, _ => new ChatEntry(id, ChatEntryKind.User, cleaned));
+    }
+
+    /// <summary>お知らせ（中断・失敗など）を足す。</summary>
+    public ChatEntry AddNotice(string text, bool error = false)
+    {
+        string id = NewId("notice_");
+        return Upsert(id, _ => new ChatEntry(id, ChatEntryKind.Notice, text, Status: error ? "error" : "info"));
+    }
+
+    /// <summary>思考・ツールの開閉を切り替える。見つからなければ false。</summary>
+    public bool Toggle(string id)
+    {
+        lock (_lock)
+        {
+            int index = _entries.FindIndex(entry => entry.Id == id);
+            if (index < 0) return false;
+            var entry = _entries[index];
+            _entries[index] = entry with { Expanded = !entry.Expanded, Revision = entry.Revision + 1 };
+            return true;
+        }
+    }
+
+    /// <summary>吹き出し単位のコピー用文字列。</summary>
+    public string CopyText(string id)
+    {
+        lock (_lock) return _entries.FirstOrDefault(entry => entry.Id == id)?.Text ?? "";
+    }
+
+    /// <summary>最後の応答本文。</summary>
+    public string LastAssistantText()
+    {
+        lock (_lock) return _entries.LastOrDefault(entry => entry.Kind == ChatEntryKind.Text)?.Text ?? "";
+    }
+
+    /// <summary>「コンテキスト 10.1k トークン · $0.0300」。使用量が無ければ空文字。</summary>
+    public string UsageText()
+    {
+        if (ContextTokens <= 0) return "";
+        string text = $"コンテキスト {OpenCodeChatFormat.FormatTokens(ContextTokens)} トークン";
+        return Cost > 0 ? $"{text} · ${Cost.ToString("0.0000", System.Globalization.CultureInfo.InvariantCulture)}" : text;
+    }
+
+    /// <summary>NDJSON の 1 行を取り込む。表示が変わったら true。</summary>
+    public bool ApplyLine(string line)
+    {
+        string raw = (line ?? "").Trim();
+        if (raw.Length == 0) return false;
+        if (raw.StartsWith('{') && raw.EndsWith('}'))
+        {
+            try
+            {
+                using var doc = JsonDocument.Parse(raw);
+                if (doc.RootElement.ValueKind == JsonValueKind.Object) return ApplyEvent(doc.RootElement);
+            }
+            catch (JsonException)
+            {
+                // JSON として読めない行は本文として残す
+            }
+        }
+        string cleaned = OpenCodeCommandBuilder.StripAnsi(raw).Trim();
+        if (cleaned.Length == 0) return false;
+        string id = NewId("raw_");
+        Upsert(id, _ => new ChatEntry(id, ChatEntryKind.Text, cleaned));
+        return true;
+    }
+
+    /// <summary>opencode のイベント 1 つを取り込む。表示が変わったら true。</summary>
+    public bool ApplyEvent(JsonElement root)
+    {
+        string type = Str(root, "type");
+        JsonElement part = root.TryGetProperty("part", out var p) && p.ValueKind == JsonValueKind.Object ? p : default;
+        bool hasPart = part.ValueKind == JsonValueKind.Object;
+        switch (type)
+        {
+            case "text":
+            {
+                string text = hasPart && part.TryGetProperty("text", out var t) && t.ValueKind == JsonValueKind.String ? t.GetString() ?? "" : Str(root, "text");
+                if (text.Trim().Length == 0) return false;
+                string id = hasPart ? Str(part, "id") : "";
+                if (id.Length == 0) id = NewId("text_");
+                Upsert(id, _ => new ChatEntry(id, ChatEntryKind.Text, text));
+                return true;
+            }
+            case "reasoning":
+            {
+                string text = hasPart ? Str(part, "text").Trim() : "";
+                if (text.Length == 0) return false;
+                string id = Str(part, "id");
+                if (id.Length == 0) id = NewId("reasoning_");
+                double? duration = Duration(part, "start", "end");
+                Upsert(id, _ => new ChatEntry(id, ChatEntryKind.Reasoning, text, DurationSeconds: duration));
+                return true;
+            }
+            case "tool_use" or "tool_call":
+                if (hasPart) ApplyTool(part, null);
+                return hasPart;
+            case "step_finish":
+                lock (_lock)
+                {
+                    if (hasPart && part.TryGetProperty("tokens", out var tokens))
+                    {
+                        long context = ContextTokensOf(tokens);
+                        if (context > 0) ContextTokens = context;
+                    }
+                    if (hasPart && part.TryGetProperty("cost", out var cost) && cost.ValueKind == JsonValueKind.Number) Cost += cost.GetDouble();
+                }
+                return true;
+            case "error":
+                AddNotice(ErrorMessage(root), error: true);
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    /// <summary>ツールの part（run の tool_use / export の tool）をカードへ反映する。</summary>
+    private void ApplyTool(JsonElement part, string? entryId)
+    {
+        JsonElement state = part.TryGetProperty("state", out var s) && s.ValueKind == JsonValueKind.Object ? s : default;
+        bool hasState = state.ValueKind == JsonValueKind.Object;
+        string tool = Str(part, "tool");
+        if (tool.Length == 0) tool = Str(part, "name");
+        if (tool.Length == 0) tool = "tool";
+        string status = hasState ? Str(state, "status") : "";
+        if (status.Length == 0 || status == "pending") status = "running";
+        string inputJson = hasState && state.TryGetProperty("input", out var input) && input.ValueKind == JsonValueKind.Object ? input.GetRawText() : "";
+        string title = hasState ? Str(state, "title") : "";
+        if (title.Length == 0) title = Str(part, "title");
+        string output = hasState ? Str(state, "output") : "";
+        if (output.Length == 0 && hasState && state.TryGetProperty("content", out var content) && content.ValueKind == JsonValueKind.Array)
+        {
+            output = string.Join("\n", content.EnumerateArray().Where(item => item.ValueKind == JsonValueKind.Object).Select(item => Str(item, "text")));
+        }
+        if (output.Length == 0 && status == "error" && hasState) output = Str(state, "error");
+        string id = entryId ?? FirstNonEmpty(Str(part, "partID"), Str(part, "id"));
+        if (id.Length == 0) id = NewId("tool_");
+        string summary = OpenCodeChatFormat.SummarizeTool(tool, inputJson.Length > 0 ? inputJson : "{}", title);
+        string detailInput = inputJson.Length > 0 && inputJson != "{}" ? Truncate(Indent(inputJson), DetailLimit) : "";
+        string detailOutput = Truncate(OpenCodeCommandBuilder.StripAnsi(output).Trim(), DetailLimit);
+        Upsert(id, _ => new ChatEntry(id, ChatEntryKind.Tool, Tool: tool, Status: status, Summary: summary, DetailInput: detailInput, DetailOutput: detailOutput));
+    }
+
+    /// <summary>opencode session export の JSON から会話を復元する。読めなければ空の会話。</summary>
+    public static ChatTranscript FromExport(string json)
+    {
+        var transcript = new ChatTranscript();
+        JsonDocument doc;
+        try { doc = JsonDocument.Parse(json); }
+        catch (JsonException) { return transcript; }
+        using (doc)
+        {
+            var root = doc.RootElement;
+            if (root.ValueKind != JsonValueKind.Object) return transcript;
+            if (root.TryGetProperty("info", out var info) && info.ValueKind == JsonValueKind.Object) transcript.Title = Str(info, "title");
+            if (!root.TryGetProperty("messages", out var messages) || messages.ValueKind != JsonValueKind.Array) return transcript;
+            foreach (var message in messages.EnumerateArray())
+            {
+                if (message.ValueKind != JsonValueKind.Object) continue;
+                string kind = FirstNonEmpty(Str(message, "type"), Str(message, "role"));
+                if (kind == "user")
+                {
+                    transcript.AddUser(Str(message, "text"));
+                    continue;
+                }
+                if (kind != "assistant") continue;
+                if (message.TryGetProperty("content", out var content) && content.ValueKind == JsonValueKind.Array)
+                {
+                    foreach (var item in content.EnumerateArray())
+                    {
+                        if (item.ValueKind != JsonValueKind.Object) continue;
+                        string itemType = Str(item, "type");
+                        string text = Str(item, "text");
+                        if (itemType == "text" && text.Trim().Length > 0)
+                        {
+                            string id = transcript.NewId("text_");
+                            transcript.Upsert(id, _ => new ChatEntry(id, ChatEntryKind.Text, text));
+                        }
+                        else if (itemType == "reasoning" && text.Trim().Length > 0)
+                        {
+                            string id = transcript.NewId("reasoning_");
+                            double? duration = Duration(item, "created", "completed");
+                            transcript.Upsert(id, _ => new ChatEntry(id, ChatEntryKind.Reasoning, text.Trim(), DurationSeconds: duration));
+                        }
+                        else if (itemType == "tool")
+                        {
+                            transcript.ApplyTool(item, transcript.NewId("tool_"));
+                        }
+                    }
+                }
+                if (message.TryGetProperty("tokens", out var tokens))
+                {
+                    long context = ContextTokensOf(tokens);
+                    if (context > 0) transcript.ContextTokens = context;
+                }
+                if (message.TryGetProperty("cost", out var cost) && cost.ValueKind == JsonValueKind.Number) transcript.Cost += cost.GetDouble();
+            }
+        }
+        return transcript;
+    }
+
+    private static string Str(JsonElement element, string name) =>
+        element.ValueKind == JsonValueKind.Object && element.TryGetProperty(name, out var value) && value.ValueKind == JsonValueKind.String
+            ? value.GetString() ?? ""
+            : "";
+
+    private static string FirstNonEmpty(params string[] values) => values.FirstOrDefault(value => value.Length > 0) ?? "";
+
+    private static double? Duration(JsonElement element, string startKey, string endKey)
+    {
+        if (!element.TryGetProperty("time", out var time) || time.ValueKind != JsonValueKind.Object) return null;
+        if (time.TryGetProperty(startKey, out var start) && start.ValueKind == JsonValueKind.Number
+            && time.TryGetProperty(endKey, out var end) && end.ValueKind == JsonValueKind.Number
+            && end.GetDouble() >= start.GetDouble())
+        {
+            return Math.Round((end.GetDouble() - start.GetDouble()) / 1000.0, 3);
+        }
+        return null;
+    }
+
+    private static long ContextTokensOf(JsonElement tokens)
+    {
+        if (tokens.ValueKind != JsonValueKind.Object) return 0;
+        double total = 0;
+        foreach (string key in new[] { "input", "output", "reasoning" })
+        {
+            if (tokens.TryGetProperty(key, out var value) && value.ValueKind == JsonValueKind.Number) total += value.GetDouble();
+        }
+        if (tokens.TryGetProperty("cache", out var cache) && cache.ValueKind == JsonValueKind.Object)
+        {
+            foreach (string key in new[] { "read", "write" })
+            {
+                if (cache.TryGetProperty(key, out var value) && value.ValueKind == JsonValueKind.Number) total += value.GetDouble();
+            }
+        }
+        return (long)total;
+    }
+
+    private static string ErrorMessage(JsonElement root)
+    {
+        if (root.TryGetProperty("error", out var error) && error.ValueKind == JsonValueKind.Object)
+        {
+            if (error.TryGetProperty("data", out var data) && data.ValueKind == JsonValueKind.Object && Str(data, "message").Length > 0) return Str(data, "message");
+            return FirstNonEmpty(Str(error, "message"), Str(root, "message"), Str(error, "name"), "不明なエラー");
+        }
+        return FirstNonEmpty(Str(root, "message"), "不明なエラー");
+    }
+
+    private static string Indent(string json)
+    {
+        try
+        {
+            using var doc = JsonDocument.Parse(json);
+            return JsonSerializer.Serialize(doc.RootElement, IndentedJson).Replace("\r\n", "\n");
+        }
+        catch (JsonException) { return json; }
+    }
+
+    private static string Truncate(string text, int limit) => text.Length <= limit ? text : text[..(limit - 1)] + "…";
+}
+
+/// <summary>チャット表示の書式（ツールの要約・見出し・時間・トークン数・相対時刻）と、CLI 出力の解析。</summary>
+internal static class OpenCodeChatFormat
+{
+    private const int SummaryLimit = 80;
+    private static readonly Regex ModelLine = new(@"^[A-Za-z0-9._-]+/\S+$", RegexOptions.Compiled);
+
+    /// <summary>ツールカードの見出しに出す要約（パス・コマンド・検索語など）。80 文字で切る。</summary>
+    public static string SummarizeTool(string tool, string inputJson, string title = "")
+    {
+        string name = (tool ?? "").ToLowerInvariant();
+        JsonElement data = default;
+        JsonDocument? doc = null;
+        try
+        {
+            doc = JsonDocument.Parse(string.IsNullOrWhiteSpace(inputJson) ? "{}" : inputJson);
+            data = doc.RootElement;
+        }
+        catch (JsonException) { }
+        try
+        {
+            string Text(string key) =>
+                data.ValueKind == JsonValueKind.Object && data.TryGetProperty(key, out var value)
+                    ? value.ValueKind switch
+                    {
+                        JsonValueKind.String => (value.GetString() ?? "").Trim(),
+                        JsonValueKind.Number => value.GetRawText(),
+                        _ => "",
+                    }
+                    : "";
+
+            string summary = name switch
+            {
+                "read" or "write" or "edit" or "patch" or "list" or "multiedit" => FirstNonEmpty(Text("filePath"), Text("path")),
+                "bash" => Text("command").Split('\n')[0],
+                "grep" or "glob" => Text("pattern").Length > 0 && Text("path").Length > 0 ? $"{Text("pattern")} in {Text("path")}" : Text("pattern"),
+                "webfetch" => Text("url"),
+                "websearch" => Text("query"),
+                "task" => Text("description"),
+                "todowrite" => TodoSummary(data),
+                _ => "",
+            };
+            if (summary.Length == 0)
+            {
+                string cleanedTitle = (title ?? "").Trim();
+                if (cleanedTitle.Length > 0 && !cleanedTitle.Equals(name, StringComparison.OrdinalIgnoreCase)) summary = cleanedTitle;
+            }
+            if (summary.Length == 0 && data.ValueKind == JsonValueKind.Object)
+            {
+                summary = data.EnumerateObject()
+                    .Where(property => property.Value.ValueKind == JsonValueKind.String && (property.Value.GetString() ?? "").Trim().Length > 0)
+                    .Select(property => (property.Value.GetString() ?? "").Trim())
+                    .FirstOrDefault() ?? "";
+            }
+            summary = summary.Split('\n')[0];
+            return summary.Length <= SummaryLimit ? summary : summary[..(SummaryLimit - 1)] + "…";
+        }
+        finally
+        {
+            doc?.Dispose();
+        }
+    }
+
+    private static string TodoSummary(JsonElement data)
+    {
+        if (data.ValueKind != JsonValueKind.Object || !data.TryGetProperty("todos", out var todos) || todos.ValueKind != JsonValueKind.Array) return "";
+        int total = todos.GetArrayLength();
+        int done = todos.EnumerateArray().Count(todo =>
+            todo.ValueKind == JsonValueKind.Object && todo.TryGetProperty("status", out var status) && status.GetString() == "completed");
+        return total > 0 ? $"Tasks {done}/{total}" : "";
+    }
+
+    private static string FirstNonEmpty(params string[] values) => values.FirstOrDefault(value => value.Length > 0) ?? "";
+
+    /// <summary>ツールカードの見出し（✓ 完了 / ⏳ 実行中 / ✗ 失敗）。</summary>
+    public static string ToolHeader(string tool, string status, string summary)
+    {
+        string icon = status switch { "completed" => "✓", "error" => "✗", _ => "⏳" };
+        return summary.Length > 0 ? $"{icon} {tool}  {summary}" : $"{icon} {tool}";
+    }
+
+    /// <summary>経過時間（10 秒未満は小数 1 桁、1 分以上は「1分05秒」）。</summary>
+    public static string FormatElapsed(double seconds)
+    {
+        double value = Math.Max(0, seconds);
+        if (value < 10) return $"{value.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)}秒";
+        int total = (int)Math.Round(value, MidpointRounding.AwayFromZero);
+        if (value < 60) return $"{total}秒";
+        return $"{total / 60}分{total % 60:00}秒";
+    }
+
+    /// <summary>トークン数（950 / 10.7k / 1.3M）。</summary>
+    public static string FormatTokens(long count)
+    {
+        var culture = System.Globalization.CultureInfo.InvariantCulture;
+        if (count >= 1_000_000) return $"{(count / 1_000_000.0).ToString("0.0", culture)}M";
+        if (count >= 1000) return $"{(count / 1000.0).ToString("0.0", culture)}k";
+        return count.ToString(culture);
+    }
+
+    /// <summary>会話一覧の更新時刻（たった今 / n分前 / n時間前 / n日前）。</summary>
+    public static string FormatRelativeTime(long updatedMs, long nowMs)
+    {
+        long seconds = Math.Max(0, (nowMs - updatedMs) / 1000);
+        if (seconds < 60) return "たった今";
+        if (seconds < 3600) return $"{seconds / 60}分前";
+        if (seconds < 86400) return $"{seconds / 3600}時間前";
+        return $"{seconds / 86400}日前";
+    }
+
+    /// <summary>opencode session list --format json の出力から会話一覧を読む。余計な出力は無視する。</summary>
+    public static IReadOnlyList<OpenCodeSessionSummary> ParseSessionList(string stdout)
+    {
+        string text = stdout ?? "";
+        for (int index = text.IndexOf('['); index >= 0; index = text.IndexOf('[', index + 1))
+        {
+            try
+            {
+                var reader = new Utf8JsonReader(System.Text.Encoding.UTF8.GetBytes(text[index..]), new JsonReaderOptions { AllowTrailingCommas = true });
+                using var doc = JsonDocument.ParseValue(ref reader);
+                if (doc.RootElement.ValueKind != JsonValueKind.Array) continue;
+                var sessions = new List<OpenCodeSessionSummary>();
+                foreach (var item in doc.RootElement.EnumerateArray())
+                {
+                    if (item.ValueKind != JsonValueKind.Object || !item.TryGetProperty("id", out var id) || id.ValueKind != JsonValueKind.String) continue;
+                    string title = item.TryGetProperty("title", out var t) && t.ValueKind == JsonValueKind.String ? t.GetString() ?? "" : "";
+                    long updated = item.TryGetProperty("updated", out var u) && u.ValueKind == JsonValueKind.Number ? (long)u.GetDouble() : 0;
+                    sessions.Add(new OpenCodeSessionSummary(id.GetString() ?? "", title, updated));
+                }
+                return sessions;
+            }
+            catch (JsonException) { }
+        }
+        return [];
+    }
+
+    /// <summary>opencode models の出力から「プロバイダー/モデル」の行だけを取り出す。</summary>
+    public static IReadOnlyList<string> ParseModelList(string stdout) =>
+        (stdout ?? "").Split('\n').Select(line => line.Trim()).Where(line => ModelLine.IsMatch(line)).ToArray();
+}
+
+/// <summary>
+/// 送った指示の履歴。↑（Previous）で新しい順に呼び出し、↓（Next）で戻る。最後まで戻ると呼び出し前の下書きを返し、
+/// その次は null（呼び出し中でない）。連続する同じ指示はまとめ、上限を超えたら古いものから捨てる。
+/// </summary>
+internal sealed class PromptHistory(int limit = 50)
+{
+    private readonly List<string> _items = [];
+    private int? _index;
+    private string _draft = "";
+
+    public IReadOnlyList<string> Items => _items;
+
+    public void Add(string prompt)
+    {
+        string cleaned = (prompt ?? "").Trim();
+        _index = null;
+        if (cleaned.Length == 0 || (_items.Count > 0 && _items[^1] == cleaned)) return;
+        _items.Add(cleaned);
+        if (_items.Count > limit) _items.RemoveRange(0, _items.Count - limit);
+    }
+
+    public string? Previous(string currentDraft)
+    {
+        if (_items.Count == 0) return null;
+        if (_index is null)
+        {
+            _draft = currentDraft ?? "";
+            _index = _items.Count - 1;
+        }
+        else
+        {
+            _index = Math.Max(0, _index.Value - 1);
+        }
+        return _items[_index.Value];
+    }
+
+    public string? Next()
+    {
+        if (_index is null) return null;
+        if (_index.Value >= _items.Count - 1)
+        {
+            _index = null;
+            return _draft;
+        }
+        _index++;
+        return _items[_index.Value];
+    }
+}
+
+/// <summary>指示欄のキー操作の結果。</summary>
+internal enum OpenCodeInputAction
+{
+    None,
+    Submit,
+    Newline,
+    HistoryPrevious,
+    HistoryNext,
+    SuggestionPrevious,
+    SuggestionNext,
+    AcceptSuggestion,
+    CloseSuggestions,
+    CompleteSlash,
+}
+
+/// <summary>
+/// 指示欄のキー操作を決める。Claudian と同じく Enter で送信・Shift+Enter で改行・↑↓で履歴。
+/// スラッシュコマンドの候補表示中は ↑↓ で候補を選び、Tab / Enter で確定、Esc で閉じる（Obsidian と同じ）。
+/// 候補が閉じていても「/」の語の中の Tab は補完する。それ以外の Tab / Esc はペイン移動・非表示に任せる（None）。
+/// </summary>
+internal static class OpenCodeInputKeys
+{
+    public static OpenCodeInputAction Decide(
+        Key key,
+        ModifierKeys modifiers,
+        bool caretOnFirstLine,
+        bool caretOnLastLine,
+        bool suggestionsOpen = false,
+        bool inSlashToken = false)
+    {
+        bool shift = modifiers.HasFlag(ModifierKeys.Shift);
+        bool control = modifiers.HasFlag(ModifierKeys.Control);
+        if (suggestionsOpen && modifiers == ModifierKeys.None)
+        {
+            switch (key)
+            {
+                case Key.Up: return OpenCodeInputAction.SuggestionPrevious;
+                case Key.Down: return OpenCodeInputAction.SuggestionNext;
+                case Key.Tab or Key.Enter or Key.Return: return OpenCodeInputAction.AcceptSuggestion;
+                case Key.Escape: return OpenCodeInputAction.CloseSuggestions;
+            }
+        }
+        if (key == Key.Tab && inSlashToken && modifiers == ModifierKeys.None) return OpenCodeInputAction.CompleteSlash;
+        return key switch
+        {
+            Key.Enter or Key.Return when shift && !control => OpenCodeInputAction.Newline,
+            Key.Enter or Key.Return => OpenCodeInputAction.Submit,
+            Key.Up when caretOnFirstLine && modifiers == ModifierKeys.None => OpenCodeInputAction.HistoryPrevious,
+            Key.Down when caretOnLastLine && modifiers == ModifierKeys.None => OpenCodeInputAction.HistoryNext,
+            _ => OpenCodeInputAction.None,
+        };
+    }
+}
diff --git a/launcher/windows/LocalSearchLauncher/OpenCodeChatView.cs b/launcher/windows/LocalSearchLauncher/OpenCodeChatView.cs
new file mode 100644
index 0000000000000000000000000000000000000000..1abaf7aa406cd9785c199a1cd6bb4fd744855ec1
--- /dev/null
+++ b/launcher/windows/LocalSearchLauncher/OpenCodeChatView.cs
@@ -0,0 +1,295 @@
+/**
+ * WPF ランチャーの OpenCode ペインのチャット描画（Claudian 風）。
+ *
+ * 【仕様】
+ * - ChatTranscript の表示項目を StackPanel へ並べる。Id と Revision を覚え、変わった項目だけ作り直す。
+ * - 自分の指示: 右寄せの青い吹き出し。opencode の応答: 1 往復の最初に「opencode」の見出しを付け、
+ *   本文は簡易 Markdown（見出し・箇条書き・番号・引用・コード・行内コード・太字）を FlowDocument で描く。本文ごとに「コピー」ボタン。
+ * - 思考とツールは Expander（既定で閉じる）。見出しは「思考（1.2秒）」「✓ bash  npm test」。開くと本文 / 入力と出力。
+ * - お知らせは中央寄せの灰色「— 中断しました —」、エラーは赤の「⚠ 理由」。会話が空なら操作の案内を出す。
+ * - 読み返し中（下端から 100px より上）はスクロール位置を保ち、下端付近なら最新へ追従する。
+ **/
+using System.Windows;
+using System.Windows.Controls;
+using System.Windows.Documents;
+using System.Windows.Media;
+
+namespace LocalSearchLauncher;
+
+internal sealed class OpenCodeChatView(StackPanel panel, ScrollViewer scroll, Action<string> toggle, Action<string> copy)
+{
+    public const string EmptyHint = "opencode に指示を入力してください。\nEnter で送信 / Shift+Enter で改行 / ↑ で過去の指示\n履歴から過去の会話を再開でき、Plan にすると変更せず計画だけ立てます。";
+    private static readonly Brush TextBrush = Brush("#F8FAFC");
+    private static readonly Brush MutedBrush = Brush("#94A3B8");
+    private static readonly Brush UserBubbleBrush = Brush("#CC1D4ED8");
+    private static readonly Brush AssistantLabelBrush = Brush("#86EFAC");
+    private static readonly Brush ToolBrush = Brush("#BFDBFE");
+    private static readonly Brush ErrorBrush = Brush("#F87171");
+    private static readonly Brush CodeBrush = Brush("#D9F99D");
+    private static readonly Brush CodeBackground = Brush("#FF0B1220");
+    private static readonly Brush LinkBrush = Brush("#60A5FA");
+    private static readonly FontFamily MonoFont = new("Consolas, Cascadia Mono, MS Gothic");
+    private readonly List<(string Id, int Revision)> _rendered = [];
+    private bool _showingHint;
+
+    /// <summary>会話を描く（変わった項目だけ作り直す）。</summary>
+    public void Render(IReadOnlyList<ChatEntry> entries)
+    {
+        bool follow = scroll.ScrollableHeight - scroll.VerticalOffset <= 100;
+        if (entries.Count == 0)
+        {
+            if (!_showingHint)
+            {
+                panel.Children.Clear();
+                _rendered.Clear();
+                panel.Children.Add(new TextBlock { Text = EmptyHint, Foreground = MutedBrush, FontSize = 12, TextWrapping = TextWrapping.Wrap, Margin = new Thickness(4) });
+                _showingHint = true;
+            }
+            return;
+        }
+        if (_showingHint || entries.Count < _rendered.Count || !SamePrefix(entries))
+        {
+            panel.Children.Clear();
+            _rendered.Clear();
+            _showingHint = false;
+        }
+        for (int index = 0; index < entries.Count; index++)
+        {
+            var entry = entries[index];
+            bool startsResponse = entry.Kind is ChatEntryKind.Text or ChatEntryKind.Reasoning or ChatEntryKind.Tool
+                && (index == 0 || entries[index - 1].Kind is ChatEntryKind.User or ChatEntryKind.Notice);
+            if (index < _rendered.Count)
+            {
+                if (_rendered[index].Revision == entry.Revision) continue;
+                panel.Children[index] = Build(entry, startsResponse);
+                _rendered[index] = (entry.Id, entry.Revision);
+            }
+            else
+            {
+                panel.Children.Add(Build(entry, startsResponse));
+                _rendered.Add((entry.Id, entry.Revision));
+            }
+        }
+        if (follow) scroll.ScrollToEnd();
+    }
+
+    /// <summary>開閉をこの画面で切り替えたときに、描き直さないよう版番号だけ合わせる。</summary>
+    public void Acknowledge(ChatEntry entry)
+    {
+        int index = _rendered.FindIndex(item => item.Id == entry.Id);
+        if (index >= 0) _rendered[index] = (entry.Id, entry.Revision);
+    }
+
+    private bool SamePrefix(IReadOnlyList<ChatEntry> entries)
+    {
+        for (int index = 0; index < _rendered.Count; index++)
+        {
+            if (entries[index].Id != _rendered[index].Id) return false;
+        }
+        return true;
+    }
+
+    private FrameworkElement Build(ChatEntry entry, bool startsResponse)
+    {
+        var element = BuildEntry(entry, startsResponse);
+        // 吹き出し内の文字欄がホイールを奪わないよう、会話全体のスクロールへ渡す（ツール出力の欄は自分でスクロールする）
+        element.PreviewMouseWheel += (_, e) =>
+        {
+            if (e.OriginalSource is DependencyObject source && FindScrollableTextBox(source) is not null) return;
+            e.Handled = true;
+            scroll.ScrollToVerticalOffset(scroll.VerticalOffset - e.Delta / 3.0);
+        };
+        return element;
+    }
+
+    private static TextBox? FindScrollableTextBox(DependencyObject? current)
+    {
+        while (current is not null)
+        {
+            if (current is TextBox { VerticalScrollBarVisibility: ScrollBarVisibility.Auto } box && box.ExtentHeight > box.ViewportHeight) return box;
+            current = current is Visual or System.Windows.Media.Media3D.Visual3D ? VisualTreeHelper.GetParent(current) : LogicalTreeHelper.GetParent(current);
+        }
+        return null;
+    }
+
+    private FrameworkElement BuildEntry(ChatEntry entry, bool startsResponse)
+    {
+        FrameworkElement body = entry.Kind switch
+        {
+            ChatEntryKind.User => UserBubble(entry),
+            ChatEntryKind.Text => AssistantText(entry),
+            ChatEntryKind.Reasoning => Collapsible(entry, entry.DurationSeconds is { } seconds ? $"思考（{OpenCodeChatFormat.FormatElapsed(seconds)}）" : "思考", MutedBrush, PlainBox(entry.Text, MutedBrush, mono: false)),
+            ChatEntryKind.Tool => Collapsible(
+                entry,
+                OpenCodeChatFormat.ToolHeader(entry.Tool, entry.Status, entry.Summary),
+                entry.Status == "error" ? ErrorBrush : ToolBrush,
+                PlainBox(string.Join("\n\n", new[] { entry.DetailInput, entry.DetailOutput.Length > 0 ? entry.DetailOutput : "（出力なし）" }.Where(part => part.Length > 0)), MutedBrush, mono: true)),
+            _ => Notice(entry),
+        };
+        if (!startsResponse) return body;
+        var stack = new StackPanel();
+        stack.Children.Add(new TextBlock { Text = "opencode", Foreground = AssistantLabelBrush, FontSize = 11, FontWeight = FontWeights.SemiBold, Margin = new Thickness(2, 8, 0, 2) });
+        stack.Children.Add(body);
+        return stack;
+    }
+
+    private static FrameworkElement UserBubble(ChatEntry entry) => new Border
+    {
+        Background = UserBubbleBrush,
+        CornerRadius = new CornerRadius(10),
+        Padding = new Thickness(10, 6, 10, 6),
+        Margin = new Thickness(40, 8, 0, 2),
+        HorizontalAlignment = HorizontalAlignment.Right,
+        Child = PlainBox(entry.Text, TextBrush, mono: false, transparent: true),
+    };
+
+    private FrameworkElement AssistantText(ChatEntry entry)
+    {
+        var box = new RichTextBox
+        {
+            IsReadOnly = true,
+            IsDocumentEnabled = true,
+            Background = Brushes.Transparent,
+            BorderThickness = new Thickness(0),
+            Foreground = TextBrush,
+            Padding = new Thickness(0),
+            Document = MarkdownDocument(entry.Text),
+        };
+        var copyButton = new Button
+        {
+            Content = "コピー",
+            FontSize = 10,
+            Padding = new Thickness(6, 0, 6, 0),
+            Margin = new Thickness(0, 0, 0, 4),
+            Background = Brushes.Transparent,
+            BorderThickness = new Thickness(0),
+            Foreground = LinkBrush,
+            Cursor = System.Windows.Input.Cursors.Hand,
+            HorizontalAlignment = HorizontalAlignment.Left,
+            Focusable = false,
+        };
+        copyButton.Click += (_, _) => copy(entry.Id);
+        var stack = new StackPanel { Margin = new Thickness(0, 2, 0, 2) };
+        stack.Children.Add(box);
+        stack.Children.Add(copyButton);
+        return stack;
+    }
+
+    private FrameworkElement Collapsible(ChatEntry entry, string header, Brush headerBrush, FrameworkElement content)
+    {
+        var expander = new Expander
+        {
+            Header = new TextBlock { Text = header, Foreground = headerBrush, FontSize = 12, TextTrimming = TextTrimming.CharacterEllipsis },
+            IsExpanded = entry.Expanded,
+            Content = content,
+            Foreground = headerBrush,
+            Margin = new Thickness(0, 1, 0, 1),
+            Focusable = false,
+        };
+        // 画面上の開閉状態を覚え、変わったときだけ会話側の状態を切り替える
+        bool expanded = entry.Expanded;
+        expander.Expanded += (_, _) => { if (!expanded) { expanded = true; toggle(entry.Id); } };
+        expander.Collapsed += (_, _) => { if (expanded) { expanded = false; toggle(entry.Id); } };
+        return expander;
+    }
+
+    private static FrameworkElement Notice(ChatEntry entry) => new TextBlock
+    {
+        Text = entry.Status == "error" ? $"⚠ {entry.Text}" : $"— {entry.Text} —",
+        Foreground = entry.Status == "error" ? ErrorBrush : MutedBrush,
+        FontSize = 11,
+        TextWrapping = TextWrapping.Wrap,
+        HorizontalAlignment = entry.Status == "error" ? HorizontalAlignment.Left : HorizontalAlignment.Center,
+        Margin = new Thickness(0, 4, 0, 4),
+    };
+
+    /// <summary>選択・コピーできる読み取り専用の文字欄。</summary>
+    private static TextBox PlainBox(string text, Brush foreground, bool mono, bool transparent = false) => new()
+    {
+        Text = text,
+        IsReadOnly = true,
+        TextWrapping = TextWrapping.Wrap,
+        BorderThickness = new Thickness(0),
+        Background = transparent ? Brushes.Transparent : CodeBackground,
+        Foreground = foreground,
+        FontFamily = mono ? MonoFont : new FontFamily("Inter, Segoe UI"),
+        FontSize = mono ? 11 : 13,
+        Padding = transparent ? new Thickness(0) : new Thickness(6, 4, 6, 4),
+        MaxHeight = mono ? 240 : double.PositiveInfinity,
+        VerticalScrollBarVisibility = mono ? ScrollBarVisibility.Auto : ScrollBarVisibility.Disabled,
+    };
+
+    /// <summary>簡易 Markdown を FlowDocument にする。</summary>
+    private static FlowDocument MarkdownDocument(string text)
+    {
+        var document = new FlowDocument { PagePadding = new Thickness(0), FontFamily = new FontFamily("Inter, Segoe UI"), FontSize = 13, Foreground = TextBrush };
+        foreach (var block in MarkdownLite.Parse(text))
+        {
+            var paragraph = new Paragraph { Margin = new Thickness(0, 2, 0, 2) };
+            switch (block.Kind)
+            {
+                case MdBlockKind.Code:
+                    paragraph.FontFamily = MonoFont;
+                    paragraph.FontSize = 12;
+                    paragraph.Foreground = CodeBrush;
+                    paragraph.Background = CodeBackground;
+                    paragraph.Padding = new Thickness(6, 4, 6, 4);
+                    AddLines(paragraph.Inlines, block.Text, null);
+                    document.Blocks.Add(paragraph);
+                    continue;
+                case MdBlockKind.Heading:
+                    paragraph.FontWeight = FontWeights.Bold;
+                    paragraph.FontSize = block.Level <= 2 ? 15 : 14;
+                    paragraph.Margin = new Thickness(0, 6, 0, 2);
+                    break;
+                case MdBlockKind.Bullet:
+                    paragraph.Margin = new Thickness(4 + block.Level * 16, 0, 0, 0);
+                    paragraph.Inlines.Add(new Run("• "));
+                    break;
+                case MdBlockKind.Numbered:
+                    paragraph.Margin = new Thickness(4, 0, 0, 0);
+                    paragraph.Inlines.Add(new Run($"{block.Level}. "));
+                    break;
+                case MdBlockKind.Quote:
+                    paragraph.Foreground = MutedBrush;
+                    paragraph.BorderBrush = MutedBrush;
+                    paragraph.BorderThickness = new Thickness(2, 0, 0, 0);
+                    paragraph.Padding = new Thickness(6, 0, 0, 0);
+                    break;
+            }
+            foreach (var inline in block.Inlines)
+            {
+                AddLines(paragraph.Inlines, inline.Text, inline.Style);
+            }
+            document.Blocks.Add(paragraph);
+        }
+        return document;
+    }
+
+    /// <summary>改行を LineBreak に変えながら文字を足す。</summary>
+    private static void AddLines(InlineCollection inlines, string text, MdInlineStyle? style)
+    {
+        string[] lines = text.Split('\n');
+        for (int index = 0; index < lines.Length; index++)
+        {
+            if (index > 0) inlines.Add(new LineBreak());
+            if (lines[index].Length == 0) continue;
+            Inline run = new Run(lines[index]);
+            if (style == MdInlineStyle.Bold) run = new Bold(run);
+            else if (style == MdInlineStyle.Code)
+            {
+                run.FontFamily = MonoFont;
+                run.Foreground = CodeBrush;
+                run.Background = CodeBackground;
+            }
+            inlines.Add(run);
+        }
+    }
+
+    private static SolidColorBrush Brush(string hex)
+    {
+        var brush = (SolidColorBrush)new BrushConverter().ConvertFromString(hex)!;
+        brush.Freeze();
+        return brush;
+    }
+}
diff --git a/launcher/windows/LocalSearchLauncher/OpenCodeConversation.cs b/launcher/windows/LocalSearchLauncher/OpenCodeConversation.cs
new file mode 100644
index 0000000000000000000000000000000000000000..8d0f1873d3dc9b771de52ddb16138fb2ff3d7f84
--- /dev/null
+++ b/launcher/windows/LocalSearchLauncher/OpenCodeConversation.cs
@@ -0,0 +1,445 @@
+/**
+ * WPF ランチャーの OpenCode CLI ペインの会話とプロセス実行。
+ *
+ * 【仕様】
+ * - OpenCodeConversation はアプリ（App）が 1 つだけ持ち、ウィンドウを閉じても実行中の opencode とチャット表示（Transcript）を保持する。
+ *   ウィンドウは Changed イベントで画面を更新し、再表示時は現在の会話・状態を表示する。
+ * - 作業フォルダが未設定・存在しないときは opencode を起動しない（別のフォルダで代わりに動かさない）。
+ * - 1 回目の出力に含まれる sessionID を覚え、2 回目以降は --session で同じ会話を続ける。ID が取れない成功時は --continue。
+ * - 送信時に Model（--model）・PlanMode（--agent plan）・AutoApprove（--auto）を渡し、常に --thinking で思考も受け取る。
+ * - 同時に 2 つの opencode は走らせない。実行中に送った指示は待ち行列（Queue）へ入れ、今の実行が終わったら順に送る。
+ *   Cancel()（停止）は実行中の opencode を止め、待ち行列も捨てる。Reset()（新規）はさらに表示と会話IDを消す。
+ * - 結果のお知らせ: 中断「中断しました」、タイムアウト「タイムアウトしたため停止しました」、
+ *   失敗「opencode 実行失敗（exit n）: 標準エラー」、応答が空「（応答なし）」。
+ * - StatusText(): 実行中は「作業中… 12秒」（待ち行列があれば「 · 待機 n件」）、終わったら「完了（2.0秒）」など。
+ * - 会話一覧は session list --format json -n 20、過去の会話の読み込みは session export <ID>、モデル一覧は models（作業フォルダで実行）。
+ * - ProcessOpenCodeRunner は標準出力と標準エラーを並行して読み、タイムアウトで止める。cmd.exe は経由しない。
+ * - 登録したスラッシュコマンド（SlashCommands）は送る直前にプロンプトへ展開する。吹き出しと指示の履歴には打った文字を残す。
+ **/
+using System.Diagnostics;
+using System.IO;
+using System.Text;
+
+namespace LocalSearchLauncher;
+
+/// <summary>opencode プロセス 1 回分の終了状態。</summary>
+internal sealed record OpenCodeRunResult(int ExitCode, string Stderr, bool TimedOut = false, bool Cancelled = false);
+
+/// <summary>短い問い合わせ（会話一覧・会話の書き出し・モデル一覧）の結果。</summary>
+internal sealed record OpenCodeCaptureResult(int ExitCode, string Stdout, string Stderr);
+
+/// <summary>opencode を起動し、標準出力を 1 行ずつ渡す部品。</summary>
+internal interface IOpenCodeProcessRunner
+{
+    Task<OpenCodeRunResult> RunAsync(string workingDir, IReadOnlyList<string> args, Action<string> onLine, CancellationToken cancellationToken);
+
+    Task<OpenCodeCaptureResult> CaptureAsync(string workingDir, IReadOnlyList<string> args, CancellationToken cancellationToken);
+}
+
+/// <summary>opencode を実行できない理由（実行ファイルなし等）。</summary>
+internal sealed class OpenCodeException(string message) : Exception(message);
+
+/// <summary>opencode.exe をサブプロセスで実行する既定のランナー。</summary>
+internal sealed class ProcessOpenCodeRunner(Func<string?> executableResolver, TimeSpan timeout, bool warmUp = true) : IOpenCodeProcessRunner
+{
+    private static readonly TimeSpan CaptureTimeout = TimeSpan.FromSeconds(60);
+    private static int _serviceWarmupStarted;
+
+    public static ProcessOpenCodeRunner CreateDefault() =>
+        new(OpenCodeCommandBuilder.ResolveExecutable, TimeSpan.FromMinutes(15));
+
+    /// <summary>opencode の常駐サービス（opencode service start）を裏で 1 度だけ起動する。</summary>
+    public static void WarmUpService(string executable)
+    {
+        if (Interlocked.Exchange(ref _serviceWarmupStarted, 1) != 0) return;
+        _ = Task.Run(() =>
+        {
+            try
+            {
+                var startInfo = new ProcessStartInfo(executable)
+                {
+                    UseShellExecute = false,
+                    RedirectStandardOutput = true,
+                    RedirectStandardError = true,
+                    CreateNoWindow = true,
+                };
+                startInfo.ArgumentList.Add("service");
+                startInfo.ArgumentList.Add("start");
+                using var process = Process.Start(startInfo);
+                process?.WaitForExit(15000);
+            }
+            catch (Exception error) when (error is System.ComponentModel.Win32Exception or InvalidOperationException or IOException)
+            {
+                // 常駐サービスを起動できなくても opencode run 単体は動く
+            }
+        });
+    }
+
+    private ProcessStartInfo CreateStartInfo(string workingDir, IReadOnlyList<string> args)
+    {
+        string executable = executableResolver()
+            ?? throw new OpenCodeException("opencode が見つかりません（opencode.exe をインストールしてください）");
+        if (warmUp) WarmUpService(executable);
+        var startInfo = new ProcessStartInfo(executable)
+        {
+            UseShellExecute = false,
+            RedirectStandardInput = true,
+            RedirectStandardOutput = true,
+            RedirectStandardError = true,
+            CreateNoWindow = true,
+            StandardOutputEncoding = Encoding.UTF8,
+            StandardErrorEncoding = Encoding.UTF8,
+        };
+        if (!string.IsNullOrWhiteSpace(workingDir)) startInfo.WorkingDirectory = workingDir;
+        foreach (string arg in args) startInfo.ArgumentList.Add(arg);
+        return startInfo;
+    }
+
+    public async Task<OpenCodeRunResult> RunAsync(string workingDir, IReadOnlyList<string> args, Action<string> onLine, CancellationToken cancellationToken)
+    {
+        using var process = new Process { StartInfo = CreateStartInfo(workingDir, args) };
+        process.Start();
+        process.StandardInput.Close();
+        using var timeoutSource = new CancellationTokenSource(timeout);
+        using var linked = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken, timeoutSource.Token);
+        using var killOnCancel = linked.Token.Register(() => Kill(process));
+
+        Task<string> stderrTask = process.StandardError.ReadToEndAsync();
+        while (await process.StandardOutput.ReadLineAsync() is { } line)
+        {
+            onLine(line);
+        }
+        await process.WaitForExitAsync(CancellationToken.None);
+        string stderr = OpenCodeCommandBuilder.StripAnsi(await stderrTask).Trim();
+        return new OpenCodeRunResult(
+            process.ExitCode,
+            stderr,
+            TimedOut: timeoutSource.IsCancellationRequested,
+            Cancelled: cancellationToken.IsCancellationRequested);
+    }
+
+    public async Task<OpenCodeCaptureResult> CaptureAsync(string workingDir, IReadOnlyList<string> args, CancellationToken cancellationToken)
+    {
+        using var process = new Process { StartInfo = CreateStartInfo(workingDir, args) };
+        process.Start();
+        process.StandardInput.Close();
+        using var timeoutSource = new CancellationTokenSource(CaptureTimeout);
+        using var linked = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken, timeoutSource.Token);
+        using var killOnCancel = linked.Token.Register(() => Kill(process));
+        Task<string> stdoutTask = process.StandardOutput.ReadToEndAsync();
+        Task<string> stderrTask = process.StandardError.ReadToEndAsync();
+        await process.WaitForExitAsync(CancellationToken.None);
+        string stdout = await stdoutTask;
+        string stderr = OpenCodeCommandBuilder.StripAnsi(await stderrTask).Trim();
+        return timeoutSource.IsCancellationRequested
+            ? new OpenCodeCaptureResult(-1, "", "タイムアウトしました")
+            : new OpenCodeCaptureResult(process.ExitCode, stdout, stderr);
+    }
+
+    private static void Kill(Process process)
+    {
+        try { process.Kill(entireProcessTree: true); }
+        catch (InvalidOperationException) { }
+    }
+}
+
+/// <summary>OpenCode ペインの作業フォルダ・会話ID・チャット表示・待ち行列・実行状態を、ウィンドウより長く保持する。</summary>
+internal sealed class OpenCodeConversation(IOpenCodeProcessRunner runner, Func<string, bool>? directoryExists = null, Func<DateTimeOffset>? clock = null)
+{
+    private const int SessionListLimit = 20;
+    private readonly Func<string, bool> _directoryExists = directoryExists ?? Directory.Exists;
+    private readonly Func<DateTimeOffset> _clock = clock ?? (() => DateTimeOffset.Now);
+    private readonly object _lock = new();
+    private readonly List<string> _queue = [];
+    private CancellationTokenSource? _running;
+    private DateTimeOffset? _startedAt;
+    private int _generation;
+
+    public string WorkingDir { get; private set; } = "";
+    public ChatTranscript Transcript { get; } = new();
+    public PromptHistory History { get; } = new();
+    public string Status { get; private set; } = "";
+    public string? SessionId { get; private set; }
+    public bool HasConversation { get; private set; }
+    public bool IsRunning
+    {
+        get { lock (_lock) return _running is not null; }
+    }
+
+    public string? Model { get; set; }
+    /// <summary>このアプリ独自のスラッシュコマンド（/pass など）。バックエンドから読み、登録画面で書き換える。</summary>
+    public IReadOnlyList<SlashCommand> SlashCommands { get; set; } = [];
+    public bool PlanMode { get; set; }
+    public bool AutoApprove { get; set; }
+
+    public IReadOnlyList<string> Queue
+    {
+        get { lock (_lock) return _queue.ToArray(); }
+    }
+
+    /// <summary>表示・状態が変わったときに通知する（呼び出し元のスレッドは問わない）。</summary>
+    public event Action? Changed;
+
+    /// <summary>実行中は「作業中… 12秒 · 待機 1件」、それ以外は直近の結果。</summary>
+    public string StatusText()
+    {
+        DateTimeOffset? started;
+        int waiting;
+        lock (_lock)
+        {
+            started = _running is not null ? _startedAt : null;
+            waiting = _queue.Count;
+        }
+        if (started is null) return Status;
+        string text = $"作業中… {OpenCodeChatFormat.FormatElapsed((_clock() - started.Value).TotalSeconds)}";
+        return waiting > 0 ? $"{text} · 待機 {waiting}件" : text;
+    }
+
+    /// <summary>作業フォルダを変える。変わったら新規会話へ戻す。</summary>
+    public void SetWorkingDir(string workingDir)
+    {
+        string normalized = (workingDir ?? "").Trim();
+        if (string.Equals(normalized, WorkingDir, StringComparison.OrdinalIgnoreCase)) return;
+        WorkingDir = normalized;
+        SessionId = null;
+        HasConversation = false;
+        Changed?.Invoke();
+    }
+
+    private string? WorkingDirProblem()
+    {
+        if (WorkingDir.Length == 0) return "opencode 実行フォルダが未設定です（ランチャーの ☰ メニューか Web の設定で指定してください）";
+        if (!_directoryExists(WorkingDir)) return $"opencode 実行フォルダが見つかりません: {WorkingDir}";
+        return null;
+    }
+
+    /// <summary>
+    /// 指示を送る。受け付けなかった（空・未設定・フォルダなし）ときは false。
+    /// 実行中なら待ち行列へ入れて true を返す。実行した場合は、待ち行列の指示も順に送ってから終わる。
+    /// </summary>
+    public async Task<bool> SendAsync(string prompt)
+    {
+        string cleaned = (prompt ?? "").Trim();
+        if (cleaned.Length == 0) return SetStatus("指示を入力してください");
+        if (WorkingDirProblem() is { } problem) return SetStatus(problem);
+
+        lock (_lock)
+        {
+            if (_running is not null)
+            {
+                _queue.Add(cleaned);
+                cleaned = "";
+            }
+            else
+            {
+                _running = new CancellationTokenSource();
+            }
+        }
+        if (cleaned.Length == 0)
+        {
+            Changed?.Invoke();
+            return true;
+        }
+
+        try
+        {
+            string? next = cleaned;
+            while (next is not null)
+            {
+                await RunOnceAsync(next);
+                lock (_lock)
+                {
+                    if (_queue.Count > 0)
+                    {
+                        next = _queue[0];
+                        _queue.RemoveAt(0);
+                        _running?.Dispose();
+                        _running = new CancellationTokenSource();
+                    }
+                    else
+                    {
+                        next = null;
+                    }
+                }
+            }
+        }
+        finally
+        {
+            lock (_lock)
+            {
+                _running?.Dispose();
+                _running = null;
+                _startedAt = null;
+            }
+            Changed?.Invoke();
+        }
+        return true;
+    }
+
+    /// <summary>1 回分の実行と、結果のお知らせ。</summary>
+    private async Task RunOnceAsync(string prompt)
+    {
+        CancellationToken token;
+        int generation;
+        DateTimeOffset started = _clock();
+        lock (_lock)
+        {
+            token = _running!.Token;
+            generation = _generation;
+            _startedAt = started;
+        }
+        History.Add(prompt);
+        Transcript.AddUser(prompt);
+        int shownBefore = Transcript.Snapshot().Count;
+        string toSend = LocalSearchLauncher.SlashCommands.Expand(prompt, SlashCommands) ?? prompt;
+        var args = OpenCodeCommandBuilder.BuildArguments(toSend, SessionId, HasConversation, Model, PlanMode, AutoApprove);
+        string? capturedSession = null;
+        Changed?.Invoke();
+        try
+        {
+            var result = await runner.RunAsync(WorkingDir, args, line =>
+            {
+                capturedSession ??= OpenCodeCommandBuilder.ExtractSessionId(line);
+                bool current;
+                lock (_lock) current = generation == _generation;
+                if (current && Transcript.ApplyLine(line)) Changed?.Invoke();
+            }, token);
+
+            lock (_lock)
+            {
+                if (generation != _generation) return;
+            }
+            double elapsed = (_clock() - started).TotalSeconds;
+            if (result.Cancelled)
+            {
+                Transcript.AddNotice("中断しました");
+                Status = "中断しました";
+            }
+            else if (result.TimedOut)
+            {
+                Transcript.AddNotice("タイムアウトしたため停止しました", error: true);
+                Status = "タイムアウトしました";
+            }
+            else if (result.ExitCode != 0)
+            {
+                string detail = result.Stderr.Length > 0 ? $": {result.Stderr}" : "";
+                Transcript.AddNotice($"opencode 実行失敗（exit {result.ExitCode}）{detail}", error: true);
+                Status = $"opencode 実行失敗（exit {result.ExitCode}）";
+            }
+            else
+            {
+                if (!Transcript.Snapshot().Skip(shownBefore).Any(entry => entry.Kind is ChatEntryKind.Text or ChatEntryKind.Tool))
+                {
+                    Transcript.AddNotice("（応答なし）");
+                }
+                Status = $"完了（{OpenCodeChatFormat.FormatElapsed(elapsed)}）";
+            }
+            if (capturedSession is not null)
+            {
+                SessionId = capturedSession;
+                HasConversation = true;
+            }
+            else if (result.ExitCode == 0 && !result.Cancelled && !result.TimedOut)
+            {
+                HasConversation = true;
+            }
+        }
+        catch (Exception error) when (error is OpenCodeException or System.ComponentModel.Win32Exception or InvalidOperationException or IOException)
+        {
+            Transcript.AddNotice(error.Message, error: true);
+            Status = $"opencode 実行失敗: {error.Message}";
+        }
+    }
+
+    /// <summary>実行中の opencode を止め、待ち行列を捨てる。</summary>
+    public void Cancel()
+    {
+        lock (_lock)
+        {
+            _queue.Clear();
+            try { _running?.Cancel(); }
+            catch (ObjectDisposedException) { }
+        }
+        Changed?.Invoke();
+    }
+
+    /// <summary>実行中なら止め、待ち行列・表示・会話IDを消して新規会話へ戻す。</summary>
+    public void Reset()
+    {
+        lock (_lock)
+        {
+            _generation++;
+            _queue.Clear();
+            try { _running?.Cancel(); }
+            catch (ObjectDisposedException) { }
+        }
+        SessionId = null;
+        HasConversation = false;
+        Transcript.Clear();
+        Status = "新しい会話を開始します";
+        Changed?.Invoke();
+    }
+
+    /// <summary>作業フォルダの会話一覧（新しい順）。取れなければ空。</summary>
+    public async Task<IReadOnlyList<OpenCodeSessionSummary>> ListSessionsAsync()
+    {
+        if (WorkingDirProblem() is not null) return [];
+        try
+        {
+            var result = await runner.CaptureAsync(WorkingDir, ["session", "list", "--format", "json", "-n", SessionListLimit.ToString()], CancellationToken.None);
+            return result.ExitCode == 0 ? OpenCodeChatFormat.ParseSessionList(result.Stdout) : [];
+        }
+        catch (Exception error) when (error is OpenCodeException or System.ComponentModel.Win32Exception or InvalidOperationException or IOException)
+        {
+            return [];
+        }
+    }
+
+    /// <summary>過去の会話を読み込み、その会話IDで続ける。実行中・読み込み失敗は false（今の会話は残す）。</summary>
+    public async Task<bool> ResumeAsync(string sessionId)
+    {
+        if (WorkingDirProblem() is { } problem) return SetStatus(problem);
+        if (IsRunning) return SetStatus("opencode 実行中は会話を切り替えられません");
+        OpenCodeCaptureResult result;
+        try
+        {
+            result = await runner.CaptureAsync(WorkingDir, ["session", "export", sessionId], CancellationToken.None);
+        }
+        catch (Exception error) when (error is OpenCodeException or System.ComponentModel.Win32Exception or InvalidOperationException or IOException)
+        {
+            return SetStatus($"会話を読み込めません: {error.Message}");
+        }
+        int start = result.Stdout.IndexOf('{');
+        if (result.ExitCode != 0 || start < 0) return SetStatus($"会話を読み込めません: {(result.Stderr.Length > 0 ? result.Stderr : sessionId)}");
+        var restored = ChatTranscript.FromExport(result.Stdout[start..]);
+        lock (_lock) _generation++;
+        Transcript.ReplaceWith(restored);
+        SessionId = sessionId;
+        HasConversation = true;
+        Status = $"会話を再開しました: {(restored.Title.Length > 0 ? restored.Title : sessionId)}";
+        Changed?.Invoke();
+        return true;
+    }
+
+    /// <summary>使えるモデルの一覧（opencode models）。取れなければ空。</summary>
+    public async Task<IReadOnlyList<string>> ListModelsAsync()
+    {
+        try
+        {
+            string dir = WorkingDirProblem() is null ? WorkingDir : "";
+            var result = await runner.CaptureAsync(dir, ["models"], CancellationToken.None);
+            return result.ExitCode == 0 ? OpenCodeChatFormat.ParseModelList(result.Stdout) : [];
+        }
+        catch (Exception error) when (error is OpenCodeException or System.ComponentModel.Win32Exception or InvalidOperationException or IOException)
+        {
+            return [];
+        }
+    }
+
+    private bool SetStatus(string status)
+    {
+        Status = status;
+        Changed?.Invoke();
+        return false;
+    }
+}
