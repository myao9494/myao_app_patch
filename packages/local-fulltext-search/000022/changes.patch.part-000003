+
+/// <summary>1ページ4ペイン（左上:検索 → 右上:opencode CLI → 左下:永続メモ → 右下:gantt）のTab/Shift+Tabフォーカス順序を提供する。</summary>
+internal static class LauncherTabNavigation
+{
+    private static readonly string[] Order =
+    [
+        "Query",
+        "Extension",
+        "OpenCodeInput",
+        "OpenCodeSubmit",
+        "Scratchpad",
+        "MemoTitle",
+        "MemoBody",
+        "MemoSubmit",
+    ];
+
+    public static string Next(string current, bool backwards = false)
+    {
+        int index = Array.IndexOf(Order, current);
+        if (index < 0) index = 0;
+        int step = backwards ? -1 : 1;
+        int nextIndex = (index + step + Order.Length) % Order.Length;
+        return Order[nextIndex];
+    }
+}
+
+/// <summary>
+/// opencode CLI 実行用の引数組み立て・会話IDの取り出し・ANSIエスケープ除去・実行ファイル解決を提供する。
+/// 出力（NDJSON）の表示は ChatTranscript（OpenCodeChat.cs）が受け持つ。
+/// 指示は `--` の後ろへ置き、`-` で始まる指示もオプションとして解釈させない。
+/// 実行ファイルは opencode.exe だけを使い、cmd.exe を経由する opencode.cmd は使わない
+/// （cmd.exe は `&` や `|` を含む指示を別コマンドとして解釈するため）。
+/// </summary>
+internal static class OpenCodeCommandBuilder
+{
+    private static readonly Regex AnsiEscapeRegex = new(@"\x1b\[[0-9;?]*[ -/]*[@-~]", RegexOptions.Compiled);
+
+    /// <summary>
+    /// opencode run の引数を組み立てる。思考を表示するため常に --thinking を付け、
+    /// モデル（--model）・Plan（--agent plan）・自動承認（--auto）・会話の続き（--session / --continue）の順に足し、指示は -- の後ろへ置く。
+    /// </summary>
+    public static IReadOnlyList<string> BuildArguments(
+        string prompt,
+        string? sessionId = null,
+        bool continueSession = false,
+        string? model = null,
+        bool planMode = false,
+        bool autoApprove = false)
+    {
+        string cleaned = (prompt ?? "").Trim();
+        var args = new List<string> { "run", "--format", "json", "--thinking" };
+        if (!string.IsNullOrWhiteSpace(model))
+        {
+            args.Add("--model");
+            args.Add(model.Trim());
+        }
+        if (planMode)
+        {
+            args.Add("--agent");
+            args.Add("plan");
+        }
+        if (autoApprove) args.Add("--auto");
+        if (!string.IsNullOrWhiteSpace(sessionId))
+        {
+            args.Add("--session");
+            args.Add(sessionId);
+        }
+        else if (continueSession)
+        {
+            args.Add("--continue");
+        }
+        args.Add("--");
+        args.Add(cleaned);
+        return args;
+    }
+
+    public static string StripAnsi(string text)
+    {
+        string normalized = (text ?? "").Replace("\r\n", "\n").Replace("\r", "\n");
+        return AnsiEscapeRegex.Replace(normalized, "");
+    }
+
+    /// <summary>NDJSON の1行を JSON として読む。JSONでなければ null。</summary>
+    private static JsonDocument? TryParse(string line)
+    {
+        string raw = (line ?? "").Trim();
+        if (!(raw.StartsWith('{') && raw.EndsWith('}'))) return null;
+        try { return JsonDocument.Parse(raw); }
+        catch (JsonException) { return null; }
+    }
+
+    /// <summary>NDJSONイベントの sessionID を返す。JSONでない行やIDのない行は null。</summary>
+    public static string? ExtractSessionId(string line)
+    {
+        using var doc = TryParse(line);
+        if (doc is null) return null;
+        return doc.RootElement.ValueKind == JsonValueKind.Object
+            && doc.RootElement.TryGetProperty("sessionID", out var id)
+            && id.ValueKind == JsonValueKind.String
+            && !string.IsNullOrWhiteSpace(id.GetString())
+            ? id.GetString()
+            : null;
+    }
+
+    /// <summary>この PC の環境から opencode.exe を探す。見つからなければ null。</summary>
+    public static string? ResolveExecutable() => ResolveExecutable(
+        Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData),
+        File.Exists,
+        Environment.GetEnvironmentVariable("PATH") ?? "");
+
+    /// <summary>npm 配下の opencode.exe → PATH 上の opencode.exe の順に探す。opencode.cmd は使わない。</summary>
+    public static string? ResolveExecutable(string appData, Func<string, bool> fileExists, string pathVariable)
+    {
+        if (!string.IsNullOrWhiteSpace(appData))
+        {
+            string npmRoot = Path.Combine(appData, "npm", "node_modules", "@opencode", "cli");
+            foreach (var candidate in new[]
+            {
+                Path.Combine(npmRoot, "bin", "opencode.exe"),
+                Path.Combine(npmRoot, "node_modules", "@opencode", "cli-windows-x64", "bin", "opencode.exe"),
+            })
+            {
+                if (fileExists(candidate)) return candidate;
+            }
+        }
+        foreach (var directory in (pathVariable ?? "").Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
+        {
+            string candidate = Path.Combine(directory, "opencode.exe");
+            if (fileExists(candidate)) return candidate;
+        }
+        return null;
+    }
+}
diff --git a/launcher/windows/LocalSearchLauncher/SlashCommands.cs b/launcher/windows/LocalSearchLauncher/SlashCommands.cs
new file mode 100644
index 0000000000000000000000000000000000000000..8af5a01992c259751e4fab9fcf2cbb136a67b696
--- /dev/null
+++ b/launcher/windows/LocalSearchLauncher/SlashCommands.cs
@@ -0,0 +1,171 @@
+/**
+ * OpenCode ペインのスラッシュコマンド（このアプリ独自の定型作業。/pass など）の展開・入力チェック・補完。
+ * Python 版（launcher_app/slash_commands.py）と同じ約束で動く。
+ *
+ * 【仕様】
+ * - コマンドは 名前・プロンプト・説明。保存はバックエンドの api/index/settings/launcher-slash-commands（一覧ごと）。
+ * - 展開: 指示の最初の語が「/登録済みの名前」（大文字小文字を区別しない）なら、プロンプトへ置き換えて送る。
+ *   プロンプト中の $ARGUMENTS は名前の後ろの文字に置き換え、無ければ後ろの文字があるときだけ空行のあとへ足す。
+ *   登録の無い名前や /usr/bin のようなパスは展開しない。
+ * - 登録の入力チェック: 名前（先頭の / は外す）が空・空白や / を含む・既存と重複、プロンプトが空はエラー。
+ * - 補完（Obsidian と同じ操作）: 先頭が / でカーソルが最初の語の中にある間だけ候補を出す。前方一致 → 途中一致（それぞれ名前順）。
+ *   上下で選び（端で回る）、Tab / Enter で「/名前 」に置き換えて確定、Esc で閉じる（文字が変わるまで開かない）。
+ *   Tab は候補が 1 つならすぐ補完、複数なら候補を開く。
+ **/
+using System.Text.Json;
+using System.Text.RegularExpressions;
+
+namespace LocalSearchLauncher;
+
+/// <summary>スラッシュコマンド 1 件。Name は先頭の / を含まない。</summary>
+internal sealed record SlashCommand(string Name, string Prompt, string Description = "");
+
+internal static class SlashCommands
+{
+    public const string ArgumentsPlaceholder = "$ARGUMENTS";
+    private static readonly Regex FirstToken = new(@"^/(\S*)", RegexOptions.Compiled);
+
+    /// <summary>前後の空白と先頭の / を外す。</summary>
+    public static string NormalizeName(string name) => (name ?? "").Trim().TrimStart('/');
+
+    /// <summary>API の {"commands": [...]} を読む。名前かプロンプトの無い項目・壊れた JSON は飛ばす。</summary>
+    public static IReadOnlyList<SlashCommand> Parse(string json)
+    {
+        try
+        {
+            using var document = JsonDocument.Parse(json);
+            var root = document.RootElement;
+            var items = root.ValueKind == JsonValueKind.Object && root.TryGetProperty("commands", out var list) ? list : root;
+            if (items.ValueKind != JsonValueKind.Array) return [];
+            var commands = new List<SlashCommand>();
+            foreach (var item in items.EnumerateArray())
+            {
+                if (item.ValueKind != JsonValueKind.Object) continue;
+                string name = NormalizeName(Str(item, "name"));
+                string prompt = Str(item, "prompt").Trim();
+                if (name.Length > 0 && prompt.Length > 0) commands.Add(new SlashCommand(name, prompt, Str(item, "description").Trim()));
+            }
+            return commands;
+        }
+        catch (JsonException) { return []; }
+    }
+
+    /// <summary>登録画面の入力チェック。問題があれば利用者向けの文言、無ければ null。</summary>
+    public static string? Validate(string name, string prompt, IEnumerable<string> existingNames)
+    {
+        string cleaned = NormalizeName(name);
+        if (cleaned.Length == 0) return "コマンド名を入力してください";
+        if (cleaned.Any(ch => char.IsWhiteSpace(ch) || ch == '/')) return "コマンド名に空白や / は使えません";
+        if (existingNames.Any(existing => string.Equals(NormalizeName(existing), cleaned, StringComparison.OrdinalIgnoreCase))) return $"/{cleaned} はすでに登録されています";
+        if ((prompt ?? "").Trim().Length == 0) return "プロンプトを入力してください";
+        return null;
+    }
+
+    /// <summary>「/名前 引数」を登録したプロンプトへ展開する。登録の無い名前・コマンドでない文字は null。</summary>
+    public static string? Expand(string text, IReadOnlyList<SlashCommand> commands)
+    {
+        string raw = (text ?? "").Trim();
+        var match = FirstToken.Match(raw);
+        if (!match.Success || match.Groups[1].Value.Length == 0) return null;
+        var command = commands.FirstOrDefault(c => string.Equals(c.Name, match.Groups[1].Value, StringComparison.OrdinalIgnoreCase));
+        if (command is null) return null;
+        string arguments = raw[match.Length..].Trim();
+        if (command.Prompt.Contains(ArgumentsPlaceholder, StringComparison.Ordinal)) return command.Prompt.Replace(ArgumentsPlaceholder, arguments, StringComparison.Ordinal);
+        return arguments.Length > 0 ? $"{command.Prompt}\n\n{arguments}" : command.Prompt;
+    }
+
+    /// <summary>先頭が / でカーソルが最初の語の中にあるとき、/ の後ろからカーソルまでの文字（検索語）。それ以外は null。</summary>
+    public static string? Query(string text, int caret)
+    {
+        string before = (text ?? "")[..Math.Clamp(caret, 0, (text ?? "").Length)];
+        if (!before.StartsWith('/') || before.Any(char.IsWhiteSpace)) return null;
+        return before[1..];
+    }
+
+    /// <summary>前方一致（名前順）→ 途中一致（名前順）の候補。</summary>
+    public static IReadOnlyList<SlashCommand> Candidates(IReadOnlyList<SlashCommand> commands, string query)
+    {
+        var ordered = commands.OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase).ToList();
+        var prefix = ordered.Where(c => c.Name.StartsWith(query ?? "", StringComparison.OrdinalIgnoreCase)).ToList();
+        var contains = ordered.Where(c => !prefix.Contains(c) && c.Name.Contains(query ?? "", StringComparison.OrdinalIgnoreCase));
+        return [.. prefix, .. contains];
+    }
+
+    /// <summary>最初の語を「/名前 」に置き換え、(新しい文字, カーソル位置) を返す。後ろの文字は残す。</summary>
+    public static (string Text, int Caret) ApplyCompletion(string text, int caret, string name)
+    {
+        string raw = text ?? "";
+        var match = FirstToken.Match(raw);
+        string rest = match.Success ? raw[match.Length..] : raw[Math.Clamp(caret, 0, raw.Length)..];
+        string head = $"/{name}";
+        return rest.Length > 0 && char.IsWhiteSpace(rest[0]) ? ($"{head}{rest}", head.Length + 1) : ($"{head} {rest}", head.Length + 1);
+    }
+
+    private static string Str(JsonElement element, string name) =>
+        element.TryGetProperty(name, out var value) && value.ValueKind == JsonValueKind.String ? value.GetString() ?? "" : "";
+}
+
+/// <summary>指示欄の補完候補の表示状態（開閉・候補・選択位置）。</summary>
+internal sealed class SlashSuggestions
+{
+    private string? _text;
+    private string? _dismissedText;
+
+    public IReadOnlyList<SlashCommand> Items { get; private set; } = [];
+    public int Index { get; private set; }
+    public bool IsOpen { get; private set; }
+    public SlashCommand? Selected => IsOpen && Items.Count > 0 ? Items[Index] : null;
+
+    /// <summary>入力が変わるたびに候補を作り直し、先頭を選ぶ。force は Esc で閉じた状態でも開く（Tab 用）。</summary>
+    public void Refresh(string text, int caret, IReadOnlyList<SlashCommand> commands, bool force = false)
+    {
+        _text = text;
+        string? query = SlashCommands.Query(text, caret);
+        if (query is null)
+        {
+            IsOpen = false;
+            _dismissedText = null;
+            return;
+        }
+        if (!force && _dismissedText == text)
+        {
+            IsOpen = false;
+            return;
+        }
+        _dismissedText = null;
+        // 入力が変わったら先頭の候補を選び直す（Obsidian と同じ）
+        Items = SlashCommands.Candidates(commands, query);
+        Index = 0;
+        IsOpen = Items.Count > 0;
+    }
+
+    /// <summary>選択を上下へ動かす（端で回る）。</summary>
+    public void Move(int delta)
+    {
+        if (Items.Count > 0) Index = ((Index + delta) % Items.Count + Items.Count) % Items.Count;
+    }
+
+    /// <summary>選択中の候補で補完して閉じる。候補が無ければ null。</summary>
+    public (string Text, int Caret)? Accept(string text, int caret)
+    {
+        var command = Selected;
+        if (command is null) return null;
+        IsOpen = false;
+        return SlashCommands.ApplyCompletion(text, caret, command.Name);
+    }
+
+    /// <summary>Esc: 閉じて、文字が変わるまで開かない。</summary>
+    public void Dismiss()
+    {
+        _dismissedText = _text;
+        IsOpen = false;
+    }
+
+    /// <summary>Tab: 開いていれば選択中を確定。閉じていれば、候補 1 つは即補完、複数は開いて null。</summary>
+    public (string Text, int Caret)? CompleteOnTab(string text, int caret, IReadOnlyList<SlashCommand> commands)
+    {
+        if (IsOpen) return Accept(text, caret);
+        Refresh(text, caret, commands, force: true);
+        return IsOpen && Items.Count == 1 ? Accept(text, caret) : null;
+    }
+}
diff --git a/launcher/windows/LocalSearchLauncher/SlashCommandsWindow.xaml b/launcher/windows/LocalSearchLauncher/SlashCommandsWindow.xaml
new file mode 100644
index 0000000000000000000000000000000000000000..16552f035894ec18acf1bdeb088ac08cab2bbb78
--- /dev/null
+++ b/launcher/windows/LocalSearchLauncher/SlashCommandsWindow.xaml
@@ -0,0 +1,38 @@
+<Window x:Class="LocalSearchLauncher.SlashCommandsWindow"
+ xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
+ Title="スラッシュコマンド" Width="720" Height="480" MinWidth="560" MinHeight="380" WindowStartupLocation="CenterOwner"
+ Background="#FF0F172A" Foreground="#F8FAFC" ShowInTaskbar="False" Topmost="True" PreviewKeyDown="Window_PreviewKeyDown">
+ <!-- OpenCode ペインの独自スラッシュコマンド（/pass など）を登録・編集・削除する画面 -->
+ <Grid Margin="14">
+  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
+  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
+  <DockPanel Grid.Column="0" Margin="0,0,12,0">
+   <TextBlock DockPanel.Dock="Top" Text="登録済み" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
+   <Button x:Name="NewButton" DockPanel.Dock="Bottom" Content="＋ 新規" Margin="0,8,0,0" Padding="8,4" Background="#1E293B" Foreground="#93C5FD" BorderBrush="#334155" Click="NewButton_Click"/>
+   <ListBox x:Name="CommandList" Background="#CC1E293B" Foreground="#F8FAFC" BorderBrush="#334155" SelectionChanged="CommandList_SelectionChanged"/>
+  </DockPanel>
+  <Grid Grid.Column="1">
+   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
+   <TextBlock Text="コマンド名" Foreground="#94A3B8" FontSize="11"/>
+   <DockPanel Grid.Row="1" Margin="0,2,0,8">
+    <TextBlock DockPanel.Dock="Left" Text="/" FontSize="16" Foreground="#93C5FD" VerticalAlignment="Center" Margin="0,0,4,0"/>
+    <TextBox x:Name="NameBox" FontSize="14" Padding="6,4" Background="#CC1E293B" Foreground="#F8FAFC" BorderBrush="#3B82F6" ToolTip="例: pass（空白と / は使えません）"/>
+   </DockPanel>
+   <TextBlock Grid.Row="2" Text="説明（候補に表示）" Foreground="#94A3B8" FontSize="11"/>
+   <TextBox x:Name="DescriptionBox" Grid.Row="3" Margin="0,2,0,8" Padding="6,4" Background="#CC1E293B" Foreground="#F8FAFC" BorderBrush="#334155" ToolTip="例: エクセルからパスワードを取得"/>
+   <TextBlock Grid.Row="4" Text="プロンプト（$ARGUMENTS はコマンドの後ろに打った文字に置き換わります）" Foreground="#94A3B8" FontSize="11"/>
+   <TextBox x:Name="PromptBox" Grid.Row="5" Margin="0,2,0,6" Padding="6,4" FontSize="13" Background="#CC1E293B" Foreground="#F8FAFC" BorderBrush="#334155" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
+            ToolTip="例: C:\work\passwords.xlsx を開いて、$ARGUMENTS のパスワードを探して教えて"/>
+   <TextBlock Grid.Row="6" Foreground="#64748B" FontSize="11" TextWrapping="Wrap"
+              Text="使い方: 指示欄で /pass gmail と打って送信 → 「$ARGUMENTS」が gmail に置き換わったプロンプトを opencode へ送ります。$ARGUMENTS が無いときは、後ろの文字をプロンプトの末尾に足します。"/>
+  </Grid>
+  <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
+   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
+    <Button x:Name="DeleteButton" Content="削除" Margin="6,0,0,0" Padding="12,4" Background="#1E293B" Foreground="#FCA5A5" BorderBrush="#334155" Click="DeleteButton_Click"/>
+    <Button x:Name="SaveButton" Content="保存" Margin="6,0,0,0" Padding="16,4" Background="#1D4ED8" Foreground="#F8FAFC" BorderBrush="#3B82F6" Click="SaveButton_Click"/>
+    <Button Content="閉じる" Margin="6,0,0,0" Padding="12,4" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" Click="CloseButton_Click"/>
+   </StackPanel>
+   <TextBlock x:Name="StatusText" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
+  </DockPanel>
+ </Grid>
+</Window>
diff --git a/launcher/windows/LocalSearchLauncher/SlashCommandsWindow.xaml.cs b/launcher/windows/LocalSearchLauncher/SlashCommandsWindow.xaml.cs
new file mode 100644
index 0000000000000000000000000000000000000000..56e61677b41ca37817ee2308818dadc2b58d081c
--- /dev/null
+++ b/launcher/windows/LocalSearchLauncher/SlashCommandsWindow.xaml.cs
@@ -0,0 +1,148 @@
+/**
+ * OpenCode ペインの独自スラッシュコマンド（/pass など）の登録画面。
+ *
+ * 【仕様】
+ * - 左に登録済みの一覧（名前順）、右に コマンド名・説明・プロンプト の入力欄。一覧で選ぶと入力欄へ読み込む。
+ * - 「＋ 新規」で入力欄を空にする。「保存」は入力をチェック（SlashCommands.Validate）してから、
+ *   選択中のコマンドの書き換え（名前の変更も可）または追加として一覧ごとバックエンドへ保存する。
+ * - 「削除」は確認してから一覧ごと保存する。保存に失敗したら理由を表示し、画面の一覧は変えない。
+ * - Esc で閉じる。保存はその場でバックエンドへ送るため、閉じても取り消しにはならない。
+ **/
+using System.Net.Http;
+using System.Windows;
+using System.Windows.Controls;
+using System.Windows.Input;
+
+namespace LocalSearchLauncher;
+
+public partial class SlashCommandsWindow : Window
+{
+    private readonly Func<IReadOnlyList<SlashCommand>, Task<IReadOnlyList<SlashCommand>>> _save;
+    private List<SlashCommand> _commands;
+    private string? _editingName;
+    private bool _suppressSelection;
+
+    internal SlashCommandsWindow(IReadOnlyList<SlashCommand> commands, Func<IReadOnlyList<SlashCommand>, Task<IReadOnlyList<SlashCommand>>> save)
+    {
+        InitializeComponent();
+        _save = save;
+        _commands = Sorted(commands);
+        RenderList(null);
+        ClearEditor();
+        Loaded += (_, _) => NameBox.Focus();
+    }
+
+    private static List<SlashCommand> Sorted(IEnumerable<SlashCommand> commands) =>
+        commands.OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase).ToList();
+
+    private void RenderList(string? selectName)
+    {
+        _suppressSelection = true;
+        CommandList.Items.Clear();
+        foreach (var command in _commands)
+        {
+            CommandList.Items.Add(new ListBoxItem
+            {
+                Content = command.Description.Length > 0 ? $"/{command.Name}  {command.Description}" : $"/{command.Name}",
+                Tag = command.Name,
+                ToolTip = command.Prompt,
+            });
+        }
+        int index = selectName is null ? -1 : _commands.FindIndex(c => string.Equals(c.Name, selectName, StringComparison.OrdinalIgnoreCase));
+        CommandList.SelectedIndex = index;
+        _suppressSelection = false;
+        DeleteButton.IsEnabled = index >= 0;
+    }
+
+    private void ClearEditor()
+    {
+        _editingName = null;
+        NameBox.Text = "";
+        DescriptionBox.Text = "";
+        PromptBox.Text = "";
+        DeleteButton.IsEnabled = false;
+    }
+
+    private void CommandList_SelectionChanged(object sender, SelectionChangedEventArgs e)
+    {
+        if (_suppressSelection || CommandList.SelectedItem is not ListBoxItem { Tag: string name }) return;
+        var command = _commands.FirstOrDefault(c => c.Name == name);
+        if (command is null) return;
+        _editingName = command.Name;
+        NameBox.Text = command.Name;
+        DescriptionBox.Text = command.Description;
+        PromptBox.Text = command.Prompt;
+        DeleteButton.IsEnabled = true;
+        StatusText.Text = "";
+    }
+
+    private void NewButton_Click(object sender, RoutedEventArgs e)
+    {
+        CommandList.SelectedIndex = -1;
+        ClearEditor();
+        StatusText.Text = "新しいコマンドを入力して「保存」を押してください";
+        NameBox.Focus();
+    }
+
+    /// <summary>入力をチェックし、選択中の書き換えまたは追加として一覧ごと保存する。</summary>
+    private async void SaveButton_Click(object sender, RoutedEventArgs e)
+    {
+        var others = _commands.Where(c => !string.Equals(c.Name, _editingName, StringComparison.OrdinalIgnoreCase)).ToList();
+        if (SlashCommands.Validate(NameBox.Text, PromptBox.Text, others.Select(c => c.Name)) is { } problem)
+        {
+            StatusText.Text = problem;
+            return;
+        }
+        var command = new SlashCommand(SlashCommands.NormalizeName(NameBox.Text), PromptBox.Text.Trim(), DescriptionBox.Text.Trim());
+        if (await SaveAsync([.. others, command]))
+        {
+            _editingName = command.Name;
+            RenderList(command.Name);
+            StatusText.Text = $"/{command.Name} を保存しました";
+        }
+    }
+
+    private async void DeleteButton_Click(object sender, RoutedEventArgs e)
+    {
+        if (_editingName is null) return;
+        string name = _editingName;
+        if (MessageBox.Show(this, $"/{name} を削除しますか？", "スラッシュコマンド", MessageBoxButton.YesNo, MessageBoxImage.Question) != MessageBoxResult.Yes) return;
+        if (await SaveAsync(_commands.Where(c => c.Name != name).ToList()))
+        {
+            RenderList(null);
+            ClearEditor();
+            StatusText.Text = $"/{name} を削除しました";
+        }
+    }
+
+    /// <summary>一覧をバックエンドへ保存し、成功したら保存後の一覧で置き換える。失敗したら理由を出して false。</summary>
+    private async Task<bool> SaveAsync(List<SlashCommand> commands)
+    {
+        SaveButton.IsEnabled = false;
+        try
+        {
+            _commands = Sorted(await _save(commands));
+            return true;
+        }
+        catch (Exception error) when (error is HttpRequestException or TaskCanceledException)
+        {
+            StatusText.Text = $"保存できません: {error.Message}";
+            return false;
+        }
+        finally
+        {
+            SaveButton.IsEnabled = true;
+        }
+    }
+
+    private void CloseButton_Click(object sender, RoutedEventArgs e) => Close();
+
+    private void Window_PreviewKeyDown(object sender, KeyEventArgs e)
+    {
+        if (e.Key == Key.Escape)
+        {
+            e.Handled = true;
+            Close();
+        }
+    }
+}
diff --git a/launcher/windows/README.md b/launcher/windows/README.md
index 4393e49320fbfe3959bdec716237c0001955fff1..e8c658f75d9553e7a1e308020fb5e4c74c36477d 100644
--- a/launcher/windows/README.md
+++ b/launcher/windows/README.md
@@ -10,7 +10,9 @@ Windows標準APIと.NET標準機能だけで動く、Windows x64向けランチ
 - ウィンドウ上部の「Local Search」領域をドラッグして表示位置を移動可能
 - 多重起動防止
 
-WPF版はmacOSネイティブ版の操作仕様に合わせ、検索欄右側の拡張子フィルタ、gantt検索、タスク名・メモ・送信・キャンセル、共有parent取得、パスコピー、保存場所、フォルダ、ganttリンク、GUIボタン、上下キー循環選択を提供します。表示直後に検索欄へフォーカスし、検索結果の先頭が選択されていれば矢印操作なしの `Return` / `Enter` で開きます。`Tab` / `Shift + Tab` は「検索欄 → 拡張子欄 → タスク名 → メモ → 送信 → 検索欄」を循環し、送信後のTabでは検索画面を表示します。`.py`、`.bat`、`.exe`、`.lnk` は8001のOpenハブを経由せず、親フォルダをcurrent directoryとして直接起動します。検索結果領域は横スクロールを使わず、長いパス・抜粋・操作ボタンを折り返します。Windowsの検索性能仕様に従い、通常時（「更新」チェックOFF）は既存DB専用API（`/api/search/indexed`）を使用してベクトルのインデックス作成を待たず既存DBだけで即座に高速検索し、「更新」チェックON時は最新のインデックス作成・更新を待ってから検索します。gantt選択時は `skip_refresh=true` の `/api/search` を使用し、いずれもローカルファイルとWebページの両方を既存DBから横断検索します。
+WPF版はmacOSネイティブ版の操作仕様に合わせ、検索欄右側の拡張子フィルタ、gantt検索、タスク名・メモ・送信・キャンセル、共有parent取得、パスコピー、保存場所、フォルダ、ganttリンク、GUIボタン、上下キー循環選択を提供します。表示直後に検索欄へフォーカスし、検索結果の先頭が選択されていれば矢印操作なしの `Return` / `Enter` で開きます。縦画面モニターでも収まる幅（1040×940）に4ペイン（左上: 検索、右上: OpenCode CLI、左下: 常時保持メモ、右下: ganttメモ）を統合し、`Tab` / `Shift + Tab` は「検索欄 → 拡張子欄 → OpenCode入力 → OpenCode送信 → 常時保持メモ → タスク名 → メモ → gantt送信 → 検索欄」を循環します。OpenCode入力欄およびgantt入力欄では `Ctrl + Enter` で即時送信できます。opencode の会話と常時保持メモはアプリ側が持つため、Esc でウィンドウを閉じても実行中の opencode とメモの保存は止まらず、再表示すると途中経過から表示します（仕様は `docs/gantt_launcher_ui.md`）。`.py`、`.bat`、`.exe`、`.lnk` は8001のOpenハブを経由せず、親フォルダをcurrent directoryとして直接起動します。検索結果領域は横スクロールを使わず、長いパス・抜粋・操作ボタンを折り返します。Windowsの検索性能仕様に従い、通常時（「更新」チェックOFF）は既存DB専用API（`/api/search/indexed`）を使用してベクトルのインデックス作成を待たず既存DBだけで即座に高速検索し、「更新」チェックON時は最新のインデックス作成・更新を待ってから検索します。gantt選択時は `skip_refresh=true` の `/api/search` を使用し、いずれもローカルファイルとWebページの両方を既存DBから横断検索します。
+
+右上の OpenCode ペインは Obsidian の Claudian 風チャットです（吹き出し・思考/ツールの折りたたみ・コピー・使用量、Enter で送信 / Shift+Enter で改行 / ↑↓ で過去の指示、履歴からの再開・モデル・Plan・自動承認、実行中の送信は待ち行列で送信ボタンは「停止」、「/ コマンド」で登録したスラッシュコマンドを `/` の候補・Tab 補完で実行、左上の ☰ メニューで opencode 実行フォルダを選ぶ／既定に戻す）。詳細は `docs/opencode_chat_pane_spec.md`。
 
 検索APIとgantt APIのタイムアウトは `LAUNCHER_REQUEST_TIMEOUT`（秒、既定15）で変更できます。検索がタイムアウトしたときは「検索中…」のまま残さず、状態欄に `検索がタイムアウトしました（15秒）` と表示します。新しい入力で置き換えられた検索の取り消しと失敗は表示しません。
 
@@ -30,7 +32,7 @@ WPF初期版の背景は半透明ネイビーパネルとドロップシャド
 .\launcher\windows\publish.ps1
 ```
 
-発行中は起動中の `LocalSearchLauncher.exe` を終了してください。発行スクリプトは古い成果物の混入を防ぐため、対象の出力フォルダを削除してから作り直します。
+発行中は起動中の `LocalSearchLauncher.exe` を終了してください。起動中のまま実行するとエラーで止まります（`-StopRunningLauncher` を付けると、ランチャーを終了してから発行します）。発行スクリプトは古い成果物の混入を防ぐため、対象の出力フォルダを削除してから作り直し、削除・発行・置き換えのどれかに失敗したらエラーで終わります（古い成果物を残したまま成功扱いにしません）。
 
 `publish/folder` が会社PC向けの第一候補、`publish/single-file` が携帯版です。会社PC側にSDKや.NETランタイムは不要です。
 
@@ -42,7 +44,7 @@ WPF初期版の背景は半透明ネイビーパネルとドロップシャド
 
 発行スクリプトは各出力フォルダを作り直すため、以前のPDBやDLLが配布物へ混入しません。single-file版はEXE 1個、通常版は.NETランタイムを含む複数ファイルになります。single-file版は実行時にネイティブライブラリを一時ディレクトリへ展開するため、社内EDRとの相性では通常版を優先してください。
 
-`start_windows.bat` はバックエンドを起動し、バックエンドのランチャー管理機能が `launcher\windows\publish\folder\LocalSearchLauncher.exe` を優先して子プロセスとして起動します。なければsingle-file版、どちらもなければ従来のPython/Flet版を起動します。この経路に統一することで、Web画面/APIから状態確認・停止・再起動できます。
+`start_windows.bat` はバックエンドを起動し、バックエンドのランチャー管理機能が `launcher\windows\publish\folder\LocalSearchLauncher.exe` を優先して子プロセスとして起動します。なければsingle-file版を起動し、どちらもなければ起動せずに理由をランチャー状態とログへ残します（Python / Flet 版は廃止）。この経路に統一することで、Web画面/APIから状態確認・停止・再起動できます。
 
 EXEを別フォルダへ配置する場合は、`SEARCH_APP_WPF_LAUNCHER_PATH` に絶対パスを指定します。この指定は標準の発行先より優先されます。
 
diff --git a/launcher/windows/publish.ps1 b/launcher/windows/publish.ps1
index 0c3c5214c1e0ef8a58fb4f8e5370e3cced62ae77..7a999a7939759e7566d1ecaa7c5184e551a37c7f 100644
--- a/launcher/windows/publish.ps1
+++ b/launcher/windows/publish.ps1
@@ -1,4 +1,14 @@
-param([ValidateSet("all", "folder", "single-file")][string]$Mode = "all")
+﻿# WPF ランチャーを launcher/windows/publish/ へ発行する（配布先に .NET SDK が無いため、発行物をコミットする）。
+#
+# 【仕様】
+# - 実行中のランチャーがあると発行物を置き換えられないため、既定では止めずにエラーで終える。
+#   -StopRunningLauncher を付けたときだけ実行中のランチャーを終了してから発行する
+#   （未保存の常時保持メモは最大 0.6 秒分失われることがある）。
+# - 削除・発行・置き換えのどれかに失敗したら、古い発行物を残したまま成功扱いにせずエラーで終える。
+param(
+  [ValidateSet("all", "folder", "single-file")][string]$Mode = "all",
+  [switch]$StopRunningLauncher
+)
 $ErrorActionPreference = "Stop"
 $project = Join-Path $PSScriptRoot "LocalSearchLauncher\LocalSearchLauncher.csproj"
 $output = Join-Path $PSScriptRoot "publish"
@@ -7,6 +17,16 @@ $dotnet = if ($dotnetCommand) { $dotnetCommand.Source } else { Join-Path $env:LO
 if (-not (Test-Path $dotnet)) {
   throw ".NET 8 SDK が見つかりません。launcher/windows/README.md の手順でSDKを導入してください。"
 }
+
+$running = @(Get-Process LocalSearchLauncher -ErrorAction SilentlyContinue)
+if ($running.Count -gt 0) {
+  if (-not $StopRunningLauncher) {
+    throw "LocalSearchLauncher が実行中です。終了してから実行するか、-StopRunningLauncher を付けて実行してください。"
+  }
+  $running | Stop-Process -Force
+  $running | Wait-Process -Timeout 10
+}
+
 function Reset-PublishDirectory([string]$Path) {
   $root = [IO.Path]::GetFullPath($output).TrimEnd([IO.Path]::DirectorySeparatorChar)
   $target = [IO.Path]::GetFullPath($Path)
@@ -16,13 +36,24 @@ function Reset-PublishDirectory([string]$Path) {
   if (Test-Path $target) { Remove-Item -LiteralPath $target -Recurse -Force }
   New-Item -ItemType Directory -Path $target -Force | Out-Null
 }
+
+function Invoke-Publish([string[]]$Arguments) {
+  & $dotnet publish $project -c Release -r win-x64 --self-contained true -p:DebugType=None -p:DebugSymbols=false @Arguments
+  if ($LASTEXITCODE -ne 0) { throw "dotnet publish が失敗しました（終了コード $LASTEXITCODE）" }
+}
+
 if ($Mode -in @("all", "folder")) {
   $folderOutput = Join-Path $output "folder"
   Reset-PublishDirectory $folderOutput
-  & $dotnet publish $project -c Release -r win-x64 --self-contained true -p:PublishSingleFile=false -p:DebugType=None -p:DebugSymbols=false -o $folderOutput
+  Invoke-Publish @("-p:PublishSingleFile=false", "-o", $folderOutput)
 }
 if ($Mode -in @("all", "single-file")) {
   $singleFileOutput = Join-Path $output "single-file"
-  Reset-PublishDirectory $singleFileOutput
-  & $dotnet publish $project -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:DebugType=None -p:DebugSymbols=false -o $singleFileOutput
+  $stagingOutput = Join-Path $output "single-file-staging"
+  Reset-PublishDirectory $stagingOutput
+  Invoke-Publish @("-p:PublishSingleFile=true", "-p:IncludeNativeLibrariesForSelfExtract=true", "-o", $stagingOutput)
+  New-Item -ItemType Directory -Path $singleFileOutput -Force | Out-Null
+  # Windows PowerShell 5.1（.NET Framework）には上書き指定付きの File.Move が無いため Move-Item -Force を使う
+  Move-Item -LiteralPath (Join-Path $stagingOutput "LocalSearchLauncher.exe") -Destination (Join-Path $singleFileOutput "LocalSearchLauncher.exe") -Force
+  Remove-Item -LiteralPath $stagingOutput -Recurse -Force
 }
