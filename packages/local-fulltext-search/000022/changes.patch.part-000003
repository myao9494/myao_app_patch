diff --git a/launcher/windows/publish/single-file/LocalSearchLauncher.exe b/launcher/windows/publish/single-file/LocalSearchLauncher.exe
index fff6db51bcc6547fd6e9b79cbbf353814c9099aa..bfbd6735147099a7986a01577e6885e738866b9b 100644
--- a/launcher/windows/publish/single-file/LocalSearchLauncher.exe
+++ b/launcher/windows/publish/single-file/LocalSearchLauncher.exe
@@ -1,3 +1,3 @@
 version https://git-lfs.github.com/spec/v1
-oid sha256:a2099e57911a581bcafd1e41c0d2df2d6d9c85b201caec1555c6635dc805cbf2
-size 161672759
+oid sha256:e095301cf2e99c957737cec954c94152b1fdc2b0620766b926c49f5d5a28e414
+size 161787447
diff --git a/spec/product_spec.md b/spec/product_spec.md
index 2d864618f38cc3ed3e02e52dfa77ecd3008a80a0..c03422f178438e9c5e682e56a3c5fa17278966c8 100644
--- a/spec/product_spec.md
+++ b/spec/product_spec.md
@@ -91,4 +91,4 @@ Vite 開発サーバを使う場合は `5173` 番ポートを使い、`allowedHo
 非表示にしたインデックス済みフォルダ、Web除外キーワード、Obsidian sidebar-explorer のパス設定も `data/` 配下のテキストファイルへ保存する。検索対象フォルダ自体は SQLite の `targets` テーブルへ保存する。
 端末依存でよい既定検索フォルダだけはフロントエンドの `localStorage` に保持する。
 
-現行コードでは、デスクトップランチャーを `launcher/` 配下で管理する。macOS は PyObjC / Cocoa `NSPanel`、その他 OS は Flet を使い、バックエンドから子プロセスとして起動・停止・ログ確認できる。システムトレイ常駐は未実装。
+現行コードでは、デスクトップランチャーを `launcher/` 配下で管理する。macOS は PyObjC / Cocoa `NSPanel`、Windows は WPF を使い、バックエンドから子プロセスとして起動・停止・ログ確認できる。システムトレイ常駐は未実装。
diff --git a/start_dev.sh b/start_dev.sh
index ce8f0ed7e8d7764bd28caa938a1c217ac63e4a97..e6225c16284e34551fc2c5ecc07d55d31bd25035 100755
--- a/start_dev.sh
+++ b/start_dev.sh
@@ -58,7 +58,7 @@ ensure_backend_env() {
     "${BACKEND_DIR}/.venv/bin/pip" install -r "${BACKEND_DIR}/requirements.txt"
   fi
 
-  if ! "${BACKEND_DIR}/.venv/bin/python" -c "import flet, pynput" >/dev/null 2>&1; then
+  if [[ "$(uname -s)" == "Darwin" ]] && ! "${BACKEND_DIR}/.venv/bin/python" -c "import AppKit" >/dev/null 2>&1; then
     "${BACKEND_DIR}/.venv/bin/pip" install -r "${ROOT_DIR}/launcher/requirements.txt"
   fi
 }
diff --git a/start_windows.bat b/start_windows.bat
index 3527e4385e6cbd6911020306aa441f7d656fe50d..f2f0a0f55dbd9c610e54f6b9aedf9d996409e849 100644
--- a/start_windows.bat
+++ b/start_windows.bat
@@ -9,7 +9,6 @@ set "BACKEND_DIR=%APP_ROOT%backend"
 set "SEARCH_APP_HOST=127.0.0.1"
 if "%SEARCH_APP_PORT%"=="" set "SEARCH_APP_PORT=8079"
 set "SEARCH_APP_LAUNCHER_AUTOSTART=1"
-set "LAUNCHER_REQUIRE_OFFLINE_FLET_VIEW=1"
 
 echo [Local Fulltext Search] Checking port %SEARCH_APP_PORT%...
 powershell -NoProfile -ExecutionPolicy Bypass -Command "try { $listeners = @(Get-NetTCPConnection -LocalPort ([int]$env:SEARCH_APP_PORT) -State Listen -ErrorAction SilentlyContinue); $processIds = @($listeners | Select-Object -ExpandProperty OwningProcess -Unique); foreach ($processId in $processIds) { if ($processId -and $processId -ne $PID) { $proc = Get-Process -Id $processId -ErrorAction SilentlyContinue; if ($proc) { Write-Host ('[Local Fulltext Search] Stop PID {0}: {1}' -f $processId, $proc.ProcessName); Stop-Process -Id $processId -Force -ErrorAction Stop } } }; $launchers = @(Get-Process -Name 'LocalSearchLauncher' -ErrorAction SilentlyContinue); foreach ($launcher in $launchers) { Write-Host ('[Local Fulltext Search] Stop old WPF launcher PID {0}' -f $launcher.Id); Stop-Process -Id $launcher.Id -Force -ErrorAction Stop }; exit 0 } catch { Write-Error ('[Local Fulltext Search] Process cleanup failed: ' + $_.Exception.Message); exit 1 }"
