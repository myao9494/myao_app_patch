+class SlashCommandItem(BaseModel):
+    """
+    ランチャーの OpenCode ペインで使う独自スラッシュコマンド 1 件（/pass など）。
+    name は先頭の / を外して保存する。空白・/ を含む名前、空のプロンプトは受け付けない。
+    """
+
+    name: str
+    prompt: str
+    description: str = ""
+
+    @field_validator("name")
+    @classmethod
+    def _validate_name(cls, value: str) -> str:
+        cleaned = str(value or "").strip().lstrip("/")
+        if not cleaned or any(char.isspace() or char == "/" for char in cleaned):
+            raise ValueError("コマンド名に空白や / は使えません")
+        return cleaned
+
+    @field_validator("prompt")
+    @classmethod
+    def _validate_prompt(cls, value: str) -> str:
+        cleaned = str(value or "").strip()
+        if not cleaned:
+            raise ValueError("プロンプトを入力してください")
+        return cleaned
+
+    @field_validator("description")
+    @classmethod
+    def _strip_description(cls, value: str) -> str:
+        return str(value or "").strip()
+
+
