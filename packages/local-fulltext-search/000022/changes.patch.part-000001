@@ -280,6 +280,47 @@ def test_get_app_settings_reads_shared_web_settings() -> None:
     assert captured["method"] == "GET"
 
 
+def test_save_launcher_memo_puts_to_memo_endpoint() -> None:
+    """
+    ランチャーの常時保持メモは、共有設定の一括保存ではなくメモ専用の API へ PUT して永続化する。
+    """
+    captured: dict[str, object] = {}
+
+    def fake_urlopen(request: Request, timeout: float) -> StubResponse:
+        captured["url"] = request.full_url
+        captured["method"] = request.get_method()
+        captured["body"] = json.loads((request.data or b"{}").decode("utf-8"))
+        return StubResponse({"launcher_memo": "消えないメモ\n2行目"})
+
+    client = LauncherApiClient(base_url="http://127.0.0.1:8079", urlopen=fake_urlopen)
+
+    result = client.save_launcher_memo("消えないメモ\n2行目")
+    assert result == {"launcher_memo": "消えないメモ\n2行目"}
+    assert captured["url"] == "http://127.0.0.1:8079/api/index/settings/launcher-memo"
+    assert captured["method"] == "PUT"
+    assert captured["body"] == {"launcher_memo": "消えないメモ\n2行目"}
+
+
+def test_save_opencode_working_dir_puts_only_that_setting() -> None:
+    """
+    opencode 実行フォルダは共有設定の PUT へ、そのキーだけを送って保存する（他の設定は送らず、バックエンド側で据え置かれる）。
+    """
+    captured: dict[str, object] = {}
+
+    def fake_urlopen(request: Request, timeout: float) -> StubResponse:
+        captured["url"] = request.full_url
+        captured["method"] = request.get_method()
+        captured["body"] = json.loads((request.data or b"{}").decode("utf-8"))
+        return StubResponse({"opencode_working_dir": "/work/project", "gantt_parent": 3})
+
+    client = LauncherApiClient(base_url="http://127.0.0.1:8079", urlopen=fake_urlopen)
+
+    assert client.save_opencode_working_dir("/work/project") == "/work/project"
+    assert captured["url"] == "http://127.0.0.1:8079/api/index/settings"
+    assert captured["method"] == "PUT"
+    assert captured["body"] == {"opencode_working_dir": "/work/project"}
+
+
 def test_api_error_extracts_detail() -> None:
     """
     API エラーは HTTP ステータスと FastAPI の detail をユーザー向けメッセージとして保持する。
@@ -419,3 +460,30 @@ def test_search_sends_include_path_in_filename_enabled_by_default(monkeypatch, s
 
     client.search("人事 top", include_path_in_filename=False)
     assert sent["body"]["include_path_in_filename"] is False
+
+
+def test_slash_commands_are_read_and_saved_through_dedicated_endpoint() -> None:
+    """
+    スラッシュコマンドは /api/index/settings/launcher-slash-commands で読み（GET）、一覧ごと保存する（PUT）。
+    """
+    from launcher_app.slash_commands import SlashCommand
+
+    captured: list[dict[str, object]] = []
+
+    def fake_urlopen(request: Request, timeout: float) -> StubResponse:
+        body = json.loads((request.data or b"{}").decode("utf-8")) if request.data else None
+        captured.append({"url": request.full_url, "method": request.get_method(), "body": body})
+        if request.get_method() == "GET":
+            return StubResponse({"commands": [{"name": "pass", "prompt": "p", "description": "d"}]})
+        return StubResponse(body or {})
+
+    client = LauncherApiClient(base_url="http://127.0.0.1:8079", urlopen=fake_urlopen)
+
+    assert client.get_slash_commands() == [SlashCommand("pass", "p", "d")]
+    saved = client.save_slash_commands([SlashCommand("daily", "まとめて")])
+
+    assert saved == [SlashCommand("daily", "まとめて")]
+    assert captured[0]["url"] == "http://127.0.0.1:8079/api/index/settings/launcher-slash-commands"
+    assert captured[0]["method"] == "GET"
+    assert captured[1]["method"] == "PUT"
+    assert captured[1]["body"] == {"commands": [{"name": "daily", "prompt": "まとめて", "description": ""}]}
