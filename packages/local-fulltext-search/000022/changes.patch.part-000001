diff --git a/launcher/tests/test_mac_layout.py b/launcher/tests/test_mac_layout.py
new file mode 100644
index 0000000000000000000000000000000000000000..f6698e1aa13913e2f451f0dc6922c6cda9d807f9
--- /dev/null
+++ b/launcher/tests/test_mac_layout.py
@@ -0,0 +1,92 @@
+"""
+macOS ネイティブ版の 2×2 ペイン配置が、パネルからはみ出さず部品どうしが重ならないことを検証する。
+AppKit を使わない配置計算なので、macOS 以外でも実行できる。
+"""
+
+from itertools import combinations
+
+from launcher_app.ui.mac_layout import (
+    PANE_CONTROLS,
+    RESULT_CARD_HEIGHT,
+    Rect,
+    four_pane_layout,
+    result_card_layout,
+)
+
+
+def test_panes_form_two_by_two_grid_inside_panel() -> None:
+    """検索=左上、OpenCode=右上、常時保持メモ=左下、gantt=右下に、パネル内へ重ならず並ぶ。"""
+    layout = four_pane_layout(1170, 780)
+    panel = Rect(0, 0, 1170, 780)
+    search, opencode, scratchpad, gantt = (
+        layout["search_pane"], layout["opencode_pane"], layout["scratchpad_pane"], layout["gantt_pane"],
+    )
+
+    for pane in (search, opencode, scratchpad, gantt):
+        assert panel.contains(pane)
+    # Cocoa は左下原点なので、上段ほど y が大きい
+    assert search.x < opencode.x and search.y == opencode.y
+    assert scratchpad.x < gantt.x and scratchpad.y == gantt.y
+    assert search.y > scratchpad.y
+    for first, second in combinations((search, opencode, scratchpad, gantt), 2):
+        assert not first.intersects(second)
+    assert not layout["status_label"].intersects(scratchpad)
+    assert not layout["status_label"].intersects(gantt)
+
+
+def test_controls_stay_inside_their_pane_without_overlapping() -> None:
+    """各ペインの入力欄・ボタンは自分のペインの中に収まり、互いに重ならない。"""
+    layout = four_pane_layout(1170, 780)
+
+    for pane_name, control_names in PANE_CONTROLS.items():
+        pane = layout[pane_name]
+        for name in control_names:
+            assert pane.contains(layout[name]), f"{name} が {pane_name} からはみ出している"
+        for first, second in combinations(control_names, 2):
+            assert not layout[first].intersects(layout[second]), f"{first} と {second} が重なっている"
+
+
+def test_result_card_fits_search_pane_with_buttons_on_own_row() -> None:
+    """検索結果カードは検索ペインの幅に収まり、操作ボタンは文字と重ならない別の行に置く。"""
+    layout = four_pane_layout(1170, 780)
+    card_width = layout["results_scroll"].width - 18
+    card = result_card_layout(card_width)
+    card_rect = Rect(0, 0, card_width, RESULT_CARD_HEIGHT)
+
+    texts = ("icon", "title", "path", "snippet")
+    buttons = ("copy_button", "reveal_button", "folder_button")
+    for name in (*texts, *buttons, "gantt_link_button", "open_area"):
+        assert card_rect.contains(card[name]), f"{name} がカードからはみ出している"
+    for text in texts:
+        for button in (*buttons, "gantt_link_button"):
+            assert not card[text].intersects(card[button])
+    for first, second in combinations(buttons, 2):
+        assert not card[first].intersects(card[second])
+    # 透明なクリック領域はボタンを覆わない
+    for button in (*buttons, "gantt_link_button"):
+        assert not card["open_area"].intersects(card[button])
+
+
+def test_opencode_pane_has_chat_toolbar_controls() -> None:
+    """OpenCode ペインは Claudian 風に、スラッシュコマンド登録・会話履歴・新規会話・モデル・Plan・自動承認・作業状況・使用量を持つ。"""
+    expected = {
+        "opencode_menu_button",
+        "opencode_commands_button",
+        "opencode_history_popup",
+        "opencode_new_chat_button",
+        "opencode_model_popup",
+        "opencode_plan_checkbox",
+        "opencode_auto_checkbox",
+        "opencode_output_scroll",
+        "opencode_activity_label",
+        "opencode_prompt_scroll",
+        "opencode_usage_label",
+        "opencode_submit_button",
+    }
+    assert expected <= set(PANE_CONTROLS["opencode_pane"])
+    layout = four_pane_layout(1170, 780)
+    # 会話の表示欄がペインの大半を使い、指示欄はその下、送信ボタンは最下段
+    assert layout["opencode_output_scroll"].height >= 200
+    assert layout["opencode_prompt_scroll"].top <= layout["opencode_activity_label"].y
+    assert layout["opencode_activity_label"].top <= layout["opencode_output_scroll"].y
+    assert layout["opencode_submit_button"].top <= layout["opencode_prompt_scroll"].y
diff --git a/launcher/tests/test_mac_slash_editor_window.py b/launcher/tests/test_mac_slash_editor_window.py
new file mode 100644
index 0000000000000000000000000000000000000000..a35c68b05773846c00ecd4118ee2c8237f3e98c0
--- /dev/null
+++ b/launcher/tests/test_mac_slash_editor_window.py
@@ -0,0 +1,41 @@
+"""
+macOS ランチャーの「コマンド」登録画面が、ランチャー本体の前に出ることを検証する。
+（ランチャー本体は NSStatusWindowLevel で常に手前に出るため、登録画面はそれより上でないと後ろに隠れる）
+"""
+
+import pytest
+
+pytest.importorskip("AppKit")
+
+import AppKit
+
+from launcher_app.slash_commands import SlashCommand
+from launcher_app.ui.mac_slash_editor import SlashCommandEditor
+
+
+def _editor() -> SlashCommandEditor:
+    editor = SlashCommandEditor.alloc().init()
+    editor.setup([SlashCommand("pass", "p", "d")], lambda commands: commands, lambda commands: None)
+    return editor
+
+
+def test_editor_window_level_is_above_launcher_panel() -> None:
+    """登録画面のウィンドウレベルは、ランチャー本体（NSStatusWindowLevel）より上。"""
+    assert _editor().panel.level() > AppKit.NSStatusWindowLevel
+
+
+def test_editor_follows_launcher_across_spaces() -> None:
+    """ランチャー本体と同じく、全デスクトップ・フルスクリーン上でも表示でき、他アプリが前面でも隠れない。"""
+    editor = _editor()
+    behavior = editor.panel.collectionBehavior()
+
+    assert behavior & AppKit.NSWindowCollectionBehaviorCanJoinAllSpaces
+    assert behavior & AppKit.NSWindowCollectionBehaviorFullScreenAuxiliary
+    assert editor.panel.hidesOnDeactivate() is False
+
+
+def test_delete_confirmation_alert_level_is_above_editor() -> None:
+    """削除の確認ダイアログは登録画面より上のレベルで出す（でないと登録画面の後ろに隠れて操作できない）。"""
+    from launcher_app.ui import mac_slash_editor
+
+    assert mac_slash_editor.ALERT_WINDOW_LEVEL > _editor().panel.level()
diff --git a/launcher/tests/test_markdown_lite.py b/launcher/tests/test_markdown_lite.py
new file mode 100644
index 0000000000000000000000000000000000000000..c19ddc88c2f4482331e8d9c7b0c42656f873373f
--- /dev/null
+++ b/launcher/tests/test_markdown_lite.py
@@ -0,0 +1,61 @@
+"""
+OpenCode の応答（Markdown）を、ランチャーの小さなペインで表示するための簡易 Markdown 解析を検証する。
+見出し・箇条書き・番号付き・引用・コードブロック・行内コード・太字だけを扱う。
+"""
+
+from launcher_app.markdown_lite import MdBlock, MdInline, parse_inlines, parse_markdown
+
+
+def test_paragraphs_are_split_by_blank_lines_and_keep_line_breaks() -> None:
+    """空行で段落を分け、段落内の改行はそのまま残す。"""
+    blocks = parse_markdown("一行目\n二行目\n\n次の段落")
+
+    assert blocks == [
+        MdBlock("paragraph", (MdInline("一行目\n二行目"),)),
+        MdBlock("paragraph", (MdInline("次の段落"),)),
+    ]
+
+
+def test_headings_lists_and_quotes() -> None:
+    """# 見出し、- 箇条書き（字下げで階層）、1. 番号付き、> 引用を見分ける。"""
+    blocks = parse_markdown("## 手順\n- 準備\n  - 下準備\n2. 実行\n> 注意")
+
+    assert [(block.kind, block.level, block.inlines[0].text) for block in blocks] == [
+        ("heading", 2, "手順"),
+        ("bullet", 0, "準備"),
+        ("bullet", 1, "下準備"),
+        ("numbered", 2, "実行"),
+        ("quote", 0, "注意"),
+    ]
+
+
+def test_fenced_code_block_keeps_raw_text_and_language() -> None:
+    """``` で囲んだ部分は Markdown として解釈せず、言語名と一緒にそのまま残す。"""
+    blocks = parse_markdown("実行します\n```bash\nnpm test # **太字ではない**\n```\n終わり")
+
+    assert blocks[1] == MdBlock("code", (), text="npm test # **太字ではない**", language="bash")
+    assert [block.kind for block in blocks] == ["paragraph", "code", "paragraph"]
+
+
+def test_unclosed_code_fence_runs_to_end() -> None:
+    """閉じていないコードブロック（ストリーミング途中など）は最後までコードとして扱う。"""
+    blocks = parse_markdown("```python\nprint(1)\nprint(2)")
+
+    assert blocks == [MdBlock("code", (), text="print(1)\nprint(2)", language="python")]
+
+
+def test_inline_code_and_bold() -> None:
+    """`行内コード` と **太字** を分け、閉じていない記号は文字のまま残す。"""
+    assert parse_inlines("`npm test` を **必ず** 実行") == [
+        MdInline("npm test", "code"),
+        MdInline(" を ", "plain"),
+        MdInline("必ず", "bold"),
+        MdInline(" 実行", "plain"),
+    ]
+    assert parse_inlines("2 ** 3 と `未完") == [MdInline("2 ** 3 と `未完", "plain")]
+
+
+def test_empty_text_has_no_blocks() -> None:
+    """空の応答はブロックなし。"""
+    assert parse_markdown("") == []
+    assert parse_markdown("\n\n") == []
