+			"versionNonce": 503,
+			"seed": 503,
+			"strokeWidth": 1,
+			"x": 50,
+			"y": 15.0,
+			"width": 860,
+			"height": 20,
+			"strokeColor": "#1e1e1e",
+			"backgroundColor": "transparent",
+			"roundness": null,
+			"boundElements": [],
+			"fontSize": 14,
+			"fontFamily": 1,
+			"text": "スラッシュコマンド（このアプリ独自の定型作業）の流れ",
+			"rawText": "スラッシュコマンド（このアプリ独自の定型作業）の流れ",
+			"originalText": "スラッシュコマンド（このアプリ独自の定型作業）の流れ",
+			"textAlign": "center",
+			"verticalAlign": "middle",
+			"containerId": "box-title",
+			"lineHeight": 1.25,
+			"baseline": 12
+		},
+		{
+			"version": 1,
+			"isDeleted": false,
+			"fillStyle": "solid",
+			"strokeStyle": "solid",
+			"roughness": 0,
+			"opacity": 100,
+			"angle": 0,
+			"groupIds": [],
+			"frameId": null,
+			"updated": 1,
