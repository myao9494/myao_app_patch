--- a/launcher/src/launcher_app/offline_flet.py
+++ /dev/null
@@ -1,147 +0,0 @@
-"""
-Flet デスクトップクライアントをオフライン環境で利用するための準備を行う。
-"""
-
-from __future__ import annotations
-
-import os
-from pathlib import Path
-import platform
-import tarfile
-import zipfile
-
-
-PROJECT_ROOT = Path(__file__).resolve().parents[3]
-VENDOR_ROOT = PROJECT_ROOT / "launcher" / "vendor" / "flet-view"
-CACHE_ROOT = PROJECT_ROOT / "launcher" / ".offline_cache" / "flet-view"
-
-
-class OfflineFletViewError(RuntimeError):
-    """
-    オフライン必須モードで Flet View が見つからない場合の起動エラー。
-    """
-
-
-def prepare_flet_view() -> Path | None:
-    """
-    同梱済みの Flet View を検出し、必要なら展開して FLET_VIEW_PATH を設定する。
-    """
-    if platform.system() == "Darwin":
-        return None
-    existing_path = os.environ.get("FLET_VIEW_PATH")
-    if existing_path:
-        return Path(existing_path)
-
-    platform_name = _platform_name()
-    unpacked_dir = VENDOR_ROOT / platform_name
-    if _looks_like_flet_view_dir(unpacked_dir):
-        os.environ["FLET_VIEW_PATH"] = str(unpacked_dir)
-        return unpacked_dir
-
-    archive_path = _find_archive(platform_name)
-    if archive_path is not None:
-        extracted_dir = CACHE_ROOT / platform_name
-        cached_view_dir = _find_flet_view_dir(extracted_dir)
-        if cached_view_dir is not None:
-            os.environ["FLET_VIEW_PATH"] = str(cached_view_dir)
-            return cached_view_dir
-        _extract_archive(archive_path, extracted_dir)
-        view_dir = _find_flet_view_dir(extracted_dir) or extracted_dir
-        os.environ["FLET_VIEW_PATH"] = str(view_dir)
-        return view_dir
-
-    if _offline_required():
-        raise OfflineFletViewError(_missing_message(platform_name))
-    return None
-
-
-def _platform_name() -> str:
-    """
-    Flet View 配布物の OS 名をディレクトリ名へ正規化する。
-    """
-    system_name = platform.system()
-    if system_name == "Windows":
-        return "windows"
-    if system_name == "Linux":
-        return "linux"
-    return system_name.lower()
-
-
-def _looks_like_flet_view_dir(path: Path) -> bool:
-    """
-    FLET_VIEW_PATH として使えるディレクトリかを簡易判定する。
-    """
-    if not path.is_dir():
-        return False
-    executable_names = {"flet.exe", "flet", "flet_view.exe", "flet_view"}
-    return any((path / name).is_file() for name in executable_names)
-
-
-def _find_archive(platform_name: str) -> Path | None:
-    """
-    vendor 配下から対象 OS の Flet View アーカイブを探す。
-    """
-    if not VENDOR_ROOT.is_dir():
-        return None
-    patterns = (
-        f"flet-view-{platform_name}*.zip",
-        f"flet-view-{platform_name}*.tar.gz",
-        f"flet-view-{platform_name}*.tgz",
-    )
-    for pattern in patterns:
-        matches = sorted(VENDOR_ROOT.glob(pattern))
-        if matches:
-            return matches[0]
-    return None
-
-
-def _extract_archive(archive_path: Path, destination: Path) -> None:
-    """
-    zip/tar.gz の Flet View アーカイブをリポジトリ内キャッシュへ展開する。
-    """
-    destination.mkdir(parents=True, exist_ok=True)
-    if archive_path.suffix == ".zip":
-        with zipfile.ZipFile(archive_path) as archive:
-            for member in archive.infolist():
-                target = (destination / member.filename).resolve()
-                if not target.is_relative_to(destination.resolve()):
-                    raise OfflineFletViewError(f"不正なパスを含む zip です: {member.filename}")
-            archive.extractall(destination)
-        return
-    if archive_path.name.endswith((".tar.gz", ".tgz")):
-        with tarfile.open(archive_path) as archive:
-            archive.extractall(destination, filter="data")
-        return
-    raise OfflineFletViewError(f"未対応の Flet View アーカイブ形式です: {archive_path}")
-
-
-def _find_flet_view_dir(root: Path) -> Path | None:
-    """
-    展開後ディレクトリから Flet View 実行ファイルを含む階層を探す。
-    """
-    if _looks_like_flet_view_dir(root):
-        return root
-    for path in root.rglob("*"):
-        if path.is_dir() and _looks_like_flet_view_dir(path):
-            return path
-    return None
-
-
-def _offline_required() -> bool:
-    """
-    オフライン配布時に Flet View 同梱を必須にするかを返す。
-    """
-    return os.environ.get("LAUNCHER_REQUIRE_OFFLINE_FLET_VIEW", "").strip().lower() in {"1", "true", "yes", "on"}
-
-
-def _missing_message(platform_name: str) -> str:
-    """
-    Flet View 未配置時に表示する復旧手順を返す。
-    """
-    return (
-        "オフライン起動に必要な Flet View が見つかりません。\n"
-        f"配置先: {VENDOR_ROOT}\\{platform_name}\\ または "
-        f"{VENDOR_ROOT}\\flet-view-{platform_name}.zip\n"
-        "オンライン環境で Flet が取得する Flet View アーカイブを保存し、"
-        "リポジトリの launcher/vendor/flet-view/ に配置してから再起動してください。"
-    )
diff --git a/launcher/src/launcher_app/opencode_chat.py b/launcher/src/launcher_app/opencode_chat.py
new file mode 100644
index 0000000000000000000000000000000000000000..5051648b7187788db759f68a55ef8d3f260e3994
--- /dev/null
+++ b/launcher/src/launcher_app/opencode_chat.py
@@ -0,0 +1,480 @@
+"""
+OpenCode ペインのチャット表示モデル（Obsidian の Claudian プラグイン風）と、表示用の書式・解析をまとめる。
+AppKit に依存しないので、macOS 以外でもテストできる。WPF 版（OpenCodeChat.cs）と同じ約束で動く。
+
+【仕様】
+- 会話は「表示項目（ChatEntry）」の並び。種類は次の 5 つ。
+  - user: 自分の指示（吹き出し）
+  - text: opencode の応答本文（Markdown）
+  - reasoning: 思考。既定で折りたたみ、見出しに「思考（n秒）」を出す
+  - tool: ツール実行カード。見出しは「状態アイコン ツール名 要約」（✓ 完了 / ⏳ 実行中 / ✗ 失敗）。
+    既定で折りたたみ、開くと入力と出力を表示する
+  - notice: 中断・タイムアウト・失敗などのお知らせ（status は info / error）
+- `opencode run --format json` の NDJSON イベントを apply_event / apply_line で取り込む。
+  - text / reasoning / tool_use（tool_call）は part ID ごとに 1 項目。同じ ID が再び届いたら更新する
+    （ツールの呼び出し ID は応答ごとに重なるため、partID を優先する）
+  - step_finish は最後のトークン数をコンテキスト使用量とし、費用（cost）は合計する
+  - error はエラーのお知らせ。step_start など他の制御イベントは表示しない
+  - JSON でない行は ANSI を除いて本文（text）として残す
+- `opencode session export` の JSON から過去の会話を復元できる（from_export）。
+- 項目の更新は revision を上げる（画面は revision の変わった項目だけ描き直す）。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import itertools
+import json
+import re
+import threading
+from typing import Any
+
+_ANSI_ESCAPE_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")
+_MODEL_LINE_RE = re.compile(r"^[A-Za-z0-9._-]+/\S+$")
+SUMMARY_LIMIT = 80
+DETAIL_LIMIT = 4000
+_STATUS_ICONS = {"completed": "✓", "running": "⏳", "pending": "⏳", "error": "✗"}
+
+
+@dataclass
+class ChatEntry:
+    """会話の表示項目 1 つ。"""
+
+    id: str
+    kind: str
+    text: str = ""
+    tool: str = ""
+    status: str = ""
+    summary: str = ""
+    detail_input: str = ""
+    detail_output: str = ""
+    duration_seconds: float | None = None
+    expanded: bool = False
+    revision: int = 0
+
+
+@dataclass(frozen=True)
+class SessionSummary:
+    """会話一覧の 1 件（`opencode session list --format json`）。"""
+
+    id: str
+    title: str
+    updated_ms: int
+
+
+def _strip_ansi(text: str) -> str:
+    """ANSI エスケープを除き、改行を LF に揃える。"""
+    normalized = str(text or "").replace("\r\n", "\n").replace("\r", "\n")
+    return _ANSI_ESCAPE_RE.sub("", normalized)
+
+
+def _truncate(text: str, limit: int) -> str:
+    """limit 文字を超えたら末尾を「…」にして limit 文字に収める。"""
+    return text if len(text) <= limit else text[: limit - 1] + "…"
+
+
+def _duration(time_info: Any, start_key: str, end_key: str) -> float | None:
+    """{start, end}（ミリ秒）からかかった秒数を返す。取れなければ None。"""
+    if not isinstance(time_info, dict):
+        return None
+    start, end = time_info.get(start_key), time_info.get(end_key)
+    if isinstance(start, (int, float)) and isinstance(end, (int, float)) and end >= start:
+        return round((end - start) / 1000.0, 3)
+    return None
+
+
+def _context_tokens(tokens: Any) -> int | None:
+    """step_finish の tokens から、コンテキストに載っているトークン数（入力+出力+思考+キャッシュ）を返す。"""
+    if not isinstance(tokens, dict):
+        return None
+    cache = tokens.get("cache") if isinstance(tokens.get("cache"), dict) else {}
+    values = [tokens.get("input"), tokens.get("output"), tokens.get("reasoning"), cache.get("read"), cache.get("write")]
+    return int(sum(value for value in values if isinstance(value, (int, float))))
+
+
+def summarize_tool(tool: str, tool_input: Any, title: str = "") -> str:
+    """ツールカードの見出しに出す要約（パス・コマンド・検索語など）を返す。80 文字で切る。"""
+    data = tool_input if isinstance(tool_input, dict) else {}
+    name = str(tool or "").lower()
+
+    def text(key: str) -> str:
+        value = data.get(key)
+        return str(value).strip() if isinstance(value, (str, int, float)) else ""
+
+    summary = ""
+    if name in {"read", "write", "edit", "patch", "list", "multiedit"}:
+        summary = text("filePath") or text("path")
+    elif name == "bash":
+        summary = text("command").split("\n", 1)[0]
+    elif name in {"grep", "glob"}:
+        summary = text("pattern")
+        if summary and text("path"):
+            summary = f"{summary} in {text('path')}"
+    elif name == "webfetch":
+        summary = text("url")
+    elif name == "websearch":
+        summary = text("query")
+    elif name == "task":
+        summary = text("description")
+    elif name == "todowrite":
+        todos = data.get("todos") if isinstance(data.get("todos"), list) else []
+        done = sum(1 for todo in todos if isinstance(todo, dict) and todo.get("status") == "completed")
+        summary = f"Tasks {done}/{len(todos)}" if todos else ""
+    if not summary:
+        cleaned_title = str(title or "").strip()
+        if cleaned_title and cleaned_title.lower() != name:
+            summary = cleaned_title
+    if not summary:
+        summary = next((str(value).strip() for value in data.values() if isinstance(value, str) and value.strip()), "")
+    return _truncate(summary.split("\n", 1)[0], SUMMARY_LIMIT)
+
+
+def tool_header(tool: str, status: str, summary: str) -> str:
+    """ツールカードの見出し（状態アイコン・ツール名・要約）。"""
+    icon = _STATUS_ICONS.get(status, "⏳")
+    return f"{icon} {tool}  {summary}" if summary else f"{icon} {tool}"
+
+
+def format_elapsed(seconds: float) -> str:
+    """経過時間の表示（10 秒未満は小数 1 桁、1 分以上は「1分05秒」）。"""
+    value = max(0.0, float(seconds))
+    if value < 10:
+        return f"{value:.1f}秒"
+    if value < 60:
+        return f"{int(round(value))}秒"
+    total = int(round(value))
+    return f"{total // 60}分{total % 60:02d}秒"
+
+
+def format_tokens(count: int) -> str:
+    """トークン数の表示（950 / 10.7k / 1.3M）。"""
+    if count >= 1_000_000:
+        return f"{count / 1_000_000:.1f}M"
+    if count >= 1000:
+        return f"{count / 1000:.1f}k"
+    return str(count)
+
+
+def format_relative_time(updated_ms: int, now_ms: int) -> str:
+    """会話一覧の更新時刻を「たった今 / n分前 / n時間前 / n日前」で表す。"""
+    seconds = max(0, (now_ms - updated_ms) // 1000)
+    if seconds < 60:
+        return "たった今"
+    if seconds < 3600:
+        return f"{seconds // 60}分前"
+    if seconds < 86400:
+        return f"{seconds // 3600}時間前"
+    return f"{seconds // 86400}日前"
+
+
+def _first_json(text: str, opener: str) -> Any:
+    """出力の中から最初の JSON（opener で始まる行以降）を読む。読めなければ None。"""
+    raw = str(text or "")
+    index = raw.find(opener)
+    while index >= 0:
+        try:
+            return json.JSONDecoder().raw_decode(raw[index:])[0]
+        except ValueError:
+            index = raw.find(opener, index + 1)
+    return None
+
+
+def parse_session_list(stdout: str) -> list[SessionSummary]:
+    """`opencode session list --format json` の出力から会話一覧を読む。余計な出力は無視する。"""
+    data = _first_json(stdout, "[")
+    if not isinstance(data, list):
+        return []
+    sessions: list[SessionSummary] = []
+    for item in data:
+        if isinstance(item, dict) and isinstance(item.get("id"), str):
+            updated = item.get("updated")
+            sessions.append(SessionSummary(
+                item["id"],
+                str(item.get("title") or ""),
+                int(updated) if isinstance(updated, (int, float)) else 0,
+            ))
+    return sessions
+
+
+def parse_model_list(stdout: str) -> list[str]:
+    """`opencode models` の出力から「プロバイダー/モデル」の行だけを取り出す。"""
+    return [line.strip() for line in str(stdout or "").splitlines() if _MODEL_LINE_RE.match(line.strip())]
+
+
+class PromptHistory:
+    """
+    送った指示の履歴。↑（previous）で新しい順に呼び出し、↓（next）で戻る。
+    最後まで戻ると呼び出し前の下書きを返し、その次は None（呼び出し中でない）。
+    連続する同じ指示はまとめ、上限を超えたら古いものから捨てる。
+    """
+
+    def __init__(self, limit: int = 50) -> None:
+        self.limit = limit
+        self.items: list[str] = []
+        self._index: int | None = None
+        self._draft = ""
+
+    def add(self, prompt: str) -> None:
+        """送った指示を履歴へ足し、呼び出し位置を最初へ戻す。"""
+        cleaned = str(prompt or "").strip()
+        self._index = None
+        if not cleaned or (self.items and self.items[-1] == cleaned):
+            return
+        self.items.append(cleaned)
+        del self.items[: max(0, len(self.items) - self.limit)]
+
+    def previous(self, current_draft: str) -> str | None:
+        """1 つ前（古い方）の指示。履歴が空なら None。最古で止まる。"""
+        if not self.items:
+            return None
+        if self._index is None:
+            self._draft = current_draft
+            self._index = len(self.items) - 1
+        else:
+            self._index = max(0, self._index - 1)
+        return self.items[self._index]
+
+    def next(self) -> str | None:
+        """1 つ後（新しい方）の指示。最新を過ぎたら下書き、呼び出し中でなければ None。"""
+        if self._index is None:
+            return None
+        if self._index >= len(self.items) - 1:
+            self._index = None
+            return self._draft
+        self._index += 1
+        return self.items[self._index]
+
+
+class ChatTranscript:
+    """
+    OpenCode ペインに表示する会話。opencode の出力を読むスレッドと画面のスレッドの両方から触るため、
+    更新と読み出しはロックで守る。
+    """
+
+    def __init__(self) -> None:
+        self.entries: list[ChatEntry] = []
+        self.context_tokens = 0
+        self.cost = 0.0
+        self.title = ""
+        self._ids = itertools.count(1)
+        self._lock = threading.RLock()
+
+    def _new_id(self, prefix: str) -> str:
+        return f"{prefix}{next(self._ids)}"
+
+    def _find(self, entry_id: str) -> ChatEntry | None:
+        return next((entry for entry in self.entries if entry.id == entry_id), None)
+
+    def _upsert(self, entry_id: str, kind: str, **values: Any) -> ChatEntry:
+        """同じ ID があれば更新（revision を上げる）、なければ末尾へ追加する。"""
+        with self._lock:
+            entry = self._find(entry_id)
+            if entry is None:
+                entry = ChatEntry(entry_id, kind, **values)
+                self.entries.append(entry)
+                return entry
+            for key, value in values.items():
+                setattr(entry, key, value)
+            entry.revision += 1
+            return entry
+
+    def snapshot(self) -> list[ChatEntry]:
+        """今の表示項目の写し（描画中に別スレッドが更新しても崩れない）。"""
+        with self._lock:
+            return [ChatEntry(**vars(entry)) for entry in self.entries]
+
+    @property
+    def is_empty(self) -> bool:
+        return not self.entries
+
+    def clear(self) -> None:
+        """表示と使用量を消す。"""
+        with self._lock:
+            self.entries.clear()
+            self.context_tokens = 0
+            self.cost = 0.0
+            self.title = ""
+
+    def replace_with(self, other: "ChatTranscript") -> None:
+        """表示・使用量・題名を other の内容へ置き換える（過去の会話の読み込み）。"""
+        restored = other.snapshot()
+        with self._lock:
+            self.entries[:] = restored
+            self.context_tokens = other.context_tokens
+            self.cost = other.cost
+            self.title = other.title
+            # 読み込んだ項目（1〜n 番）と ID が重ならないよう、続きの番号から採番する
+            self._ids = itertools.count(len(restored) + 1)
+
+    def add_user(self, text: str) -> ChatEntry:
+        """自分の指示を吹き出しとして足す。"""
+        return self._upsert(self._new_id("user_"), "user", text=str(text or "").strip())
+
+    def add_notice(self, text: str, *, error: bool = False) -> ChatEntry:
+        """お知らせ（中断・失敗など）を足す。"""
+        return self._upsert(self._new_id("notice_"), "notice", text=text, status="error" if error else "info")
+
+    def toggle(self, entry_id: str) -> bool:
+        """思考・ツールの開閉を切り替える。見つからなければ False。"""
+        with self._lock:
+            entry = self._find(entry_id)
+            if entry is None:
+                return False
+            entry.expanded = not entry.expanded
+            entry.revision += 1
+            return True
+
+    def copy_text(self, entry_id: str) -> str:
+        """吹き出し単位のコピー用文字列。"""
+        with self._lock:
+            entry = self._find(entry_id)
+            return entry.text if entry is not None else ""
+
+    def last_assistant_text(self) -> str:
+        """最後の応答本文。"""
+        with self._lock:
+            return next((entry.text for entry in reversed(self.entries) if entry.kind == "text"), "")
+
+    def usage_text(self) -> str:
+        """「コンテキスト 10.1k トークン · $0.0300」。使用量が無ければ空文字。"""
+        if self.context_tokens <= 0:
+            return ""
+        text = f"コンテキスト {format_tokens(self.context_tokens)} トークン"
+        return f"{text} · ${self.cost:.4f}" if self.cost > 0 else text
+
+    def apply_line(self, line: str) -> bool:
+        """NDJSON の 1 行を取り込む。表示が変わったら True。"""
+        raw = str(line or "").strip()
+        if not raw:
+            return False
+        payload: Any = None
+        if raw.startswith("{") and raw.endswith("}"):
+            try:
+                payload = json.loads(raw)
+            except ValueError:
+                payload = None
+        if isinstance(payload, dict):
+            return self.apply_event(payload)
+        cleaned = _strip_ansi(raw).strip()
+        if not cleaned:
+            return False
+        self._upsert(self._new_id("raw_"), "text", text=cleaned)
+        return True
+
+    def apply_event(self, payload: dict[str, Any]) -> bool:
+        """opencode のイベント 1 つを取り込む。表示が変わったら True。"""
+        event_type = str(payload.get("type") or "")
+        part = payload.get("part") if isinstance(payload.get("part"), dict) else {}
+        if event_type == "text":
+            text = str(part.get("text") if "text" in part else payload.get("text") or "")
+            if not text.strip():
+                return False
+            self._upsert(str(part.get("id") or self._new_id("text_")), "text", text=text)
+            return True
+        if event_type == "reasoning":
+            text = str(part.get("text") or "")
+            if not text.strip():
+                return False
+            self._upsert(
+                str(part.get("id") or self._new_id("reasoning_")), "reasoning",
+                text=text.strip(), duration_seconds=_duration(part.get("time"), "start", "end"),
+            )
+            return True
+        if event_type in {"tool_use", "tool_call"}:
+            self._apply_tool(part)
+            return True
+        if event_type == "step_finish":
+            with self._lock:
+                tokens = _context_tokens(part.get("tokens"))
+                if tokens:
+                    self.context_tokens = tokens
+                cost = part.get("cost")
+                if isinstance(cost, (int, float)):
+                    self.cost += float(cost)
+            return True
+        if event_type == "error":
+            self.add_notice(_error_message(payload), error=True)
+            return True
+        return False
+
+    def _apply_tool(self, part: dict[str, Any], *, entry_id: str | None = None) -> None:
+        """ツールの part（run の tool_use / export の tool）をカードへ反映する。"""
+        state = part.get("state") if isinstance(part.get("state"), dict) else {}
+        tool = str(part.get("tool") or part.get("name") or "tool")
+        tool_input = state.get("input")
+        status = str(state.get("status") or "running")
+        output = state.get("output")
+        if output is None and isinstance(state.get("content"), list):
+            output = "\n".join(
+                str(item.get("text") or "") for item in state["content"] if isinstance(item, dict)
+            )
+        if status == "error" and not output:
+            output = state.get("error")
+        self._upsert(
+            entry_id or str(part.get("partID") or part.get("id") or self._new_id("tool_")),
+            "tool",
+            tool=tool,
+            status="running" if status == "pending" else status,
+            summary=summarize_tool(tool, tool_input, str(state.get("title") or part.get("title") or "")),
+            detail_input=_truncate(json.dumps(tool_input, ensure_ascii=False, indent=2), DETAIL_LIMIT) if tool_input else "",
+            detail_output=_truncate(_strip_ansi(str(output or "")).strip(), DETAIL_LIMIT),
+        )
+
+    @classmethod
+    def from_export(cls, data: dict[str, Any]) -> "ChatTranscript":
+        """`opencode session export` の JSON から会話を復元する。"""
+        transcript = cls()
+        info = data.get("info") if isinstance(data.get("info"), dict) else {}
+        transcript.title = str(info.get("title") or "")
+        messages = data.get("messages") if isinstance(data.get("messages"), list) else []
+        for message in messages:
+            if not isinstance(message, dict):
+                continue
+            kind = message.get("type") or message.get("role")
+            if kind == "user":
+                transcript.add_user(str(message.get("text") or ""))
+                continue
+            if kind != "assistant":
+                continue
+            for item in message.get("content") or []:
+                if not isinstance(item, dict):
+                    continue
+                if item.get("type") == "text" and str(item.get("text") or "").strip():
+                    transcript._upsert(transcript._new_id("text_"), "text", text=str(item["text"]))
+                elif item.get("type") == "reasoning" and str(item.get("text") or "").strip():
+                    transcript._upsert(
+                        transcript._new_id("reasoning_"), "reasoning", text=str(item["text"]).strip(),
+                        duration_seconds=_duration(item.get("time"), "created", "completed"),
+                    )
+                elif item.get("type") == "tool":
+                    transcript._apply_tool(item, entry_id=transcript._new_id("tool_"))
+            tokens = _context_tokens(message.get("tokens"))
+            if tokens:
+                transcript.context_tokens = tokens
+            cost = message.get("cost")
+            if isinstance(cost, (int, float)):
+                transcript.cost += float(cost)
+        return transcript
+
+
+def _error_message(payload: dict[str, Any]) -> str:
+    """error イベントから利用者に見せる文言を取り出す。"""
+    error = payload.get("error") if isinstance(payload.get("error"), dict) else {}
+    data = error.get("data") if isinstance(error.get("data"), dict) else {}
+    return str(data.get("message") or error.get("message") or payload.get("message") or error.get("name") or "不明なエラー")
+
+
+__all__ = [
+    "ChatEntry",
+    "ChatTranscript",
+    "PromptHistory",
+    "SessionSummary",
+    "format_elapsed",
+    "format_relative_time",
+    "format_tokens",
+    "parse_model_list",
+    "parse_session_list",
+    "summarize_tool",
+    "tool_header",
+]
+
diff --git a/launcher/src/launcher_app/opencode_runner.py b/launcher/src/launcher_app/opencode_runner.py
new file mode 100644
index 0000000000000000000000000000000000000000..7b3720ef8bd2d85a0f012858d909bafa09815970
--- /dev/null
+++ b/launcher/src/launcher_app/opencode_runner.py
@@ -0,0 +1,552 @@
+"""
+ランチャー内 opencode CLI ペインのコマンド組み立て・会話セッション管理・サブプロセス実行を提供する。
+画面に出す会話は opencode_chat.ChatTranscript（Claudian 風のチャット表示モデル）が持つ。
+
+【仕様】
+- 子プロセスには `cwd` に加えて環境変数 `PWD` も作業フォルダへ合わせて渡す（起動元の `PWD` が残ると opencode が別のフォルダで動く）。
+- 作業フォルダは Web 設定ドロワーの `opencode_working_dir`（バックエンドが既定値を補う）を使う。
+  未設定・存在しないフォルダでは opencode を起動せず `OpenCodeError` を送出する（別の場所で代わりに動かさない）。
+- コマンドは `opencode run --format json --thinking [--model M] [--agent plan] [--auto] [--session <ID> | --continue] -- <指示>`。
+  思考を表示するため常に `--thinking` を付ける。指示は `--` の後ろへ置き、`-` で始まる指示もオプションとして解釈させない。
+  Plan モードのときだけ `--agent plan` を付ける（Build は opencode の既定に任せる）。自動承認は `--auto`。
+- 1 回目の出力（NDJSON）に含まれる `sessionID` を覚え、2 回目以降は `--session <ID>` で同じ会話を続ける。
+  ID が取れなかった成功時だけ `--continue` を使う。「新規会話」（`reset()`）と作業フォルダ変更で新規会話へ戻す。
+- 同時に 2 つの opencode は走らせない。実行中に送った指示は待ち行列（queue）へ入れ、今の実行が終わったら順に送る。
+  `cancel()`（停止）は実行中の処理を止め、待ち行列も捨てる。
+- 結果のお知らせ: 中断「中断しました」、タイムアウト「タイムアウトしたため停止しました」、
+  失敗「opencode 実行失敗（exit n）: 標準エラー」、応答が空「（応答なし）」。
+- 状態表示（status_text）: 実行中は「作業中… 12秒」（待ち行列があれば「 · 待機 n件」）、終わったら「完了（2.0秒）」。
+- 会話一覧は `opencode session list --format json -n 20`、過去の会話の読み込みは `opencode session export <ID>`、
+  モデル一覧は `opencode models`（いずれも作業フォルダで実行）。
+- サブプロセスは標準出力と標準エラーを並行して読み（パイプが詰まって止まらない）、`timeout_seconds` を過ぎたら止める。
+- Windows では cmd.exe を経由する `opencode.cmd` を使わず、ネイティブの `opencode.exe` だけを起動する
+  （cmd.exe は `&` や `|` を含む指示を別コマンドとして解釈するため）。
+- 初回実行時に `opencode service start` を裏で 1 度だけ起動し、常駐サービスを温めておく。
+- 登録したスラッシュコマンド（slash_commands）は送る直前にプロンプトへ展開する（slash_commands.py）。
+  吹き出しと指示の履歴には打った文字（/pass gmail）をそのまま残す。
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from dataclasses import dataclass
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import threading
+import time
+from typing import Any, Protocol
+
+from launcher_app.opencode_chat import (
+    ChatTranscript,
+    PromptHistory,
+    SessionSummary,
+    format_elapsed,
+    parse_model_list,
+    parse_session_list,
+)
+from launcher_app.slash_commands import SlashCommand, expand_slash_command
+
+_ANSI_ESCAPE_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")
+DEFAULT_TIMEOUT_SECONDS = 900.0
+CAPTURE_TIMEOUT_SECONDS = 60.0
+SESSION_LIST_LIMIT = 20
+_service_warmup_started = False
+_service_warmup_lock = threading.Lock()
+
+
+class OpenCodeError(Exception):
+    """opencode を実行できない理由（作業フォルダ未設定・実行中・実行ファイルなし）を表す。"""
+
+
+@dataclass(frozen=True)
+class OpenCodeRunResult:
+    """opencode プロセス 1 回分の終了状態。"""
+
+    returncode: int
+    stderr: str = ""
+    timed_out: bool = False
+    cancelled: bool = False
+
+
+@dataclass(frozen=True)
+class OpenCodeCaptureResult:
+    """短い問い合わせ（会話一覧・会話の書き出し・モデル一覧）の結果。"""
+
+    returncode: int
+    stdout: str
+    stderr: str = ""
+
+
+class OpenCodeRunner(Protocol):
+    """opencode プロセスを起動し、標準出力を 1 行ずつ on_line へ渡す部品。"""
+
+    def run(self, working_dir: str, args: list[str], on_line: Callable[[str], None]) -> OpenCodeRunResult: ...
+
+    def capture(self, working_dir: str, args: list[str]) -> OpenCodeCaptureResult: ...
+
+    def cancel(self) -> None: ...
+
+
+def build_opencode_args(
+    prompt: str,
+    *,
+    session_id: str | None = None,
+    continue_session: bool = False,
+    model: str | None = None,
+    plan_mode: bool = False,
+    auto_approve: bool = False,
+) -> list[str]:
+    """
+    opencode CLI へ渡す引数を組み立てる。
+    `--thinking` を常に付け、モデル・Plan・自動承認・会話の続き（`--session` / `--continue`）の順に足し、指示は `--` の後ろへ置く。
+    """
+    cleaned = str(prompt or "").strip()
+    args = ["run", "--format", "json", "--thinking"]
+    if model and model.strip():
+        args += ["--model", model.strip()]
+    if plan_mode:
+        args += ["--agent", "plan"]
+    if auto_approve:
+        args.append("--auto")
+    if session_id:
+        args += ["--session", session_id]
+    elif continue_session:
+        args.append("--continue")
+    return [*args, "--", cleaned]
+
+
+def strip_ansi_codes(text: str) -> str:
+    """CLI 出力に含まれる ANSI カラーコードや制御エスケープシーケンスを除去し、改行を LF に揃える。"""
+    normalized = str(text or "").replace("\r\n", "\n").replace("\r", "\n")
+    return _ANSI_ESCAPE_RE.sub("", normalized)
+
+
+def _parse_event(line: str) -> dict[str, Any] | None:
+    """NDJSON の 1 行を辞書として読む。JSON でなければ None。"""
+    raw = str(line or "").strip()
+    if not (raw.startswith("{") and raw.endswith("}")):
+        return None
+    try:
+        payload = json.loads(raw)
+    except ValueError:
+        return None
+    return payload if isinstance(payload, dict) else None
+
+
+def extract_session_id(line: str) -> str | None:
+    """NDJSON イベントの `sessionID` を返す。JSON でない行や ID のない行は None。"""
+    payload = _parse_event(line)
+    if payload is None:
+        return None
+    session_id = payload.get("sessionID")
+    return str(session_id) if isinstance(session_id, str) and session_id else None
+
+
+def resolve_opencode_executable(
+    *,
+    appdata: str | None = None,
+    which: Callable[[str], str | None] = shutil.which,
+    is_windows: bool | None = None,
+) -> str | None:
+    """
+    opencode の実行ファイルを探す。見つからなければ None。
+    Windows は npm 配下の opencode.exe → PATH 上の opencode.exe の順に探し、opencode.cmd は使わない。
+    それ以外の OS は PATH 上の opencode を使う。
+    """
+    windows = os.name == "nt" if is_windows is None else is_windows
+    if not windows:
+        return which("opencode")
+    appdata_dir = os.environ.get("APPDATA", "") if appdata is None else appdata
+    if appdata_dir:
+        npm_root = Path(appdata_dir) / "npm" / "node_modules" / "@opencode" / "cli"
+        for candidate in (
+            npm_root / "bin" / "opencode.exe",
+            npm_root / "node_modules" / "@opencode" / "cli-windows-x64" / "bin" / "opencode.exe",
+        ):
+            if candidate.exists():
+                return str(candidate)
+    return which("opencode.exe")
+
+
+def warm_up_opencode_service(executable: str) -> None:
+    """
+    opencode の常駐サービス（`opencode service start`）を裏で 1 度だけ起動する。
+    失敗しても `opencode run` 単体は動くため、結果は見ない。
+    """
+    global _service_warmup_started
+    with _service_warmup_lock:
+        if _service_warmup_started:
+            return
+        _service_warmup_started = True
+
+    def _warmup() -> None:
+        try:
+            subprocess.run(
+                [executable, "service", "start"],
+                capture_output=True,
+                timeout=15,
+                check=False,
+                creationflags=_creation_flags(),
+            )
+        except (OSError, subprocess.SubprocessError):
+            pass
+
+    threading.Thread(target=_warmup, daemon=True).start()
+
+
+def child_environment(working_dir: str) -> dict[str, str] | None:
+    """
+    opencode へ渡す環境変数。`PWD` を作業フォルダに合わせる。
+    `cwd=` だけを指定すると起動元の `PWD` が残り、opencode はそちらを作業フォルダと見なして
+    設定したフォルダと別の場所（例: バックエンドの backend/）でコマンドを実行してしまう。
+    作業フォルダが空なら何も変えない（None）。
+    """
+    if not working_dir:
+        return None
+    return {**os.environ, "PWD": working_dir}
+
+
+def _creation_flags() -> int:
+    """Windows ではコンソール窓を出さずに起動する。"""
+    return getattr(subprocess, "CREATE_NO_WINDOW", 0) if os.name == "nt" else 0
+
+
+class SubprocessOpenCodeRunner:
+    """
+    opencode をサブプロセスで実行する既定のランナー。
+    標準エラーは別スレッドで読み、`timeout_seconds` を過ぎるか cancel() されたらプロセスを止める。
+    """
+
+    def __init__(
+        self,
+        *,
+        executable_resolver: Callable[[], str | None] = resolve_opencode_executable,
+        timeout_seconds: float = DEFAULT_TIMEOUT_SECONDS,
+        warm_up: Callable[[str], None] = warm_up_opencode_service,
+    ) -> None:
+        self.executable_resolver = executable_resolver
+        self.timeout_seconds = timeout_seconds
+        self.warm_up = warm_up
+        self._lock = threading.Lock()
+        self._process: subprocess.Popen[str] | None = None
+        self._cancelled = False
+
+    def run(self, working_dir: str, args: list[str], on_line: Callable[[str], None]) -> OpenCodeRunResult:
+        """作業フォルダで opencode を起動し、標準出力を 1 行ずつ on_line へ渡して終了状態を返す。"""
+        executable = self.executable_resolver()
+        if not executable:
+            raise OpenCodeError("opencode が見つかりません（opencode.exe をインストールしてください）")
+        self.warm_up(executable)
+        process = subprocess.Popen(
+            [executable, *args],
+            cwd=working_dir,
+            env=child_environment(working_dir),
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+            encoding="utf-8",
+            errors="replace",
+            bufsize=1,
+            creationflags=_creation_flags(),
+        )
+        with self._lock:
+            self._process = process
+            self._cancelled = False
+        stderr_chunks: list[str] = []
+        stderr_reader = threading.Thread(target=lambda: stderr_chunks.append(process.stderr.read() if process.stderr else ""), daemon=True)
+        stderr_reader.start()
+        timed_out = threading.Event()
+
+        def _on_timeout() -> None:
+            timed_out.set()
+            _kill(process)
+
+        watchdog = threading.Timer(self.timeout_seconds, _on_timeout)
+        watchdog.daemon = True
+        watchdog.start()
+        try:
+            assert process.stdout is not None
+            for raw_line in process.stdout:
+                on_line(raw_line)
+            returncode = process.wait()
+        finally:
+            watchdog.cancel()
+            stderr_reader.join(5)
+            with self._lock:
+                cancelled = self._cancelled
+                self._process = None
+        stderr_text = strip_ansi_codes("".join(stderr_chunks)).strip()
+        return OpenCodeRunResult(returncode, stderr_text, timed_out=timed_out.is_set(), cancelled=cancelled)
+
+    def capture(self, working_dir: str, args: list[str]) -> OpenCodeCaptureResult:
+        """短い問い合わせを実行し、標準出力をまとめて返す（`CAPTURE_TIMEOUT_SECONDS` で打ち切る）。"""
+        executable = self.executable_resolver()
+        if not executable:
+            raise OpenCodeError("opencode が見つかりません（opencode.exe をインストールしてください）")
+        try:
+            completed = subprocess.run(
+                [executable, *args],
+                cwd=working_dir or None,
+                env=child_environment(working_dir),
+                stdin=subprocess.DEVNULL,
+                capture_output=True,
+                text=True,
+                encoding="utf-8",
+                errors="replace",
+                timeout=CAPTURE_TIMEOUT_SECONDS,
+                check=False,
+                creationflags=_creation_flags(),
+            )
+        except subprocess.TimeoutExpired:
+            return OpenCodeCaptureResult(-1, "", "タイムアウトしました")
+        except OSError as error:
+            raise OpenCodeError(f"opencode を起動できません: {error}") from error
+        return OpenCodeCaptureResult(completed.returncode, completed.stdout or "", strip_ansi_codes(completed.stderr or "").strip())
+
+    def cancel(self) -> None:
+        """実行中の opencode を止める。実行していなければ何もしない。"""
+        with self._lock:
+            process = self._process
+            if process is None:
+                return
+            self._cancelled = True
+        _kill(process)
+
+
+def _kill(process: subprocess.Popen[str]) -> None:
+    """終了済みでも例外にせずプロセスを止める。"""
+    try:
+        process.kill()
+    except OSError:
+        pass
+
+
+class OpenCodeSession:
+    """
+    opencode CLI ペインの作業フォルダ・会話 ID・チャット表示（transcript）・待ち行列・実行中状態を管理する。
+    send() は呼び出したスレッドで opencode を実行する（画面からは別スレッドで呼ぶ）。
+    """
+
+    def __init__(
+        self,
+        working_dir: str = "",
+        *,
+        runner: OpenCodeRunner | None = None,
+        dir_exists: Callable[[str], bool] = os.path.isdir,
+        clock: Callable[[], float] = time.monotonic,
+    ) -> None:
+        self.working_dir = str(working_dir or "").strip()
+        self.runner: OpenCodeRunner = runner or SubprocessOpenCodeRunner()
+        self.dir_exists = dir_exists
+        self.clock = clock
+        self.session_id: str | None = None
+        self.transcript = ChatTranscript()
+        self.history = PromptHistory()
+        self.model: str | None = None
+        self.plan_mode = False
+        self.auto_approve = False
+        self.queue: list[str] = []
+        self.slash_commands: list[SlashCommand] = []
+        self.status = ""
+        self._has_conversation = False
+        self._running = False
+        self._started_at: float | None = None
+        self._generation = 0
+        self._lock = threading.Lock()
+
+    @property
+    def continue_session(self) -> bool:
+        """次の送信が直前の会話の続きになるか。"""
+        return self._has_conversation
+
+    @property
+    def is_running(self) -> bool:
+        """opencode を実行中か。"""
+        return self._running
+
+    def status_text(self) -> str:
+        """実行中は「作業中… 12秒 · 待機 1件」、それ以外は直近の結果（完了・中断など）。"""
+        with self._lock:
+            started = self._started_at if self._running else None
+            waiting = len(self.queue)
+        if started is None:
+            return self.status
+        text = f"作業中… {format_elapsed(self.clock() - started)}"
+        return f"{text} · 待機 {waiting}件" if waiting else text
+
+    def set_working_dir(self, working_dir: str) -> None:
+        """作業フォルダを更新する。フォルダが変わったら新規会話へ戻す。"""
+        normalized = str(working_dir or "").strip()
+        if normalized != self.working_dir:
+            self.working_dir = normalized
+            self.session_id = None
+            self._has_conversation = False
+
+    def reset(self) -> None:
+        """実行中なら止め、待ち行列と表示を消して次回の送信を新規会話に戻す。"""
+        with self._lock:
+            self._generation += 1
+            self.queue.clear()
+        if self._running:
+            self.runner.cancel()
+        self.session_id = None
+        self._has_conversation = False
+        self.transcript.clear()
+        self.status = ""
+
+    def cancel(self) -> None:
+        """実行中の opencode を止め、待ち行列を捨てる。"""
+        with self._lock:
+            self.queue.clear()
+            running = self._running
+        if running:
+            self.runner.cancel()
+
+    def _check_working_dir(self) -> None:
+        """作業フォルダが使えなければ OpenCodeError。"""
+        if not self.working_dir:
+            raise OpenCodeError("opencode 実行フォルダが未設定です（ランチャーの ☰ メニューか Web の設定で指定してください）")
+        if not self.dir_exists(self.working_dir):
+            raise OpenCodeError(f"opencode 実行フォルダが見つかりません: {self.working_dir}")
+
+    def send(self, prompt: str, *, on_update: Callable[[], None] | None = None) -> bool:
+        """
+        指示を opencode へ送る。実行中なら待ち行列へ入れてすぐ戻る。
+        実行した場合は、終わったあと待ち行列の指示も順に送ってから戻る。
+        on_update には表示が変わるたびに通知する。空の指示は False、作業フォルダの未設定・不在は OpenCodeError。
+        """
+        cleaned_prompt = str(prompt or "").strip()
+        if not cleaned_prompt:
+            return False
+        self._check_working_dir()
+        with self._lock:
+            if self._running:
+                self.queue.append(cleaned_prompt)
+                queued = True
+            else:
+                self._running = True
+                queued = False
+        if queued:
+            _notify(on_update)
+            return True
+        try:
+            next_prompt: str | None = cleaned_prompt
+            while next_prompt is not None:
+                self._run(next_prompt, on_update)
+                with self._lock:
+                    next_prompt = self.queue.pop(0) if self.queue else None
+        finally:
+            with self._lock:
+                self._running = False
+                self._started_at = None
+            _notify(on_update)
+        return True
+
+    def _run(self, prompt: str, on_update: Callable[[], None] | None) -> None:
+        """1 回分の実行と、結果のお知らせ。"""
+        with self._lock:
+            generation = self._generation
+            self._started_at = self.clock()
+        started = self._started_at
+        self.history.add(prompt)
+        self.transcript.add_user(prompt)
+        expanded = expand_slash_command(prompt, self.slash_commands)
+        args = build_opencode_args(
+            expanded if expanded is not None else prompt,
+            session_id=self.session_id,
+            continue_session=self._has_conversation,
+            model=self.model,
+            plan_mode=self.plan_mode,
+            auto_approve=self.auto_approve,
+        )
+        captured_session: list[str] = []
+        shown_before = len(self.transcript.entries)
+
+        def _handle_line(line: str) -> None:
+            session_id = extract_session_id(line)
+            if session_id and not captured_session:
+                captured_session.append(session_id)
+            if generation == self._generation and self.transcript.apply_line(line):
+                _notify(on_update)
+
+        _notify(on_update)
+        try:
+            result = self.runner.run(self.working_dir, args, _handle_line)
+        except OpenCodeError as error:
+            self.transcript.add_notice(str(error), error=True)
+            self.status = f"opencode 実行失敗: {error}"
+            return
+        if generation != self._generation:
+            return
+        elapsed = self.clock() - (started if started is not None else self.clock())
+        if result.cancelled:
+            self.transcript.add_notice("中断しました")
+            self.status = "中断しました"
+        elif result.timed_out:
+            self.transcript.add_notice("タイムアウトしたため停止しました", error=True)
+            self.status = "タイムアウトしました"
+        elif result.returncode != 0:
+            detail = f": {result.stderr}" if result.stderr else ""
+            self.transcript.add_notice(f"opencode 実行失敗（exit {result.returncode}）{detail}", error=True)
+            self.status = f"opencode 実行失敗（exit {result.returncode}）"
+        else:
+            if not any(entry.kind in {"text", "tool"} for entry in self.transcript.entries[shown_before:]):
+                self.transcript.add_notice("（応答なし）")
+            self.status = f"完了（{format_elapsed(elapsed)}）"
+        if captured_session:
+            self.session_id = captured_session[0]
+            self._has_conversation = True
+        elif result.returncode == 0 and not result.cancelled and not result.timed_out:
+            self._has_conversation = True
+
+    def list_sessions(self) -> list[SessionSummary]:
+        """作業フォルダの会話一覧（新しい順）。取れなければ空。"""
+        self._check_working_dir()
+        result = self.runner.capture(
+            self.working_dir, ["session", "list", "--format", "json", "-n", str(SESSION_LIST_LIMIT)]
+        )
+        return parse_session_list(result.stdout) if result.returncode == 0 else []
+
+    def resume(self, session_id: str) -> None:
+        """
+        過去の会話を読み込み、その会話 ID で続ける。実行中・読み込み失敗は OpenCodeError（今の会話は残す）。
+        """
+        self._check_working_dir()
+        if self._running:
+            raise OpenCodeError("opencode 実行中は会話を切り替えられません")
+        result = self.runner.capture(self.working_dir, ["session", "export", session_id])
+        data: Any = None
+        if result.returncode == 0:
+            try:
+                start = result.stdout.find("{")
+                data = json.JSONDecoder().raw_decode(result.stdout[start:])[0] if start >= 0 else None
+            except ValueError:
+                data = None
+        if not isinstance(data, dict):
+            raise OpenCodeError(f"会話を読み込めません: {result.stderr or session_id}")
+        restored = ChatTranscript.from_export(data)
+        with self._lock:
+            self._generation += 1
+        self.transcript.replace_with(restored)
+        self.session_id = session_id
+        self._has_conversation = True
+        self.status = f"会話を再開しました: {restored.title or session_id}"
+
+    def list_models(self) -> list[str]:
+        """使えるモデルの一覧（`opencode models`）。取れなければ空。"""
+        try:
+            result = self.runner.capture(self.working_dir if self.working_dir and self.dir_exists(self.working_dir) else "", ["models"])
+        except OpenCodeError:
+            return []
+        return parse_model_list(result.stdout) if result.returncode == 0 else []
+
+
+def _notify(callback: Callable[[], None] | None) -> None:
+    """表示更新の通知（未指定なら何もしない）。"""
+    if callback is not None:
+        callback()
diff --git a/launcher/src/launcher_app/scratchpad.py b/launcher/src/launcher_app/scratchpad.py
new file mode 100644
index 0000000000000000000000000000000000000000..2370dc4d3ff7c27ec340a2d19bb0f28f7c2db1ba
--- /dev/null
+++ b/launcher/src/launcher_app/scratchpad.py
@@ -0,0 +1,105 @@
+"""
+ランチャーの常時保持メモ（Scratchpad）の自動保存を管理する（macOS 版）。
+
+【仕様】
+- 入力のたびに update() を呼ぶと、最後の入力から delay 秒後に 1 回だけ保存する（デバウンス）。
+- 非表示・終了時は flush() で即座に保存する。flush() は同時に 1 つしか走らない。
+- 保存の通信中に入力された内容は「未保存」のまま残し、次の保存で必ず届ける（版番号で判定する）。
+- 保存に失敗したら未保存のまま残し、状態を「保存失敗: 理由」にする。
+- load() はサーバーから読んだ値を未保存扱いにせず反映する。手元で一度でも編集した後は何もしない
+  （ランチャー自身の編集を正とし、行き違った古い値で上書きしない）。
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+import threading
+from typing import Any
+
+SAVED_STATUS = "保存済み"
+DIRTY_STATUS = "未保存..."
+
+
+class ScratchpadAutosave:
+    """常時保持メモの本文・未保存状態・保存タイマーをまとめる。"""
+
+    def __init__(
+        self,
+        save: Callable[[str], Any],
+        *,
+        delay: float = 0.6,
+        timer_factory: Callable[[float, Callable[[], None]], Any] = threading.Timer,
+        on_status: Callable[[str], None] = lambda status: None,
+    ) -> None:
+        self._save = save
+        self._delay = delay
+        self._timer_factory = timer_factory
+        self._on_status = on_status
+        self._state_lock = threading.Lock()
+        self._save_lock = threading.Lock()
+        self._text = ""
+        self._revision = 0
+        self._saved_revision = 0
+        self._timer: Any = None
+
+    @property
+    def text(self) -> str:
+        """現在のメモ本文。"""
+        return self._text
+
+    @property
+    def dirty(self) -> bool:
+        """まだバックエンドへ届いていない編集があるか。"""
+        return self._revision != self._saved_revision
+
+    def load(self, text: str) -> bool:
+        """
+        サーバーから読んだメモを反映する。手元で一度も編集していないときだけ反映し、反映したら True を返す。
+        （編集した後は、読み込みと保存が行き違って新しい内容を古い値で消さないよう反映しない）
+        """
+        with self._state_lock:
+            if self._revision != 0:
+                return False
+            self._text = str(text or "")
+            return True
+
+    def update(self, text: str) -> None:
+        """入力された本文を記録し、保存タイマーを掛け直す。"""
+        with self._state_lock:
+            self._text = str(text or "")
+            self._revision += 1
+            self._cancel_timer_locked()
+            timer = self._timer_factory(self._delay, self.flush)
+            timer.daemon = True
+            self._timer = timer
+        self._on_status(DIRTY_STATUS)
+        timer.start()
+
+    def cancel(self) -> None:
+        """保存タイマーを止める（未保存の状態は残す）。"""
+        with self._state_lock:
+            self._cancel_timer_locked()
+
+    def flush(self) -> bool:
+        """未保存の編集があれば保存する。保存できた（または保存不要だった）ら True。"""
+        with self._save_lock:
+            with self._state_lock:
+                self._cancel_timer_locked()
+                if self._revision == self._saved_revision:
+                    return True
+                text, revision = self._text, self._revision
+            try:
+                self._save(text)
+            except Exception as error:  # 通信・サーバーの失敗はすべて「未保存のまま」で扱う
+                self._on_status(f"保存失敗: {error}")
+                return False
+            with self._state_lock:
+                self._saved_revision = max(self._saved_revision, revision)
+                still_dirty = self._revision != self._saved_revision
+            self._on_status(DIRTY_STATUS if still_dirty else SAVED_STATUS)
+            return True
+
+    def _cancel_timer_locked(self) -> None:
+        if self._timer is not None:
+            self._timer.cancel()
+            self._timer = None
