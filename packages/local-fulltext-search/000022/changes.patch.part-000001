+def test_launcher_manager_does_not_start_python_on_windows_without_wpf(monkeypatch, tmp_path) -> None:
+    """
+    Windows で発行済みWPF版が無いときは起動しない（Python / Flet 版は廃止）。理由を状態とログへ残す。
+    """
