@@ -160,6 +161,39 @@ def normalize_plain_text(value: str | None) -> str:
     return str(value or "").strip()
 
 
+def normalize_opencode_working_dir(value: str | None) -> str:
+    """opencode CLI の作業フォルダを正規化する。空欄時は設定（settings.opencode_default_working_dir）の既定フォルダを返す。"""
+    cleaned = str(value or "").strip()
+    return cleaned if cleaned else settings.opencode_default_working_dir
+
+
+def normalize_launcher_memo(value: str | None) -> str:
+    """ランチャーの永続メモを改行コードのみ LF に揃えてそのまま保持する。"""
+    return str(value or "").replace("\r\n", "\n").replace("\r", "\n")
+
+
+def normalize_slash_commands(commands: Any) -> list[dict[str, str]]:
+    """
+    ランチャーの独自スラッシュコマンド一覧を正規化する。
+    名前は先頭の / を外し、空白・/ を含む名前や空のプロンプトは捨てる。名前は大文字小文字を区別せず重複させず
+    （先に来た方を残す）、名前順に並べる。
+    """
+    normalized: dict[str, dict[str, str]] = {}
+    for item in commands if isinstance(commands, list) else []:
+        if not isinstance(item, dict):
+            continue
+        name = str(item.get("name") or "").strip().lstrip("/")
+        prompt = str(item.get("prompt") or "").strip()
+        if not name or not prompt or any(char.isspace() or char == "/" for char in name):
+            continue
+        normalized.setdefault(name.lower(), {
+            "name": name,
+            "prompt": prompt,
+            "description": str(item.get("description") or "").strip(),
+        })
+    return sorted(normalized.values(), key=lambda command: command["name"].lower())
+
