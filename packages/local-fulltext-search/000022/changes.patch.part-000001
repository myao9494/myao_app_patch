-    def _on_keyboard(self, event: Any) -> None:
-        """
-        矢印・Enter・Escape のランチャー操作を処理する。
-        """
-        key = _key_name_from_flet_event(event)
-        if key == "Escape":
-            if self.active_screen == "memo":
-                self._switch_screen("search")
-            else:
-                self._hide_window()
-        elif key == "Tab":
-            self._move_tab_focus(backward=bool(getattr(event, "shift", False)))
-        elif key == "Arrow Down":
-            self._move_selection(1)
-        elif key == "Arrow Up":
-            self._move_selection(-1)
-        elif key == "Enter":
-            if self.active_screen == "memo":
-                # 各テキストボックス（タイトル・本文）での Enter/Shift+Enter は送信せず改行とする（標準挙動に委ねる）
-                if self.memo_focused_control in {"title", "body"}:
-                    return
-                elif self.memo_focused_control == "cancel":
-                    self._switch_screen("search")
-                elif self.memo_focused_control == "submit":
-                    self._submit_memo()
-                return
-            if self._plain_search_enter_should_commit_text(event):
-                return
-            if getattr(event, "meta", False) or getattr(event, "ctrl", False):
-                self._reveal_selected()
-            else:
-                self._open_selected()
-
-    def _set_query_focus(self, focused: bool) -> None:
-        """
-        検索欄が IME の Enter 確定対象か判定するため、フォーカス状態を保持する。
-        """
-        self._query_focused = focused
-
-    def _set_extension_filter_focus(self, focused: bool) -> None:
-        """拡張子欄のTab循環位置を保持する。"""
-        self._extension_filter_focused = focused
-
-    def _on_query_submit(self, event: Any) -> None:
-        """
-        検索欄の submit を処理する。Windows では IME 変換確定の Enter を結果起動に使わない。
-        """
-        if self._plain_search_enter_should_commit_text(event):
-            return
-        self._open_selected()
-
-    def _plain_search_enter_should_commit_text(self, event: Any | None = None) -> bool:
-        """
-        Windows の検索欄フォーカス中の素の Enter は IME 変換確定として扱う。
-        ただし、上下キーによるナビゲーション直後の Enter は結果起動として扱う。
-        """
-        if self._platform_name() != "Windows":
-            return False
-        if self.active_screen != "search" or not self._query_focused:
-            return False
-        # 上下キーで選択を移動した直後の Enter はファイルを開く意図
-        if self._arrow_navigated:
-            self._arrow_navigated = False
-            return False
-        if event is None:
-            return True
-        return not any(
-            bool(getattr(event, modifier, False))
-            for modifier in ("alt", "ctrl", "meta", "shift")
-        )
-
-    def _switch_screen(self, screen: str) -> None:
-        """
-        Tab キーで検索画面と gantt メモ画面を切り替える。
-        """
-        self.active_screen = "memo" if screen == "memo" else "search"
-        self._apply_memo_surface_style(self.active_screen == "memo")
-        drag_area = getattr(self, "drag_area", None)
-        main_column = getattr(self, "main_column", None)
-        if self.active_screen == "memo":
-            if main_column is not None:
-                # gantt メモ画面ではドラッグ用の飾りも表示せず、文字と入力欄だけにする。
-                main_column.controls = [self.memo_area]
-            self.memo_focused_control = "title"
-            self._run_window_task(self.memo_title_field.focus)
-        else:
-            if main_column is not None:
-                main_column.controls = [drag_area, self.search_area] if drag_area is not None else [self.search_area]
-            self._focus_query()
-        self.page.update()
-
-    def _apply_memo_surface_style(self, is_memo: bool) -> None:
-        """gantt メモ画面では外枠・影を外し、検索画面では通常の外観へ戻す。"""
-        root = getattr(self, "root", None)
-        ft = getattr(self, "ft", None)
-        if root is None or ft is None:
-            return
-        if is_memo:
-            root.border_radius = 0
-            root.border = None
-            root.shadow = None
-        else:
-            root.border_radius = 18
-            root.border = ft.border.all(1, "#1d4ed8")
-            root.shadow = ft.BoxShadow(blur_radius=34, color="#000000", offset=ft.Offset(0, 18))
-
-    def _set_memo_focused(self, name: str) -> None:
-        """
-        現在フォーカスのあるメモ画面コントロール名を記録する。
-        """
-        self.memo_focused_control = name
-
-    def _focus_next_memo_control(self) -> None:
-        """
-        gantt メモ画面で次のコントロールへフォーカスを移す。
-        """
-        if self.memo_focused_control == "title":
-            self._run_window_task(self.memo_body_field.focus)
-        elif self.memo_focused_control == "body":
-            self._run_window_task(self.memo_submit_button.focus)
-        elif self.memo_focused_control == "submit":
-            self._switch_screen("search")
-
-    def _focus_previous_memo_control(self) -> None:
-        """
-        gantt メモ画面で前のコントロールへフォーカスを戻す。
-        """
-        if self.memo_focused_control == "title":
-            self._switch_screen("search")
-            self._run_window_task(self.extension_filter.focus)
-        elif self.memo_focused_control == "body":
-            self._run_window_task(self.memo_title_field.focus)
-        elif self.memo_focused_control == "submit":
-            self._run_window_task(self.memo_body_field.focus)
-        elif self.memo_focused_control == "cancel":
-            self._run_window_task(self.memo_submit_button.focus)
-
-    def _move_tab_focus(self, *, backward: bool) -> None:
-        """検索欄、拡張子欄、ganttメモ主要入力を指定順で循環させる。"""
-        if self.active_screen == "search":
-            if backward:
-                if self._extension_filter_focused:
-                    self._run_window_task(self.query.focus)
-                else:
-                    self._switch_screen("memo")
-                    self.memo_focused_control = "submit"
-                    self._run_window_task(self.memo_submit_button.focus)
-            elif self._query_focused:
-                self._run_window_task(self.extension_filter.focus)
-            else:
-                self._switch_screen("memo")
-            return
-        if backward:
-            self._focus_previous_memo_control()
-        else:
-            self._focus_next_memo_control()
-
-    def _submit_memo(self) -> None:
-        """
-        メモ入力を gantt タスクに変換して作成 API へ送信する。
-        """
-        title = str(self.memo_title_field.value or "").strip()
-        memo = str(self.memo_body_field.value or "").strip()
-        raw_text = f"{title}\n{memo}"
-        if self._recently_submitted_memo(raw_text):
-            return
-        if not title:
-            self.memo_status.value = "タスク名を入力してください"
-            self.page.update()
-            return
-        parent = self._load_gantt_parent()
-        payload = build_gantt_task_payload(title, memo, parent=parent)
-        try:
-            self.client.create_gantt_task(payload)
-        except Exception as error:
-            self.memo_status.value = f"gantt 追加に失敗しました: {error}"
-        else:
-            self._last_memo_submit_text = raw_text
-            self._last_memo_submit_time = time.monotonic()
-            self.memo_title_field.value = ""
-            self.memo_body_field.value = ""
-            self.memo_status.value = "gantt に追加しました"
-            self.memo_focused_control = "title"
-            self._run_window_task(self.memo_title_field.focus)
-        self.page.update()
-
-    def _load_gantt_parent(self) -> int:
-        """
-        Web の設定ドロワーで保存した gantt parent ID を取得する。
-        """
-        try:
-            settings = self.client.get_app_settings()
-        except Exception:
-            return self.gantt_parent
-        self.gantt_parent = normalize_parent_id(settings.get("gantt_parent"), default=self.gantt_parent)
-        self.memo_parent_label.value = f"parent: {self.gantt_parent}"
-        return self.gantt_parent
-
-    _BLUR_GUARD_SECONDS = 0.3
-
-    def _on_window_event(self, event: Any) -> None:
-        """
-        フォーカス喪失時に自動でランチャーを隠す。
-        表示直後の blur はウィンドウマネージャー起因のため無視する。
-        """
-        if getattr(event, "data", "") == "blur":
-            if time.monotonic() - self._show_time < self._BLUR_GUARD_SECONDS:
-                return
-            self._hide_window()
-
-    def _move_selection(self, delta: int) -> None:
-        """
-        検索結果の選択位置を上下に移動する。
-        矢印ナビゲーションフラグを立てて、直後の Enter をファイル起動として扱えるようにする。
-        """
-        if not self.results:
-            return
-        self._arrow_navigated = True
-        self.selected_index = (self.selected_index + delta) % len(self.results)
-        self._suppress_render_focus = True
-        try:
-            self._render_results()
-        finally:
-            self._suppress_render_focus = False
-        self._scroll_to_selected(delta)
-        self._focus_query()
-
-    def _scroll_to_selected(self, delta: int = 0) -> None:
-        """
-        キーボード選択中のカードがリスト表示範囲に入るようスクロールする。
-        """
-        scroll_to = getattr(self.results_column, "scroll_to", None)
-        if callable(scroll_to):
-            if delta > 0:
-                anchor_index = max(self.selected_index - VISIBLE_RESULT_COUNT + 1, 0)
-            else:
-                anchor_index = self.selected_index
-            offset = max(anchor_index * RESULT_TILE_SCROLL_STEP, 0)
-            result = scroll_to(offset=offset, duration=120)
-            if inspect.isawaitable(result):
-                async def _await_scroll() -> None:
-                    await result
-                self.page.run_task(_await_scroll)
-            self.page.update()
-
-    def _open_selected(self) -> None:
-        """
-        選択中の結果を Web アプリ互換 URL で開き、アクセス数を記録する。
-        """
-        if not self.results:
-            return
-        self._select_and_open(self.results[self.selected_index])
-
-    def _global_enter_enabled(self) -> bool:
-        """
-        Flet の Enter イベントが失われた場合だけ、表示中の単独 Enter を補助する。
-        """
-        if self._plain_search_enter_should_commit_text():
-            return False
-        return self.active_screen in {"search", "memo"} and not self.is_hidden
-
-    def _handle_global_enter_fallback(self) -> None:
-        """
-        pynput のリスナースレッドから Enter 操作を UI スレッドへ戻す。
-        """
-
-        async def _handle_enter() -> None:
-            if self.active_screen == "memo":
-                # 送信ボタンにフォーカスがあるときのみ送信、キャンセルボタンのときは検索画面へ戻る
-                if self.memo_focused_control == "submit":
-                    self._submit_memo()
-                elif self.memo_focused_control == "cancel":
-                    self._switch_screen("search")
-            else:
-                self._open_selected()
-
-        future = self.page.run_task(_handle_enter)
-        add_done_callback = getattr(future, "add_done_callback", None)
-        if callable(add_done_callback):
-            add_done_callback(_log_task_error)
-
-    def _open_selected_from_global_enter(self) -> None:
-        """
-        旧テスト・呼び出し互換用に検索結果起動の Enter フォールバックを残す。
-        """
-        self._handle_global_enter_fallback()
-
-    def _recently_submitted_memo(self, raw_text: str) -> bool:
-        """
-        TextField submit とページキーイベントが同じ Enter を二重送信しないようにする。
-        """
-        current_time = time.monotonic()
-        return raw_text == self._last_memo_submit_text and current_time - self._last_memo_submit_time < 1.0
-
-    def _select_and_open(self, item: SearchResultItem) -> None:
-        """
-        指定結果を開いた後、ランチャーを自動で隠す。
-        """
-        try:
-            if item.source_type == "gantt":
-                if self._is_duplicate_open_request(f"gantt:{abs(item.file_id)}"):
-                    return
-                self.client.open_gantt_task_input(abs(item.file_id))
-                self._hide_window()
-                self.page.update()
-                return
-            open_url = primary_web_url_for_item(item, self.config.web_base_url)
-            if self._is_duplicate_open_request(open_url):
-                return
-            if uses_system_file_launcher(item.full_path):
-                open_with_system_file_launcher(item.full_path)
-            else:
-                webbrowser.open(open_url)
-            if item.result_kind == "file" and item.source_type != "gantt" and item.file_id > 0:
-                query_control = getattr(self, "query", None)
-                query = str(getattr(query_control, "value", "") or "").strip()
-                self.client.record_click(item.file_id, query)
-            self._hide_window()
-        except (OSError, LauncherApiError) as error:
-            self.status.value = f"ファイルを開けませんでした: {error}"
-        self.page.update()
-
-    def _open_gantt_link(self, item: SearchResultItem) -> None:
-        """
-        gantt タスクに設定されているリンクを既定ブラウザで開く。
-        """
-        if item.gantt_link:
-            webbrowser.open(item.gantt_link)
-
-    def _reveal_selected(self) -> None:
-        """
-        選択中の結果の保存場所を開く。
-        """
-        if not self.results:
-            return
-        item = self.results[self.selected_index]
-        self._reveal_item(item)
-
-    def _reveal_item(self, item: SearchResultItem) -> None:
-        """
-        指定結果の保存場所を Explorer / Finder で開く。
-        """
-        if item.source_type == "gantt":
-            self._select_and_open(item)
-            return
-        target_path = item.full_path if item.result_kind == "folder" else folder_path_for_item(item)
-        try:
-            self.client.open_location(target_path)
-            self._hide_window()
-        except LauncherApiError as error:
-            self.status.value = f"保存場所を開けませんでした: {error}"
-        self.page.update()
-
-    def _is_duplicate_open_request(self, request_key: str) -> bool:
-        """
-        Enter の submit/key イベント重複で同じ結果を複数回開かないようにする。
-        """
-        current_time = time.monotonic()
-        if request_key == self._last_open_request_key and current_time - self._last_open_request_time < 1.0:
-            return True
-        self._last_open_request_key = request_key
-        self._last_open_request_time = current_time
-        return False
-
-    def _copy_path(self, item: SearchResultItem) -> None:
-        """
-        フルパスをクリップボードへコピーする。
-        """
-        self._copy_text_to_clipboard(item.full_path)
-        self.status.value = "クリップボードにコピーしました"
-        self.page.update()
-
-    def _copy_text_to_clipboard(self, text: str) -> None:
-        """
-        Flet の非同期 clipboard API と Windows の OS クリップボードへ文字列をコピーする。
-        """
-        set_clipboard = getattr(self.page, "set_clipboard", None)
-        if callable(set_clipboard):
-            set_clipboard(text)
-        else:
-            clipboard = getattr(self.page, "clipboard", None)
-            clipboard_set = getattr(clipboard, "set", None)
-            if callable(clipboard_set):
-                result = clipboard_set(text)
-                if inspect.isawaitable(result):
-                    async def _await_clipboard_set() -> None:
-                        await result
-
-                    self.page.run_task(_await_clipboard_set)
-
-        if platform.system() == "Windows":
-            subprocess.run(
-                ["powershell", "-NoProfile", "-Command", "$input | Set-Clipboard"],
-                input=text,
-                text=True,
-                check=False,
-                capture_output=True,
-            )
-
-    def _open_folder_url(self, item: SearchResultItem) -> None:
-        """
-        Web アプリのフォルダリンクを既定ブラウザで開く。
-        """
-        webbrowser.open(folder_web_url_for_item(item, self.config.web_base_url))
-
-    def _open_gui_url(self) -> None:
-        """
-        8079の検索 Web GUI を既定ブラウザで開く。
-        """
-        webbrowser.open(f"{self.config.api_base_url.rstrip('/')}/")
-        self._hide_window()
-
-    def _on_path_in_filename_toggle_change(self, event: Any) -> None:
-        """
-        ファイル名検索でフォルダ名も対象にするかを切り替え、現在の検索語で再検索する。
-        """
-        self.include_path_in_filename = bool(getattr(event.control, "value", True))
-        query_ctrl = getattr(self, "query", None)
-        if query_ctrl is not None:
-            self._on_query_change(type("Event", (), {"control": query_ctrl})())
-
-    def _on_gantt_toggle_change(self, event: Any) -> None:
-        """
-        ランチャーから gantt タスク検索へ切り替え、現在の検索語で再検索する。
-        """
-        self.include_gantt_tasks = bool(getattr(event.control, "value", False))
-        query = str(self.query.value or "").strip()
-        if not query:
-            return
-        if self.search_timer is not None:
-            self.search_timer.cancel()
-        self.search_sequence += 1
-        sequence = self.search_sequence
-        self.status.value = "検索中..."
-        self.page.update()
-        self.search_timer = threading.Timer(0.18, lambda: self._search(query, sequence))
-        self.search_timer.daemon = True
-        self.search_timer.start()
-
-    def _focus_query(self) -> None:
-        """
-        Windows の Flet で結果側へ移ったフォーカスを検索欄へ戻し、Enter 起動を安定させる。
-        """
-        query = getattr(self, "query", None)
-        focus = getattr(query, "focus", None)
-        if callable(focus):
-            self._run_window_task(focus)
-
-    @staticmethod
-    def _platform_name() -> str:
-        """
-        OS 名を返す。テスト時に差し替えやすいよう分離する。
-        """
-        import platform
-
-        return platform.system()
-
-
-
-def _log_task_error(future: Any) -> None:
-    """
-    非同期ウィンドウ操作の例外でランチャー全体が落ちないようログに閉じ込める。
-    """
-    try:
-        future.result()
-    except Exception:
-        logger.exception("Flet window task failed.")
-
-
-def _normalize_flet_key_name(key: object) -> str:
-    """
-    Flet のバージョンや Windows の入力経路で揺れるキー名をランチャー内部表現へ揃える。
-    """
-    normalized = str(key or "").strip().lower().replace("_", " ").replace("-", " ")
-    normalized = " ".join(normalized.split())
-    if normalized in {"escape", "esc"}:
-        return "Escape"
-    if normalized in {"arrow down", "arrowdown", "down"}:
-        return "Arrow Down"
-    if normalized in {"arrow up", "arrowup", "up"}:
-        return "Arrow Up"
-    if normalized in {"enter", "return", "numpad enter", "numpadenter", "\n", "\r"}:
-        return "Enter"
-    if normalized in {"tab"}:
-        return "Tab"
-    return str(key or "")
-
-
-def _key_name_from_flet_event(event: Any) -> str:
-    """
-    Flet の key/data 表現差を吸収して内部キー名へ変換する。
-    """
-    key = _normalize_flet_key_name(getattr(event, "key", ""))
-    if key:
-        return key
-    return _normalize_flet_key_name(getattr(event, "data", ""))
diff --git a/launcher/src/launcher_app/ui/four_pane.py b/launcher/src/launcher_app/ui/four_pane.py
new file mode 100644
index 0000000000000000000000000000000000000000..18609ad1dd5ef36d7e22850739eec5e4bdbe3ea7
--- /dev/null
+++ b/launcher/src/launcher_app/ui/four_pane.py
@@ -0,0 +1,77 @@
+"""
+1ページ4ペイン画面（macOS 版）のフォーカス巡回順と Enter キーの動作を決める。
+
+【仕様】
+- Tab / Shift+Tab の巡回順は「検索欄 → 拡張子欄 → OpenCode入力 → OpenCode送信 → 常時保持メモ →
+  ganttタスク名 → ganttメモ本文 → gantt送信 → 検索欄」。
+- 巡回順にないボタン（gantt のクリア、OpenCode の新規会話）からの Tab は、属するペインの次の入力へ進む。
+- Enter の動作:
+  - OpenCode の指示欄は Claudian と同じく Enter で送信、Shift+Enter で改行（Cmd + Enter でも送信）。
+  - gantt の入力欄（タスク名・本文）は改行。Ctrl / Cmd + Enter で送信する。
+  - 常時保持メモは常に改行（送信先がない）。
+  - ボタン上の Enter はそのボタンの操作（送信・クリア・新規会話）。
+  - 検索欄・拡張子欄は選択中の結果を開き、Ctrl / Cmd + Enter は保存場所を開く。
+"""
+
+from __future__ import annotations
+
+FOUR_PANE_TAB_ORDER: tuple[str, ...] = (
+    "query",
+    "extension",
+    "opencode_prompt",
+    "opencode_submit",
+    "scratchpad",
+    "memo_title",
+    "memo_body",
+    "memo_submit",
+)
+
+# 巡回順にないボタンは、巡回順の直前の位置にあるものとして扱う
+_OFF_ORDER_ANCHORS = {
+    "memo_cancel": "memo_body",
+    "opencode_new_chat": "extension",
+}
+
+_SUBMIT_TARGETS = {
+    "opencode_prompt": "submit_opencode",
+    "memo_title": "submit_memo",
+    "memo_body": "submit_memo",
+}
+
+_BUTTON_ACTIONS = {
+    "opencode_submit": "submit_opencode",
+    "opencode_new_chat": "reset_opencode",
+    "memo_submit": "submit_memo",
+    "memo_cancel": "clear_memo",
+}
+
+BUTTON_STOPS = frozenset(_BUTTON_ACTIONS)
+
+
+def next_focus_stop(current: str, *, backward: bool) -> str:
+    """現在のフォーカス位置から、Tab（backward=True なら Shift+Tab）で移る先を返す。"""
+    anchor = _OFF_ORDER_ANCHORS.get(current, current)
+    if anchor not in FOUR_PANE_TAB_ORDER:
+        anchor = "query"
+    index = FOUR_PANE_TAB_ORDER.index(anchor)
+    if current in _OFF_ORDER_ANCHORS and backward:
+        # 巡回順にないボタンからの Shift+Tab は、属するペインの直前の入力へ戻る
+        return anchor
+    step = -1 if backward else 1
+    return FOUR_PANE_TAB_ORDER[(index + step) % len(FOUR_PANE_TAB_ORDER)]
+
+
+def enter_action(focused: str, *, submit_modifier: bool, shift: bool = False) -> str:
+    """
+    フォーカス位置と Ctrl / Cmd・Shift の有無から Enter の動作名を返す。
+    戻り値: newline / submit_opencode / reset_opencode / submit_memo / clear_memo / open_result / reveal_result
+    """
+    if focused in _BUTTON_ACTIONS:
+        return _BUTTON_ACTIONS[focused]
+    if focused == "opencode_prompt":
+        return "newline" if shift and not submit_modifier else "submit_opencode"
+    if focused in _SUBMIT_TARGETS:
+        return _SUBMIT_TARGETS[focused] if submit_modifier else "newline"
+    if focused == "scratchpad":
+        return "newline"
+    return "reveal_result" if submit_modifier else "open_result"
diff --git a/launcher/src/launcher_app/ui/mac_layout.py b/launcher/src/launcher_app/ui/mac_layout.py
new file mode 100644
index 0000000000000000000000000000000000000000..fa1edc29b502a1ed79dbba933d15d9a8722416c9
--- /dev/null
+++ b/launcher/src/launcher_app/ui/mac_layout.py
@@ -0,0 +1,225 @@
+"""
+macOS ネイティブ版ランチャーの 1 ページ 4 ペイン（2×2）配置を計算する。AppKit に依存しない。
+
+【仕様】
+- パネル（既定 1170×780）を 2×2 に分け、左上=検索、右上=OpenCode CLI、左下=常時保持メモ、右下=gantt メモを置く。
+- 座標は Cocoa と同じ左下原点（y が大きいほど上）。最下部に全幅の状態表示欄を置く。
+- 各ペインの入力欄・ボタンは自分のペインの内側に収め、互いに重ねない。
+- 検索結果カード（FlippedView 内、左上原点）は検索ペインの幅に合わせ、操作ボタンを文字と別の行に置く。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+PANEL_WIDTH = 1170
+PANEL_HEIGHT = 780
+RESULT_CARD_HEIGHT = 84
+RESULT_CARD_SPACING = 8
+
+_MARGIN = 16
+_GAP = 12
+_PADDING = 8
+_STATUS_Y = 10
+_STATUS_HEIGHT = 20
+_BOTTOM_ROW_Y = 38
+_BOTTOM_ROW_HEIGHT = 300
+_BUTTON_WIDTH = 88
+_BUTTON_HEIGHT = 26
+
+
+@dataclass(frozen=True)
+class Rect:
+    """矩形（x, y, 幅, 高さ）。辺が接するだけの場合は重なりとみなさない。"""
+
+    x: float
+    y: float
+    width: float
+    height: float
+
+    @property
+    def right(self) -> float:
+        return self.x + self.width
+
+    @property
+    def top(self) -> float:
+        return self.y + self.height
+
+    def contains(self, other: "Rect") -> bool:
+        """other が自分の内側（辺上を含む）に収まるか。"""
+        return self.x <= other.x and self.y <= other.y and other.right <= self.right and other.top <= self.top
+
+    def intersects(self, other: "Rect") -> bool:
+        """面積を持って重なるか。"""
+        return self.x < other.right and other.x < self.right and self.y < other.top and other.y < self.top
+
+
+PANE_CONTROLS: dict[str, tuple[str, ...]] = {
+    "search_pane": (
+        "search_field",
+        "extension_filter",
+        "search_type_segmented",
+        "gui_button",
+        "gantt_checkbox",
+        "path_in_filename_checkbox",
+        "results_scroll",
+    ),
+    "opencode_pane": (
+        "opencode_menu_button",
+        "opencode_title_label",
+        "opencode_commands_button",
+        "opencode_history_popup",
+        "opencode_new_chat_button",
+        "opencode_model_popup",
+        "opencode_plan_checkbox",
+        "opencode_auto_checkbox",
+        "opencode_dir_label",
+        "opencode_output_scroll",
+        "opencode_activity_label",
+        "opencode_prompt_scroll",
+        "opencode_usage_label",
+        "opencode_submit_button",
+    ),
+    "scratchpad_pane": (
+        "scratchpad_title_label",
+        "scratchpad_status_label",
+        "scratchpad_scroll",
+    ),
+    "gantt_pane": (
+        "memo_title_label",
+        "memo_parent_label",
+        "memo_title_field",
+        "memo_scroll",
+        "memo_status_label",
+        "memo_cancel_button",
+        "memo_submit_button",
+    ),
+}
+
+
+def four_pane_layout(width: float = PANEL_WIDTH, height: float = PANEL_HEIGHT) -> dict[str, Rect]:
+    """パネルの大きさから、4 つのペインと各コントロールの矩形を返す。"""
+    pane_width = (width - 2 * _MARGIN - _GAP) / 2
+    inner_width = pane_width - 2 * _PADDING
+    left_x = _MARGIN
+    right_x = _MARGIN + pane_width + _GAP
+    top_row_y = _BOTTOM_ROW_Y + _BOTTOM_ROW_HEIGHT + _GAP
+    top_row_height = height - _MARGIN - top_row_y
+    layout: dict[str, Rect] = {
+        "status_label": Rect(_MARGIN, _STATUS_Y, width - 2 * _MARGIN, _STATUS_HEIGHT),
+        "search_pane": Rect(left_x, top_row_y, pane_width, top_row_height),
+        "opencode_pane": Rect(right_x, top_row_y, pane_width, top_row_height),
+        "scratchpad_pane": Rect(left_x, _BOTTOM_ROW_Y, pane_width, _BOTTOM_ROW_HEIGHT),
+        "gantt_pane": Rect(right_x, _BOTTOM_ROW_Y, pane_width, _BOTTOM_ROW_HEIGHT),
+    }
+    layout.update(_search_controls(left_x + _PADDING, top_row_y, top_row_y + top_row_height, inner_width))
+    layout.update(_opencode_controls(right_x + _PADDING, top_row_y, top_row_y + top_row_height, inner_width))
+    layout.update(_scratchpad_controls(left_x + _PADDING, _BOTTOM_ROW_Y, _BOTTOM_ROW_Y + _BOTTOM_ROW_HEIGHT, inner_width))
+    layout.update(_gantt_controls(right_x + _PADDING, _BOTTOM_ROW_Y, _BOTTOM_ROW_Y + _BOTTOM_ROW_HEIGHT, inner_width))
+    return layout
+
+
+def _search_controls(x: float, bottom: float, top: float, inner_width: float) -> dict[str, Rect]:
+    """検索ペイン: 検索欄＋拡張子欄 / 検索方式＋Web GUI / 絞り込み / 結果一覧。"""
+    extension_width = 110
+    field_y = top - _PADDING - 32
+    segmented_y = field_y - 8 - 24
+    checkbox_y = segmented_y - 6 - 22
+    results_y = bottom + _PADDING
+    return {
+        "search_field": Rect(x, field_y, inner_width - extension_width - 8, 32),
+        "extension_filter": Rect(x + inner_width - extension_width, field_y, extension_width, 32),
+        "search_type_segmented": Rect(x, segmented_y, 250, 24),
+        "gui_button": Rect(x + inner_width - 90, segmented_y, 90, 24),
+        "gantt_checkbox": Rect(x, checkbox_y, 70, 22),
+        "path_in_filename_checkbox": Rect(x + 78, checkbox_y, 160, 22),
+        "results_scroll": Rect(x, results_y, inner_width, checkbox_y - 6 - results_y),
+    }
+
+
+def _opencode_controls(x: float, bottom: float, top: float, inner_width: float) -> dict[str, Rect]:
+    """
+    OpenCode ペイン（Claudian 風）: 見出し＋コマンド登録＋会話履歴＋新規 / モデル＋Plan＋自動承認 / 作業フォルダ /
+    会話（チャット表示）/ 作業状況 / 指示入力 / 使用量＋送信（実行中は停止）。
+    """
+    title_y = top - _PADDING - 24
+    toolbar_y = title_y - 4 - 24
+    dir_y = toolbar_y - 4 - 16
+    row_y = bottom + _PADDING
+    prompt_y = row_y + _BUTTON_HEIGHT + 6
+    prompt_height = 54
+    activity_y = prompt_y + prompt_height + 4
+    output_y = activity_y + 16 + 4
+    new_chat_width = 56
+    history_width = 104
+    commands_width = 78
+    plan_width = 62
+    auto_width = 86
+    model_width = inner_width - plan_width - auto_width - 16
+    menu_width = 32
+    title_x = x + menu_width + 8
+    return {
+        "opencode_menu_button": Rect(x, title_y, menu_width, 24),
+        "opencode_title_label": Rect(title_x, title_y, x + inner_width - new_chat_width - history_width - commands_width - 24 - title_x, 22),
+        "opencode_commands_button": Rect(x + inner_width - new_chat_width - history_width - commands_width - 16, title_y, commands_width, 24),
+        "opencode_history_popup": Rect(x + inner_width - new_chat_width - 8 - history_width, title_y, history_width, 24),
+        "opencode_new_chat_button": Rect(x + inner_width - new_chat_width, title_y, new_chat_width, 24),
+        "opencode_model_popup": Rect(x, toolbar_y, model_width, 24),
+        "opencode_plan_checkbox": Rect(x + model_width + 8, toolbar_y, plan_width, 24),
+        "opencode_auto_checkbox": Rect(x + inner_width - auto_width, toolbar_y, auto_width, 24),
+        "opencode_dir_label": Rect(x, dir_y, inner_width, 16),
+        "opencode_output_scroll": Rect(x, output_y, inner_width, dir_y - 6 - output_y),
+        "opencode_activity_label": Rect(x, activity_y, inner_width, 16),
+        "opencode_prompt_scroll": Rect(x, prompt_y, inner_width, prompt_height),
+        "opencode_usage_label": Rect(x, row_y, inner_width - _BUTTON_WIDTH - 8, _BUTTON_HEIGHT),
+        "opencode_submit_button": Rect(x + inner_width - _BUTTON_WIDTH, row_y, _BUTTON_WIDTH, _BUTTON_HEIGHT),
+    }
+
+
+def _scratchpad_controls(x: float, bottom: float, top: float, inner_width: float) -> dict[str, Rect]:
+    """常時保持メモペイン: 見出し＋保存状態 / 本文。"""
+    title_y = top - _PADDING - 22
+    scroll_y = bottom + _PADDING
+    return {
+        "scratchpad_title_label": Rect(x, title_y, 150, 22),
+        "scratchpad_status_label": Rect(x + 158, title_y, inner_width - 158, 22),
+        "scratchpad_scroll": Rect(x, scroll_y, inner_width, title_y - 6 - scroll_y),
+    }
+
+
+def _gantt_controls(x: float, bottom: float, top: float, inner_width: float) -> dict[str, Rect]:
+    """gantt ペイン: 見出し＋parent / タスク名 / 本文 / 状態＋クリア＋送信。"""
+    title_y = top - _PADDING - 22
+    field_y = title_y - 6 - 28
+    row_y = bottom + _PADDING
+    scroll_y = row_y + _BUTTON_HEIGHT + 6
+    submit_x = x + inner_width - _BUTTON_WIDTH
+    cancel_x = submit_x - 8 - _BUTTON_WIDTH
+    return {
+        "memo_title_label": Rect(x, title_y, 120, 22),
+        "memo_parent_label": Rect(x + inner_width - 180, title_y, 180, 22),
+        "memo_title_field": Rect(x, field_y, inner_width, 28),
+        "memo_scroll": Rect(x, scroll_y, inner_width, field_y - 6 - scroll_y),
+        "memo_status_label": Rect(x, row_y, cancel_x - 8 - x, _BUTTON_HEIGHT),
+        "memo_cancel_button": Rect(cancel_x, row_y, _BUTTON_WIDTH, _BUTTON_HEIGHT),
+        "memo_submit_button": Rect(submit_x, row_y, _BUTTON_WIDTH, _BUTTON_HEIGHT),
+    }
+
+
+def result_card_layout(card_width: float) -> dict[str, Rect]:
+    """
+    検索結果カード内の配置（左上原点）。1〜3 行目にアイコン・題名・パス・抜粋、4 行目に操作ボタンを置く。
+    open_area は結果を開く透明ボタンで、操作ボタンの行には掛けない。
+    """
+    button_y = 60
+    return {
+        "icon": Rect(12, 6, 20, 20),
+        "title": Rect(38, 6, card_width - 50, 20),
+        "path": Rect(12, 28, card_width - 24, 14),
+        "snippet": Rect(12, 44, card_width - 24, 14),
+        "open_area": Rect(0, 0, card_width, 58),
+        "copy_button": Rect(12, button_y, 72, 20),
+        "reveal_button": Rect(90, button_y, 96, 20),
+        "folder_button": Rect(192, button_y, 104, 20),
+        "gantt_link_button": Rect(12, button_y, 160, 20),
+    }
diff --git a/launcher/src/launcher_app/ui/mac_slash_editor.py b/launcher/src/launcher_app/ui/mac_slash_editor.py
new file mode 100644
index 0000000000000000000000000000000000000000..1d478bc336210552bdf992eeb27e77b4d3133c32
--- /dev/null
+++ b/launcher/src/launcher_app/ui/mac_slash_editor.py
@@ -0,0 +1,240 @@
+"""
+macOS 版ランチャーの、OpenCode ペインの独自スラッシュコマンド（/pass など）の登録画面（NSPanel）。
+
+【仕様】（WPF 版 SlashCommandsWindow と同じ）
+- 上の選択欄で登録済みのコマンドを選ぶと、コマンド名・説明・プロンプトの欄へ読み込む。「＋ 新規」で欄を空にする。
+- 「保存」は入力をチェック（slash_commands.validate_command）してから、選択中のコマンドの書き換え（名前の変更も可）
+  または追加として一覧ごとバックエンドへ保存する。保存は裏スレッドで行い、結果はメインスレッドで表示する。
+- 「削除」は確認してから一覧ごと保存する。保存に失敗したら理由を表示し、一覧は変えない。
+- ウィンドウレベルはランチャー本体（NSStatusWindowLevel）より上にし、全デスクトップ・フルスクリーン上でも本体の前に出す。
+- 「閉じる」（Esc）で閉じる。開いている間はランチャー本体をフォーカス喪失で隠さない（native_mac 側で判定）。
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+import threading
+from typing import Any
+
+import AppKit
+import objc
+from PyObjCTools import AppHelper
+
+from launcher_app.slash_commands import SlashCommand, normalize_name, validate_command
+
+EDITOR_WIDTH = 600
+EDITOR_HEIGHT = 440
+# ランチャー本体は NSStatusWindowLevel。登録画面はその 1 つ上、確認ダイアログはさらに 1 つ上にして必ず手前に出す
+EDITOR_WINDOW_LEVEL = AppKit.NSStatusWindowLevel + 1
+ALERT_WINDOW_LEVEL = EDITOR_WINDOW_LEVEL + 1
+NEW_ITEM_TITLE = "＋ 新規"
+
+
+class SlashCommandEditor(AppKit.NSObject):
+    """スラッシュコマンドの登録画面。setup() で一覧と保存処理を受け取り、show() で表示する。"""
+
+    @objc.python_method
+    def setup(
+        self,
+        commands: list[SlashCommand],
+        save: Callable[[list[SlashCommand]], list[SlashCommand]],
+        on_saved: Callable[[list[SlashCommand]], None],
+    ) -> None:
+        """一覧・保存処理（裏スレッドで呼ぶ）・保存後の通知（メインスレッド）を受け取り、画面を作る。"""
+        self.commands = sorted(commands, key=lambda command: command.name.lower())
+        self.save = save
+        self.on_saved = on_saved
+        self.editing_name: str | None = None
+        if getattr(self, "panel", None) is None:
+            self._build()
+        self._render_list(None)
+        self._clear_editor()
+
+    @objc.python_method
+    def _build(self) -> None:
+        style = AppKit.NSWindowStyleMaskTitled | AppKit.NSWindowStyleMaskClosable | AppKit.NSWindowStyleMaskResizable
+        self.panel = AppKit.NSPanel.alloc().initWithContentRect_styleMask_backing_defer_(
+            AppKit.NSMakeRect(0, 0, EDITOR_WIDTH, EDITOR_HEIGHT), style, AppKit.NSBackingStoreBuffered, False
+        )
+        self.panel.setTitle_("スラッシュコマンド")
+        # ランチャー本体は NSStatusWindowLevel なので、それより上にしないと登録画面が本体の後ろに隠れる
+        self.panel.setLevel_(EDITOR_WINDOW_LEVEL)
+        self.panel.setHidesOnDeactivate_(False)
+        self.panel.setCollectionBehavior_(
+            AppKit.NSWindowCollectionBehaviorCanJoinAllSpaces | AppKit.NSWindowCollectionBehaviorFullScreenAuxiliary
+        )
+        self.panel.setReleasedWhenClosed_(False)
+        content = self.panel.contentView()
+        top = EDITOR_HEIGHT - 16
+
+        self.list_popup = AppKit.NSPopUpButton.alloc().initWithFrame_pullsDown_(AppKit.NSMakeRect(16, top - 28, EDITOR_WIDTH - 32, 26), False)
+        self.list_popup.setTarget_(self)
+        self.list_popup.setAction_("selectCommand:")
+        content.addSubview_(self.list_popup)
+
+        content.addSubview_(_label("コマンド名（/ の後ろ。空白と / は使えません）", AppKit.NSMakeRect(16, top - 54, 400, 18)))
+        self.name_field = AppKit.NSTextField.alloc().initWithFrame_(AppKit.NSMakeRect(16, top - 80, 220, 24))
+        self.name_field.setPlaceholderString_("pass")
+        content.addSubview_(self.name_field)
+
+        content.addSubview_(_label("説明（候補に表示）", AppKit.NSMakeRect(16, top - 106, 400, 18)))
+        self.description_field = AppKit.NSTextField.alloc().initWithFrame_(AppKit.NSMakeRect(16, top - 132, EDITOR_WIDTH - 32, 24))
+        self.description_field.setPlaceholderString_("エクセルからパスワードを取得")
+        content.addSubview_(self.description_field)
+
+        content.addSubview_(_label("プロンプト（$ARGUMENTS はコマンドの後ろに打った文字に置き換わります）", AppKit.NSMakeRect(16, top - 158, EDITOR_WIDTH - 32, 18)))
+        prompt_height = top - 166 - 96
+        scroll = AppKit.NSScrollView.alloc().initWithFrame_(AppKit.NSMakeRect(16, 96, EDITOR_WIDTH - 32, prompt_height))
+        scroll.setBorderType_(AppKit.NSBezelBorder)
+        scroll.setHasVerticalScroller_(True)
+        size = scroll.contentSize()
+        self.prompt_view = AppKit.NSTextView.alloc().initWithFrame_(AppKit.NSMakeRect(0, 0, size.width, size.height))
+        self.prompt_view.setRichText_(False)
+        self.prompt_view.setFont_(AppKit.NSFont.systemFontOfSize_(13))
+        self.prompt_view.setAutoresizingMask_(AppKit.NSViewWidthSizable)
+        scroll.setDocumentView_(self.prompt_view)
+        content.addSubview_(scroll)
+
+        hint = _label(
+            "使い方: 指示欄で /pass gmail と打って送信 → $ARGUMENTS が gmail に置き換わったプロンプトを opencode へ送ります。"
+            "$ARGUMENTS が無いときは、後ろの文字をプロンプトの末尾に足します。",
+            AppKit.NSMakeRect(16, 52, EDITOR_WIDTH - 32, 36),
+        )
+        hint.setLineBreakMode_(AppKit.NSLineBreakByWordWrapping)
+        content.addSubview_(hint)
+
+        self.status_label = _label("", AppKit.NSMakeRect(16, 16, EDITOR_WIDTH - 300, 24))
+        content.addSubview_(self.status_label)
+        self.delete_button = _button("削除", AppKit.NSMakeRect(EDITOR_WIDTH - 276, 12, 80, 30), self, "deleteCommand:")
+        content.addSubview_(self.delete_button)
+        self.save_button = _button("保存", AppKit.NSMakeRect(EDITOR_WIDTH - 188, 12, 80, 30), self, "saveCommand:")
+        self.save_button.setKeyEquivalent_("\r")
+        content.addSubview_(self.save_button)
+        close_button = _button("閉じる", AppKit.NSMakeRect(EDITOR_WIDTH - 100, 12, 84, 30), self, "closeEditor:")
+        close_button.setKeyEquivalent_("\x1b")
+        content.addSubview_(close_button)
+
+    @objc.python_method
+    def show(self) -> None:
+        self.panel.center()
+        AppKit.NSApp.activateIgnoringOtherApps_(True)
+        self.panel.makeKeyAndOrderFront_(None)
+        self.panel.orderFrontRegardless()
+        self.panel.makeFirstResponder_(self.name_field)
+
+    @objc.python_method
+    def is_visible(self) -> bool:
+        panel = getattr(self, "panel", None)
+        return bool(panel is not None and panel.isVisible())
+
+    @objc.python_method
+    def _render_list(self, select_name: str | None) -> None:
+        """選択欄の先頭は「＋ 新規」、続けて「/名前  説明」を名前順に並べる。"""
+        self.list_popup.removeAllItems()
+        self.list_popup.addItemWithTitle_(NEW_ITEM_TITLE)
+        for command in self.commands:
+            title = f"/{command.name}  {command.description}" if command.description else f"/{command.name}"
+            self.list_popup.addItemWithTitle_(title)
+            self.list_popup.lastItem().setRepresentedObject_(command.name)
+        index = next((i + 1 for i, command in enumerate(self.commands) if command.name == select_name), 0)
+        self.list_popup.selectItemAtIndex_(index)
+        self.delete_button.setEnabled_(index > 0)
+
+    @objc.python_method
+    def _clear_editor(self) -> None:
+        self.editing_name = None
+        self.name_field.setStringValue_("")
+        self.description_field.setStringValue_("")
+        self.prompt_view.setString_("")
+        self.delete_button.setEnabled_(False)
+
+    def selectCommand_(self, sender: Any) -> None:
+        """選択欄で選んだコマンドを入力欄へ読み込む（「＋ 新規」なら空にする）。"""
+        item = sender.selectedItem()
+        name = item.representedObject() if item is not None else None
+        command = next((c for c in self.commands if c.name == name), None)
+        if command is None:
+            self._clear_editor()
+            self.status_label.setStringValue_("新しいコマンドを入力して「保存」を押してください")
+            self.panel.makeFirstResponder_(self.name_field)
+            return
+        self.editing_name = command.name
+        self.name_field.setStringValue_(command.name)
+        self.description_field.setStringValue_(command.description)
+        self.prompt_view.setString_(command.prompt)
+        self.delete_button.setEnabled_(True)
+        self.status_label.setStringValue_("")
+
+    def saveCommand_(self, sender: Any) -> None:
+        """入力をチェックし、選択中の書き換えまたは追加として一覧ごと保存する。"""
+        name = str(self.name_field.stringValue() or "")
+        prompt = str(self.prompt_view.string() or "")
+        others = [c for c in self.commands if self.editing_name is None or c.name.lower() != self.editing_name.lower()]
+        problem = validate_command(name, prompt, [c.name for c in others])
+        if problem:
+            self.status_label.setStringValue_(problem)
+            return
+        command = SlashCommand(normalize_name(name), prompt.strip(), str(self.description_field.stringValue() or "").strip())
+        self._save_async([*others, command], select_name=command.name, done=f"/{command.name} を保存しました")
+
+    def deleteCommand_(self, sender: Any) -> None:
+        """確認してから、選択中のコマンドを除いた一覧を保存する。"""
+        if self.editing_name is None:
+            return
+        name = self.editing_name
+        alert = AppKit.NSAlert.alloc().init()
+        alert.setMessageText_(f"/{name} を削除しますか？")
+        alert.addButtonWithTitle_("削除")
+        alert.addButtonWithTitle_("キャンセル")
+        alert.window().setLevel_(ALERT_WINDOW_LEVEL)
+        if alert.runModal() != AppKit.NSAlertFirstButtonReturn:
+            return
+        self._save_async([c for c in self.commands if c.name != name], select_name=None, done=f"/{name} を削除しました")
+
+    def closeEditor_(self, sender: Any) -> None:
+        self.panel.orderOut_(None)
+
+    @objc.python_method
+    def _save_async(self, commands: list[SlashCommand], *, select_name: str | None, done: str) -> None:
+        """裏スレッドで保存し、成功したら一覧を描き直して通知する。失敗したら理由を出して一覧は変えない。"""
+        self.save_button.setEnabled_(False)
+        self.status_label.setStringValue_("保存しています…")
+
+        def _work() -> None:
+            try:
+                saved = self.save(commands)
+            except Exception as error:  # 通信の失敗は画面に出して続ける
+                AppHelper.callAfter(self._finish_save, None, select_name, f"保存できません: {error}")
+                return
+            AppHelper.callAfter(self._finish_save, saved, select_name, done)
+
+        threading.Thread(target=_work, daemon=True).start()
+
+    @objc.python_method
+    def _finish_save(self, saved: list[SlashCommand] | None, select_name: str | None, message: str) -> None:
+        self.save_button.setEnabled_(True)
+        self.status_label.setStringValue_(message)
+        if saved is None:
+            return
+        self.commands = sorted(saved, key=lambda command: command.name.lower())
+        self.on_saved(self.commands)
+        self._render_list(select_name)
+        if select_name is None:
+            self._clear_editor()
+        else:
+            self.editing_name = select_name
+
+
+def _label(text: str, frame: Any) -> Any:
+    label = AppKit.NSTextField.labelWithString_(text)
+    label.setFrame_(frame)
+    label.setFont_(AppKit.NSFont.systemFontOfSize_(11))
+    label.setTextColor_(AppKit.NSColor.secondaryLabelColor())
+    return label
+
+
+def _button(title: str, frame: Any, target: Any, action: str) -> Any:
+    button = AppKit.NSButton.buttonWithTitle_target_action_(title, target, action)
+    button.setFrame_(frame)
+    button.setBezelStyle_(AppKit.NSBezelStyleRounded)
+    return button
