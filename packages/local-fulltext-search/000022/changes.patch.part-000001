diff --git a/launcher/tests/test_opencode_chat.py b/launcher/tests/test_opencode_chat.py
new file mode 100644
index 0000000000000000000000000000000000000000..6ff86290420c6f2544a81c4f855d30d985e6b196
--- /dev/null
+++ b/launcher/tests/test_opencode_chat.py
@@ -0,0 +1,281 @@
+"""
+OpenCode ペインのチャット表示モデル（Claudian 風: 吹き出し・思考/ツールの折りたたみ・使用量）と、
+指示の履歴・会話一覧/モデル一覧の読み取り・表示用の書式を検証する。
+"""
+
+from __future__ import annotations
+
+import json
+
+from launcher_app.opencode_chat import (
+    ChatTranscript,
+    PromptHistory,
+    format_elapsed,
+    format_relative_time,
+    format_tokens,
+    parse_model_list,
+    parse_session_list,
+    summarize_tool,
+    tool_header,
+)
+
+
+def event(kind: str, part: dict, session_id: str = "ses_A") -> dict:
+    """opencode run --format json の 1 イベントを作る。"""
+    return {"type": kind, "sessionID": session_id, "part": part}
+
+
+def test_user_and_text_events_become_chat_entries_in_order() -> None:
+    """自分の指示と opencode の応答（text）を、届いた順に別々の吹き出しとして並べる。"""
+    transcript = ChatTranscript()
+    transcript.add_user("ファイル一覧を教えて")
+
+    assert transcript.apply_event(event("text", {"id": "prt_1", "type": "text", "text": "a.txt と b.txt です"})) is True
+
+    assert [(entry.kind, entry.text) for entry in transcript.entries] == [
+        ("user", "ファイル一覧を教えて"),
+        ("text", "a.txt と b.txt です"),
+    ]
+
+
+def test_same_part_id_updates_entry_instead_of_appending() -> None:
+    """同じ part ID のイベントは同じ吹き出し・カードを更新する（実行中→完了のツールなど）。"""
+    transcript = ChatTranscript()
+    transcript.apply_event(event("tool_use", {
+        "id": "prt_t", "type": "tool", "tool": "bash",
+        "state": {"status": "running", "input": {"command": "npm test"}},
+    }))
+    transcript.apply_event(event("tool_use", {
+        "id": "prt_t", "type": "tool", "tool": "bash",
+        "state": {"status": "completed", "input": {"command": "npm test"}, "output": "253 passed"},
+    }))
+
+    assert len(transcript.entries) == 1
+    tool = transcript.entries[0]
+    assert (tool.kind, tool.tool, tool.status, tool.summary) == ("tool", "bash", "completed", "npm test")
+    assert "253 passed" in tool.detail_output
+    assert '"command": "npm test"' in tool.detail_input
+
+
+def test_tool_part_id_prefers_part_id_over_call_id() -> None:
+    """ツールの呼び出し ID（functions.read:0）は応答ごとに重なるため、partID を優先して区別する。"""
+    transcript = ChatTranscript()
+    for part_id in ("prt_1", "prt_2"):
+        transcript.apply_event(event("tool_use", {
+            "partID": part_id, "id": "functions.read:0", "type": "tool", "tool": "read",
+            "state": {"status": "completed", "input": {"path": f"{part_id}.txt"}, "output": "ok"},
+        }))
+
+    assert [entry.summary for entry in transcript.entries] == ["prt_1.txt", "prt_2.txt"]
+
+
+def test_reasoning_is_collapsed_and_keeps_duration() -> None:
+    """思考は既定で折りたたみ、かかった時間を見出しに出す。toggle で開閉できる。"""
+    transcript = ChatTranscript()
+    transcript.apply_event(event("reasoning", {
+        "id": "prt_r", "type": "reasoning", "text": "ファイルを読む必要がある",
+        "time": {"start": 1000, "end": 3500},
+    }))
+
+    reasoning = transcript.entries[0]
+    assert reasoning.kind == "reasoning"
+    assert reasoning.expanded is False
+    assert reasoning.duration_seconds == 2.5
+    assert transcript.toggle("prt_r") is True
+    assert transcript.entries[0].expanded is True
+    assert transcript.toggle("missing") is False
+
+
+def test_empty_reasoning_and_control_events_are_not_shown() -> None:
+    """中身のない思考や step_start などの制御イベントは表示しない。"""
+    transcript = ChatTranscript()
+
+    assert transcript.apply_event(event("reasoning", {"id": "prt_r", "type": "reasoning", "text": "  "})) is False
+    assert transcript.apply_event(event("step_start", {"id": "prt_s", "type": "step-start"})) is False
+    assert transcript.entries == []
+
+
+def test_step_finish_updates_context_usage_and_cost() -> None:
+    """最後の step_finish のトークン数をコンテキスト使用量として表示し、費用は合計する。"""
+    transcript = ChatTranscript()
+    transcript.apply_event(event("step_finish", {
+        "type": "step-finish", "cost": 0.01,
+        "tokens": {"input": 9976, "output": 30, "reasoning": 21, "cache": {"read": 0, "write": 0}},
+    }))
+    transcript.apply_event(event("step_finish", {
+        "type": "step-finish", "cost": 0.02,
+        "tokens": {"input": 191, "output": 6, "reasoning": 87, "cache": {"read": 9856, "write": 0}},
+    }))
+
+    assert transcript.context_tokens == 191 + 6 + 87 + 9856
+    assert round(transcript.cost, 4) == 0.03
+    assert transcript.usage_text() == "コンテキスト 10.1k トークン · $0.0300"
+
+
+def test_usage_text_without_cost_and_without_usage() -> None:
+    """費用 0 は出さず、使用量が無いときは空文字。"""
+    transcript = ChatTranscript()
+    assert transcript.usage_text() == ""
+    transcript.apply_event(event("step_finish", {"type": "step-finish", "cost": 0, "tokens": {"input": 950}}))
+    assert transcript.usage_text() == "コンテキスト 950 トークン"
+
+
+def test_error_event_and_notices() -> None:
+    """error イベントはエラーのお知らせ行にし、中断などの通知も同じ一覧へ並べる。"""
+    transcript = ChatTranscript()
+    transcript.apply_event({"type": "error", "error": {"name": "APIError", "data": {"message": "認証が必要です"}}})
+    transcript.add_notice("中断しました")
+
+    assert [(entry.kind, entry.status, entry.text) for entry in transcript.entries] == [
+        ("notice", "error", "認証が必要です"),
+        ("notice", "info", "中断しました"),
+    ]
+
+
+def test_apply_line_parses_ndjson_and_keeps_plain_output() -> None:
+    """JSON の行はイベントとして読み、JSON でない出力は ANSI を除いて本文として残す。"""
+    transcript = ChatTranscript()
+
+    assert transcript.apply_line(json.dumps(event("text", {"id": "p", "type": "text", "text": "ok"}))) is True
+    assert transcript.apply_line("\x1b[33m警告: 設定が古い\x1b[0m\n") is True
+    assert transcript.apply_line("   ") is False
+
+    assert [(entry.kind, entry.text) for entry in transcript.entries] == [("text", "ok"), ("text", "警告: 設定が古い")]
+
+
+def test_last_assistant_text_and_copy_text() -> None:
+    """コピー用に、応答の本文（最後の text）と吹き出し単位の本文を取り出せる。"""
+    transcript = ChatTranscript()
+    transcript.add_user("質問")
+    transcript.apply_event(event("text", {"id": "p1", "type": "text", "text": "一つ目"}))
+    transcript.apply_event(event("text", {"id": "p2", "type": "text", "text": "二つ目"}))
+
+    assert transcript.last_assistant_text() == "二つ目"
+    assert transcript.copy_text("p1") == "一つ目"
+    assert transcript.copy_text("missing") == ""
+
+
+def test_from_export_restores_past_conversation() -> None:
+    """`opencode session export` の JSON から、過去の会話（指示・思考・ツール・応答・使用量）を復元する。"""
+    exported = {
+        "info": {"id": "ses_A", "title": "hello.txt を読む", "tokens": {"input": 10669}},
+        "messages": [
+            {"id": "m1", "type": "user", "text": "hello.txt を読んで"},
+            {
+                "id": "m2", "type": "assistant",
+                "content": [
+                    {"type": "reasoning", "text": "読む", "time": {"created": 1000, "completed": 1500}},
+                    {
+                        "type": "tool", "id": "functions.read:0", "name": "read",
+                        "state": {"status": "completed", "input": {"path": "hello.txt"},
+                                  "content": [{"type": "text", "text": "1: hello world"}]},
+                    },
+                ],
+                "tokens": {"input": 9976, "output": 30, "reasoning": 21, "cache": {"read": 0, "write": 0}},
+            },
+            {
+                "id": "m3", "type": "assistant",
+                "content": [{"type": "text", "text": "hello world"}],
+                "tokens": {"input": 191, "output": 6, "reasoning": 87, "cache": {"read": 9856, "write": 0}},
+            },
+            {"id": "m4", "type": "idle", "outcome": "succeeded"},
+        ],
+    }
+
+    transcript = ChatTranscript.from_export(exported)
+
+    assert transcript.title == "hello.txt を読む"
+    assert [(entry.kind, entry.text or entry.summary) for entry in transcript.entries] == [
+        ("user", "hello.txt を読んで"),
+        ("reasoning", "読む"),
+        ("tool", "hello.txt"),
+        ("text", "hello world"),
+    ]
+    assert transcript.entries[1].duration_seconds == 0.5
+    assert transcript.entries[2].status == "completed"
+    assert "hello world" in transcript.entries[2].detail_output
+    assert transcript.context_tokens == 191 + 6 + 87 + 9856
+    # 復元した ID は重ならない
+    assert len({entry.id for entry in transcript.entries}) == 4
+
+
+def test_summarize_tool_by_tool_kind() -> None:
+    """ツールごとに、カードの見出しへ出す要約（パス・コマンド・検索語など）を決める。"""
+    assert summarize_tool("read", {"filePath": "src/app.py"}) == "src/app.py"
+    assert summarize_tool("edit", {"path": "README.md"}) == "README.md"
+    assert summarize_tool("bash", {"command": "npm test\nnpm run build"}) == "npm test"
+    assert summarize_tool("grep", {"pattern": "TODO", "path": "src"}) == "TODO in src"
+    assert summarize_tool("glob", {"pattern": "**/*.md"}) == "**/*.md"
+    assert summarize_tool("webfetch", {"url": "https://example.test"}) == "https://example.test"
+    assert summarize_tool("task", {"description": "テストを調べる"}) == "テストを調べる"
+    assert summarize_tool("todowrite", {"todos": [{"status": "completed"}, {"status": "pending"}]}) == "Tasks 1/2"
+    assert summarize_tool("custom", {}, title="独自ツール") == "独自ツール"
+    assert summarize_tool("custom", {"x": 1, "query": "検索"}) == "検索"
+    assert summarize_tool("bash", {"command": "x" * 200}).endswith("…")
+    assert len(summarize_tool("bash", {"command": "x" * 200})) == 80
+
+
+def test_tool_header_shows_status_icon() -> None:
+    """ツールの見出しは「状態アイコン ツール名 要約」。"""
+    assert tool_header("read", "completed", "hello.txt") == "✓ read  hello.txt"
+    assert tool_header("bash", "running", "npm test") == "⏳ bash  npm test"
+    assert tool_header("bash", "error", "") == "✗ bash"
+
+
+def test_prompt_history_navigates_with_up_and_down() -> None:
+    """↑ で過去の指示を新しい順に呼び出し、↓ で戻る。最後まで戻ると打ちかけの下書きを返す。"""
+    history = PromptHistory(limit=3)
+    for prompt in ("一つ目", "二つ目", "二つ目", "三つ目", "四つ目"):
+        history.add(prompt)
+
+    assert history.items == ["二つ目", "三つ目", "四つ目"]
+    assert history.previous("下書き") == "四つ目"
+    assert history.previous("四つ目") == "三つ目"
+    assert history.previous("三つ目") == "二つ目"
+    assert history.previous("二つ目") == "二つ目"
+    assert history.next() == "三つ目"
+    assert history.next() == "四つ目"
+    assert history.next() == "下書き"
+    assert history.next() is None
+
+
+def test_prompt_history_empty_and_reset() -> None:
+    """履歴が空なら呼び出さない。送信したら呼び出し位置を最初へ戻す。"""
+    history = PromptHistory()
+    assert history.previous("") is None
+    history.add("a")
+    assert history.previous("") == "a"
+    history.add("b")
+    assert history.previous("") == "b"
+
+
+def test_parse_session_list_reads_json_and_ignores_noise() -> None:
+    """`opencode session list --format json` の出力から会話一覧を読む。前後の余計な出力は無視する。"""
+    stdout = 'warn: something\n[{"id":"ses_1","title":"一つ目","updated":2000},{"id":"ses_2","updated":1000}]\n'
+
+    sessions = parse_session_list(stdout)
+
+    assert [(s.id, s.title, s.updated_ms) for s in sessions] == [("ses_1", "一つ目", 2000), ("ses_2", "", 1000)]
+    assert parse_session_list("not json") == []
+
+
+def test_parse_model_list_keeps_provider_model_lines() -> None:
+    """`opencode models` の出力から「プロバイダー/モデル」の行だけを取り出す。"""
+    stdout = "opencode/big-pickle\nanthropic/claude-opus-5-5\n\nServiceUnavailableError: x\n    at k (B:/x.js:1:2)\n"
+
+    assert parse_model_list(stdout) == ["opencode/big-pickle", "anthropic/claude-opus-5-5"]
+
+
+def test_formatters() -> None:
+    """経過時間・トークン数・相対時刻の表示。"""
+    assert format_elapsed(0.24) == "0.2秒"
+    assert format_elapsed(12.6) == "13秒"
+    assert format_elapsed(65) == "1分05秒"
+    assert format_tokens(950) == "950"
+    assert format_tokens(10669) == "10.7k"
+    assert format_tokens(1_260_000) == "1.3M"
+    now = 10 * 24 * 3600 * 1000
+    assert format_relative_time(now - 30 * 1000, now) == "たった今"
+    assert format_relative_time(now - 5 * 60 * 1000, now) == "5分前"
+    assert format_relative_time(now - 3 * 3600 * 1000, now) == "3時間前"
+    assert format_relative_time(now - 2 * 24 * 3600 * 1000, now) == "2日前"
diff --git a/launcher/tests/test_opencode_runner.py b/launcher/tests/test_opencode_runner.py
new file mode 100644
index 0000000000000000000000000000000000000000..fe34fda0d18c978709c0e2454e54ee377556e783
--- /dev/null
+++ b/launcher/tests/test_opencode_runner.py
@@ -0,0 +1,490 @@
+"""
+ランチャー内 opencode CLI ペインのコマンド組み立て・会話セッション管理（チャット表示・待ち行列・停止・
+過去の会話の再開・モデル一覧）・サブプロセス実行（ハング防止・タイムアウト・実行ファイル解決）のテスト。
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+import json
+import os
+import sys
+import threading
+
+import pytest
+
+from launcher_app.opencode_runner import (
+    OpenCodeCaptureResult,
+    OpenCodeError,
+    OpenCodeRunResult,
+    OpenCodeSession,
+    SubprocessOpenCodeRunner,
+    build_opencode_args,
+    extract_session_id,
+    resolve_opencode_executable,
+    strip_ansi_codes,
+)
+
+
+class FakeRunner:
+    """
+    opencode CLI の代わりに、渡された NDJSON 行を順に流して終了コードを返す。
+    capture（会話一覧・会話の書き出し・モデル一覧）は引数ごとに決めた結果を返す。
+    """
+
+    def __init__(
+        self,
+        scripts: list[tuple[list[str], OpenCodeRunResult]] | None = None,
+        captures: dict[tuple[str, ...], OpenCodeCaptureResult] | None = None,
+    ) -> None:
+        self.scripts = list(scripts or [])
+        self.captures = dict(captures or {})
+        self.calls: list[tuple[str, list[str]]] = []
+        self.capture_calls: list[tuple[str, list[str]]] = []
+        self.cancel_count = 0
+
+    def run(self, working_dir: str, args: list[str], on_line: Callable[[str], None]) -> OpenCodeRunResult:
+        self.calls.append((working_dir, list(args)))
+        lines, result = self.scripts.pop(0) if self.scripts else ([], OpenCodeRunResult(0))
+        for line in lines:
+            on_line(line)
+        return result
+
+    def capture(self, working_dir: str, args: list[str]) -> OpenCodeCaptureResult:
+        self.capture_calls.append((working_dir, list(args)))
+        return self.captures.get(tuple(args), OpenCodeCaptureResult(1, "", "not scripted"))
+
+    def cancel(self) -> None:
+        self.cancel_count += 1
+
+
+_part_counter = [0]
+
+
+def text_event(text: str, session_id: str = "ses_A") -> str:
+    """opencode run --format json の text イベント 1 行を作る（part ID は毎回別）。"""
+    _part_counter[0] += 1
+    return json.dumps({"type": "text", "sessionID": session_id, "part": {"id": f"prt_{_part_counter[0]}", "type": "text", "text": text}})
+
+
+def kinds_and_texts(session: OpenCodeSession) -> list[tuple[str, str]]:
+    """会話の表示内容を (種類, 本文) の並びで返す。"""
+    return [(entry.kind, entry.text) for entry in session.transcript.entries]
+
+
+def make_session(runner: FakeRunner, working_dir: str = r"C:\work", **kwargs: object) -> OpenCodeSession:
+    """フォルダが存在する扱いのセッションを作る。"""
+    return OpenCodeSession(working_dir, runner=runner, dir_exists=lambda path: True, **kwargs)  # type: ignore[arg-type]
+
+
+def test_build_opencode_args_separates_prompt_and_selects_session() -> None:
+    """
+    思考を表示するため常に `--thinking` を付け、プロンプトは `--` の後ろへ置く（`-` で始まる指示も解釈させない）。
+    会話 ID が分かっていれば `--session`、分からなければ `--continue` で続きを指定する。
+    """
+    assert build_opencode_args("ファイル一覧を教えて") == ["run", "--format", "json", "--thinking", "--", "ファイル一覧を教えて"]
+    assert build_opencode_args("-h の意味は？") == ["run", "--format", "json", "--thinking", "--", "-h の意味は？"]
+    assert build_opencode_args("続き", session_id="ses_123") == [
+        "run", "--format", "json", "--thinking", "--session", "ses_123", "--", "続き",
+    ]
+    assert build_opencode_args("続き", continue_session=True) == [
+        "run", "--format", "json", "--thinking", "--continue", "--", "続き",
+    ]
+
+
+def test_build_opencode_args_adds_model_plan_and_auto_approve() -> None:
+    """モデル指定は `--model`、Plan モードは `--agent plan`、自動承認は `--auto` を付ける。Build（既定）は付けない。"""
+    assert build_opencode_args(
+        "直して", session_id="ses_1", model="anthropic/claude-opus-5-5", plan_mode=True, auto_approve=True,
+    ) == [
+        "run", "--format", "json", "--thinking",
+        "--model", "anthropic/claude-opus-5-5", "--agent", "plan", "--auto",
+        "--session", "ses_1", "--", "直して",
+    ]
+    assert build_opencode_args("直して", model="  ", plan_mode=False) == ["run", "--format", "json", "--thinking", "--", "直して"]
+
+
+def test_strip_ansi_codes_removes_escape_sequences() -> None:
+    """CLI出力に含まれるANSIカラーコードや制御シーケンスを除去する。"""
+    raw = "\x1b[32m✓\x1b[0m 完了しました \x1b[1;34m[opencode]\x1b[0m\r\n次の行"
+    assert strip_ansi_codes(raw) == "✓ 完了しました [opencode]\n次の行"
+
+
+def test_extract_session_id_reads_session_from_any_event() -> None:
+    """NDJSON イベントの sessionID を取り出し、JSON でない行や ID のない行は None を返す。"""
+    assert extract_session_id('{"type":"error","sessionID":"ses_e42","error":{}}') == "ses_e42"
+    assert extract_session_id('{"type":"step_start"}') is None
+    assert extract_session_id("plain text") is None
+
+
+def test_session_requires_existing_working_dir_and_never_falls_back() -> None:
+    """
+    作業フォルダが未設定・存在しないときは opencode を起動せずエラーにする。
+    ランチャー自身のフォルダなど別の場所でエージェントを動かさない。
+    """
+    runner = FakeRunner()
+    unset = OpenCodeSession("", runner=runner, dir_exists=lambda path: True)
+    with pytest.raises(OpenCodeError, match="未設定"):
+        unset.send("質問")
+
+    missing = OpenCodeSession(r"D:\missing", runner=runner, dir_exists=lambda path: False)
+    with pytest.raises(OpenCodeError, match=r"見つかりません: D:\\missing"):
+        missing.send("質問")
+    assert runner.calls == []
+
+
+def test_session_streams_chat_entries_and_continues_with_captured_session_id() -> None:
+    """
+    1 回目は新規会話。指示と応答をチャットの吹き出しとして並べ、届くたびに on_update で知らせる。
+    出力に含まれた sessionID を覚え、2 回目以降は `--session` で同じ会話を続ける。
+    """
+    runner = FakeRunner([
+        ([text_event("前半"), text_event("後半")], OpenCodeRunResult(0)),
+        ([text_event("2回目の応答")], OpenCodeRunResult(0)),
+    ])
+    session = make_session(runner)
+    snapshots: list[list[tuple[str, str]]] = []
+
+    assert session.send("最初の質問", on_update=lambda: snapshots.append(kinds_and_texts(session))) is True
+
+    assert runner.calls[-1] == (r"C:\work", ["run", "--format", "json", "--thinking", "--", "最初の質問"])
+    assert kinds_and_texts(session) == [("user", "最初の質問"), ("text", "前半"), ("text", "後半")]
+    assert [("user", "最初の質問"), ("text", "前半")] in snapshots  # 途中経過を知らせる
+    assert session.session_id == "ses_A"
+    assert session.continue_session is True
+
+    session.send("2回目の質問")
+    assert runner.calls[-1][1] == ["run", "--format", "json", "--thinking", "--session", "ses_A", "--", "2回目の質問"]
+    assert kinds_and_texts(session)[-2:] == [("user", "2回目の質問"), ("text", "2回目の応答")]
+    assert session.history.items == ["最初の質問", "2回目の質問"]
+
+
+def test_session_passes_model_plan_and_auto_options() -> None:
+    """ペインで選んだモデル・Plan モード・自動承認を opencode へ渡す。"""
+    runner = FakeRunner()
+    session = make_session(runner)
+    session.model = "opencode/big-pickle"
+    session.plan_mode = True
+    session.auto_approve = True
+
+    session.send("計画して")
+
+    assert runner.calls[-1][1] == [
+        "run", "--format", "json", "--thinking", "--model", "opencode/big-pickle", "--agent", "plan", "--auto", "--", "計画して",
+    ]
+
+
+def test_session_falls_back_to_continue_without_session_id_and_resets() -> None:
+    """
+    sessionID が取れなかった成功時は `--continue` で続ける。
+    作業フォルダ変更と reset() は新規会話へ戻し、表示も空にする。
+    """
+    runner = FakeRunner([
+        (["プレーン応答"], OpenCodeRunResult(0)),
+        (["続き"], OpenCodeRunResult(0)),
+        (["別フォルダ"], OpenCodeRunResult(0)),
+    ])
+    session = make_session(runner)
+
+    session.send("1")
+    session.send("2")
+    assert runner.calls[-1][1] == ["run", "--format", "json", "--thinking", "--continue", "--", "2"]
+
+    session.set_working_dir(r"D:\other")
+    assert session.continue_session is False
+    session.send("3")
+    assert runner.calls[-1] == (r"D:\other", ["run", "--format", "json", "--thinking", "--", "3"])
+
+    session.reset()
+    assert session.continue_session is False
+    assert session.session_id is None
+    assert session.transcript.entries == []
+
+
+def test_session_reports_failure_timeout_and_empty_output_as_notices() -> None:
+    """失敗・タイムアウト・応答なしは、理由をお知らせ行で表示する。失敗した実行は会話継続の起点にしない。"""
+    runner = FakeRunner([
+        ([], OpenCodeRunResult(1, stderr="認証が必要です")),
+        ([], OpenCodeRunResult(-9, timed_out=True)),
+        ([], OpenCodeRunResult(0)),
+    ])
+    session = make_session(runner)
+
+    session.send("失敗")
+    assert kinds_and_texts(session)[-1] == ("notice", "opencode 実行失敗（exit 1）: 認証が必要です")
+    assert session.transcript.entries[-1].status == "error"
+    assert session.continue_session is False
+
+    session.send("時間切れ")
+    assert kinds_and_texts(session)[-1] == ("notice", "タイムアウトしたため停止しました")
+
+    session.send("空")
+    assert kinds_and_texts(session)[-1] == ("notice", "（応答なし）")
+
+
+def test_session_status_text_shows_elapsed_and_finish_time() -> None:
+    """実行中は「作業中… 経過秒」、終わったら「完了（かかった秒）」を表示する。"""
+    clock = [100.0]
+
+    class SlowRunner(FakeRunner):
+        def run(self, working_dir: str, args: list[str], on_line: Callable[[str], None]) -> OpenCodeRunResult:
+            clock[0] += 2.0
+            return super().run(working_dir, args, on_line)
+
+    session = make_session(SlowRunner([([text_event("ok")], OpenCodeRunResult(0))]), clock=lambda: clock[0])
+    assert session.status_text() == ""
+
+    session.send("質問")
+
+    assert session.status_text() == "完了（2.0秒）"
+
+
+class BlockingRunner(FakeRunner):
+    """1 回目の実行だけ、release されるまで終わらないランナー。"""
+
+    def __init__(self, *args: object, **kwargs: object) -> None:
+        super().__init__(*args, **kwargs)  # type: ignore[arg-type]
+        self.entered = threading.Event()
+        self.release = threading.Event()
+
+    def run(self, working_dir: str, args: list[str], on_line: Callable[[str], None]) -> OpenCodeRunResult:
+        if not self.entered.is_set():
+            self.entered.set()
+            self.release.wait(5)
+            if self.cancel_count:
+                self.calls.append((working_dir, list(args)))
+                return OpenCodeRunResult(-1, cancelled=True)
+        return super().run(working_dir, args, on_line)
+
+
+def test_send_while_running_queues_and_runs_after_current() -> None:
+    """実行中に送った指示は待ち行列へ入れ、今の実行が終わったら順に送る。同時に 2 つは走らせない。"""
+    runner = BlockingRunner()
+    clock = [10.0]
+    session = make_session(runner, clock=lambda: clock[0])
+    worker = threading.Thread(target=session.send, args=("長い処理",))
+    worker.start()
+    assert runner.entered.wait(5)
+    assert session.is_running is True
+
+    assert session.send("次の指示") is True
+    clock[0] += 12.0
+    assert session.queue == ["次の指示"]
+    assert session.status_text() == "作業中… 12秒 · 待機 1件"
+    runner.release.set()
+    worker.join(5)
+
+    assert not worker.is_alive()
+    assert [args[-1] for _, args in runner.calls] == ["長い処理", "次の指示"]
+    assert session.queue == []
+    assert [text for kind, text in kinds_and_texts(session) if kind == "user"] == ["長い処理", "次の指示"]
+    assert session.is_running is False
+
+
+def test_cancel_stops_current_run_and_clears_queue() -> None:
+    """停止は実行中の opencode を止め、待ち行列も捨てる。"""
+    runner = BlockingRunner()
+    session = make_session(runner)
+    worker = threading.Thread(target=session.send, args=("長い処理",))
+    worker.start()
+    assert runner.entered.wait(5)
+    session.send("待機中の指示")
+
+    session.cancel()
+    runner.release.set()
+    worker.join(5)
+
+    assert runner.cancel_count == 1
+    assert len(runner.calls) == 1
+    assert session.queue == []
+    assert kinds_and_texts(session)[-1] == ("notice", "中断しました")
+    assert session.is_running is False
+
+
+def test_list_sessions_resume_and_list_models() -> None:
+    """会話一覧から過去の会話を読み込み、その会話 ID で続ける。モデル一覧も取得できる。"""
+    export = {
+        "info": {"id": "ses_old", "title": "前の会話"},
+        "messages": [
+            {"id": "m1", "type": "user", "text": "前の質問"},
+            {"id": "m2", "type": "assistant", "content": [{"type": "text", "text": "前の応答"}]},
+        ],
+    }
+    runner = FakeRunner(captures={
+        ("session", "list", "--format", "json", "-n", "20"): OpenCodeCaptureResult(
+            0, '[{"id":"ses_old","title":"前の会話","updated":5}]', ""
+        ),
+        ("session", "export", "ses_old"): OpenCodeCaptureResult(0, json.dumps(export), ""),
+        ("models",): OpenCodeCaptureResult(0, "opencode/big-pickle\nanthropic/claude-opus-5-5\n", ""),
+    })
+    session = make_session(runner)
+
+    sessions = session.list_sessions()
+    assert [(item.id, item.title) for item in sessions] == [("ses_old", "前の会話")]
+    assert runner.capture_calls[-1][0] == r"C:\work"
+
+    session.resume("ses_old")
+    assert kinds_and_texts(session) == [("user", "前の質問"), ("text", "前の応答")]
+    assert session.session_id == "ses_old"
+    assert session.continue_session is True
+
+    session.send("続きの質問")
+    assert runner.calls[-1][1][-4:] == ["--session", "ses_old", "--", "続きの質問"]
+
+    assert session.list_models() == ["opencode/big-pickle", "anthropic/claude-opus-5-5"]
+
+
+def test_resume_failure_keeps_current_conversation() -> None:
+    """会話を読み込めなかったときは今の会話を残し、理由をエラーで知らせる。"""
+    runner = FakeRunner([([text_event("今の応答")], OpenCodeRunResult(0))])
+    session = make_session(runner)
+    session.send("今の質問")
+
+    with pytest.raises(OpenCodeError, match="会話を読み込めません"):
+        session.resume("ses_missing")
+
+    assert kinds_and_texts(session) == [("user", "今の質問"), ("text", "今の応答")]
+    assert session.session_id == "ses_A"
+    assert session.list_models() == []
+
+
+def test_resolve_opencode_executable_never_returns_cmd_wrapper_on_windows(tmp_path) -> None:
+    """
+    Windows では cmd.exe を経由する opencode.cmd を使わず、ネイティブの opencode.exe だけを返す。
+    （cmd.exe は `&` や `|` を含む指示を別コマンドとして解釈するため）
+    """
+    appdata = tmp_path / "AppData"
+    (appdata / "npm").mkdir(parents=True)
+    (appdata / "npm" / "opencode.cmd").write_text("@echo off", encoding="utf-8")
+
+    assert resolve_opencode_executable(appdata=str(appdata), which=lambda name: None, is_windows=True) is None
+
+    native = appdata / "npm" / "node_modules" / "@opencode" / "cli" / "bin" / "opencode.exe"
+    native.parent.mkdir(parents=True)
+    native.write_bytes(b"")
+    assert resolve_opencode_executable(appdata=str(appdata), which=lambda name: None, is_windows=True) == str(native)
+
+    on_path = resolve_opencode_executable(
+        appdata="", which=lambda name: r"C:\bin\opencode.exe" if name == "opencode.exe" else None, is_windows=True
+    )
+    assert on_path == r"C:\bin\opencode.exe"
+    assert resolve_opencode_executable(appdata="", which=lambda name: "/usr/local/bin/opencode", is_windows=False) == (
+        "/usr/local/bin/opencode"
+    )
+
+
+def _python_runner(script: str, **kwargs: object) -> tuple[SubprocessOpenCodeRunner, list[str]]:
+    """opencode の代わりに Python スクリプトを起動するランナーを作る。"""
+    runner = SubprocessOpenCodeRunner(executable_resolver=lambda: sys.executable, warm_up=lambda executable: None, **kwargs)  # type: ignore[arg-type]
+    return runner, ["-c", script]
+
+
+def test_subprocess_runner_does_not_hang_when_stderr_is_large(tmp_path) -> None:
+    """
+    標準エラーへ大量に書く opencode でも、標準出力と並行して読み、待ち合わせで止まらない。
+    """
+    script = "import sys\nsys.stderr.write('e' * 200000)\nsys.stderr.flush()\nprint('{\"type\":\"text\",\"part\":{\"text\":\"done\"}}', flush=True)\n"
+    runner, args = _python_runner(script, timeout_seconds=20)
+    lines: list[str] = []
+    result: list[OpenCodeRunResult] = []
+
+    worker = threading.Thread(target=lambda: result.append(runner.run(str(tmp_path), args, lines.append)))
+    worker.start()
+    worker.join(15)
+
+    assert not worker.is_alive(), "標準エラーの読み残しでハングした"
+    assert result[0].returncode == 0
+    assert len(result[0].stderr) == 200000
+    assert any("done" in line for line in lines)
+
+
+def test_subprocess_runner_kills_process_after_timeout(tmp_path) -> None:
+    """応答が返らない opencode はタイムアウトで止め、その旨を返す。"""
+    runner, args = _python_runner("import time\ntime.sleep(30)\n", timeout_seconds=0.5)
+
+    result = runner.run(str(tmp_path), args, lambda line: None)
+
+    assert result.returncode != 0
+    assert result.timed_out is True
+
+
+def test_subprocess_runner_cancel_stops_running_process(tmp_path) -> None:
+    """cancel() で実行中の opencode を止める。"""
+    runner, args = _python_runner("import time\nprint('start', flush=True)\ntime.sleep(30)\n", timeout_seconds=60)
+    started = threading.Event()
+    result: list[OpenCodeRunResult] = []
+
+    def on_line(line: str) -> None:
+        started.set()
+
+    worker = threading.Thread(target=lambda: result.append(runner.run(str(tmp_path), args, on_line)))
+    worker.start()
+    assert started.wait(10)
+    runner.cancel()
+    worker.join(10)
+
+    assert not worker.is_alive()
+    assert result[0].cancelled is True
+
+
+def test_subprocess_runner_run_sets_pwd_to_working_dir(tmp_path, monkeypatch) -> None:
+    """
+    起動元の PWD が残ったままだと、opencode が cwd ではなく PWD を作業フォルダと見なす（backend で動いてしまう）。
+    run は cwd と同じ値を PWD にも渡す。
+    """
+    monkeypatch.setenv("PWD", "/somewhere/else")
+    runner, args = _python_runner("import os\nprint(os.environ.get('PWD'), os.getcwd(), flush=True)\n", timeout_seconds=20)
+    lines: list[str] = []
+
+    runner.run(str(tmp_path), args, lines.append)
+
+    pwd, cwd = "".join(lines).split()
+    assert pwd == str(tmp_path)
+    assert os.path.realpath(cwd) == os.path.realpath(str(tmp_path))
+
+
+def test_subprocess_runner_capture_sets_pwd_to_working_dir(tmp_path, monkeypatch) -> None:
+    """会話一覧などの短い問い合わせ（capture）も、PWD を作業フォルダに合わせる。"""
+    monkeypatch.setenv("PWD", "/somewhere/else")
+    runner, args = _python_runner("import os\nprint(os.environ.get('PWD'))\n", timeout_seconds=20)
+
+    result = runner.capture(str(tmp_path), args)
+
+    assert result.stdout.strip() == str(tmp_path)
+
+
+def test_subprocess_runner_reports_missing_executable(tmp_path) -> None:
+    """opencode.exe が見つからないときは分かる文言で知らせる。"""
+    runner = SubprocessOpenCodeRunner(executable_resolver=lambda: None, warm_up=lambda executable: None)
+
+    with pytest.raises(OpenCodeError, match="opencode が見つかりません"):
+        runner.run(str(tmp_path), ["run"], lambda line: None)
+
+
+def test_subprocess_runner_capture_returns_stdout(tmp_path) -> None:
+    """会話一覧などの短い問い合わせは、標準出力をまとめて受け取る。"""
+    runner, args = _python_runner("print('[]')", timeout_seconds=20)
+
+    result = runner.capture(str(tmp_path), args)
+
+    assert result.returncode == 0
+    assert result.stdout.strip() == "[]"
+
+
+def test_session_expands_registered_slash_command() -> None:
+    """
+    登録したスラッシュコマンド（/pass gmail）は展開したプロンプトを opencode へ送り、
+    吹き出しと指示の履歴には打った「/pass gmail」をそのまま残す。登録の無い /… はそのまま送る。
+    """
+    from launcher_app.slash_commands import SlashCommand
+
+    runner = FakeRunner()
+    session = make_session(runner)
+    session.slash_commands = [SlashCommand("pass", "パスワード表から $ARGUMENTS のパスワードを探して")]
+
+    session.send("/pass gmail")
+    session.send("/usr/bin を調べて")
+
+    assert [args[-1] for _, args in runner.calls] == ["パスワード表から gmail のパスワードを探して", "/usr/bin を調べて"]
+    assert [text for kind, text in kinds_and_texts(session) if kind == "user"] == ["/pass gmail", "/usr/bin を調べて"]
+    assert session.history.items == ["/pass gmail", "/usr/bin を調べて"]
diff --git a/launcher/tests/test_opencode_view.py b/launcher/tests/test_opencode_view.py
new file mode 100644
index 0000000000000000000000000000000000000000..3abcae20bd0f39426314621e70e27362eb4f3ec9
--- /dev/null
+++ b/launcher/tests/test_opencode_view.py
@@ -0,0 +1,111 @@
+"""
+macOS 版 OpenCode ペインのチャット表示（NSTextView へ流し込む「文字列＋書式＋リンク」の並び）を検証する。
+AppKit に依存しない部分なので、macOS 以外でも実行できる。
+"""
+
+from launcher_app.opencode_chat import ChatTranscript
+from launcher_app.ui.opencode_view import EMPTY_HINT, Segment, render_chat
+
+
+def joined(segments: list[Segment]) -> str:
+    """表示される文字列全体。"""
+    return "".join(segment.text for segment in segments)
+
+
+def build_transcript() -> ChatTranscript:
+    """指示 → 思考 → ツール → 応答 の 1 往復を持つ会話。"""
+    transcript = ChatTranscript()
+    transcript.add_user("テストを流して")
+    transcript.apply_event({"type": "reasoning", "part": {
+        "id": "r1", "type": "reasoning", "text": "npm test を使う", "time": {"start": 0, "end": 1200},
+    }})
+    transcript.apply_event({"type": "tool_use", "part": {
+        "id": "t1", "type": "tool", "tool": "bash",
+        "state": {"status": "completed", "input": {"command": "npm test"}, "output": "253 passed"},
+    }})
+    transcript.apply_event({"type": "text", "part": {"id": "x1", "type": "text", "text": "**全件**成功です\n```\n253 passed\n```"}})
+    return transcript
+
+
+def test_empty_transcript_shows_hint() -> None:
+    """会話が空のときは操作の案内を出す。"""
+    segments = render_chat(ChatTranscript())
+
+    assert joined(segments) == EMPTY_HINT
+    assert "Enter で送信" in EMPTY_HINT and "Shift+Enter で改行" in EMPTY_HINT
+
+
+def test_user_and_assistant_bubbles_have_labels_and_styles() -> None:
+    """自分の指示と opencode の応答を、見出し付きの別の書式（吹き出し）で表示する。"""
+    segments = render_chat(build_transcript())
+
+    styles = {segment.style for segment in segments}
+    assert {"user_label", "user", "assistant_label", "bold", "code"} <= styles
+    user = next(segment for segment in segments if segment.style == "user")
+    assert user.text.strip() == "テストを流して"
+    assert next(segment for segment in segments if segment.style == "bold").text == "全件"
+    assert next(segment for segment in segments if segment.style == "code").text.strip() == "253 passed"
+    # 応答の見出しは 1 往復に 1 回だけ
+    assert [segment.style for segment in segments].count("assistant_label") == 1
+
+
+def test_reasoning_and_tool_are_collapsed_with_toggle_links() -> None:
+    """思考とツールは見出しだけを出して折りたたみ、見出しのリンクで開閉する。"""
+    segments = render_chat(build_transcript())
+    text = joined(segments)
+
+    assert "▸ 思考（1.2秒）" in text
+    assert "▸ ✓ bash  npm test" in text
+    assert "npm test を使う" not in text  # 思考の本文は閉じている
+    assert "253 passed\n" in text  # 応答本文のコードブロックだけが見える
+    links = [segment.link for segment in segments if segment.link]
+    assert "toggle:r1" in links and "toggle:t1" in links
+
+
+def test_expanded_tool_shows_input_and_output() -> None:
+    """開いたツールは入力と出力を表示する。"""
+    transcript = build_transcript()
+    transcript.toggle("t1")
+    transcript.toggle("r1")
+
+    text = joined(render_chat(transcript))
+
+    assert "▾ ✓ bash  npm test" in text
+    assert '"command": "npm test"' in text
+    assert "npm test を使う" in text
+
+
+def test_assistant_text_has_copy_link() -> None:
+    """応答の吹き出しごとにコピーのリンクを付ける。"""
+    segments = render_chat(build_transcript())
+
+    copy = [segment for segment in segments if segment.link == "copy:x1"]
+    assert len(copy) == 1 and copy[0].text == "コピー"
+
+
+def test_notices_and_errors() -> None:
+    """中断などの通知と、エラーを区別して表示する。"""
+    transcript = ChatTranscript()
+    transcript.add_notice("中断しました")
+    transcript.add_notice("認証が必要です", error=True)
+
+    segments = render_chat(transcript)
+
+    assert [(segment.style, segment.text) for segment in segments] == [
+        ("notice", "— 中断しました —\n"),
+        ("error", "⚠ 認証が必要です\n"),
+    ]
+
+
+def test_markdown_lists_and_headings_are_rendered_with_prefixes() -> None:
+    """箇条書きは「• 」、番号付きは「1. 」、見出しは見出し用の書式で表示する。"""
+    transcript = ChatTranscript()
+    transcript.apply_event({"type": "text", "part": {"id": "x", "type": "text", "text": "# まとめ\n- 一つ目\n  - 詳細\n3. 三番"}})
+
+    segments = render_chat(transcript)
+    text = joined(segments)
+
+    assert next(segment for segment in segments if segment.style == "heading").text == "まとめ\n"
+    assert "• 一つ目\n" in text
+    assert "    • 詳細\n" in text
+    assert "3. 三番\n" in text
diff --git a/launcher/tests/test_scratchpad_autosave.py b/launcher/tests/test_scratchpad_autosave.py
new file mode 100644
index 0000000000000000000000000000000000000000..c697c014d5fad17b0908a7efeb258af869459d9a
--- /dev/null
+++ b/launcher/tests/test_scratchpad_autosave.py
@@ -0,0 +1,103 @@
+"""
+常時保持メモ（Scratchpad）の自動保存が、入力の取りこぼしや二重保存なくバックエンドへ届くことを検証する。
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from launcher_app.scratchpad import ScratchpadAutosave
+
+
+class FakeTimer:
+    """threading.Timer の代わりに、テストから明示的に発火させるタイマー。"""
+
+    created: list["FakeTimer"] = []
+
+    def __init__(self, interval: float, function: Any) -> None:
+        self.interval = interval
+        self.function = function
+        self.cancelled = False
+        self.daemon = False
+        FakeTimer.created.append(self)
+
+    def start(self) -> None:
+        return None
+
+    def cancel(self) -> None:
+        self.cancelled = True
+
+    def fire(self) -> None:
+        if not self.cancelled:
+            self.function()
+
+
+def make_autosave(save: Any) -> tuple[ScratchpadAutosave, list[str]]:
+    FakeTimer.created = []
+    statuses: list[str] = []
+    autosave = ScratchpadAutosave(save, delay=0.6, timer_factory=FakeTimer, on_status=statuses.append)
+    return autosave, statuses
+
+
+def test_load_does_not_mark_dirty_and_update_debounces_save() -> None:
+    """読み込んだメモは保存せず、入力は最後のタイマーだけが保存する。"""
+    saved: list[str] = []
+    autosave, statuses = make_autosave(saved.append)
+
+    autosave.load("サーバーのメモ")
+    assert autosave.text == "サーバーのメモ"
+    assert autosave.dirty is False
+    assert autosave.flush() is True
+    assert saved == []
+
+    autosave.update("a")
+    autosave.update("ab")
+    assert FakeTimer.created[0].cancelled is True
+    FakeTimer.created[-1].fire()
+
+    assert saved == ["ab"]
+    assert autosave.dirty is False
+    assert statuses[-1] == "保存済み"
+
+
+def test_edit_during_save_is_not_lost() -> None:
+    """保存の通信中に入力した内容は、次の保存で必ずバックエンドへ届く。"""
+    saved: list[str] = []
+    autosave_ref: list[ScratchpadAutosave] = []
+
+    def slow_save(text: str) -> None:
+        saved.append(text)
+        if len(saved) == 1:
+            # 1 回目の保存の通信中に利用者が追記する
+            autosave_ref[0].update("1行目\n2行目")
+
+    autosave, _ = make_autosave(slow_save)
+    autosave_ref.append(autosave)
+
+    autosave.update("1行目")
+    FakeTimer.created[0].fire()
+
+    assert saved == ["1行目"]
+    assert autosave.dirty is True
+    FakeTimer.created[-1].fire()
+    assert saved == ["1行目", "1行目\n2行目"]
+    assert autosave.dirty is False
+
+
+def test_failed_save_stays_dirty_and_reports_error() -> None:
+    """保存に失敗したら未保存のまま残し、次の flush で再送する。"""
+    attempts: list[str] = []
+
+    def flaky_save(text: str) -> None:
+        attempts.append(text)
+        if len(attempts) == 1:
+            raise OSError("接続できません")
+
+    autosave, statuses = make_autosave(flaky_save)
+    autosave.update("メモ")
+
+    assert autosave.flush() is False
+    assert autosave.dirty is True
+    assert statuses[-1] == "保存失敗: 接続できません"
+    assert autosave.flush() is True
+    assert attempts == ["メモ", "メモ"]
diff --git a/launcher/tests/test_slash_commands.py b/launcher/tests/test_slash_commands.py
new file mode 100644
index 0000000000000000000000000000000000000000..5f7691dc801a7cfadd44e10d92297507040b15ae
--- /dev/null
+++ b/launcher/tests/test_slash_commands.py
@@ -0,0 +1,137 @@
+"""
+OpenCode ペインのスラッシュコマンド（このアプリ独自の定型作業。/pass など）の展開・入力チェック・補完を検証する。
+Obsidian（Claudian）と同じく、/ で候補を出し、上下で選び、Tab / Enter で確定、Esc で閉じる。
+"""
+
+from launcher_app.slash_commands import (
+    SlashCommand,
+    SlashSuggestions,
+    apply_completion,
+    completion_words,
+    expand_slash_command,
+    find_candidates,
+    parse_commands,
+    slash_query,
+    validate_command,
+)
+
+PASS = SlashCommand("pass", "パスワード表 C:\\secret\\pw.xlsx から $ARGUMENTS のパスワードを探して", "パスワード取得")
+PASTE = SlashCommand("paste", "クリップボードを整形して")
+DAILY = SlashCommand("daily", "今日の作業をまとめて")
+REPORT = SlashCommand("report-pass", "合格者を報告して")
+COMMANDS = [PASS, PASTE, DAILY, REPORT]
+
+
+def test_expand_replaces_arguments_placeholder() -> None:
+    """/pass gmail は $ARGUMENTS を gmail に置き換えたプロンプトになる（名前は大文字小文字を区別しない）。"""
+    assert expand_slash_command("/pass gmail", COMMANDS) == "パスワード表 C:\\secret\\pw.xlsx から gmail のパスワードを探して"
+    assert expand_slash_command("/PASS  gmail ", COMMANDS) == "パスワード表 C:\\secret\\pw.xlsx から gmail のパスワードを探して"
+    assert expand_slash_command("/pass", COMMANDS) == "パスワード表 C:\\secret\\pw.xlsx から  のパスワードを探して"
+
+
+def test_expand_appends_arguments_without_placeholder() -> None:
+    """$ARGUMENTS が無いコマンドは、後ろの文字（改行を含む）を空行のあとへ足す。"""
+    assert expand_slash_command("/daily", COMMANDS) == "今日の作業をまとめて"
+    assert expand_slash_command("/daily 午後は会議\n夜は資料", COMMANDS) == "今日の作業をまとめて\n\n午後は会議\n夜は資料"
+
+
+def test_unregistered_or_non_command_text_is_not_expanded() -> None:
+    """登録されていない名前・パス（/usr/bin など）・途中の / は展開しない（そのまま opencode へ送る）。"""
+    assert expand_slash_command("/unknown x", COMMANDS) is None
+    assert expand_slash_command("/usr/bin を調べて", COMMANDS) is None
+    assert expand_slash_command("pass gmail", COMMANDS) is None
+    assert expand_slash_command("", COMMANDS) is None
+
+
+def test_validate_command_for_registration() -> None:
+    """登録画面の入力チェック。先頭の / は付けても付けなくてもよい。"""
+    assert validate_command("", "x", []) == "コマンド名を入力してください"
+    assert validate_command("two words", "x", []) == "コマンド名に空白や / は使えません"
+    assert validate_command("a/b", "x", []) == "コマンド名に空白や / は使えません"
+    assert validate_command("/pass", "x", ["PASS"]) == "/pass はすでに登録されています"
+    assert validate_command("pass", "  ", []) == "プロンプトを入力してください"
+    assert validate_command("/pass", "x", ["daily"]) is None
+
+
+def test_parse_commands_from_api_payload() -> None:
+    """API の {"commands": [...]} から読み、壊れた項目は飛ばす。"""
+    payload = {"commands": [{"name": "pass", "prompt": "p", "description": "d"}, {"name": "x"}, "bad"]}
+
+    assert parse_commands(payload) == [SlashCommand("pass", "p", "d")]
+    assert parse_commands(None) == []
+
+
+def test_slash_query_only_while_typing_the_first_token() -> None:
+    """先頭が / で、カーソルが最初の語の中にあるときだけ補完の検索語を返す。"""
+    assert slash_query("/p", 2) == "p"
+    assert slash_query("/", 1) == ""
+    assert slash_query("/pa extra", 3) == "pa"
+    assert slash_query("/pa extra", 6) is None
+    assert slash_query("a/p", 3) is None
+    assert slash_query("/p", 0) is None
+
+
+def test_find_candidates_prefix_first_then_contains() -> None:
+    """前方一致を名前順に先に、その後ろに途中一致を並べる。空なら全件（名前順）。"""
+    assert [c.name for c in find_candidates(COMMANDS, "pa")] == ["pass", "paste", "report-pass"]
+    assert [c.name for c in find_candidates(COMMANDS, "PAS")] == ["pass", "paste", "report-pass"]
+    assert [c.name for c in find_candidates(COMMANDS, "")] == ["daily", "pass", "paste", "report-pass"]
+    assert find_candidates(COMMANDS, "zzz") == []
+
+
+def test_apply_completion_replaces_first_token() -> None:
+    """補完は最初の語を「/名前 」に置き換え、カーソルを空白の後ろへ置く。後ろの文字は残す。"""
+    assert apply_completion("/p", 2, "pass") == ("/pass ", 6)
+    assert apply_completion("/pa gmail", 3, "pass") == ("/pass gmail", 6)
+
+
+def test_completion_words_for_native_completion() -> None:
+    """macOS の標準補完へ渡す候補。補完範囲に / が含まれるかどうかに合わせる。"""
+    assert completion_words("p", COMMANDS) == ["pass", "paste", "report-pass"]
+    assert completion_words("/p", COMMANDS) == ["/pass", "/paste", "/report-pass"]
+
+
+def test_suggestions_open_while_typing_and_move_with_wrap() -> None:
+    """/ を打つと候補が開き、上下で選択が回る。候補が無い・最初の語を出たら閉じる。"""
+    state = SlashSuggestions()
+    state.refresh("/pa", 3, COMMANDS)
+    assert state.is_open and [c.name for c in state.items] == ["pass", "paste", "report-pass"]
+    assert state.selected == PASS
+    state.move(1)
+    assert state.selected == PASTE
+    state.move(-2)
+    assert state.selected == REPORT
+
+    state.refresh("/zzz", 4, COMMANDS)
+    assert not state.is_open
+    state.refresh("/pass gmail", 11, COMMANDS)
+    assert not state.is_open
+
+
+def test_suggestions_accept_and_dismiss() -> None:
+    """確定で補完して閉じる。Esc で閉じたら、文字が変わるまで開かない。"""
+    state = SlashSuggestions()
+    state.refresh("/pa", 3, COMMANDS)
+    state.move(1)
+    assert state.accept("/pa", 3) == ("/paste ", 7)
+    assert not state.is_open
+
+    state.refresh("/p", 2, COMMANDS)
+    state.dismiss()
+    state.refresh("/p", 2, COMMANDS)
+    assert not state.is_open
+    state.refresh("/pa", 3, COMMANDS)
+    assert state.is_open
+
+
+def test_tab_completes_single_candidate_or_opens_list() -> None:
+    """Tab: 候補が 1 つならそのまま補完（/d → /daily）、複数なら候補を開く、開いていれば選択中を確定。"""
+    state = SlashSuggestions()
+    assert state.complete_on_tab("/d", 2, COMMANDS) == ("/daily ", 7)
+
+    state.refresh("/p", 2, COMMANDS)
+    state.dismiss()
+    assert state.complete_on_tab("/p", 2, COMMANDS) is None
+    assert state.is_open
+    assert state.complete_on_tab("/p", 2, COMMANDS) == ("/pass ", 6)
+    assert state.complete_on_tab("hello", 5, COMMANDS) is None
diff --git a/launcher/vendor/flet-view/README.md b/launcher/vendor/flet-view/README.md
deleted file mode 100644
index 9679d51b55b1c92ab3ee0bf2b01cfcba46f7e81a..0000000000000000000000000000000000000000
--- a/launcher/vendor/flet-view/README.md
+++ /dev/null
@@ -1,22 +0,0 @@
-<!--
-Flet の Windows/Linux デスクトップクライアントをオフライン配布するための配置場所。
--->
-
-# Flet View オフライン配置
-
-Windows の `start_windows.bat` は完全オフライン起動を前提に、ここへ配置された Flet View を使います。
-
-配置方法はどちらか一方です。
-
-1. 展開済みディレクトリを置く
-   - Windows: `launcher/vendor/flet-view/windows/flet.exe`
-   - Linux: `launcher/vendor/flet-view/linux/flet`
-2. アーカイブを置く
-   - Windows: `launcher/vendor/flet-view/flet-view-windows.zip`
-   - Linux: `launcher/vendor/flet-view/flet-view-linux.tar.gz`
-
-アーカイブ配置の場合、初回起動時に `launcher/.offline_cache/flet-view/` へ展開され、`FLET_VIEW_PATH` が自動設定されます。
-
-このリポジトリでは Flet を `0.84.0` に固定しています。Windows では Flet の GitHub Releases から `v0.84.0` の `flet-windows.zip` を取得し、`flet-view-windows.zip` にリネームしてこのディレクトリへ置いてください。
-
-会社のオフライン端末へ持ち込む前に、このディレクトリへ保存してからリポジトリごと配布してください。
