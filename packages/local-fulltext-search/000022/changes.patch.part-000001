+
+
+@router.get("/settings/launcher-slash-commands")
+def get_launcher_slash_commands(service: IndexService = Depends(get_index_service)) -> dict[str, list[dict[str, str]]]:
+    """ランチャーの OpenCode ペインで使う独自スラッシュコマンド（/pass など）の一覧を返す。"""
+    return {"commands": service.get_launcher_slash_commands()}
+
+
+@router.put("/settings/launcher-slash-commands")
+def update_launcher_slash_commands(
+    payload: LauncherSlashCommandsUpdateRequest,
+    service: IndexService = Depends(get_index_service),
+) -> dict[str, list[dict[str, str]]]:
+    """独自スラッシュコマンドの一覧を丸ごと保存し、保存後の一覧を返す（他の設定ファイルには触れない）。"""
+    commands = [command.model_dump() for command in payload.commands]
+    return {"commands": service.save_launcher_slash_commands(commands)}
+
+
 @router.get("/failed-files")
 def get_failed_files(service: IndexService = Depends(get_index_service)) -> dict[str, object]:
     return service.get_failed_files().model_dump()
