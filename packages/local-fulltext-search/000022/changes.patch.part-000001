+def test_app_settings_can_store_opencode_working_dir_and_launcher_memo(tmp_path: Path, monkeypatch) -> None:
+    """
+    ランチャーの opencode 実行フォルダと永続メモは共有設定ファイルへ保存・復元される。
+    """
+    connection = _create_connection(tmp_path)
+    service = IndexService(connection=connection)
+    opencode_dir_path = tmp_path / "opencode_working_dir.txt"
+    launcher_memo_path = tmp_path / "launcher_memo.txt"
+    monkeypatch.setattr(settings, "data_dir", tmp_path)
+    monkeypatch.setattr(settings, "opencode_working_dir_name", "opencode_working_dir.txt")
+    monkeypatch.setattr(settings, "launcher_memo_name", "launcher_memo.txt")
+    default_dir = str(tmp_path / "default_ai_work")
+    monkeypatch.setattr(settings, "opencode_default_working_dir", default_dir)
+
+    initial = service.get_app_settings()
+    assert initial.opencode_working_dir == default_dir
+    assert initial.launcher_memo == ""
+
+    saved_settings = service.update_app_settings(opencode_working_dir=r"  D:\company\ai_workspace  ")
+    saved_memo = service.save_launcher_memo("1行目のメモ\r\n2行目のメモ\n")
+    reloaded = IndexService(connection=connection).get_app_settings()
+
+    assert saved_settings.opencode_working_dir == r"D:\company\ai_workspace"
+    assert reloaded.opencode_working_dir == r"D:\company\ai_workspace"
+    assert opencode_dir_path.read_text(encoding="utf-8") == r"D:\company\ai_workspace"
+    assert saved_memo == "1行目のメモ\n2行目のメモ\n"
+    assert reloaded.launcher_memo == "1行目のメモ\n2行目のメモ\n"
+    assert launcher_memo_path.read_text(encoding="utf-8") == "1行目のメモ\n2行目のメモ\n"
+
+    # 空欄で保存すると設定ファイル側の既定フォルダへ戻る
+    cleared = service.update_app_settings(opencode_working_dir="   ")
+    assert cleared.opencode_working_dir == default_dir
+
+
+def test_general_settings_save_does_not_rewrite_launcher_memo(tmp_path: Path, monkeypatch) -> None:
+    """
+    共有設定の一括保存はランチャーの永続メモを書き戻さない。
+    ランチャーが保存した直後のメモを、Web 画面の設定保存が古い値で上書きしないようにする。
+    """
+    connection = _create_connection(tmp_path)
+    service = IndexService(connection=connection)
+    monkeypatch.setattr(settings, "data_dir", tmp_path)
+    monkeypatch.setattr(settings, "launcher_memo_name", "launcher_memo.txt")
+    memo_path = tmp_path / "launcher_memo.txt"
+
+    service.save_launcher_memo("古いメモ")
+    stale = service.get_app_settings()
+    # ランチャーが別経路でメモを更新した直後に、Web 画面が手元の古い設定で保存する状況
+    service.save_launcher_memo("新しいメモ")
+    service.settings_store.save(stale)
+    service.update_app_settings(gantt_parent=7)
+
+    assert memo_path.read_text(encoding="utf-8") == "新しいメモ"
+    assert service.get_app_settings().launcher_memo == "新しいメモ"
+
+
