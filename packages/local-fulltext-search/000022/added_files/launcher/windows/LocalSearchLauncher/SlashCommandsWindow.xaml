<Window x:Class="LocalSearchLauncher.SlashCommandsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="スラッシュコマンド" Width="720" Height="480" MinWidth="560" MinHeight="380" WindowStartupLocation="CenterOwner"
 Background="#FF0F172A" Foreground="#F8FAFC" ShowInTaskbar="False" Topmost="True" PreviewKeyDown="Window_PreviewKeyDown">
 <!-- OpenCode ペインの独自スラッシュコマンド（/pass など）を登録・編集・削除する画面 -->
 <Grid Margin="14">
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Column="0" Margin="0,0,12,0">
   <TextBlock DockPanel.Dock="Top" Text="登録済み" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
   <Button x:Name="NewButton" DockPanel.Dock="Bottom" Content="＋ 新規" Margin="0,8,0,0" Padding="8,4" Background="#1E293B" Foreground="#93C5FD" BorderBrush="#334155" Click="NewButton_Click"/>
   <ListBox x:Name="CommandList" Background="#CC1E293B" Foreground="#F8FAFC" BorderBrush="#334155" SelectionChanged="CommandList_SelectionChanged"/>
  </DockPanel>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="コマンド名" Foreground="#94A3B8" FontSize="11"/>
   <DockPanel Grid.Row="1" Margin="0,2,0,8">
    <TextBlock DockPanel.Dock="Left" Text="/" FontSize="16" Foreground="#93C5FD" VerticalAlignment="Center" Margin="0,0,4,0"/>
    <TextBox x:Name="NameBox" FontSize="14" Padding="6,4" Background="#CC1E293B" Foreground="#F8FAFC" BorderBrush="#3B82F6" ToolTip="例: pass（空白と / は使えません）"/>
   </DockPanel>
   <TextBlock Grid.Row="2" Text="説明（候補に表示）" Foreground="#94A3B8" FontSize="11"/>
   <TextBox x:Name="DescriptionBox" Grid.Row="3" Margin="0,2,0,8" Padding="6,4" Background="#CC1E293B" Foreground="#F8FAFC" BorderBrush="#334155" ToolTip="例: エクセルからパスワードを取得"/>
   <TextBlock Grid.Row="4" Text="プロンプト（$ARGUMENTS はコマンドの後ろに打った文字に置き換わります）" Foreground="#94A3B8" FontSize="11"/>
   <TextBox x:Name="PromptBox" Grid.Row="5" Margin="0,2,0,6" Padding="6,4" FontSize="13" Background="#CC1E293B" Foreground="#F8FAFC" BorderBrush="#334155" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
            ToolTip="例: C:\work\passwords.xlsx を開いて、$ARGUMENTS のパスワードを探して教えて"/>
   <TextBlock Grid.Row="6" Foreground="#64748B" FontSize="11" TextWrapping="Wrap"
              Text="使い方: 指示欄で /pass gmail と打って送信 → 「$ARGUMENTS」が gmail に置き換わったプロンプトを opencode へ送ります。$ARGUMENTS が無いときは、後ろの文字をプロンプトの末尾に足します。"/>
  </Grid>
  <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button x:Name="DeleteButton" Content="削除" Margin="6,0,0,0" Padding="12,4" Background="#1E293B" Foreground="#FCA5A5" BorderBrush="#334155" Click="DeleteButton_Click"/>
    <Button x:Name="SaveButton" Content="保存" Margin="6,0,0,0" Padding="16,4" Background="#1D4ED8" Foreground="#F8FAFC" BorderBrush="#3B82F6" Click="SaveButton_Click"/>
    <Button Content="閉じる" Margin="6,0,0,0" Padding="12,4" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" Click="CloseButton_Click"/>
   </StackPanel>
   <TextBlock x:Name="StatusText" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
  </DockPanel>
 </Grid>
</Window>
