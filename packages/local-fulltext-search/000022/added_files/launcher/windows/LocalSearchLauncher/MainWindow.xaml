<Window x:Class="LocalSearchLauncher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="1040" Height="940" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
 Background="Transparent" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterScreen"
 PreviewKeyDown="Window_PreviewKeyDown">
 <Border x:Name="WindowSurface" CornerRadius="18" Background="#F20F172A" BorderBrush="#553B82F6" BorderThickness="1" Padding="18">
  <Border.Effect><DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.55" Color="#000000"/></Border.Effect>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border x:Name="WindowDragHandle" Grid.Row="0" Height="22" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="WindowDragHandle_MouseLeftButtonDown">
    <TextBlock Text="Local Search (4-Pane Launcher: Search / OpenCode CLI / Memo / Gantt)" Foreground="#64748B" FontFamily="Inter, Segoe UI" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
   </Border>
   <Grid Grid.Row="1">
    <Grid.RowDefinitions><RowDefinition Height="1.15*"/><RowDefinition Height="0.85*"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>

    <!-- ペイン1（左上）: 検索 -->
    <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" Padding="14" CornerRadius="12" Background="#AA0F172A" BorderBrush="#334155" BorderThickness="1">
     <Grid x:Name="SearchView" Grid.Row="0" Grid.Column="0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="0">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="95"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBox x:Name="QueryBox" FontFamily="Inter, Segoe UI" FontSize="18" Foreground="#F8FAFC" Background="#CC1E293B" BorderBrush="#3B82F6" BorderThickness="1" Padding="10,7" ToolTip="検索語を入力（例: keyword, -.png で除外）" TextChanged="QueryBox_TextChanged"/>
       <TextBox x:Name="ExtensionBox" Grid.Column="1" Margin="6,0,0,0" FontFamily="Inter, Segoe UI" FontSize="12" Foreground="#F8FAFC" Background="#CC1E293B" BorderBrush="#3B82F6" BorderThickness="1" Padding="8,7" ToolTip="拡張子（例: .md, -png）" TextChanged="QueryBox_TextChanged"/>
       <ComboBox x:Name="SearchTypeCombo" Grid.Column="2" Margin="6,0,0,0" Padding="6,4" VerticalAlignment="Center" Foreground="#0F172A" FontSize="11" SelectionChanged="SearchTypeCombo_SelectionChanged">
        <ComboBox.ItemContainerStyle>
         <Style TargetType="ComboBoxItem">
          <Setter Property="Foreground" Value="#0F172A"/>
          <Setter Property="FontWeight" Value="Medium"/>
         </Style>
        </ComboBox.ItemContainerStyle>
        <ComboBoxItem Content="🔀 ハイブリッド" Tag="hybrid" Foreground="#0F172A" IsSelected="True"/>
        <ComboBoxItem Content="🔮 ベクトル" Tag="vector" Foreground="#0F172A"/>
        <ComboBoxItem Content="🏷️ 通常" Tag="keyword" Foreground="#0F172A"/>
       </ComboBox>
       <Button Grid.Column="3" Content="GUI" Margin="6,0,0,0" Padding="10,6" Click="OpenGui_Click"/>
      </Grid>
      <WrapPanel Grid.Row="1" Margin="0,8,0,4" VerticalAlignment="Center">
       <CheckBox x:Name="GanttCheck" Content="gantt" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="0,0,12,0" Click="GanttCheck_Click"/>
       <CheckBox x:Name="UpdateIndexCheck" Content="更新" Foreground="#93C5FD" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="既存結果をすぐ表示し、変更があればバックグラウンドで差分更新します" Click="UpdateIndexCheck_Click"/>
       <CheckBox x:Name="PathInFilenameCheck" Content="フォルダ名も対象" IsChecked="True" Foreground="#E2E8F0" VerticalAlignment="Center" ToolTip="ファイル名検索でフォルダ名も対象にします（例: 「人事 top」で「人事/top.md」）" Click="PathInFilenameCheck_Click"/>
      </WrapPanel>
      <ListBox x:Name="Results" Grid.Row="2" Margin="0,6,0,8" Background="Transparent" BorderThickness="0" Foreground="#E2E8F0" FontFamily="Inter, Segoe UI" FontSize="13" MouseDoubleClick="Results_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,2"/></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><Border Padding="10,7" Background="#991E293B" CornerRadius="8">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <StackPanel Orientation="Horizontal">
          <Image Source="{Binding IconPath}" Width="18" Height="18" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" TextWrapping="Wrap"/>
         </StackPanel>
         <TextBlock Grid.Row="1" Text="{Binding FullPath}" Foreground="#60A5FA" FontSize="11" TextWrapping="Wrap" MaxHeight="28"/>
         <TextBlock Grid.Row="2" Text="{Binding DisplaySnippet}" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" MaxHeight="34"/>
         <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,5,0,0">
          <Button Content="パスをコピー" Margin="3,0" Padding="7,2" Click="CopyPath_Click"/>
          <Button Content="保存場所" Margin="3,2" Padding="7,2" Click="Reveal_Click"><Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsLocal}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
          <Button Content="フォルダを開く" Margin="3,2" Padding="7,2" Click="OpenFolder_Click"><Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsLocal}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
          <Button Content="ganttのリンクを開く" Margin="3,0" Padding="7,2" Click="OpenGanttLink_Click"><Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasGanttLink}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
         </WrapPanel>
        </Grid>
       </Border></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="Status" Grid.Row="3" Foreground="#94A3B8" FontSize="11" Text="Shift × 2 で表示・非表示　Tabで4ペイン移動　Escで閉じる"/>
     </Grid>
    </Border>

    <!-- ペイン2（右上）: OpenCode（Claudian 風チャット: 履歴・新規 / モデル・Plan・自動承認 / 会話 / 作業状況 / 指示 / 使用量・送信） -->
    <Border Grid.Row="0" Grid.Column="1" Margin="8,0,0,8" Padding="14" CornerRadius="12" Background="#AA0F172A" BorderBrush="#334155" BorderThickness="1">
     <Grid x:Name="OpenCodeView" Grid.Row="0" Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="64"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Button x:Name="OpenCodeMenuButton" Content="☰" Margin="0,0,8,0" Padding="9,3" Background="#1E293B" Foreground="#93C5FD" BorderBrush="#334155" BorderThickness="1" ToolTip="メニュー（opencode 実行フォルダの設定）" Click="OpenCodeMenu_Click">
        <Button.ContextMenu><ContextMenu x:Name="OpenCodeMenu"/></Button.ContextMenu>
       </Button>
       <TextBlock Grid.Column="1" Text="OpenCode" Foreground="#F8FAFC" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
       <Button x:Name="OpenCodeCommandsButton" Grid.Column="2" Content="/ コマンド" Margin="0,0,6,0" Padding="8,3" Background="#1E293B" Foreground="#93C5FD" BorderBrush="#334155" BorderThickness="1" ToolTip="スラッシュコマンド（/pass など、定型作業のプロンプト）を登録・編集する" Click="OpenCodeCommands_Click"/>
       <Button x:Name="OpenCodeHistoryButton" Grid.Column="3" Content="履歴 ▾" Margin="0,0,6,0" Padding="8,3" Background="#1E293B" Foreground="#93C5FD" BorderBrush="#334155" BorderThickness="1" ToolTip="この作業フォルダの過去の会話を開いて続ける" Click="OpenCodeHistory_Click">
        <Button.ContextMenu><ContextMenu x:Name="OpenCodeHistoryMenu"/></Button.ContextMenu>
       </Button>
       <Button x:Name="OpenCodeNewChat" Grid.Column="4" Content="新規" Padding="10,3" Background="#1E293B" Foreground="#93C5FD" BorderBrush="#334155" BorderThickness="1" ToolTip="実行中なら止めて、新しい会話を始める" Click="OpenCodeNewChat_Click"/>
      </Grid>
      <Grid Grid.Row="1" Margin="0,6,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="OpenCodeModelCombo" Padding="6,3" FontSize="11" Foreground="#0F172A" ToolTip="使うモデル（opencode models の一覧）" SelectionChanged="OpenCodeModelCombo_SelectionChanged"/>
       <CheckBox x:Name="OpenCodePlanCheck" Grid.Column="1" Content="Plan" Margin="10,0,0,0" Foreground="#E2E8F0" VerticalAlignment="Center" ToolTip="変更せず、調べて計画だけ立てる（--agent plan）" Click="OpenCodePlanCheck_Click"/>
       <CheckBox x:Name="OpenCodeAutoCheck" Grid.Column="2" Content="自動承認" Margin="10,0,0,0" Foreground="#E2E8F0" VerticalAlignment="Center" ToolTip="拒否されていない操作の許可を自動で出す（--auto）" Click="OpenCodeAutoCheck_Click"/>
      </Grid>
      <TextBlock x:Name="OpenCodeDirLabel" Grid.Row="2" Margin="0,6,0,0" Text="cwd: （読み込み中）" Foreground="#93C5FD" FontSize="11" TextTrimming="CharacterEllipsis"/>
      <Border Grid.Row="3" Margin="0,6,0,4" Background="#CC1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6">
       <ScrollViewer x:Name="OpenCodeChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4">
        <StackPanel x:Name="OpenCodeChatPanel"/>
       </ScrollViewer>
      </Border>
      <TextBlock x:Name="OpenCodeActivity" Grid.Row="4" Margin="2,0,0,4" Foreground="#94A3B8" FontSize="11" TextTrimming="CharacterEllipsis"/>
      <TextBox x:Name="OpenCodeInput" Grid.Row="5" Padding="10,6" FontSize="13" Background="#CC1E293B" Foreground="#F8FAFC" BorderBrush="#3B82F6" BorderThickness="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="opencode への指示（Enter で送信 / Shift+Enter で改行 / ↑↓ で過去の指示 / / でコマンド）" TextChanged="OpenCodeInput_TextChanged" SelectionChanged="OpenCodeInput_TextChanged"/>
      <!-- スラッシュコマンドの候補（Obsidian と同じ: / で表示、↑↓で選択、Tab / Enter で確定、Esc で閉じる） -->
      <Popup x:Name="SlashPopup" Grid.Row="5" PlacementTarget="{Binding ElementName=OpenCodeInput}" Placement="Top" AllowsTransparency="True" StaysOpen="True" Focusable="False">
       <Border Background="#F2111827" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="280" MaxWidth="460">
        <ListBox x:Name="SlashList" Background="Transparent" BorderThickness="0" Focusable="False" MaxHeight="220" Foreground="#F8FAFC" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="SlashList_PreviewMouseLeftButtonUp"/>
       </Border>
      </Popup>
      <Grid Grid.Row="6" Margin="0,6,0,0">
       <TextBlock x:Name="OpenCodeUsage" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
       <Button x:Name="OpenCodeSubmit" Content="送信" HorizontalAlignment="Right" Padding="14,4" Background="#1D4ED8" Foreground="#F8FAFC" BorderBrush="#3B82F6" BorderThickness="1" Click="OpenCodeSubmit_Click"/>
      </Grid>
     </Grid>
    </Border>

    <!-- ペイン3（左下）: 単純なメモ（常時保持・自動保存） -->
    <Border Grid.Row="1" Grid.Column="0" Margin="0,8,8,0" Padding="14" CornerRadius="12" Background="#AA0F172A" BorderBrush="#334155" BorderThickness="1">
     <Grid x:Name="ScratchpadView" Grid.Row="1" Grid.Column="0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0">
       <TextBlock Text="メモ（常時保持）" Foreground="#F8FAFC" FontSize="15" FontWeight="SemiBold"/>
       <TextBlock x:Name="ScratchpadStatus" Text="自動保存（人間が消すまで保持）" HorizontalAlignment="Right" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
      </Grid>
      <TextBox x:Name="ScratchpadBox" Grid.Row="1" Margin="0,10,0,0" Padding="12" FontSize="14" Background="#CC1E293B" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="ScratchpadBox_TextChanged" ToolTip="自由メモを入力してください（自動保存され、ランチャーやPCを再起動しても消えません）"/>
     </Grid>
    </Border>

    <!-- ペイン4（右下）: gantt メモ -->
    <Border Grid.Row="1" Grid.Column="1" Margin="8,8,0,0" Padding="14" CornerRadius="12" Background="#FF0F172A" BorderBrush="#334155" BorderThickness="1">
     <Grid x:Name="MemoView" Grid.Row="1" Grid.Column="1" Background="#FF0F172A" KeyboardNavigation.TabNavigation="Cycle">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><TextBlock Text="gantt メモ" Foreground="#F8FAFC" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="ParentLabel" Text="parent: 0" HorizontalAlignment="Right" Foreground="#93C5FD" FontSize="12"/></Grid>
      <TextBox x:Name="MemoTitle" Grid.Row="1" Margin="0,10,0,8" Padding="10,8" FontSize="14" Background="#CC1E293B" Foreground="#F8FAFC" BorderBrush="#3B82F6" BorderThickness="1" Text="" ToolTip="タスク名を入力してください（Ctrl+Enterで送信）"/>
      <TextBox x:Name="MemoBody" Grid.Row="2" Padding="10" FontSize="13" Background="#CC1E293B" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="メモを入力してください（Ctrl+Enterで送信、Enterで改行）"/>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,4"><Button x:Name="MemoCancel" Content="クリア" Padding="8,4" Margin="4,0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Foreground="#94A3B8" Click="MemoCancel_Click"/><Button x:Name="MemoSubmit" Content="送信" Padding="12,4" Margin="4,0" Background="#1D4ED8" BorderBrush="#3B82F6" BorderThickness="1" Foreground="#F8FAFC" Click="MemoSubmit_Click"/></StackPanel>
      <TextBlock x:Name="MemoStatus" Grid.Row="4" Foreground="#94A3B8" FontSize="11" Text="Ctrl+Enterまたは送信ボタンで追加（Enterは改行）"/>
     </Grid>
    </Border>
   </Grid>
  </Grid>
 </Border>
</Window>
