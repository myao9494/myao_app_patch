index b1ddbd4d2ced98767caf989a30f2559aa6059b33..fa523f2a4137bf085bec3fc501db178d2db2fab1 100644
--- a/backend/requirements-cuda.txt
+++ b/backend/requirements-cuda.txt
@@ -1,13 +1,16 @@
 # -*- coding: utf-8 -*-
 # ==============================================================================
 # Windows NVIDIA GPU (RTX A500 等) 専用 requirements
-# 
-# 使用方法:
-#   pip install -r requirements-cuda.txt
-# 
-# これにより、PyTorch 公式の CUDA 12.4 対応 wheel が自動取得され、
-# Windows 環境で GPU (CUDA) 高速化が有効化されます。
+#
+# 使用方法（通常は setup_windows_cuda.bat が実行する）:
+#   .venv\Scripts\python.exe -m pip install -r requirements-cuda.txt
+#
+# PyTorch 公式の CUDA 12.6 の索引を足して、requirements-lock.txt と同じ版を入れる。
+# torch だけは GPU 版の 2.14.1+cu126 を明示する（requirements-lock.txt の torch==2.14.1 も満たす）。
+# 明示しないと、CPU 版の 2.14.1 が入った venv では「入っている」と見なされ GPU 版に入れ替わらない。
+# CUDA 12.4 の索引には Python 3.14 用の torch が無く、黙って CPU 版が入ってしまうため使わない。
 # ==============================================================================
 
---extra-index-url https://download.pytorch.org/whl/cu124
--r requirements.txt
+--extra-index-url https://download.pytorch.org/whl/cu126
+torch==2.14.1+cu126
+-r requirements-lock.txt
diff --git a/backend/requirements-lock.txt b/backend/requirements-lock.txt
new file mode 100644
index 0000000000000000000000000000000000000000..f06f68978fa3484d5abbba2e24f76fd31b897dd9
--- /dev/null
+++ b/backend/requirements-lock.txt
@@ -0,0 +1,126 @@
+# -*- coding: utf-8 -*-
+# ==============================================================================
+# Local Fulltext Search - 版を固定した依存一覧（requirements.txt から書き出す）
+#
+# setup_windows.bat（会社の Windows。uv が無いので pip で入れる）と Mac の start_dev.sh が
+# backend/.venv にこれを入れる。どの端末でも同じ版になるようにしている。Python 3.14 用。
+# - 全パッケージに Python 3.14 用のビルド済み wheel がある（lzstring・red-black-tree-mod・unidic-lite・
+#   win-unicode-console は純 Python のソースだけだが、pip がそのまま入れられる）
+# - torch は 2.14.1 に固定する。PyPI（Mac・CPU の Windows）と CUDA 12.6 の索引（requirements-cuda.txt）の
+#   両方にある版で、GPU 版は同じ版の 2.14.1+cu126 が入る
+#
+# requirements.txt を変えたら、uv のある端末（Mac）で書き出し直す（冒頭のコメントはそのまま残る）:
+#   cd backend
+#   { grep '^#' requirements-lock.txt; uv pip compile -q --universal --python-version 3.14 --no-header --no-annotate requirements.txt -c <(echo torch==2.14.1); } > requirements-lock.txt.new && mv requirements-lock.txt.new requirements-lock.txt
+# tests/test_python_env_contract.py が固定漏れと torch・pydantic の版を確かめる。
+# ==============================================================================
