+    def refresh_before_search(self, params: SearchQueryParams) -> dict[str, bool]:
+        """
+        検索の前にインデックスを更新し、更新の状況（used_existing_index / background_refresh_scheduled）を返す。
+        キーワード検索を通らないベクトル検索が、search と同じ条件で更新するために呼ぶ。
+        """
+        if params.source_type == "gantt":
+            return dict(_NO_REFRESH_FLAGS)
+        app_settings = self.index_service.get_app_settings()
+        return self._refresh_scope(params, self._resolve_scope(params, app_settings), app_settings)
+
+    def _refresh_scope(
+        self, params: SearchQueryParams, scope: _SearchScope, app_settings: AppSettingsResponse
+    ) -> dict[str, bool]:
+        """全DB検索と skip_refresh のときは更新しない。それ以外は対象フォルダ、無ければ登録済みの検索対象を更新する。"""
+        if params.search_all_enabled or params.skip_refresh:
+            return dict(_NO_REFRESH_FLAGS)
+        if scope.normalized_target_path:
+            return self.refresher.refresh_target(
+                normalized_target_path=scope.normalized_target_path,
+                refresh_window_minutes=params.refresh_window_minutes,
+                effective_exclude_keywords=scope.exclude_keywords,
+                index_depth=scope.index_depth,
+                index_types=params.index_types,
+                custom_content_extensions=app_settings.custom_content_extensions,
+                custom_filename_extensions=app_settings.custom_filename_extensions,
+            )
+        self.refresher.refresh_registered_targets(
+            refresh_window_minutes=params.refresh_window_minutes,
+            effective_exclude_keywords=scope.exclude_keywords,
+            index_depth=scope.index_depth,
+            index_types=params.index_types,
+            custom_content_extensions=app_settings.custom_content_extensions,
+            custom_filename_extensions=app_settings.custom_filename_extensions,
+            source_type=params.source_type,
+            web_exclude_keywords=(
+                params.exclude_keywords if params.exclude_keywords is not None else app_settings.web_exclude_keywords
+            ),
+            web_index_depth=params.index_depth,
+        )
+        return dict(_NO_REFRESH_FLAGS)
+
     def _resolve_scope(self, params: SearchQueryParams, app_settings: AppSettingsResponse) -> _SearchScope:
         """リクエストと保存済みの設定から、検索の対象範囲を決める。"""
         normalized_target_path = ""
