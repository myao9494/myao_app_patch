+        return _extract_xml_text(read_text_file(path))
     if resolved_extension in extra_content_extensions:
-        return path.read_text(encoding="utf-8", errors="ignore")
+        return read_text_file(path)
     if resolved_extension == ".pdf":
         return _extract_pdf_text(path)
     if resolved_extension == ".docx":
@@ -311,6 +334,9 @@ def _iter_json_scalar_values(value: object) -> list[str]:
         for nested in value:
             values.extend(_iter_json_scalar_values(nested))
         return values
+    if isinstance(value, str) and ";base64," in value[:_BASE64_DATA_URL_HEAD_CHARS] and value.startswith("data:"):
+        # 埋め込み画像は検索語の誤一致の原因になるだけなので入れない
+        return []
     if isinstance(value, bool):
         return ["true" if value else "false"]
     if isinstance(value, (int, float)):
