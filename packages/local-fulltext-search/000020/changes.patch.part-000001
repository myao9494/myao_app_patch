+# Excalidraw ノートの図データの節。形が想定と違うときは何も削らないよう、閉じたコードブロックだけに一致させる
+_EXCALIDRAW_DRAWING_SECTION = re.compile(
+    r"^(?:%%[ \t]*\r?\n)?#+[ \t]*Drawing[ \t]*\r?\n```[\w-]*[ \t]*\r?\n.*?^```[ \t]*(?:\r?\n%%[ \t]*)?$",
+    re.MULTILINE | re.DOTALL,
+)
+_EXCALIDRAW_PLUGIN_MARKER = "excalidraw-plugin:"
+_EXCALIDRAW_FRONTMATTER_SEARCH_CHARS = 3000
+_BASE64_DATA_URL_HEAD_CHARS = 100
+
+
+def strip_excalidraw_drawing(content: str) -> str:
+    """
+    Excalidraw ノートから図データ（`## Drawing` の節）を除いた本文を返す。
+    図の中の文字（`## Text Elements`）は残す。普通の Markdown の `## Drawing` 見出しは削らない。
+    図の JSON と貼り付け画像の base64 は、検索語の誤一致とベクトル化の時間の原因になるだけで、検索の役に立たない。
+    """
+    if _EXCALIDRAW_PLUGIN_MARKER not in content[:_EXCALIDRAW_FRONTMATTER_SEARCH_CHARS]:
+        return content
+    return _EXCALIDRAW_DRAWING_SECTION.sub("", content).rstrip() + "\n"
+
+
 def extract_text(
     path: Path,
     *,
@@ -231,18 +254,18 @@ def extract_text(
         raise ValueError(f"Unsupported extension: {suffix}")
 
     if resolved_extension in {".md", ".excalidraw.md"}:
