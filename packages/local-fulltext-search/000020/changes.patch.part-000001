     return should_exclude_path_with_keywords(path, keyword_set, substring_keywords, excluded_path_prefixes)
 
 
+def find_enclosing_root(path: str, roots: Sequence[str]) -> str:
+    """path を含む最も深いフォルダを roots から返す。どれにも含まれなければ空文字を返す。区切り文字の違いは無視する。"""
+    normalized_path = path.replace("\\", "/").rstrip("/").lower()
+    enclosing = ""
+    for root in roots:
+        normalized_root = root.replace("\\", "/").rstrip("/").lower()
+        if normalized_path != normalized_root and not normalized_path.startswith(f"{normalized_root}/"):
+            continue
+        if len(root) > len(enclosing):
+            enclosing = root
+    return enclosing
+
+
+def should_exclude_under_root(path: Path, root: str | None, keywords: list[str]) -> bool:
+    """
+    検索対象 root の下にある path が除外されるかを返す。
+    パス形式のキーワードは全体のパスで、名前形式のキーワードは root より下の要素だけで判定する。
+    root が無い、または path が root の外にあるときは、パス全体の要素で判定する。
+    """
+    if not keywords:
+        return False
+    keyword_set, substring_keywords, excluded_path_prefixes = _compile_exclude_keywords_cached(tuple(keywords))
+    normalized_path = normalize_excluded_path_prefix(path)
+    if normalized_path is not None and is_excluded_path_prefix(normalized_path, excluded_path_prefixes):
+        return True
+    substring_tuple = tuple(substring_keywords)
+    return any(_is_excluded_name_cached(part, keyword_set, substring_tuple) for part in _parts_under_root(path, root))
+
+
+def _parts_under_root(path: Path, root: str | None) -> tuple[str, ...] | list[str]:
+    """
+    root より下のパス要素を返す。path が root の外にあるときは全要素を返す。
+    検索結果の件数だけ呼ばれるので、pathlib の relative_to は使わない（1 件あたり 0.5 ミリ秒かかる）。
+    """
+    if not root:
+        return path.parts
+    full_path = path.as_posix()
+    normalized_root = root.replace("\\", "/").rstrip("/")
+    lowered_path = full_path.lower()
+    lowered_root = normalized_root.lower()
+    if lowered_path == lowered_root:
+        return []
+    if not lowered_path.startswith(f"{lowered_root}/"):
+        return path.parts
+    return full_path[len(normalized_root) + 1 :].split("/")
+
+
