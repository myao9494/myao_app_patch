diff --git a/backend/tests/test_skipped_links.py b/backend/tests/test_skipped_links.py
new file mode 100644
index 0000000000000000000000000000000000000000..2d58b916fc8b105212ac6c8a99b45b616a3ceb2b
--- /dev/null
+++ b/backend/tests/test_skipped_links.py
@@ -0,0 +1,312 @@
+"""
+たどらなかったフォルダのリンクを利用者へ案内するためのテスト。
+
+ジャンクション（Windows）とフォルダのシンボリックリンク（全 OS）の先は走査しない。
+その先にある文書は検索できないので、見つけたら画面で案内する。
+
+仕様:
+- 走査で見つけたリンクの場所・元のフォルダ・種類を記録する。リンクの中へは入らない。
+- 元のフォルダが無いリンク、除外されたリンク、階層の上限より深いリンクは案内しない。
+- 確認済みにしたリンクは再び案内しない。元のフォルダが変わったら、また案内する。
+- 走査でリンクが無くなっていたら、記録を消す。読めなかったフォルダがある走査では消さない。
+- 検索対象から外したフォルダのリンクは案内しない。
+- 元のフォルダが検索対象に含まれるときは is_covered を返す（案内の文面を変えるため）。
+"""
+
+import os
+import sqlite3
+import subprocess
+from collections.abc import Iterator
+from pathlib import Path
+
+import pytest
+from fastapi.testclient import TestClient
+
+from app import main as app_main
+from app.db.schema import initialize_schema, reset_schema
+from app.services import exclude_rules
+from app.services.file_walker import SkippedLink, walk_indexable_files
+from app.services.index_service import IndexService
+from app.services.skipped_link_store import SkippedLinkStore
+
+
+def _make_junction(link: Path, target: Path) -> None:
+    if os.name != "nt":
+        pytest.skip("ジャンクションは Windows の機能")
+    subprocess.run(["cmd", "/c", "mklink", "/J", str(link), str(target)], check=True, capture_output=True)
+
+
+def _make_symlink(link: Path, target: Path) -> None:
+    try:
+        os.symlink(target, link, target_is_directory=True)
+    except OSError as error:
+        pytest.skip(f"シンボリックリンクを作れない環境: {error}")
+
+
+MAKE_LINK = [
+    pytest.param(_make_junction, "junction", id="junction"),
+    pytest.param(_make_symlink, "symlink", id="symlink"),
+]
+
+
+def _walk(
+    root: Path,
+    *,
+    keywords: str = "",
+    max_depth: int = 5,
+) -> tuple[list[Path], dict[str, SkippedLink]]:
+    keyword_set, substring_keywords, excluded_path_prefixes = exclude_rules.compile_exclude_keywords(
+        exclude_rules.parse_exclude_keywords(keywords)
+    )
+    skipped: dict[str, SkippedLink] = {}
+    found = list(
+        walk_indexable_files(
+            root,
+            keyword_set,
+            substring_keywords,
+            excluded_path_prefixes=excluded_path_prefixes,
+            auto_excluded_paths=set(),
+            allowed_extensions=frozenset({".md"}),
+            sorted_allowed_extensions=(".md",),
+            max_depth=max_depth,
+            skipped_links=skipped,
+        )
+    )
+    return found, skipped
+
+
+@pytest.fixture
+def folders(tmp_path: Path) -> tuple[Path, Path]:
+    """検索対象のフォルダと、その外にある元のフォルダを作る。"""
+    target = (tmp_path / "work").resolve()
+    outside = (tmp_path / "outside").resolve()
+    target.mkdir()
+    outside.mkdir()
+    (target / "note.md").write_text("zebra", encoding="utf-8")
+    (outside / "linked.md").write_text("linked", encoding="utf-8")
+    return target, outside
+
+
+@pytest.fixture
+def connection(tmp_path: Path) -> Iterator[sqlite3.Connection]:
+    db = sqlite3.connect(tmp_path / "search.db")
+    db.row_factory = sqlite3.Row
+    initialize_schema(db)
+    yield db
+    db.close()
+
+
+@pytest.fixture
+def client() -> Iterator[TestClient]:
+    with TestClient(app_main.create_app(), raise_server_exceptions=False) as test_client:
+        yield test_client
+
+
+def _register_and_index(client: TestClient, target: Path) -> None:
+    client.post("/api/index/search-targets", json={"folder_path": target.as_posix(), "index_depth": 5})
+    response = client.post("/api/index/search-targets/reindex", json={"folder_paths": [target.as_posix()]})
+    assert response.status_code == 200
+
+
+def _items(client: TestClient) -> list[dict[str, object]]:
+    response = client.get("/api/index/skipped-links")
+    assert response.status_code == 200
+    return response.json()["items"]
+
+
+@pytest.mark.parametrize(("make_link", "link_type"), MAKE_LINK)
+def test_walker_records_the_link_and_does_not_enter_it(
+    folders: tuple[Path, Path], make_link, link_type: str
+) -> None:
+    target, outside = folders
+    link = target / "shared"
+    make_link(link, outside)
+
+    found, skipped = _walk(target)
+
+    assert [path.name for path in found] == ["note.md"]
+    assert list(skipped.values()) == [SkippedLink(link.as_posix(), outside.as_posix(), link_type)]
+
+
+def test_walker_records_nothing_for_a_normal_folder(folders: tuple[Path, Path]) -> None:
+    target, _ = folders
+    (target / "sub").mkdir()
+    (target / "sub" / "deep.md").write_text("deep", encoding="utf-8")
+
+    found, skipped = _walk(target)
+
+    assert sorted(path.name for path in found) == ["deep.md", "note.md"]
+    assert skipped == {}
+
+
+def test_walker_ignores_a_link_to_a_missing_folder(folders: tuple[Path, Path], tmp_path: Path) -> None:
+    target, _ = folders
+    gone = tmp_path / "gone"
+    gone.mkdir()
+    _make_symlink(target / "broken", gone)
+    gone.rmdir()
+
+    _, skipped = _walk(target)
+
+    assert skipped == {}
+
+
+def test_walker_ignores_an_excluded_link(folders: tuple[Path, Path]) -> None:
+    target, outside = folders
+    _make_symlink(target / "backup", outside)
+
+    _, skipped = _walk(target, keywords="backup")
+
+    assert skipped == {}
+
+
+def test_walker_ignores_a_link_deeper_than_the_limit(folders: tuple[Path, Path]) -> None:
+    target, outside = folders
+    (target / "sub").mkdir()
+    _make_symlink(target / "sub" / "shared", outside)
+
+    assert _walk(target, max_depth=1)[1] == {}
+    assert len(_walk(target, max_depth=2)[1]) == 1
+
+
+@pytest.mark.parametrize(("make_link", "link_type"), MAKE_LINK)
+def test_found_link_is_announced_with_its_original_folder(
+    client: TestClient, folders: tuple[Path, Path], make_link, link_type: str
+) -> None:
+    target, outside = folders
+    make_link(target / "shared", outside)
+
+    _register_and_index(client, target)
+
+    assert _items(client) == [
+        {
+            "link_path": (target / "shared").as_posix(),
+            "target_path": outside.as_posix(),
+            "link_type": link_type,
+            "is_covered": False,
+        }
+    ]
+
+
+def test_link_to_a_searched_folder_is_marked_as_covered(client: TestClient, folders: tuple[Path, Path]) -> None:
+    target, _ = folders
+    (target / "sub").mkdir()
+    _make_symlink(target / "sub" / "back", target)
+
+    _register_and_index(client, target)
+
+    assert [item["is_covered"] for item in _items(client)] == [True]
+
+
+def test_acknowledged_link_is_not_announced_again(client: TestClient, folders: tuple[Path, Path]) -> None:
+    target, outside = folders
+    link = target / "shared"
+    _make_symlink(link, outside)
+    _register_and_index(client, target)
+
+    response = client.post("/api/index/skipped-links/acknowledge", json={"link_paths": [link.as_posix()]})
+    _register_and_index(client, target)
+
+    assert response.status_code == 200
+    assert response.json() == {"acknowledged_count": 1}
+    assert _items(client) == []
+
+
+def test_link_is_announced_again_when_its_folder_changes(
+    client: TestClient, folders: tuple[Path, Path], tmp_path: Path
+) -> None:
+    target, outside = folders
+    link = target / "shared"
+    _make_symlink(link, outside)
+    _register_and_index(client, target)
+    client.post("/api/index/skipped-links/acknowledge", json={"link_paths": [link.as_posix()]})
+    other = (tmp_path / "other").resolve()
+    other.mkdir()
+    os.rmdir(link) if os.name == "nt" else link.unlink()
+    _make_symlink(link, other)
+
+    _register_and_index(client, target)
+
+    assert [item["target_path"] for item in _items(client)] == [other.as_posix()]
+
+
+def test_removed_link_is_forgotten(client: TestClient, folders: tuple[Path, Path]) -> None:
+    target, outside = folders
+    link = target / "shared"
+    _make_symlink(link, outside)
+    _register_and_index(client, target)
+    os.rmdir(link) if os.name == "nt" else link.unlink()
+
+    _register_and_index(client, target)
+
+    assert _items(client) == []
+
+
+def test_link_is_kept_when_part_of_the_folder_could_not_be_read(connection: sqlite3.Connection) -> None:
+    store = SkippedLinkStore(connection)
+    link = SkippedLink("C:/work/shared", "D:/data", "junction")
+    store.sync("C:/work", 5, {link.link_path: link}, keep_missing=False)
+    store.acknowledge([link.link_path])
+
+    store.sync("C:/work", 5, {}, keep_missing=True)
+    store.sync("C:/work", 5, {link.link_path: link}, keep_missing=False)
+
+    assert store.list_unacknowledged(["C:/work"]).items == []
+
+
+def test_shallow_scan_keeps_links_it_did_not_reach(connection: sqlite3.Connection) -> None:
+    store = SkippedLinkStore(connection)
+    link = SkippedLink("C:/work/a/b/shared", "D:/data", "junction")
+    store.sync("C:/work", 5, {link.link_path: link}, keep_missing=False)
+
+    store.sync("C:/work", 0, {}, keep_missing=False)
+
+    assert len(store.list_unacknowledged(["C:/work"]).items) == 1
+
+
+def test_scan_of_another_folder_keeps_links(connection: sqlite3.Connection) -> None:
+    store = SkippedLinkStore(connection)
+    link = SkippedLink("C:/work/shared", "D:/data", "junction")
+    store.sync("C:/work", 5, {link.link_path: link}, keep_missing=False)
+
+    store.sync("C:/workspace", 5, {}, keep_missing=False)
+
+    assert len(store.list_unacknowledged(["C:/work"]).items) == 1
+
+
+def test_link_of_a_removed_search_target_is_not_announced(client: TestClient, folders: tuple[Path, Path]) -> None:
+    target, outside = folders
+    _make_symlink(target / "shared", outside)
+    _register_and_index(client, target)
+
+    client.request("DELETE", "/api/index/search-targets", json={"folder_paths": [target.as_posix()]})
+
+    assert _items(client) == []
+
+
+def test_reset_clears_links(connection: sqlite3.Connection) -> None:
+    store = SkippedLinkStore(connection)
+    link = SkippedLink("C:/work/shared", "D:/data", "junction")
+    store.sync("C:/work", 5, {link.link_path: link}, keep_missing=False)
+
+    reset_schema(connection)
+
+    assert store.list_unacknowledged(["C:/work"]).items == []
+
+
+def test_existing_database_gets_the_table_and_keeps_its_rows(tmp_path: Path) -> None:
+    db = sqlite3.connect(tmp_path / "old.db")
+    db.row_factory = sqlite3.Row
+    initialize_schema(db)
+    target = (tmp_path / "work").resolve()
+    target.mkdir()
+    (target / "note.md").write_text("zebra", encoding="utf-8")
+    IndexService(connection=db).ensure_fresh_target(full_path=target.as_posix(), refresh_window_minutes=0, index_depth=5)
+    db.execute("DROP TABLE skipped_links")
+    db.commit()
+
+    initialize_schema(db)
+
+    assert db.execute("SELECT COUNT(*) FROM files").fetchone()[0] == 1
+    assert db.execute("SELECT COUNT(*) FROM skipped_links").fetchone()[0] == 0
+    db.close()
diff --git a/backend/tests/test_text_encoding.py b/backend/tests/test_text_encoding.py
new file mode 100644
index 0000000000000000000000000000000000000000..f9f94fea2a4c3d3e6b518d975361e52ff854f40f
--- /dev/null
+++ b/backend/tests/test_text_encoding.py
@@ -0,0 +1,122 @@
+"""
+利用者のテキストファイルの文字コードのテスト。
+
+Windows の日本語環境には Shift-JIS や UTF-16 のテキストが多い。UTF-8 だけで読むと文字化けして検索できない。
+
+仕様:
+- BOM があれば BOM の文字コード（UTF-8 / UTF-16 / UTF-32）で読み、BOM は本文に残さない。
+- BOM が無ければ UTF-8 で読み、UTF-8 として読めなければ cp932（Shift-JIS）で読む。
+- ほぼ UTF-8 で一部だけ壊れたファイルは、壊れた箇所を除いて UTF-8 として読む（全体を文字化けさせない）。
+- 全文インデックス・ベクトルインデックス・AIインプットが同じ読み取りを使う。
+"""
+
+import json
+import sqlite3
+from pathlib import Path
+
+import pytest
+
+from app.db.schema import initialize_schema
+from app.extractors.text_encoding import decode_text, read_text_file
+from app.extractors.text_extractor import extract_text
+from app.services.index_service import IndexService
+from app.vector.db import open_db
+from app.vector.export_document_reader import read_export_document_text
+from app.vector.state import VectorState
+
+TEXT = "社内規程の改定について。第三条を変更する。"
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        TEXT.encode("utf-8"),
+        TEXT.encode("utf-8-sig"),
+        TEXT.encode("cp932"),
+        TEXT.encode("utf-16"),
+        TEXT.encode("utf-16-le").join([b"\xff\xfe", b""]),
+        b"\xfe\xff" + TEXT.encode("utf-16-be"),
+        TEXT.encode("utf-32"),
+    ],
+    ids=["utf8", "utf8bom", "cp932", "utf16", "utf16le", "utf16be", "utf32"],
+)
+def test_decode_text_detects_the_encoding(raw: bytes) -> None:
+    assert decode_text(raw) == TEXT
+
+
+def test_mostly_utf8_with_a_broken_byte_stays_utf8() -> None:
+    raw = ("本文" * 200).encode("utf-8") + b"\xff" + "末尾".encode("utf-8")
+
+    decoded = decode_text(raw)
+
+    assert decoded.startswith("本文本文")
+    assert decoded.endswith("末尾")
+
+
+def test_read_text_file_normalizes_newlines(tmp_path: Path) -> None:
+    path = tmp_path / "note.md"
+    path.write_bytes("1行目\r\n2行目\r3行目\n".encode("cp932"))
+
+    assert read_text_file(path) == "1行目\n2行目\n3行目\n"
+
+
+def test_decode_text_handles_empty_and_binary_noise() -> None:
+    assert decode_text(b"") == ""
+    assert isinstance(decode_text(bytes(range(256))), str)
+
+
+@pytest.mark.parametrize(
+    ("name", "raw"),
+    [
+        ("sjis.txt", TEXT.encode("cp932")),
+        ("sjis.md", TEXT.encode("cp932")),
+        ("utf16.txt", TEXT.encode("utf-16")),
+        ("sjis.xml", f'<?xml version="1.0" encoding="shift_jis"?><a>{TEXT}</a>'.encode("cp932")),
+        ("bom.json", json.dumps({"a": TEXT}, ensure_ascii=False).encode("utf-8-sig")),
+        ("bom.md", TEXT.encode("utf-8-sig")),
+    ],
+)
+def test_extract_text_reads_each_encoding(tmp_path: Path, name: str, raw: bytes) -> None:
+    path = tmp_path / name
+    path.write_bytes(raw)
+
+    text = extract_text(path)
+
+    assert "社内規程" in text
+    assert "﻿" not in text
+
+
+def test_shift_jis_note_is_searchable_after_indexing(tmp_path: Path) -> None:
+    connection = sqlite3.connect(tmp_path / "search.db")
+    connection.row_factory = sqlite3.Row
+    initialize_schema(connection)
+    target = (tmp_path / "work").resolve()
+    target.mkdir()
+    (target / "規程.txt").write_bytes(TEXT.encode("cp932"))
+
+    IndexService(connection=connection).ensure_fresh_target(full_path=target.as_posix(), refresh_window_minutes=0, index_depth=5)
+
+    body = connection.execute("SELECT content FROM file_segments WHERE segment_type = 'body'").fetchone()[0]
+    connection.close()
+    assert "社内規程" in body
+
+
+def test_vector_index_reads_shift_jis_markdown(tmp_path: Path) -> None:
+    folder = tmp_path / "notes"
+    folder.mkdir()
+    (folder / "規程.md").write_bytes(TEXT.encode("cp932"))
+    state = VectorState(data_dir=tmp_path)
+    state.load_model(use_mock=True, mock_dim=32)
+
+    state.sync_index(target_folders=[str(folder)], exclude_keywords="")
+
+    with open_db(state.searcher.db_path) as connection:
+        chunks = [str(row[0]) for row in connection.execute("SELECT text FROM chunks")]
+    assert any("社内規程" in chunk for chunk in chunks)
+
+
+def test_export_reader_handles_utf16(tmp_path: Path) -> None:
+    path = tmp_path / "note.md"
+    path.write_bytes(TEXT.encode("utf-16"))
+
+    assert read_export_document_text(path) == TEXT
diff --git a/backend/tests/test_unreadable_folders.py b/backend/tests/test_unreadable_folders.py
new file mode 100644
index 0000000000000000000000000000000000000000..f03bd58899dcf557e891d2ba2c95fcf0e29bba4d
--- /dev/null
+++ b/backend/tests/test_unreadable_folders.py
@@ -0,0 +1,164 @@
+"""
+走査で読めなかった場所のインデックスを消さないことのテスト。
+
+一時的に読めないだけのフォルダ（権限・ロック・ネットワークの瞬断）を「ファイルが消えた」と扱うと、
+インデックスが消える。ベクトルインデックスは再作成に何時間もかかる。
+
+仕様:
+- 走査で読めなかったフォルダの配下は、全文インデックスの削除の対象にしない。
+- 対象フォルダ自体が読めないときも何も消さない。
+- 読めなかったフォルダを除外キーワードへは追加しない（一時的な事象のため）。
+- ベクトルインデックスの削除候補にも出さない。
+- 読めるようになれば、次の走査で通常どおり更新する。消えたファイルはそのときに消す。
+"""
+
+import os
+import sqlite3
+from collections.abc import Callable, Iterator
+from contextlib import contextmanager
+from pathlib import Path
+
+import pytest
+
+from app.db.schema import initialize_schema
+from app.services.index_service import IndexService
+from app.vector.state import VectorState
+
+
+@contextmanager
+def _unreadable(suffix: str, error: OSError) -> Iterator[None]:
+    """パスの末尾が suffix のフォルダの os.scandir を失敗させる。"""
+    real_scandir = os.scandir
+
+    def flaky_scandir(path: object = ".") -> object:
+        if str(path).endswith(suffix):
+            raise error
+        return real_scandir(path)
+
+    os.scandir = flaky_scandir  # type: ignore[assignment]
+    try:
+        yield
+    finally:
+        os.scandir = real_scandir
+
+
+@pytest.fixture
+def indexed(tmp_path: Path):
+    connection = sqlite3.connect(tmp_path / "search.db")
+    connection.row_factory = sqlite3.Row
+    initialize_schema(connection)
+    service = IndexService(connection=connection)
+    target = (tmp_path / "work").resolve()
+    (target / "sub").mkdir(parents=True)
+    (target / "keep.md").write_text("keep", encoding="utf-8")
+    (target / "sub" / "inner.md").write_text("inner", encoding="utf-8")
+
+    def scan() -> None:
+        service.ensure_fresh_target(full_path=target.as_posix(), refresh_window_minutes=0, index_depth=5)
+
+    def names() -> list[str]:
+        return [str(row[0]) for row in connection.execute("SELECT file_name FROM files ORDER BY file_name")]
+
+    scan()
+    assert names() == ["inner.md", "keep.md"]
+    try:
+        yield {"target": target, "scan": scan, "names": names, "connection": connection}
+    finally:
+        connection.close()
+
+
+FOLDER_ERRORS = [
+    PermissionError(13, "Access is denied"),
+    OSError(64, "The specified network name is no longer available"),
+    OSError(53, "The network path was not found"),
+    OSError(121, "The semaphore timeout period has expired"),
+]
+
+
+@pytest.mark.parametrize("error", FOLDER_ERRORS, ids=["権限", "ネットワーク切断", "ネットワーク不明", "タイムアウト"])
+def test_unreadable_subfolder_keeps_its_index(indexed: dict, error: OSError) -> None:
+    with _unreadable("sub", error):
+        indexed["scan"]()
+
+    assert indexed["names"]() == ["inner.md", "keep.md"]
+
+
+def test_unreadable_target_folder_keeps_the_whole_index(indexed: dict) -> None:
+    with _unreadable("work", PermissionError(13, "Access is denied")):
+        try:
+            indexed["scan"]()
+        except Exception:
+            pass
+
+    assert indexed["names"]() == ["inner.md", "keep.md"]
+
+
+def test_unreadable_folder_is_not_added_to_the_exclusions(indexed: dict) -> None:
+    with _unreadable("sub", PermissionError(13, "Access is denied")):
+        indexed["scan"]()
+
+    keywords = indexed["connection"].execute("SELECT exclude_keywords FROM targets").fetchone()[0]
+    assert "sub" not in (keywords or "")
+
+
+def test_deleted_file_is_removed_once_the_folder_is_readable_again(indexed: dict) -> None:
+    with _unreadable("sub", PermissionError(13, "Access is denied")):
+        indexed["scan"]()
+    (indexed["target"] / "sub" / "inner.md").unlink()
+
+    indexed["scan"]()
+
+    assert indexed["names"]() == ["keep.md"]
+
+
+def test_file_that_cannot_be_inspected_keeps_its_index(indexed: dict, monkeypatch: pytest.MonkeyPatch) -> None:
+    real_stat = Path.stat
+
+    def flaky_stat(self: Path, *args: object, **kwargs: object) -> os.stat_result:
+        if self.name == "inner.md":
+            raise PermissionError(13, "Access is denied")
+        return real_stat(self, *args, **kwargs)
+
+    monkeypatch.setattr(Path, "stat", flaky_stat)
+    indexed["scan"]()
+
+    assert indexed["names"]() == ["inner.md", "keep.md"]
+
+
+def _vector_state(tmp_path: Path) -> tuple[VectorState, Path]:
+    folder = (tmp_path / "notes").resolve()
+    (folder / "sub").mkdir(parents=True)
+    (folder / "keep.md").write_text("keep", encoding="utf-8")
+    (folder / "sub" / "inner.md").write_text("inner", encoding="utf-8")
+    state = VectorState(data_dir=tmp_path)
+    state.load_model(use_mock=True, mock_dim=32)
+    state.sync_index(target_folders=[str(folder)], exclude_keywords="")
+    return state, folder
+
+
+def test_vector_deletion_candidates_skip_unreadable_folders(tmp_path: Path) -> None:
+    state, folder = _vector_state(tmp_path)
+
+    with _unreadable("sub", PermissionError(13, "Access is denied")):
+        pending = state.get_pending_deletions(target_folders=[str(folder)])
+
+    assert pending == []
+
+
+def test_vector_sync_with_cleanup_keeps_unreadable_folders(tmp_path: Path) -> None:
+    state, folder = _vector_state(tmp_path)
+
+    with _unreadable("sub", OSError(64, "The specified network name is no longer available")):
+        state.sync_index(target_folders=[str(folder)], exclude_keywords="", clean_deleted_files=True)
+
+    assert state.get_pending_deletions(target_folders=[str(folder)]) == []
+    with state_db(state) as count:
+        assert count() == 2
+
+
+@contextmanager
+def state_db(state: VectorState) -> Iterator[Callable[[], int]]:
+    from app.vector.db import open_db
+
+    with open_db(state.searcher.db_path) as connection:
+        yield lambda: int(connection.execute("SELECT count(*) FROM documents").fetchone()[0])
