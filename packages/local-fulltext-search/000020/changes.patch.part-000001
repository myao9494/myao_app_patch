index 21b8658f110157316ef7c21712c20fdbdf6d7b12..8e2a49923e4e73d22ee37e5dde54f55c8bd8191c 100644
--- a/frontend/src/api/client.ts
+++ b/frontend/src/api/client.ts
@@ -5,6 +5,7 @@
 import type {
   AppSettings,
   FailedFileListResponse,
+  SkippedFolderLinkListResponse,
   IndexedTargetListResponse,
   IndexStatus,
   SearchTargetListResponse,
@@ -119,6 +120,17 @@ export async function fetchFailedFiles(): Promise<FailedFileListResponse> {
   return request<FailedFileListResponse>("/api/index/failed-files");
 }
 
+export async function fetchSkippedLinks(): Promise<SkippedFolderLinkListResponse> {
+  return request<SkippedFolderLinkListResponse>("/api/index/skipped-links");
+}
+
+export async function acknowledgeSkippedLinks(linkPaths: string[]): Promise<{ acknowledged_count: number }> {
+  return request<{ acknowledged_count: number }>("/api/index/skipped-links/acknowledge", {
+    method: "POST",
+    body: JSON.stringify({ link_paths: linkPaths }),
+  });
+}
+
 export async function fetchIndexedTargets(sourceType: "local" | "web" = "local"): Promise<IndexedTargetListResponse> {
   const query = new URLSearchParams({ source_type: sourceType });
   return request<IndexedTargetListResponse>(`/api/index/targets?${query.toString()}`);
diff --git a/frontend/src/components/SkippedLinksDialog.tsx b/frontend/src/components/SkippedLinksDialog.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..39995f8466ba048e1f558763eda0178dac542bc1
--- /dev/null
+++ b/frontend/src/components/SkippedLinksDialog.tsx
@@ -0,0 +1,51 @@
+/**
+ * 走査でたどらなかったフォルダのリンクを案内するポップアップ。
+ * リンクの先は検索しないので、リンクの場所と元のフォルダを示し、元のフォルダの登録を案内する。
+ */
+import type { UseSkippedLinksResult } from "../hooks/useSkippedLinks";
+
+const LINK_TYPE_LABELS: Record<string, string> = {
+  junction: "ジャンクション",
+  symlink: "シンボリックリンク",
+};
+
+type SkippedLinksDialogProps = {
+  links: UseSkippedLinksResult;
+};
+
+export function SkippedLinksDialog({ links }: SkippedLinksDialogProps) {
+  const { handleAcknowledgeSkippedLinks, skippedLinks } = links;
+  if (skippedLinks.length === 0) {
+    return null;
+  }
+  return (
+    <div className="rule-add-modal-backdrop">
+      <div className="rule-add-modal skipped-links-dialog" role="dialog" aria-modal="true" aria-label="検索しないフォルダの案内">
+        <h2>検索しないフォルダがあります</h2>
+        <p>
+          次のフォルダは別の場所へのリンクなので、中のファイルは検索しません。
+          検索したいときは、元のフォルダを検索対象に追加してください。
+        </p>
+        <ul className="skipped-links-list">
+          {skippedLinks.map((link) => (
+            <li key={link.link_path}>
+              <strong>{LINK_TYPE_LABELS[link.link_type] ?? link.link_type}</strong>
+              <dl>
+                <dt>リンク</dt>
+                <dd>{link.link_path}</dd>
+                <dt>元のフォルダ</dt>
+                <dd>{link.target_path}</dd>
+              </dl>
+              {link.is_covered ? <p>元のフォルダは検索対象に含まれています。追加の操作は不要です。</p> : null}
+            </li>
+          ))}
+        </ul>
+        <div className="rule-add-modal-actions">
+          <button className="secondary-button" onClick={() => void handleAcknowledgeSkippedLinks()} type="button">
+            確認しました
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/frontend/src/hooks/useSkippedLinks.ts b/frontend/src/hooks/useSkippedLinks.ts
new file mode 100644
index 0000000000000000000000000000000000000000..96720afef8e754df0c159fff79141b959e035fcc
--- /dev/null
+++ b/frontend/src/hooks/useSkippedLinks.ts
@@ -0,0 +1,44 @@
+/**
+ * 走査でたどらなかったフォルダのリンク（ジャンクション・シンボリックリンク）の案内の取得と確認。
+ * 案内は補足の情報なので、取得に失敗しても画面の操作は止めない。
+ */
+import type * as React from "react";
+import { useState } from "react";
+import { acknowledgeSkippedLinks, fetchSkippedLinks } from "../api/client";
+import type { SkippedFolderLink } from "../types";
+
+type UseSkippedLinksDeps = {
+  setErrorMessage: React.Dispatch<React.SetStateAction<string>>;
+};
+
+export function useSkippedLinks({ setErrorMessage }: UseSkippedLinksDeps) {
+  const [skippedLinks, setSkippedLinks] = useState<SkippedFolderLink[]>([]);
+
+  /** 未確認のリンクを読み直す。 */
+  async function refreshSkippedLinks(): Promise<void> {
+    try {
+      const response = await fetchSkippedLinks();
+      setSkippedLinks(response.items);
+    } catch {
+      // 次のインデックスのあとに読み直す
+    }
+  }
+
+  /** 表示中のリンクを確認済みにして閉じる。送れなければ開いたままにする。 */
+  async function handleAcknowledgeSkippedLinks(): Promise<void> {
+    try {
+      await acknowledgeSkippedLinks(skippedLinks.map((link) => link.link_path));
+      setSkippedLinks([]);
+    } catch (error) {
+      setErrorMessage(error instanceof Error ? error.message : "案内の確認を保存できませんでした。");
+    }
+  }
+
+  return {
+    handleAcknowledgeSkippedLinks,
+    refreshSkippedLinks,
+    skippedLinks,
+  } as const;
+}
+
+export type UseSkippedLinksResult = ReturnType<typeof useSkippedLinks>;
