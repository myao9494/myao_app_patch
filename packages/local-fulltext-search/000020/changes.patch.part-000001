+.skipped-links-dialog h2,
+.skipped-links-dialog p {
+  margin: 0;
+}
+
+.skipped-links-list {
+  display: grid;
+  gap: 10px;
+  margin: 0;
+  padding: 0;
+  overflow-y: auto;
+  list-style: none;
+}
+
+.skipped-links-list li {
+  display: grid;
+  gap: 6px;
+  padding: 10px 12px;
+  border: 1px solid var(--border-light);
+  border-radius: 8px;
+  background: rgba(15, 23, 42, 0.72);
+}
+
+.skipped-links-list dl {
+  display: grid;
+  grid-template-columns: max-content minmax(0, 1fr);
+  gap: 4px 12px;
+  margin: 0;
+}
+
+.skipped-links-list dd {
+  margin: 0;
+  overflow-wrap: anywhere;
+}
+
 /* 検索ルール管理の上部操作は同じ寸法にそろえる。 */
 .rule-management-panel > .section-header .menu-button,
 .rule-management-panel > .section-header .secondary-button {
@@ -701,6 +744,7 @@ h1, h2, h3 {
 
 .result-header {
   display: flex;
+  flex-wrap: wrap;
   align-items: baseline;
   justify-content: space-between;
   gap: 12px;
@@ -747,9 +791,11 @@ h1, h2, h3 {
