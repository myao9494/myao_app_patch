+def _safe_file_name(name: str) -> str:
+    """
+    ファイル名に使えない文字を置き換える。区切り文字も置き換えるので、保存先フォルダの外へは書けない。
+    長すぎる名前は保存できないので切り詰める（拡張子や連番を付ける余地を残す）。
+    """
+    return re.sub(r'[\\/:*?"<>|\x00-\x1f]', "_", name).strip()[:MAX_FILE_NAME_LENGTH].strip()
+
+
+def _reject_nul(value: str) -> str:
+    """NUL を含むパスは開けないので入力エラーにする。"""
+    if "\x00" in value:
+        raise ValueError("パスに NUL 文字は使えません")
+    return value
+
+
+PathText = Annotated[str, AfterValidator(_reject_nul)]
+
+
+def _ensure_save_dir(save_dir: Path) -> Path:
+    """保存先フォルダを用意する。作れないときは理由を付けて入力エラーにする。"""
+    try:
+        save_dir.mkdir(parents=True, exist_ok=True)
+    except OSError as error:
+        raise HTTPException(status_code=400, detail=f"保存先フォルダを作成できません: {save_dir}（{error}）") from error
+    return save_dir
+
+
