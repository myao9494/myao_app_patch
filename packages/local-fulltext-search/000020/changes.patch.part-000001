+def test_explicit_reindex_scans_a_tracked_target_without_dirty_flag(tmp_path: Path) -> None:
+    """
+    画面からの再インデックスは、変更追跡が「変更なし」と判断している対象でも走査する。
+    変更通知が届く前に押しても、追加したファイルが反映され、失敗したファイルも再試行される。
+    """
+    connection = _create_connection(tmp_path)
+    service = IndexService(connection=connection)
+    target = (tmp_path / "docs").resolve()
+    target.mkdir()
+    (target / "first.md").write_text("first", encoding="utf-8")
+    service.add_search_target(folder_path=target.as_posix(), index_depth=3)
+    service.reindex_search_targets([target.as_posix()])
+    target_id = connection.execute("SELECT id FROM targets").fetchone()[0]
+    connection.execute(
+        """
+        INSERT INTO target_change_states(target_id, is_tracking, is_dirty) VALUES (?, 1, 0)
+        ON CONFLICT(target_id) DO UPDATE SET is_tracking = 1, is_dirty = 0
+        """,
+        (target_id,),
+    )
+    connection.commit()
+    (target / "second.md").write_text("second", encoding="utf-8")
+
+    service.reindex_search_targets([target.as_posix()])
+
+    names = sorted(row["file_name"] for row in connection.execute("SELECT file_name FROM files"))
+    assert names == ["first.md", "second.md"]
diff --git a/backend/tests/test_requirements_encoding.py b/backend/tests/test_requirements_encoding.py
new file mode 100644
index 0000000000000000000000000000000000000000..e020c7ebdce197adcdcfbeb7325e8d56705b694e
--- /dev/null
+++ b/backend/tests/test_requirements_encoding.py
@@ -0,0 +1,26 @@
+"""
+requirements の文字コード宣言のテスト。
+
+Python 付属の古い pip は、文字コード宣言の無い requirements を OS の既定（日本語版 Windows は cp932）で読む。
+日本語のコメントがあると UnicodeDecodeError で導入が止まるため、先頭 2 行に UTF-8 の宣言を置く。
+pip と同じ規則（先頭 2 行の `coding[:=]`）で確かめる。
+"""
+
+import re
+from pathlib import Path
+
+import pytest
+
+BACKEND_DIR = Path(__file__).resolve().parents[1]
+ENCODING_DECLARATION = re.compile(rb"coding[:=]\s*([-\w.]+)")
+
+
+@pytest.mark.parametrize("name", ["requirements.txt", "requirements-cuda.txt"])
+def test_requirements_declare_utf8_in_the_first_two_lines(name: str) -> None:
+    raw = (BACKEND_DIR / name).read_bytes()
+    head_lines = raw.splitlines()[:2]
+
+    declared = [match.group(1) for line in head_lines if line.startswith(b"#") and (match := ENCODING_DECLARATION.search(line))]
+
+    assert declared == [b"utf-8"]
+    raw.decode("utf-8")
diff --git a/backend/tests/test_runtime_env.py b/backend/tests/test_runtime_env.py
index 495c4daaf01132ee55390b0eb11c557feb97657b..6858fb8428d4ca5888fe523f057ebc13884bb2e1 100644
--- a/backend/tests/test_runtime_env.py
+++ b/backend/tests/test_runtime_env.py
@@ -2,7 +2,7 @@
 ネイティブ数値ライブラリ実行環境設定（app.runtime_env）の単体テスト。
 
 仕様:
-- 既定のスレッド数は 1（Apple Silicon 上のスレッド競合クラッシュ防止）。
+- 既定のスレッド数は Windows がコア数の半分、それ以外が 1（Apple Silicon 上のスレッド競合クラッシュ防止）。
 - SEARCH_APP_NATIVE_THREADS に 1 以上の整数を指定した場合だけ、その値を採用する。
 - torch と faiss の OpenMP 二重初期化による異常終了を防ぐ KMP_DUPLICATE_LIB_OK を設定する。
 - 利用者が設定済みの環境変数は上書きしない。
@@ -26,6 +26,8 @@ def clean_native_env(monkeypatch: pytest.MonkeyPatch) -> pytest.MonkeyPatch:
     """スレッド関連の環境変数を未設定状態にしてから検証する。"""
     for name in (*THREAD_ENV_NAMES, "TOKENIZERS_PARALLELISM", "KMP_DUPLICATE_LIB_OK", runtime_env.NATIVE_THREADS_ENV_NAME):
         monkeypatch.delenv(name, raising=False)
+    # 既定値は OS で変わるため、macOS の既定（1）を基準に検証する
+    monkeypatch.setattr(runtime_env.sys, "platform", "darwin")
     return monkeypatch
 
 
@@ -33,6 +35,29 @@ def test_default_native_thread_count_is_one(clean_native_env: pytest.MonkeyPatch
     assert runtime_env.resolve_native_thread_count() == 1
 
 
+@pytest.mark.parametrize(
+    ("platform", "cpu_count", "expected"),
+    [
+        ("win32", 4, 2),
+        ("win32", 16, 8),
+        ("win32", 1, 1),
+        ("darwin", 16, 1),
+        ("linux", 16, 1),
+    ],
+)
+def test_default_thread_count_uses_half_of_the_cores_only_on_windows(
+    platform: str, cpu_count: int | None, expected: int
+) -> None:
+    assert runtime_env.default_native_thread_count(platform=platform, cpu_count=cpu_count) == expected
+
+
+def test_windows_default_is_used_when_the_env_is_not_set(clean_native_env: pytest.MonkeyPatch) -> None:
+    clean_native_env.setattr(runtime_env.sys, "platform", "win32")
+    clean_native_env.setattr(runtime_env.os, "cpu_count", lambda: 8)
+
+    assert runtime_env.resolve_native_thread_count() == 4
+
+
 @pytest.mark.parametrize(("raw_value", "expected"), [("4", 4), (" 8 ", 8), ("1", 1)])
 def test_native_thread_count_follows_env(clean_native_env: pytest.MonkeyPatch, raw_value: str, expected: int) -> None:
     clean_native_env.setenv(runtime_env.NATIVE_THREADS_ENV_NAME, raw_value)
diff --git a/backend/tests/test_search_cancellation.py b/backend/tests/test_search_cancellation.py
new file mode 100644
index 0000000000000000000000000000000000000000..e85bb2e54c6f3a67d8ae0e68e2a4c6ac87cf9a7b
--- /dev/null
+++ b/backend/tests/test_search_cancellation.py
@@ -0,0 +1,127 @@
+"""
+検索の切断時中断（app.api.search_cancellation）のテスト。
+クライアントが取り消した/諦めた検索をサーバーが最後まで実行し続けると、検索が滞留して
+後続の検索まで遅くなる。切断を検知したら実行中の SQLite クエリを中断し、ワーカーを空ける。
+"""
+
+from __future__ import annotations
+
+import asyncio
+import sqlite3
+import threading
+import time
+
+import pytest
+
+from app.api import search as search_api
+from app.api.search_cancellation import SearchCancelled, can_cancel_search, run_cancellable
+from app.models.search import IndexedSearchRequest, SearchRequest, SearchResponse
+
+# 数十秒かかる重いクエリ（中断されなければテストがタイムアウトする）
+HEAVY_QUERY = """
+    WITH RECURSIVE counter(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM counter WHERE n < 2000000000)
+    SELECT count(*) FROM counter
+"""
+
+
+class FakeRequest:
+    """is_disconnected だけを持つ最小のリクエスト。disconnect_after 秒後に切断済みを返す。"""
+
+    def __init__(self, disconnect_after: float | None) -> None:
+        self._deadline = None if disconnect_after is None else time.monotonic() + disconnect_after
+
+    async def is_disconnected(self) -> bool:
+        return self._deadline is not None and time.monotonic() >= self._deadline
+
+
+def _connection() -> sqlite3.Connection:
+    return sqlite3.connect(":memory:", check_same_thread=False)
+
+
+def test_result_is_returned_while_the_client_stays_connected() -> None:
+    connection = _connection()
+
+    def work() -> int:
+        time.sleep(0.3)
+        return connection.execute("SELECT 41 + 1").fetchone()[0]
+
+    result = asyncio.run(run_cancellable(FakeRequest(None), connection, work, poll_seconds=0.05))
+
+    assert result == 42
+
+
+def test_heavy_query_is_aborted_when_the_client_disconnects() -> None:
+    connection = _connection()
+    started = time.monotonic()
+
+    with pytest.raises(SearchCancelled):
+        asyncio.run(
+            run_cancellable(
+                FakeRequest(0.2),
+                connection,
+                lambda: connection.execute(HEAVY_QUERY).fetchall(),
+                poll_seconds=0.05,
+            )
+        )
+
+    assert time.monotonic() - started < 5
+
+
+def test_connection_is_usable_after_cancellation_and_after_normal_completion() -> None:
+    """中断用の progress handler を残さない（残ると以降のクエリが中断され続ける）。"""
+    connection = _connection()
+    with pytest.raises(SearchCancelled):
+        asyncio.run(
+            run_cancellable(
+                FakeRequest(0.1),
+                connection,
+                lambda: connection.execute(HEAVY_QUERY).fetchall(),
+                poll_seconds=0.05,
+            )
+        )
+    quick = "WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM c WHERE n < 300000) SELECT count(*) FROM c"
+
+    assert connection.execute(quick).fetchone()[0] == 300000
+    assert asyncio.run(run_cancellable(FakeRequest(None), connection, lambda: connection.execute(quick).fetchone()[0])) == 300000
+    assert connection.execute(quick).fetchone()[0] == 300000
+
+
+def test_errors_from_the_work_are_raised_to_the_caller() -> None:
+    connection = _connection()
+
+    def work() -> None:
+        raise ValueError("検索失敗")
+
+    with pytest.raises(ValueError, match="検索失敗"):
+        asyncio.run(run_cancellable(FakeRequest(None), connection, work, poll_seconds=0.05))
+
+
+def test_search_that_refreshes_the_index_does_not_block_the_event_loop(monkeypatch: pytest.MonkeyPatch) -> None:
+    """
+    インデックス更新を伴う検索は中断しないが、イベントループの上で実行してもいけない。
+    ループが止まると、切断の検知も他の検索の受け付けも、その検索が終わるまで止まる。
+    """
+    threads: dict[str, int] = {}
+
+    def fake_dispatch(params: SearchRequest, service: object) -> SearchResponse:
+        threads["search"] = threading.get_ident()
+        return SearchResponse(total=0, items=[])
+
+    monkeypatch.setattr(search_api, "_dispatch_search", fake_dispatch)
+
+    async def post() -> object:
+        threads["event_loop"] = threading.get_ident()
+        return await search_api.post_search(FakeRequest(None), SearchRequest(q="a"), service=object())
+
+    response = asyncio.run(post())
+
+    assert isinstance(response, SearchResponse)
+    assert threads["search"] != threads["event_loop"]
+
+
+def test_only_searches_that_do_not_refresh_the_index_can_be_cancelled() -> None:
+    """インデックス更新を伴う検索を途中で中断すると更新が中途半端になるため、中断の対象にしない。"""
+    assert can_cancel_search(IndexedSearchRequest(q="a", folder_path=""))
+    assert can_cancel_search(SearchRequest(q="a", skip_refresh=True))
+    assert can_cancel_search(SearchRequest(q="a", search_all_enabled=True))
+    assert not can_cancel_search(SearchRequest(q="a", skip_refresh=False, search_all_enabled=False))
diff --git a/backend/tests/test_search_dispatcher.py b/backend/tests/test_search_dispatcher.py
index df72e49739fe08349fe242671d27edfe1dee979b..2bcce2d6c225368f2453f5fdb59850216b8b2224 100644
--- a/backend/tests/test_search_dispatcher.py
+++ b/backend/tests/test_search_dispatcher.py
@@ -8,8 +8,13 @@
   ページ間で結果が重複・欠落しない。
 - hybrid の total は、キーワード検索とベクトル検索のどちらかに一致したファイルの数（重複なし）を返す。
   どのページを取得しても同じ値になる。
+- ベクトル検索由来の結果のパスは、キーワード検索の結果と同じ `/` 区切りで返す。
+- 日付の絞り込みはベクトル検索由来の結果にも適用する。
+- hybrid は、正規表現やファイル名・フォルダ名だけの検索ではベクトル検索を使わない。
 """
 
+from datetime import date, datetime
+import os
 from pathlib import Path
 import sqlite3
 
@@ -102,6 +107,21 @@ def _params(target: Path, **overrides: object) -> SearchQueryParams:
     return SearchQueryParams(**values)
 
 
+def test_vector_result_paths_use_forward_slashes(indexed_env, monkeypatch: pytest.MonkeyPatch) -> None:
+    """ベクトルDBが OS 既定の区切りで保存していても、結果のパスはキーワード検索と同じ `/` 区切りで返す。"""
+    target: Path = indexed_env["target"]
+    note = target / "notes" / "pear.md"
+    note.parent.mkdir()
+    note.write_text("pear tart", encoding="utf-8")
+    _use_searcher(monkeypatch, [_vector_item(note, document_id=1)])
+
+    response = dispatch_search(_params(target, search_type="vector"), indexed_env["service"])
+
+    assert [(item.full_path, item.target_path) for item in response.items] == [
+        (note.as_posix(), note.parent.as_posix())
+    ]
+
+
 def test_hybrid_vector_only_result_uses_files_table_id(indexed_env, monkeypatch: pytest.MonkeyPatch) -> None:
     """ベクトルDBの documents.id が別ファイルの files.id と同じ値でも、結果の file_id は自分自身の files.id になる。"""
     target: Path = indexed_env["target"]
@@ -405,3 +425,77 @@ def test_hybrid_search_logs_time_spent_in_each_stage(
     assert "type=hybrid" in timing_logs[0]
     for stage in ("keyword=", "vector=", "total="):
         assert stage in timing_logs[0]
+
+
+def _old_note(target: Path, name: str, text: str) -> Path:
+    """更新日が 2020 年のファイルを作る。"""
+    path = target / name
+    path.write_text(text, encoding="utf-8")
+    timestamp = datetime(2020, 6, 15, 12, 0).timestamp()
+    os.utime(path, (timestamp, timestamp))
+    return path
+
+
+@pytest.mark.parametrize("search_type", ["vector", "hybrid"])
+def test_date_filter_applies_to_vector_results(
+    indexed_env, monkeypatch: pytest.MonkeyPatch, search_type: str
+) -> None:
+    target: Path = indexed_env["target"]
+    old = _old_note(target, "dated.md", "古い本文")
+    new = target / "new.md"
+    new.write_text("新しい本文", encoding="utf-8")
+    _use_searcher(monkeypatch, [_vector_item(old, document_id=1), _vector_item(new, document_id=2)])
+
+    response = dispatch_search(
+        _params(
+            target, q="意味の検索", search_type=search_type, date_field="modified",
+            created_from=date(2020, 1, 1), created_to=date(2020, 12, 31),
+        ),
+        indexed_env["service"],
+    )
+
+    assert [item.file_name for item in response.items] == ["dated.md"]
+
+
+def test_vector_results_are_kept_without_a_date_filter(indexed_env, monkeypatch: pytest.MonkeyPatch) -> None:
+    target: Path = indexed_env["target"]
+    old = _old_note(target, "dated.md", "古い本文")
+    _use_searcher(monkeypatch, [_vector_item(old, document_id=1)])
+
+    response = dispatch_search(_params(target, q="意味の検索", search_type="vector"), indexed_env["service"])
+
+    assert [item.file_name for item in response.items] == ["dated.md"]
+
+
+@pytest.mark.parametrize(
+    "overrides",
+    [{"regex_enabled": True}, {"search_target": "filename"}, {"search_target": "folder"}, {"search_target": "filename_and_folder"}],
+    ids=["正規表現", "ファイル名", "フォルダ名", "ファイル名とフォルダ名"],
+)
+def test_hybrid_does_not_mix_vector_results_into_a_literal_search(
+    indexed_env, monkeypatch: pytest.MonkeyPatch, overrides: dict[str, object]
+) -> None:
+    target: Path = indexed_env["target"]
+    apple = target / "apple.md"
+    apple.write_text("apple pie", encoding="utf-8")
+    other = target / "other.md"
+    other.write_text("banana bread", encoding="utf-8")
+    indexed_env["index"]()
+    searcher = _use_searcher(monkeypatch, [_vector_item(other, document_id=1)])
+
+    response = dispatch_search(_params(target, search_type="hybrid", **overrides), indexed_env["service"])
+
+    assert "other.md" not in [item.file_name for item in response.items]
+    assert searcher.queries == []
+
+
+def test_hybrid_body_and_all_targets_use_vector_results(indexed_env, monkeypatch: pytest.MonkeyPatch) -> None:
+    target: Path = indexed_env["target"]
+    other = target / "other.md"
+    other.write_text("banana bread", encoding="utf-8")
+    indexed_env["index"]()
+
+    for search_target in ("all", "body"):
+        _use_searcher(monkeypatch, [_vector_item(other, document_id=1)])
+        response = dispatch_search(_params(target, search_type="hybrid", search_target=search_target), indexed_env["service"])
+        assert [item.file_name for item in response.items] == ["other.md"]
diff --git a/backend/tests/test_search_exclude_filter.py b/backend/tests/test_search_exclude_filter.py
new file mode 100644
index 0000000000000000000000000000000000000000..dfe626cbe1d0bb30e759cca8610a6ee91d414a2d
--- /dev/null
+++ b/backend/tests/test_search_exclude_filter.py
@@ -0,0 +1,53 @@
+"""
+検索結果の除外判定（search_result_items.should_exclude_search_result）の単体テスト。
+
+仕様:
+- ファイル名・ステムは matches_exclude_keyword の規則で判定する（短い英数字は語の区切りで判定する）。
+- フォルダ名・パス形式は exclude_rules の規則で判定する。対象フォルダより上の階層は判定しない。
+- Web の URL は部分一致で判定する。
+"""
+
+import pytest
+
+from app.services.search_result_items import should_exclude_search_result
+
+
+@pytest.mark.parametrize(
+    ("candidate_path", "keywords", "expected"),
+    [
+        ("/work/old.md", ["old"], True),
+        ("/work/older.md", ["old"], False),
+        ("/work/report_OLD.md", ["old"], True),
+        ("/work/digital.md", ["git"], False),
+        ("/work/gantt_diff_summary_v1.md", ["gantt_diff_summary"], True),
+        ("/work/notes.tar.gz", ["tar"], True),
+        ("/work/資料_旧版.md", ["旧"], True),
+        ("/work/.git/config", [".git"], True),
+        ("/work/repo/node_modules/a.js", ["node_modules"], True),
+        ("/work/repo/src/a.js", ["repo/src"], True),
+        ("/work/repo/lib/a.js", ["repo/src"], False),
+        ("/work/a.md", [], False),
+        ("/work/a.md", ["  "], False),
+    ],
+)
+def test_local_paths(candidate_path: str, keywords: list[str], expected: bool) -> None:
+    assert (
+        should_exclude_search_result(target_path="/work", candidate_path=candidate_path, excluded_keywords=keywords)
+        is expected
+    )
+
+
+def test_folders_above_the_target_are_not_checked() -> None:
+    assert not should_exclude_search_result(
+        target_path="/backup/work", candidate_path="/backup/work/a.md", excluded_keywords=["backup"]
+    )
+    assert should_exclude_search_result(target_path="", candidate_path="/backup/work/a.md", excluded_keywords=["backup"])
+
+
+def test_web_urls_use_substring_match() -> None:
+    assert should_exclude_search_result(
+        target_path="", candidate_path="https://example.com/Login/page", excluded_keywords=["login"]
+    )
+    assert not should_exclude_search_result(
+        target_path="", candidate_path="https://example.com/page", excluded_keywords=["login"]
+    )
diff --git a/backend/tests/test_search_local_web_scope.py b/backend/tests/test_search_local_web_scope.py
new file mode 100644
index 0000000000000000000000000000000000000000..29f4ed5f7438587a34f372e126f7f9c26f4d8e25
--- /dev/null
+++ b/backend/tests/test_search_local_web_scope.py
@@ -0,0 +1,374 @@
+"""
+source_type=local_web（WPF ランチャーの検索）の対象解決と、検索前のインデックス更新を検証する。
+
+- フォルダ未指定の local_web は、登録済みのローカルフォルダと Web URL の両方を対象にする。
+- Web 対象の更新は、検索リクエストの階層・除外語ではなく、登録時の階層と Web 用除外語で巡回する。
+- 検索方式（hybrid / vector / keyword）によらず、更新 ON なら検索の前に更新する。
+- skip_refresh / 全DB検索 / 既存DB専用検索では、どの対象も更新しない。
+"""
+
+import sqlite3
+from pathlib import Path
+
+import pytest
+
+from app.db.schema import initialize_schema
+from app.models.search import IndexedSearchRequest, SearchQueryParams
+from app.services.index_service import IndexService
+from app.services.search_dispatcher import dispatch_search
+from app.services.search_service import SearchService
+from app.services.web_browser_fetcher import BrowserWebFetcherError
+from app.vector.state import vector_state
+
+BASE_URL = "https://example.test/docs/"
+
+
+def _create_connection(tmp_path: Path) -> sqlite3.Connection:
+    connection = sqlite3.connect(tmp_path / "search.db")
+    connection.row_factory = sqlite3.Row
+    connection.execute("PRAGMA foreign_keys = ON;")
+    initialize_schema(connection)
+    return connection
+
+
+def _page(title: str, body: str, *links: str) -> str:
+    anchors = "".join(f'<a href="{link}">{link}</a>' for link in links)
+    return f"<html><head><title>{title}</title></head><body><main>{body} {anchors}</main></body></html>"
+
+
+def _serve_web_pages(monkeypatch: pytest.MonkeyPatch, pages: dict[str, str]) -> list[str]:
+    """Web ページの取得を差し替え、取得した URL の一覧を返す（実際の通信はしない）。"""
+    fetched: list[str] = []
+
+    def fetch(url: str) -> str:
+        fetched.append(url)
+        if url not in pages:
+            raise OSError(f"not found: {url}")
+        return pages[url]
+
+    monkeypatch.setattr("app.services.web_pages.fetch_web_page", fetch)
+    return fetched
+
+
+def _register_target(
+    connection: sqlite3.Connection,
+    full_path: str,
+    *,
+    source_type: str,
+    is_enabled: bool = True,
+    index_depth: int = 3,
+) -> None:
+    """検索対象の行だけを登録する（巡回はしない）。"""
+    connection.execute(
+        """
+        INSERT INTO targets(
+            full_path, last_indexed_at, exclude_keywords, index_depth, selected_extensions,
+            is_search_target_enabled, indexed_file_count, index_version, source_type, created_at, updated_at
+        ) VALUES (?, NULL, '', ?, '', ?, 0, 0, ?, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)
+        """,
+        (full_path, index_depth, 1 if is_enabled else 0, source_type),
+    )
+    connection.commit()
+
+
+def _insert_web_page(connection: sqlite3.Connection, url: str, body: str) -> None:
+    """検索対象の巡回を通さず、Web ページの行を直接投入する。"""
+    cursor = connection.execute(
+        """
+        INSERT INTO files(
+            full_path, normalized_path, file_name, file_ext, created_at, mtime, size, indexed_at, source_type
+        ) VALUES (?, ?, 'Web Page', '', 0, 0, 1, '2026-01-01T00:00:00+00:00', 'web')
+        """,
+        (url, url),
+    )
+    connection.execute(
+        "INSERT INTO file_segments(file_id, segment_type, segment_label, content) VALUES (?, 'body', 'body', ?)",
+        (cursor.lastrowid, body),
+    )
+    connection.commit()
+
+
+def _update_on_params(q: str) -> SearchQueryParams:
+    """WPF ランチャーが「更新」チェック ON で送る検索条件。"""
+    return SearchQueryParams(
+        q=q,
+        full_path="",
+        search_all_enabled=False,
+        skip_refresh=False,
+        source_type="local_web",
+        refresh_window_minutes=0,
+    )
+
+
+def test_local_web_scope_paths_include_local_and_web_targets(tmp_path: Path) -> None:
+    connection = _create_connection(tmp_path)
+    _register_target(connection, tmp_path.as_posix(), source_type="local")
+    _register_target(connection, BASE_URL, source_type="web")
+
+    service = IndexService(connection=connection)
+
+    assert service.list_search_scope_paths(source_type="local_web") == [tmp_path.resolve().as_posix(), BASE_URL]
+    assert service.list_search_scope_paths(source_type="local") == [tmp_path.resolve().as_posix()]
+    assert service.list_search_scope_paths(source_type="web") == [BASE_URL]
+
+
+def test_local_web_scope_falls_back_for_each_source_separately(tmp_path: Path) -> None:
+    """有効な対象が 0 件のときの全登録へのフォールバックは、ローカルと Web で別々に判定する。"""
+    connection = _create_connection(tmp_path)
+    disabled_folder = (tmp_path / "disabled").as_posix()
+    disabled_url = "https://example.test/disabled/"
+    _register_target(connection, disabled_folder, source_type="local", is_enabled=False)
+    _register_target(connection, BASE_URL, source_type="web")
+    _register_target(connection, disabled_url, source_type="web", is_enabled=False)
+
+    paths = IndexService(connection=connection).list_search_scope_paths(source_type="local_web")
+
+    assert paths == [Path(disabled_folder).resolve().as_posix(), BASE_URL]
+
+
+def test_update_on_search_refreshes_local_and_web_targets(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    connection = _create_connection(tmp_path)
+    folder = tmp_path / "docs"
+    folder.mkdir()
+    (folder / "note.md").write_text("alpha local body", encoding="utf-8")
+    _register_target(connection, folder.as_posix(), source_type="local")
+    _register_target(connection, BASE_URL, source_type="web")
+    _serve_web_pages(monkeypatch, {BASE_URL: _page("Docs Home", "alpha web body")})
+
+    result = SearchService(connection=connection).search(_update_on_params("alpha"))
+
+    assert result.total == 2
+    assert {item.source_type for item in result.items} == {"local", "web"}
+    assert {item.file_name for item in result.items} == {"note.md", "Docs Home"}
+    rows = connection.execute("SELECT last_indexed_at FROM targets").fetchall()
+    assert all(row["last_indexed_at"] is not None for row in rows)
+
+
+def test_update_on_search_finds_keyword_results_in_existing_index(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """Web の取得に失敗しても、既存インデックスのキーワード結果は返す。"""
+    connection = _create_connection(tmp_path)
+    _register_target(connection, BASE_URL, source_type="web")
+    _insert_web_page(connection, f"{BASE_URL}page", "alpha existing body")
+    _serve_web_pages(monkeypatch, {})
+
+    result = SearchService(connection=connection).search(_update_on_params("alpha"))
+
+    assert result.total == 1
+    assert result.items[0].source_type == "web"
+
+
+def test_update_on_search_crawls_web_target_with_its_own_depth_and_keywords(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """階層未指定の検索でも、Web 対象は登録時の階層で巡回し、ローカル用の除外語を当てない。"""
+    connection = _create_connection(tmp_path)
+    _register_target(connection, BASE_URL, source_type="web", index_depth=1)
+    service = SearchService(connection=connection)
+    service.index_service.update_app_settings(exclude_keywords="guide", web_exclude_keywords="private")
+    fetched = _serve_web_pages(
+        monkeypatch,
+        {
+            BASE_URL: _page("Home", "alpha", f"{BASE_URL}guide.html", f"{BASE_URL}private.html"),
+            f"{BASE_URL}guide.html": _page("Guide", "alpha", f"{BASE_URL}deep.html"),
+            f"{BASE_URL}private.html": _page("Private", "alpha"),
+            f"{BASE_URL}deep.html": _page("Deep", "alpha"),
+        },
+    )
+
+    service.search(_update_on_params("alpha"))
+
+    assert f"{BASE_URL}guide.html" in fetched
+    assert f"{BASE_URL}private.html" not in fetched
+    assert f"{BASE_URL}deep.html" not in fetched
+    target = connection.execute("SELECT index_depth, exclude_keywords FROM targets").fetchone()
+    assert target["index_depth"] == 1
+    assert "guide" not in target["exclude_keywords"]
+
+
+def test_web_source_search_keeps_requested_depth(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    """Web UI のように階層を明示した検索は、指定された階層で巡回する。"""
+    connection = _create_connection(tmp_path)
+    _register_target(connection, BASE_URL, source_type="web", index_depth=1)
+    fetched = _serve_web_pages(
+        monkeypatch,
+        {
+            BASE_URL: _page("Home", "alpha", f"{BASE_URL}guide.html"),
+            f"{BASE_URL}guide.html": _page("Guide", "alpha", f"{BASE_URL}deep.html"),
+            f"{BASE_URL}deep.html": _page("Deep", "alpha"),
+        },
+    )
+
+    SearchService(connection=connection).search(SearchQueryParams(q="alpha", source_type="web", index_depth=2))
+
+    assert f"{BASE_URL}deep.html" in fetched
+
+
+def test_update_on_search_survives_browser_start_failure(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    """Edge / Chrome を起動できなくても、検索は止めずに既存インデックスの結果を返す。"""
+    connection = _create_connection(tmp_path)
+    _register_target(connection, BASE_URL, source_type="web")
+    _insert_web_page(connection, f"{BASE_URL}page", "alpha existing body")
+    service = SearchService(connection=connection)
+    service.index_service.update_app_settings(web_fetch_mode="edge")
+
+    class BrokenBrowserFetcher:
+        def __init__(self, **_kwargs) -> None:
+            pass
+
+        def __enter__(self):
+            raise BrowserWebFetcherError("ブラウザを起動できません。")
+
+        def __exit__(self, *_args) -> None:
+            return None
+
+    monkeypatch.setattr("app.services.web_target_indexer.BrowserWebFetcher", BrokenBrowserFetcher)
+
+    result = service.search(_update_on_params("alpha"))
+
+    assert result.total == 1
+
+
+def test_update_off_search_never_refreshes_local_web_targets(tmp_path: Path) -> None:
+    """既定の検索（更新チェック OFF）は、ローカルも Web も走査しない。"""
+    connection = _create_connection(tmp_path)
+    _register_target(connection, BASE_URL, source_type="web")
+    _insert_web_page(connection, f"{BASE_URL}page", "alpha existing body")
+    service = SearchService(connection=connection)
+    ensure_calls: list[dict[str, object]] = []
+    service.index_service.ensure_fresh_target = lambda **kwargs: ensure_calls.append(kwargs)
+
+    skip_refresh_result = service.search(
+        SearchQueryParams(q="alpha", search_all_enabled=True, skip_refresh=True, source_type="local_web")
+    )
+    scoped_skip_refresh_result = service.search(
+        SearchQueryParams(q="alpha", search_all_enabled=False, skip_refresh=True, source_type="local_web")
+    )
+    indexed_result = service.search_existing_index(
+        IndexedSearchRequest(q="alpha", folder_path="", source_type="local_web")
+    )
+
+    assert ensure_calls == []
+    assert skip_refresh_result.total == 1
+    assert scoped_skip_refresh_result.total == 1
+    assert indexed_result.total == 1
+
+
+def test_default_web_scope_covers_crawled_siblings_but_not_disabled_targets(tmp_path: Path) -> None:
+    """
+    ページ URL を登録した Web 対象は親階層まで巡回するので、フォルダ未指定の検索範囲も親階層までにする。
+    無効な Web 対象の配下は範囲に入れない。
+    """
+    connection = _create_connection(tmp_path)
+    _register_target(connection, f"{BASE_URL}page", source_type="web")
+    _register_target(connection, "https://example.test/disabled/", source_type="web", is_enabled=False)
+    _insert_web_page(connection, f"{BASE_URL}page", "alpha target page")
+    _insert_web_page(connection, f"{BASE_URL}sibling", "alpha sibling page")
+    _insert_web_page(connection, "https://example.test/disabled/page", "alpha disabled page")
+
+    result = SearchService(connection=connection).search(
+        SearchQueryParams(q="alpha", search_all_enabled=False, skip_refresh=True, source_type="local_web")
+    )
+
+    assert {item.full_path for item in result.items} == {f"{BASE_URL}page", f"{BASE_URL}sibling"}
+
+
+def test_default_web_scope_includes_target_url_with_query(tmp_path: Path) -> None:
+    """クエリ付き URL で登録した Web 対象のページ自身も、フォルダ未指定の検索範囲に入る。"""
+    connection = _create_connection(tmp_path)
+    target_url = f"{BASE_URL}?page=1"
+    _register_target(connection, target_url, source_type="web")
+    _insert_web_page(connection, target_url, "alpha query page")
+
+    result = SearchService(connection=connection).search(
+        SearchQueryParams(q="alpha", search_all_enabled=False, skip_refresh=True, source_type="local_web")
+    )
+
+    assert [item.full_path for item in result.items] == [target_url]
+
+
+@pytest.mark.parametrize("search_type", ["hybrid", "vector", "keyword"])
+def test_update_on_search_refreshes_targets_for_every_search_type(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, search_type: str
+) -> None:
+    connection = _create_connection(tmp_path)
+    folder = tmp_path / "docs"
+    folder.mkdir()
+    (folder / "note.md").write_text("alpha local body", encoding="utf-8")
+    _register_target(connection, folder.as_posix(), source_type="local")
+    _register_target(connection, BASE_URL, source_type="web")
+    fetched = _serve_web_pages(monkeypatch, {BASE_URL: _page("Docs Home", "alpha web body")})
+    monkeypatch.setattr(vector_state, "get_searcher", lambda: None)
+
+    dispatch_search(
+        _update_on_params("alpha").model_copy(update={"search_type": search_type}),
+        SearchService(connection=connection),
+    )
+
+    assert fetched == [BASE_URL]
+    rows = connection.execute("SELECT last_indexed_at FROM targets").fetchall()
+    assert all(row["last_indexed_at"] is not None for row in rows)
+
+
+@pytest.mark.parametrize("search_type", ["hybrid", "vector", "keyword"])
+def test_update_off_search_never_refreshes_for_every_search_type(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, search_type: str
+) -> None:
+    connection = _create_connection(tmp_path)
+    _register_target(connection, BASE_URL, source_type="web")
+    fetched = _serve_web_pages(monkeypatch, {BASE_URL: _page("Docs Home", "alpha web body")})
+    monkeypatch.setattr(vector_state, "get_searcher", lambda: None)
+    service = SearchService(connection=connection)
+
+    dispatch_search(
+        IndexedSearchRequest(q="alpha", folder_path="", source_type="local_web", search_type=search_type), service
+    )
+    dispatch_search(
+        SearchQueryParams(
+            q="alpha", search_all_enabled=True, skip_refresh=True, source_type="local_web", search_type=search_type
+        ),
+        service,
+    )
+
+    assert fetched == []
+
+
+def test_vector_search_reports_refresh_flags(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    """ベクトル検索でも、裏で更新を始めたことを応答で返す。"""
+    connection = _create_connection(tmp_path)
+    service = SearchService(connection=connection)
+    monkeypatch.setattr(vector_state, "get_searcher", lambda: None)
+    monkeypatch.setattr(
+        service.refresher,
+        "refresh_target",
+        lambda **_: {"used_existing_index": True, "background_refresh_scheduled": True},
+    )
+
+    response = dispatch_search(
+        SearchQueryParams(q="alpha", full_path=tmp_path.as_posix(), search_type="vector"), service
+    )
+
+    assert response.used_existing_index is True
+    assert response.background_refresh_scheduled is True
+
+
+def test_local_web_path_match_uses_path_below_registered_folder(tmp_path: Path) -> None:
+    """ファイル名検索のパス一致は、local と同じく登録フォルダより下の相対パスだけを見る。"""
+    connection = _create_connection(tmp_path)
+    folder = tmp_path / "outerword" / "vault"
+    subfolder = folder / "innerword"
+    subfolder.mkdir(parents=True)
+    (subfolder / "note.md").write_text("alpha body", encoding="utf-8")
+    _register_target(connection, folder.as_posix(), source_type="local")
+    _register_target(connection, BASE_URL, source_type="web")
+    service = SearchService(connection=connection)
+    service.index_service.ensure_fresh_target(full_path=folder.as_posix(), refresh_window_minutes=0)
+
+    def search_total(query: str) -> int:
+        return service.search(
+            SearchQueryParams(q=query, search_all_enabled=False, skip_refresh=True, source_type="local_web")
+        ).total
+
+    assert search_total("innerword alpha") == 1
+    assert search_total("outerword alpha") == 0
diff --git a/backend/tests/test_search_page_snippets.py b/backend/tests/test_search_page_snippets.py
new file mode 100644
index 0000000000000000000000000000000000000000..2a04f00bb33cdf90d9baf4d4b621714f83bdcdc8
--- /dev/null
+++ b/backend/tests/test_search_page_snippets.py
@@ -0,0 +1,192 @@
+"""
+検索結果の本文を、表示するページの分だけ読む仕様のテスト。
+
+仕様:
+- 一致件数が多くても、スニペットを作るのは表示するページの結果だけ。
+- どの検索経路（高速ページング、全件取得、除外語つき、日本語 bi-gram、フォルダ統合）でも、
+  スニペットの内容は本文を読む位置が変わっても同じになる。
+- 除外語（`-語`）は、ファイル名・フォルダ名に加えて本文も判定する。
+- 英数字混在語の本文検索は、大文字小文字を区別しない。
+"""
+
+import sqlite3
+from pathlib import Path
+
+import pytest
+
+from app.db.schema import initialize_schema
+from app.models.search import IndexedSearchRequest, SearchQueryParams
+from app.services import search_snippets
+from app.services.search_service import SearchService
+
+
+@pytest.fixture
+def service(tmp_path: Path):
+    connection = sqlite3.connect(tmp_path / "search.db")
+    connection.row_factory = sqlite3.Row
+    initialize_schema(connection)
+    try:
+        yield SearchService(connection=connection)
+    finally:
+        connection.close()
+
+
+def _index(service: SearchService, target: Path) -> None:
+    service.index_service.ensure_fresh_target(full_path=target.as_posix(), refresh_window_minutes=0, index_depth=5)
+
+
+def _target_with_notes(tmp_path: Path, count: int) -> Path:
+    target = (tmp_path / "work").resolve()
+    target.mkdir()
+    for index in range(count):
+        (target / f"note{index}.md").write_text(f"前置き。apple 本文{index}。後書き。", encoding="utf-8")
+    return target
+
+
+def _count_snippets(monkeypatch: pytest.MonkeyPatch) -> list[str]:
+    """本文からスニペットを作った回数を記録する。"""
+    built: list[str] = []
+    original = search_snippets.resolve_snippet
+
+    def counting(**kwargs: object) -> str:
+        built.append(str(kwargs.get("file_name")))
+        return original(**kwargs)
+
+    monkeypatch.setattr(search_snippets, "resolve_snippet", counting)
+    return built
+
+
+@pytest.mark.parametrize("search_target", ["body", "all"], ids=["高速ページング", "全件取得"])
+def test_snippets_are_built_only_for_the_visible_page(
+    service: SearchService, tmp_path: Path, monkeypatch: pytest.MonkeyPatch, search_target: str
+) -> None:
+    target = _target_with_notes(tmp_path, 12)
+    _index(service, target)
+    built = _count_snippets(monkeypatch)
+
+    response = service.search(
+        SearchQueryParams(q="apple", full_path=target.as_posix(), search_all_enabled=True, search_target=search_target, limit=3)
+    )
+
+    assert response.total == 12
+    assert len(response.items) == 3
+    assert sorted(built) == sorted(item.file_name for item in response.items)
+
+
+@pytest.mark.parametrize("search_target", ["body", "all"], ids=["高速ページング", "全件取得"])
+def test_every_page_has_a_snippet_from_its_own_body(service: SearchService, tmp_path: Path, search_target: str) -> None:
+    target = _target_with_notes(tmp_path, 7)
+    _index(service, target)
+
+    seen: dict[str, str] = {}
+    for offset in (0, 3, 6):
+        response = service.search(
+            SearchQueryParams(
+                q="apple", full_path=target.as_posix(), search_all_enabled=True, search_target=search_target,
+                limit=3, offset=offset,
+            )
+        )
+        seen.update({item.file_name: item.snippet for item in response.items})
+
+    assert len(seen) == 7
+    for file_name, snippet in seen.items():
+        number = file_name.removeprefix("note").removesuffix(".md")
+        assert snippet == f"前置き。<mark>apple</mark> 本文{number}。後書き。"
+
+
+def test_include_snippets_false_returns_empty_snippets(service: SearchService, tmp_path: Path, monkeypatch) -> None:
+    target = _target_with_notes(tmp_path, 3)
+    _index(service, target)
+    built = _count_snippets(monkeypatch)
+
+    response = service.search(
+        SearchQueryParams(q="apple", full_path=target.as_posix(), search_all_enabled=True, include_snippets=False)
+    )
+
+    assert [item.snippet for item in response.items if item.result_kind == "file"] == ["", "", ""]
+    assert built == []
+
+
+def test_filename_match_without_body_hit_keeps_the_filename_message(service: SearchService, tmp_path: Path) -> None:
+    target = (tmp_path / "work").resolve()
+    target.mkdir()
+    (target / "apple.md").write_text("果物の話", encoding="utf-8")
+    _index(service, target)
+
+    response = service.search(SearchQueryParams(q="apple", full_path=target.as_posix(), search_all_enabled=True))
+
+    assert response.items[0].snippet.startswith("ファイル名一致: <mark>apple.md</mark>")
+
+
+def test_body_only_search_uses_the_body_even_if_the_name_also_matches(service: SearchService, tmp_path: Path) -> None:
+    target = (tmp_path / "work").resolve()
+    target.mkdir()
+    (target / "apple.md").write_text("apple の本文", encoding="utf-8")
+    _index(service, target)
+
+    response = service.search(
+        SearchQueryParams(q="apple", full_path=target.as_posix(), search_all_enabled=True, search_target="body")
+    )
+
+    assert response.items[0].snippet == "<mark>apple</mark> の本文"
+
+
+def test_japanese_partial_match_snippet_comes_from_the_body(service: SearchService, tmp_path: Path) -> None:
+    target = (tmp_path / "work").resolve()
+    target.mkdir()
+    (target / "food.md").write_text("今日はお寿司を食べた", encoding="utf-8")
+    _index(service, target)
+
+    response = service.search(SearchQueryParams(q="寿司", full_path=target.as_posix(), search_all_enabled=True))
+
+    assert [item.snippet for item in response.items] == ["今日はお<mark>寿司</mark>を食べた"]
+
+
+def test_negative_term_in_body_excludes_the_file(service: SearchService, tmp_path: Path) -> None:
+    target = (tmp_path / "work").resolve()
+    target.mkdir()
+    (target / "keep.md").write_text("apple only", encoding="utf-8")
+    (target / "drop.md").write_text("apple and banana", encoding="utf-8")
+    _index(service, target)
+
+    response = service.search(SearchQueryParams(q="apple -banana", full_path=target.as_posix(), search_all_enabled=True))
+
+    assert [item.file_name for item in response.items] == ["keep.md"]
+    assert response.items[0].snippet == "<mark>apple</mark> only"
+
+
+def test_negative_only_query_checks_the_body(service: SearchService, tmp_path: Path) -> None:
+    target = (tmp_path / "work").resolve()
+    target.mkdir()
+    (target / "keep.md").write_text("apple only", encoding="utf-8")
+    (target / "drop.md").write_text("banana here", encoding="utf-8")
+    _index(service, target)
+
+    response = service.search(SearchQueryParams(q="-banana", full_path=target.as_posix(), search_all_enabled=True))
+
+    assert [item.file_name for item in response.items] == ["keep.md"]
+
+
+def test_literal_body_search_ignores_ascii_case(service: SearchService, tmp_path: Path) -> None:
+    """`mp3` のような英数字混在語は LIKE で探す。本文の大文字とも一致する。"""
+    target = (tmp_path / "work").resolve()
+    target.mkdir()
+    (target / "song.md").write_text("形式は MP3 です", encoding="utf-8")
+    _index(service, target)
+
+    response = service.search(SearchQueryParams(q="mp3", full_path=target.as_posix(), search_all_enabled=True))
+
+    assert [item.snippet for item in response.items] == ["形式は <mark>MP3</mark> です"]
+
+
+def test_existing_index_search_returns_snippets(service: SearchService, tmp_path: Path) -> None:
+    """ランチャーの既存DB検索も同じ結果を返す。"""
+    target = _target_with_notes(tmp_path, 2)
+    _index(service, target)
+
+    response = service.search_existing_index(IndexedSearchRequest(q="apple", folder_path=target.as_posix(), limit=8))
+
+    assert sorted(item.snippet for item in response.items) == [
+        "前置き。<mark>apple</mark> 本文0。後書き。",
+        "前置き。<mark>apple</mark> 本文1。後書き。",
+    ]
diff --git a/backend/tests/test_search_result_items_exclusion.py b/backend/tests/test_search_result_items_exclusion.py
new file mode 100644
index 0000000000000000000000000000000000000000..ec6a83f2d9e090a98a33e2476a4dbc8f356b9a31
--- /dev/null
+++ b/backend/tests/test_search_result_items_exclusion.py
@@ -0,0 +1,57 @@
+"""
+検索結果の除外判定（search_result_items.should_exclude_search_result）のテスト。
+結果1件ごとに呼ばれるため、実ファイルシステムへ触れず（Path.resolve を呼ばず）、結果が変わらないことを確かめる。
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from app.services import search_result_items
+
+
+def _exclude(candidate: str, keywords: list[str], target: str = "") -> bool:
+    return search_result_items.should_exclude_search_result(
+        target_path=target,
+        candidate_path=candidate,
+        excluded_keywords=keywords,
+    )
+
+
+@pytest.fixture
+def forbid_resolve(monkeypatch):
+    """DB 保存済みの正規化済みパスを再度 resolve（実ファイルへのアクセス）しないことを保証する。"""
+
+    def fail(self, *args, **kwargs):
+        raise AssertionError(f"Path.resolve が呼ばれた: {self}")
+
+    monkeypatch.setattr(Path, "resolve", fail)
+
+
+def test_exclusion_does_not_touch_the_filesystem(forbid_resolve) -> None:
+    keywords = ["draft", "node_modules"]
+    assert _exclude("/no/such/dir/draft/a.md", keywords)
+    assert _exclude("/no/such/dir/node_modules/pkg/a.md", keywords, target="/no/such/dir")
+    assert not _exclude("/no/such/dir/notes/a.md", keywords)
+    assert not _exclude("/no/such/dir/notes/a.md", keywords, target="/no/such/dir")
+
+
+def test_exclusion_results_are_unchanged() -> None:
+    keywords = ["draft", "~$", "アーカイブ", "/no/such/dir/private"]
+    assert _exclude("/no/such/dir/draft_v2/a.md", keywords)  # `_` は語の区切り
+    assert not _exclude("/no/such/dir/drafty/a.md", keywords)  # 語の一部だけの一致は除外しない
+    assert _exclude("/no/such/dir/draft/a.md", keywords)
+    assert _exclude("/no/such/dir/~$tmp.docx", keywords)
+    assert _exclude("/no/such/dir/2024アーカイブ/a.md", keywords)
+    assert _exclude("/no/such/dir/private/a.md", keywords)
+    assert not _exclude("/no/such/dir/privately/a.md", keywords)
+    assert _exclude("https://example.com/draft/page", ["draft"])
+    assert not _exclude("https://example.com/page", ["draft"])
+
+
+def test_target_folder_name_itself_is_not_matched_as_excluded() -> None:
+    """検索対象フォルダ自身の名前に除外語があっても、その配下の相対パスだけで判定する。"""
+    assert not _exclude("/no/such/draft/notes/a.md", ["draft"], target="/no/such/draft")
+    assert _exclude("/no/such/draft/draft/a.md", ["draft"], target="/no/such/draft")
