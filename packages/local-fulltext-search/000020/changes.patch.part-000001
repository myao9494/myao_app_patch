+/* たどらなかったフォルダのリンクの案内。パスは長いので折り返し、多いときは一覧だけスクロールする */
+.skipped-links-dialog {
+  width: min(640px, 100%);
+  max-height: calc(100vh - 40px);
+  grid-template-rows: auto auto minmax(0, 1fr) auto;
+}
