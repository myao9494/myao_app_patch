                 mock_load.assert_called_once()
     finally:
         vector_state.embedder = orig_embedder
diff --git a/backend/tests/test_vector_embedder.py b/backend/tests/test_vector_embedder.py
index 3d80f784287a2595d652cbe772e993b1478e70cc..b558de8588e4afc10bc2ab9fd4253a00248ba3f8 100644
--- a/backend/tests/test_vector_embedder.py
+++ b/backend/tests/test_vector_embedder.py
@@ -13,6 +13,7 @@ from app.vector.embedder import (
     MockEmbedder,
     auto_detect_device,
 )
+from app.vector.inference_gate import InferenceGate
 
 
 def test_auto_detect_device() -> None:
@@ -50,6 +51,36 @@ def test_embedder_invalid_path() -> None:
         Embedder("/non/existent/model/path")
 
 
+@pytest.mark.parametrize(
+    ("device", "expected_slices"),
+    [("cpu", [1] * 10), ("cuda", [8, 2]), ("mps", [8, 2])],
+)
+def test_batch_slice_size_depends_on_the_device(device: str, expected_slices: list[int]) -> None:
+    """
+    CPU は 1 件ずつ推論する（検索クエリの待ちが最短になり、パディングが減って総時間も短い）。
+    GPU はまとめて推論したほうが速いので区切りを大きくする。
+    """
+    slice_sizes: list[int] = []
+
+    class RecordingModel:
+        def encode(self, sentences, **kwargs):
+            slice_sizes.append(len(sentences))
+            return np.zeros((len(sentences), 4))
+
+    embedder = Embedder.__new__(Embedder)
+    embedder.device = device
+    embedder.model = RecordingModel()
+    embedder.is_ruri = False
+    embedder.is_e5 = False
+    embedder._dim = 4
+    embedder._gate = InferenceGate()
+
+    vectors = embedder.encode_batch([f"文書 {index}" for index in range(10)])
+
+    assert vectors.shape == (10, 4)
+    assert slice_sizes == expected_slices
+
+
 _RURI_30M_PATH = Path(__file__).resolve().parents[2] / "models" / "ruri-v3-30m"
 
 
