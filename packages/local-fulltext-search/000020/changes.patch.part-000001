+def _folder_link_type(entry: os.DirEntry[str]) -> str | None:
+    """
+    エントリがフォルダへのリンクなら種類を返す。
+    DirEntry.is_junction は Python 3.12 以降にしかないので、リパースポイントの種別で判定する。
+    """
