+    target_path = os.path.realpath(entry.path)
+    if not os.path.isdir(target_path):
+        return
+    link_path = Path(entry.path).as_posix()
+    skipped_links[link_path] = SkippedLink(link_path, Path(target_path).as_posix(), link_type)
+
