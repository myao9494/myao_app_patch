+def test_data_file_paths_are_resolved_only_once(monkeypatch, tmp_path: Path) -> None:
+    """
+    設定は検索のたびに読むため、同じパスの解決を繰り返さない（Windows の resolve は 1 回で数ミリ秒かかる）。
+    """
+    settings = Settings(data_dir=tmp_path)
+    original_resolve = Path.resolve
+    resolved: list[Path] = []
+
+    def counting_resolve(self: Path, strict: bool = False) -> Path:
+        resolved.append(self)
+        return original_resolve(self, strict)
+
+    monkeypatch.setattr(Path, "resolve", counting_resolve)
+
+    first = settings.exclude_keywords_path
+    second = settings.exclude_keywords_path
+
+    assert first == second == tmp_path.resolve() / "exclude_keywords.txt"
+    assert resolved.count(tmp_path / "exclude_keywords.txt") <= 1
+
+
+def test_data_file_paths_follow_the_current_data_dir(tmp_path: Path) -> None:
+    """
+    解決結果の再利用が、保存先の変更を隠さない。
+    """
+    settings = Settings(data_dir=tmp_path / "a")
+    assert settings.database_path == (tmp_path / "a" / "search.db").resolve()
+
+    settings.data_dir = tmp_path / "b"
+
+    assert settings.database_path == (tmp_path / "b" / "search.db").resolve()
+
+
+def test_ensure_data_dir_creates_the_folder_only_when_missing(monkeypatch, tmp_path: Path) -> None:
+    """
+    設定の読み込みごとに呼ばれるため、フォルダがあれば作成を試みない。無ければ親ごと作る。
+    """
+    data_dir = tmp_path / "parent" / "data"
+    monkeypatch.setattr(app_settings, "data_dir", data_dir)
+
+    ensure_data_dir()
+    assert data_dir.is_dir()
+
+    def fail_mkdir(self: Path, *args: object, **kwargs: object) -> None:
+        raise AssertionError("既にあるフォルダを作ろうとした")
+
+    monkeypatch.setattr(Path, "mkdir", fail_mkdir)
+    ensure_data_dir()
+
+
 def test_settings_database_name_rejects_path_segments() -> None:
     """
     database_name にはファイル名のみを許可し、パス区切りを混入させない。
diff --git a/backend/tests/test_excalidraw_index_text.py b/backend/tests/test_excalidraw_index_text.py
new file mode 100644
index 0000000000000000000000000000000000000000..50540d49a2180389ff65aeaa9f538ff30362b634
--- /dev/null
+++ b/backend/tests/test_excalidraw_index_text.py
@@ -0,0 +1,148 @@
+"""
+Excalidraw の図データを検索本文へ入れない仕様のテスト。
+
+Excalidraw のノートの大半は図の JSON と貼り付け画像の base64 で、実データでは 1 件 1,500 万文字のうち
+文章は約 9,000 文字だった。これを検索本文へ入れると、英数字の短い語が base64 に偶然一致し、
+索引も大きくなる。
+
+仕様:
+- `## Drawing` 以降（JSON・compressed-json）は検索本文に入れない。
+- `## Text Elements`（図の中の文字）とフロントマター、見出しより前の本文は検索できる。
+- 普通の Markdown に `## Drawing` という見出しがあっても削らない。
+- `.excalidraw`（JSON）は図形の文字を検索でき、埋め込み画像（`data:` の値）は入れない。
+- ベクトルインデックスは `chunker` が `# Excalidraw Data` 以降をまとめて除く（図の中の文字も入らない）。
+- 作成済みのインデックスは、ファイルが変わっていなくても版の更新で 1 度だけ作り直す。
+"""
+
+import json
+import sqlite3
+from pathlib import Path
+
+import pytest
+
+from app.db.schema import initialize_schema
+from app.extractors.text_extractor import extract_text
+from app.services.index_service import IndexService
+from app.services.search_target_store import CURRENT_TARGET_INDEX_VERSION
+from app.vector.db import open_db
+from app.vector.state import VectorState
+
+BASE64 = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg" * 40
+
+
+def _excalidraw_note(drawing_block: str) -> str:
+    return (
+        "---\n\nexcalidraw-plugin: parsed\ntags: [excalidraw]\n\n---\n"
+        "==⚠  Switch to EXCALIDRAW VIEW ==\n\n\n"
+        "# Excalidraw Data\n\n"
+        "## Text Elements\n"
+        "受注から出荷までの流れ ^abc123\n\n"
+        "## Embedded Files\n"
+        "deadbeef: [[pasted.png]]\n\n"
+        "%%\n"
+        "## Drawing\n"
+        f"{drawing_block}\n"
+        "%%\n"
+    )
+
+
+JSON_DRAWING = '```json\n{"type":"excalidraw","files":{"a":{"dataURL":"data:image/png;base64,' + BASE64 + '"}}}\n```'
+COMPRESSED_DRAWING = "```compressed-json\nN4IgLgngDgpiBcIYA" + BASE64 + "\n```"
+
+
+@pytest.mark.parametrize("drawing", [JSON_DRAWING, COMPRESSED_DRAWING], ids=["json", "compressed-json"])
+@pytest.mark.parametrize("file_name", ["図.excalidraw.md", "図.md"])
+def test_drawing_section_is_left_out_and_text_elements_are_kept(tmp_path: Path, file_name: str, drawing: str) -> None:
+    path = tmp_path / file_name
+    path.write_text(_excalidraw_note(drawing), encoding="utf-8")
+
+    text = extract_text(path)
+
+    assert "受注から出荷までの流れ" in text
+    assert "pasted.png" in text
+    assert "iVBORw0KGgo" not in text
+    assert "## Drawing" not in text
+    assert len(text) < 400
+
+
+def test_ordinary_markdown_with_a_drawing_heading_is_kept(tmp_path: Path) -> None:
+    path = tmp_path / "製図.md"
+    path.write_text("# 製図の手順\n\n## Drawing\nこの見出しの本文は検索できる\n\n## 次の章\n続きの本文\n", encoding="utf-8")
+
+    text = extract_text(path)
+
+    assert "この見出しの本文は検索できる" in text
+    assert "続きの本文" in text
+
+
+def test_excalidraw_json_keeps_text_and_drops_embedded_images(tmp_path: Path) -> None:
+    path = tmp_path / "図.excalidraw"
+    path.write_text(
+        json.dumps(
+            {
+                "type": "excalidraw",
+                "elements": [{"type": "text", "text": "受注の流れ"}],
+                "files": {"a": {"mimeType": "image/png", "dataURL": f"data:image/png;base64,{BASE64}"}},
+            }
+        ),
+        encoding="utf-8",
+    )
+
+    text = extract_text(path)
+
+    assert "受注の流れ" in text
+    assert "iVBORw0KGgo" not in text
+
+
+def test_vector_index_does_not_embed_the_drawing(tmp_path: Path) -> None:
+    folder = tmp_path / "notes"
+    folder.mkdir()
+    (folder / "図.excalidraw.md").write_text(_excalidraw_note(JSON_DRAWING), encoding="utf-8")
+    state = VectorState(data_dir=tmp_path)
+    state.load_model(use_mock=True, mock_dim=32)
+
+    state.sync_index(target_folders=[str(folder)], exclude_keywords="")
+
+    with open_db(state.searcher.db_path) as connection:
+        chunks = [str(row[0]) for row in connection.execute("SELECT text FROM chunks")]
+    assert chunks
+    assert not any("iVBORw0KGgo" in chunk for chunk in chunks)
+    assert len(chunks) <= 2
+
+
+def _connect(tmp_path: Path) -> sqlite3.Connection:
+    connection = sqlite3.connect(tmp_path / "search.db")
+    connection.row_factory = sqlite3.Row
+    initialize_schema(connection)
+    return connection
+
+
+def _body(connection: sqlite3.Connection) -> str:
+    row = connection.execute("SELECT content FROM file_segments WHERE segment_type = 'body'").fetchone()
+    return str(row["content"])
+
+
+def test_existing_index_is_rebuilt_once_without_a_file_change(tmp_path: Path) -> None:
+    connection = _connect(tmp_path)
+    service = IndexService(connection=connection)
+    target = (tmp_path / "work").resolve()
+    target.mkdir()
+    (target / "図.excalidraw.md").write_text(_excalidraw_note(JSON_DRAWING), encoding="utf-8")
+    service.ensure_fresh_target(full_path=target.as_posix(), refresh_window_minutes=0, index_depth=5)
+    # 以前の版で作った状態（図データ入りの本文、古い版番号）を再現する
+    connection.execute("UPDATE file_segments SET content = ? WHERE segment_type = 'body'", (f"old {BASE64}",))
+    connection.execute("UPDATE targets SET index_version = ?", (CURRENT_TARGET_INDEX_VERSION - 1,))
+    connection.commit()
+
+    service.ensure_fresh_target(full_path=target.as_posix(), refresh_window_minutes=0, index_depth=5)
+
+    assert "iVBORw0KGgo" not in _body(connection)
+    assert "受注から出荷までの流れ" in _body(connection)
+    assert int(connection.execute("SELECT index_version FROM targets").fetchone()[0]) == CURRENT_TARGET_INDEX_VERSION
+
+    # 版が最新になったあとは、変更の無いファイルを読み直さない
+    connection.execute("UPDATE file_segments SET content = 'kept' WHERE segment_type = 'body'")
+    connection.commit()
+    service.ensure_fresh_target(full_path=target.as_posix(), refresh_window_minutes=0, index_depth=5)
+    assert _body(connection) == "kept"
+    connection.close()
diff --git a/backend/tests/test_exclude_keyword_index_safety.py b/backend/tests/test_exclude_keyword_index_safety.py
new file mode 100644
index 0000000000000000000000000000000000000000..936b0cb02ba6d86bc96078894ce1932f2b2e3166
--- /dev/null
+++ b/backend/tests/test_exclude_keyword_index_safety.py
@@ -0,0 +1,154 @@
+"""
+除外キーワードの保存が、許可なくインデックスを消さないことのテスト。
+
+検索ルール画面の除外キーワードは入力すると自動で保存される。保存のたびに既存インデックスを消すと、
+入力の途中の語や誤入力で、再作成に何時間もかかるベクトルインデックスまで失う。
+
+仕様:
+- 除外キーワードの保存だけでは、全文インデックスもベクトルインデックスも削除しない。
+- 除外したファイルは、検索のときの絞り込みで結果から外す（全文検索・フォルダ指定の検索・ベクトル検索）。
+- キーワードを戻せば、再走査を待たずに検索へ戻る。
+- 既存インデックスを消すのは clean_excluded_files=True のときだけ。
+- 除外の判定は検索対象フォルダより下の階層だけで行う。対象フォルダの親の名前には一致させない
+  （親が `old_work` のとき、除外語 `old` で全件が消えたり隠れたりしないようにする）。
+"""
+
+import sqlite3
+from pathlib import Path
+
+import pytest
+
+from app.config import settings
+from app.db.schema import initialize_schema
+from app.models.search import IndexedSearchRequest, SearchQueryParams
+from app.services.index_service import IndexService
+from app.services.search_dispatcher import dispatch_search
+from app.services.search_service import SearchService
+from app.vector.db import get_all_documents_metadata, get_model_db_path
+from app.vector.state import VectorState, vector_state
+
+
+@pytest.fixture
+def env(tmp_path: Path, monkeypatch: pytest.MonkeyPatch):
+    """親に `old_work` を持つフォルダを全文インデックス済みにした環境を返す。"""
+    data_dir = tmp_path / "data"
+    data_dir.mkdir()
+    monkeypatch.setattr(settings, "data_dir", data_dir)
+    connection = sqlite3.connect(tmp_path / "search.db")
+    connection.row_factory = sqlite3.Row
+    initialize_schema(connection)
+    service = SearchService(connection=connection)
+    target = (tmp_path / "old_work" / "notes").resolve()
+    target.mkdir(parents=True)
+    (target / "keep.md").write_text("zebra keep", encoding="utf-8")
+    (target / "secret.md").write_text("zebra secret", encoding="utf-8")
+    index_service = service.index_service
+    index_service.add_search_target(folder_path=target.as_posix(), index_depth=5)
+    index_service.update_app_settings(exclude_keywords="")
+    index_service.ensure_fresh_target(full_path=target.as_posix(), refresh_window_minutes=0, index_depth=5, exclude_keywords="")
+    try:
+        yield {"service": service, "index": index_service, "connection": connection, "target": target, "data_dir": data_dir}
+    finally:
+        connection.close()
+
+
+def _names(env: dict, **overrides: object) -> list[str]:
+    values: dict[str, object] = {"q": "zebra", "search_all_enabled": True, "search_target": "all", "search_type": "keyword"}
+    values.update(overrides)
+    response = dispatch_search(SearchQueryParams(**values), env["service"])
+    return sorted(item.file_name for item in response.items if item.result_kind == "file")
+
+
+def _indexed_names(env: dict) -> list[str]:
+    rows = env["connection"].execute("SELECT file_name FROM files ORDER BY file_name").fetchall()
+    return [str(row["file_name"]) for row in rows]
+
+
+def test_saving_a_keyword_hides_results_but_keeps_the_index(env: dict) -> None:
+    env["index"].update_app_settings(exclude_keywords="secret")
+
+    assert _indexed_names(env) == ["keep.md", "secret.md"]
+    assert _names(env) == ["keep.md"]
+
+
+def test_removing_the_keyword_brings_results_back_without_a_rescan(env: dict) -> None:
+    env["index"].update_app_settings(exclude_keywords="secret")
+    env["index"].update_app_settings(exclude_keywords="")
+
+    assert _names(env) == ["keep.md", "secret.md"]
+
+
+@pytest.mark.parametrize("search_target", ["all", "body", "filename"])
+def test_folder_scoped_search_also_hides_excluded_files(env: dict, search_target: str) -> None:
+    env["index"].update_app_settings(exclude_keywords="secret")
+
+    names = _names(env, search_all_enabled=False, skip_refresh=True, full_path=env["target"].as_posix(), search_target=search_target)
+
+    assert "secret.md" not in names
+
+
+def test_ignored_full_path_is_hidden_in_folder_scoped_search(env: dict) -> None:
+    """検索結果の「無視」はフルパスを除外キーワードへ追加する。"""
+    env["index"].update_app_settings(exclude_keywords=(env["target"] / "secret.md").as_posix())
+
+    names = _names(env, search_all_enabled=False, skip_refresh=True, full_path=env["target"].as_posix())
+
+    assert names == ["keep.md"]
+
+
+def test_launcher_search_hides_excluded_files(env: dict) -> None:
+    env["index"].update_app_settings(exclude_keywords="secret")
+
+    response = dispatch_search(IndexedSearchRequest(q="zebra", folder_path="", search_type="keyword"), env["service"])
+
+    assert [item.file_name for item in response.items] == ["keep.md"]
+
+
+def test_regex_search_hides_excluded_files(env: dict) -> None:
+    env["index"].update_app_settings(exclude_keywords="secret")
+
+    assert _names(env, q="zeb.a", regex_enabled=True) == ["keep.md"]
+
+
+def test_explicit_cleanup_removes_only_matching_rows(env: dict) -> None:
+    env["index"].update_app_settings(exclude_keywords="secret", clean_excluded_files=True)
+
+    assert _indexed_names(env) == ["keep.md"]
+
+
+def test_keyword_matching_a_parent_folder_does_not_hide_anything(env: dict) -> None:
+    """検索対象の親の名前（old_work の old）は除外の判定に使わない。"""
+    env["index"].update_app_settings(exclude_keywords="old")
+
+    assert _names(env) == ["keep.md", "secret.md"]
+    response = dispatch_search(IndexedSearchRequest(q="zebra", folder_path="", search_type="keyword"), env["service"])
+    assert len(response.items) == 2
+
+
+def test_cleanup_with_a_keyword_matching_a_parent_folder_deletes_nothing(env: dict) -> None:
+    env["index"].update_app_settings(exclude_keywords="old", clean_excluded_files=True)
+
+    assert _indexed_names(env) == ["keep.md", "secret.md"]
+
+
+def test_vector_search_hides_excluded_files_and_keeps_vectors(env: dict, monkeypatch: pytest.MonkeyPatch) -> None:
+    state = VectorState(data_dir=env["data_dir"])
+    state.load_model(use_mock=True, mock_dim=32)
+    state.sync_index(target_folders=[env["target"].as_posix()], exclude_keywords="", force=True)
+    db_path = get_model_db_path("mock_model", data_dir=env["data_dir"])
+    assert len(get_all_documents_metadata(db_path)) == 2
+    monkeypatch.setattr(vector_state, "get_searcher", state.get_searcher)
+
+    env["index"].update_app_settings(exclude_keywords="secret")
+
+    assert len(get_all_documents_metadata(db_path)) == 2
+    response = dispatch_search(
+        SearchQueryParams(q="zebra", search_all_enabled=True, search_type="vector", skip_refresh=True), env["service"]
+    )
+    assert [item.file_name for item in response.items] == ["keep.md"]
+
+    env["index"].update_app_settings(exclude_keywords="old")
+    response = dispatch_search(
+        SearchQueryParams(q="zebra", search_all_enabled=True, search_type="vector", skip_refresh=True), env["service"]
+    )
+    assert sorted(item.file_name for item in response.items) == ["keep.md", "secret.md"]
diff --git a/backend/tests/test_exclude_rules.py b/backend/tests/test_exclude_rules.py
index 175ab833aa79fc54c9a2102f9181828d1be644cd..dae5dcb7dc327f5f5c3a2ecda1b1364855ccda10 100644
--- a/backend/tests/test_exclude_rules.py
+++ b/backend/tests/test_exclude_rules.py
@@ -36,3 +36,27 @@ def test_single_symbol_and_dot_only_keywords_do_not_match_as_substring() -> None
     assert not _is_excluded("/docs/report-final.md", ["-"])
     assert not _is_excluded("/docs/a.b..md", [".."])
     assert _is_excluded("/docs/-/a.md", ["-"])
+
+
+def test_same_keywords_are_compiled_only_once_across_many_paths(monkeypatch) -> None:
+    """検索結果1件ごとに除外キーワードを再コンパイルしない（件数に比例して検索が遅くなるため）。"""
+    calls = {"count": 0}
+    original = exclude_rules.compile_exclude_keywords
+
+    def counting_compile(keywords):
+        calls["count"] += 1
+        return original(keywords)
+
+    monkeypatch.setattr(exclude_rules, "compile_exclude_keywords", counting_compile)
+    keywords = ["unique-cache-probe-old", "アーカイブ"]
+    results = [_is_excluded(f"/docs/dir{index}/a.md", keywords) for index in range(50)]
+
+    assert results == [False] * 50
+    assert calls["count"] == 1
+    assert _is_excluded("/docs/unique-cache-probe-old/a.md", keywords)
+
+
+def test_changed_keywords_are_recompiled() -> None:
+    """キーワード列が変わったら、以前の列の結果を使い回さない。"""
+    assert _is_excluded("/docs/draft/a.md", ["draft"])
+    assert not _is_excluded("/docs/draft/a.md", ["other-keyword"])
diff --git a/backend/tests/test_export_file_names.py b/backend/tests/test_export_file_names.py
new file mode 100644
index 0000000000000000000000000000000000000000..acc9cd5bdf8b07be46dd618ed54979518fdef8ef
--- /dev/null
+++ b/backend/tests/test_export_file_names.py
@@ -0,0 +1,70 @@
+"""
+AIインプットの保存・ダウンロードのファイル名のテスト。
+
+仕様:
+- ダウンロードは日本語の題名でも失敗しない（HTTP ヘッダーは ASCII なので RFC 5987 の filename* で渡す）。
+- 保存のファイル名に区切り文字があっても、保存先フォルダの外へ書かない。
+"""
+
+from pathlib import Path
+from urllib.parse import quote
+
+import pytest
+from fastapi.testclient import TestClient
+
+from app.main import create_app
+
+
+@pytest.fixture
+def client() -> TestClient:
+    return TestClient(create_app())
+
+
+@pytest.fixture
+def note(tmp_path: Path) -> Path:
+    path = tmp_path / "note.md"
+    path.write_text("# 見出し\n本文\n", encoding="utf-8")
+    return path
+
+
+def test_download_accepts_a_japanese_title(client: TestClient, note: Path) -> None:
+    response = client.post("/api/export/ai-html/download", json={"file_paths": [note.as_posix()], "title": "検証ドキュメント"})
+
+    assert response.status_code == 200
+    disposition = response.headers["content-disposition"]
+    assert f"filename*=UTF-8''{quote('検証ドキュメント.html')}" in disposition
+    assert disposition.isascii()
+
+
+def test_download_keeps_an_ascii_title(client: TestClient, note: Path) -> None:
+    response = client.post("/api/export/ai-html/download", json={"file_paths": [note.as_posix()], "title": "plain"})
+
+    assert response.status_code == 200
+    assert 'filename="plain.html"' in response.headers["content-disposition"]
+
+
+@pytest.mark.parametrize(
+    "file_name", ["..\\外.html", "../外.html", "a\\b.html", "a/b.html", "C:\\外.html", "制御\x08文字.html"]
+)
+def test_saved_html_stays_in_the_target_folder(client: TestClient, tmp_path: Path, file_name: str) -> None:
+    target = (tmp_path / "out").resolve()
+
+    response = client.post(
+        "/api/export/ai-html/save", json={"html_content": "<p>x</p>", "file_name": file_name, "target_dir": target.as_posix()}
+    )
+
+    assert response.status_code == 200
+    assert Path(response.json()["saved_path"]).parent == target
+
+
+@pytest.mark.parametrize("file_name", ["..\\外.html", "../外.html", "a\\b.html"])
+def test_saved_html_parts_stay_in_the_target_folder(client: TestClient, tmp_path: Path, file_name: str) -> None:
+    target = (tmp_path / "out").resolve()
+
+    response = client.post(
+        "/api/export/ai-html/save-parts",
+        json={"html_parts": ["<p>1</p>", "<p>2</p>"], "file_name": file_name, "target_dir": target.as_posix()},
+    )
+
+    assert response.status_code == 200
+    assert {Path(path).parent for path in response.json()["saved_paths"]} == {target}
diff --git a/backend/tests/test_file_walker.py b/backend/tests/test_file_walker.py
