+    return any(_is_excluded_name_cached(part, keyword_set, substring_tuple) for part in path.parts)
+
+
+@lru_cache(maxsize=8192)
+def _is_excluded_name_cached(name: str, keyword_set: frozenset[str], substring_keywords: tuple[str, ...]) -> bool:
+    """同じフォルダ名は多数の検索結果のパスに繰り返し現れるため、名前単位の判定結果を使い回す。"""
+    return is_excluded_name(name, keyword_set, list(substring_keywords))
 
 
