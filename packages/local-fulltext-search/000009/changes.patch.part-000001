index 59a6b020c6e5e7782db10817c76edfff2394d53d..add173a8421befb6e4b94db91ec4a6b6738dbf0c 100644
--- a/backend/app/vector/html_exporter.py
+++ b/backend/app/vector/html_exporter.py
@@ -866,10 +866,65 @@ def parse_js_array_or_json(js_code_str: str) -> Optional[List[Dict[str, Any]]]:
     return None
 
 
-def convert_dataview_blocks_to_html(markdown_text: str) -> str:
+def strip_email_cc_lines(text: str, is_html: bool = False) -> str:
+    """
+    メール本文（プレーンテキストまたはHTML）からCc行・Ccブロックを自動除去する。
+    """
+    if not text:
+        return ""
+
+    if is_html:
+        # 1. <tr><th>Cc:</th><td>...</td></tr>
+        cleaned = re.sub(
+            r"<tr\b[^>]*>[\s\S]*?<t[hd][^>]*>[\s\S]*?(?:cc|ｃｃ)\s*[:：][\s\S]*?</t[hd]>[\s\S]*?</tr>",
+            "",
+            text,
+            flags=re.IGNORECASE,
+        )
+        # 2. <p> または <div> が Cc 行単体で構成されている場合
+        cleaned = re.sub(
+            r"<(?:p|div)\b[^>]*>\s*<b>\s*(?:cc|ｃｃ)\s*[:：]</b>[\s\S]*?</(?:p|div)>",
+            "",
+            cleaned,
+            flags=re.IGNORECASE,
+        )
+        # 3. <b>Cc:</b> ... <br> のインライン形式（後ろの <br> も巻き込んで除去）
+        cleaned = re.sub(
+            r"<b>\s*(?:cc|ｃｃ)\s*[:：]</b>[\s\S]*?(?:<br\s*/?>|(?=<b>|</(?:p|div|tr|td)>|$))",
+            "",
+            cleaned,
+            flags=re.IGNORECASE,
+        )
+        # 4. Cc: ... <br> （<b>なし）の形式
+        cleaned = re.sub(
+            r"(?im)^\s*(?:cc|ｃｃ)\s*[:：][^<]*(?:<[^>]+>[^<]*)*?(?:<br\s*/?>|$)",
+            "",
+            cleaned,
+        )
+        # <br> の重複整理
+        cleaned = re.sub(r"(?:<br\s*/?>\s*){3,}", "<br><br>", cleaned, flags=re.IGNORECASE)
+        return cleaned
+
+    # プレーンテキストの場合
+    # "Cc: ... \n    ..." のように次行がインデントされている複数行Ccもまとめて除去
+    pattern = r"(?im)^\s*(?:cc|ｃｃ)\s*[:：][^\n]*(?:\n[ \t]+[^\n]*)*\n?"
+    cleaned = re.sub(pattern, "", text)
+    return re.sub(r"\n{3,}", "\n\n", cleaned)
+
+
+def strip_raw_markdown_dataview(markdown_text: str) -> str:
+    """マークダウン元データ（doc-raw-markdown）からすべてのdataviewjs / dataviewコードブロックを除去する"""
+    if not markdown_text:
+        return ""
+    text = re.sub(r"```(?:dataviewjs|dataview)\b[\s\S]*?```", "", markdown_text, flags=re.IGNORECASE)
+    return re.sub(r"\n{3,}", "\n\n", text).strip()
+
+
+def convert_dataview_blocks_to_html(markdown_text: str, optimize_tokens: bool = True) -> str:
     """
     Markdownテキスト内の Dataview / DataviewJS テーブル定義ブロックを検出し、
     Obsidian の表示と同様の美しい HTML テーブル (<table>) に変換する。
+    optimize_tokens=True の場合、展開できない生JSコードや複雑なクエリは省略注釈に置換してトークンを削減する。
     """
     # 1. ```dataviewjs ... ``` ブロックの置換
     def replace_dataviewjs_block(match: re.Match) -> str:
@@ -954,6 +1009,9 @@ def convert_dataview_blocks_to_html(markdown_text: str) -> str:
             except Exception:
                 pass
 
+        if optimize_tokens:
