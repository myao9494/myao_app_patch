+
+
+@pytest.mark.parametrize("system_name", ["Darwin", "Windows"])
+def test_search_sends_include_path_in_filename_enabled_by_default(monkeypatch, system_name: str) -> None:
+    """
+    ランチャーの検索は、ファイル名検索でフォルダ名も対象にする設定を既定オンで送る。
+    """
+    sent: dict[str, object] = {}
+
+    def fake_urlopen(request: Request, timeout: float) -> StubResponse:
+        sent["body"] = json.loads(request.data.decode("utf-8"))
+        return _stub_search_response()
+
+    monkeypatch.setattr(client_module.platform, "system", lambda: system_name)
+    client = LauncherApiClient(base_url="http://127.0.0.1:8079", urlopen=fake_urlopen)
+
+    client.search("人事 top")
+    assert sent["body"]["include_path_in_filename"] is True
+
+    client.search("人事 top", include_path_in_filename=False)
+    assert sent["body"]["include_path_in_filename"] is False
