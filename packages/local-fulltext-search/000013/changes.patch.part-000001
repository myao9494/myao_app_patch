@@ -3434,3 +3435,94 @@ def test_search_without_path_ignores_conflict_when_indexing_is_running(tmp_path:
 
     assert result.total == 1
     assert [item.file_name for item in result.items] == ["existing_doc.md"]
+
+
+def test_filename_search_matches_terms_across_folder_and_file_name(tmp_path: Path) -> None:
+    """
+    既定ではフォルダ名とファイル名にまたがる語でも、ファイル名検索でヒットする（人事 / top）。
+    """
+    service = SearchService(connection=_create_connection(tmp_path))
+    target = tmp_path / "docs"
+    (target / "人事").mkdir(parents=True)
+    (target / "経理").mkdir()
+    (target / "人事" / "top.md").write_text("本文に語は無い", encoding="utf-8")
+    (target / "経理" / "top.md").write_text("本文に語は無い", encoding="utf-8")
+
+    result = service.search(
+        SearchQueryParams(
+            q="人事 top",
+            full_path=str(target),
+            index_depth=5,
+            refresh_window_minutes=60,
+            search_target="filename",
+        )
+    )
+
+    assert [Path(item.full_path).parent.name for item in result.items] == ["人事"]
+
+
+def test_filename_search_can_exclude_folder_names_from_path_match(tmp_path: Path) -> None:
+    """
+    include_path_in_filename=False のときは、従来どおりファイル名だけを対象にする。
+    """
+    service = SearchService(connection=_create_connection(tmp_path))
+    target = tmp_path / "docs"
+    (target / "人事").mkdir(parents=True)
+    (target / "人事" / "top.md").write_text("本文に語は無い", encoding="utf-8")
+
+    result = service.search(
+        SearchQueryParams(
+            q="人事 top",
+            full_path=str(target),
+            index_depth=5,
+            refresh_window_minutes=60,
+            search_target="filename",
+            include_path_in_filename=False,
+        )
+    )
+
+    assert result.total == 0
+
+
+def test_filename_path_match_ignores_folders_above_the_search_target(tmp_path: Path) -> None:
+    """
+    パス一致は登録した対象フォルダより下の相対パスだけが対象で、上位フォルダ名では一致しない。
+    """
+    service = SearchService(connection=_create_connection(tmp_path))
+    target = tmp_path / "upperfolder" / "docs"
+    target.mkdir(parents=True)
+    (target / "memo.md").write_text("本文に語は無い", encoding="utf-8")
+
+    result = service.search(
+        SearchQueryParams(
+            q="upperfolder memo",
+            full_path=str(target),
+            index_depth=5,
+            refresh_window_minutes=60,
+            search_target="filename",
+        )
+    )
+
+    assert result.total == 0
+
+
+def test_filename_path_match_requires_one_term_outside_the_path(tmp_path: Path) -> None:
+    """
+    フォルダ名だけで全語が一致するときは、配下のファイルを個別には返さない（フォルダ結果だけにする）。
+    """
+    service = SearchService(connection=_create_connection(tmp_path))
+    target = tmp_path / "docs"
+    (target / "人事" / "評価").mkdir(parents=True)
+    (target / "人事" / "評価" / "memo.md").write_text("本文に語は無い", encoding="utf-8")
+
+    result = service.search(
+        SearchQueryParams(
+            q="人事 評価",
+            full_path=str(target),
+            index_depth=5,
+            refresh_window_minutes=60,
+            search_target="filename",
+        )
+    )
+
+    assert all(item.result_kind != "file" for item in result.items)
diff --git a/docs/extension_filter_spec.md b/docs/extension_filter_spec.md
index 3cc4c948730c084cb1ebedde224d56e4beca8c2f..34ccc1588b868fd1099b16ac5e0e156020ade7f0 100644
--- a/docs/extension_filter_spec.md
+++ b/docs/extension_filter_spec.md
@@ -111,3 +111,15 @@ if allowed_global_extensions:
    - ベクトル検索クエリには包含語（`include_terms`）のみを渡し、除外語のみの指定時はベクトル検索をスキップして高速に応答。
    - ベクトル検索結果からもクエリ除外語を含むアイテムを確実に除外。
 
+
+---
+
+## ファイル名検索でフォルダ名も対象にするオプション（`include_path_in_filename`）
+
+- 既定はオン。Web UI は「検索種別」の下のチェックボックス、ランチャー（macOS / Flet / WPF）は「フォルダ名も対象」で切り替える。Web UI の選択はブラウザへ保存する。
+- 対象は、登録済み検索対象フォルダ（最も深く一致するもの）より下の相対パス。上位フォルダ名（`Users` など）では一致しない。
+  例: `人事/top.excalidraw` は「人事 top」でヒットする。
+- 適用範囲は、ファイル名を検索する検索種別（`all` / `filename` / `filename_and_folder`）の通常検索（FTS）。正規表現検索には適用しない。
+- パス一致だけで全語が満たされるファイルは返さない。少なくとも 1 語はファイル名・本文などで一致している必要がある
+  （フォルダ名だけの一致は従来どおりフォルダ結果として返す）。実装は `search_sql.PATH_MATCH_RANK`。
+- ファイル名のみで探したい場合はオフにする（API は `include_path_in_filename=false`）。
