   }
 });
 
+test("ファイル名検索でフォルダ名も対象にする設定は既定オンで、切り替えを検索条件として送る", async () => {
+  const app = await openApp();
+  try {
+    const checkbox = findBySelector<HTMLInputElement>(app.container, "input[aria-label='ファイル名検索でフォルダ名も対象にする']");
+    assert.equal(checkbox.checked, true);
+    await app.runSearch("人事 top");
+    assert.equal(app.lastSearchBody().include_path_in_filename, true);
+
+    await click(checkbox);
+    await app.runSearch("人事 top");
+    assert.equal(app.lastSearchBody().include_path_in_filename, false);
+  } finally {
+    await app.close();
+  }
+});
+
