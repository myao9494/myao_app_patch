+              )}
+            </button>
+          </div>
+        </div>
+      )}
+
+      {/* ステップ4: 生成結果プレビュー & ダウンロード */}
+      {generatedData && (
+        <div
+          className="panel glass-panel"
+          style={{
+            marginTop: "20px",
+            padding: "18px 22px",
+            borderRadius: "14px",
+            border: "1px solid rgba(16, 185, 129, 0.4)",
