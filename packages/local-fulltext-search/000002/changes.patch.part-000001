+    color: var(--text-muted);
+}
+
+/* AI プロンプトセクション */
+.ai-prompt-section {
+    background: #eff6ff;
+    border: 1px solid #bfdbfe;
+    border-left: 5px solid var(--accent-blue);
+    border-radius: 6px;
+    padding: 16px 20px;
+    margin-bottom: 28px;
+}
+
+.ai-prompt-section h2 {
+    font-size: 16px;
+    margin: 0 0 10px 0;
+    color: #1e40af;
+}
