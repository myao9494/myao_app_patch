 起動時にDBスキーマを初期化し、リクエストごとに短命のDB接続を利用する。
 """
 
+import os
+
+# Mac / Apple Silicon 上での OpenMP (libomp) および HuggingFace Tokenizers の並列スレッド競合クラッシュを防止
+os.environ.setdefault("OMP_NUM_THREADS", "1")
