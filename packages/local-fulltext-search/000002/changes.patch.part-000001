+                        {item.full_path}
+                      </td>
+                      <td
+                        style={{ padding: "8px", fontSize: "11.5px", color: "#cbd5e1", maxWidth: "340px", lineHeight: "1.4" }}
+                        onClick={() => toggleSelect(item.full_path)}
+                      >
+                        {(() => {
