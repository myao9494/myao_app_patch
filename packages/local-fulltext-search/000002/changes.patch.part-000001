         catch (Exception error) { Status.Text = $"検索に失敗しました: {error.Message}"; }
     }
 
+    private void SearchTypeCombo_SelectionChanged(object sender, SelectionChangedEventArgs e)
+    {
+        if (IsLoaded)
+        {
+            _debounce.Stop();
+            _debounce.Start();
+            QueryBox.Focus();
+        }
+    }
+
     private void GanttCheck_Click(object sender, RoutedEventArgs e)
     { _debounce.Stop(); _debounce.Start(); QueryBox.Focus(); }
 
diff --git a/launcher/windows/LocalSearchLauncher/SearchModels.cs b/launcher/windows/LocalSearchLauncher/SearchModels.cs
index 140f0b613003449b58c1c8b66767898686a27b50..98f7ffebf55fb75ff9847c4b20bd194f9ea097b5 100644
--- a/launcher/windows/LocalSearchLauncher/SearchModels.cs
+++ b/launcher/windows/LocalSearchLauncher/SearchModels.cs
@@ -9,10 +9,22 @@ internal sealed record SearchResponse(int Total, List<SearchItem> Items, bool Ha
 
 internal sealed record SearchItem(
     int FileId, string ResultKind, string SourceType, string TargetPath,
-    string FileName, string FullPath, string FileExt, string Snippet, string? GanttLink)
+    string FileName, string FullPath, string FileExt, string Snippet, string? GanttLink,
+    string? MatchSource = null, string? SalientSentence = null,
+    double? HybridScore = null, double? VectorScore = null)
 {
     /// <summary>HTML断片をランチャー表示用のプレーンテキストへ変換する。</summary>
     public string PlainSnippet => WebUtility.HtmlDecode(Regex.Replace(Snippet ?? "", "<[^>]+>", ""));
+    public string DisplayTitle => MatchSource switch
+    {
+        "both" => $"{FileName}  🌟両方一致",
+        "vector" => $"{FileName}  🔮意味一致",
+        "keyword" => $"{FileName}  🏷️通常一致",
+        _ => FileName
+    };
+    public string DisplaySnippet => !string.IsNullOrWhiteSpace(SalientSentence)
+        ? $"💡 {SalientSentence}"
+        : PlainSnippet;
     public bool IsGantt => SourceType == "gantt";
     public bool IsLocal => SourceType == "local";
     public bool IsWeb => SourceType == "web";
@@ -25,6 +37,11 @@ internal sealed record SearchItem(
         if (IsGantt) return "task";
         if (SourceType == "web") return "html";
         if (ResultKind == "folder") return "folder";
+
+        string lower = FileName.ToLowerInvariant();
+        if (lower.EndsWith(".excalidraw.md")) return "excalidraw";
+        if (lower.EndsWith(".drawio.svg") || lower.EndsWith(".dio.svg")) return "drawio";
+
         return Path.GetExtension(FileName).ToLowerInvariant() switch
         {
             ".md" or ".markdown" => "markdown", ".pdf" => "pdf", ".json" => "json", ".xml" => "xml",
@@ -54,7 +71,8 @@ internal sealed record LauncherWindowState(
     string MemoBody = "",
     bool MemoActive = false,
     bool IncludeGantt = false,
-    bool UpdateIndexOnSearch = false);
+    bool UpdateIndexOnSearch = false,
+    string SearchType = "hybrid");
 
 /// <summary>既存DBだけをlocal / web横断で検索するリクエスト。</summary>
 internal sealed record IndexedLauncherSearchRequest(
@@ -65,7 +83,7 @@ internal sealed record IndexedLauncherSearchRequest(
     string Types,
     string SourceType = "local_web");
 
-/// <summary>gantt追加時もDB更新を行わずlocal / webを横断するリクエスト。</summary>
+/// <summary>gantt追加時やハイブリッド・ベクトル検索時もlocal / webを横断するリクエスト。</summary>
 internal sealed record LauncherSearchRequest(
     string Q,
     string FullPath,
@@ -80,16 +98,17 @@ internal sealed record LauncherSearchRequest(
     int Offset,
     bool IncludeSnippets,
     bool IncludeGanttTasks,
-    string Types);
+    string Types,
+    string SearchType = "hybrid");
 
 /// <summary>WPF検索のエンドポイントとペイロードを一貫して組み立てる。</summary>
 internal static class LauncherSearchRequestBuilder
 {
-    public static (string Endpoint, object Payload) Build(string query, int limit, bool includeGanttTasks, string types, bool updateIndexOnSearch = false) =>
-        includeGanttTasks || updateIndexOnSearch
+    public static (string Endpoint, object Payload) Build(string query, int limit, bool includeGanttTasks, string types, bool updateIndexOnSearch = false, string searchType = "hybrid") =>
+        includeGanttTasks || updateIndexOnSearch || searchType != "keyword"
             ? ("api/search", new LauncherSearchRequest(
                 query, "", true, !updateIndexOnSearch, "local_web", 0, "all", "default", "desc",
-                limit, 0, true, includeGanttTasks, types))
+                limit, 0, true, includeGanttTasks, types, searchType))
             : ("api/search/indexed", new IndexedLauncherSearchRequest(query, "", limit, 0, types));
 }
 
