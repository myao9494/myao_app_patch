+          </h2>
+          <div style={{ fontSize: "11.5px", color: "#94a3b8", background: "rgba(255, 255, 255, 0.05)", padding: "3px 10px", borderRadius: "6px", border: "1px solid rgba(255, 255, 255, 0.08)" }}>
