+def test_export_markdown_strips_excalidraw_data_and_compressed_json(tmp_path: Path) -> None:
+    """
+    AIインプット用Markdownエクスポート時、# Excalidraw Data 以降（テキスト要素・描画バイナリ・compressed-json）が
+    完全に除去され、AIにとって意味不明なトークン浪費データが出力されないことを検証する。
+    """
+    excal_doc = tmp_path / "設計メモ.excalidraw.md"
+    excal_doc.write_text(
+        """---
+excalidraw-plugin: parsed
+tags:
+  - excalidraw
+---
+![[設計メモ|738]]
+
+# システムアーキテクチャ概要 (見出し1)
+クライアントとサーバーの通信シーケンスです。
+
+## 主要コンポーネント (見出し2)
+- フロントエンド (React)
+- バックエンド (FastAPI)
+
+# Excalidraw Data
+
+## Text Elements
+クライアント ^text1
+
+サーバー ^text2
+
+%%
+## Drawing
+```compressed-json
+N4KAkARALgngDgUwgLgAQQQDwMYEMA2AlgCYBOuA7hADTgQBuCpAzoQPYB2KqATLZMzYBXUtiRoIACyhQ4zZAHoFAc0JRJQgEYA6bGwC2CgF7N6hbEcK4OCtptbErHALRY8RMpWdx8Q1TdIEfARcZgRmBShcZQUebR4Adm0AZho6IIR9BA4oZm4AbXAwUDBSiBJuCABNegB5OAANWuYAWTTSyFhESsDsKI5lYPayzG5nZIBWZO0ANgSZ5IBOAEYZ
+```
+%%
+""",
+        encoding="utf-8",
+    )
+
+    md_content, img_bytes, stats = export_documents_to_markdown_and_image(
+        file_paths=[str(excal_doc)],
+        vault_path=str(tmp_path),
+    )
+
+    # 1. 本文・見出し・画像リンク記法は正常に出力されること
+    assert "設計メモ.excalidraw.md" in md_content
+    assert "# システムアーキテクチャ概要 (見出し1)" in md_content
+    assert "クライアントとサーバーの通信シーケンスです。" in md_content
+    assert "## 主要コンポーネント (見出し2)" in md_content
+    assert "- フロントエンド (React)" in md_content
+    assert "![[設計メモ|738]]" in md_content
+
+    # 2. # Excalidraw Data 以降のバイナリ・圧縮JSON・テキスト要素は完全に出力されないこと
+    assert "# Excalidraw Data" not in md_content
+    assert "## Text Elements" not in md_content
+    assert "compressed-json" not in md_content
+    assert "N4KAkARALgng" not in md_content
+    assert "^text1" not in md_content
+    assert "## Drawing" not in md_content
+
+
+def test_export_markdown_sample_test_convert_file_strips_excalidraw_data() -> None:
+    """
+    サンプルの実ファイル (/Users/mine/000_work/obsidian-dagnetz/scratch/test_convert.md) をエクスポートした際、
+    # Excalidraw Data 以降が完全に出力されないこと、および手前の本文が正しく残ることを検証する。
+    """
+    sample_path = Path("/Users/mine/000_work/obsidian-dagnetz/scratch/test_convert.md")
+    if not sample_path.exists():
+        pytest.skip("サンプルファイルが存在しないためスキップ")
+
+    md_content, img_bytes, stats = export_documents_to_markdown_and_image(
+        file_paths=[str(sample_path)],
+        vault_path=str(sample_path.parent),
+    )
+
+    # 手前の本文が保持されていること
+    assert "test_convert.md" in md_content
+    assert "# テストドキュメントのタイトル (見出し1)" in md_content
+    assert "これはPandocによるWord変換のテストドキュメントです。" in md_content
+    assert "# wha" in md_content
+    assert "erhathe" in md_content
+    assert "aethah" in md_content
+
+    # # Excalidraw Data 以降が完全に出力されないこと
+    assert "# Excalidraw Data" not in md_content
+    assert "Text Elements" not in md_content
+    assert "compressed-json" not in md_content
+    assert "N4KAkARALgng" not in md_content
+    assert "^cgwZexom" not in md_content
+    assert "## Drawing" not in md_content
+
+
+
diff --git a/claude.md b/claude.md
index 9b88cb846f8a25783a12fecebd6eb0621b0e1690..c655b9c8cb984f4c7b095c480858bd5923e59dd7 100644
--- a/claude.md
+++ b/claude.md
@@ -825,6 +825,34 @@ AIインプット画面の特大プレビュー＆ファイル調整モーダル
 3. **固定ヘッダーと内部スクロールの維持**:
    - `thead` の `position: sticky; top: 0;` により、縦に広がったテーブルを内部スクロールしても見出し列が常に固定表示され、選択チェックや順位・タイトルが快適に操作可能。
 
+---
+
+# AIインプット Markdownエクスポート Excalidraw Data（圧縮JSON等）完全除去仕様書
+
+## 概要
+AIインプット用のMarkdownファイル作成（`〇〇_context.md` 等）において、Excalidrawノート（`.excalidraw.md` や通常の `.md` 内の Excalidraw）に含まれる `# Excalidraw Data` 以降（テキスト要素、`## Drawing`、圧縮JSON `compressed-json` ブロック）は、AI（LLM）にとって意味不明なバイナリ文字列でありトークンの大幅な浪費となる。図面自体はすでに高解像度結合画像として添付提供されているため、Markdown出力から `# Excalidraw Data` 以降を完全に除去し、AIが解釈可能な本文・見出し・生リンク記法のみを出力する。
+
+## 仕様
+1. **# Excalidraw Data 以降の完全除去**:
+   - `export_documents_to_markdown_and_image` において、各Markdownノートの生テキストに対して `strip_excalidraw_data` を適用。
+   - 見出し `# Excalidraw Data`（`#+ Excalidraw Data` や末尾改行・空白の揺れを含む）からファイル末尾までを完全に切り捨てる。
+   - 圧縮JSON（````compressed-json ... ````）やテキスト要素リスト（`## Text Elements`）を排除。
+2. **手前の本文・見出し・画像リンクの完全保護**:
+   - `# Excalidraw Data` より手前に記述された本文（見出し、通常段落、リスト、テーブル、コードブロック）はそのまま維持。
+   - 画像リンク記法（`![[diagram|738]]` 等）も生テキストとして維持され、Obsidianコピペ互換性を保証。
+3. **結合画像ファイルとの役割分担**:
+   - Excalidrawの描画内容は、元データからベクターSVGとして高精細ラスタライズされ、結合画像ファイル（`〇〇_images.png` / `.jpg`）に収録される。
+   - テキスト側はトークンを節約し、図面情報は画像側で視覚的にAIへ提供される。
+
+## 変更対象ファイル
+- `backend/app/vector/html_exporter.py`
+- `backend/app/vector/markdown_image_exporter.py`
+- `backend/tests/test_ai_markdown_image_export.py`
+- `claude.md`
+- `docs/ai_markdown_image_export_spec.md`
+- `docs/excalidraw_data_strip_flow.excalidraw.md`
+
+
 
 
 
