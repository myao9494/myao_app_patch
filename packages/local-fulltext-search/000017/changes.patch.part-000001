+def image_search_roots(vault_dir: Path, vault_root: Optional[Path]) -> List[Path]:
+    """
+    画像・図面を同名ファイルで再帰探索するフォルダを、探す順に返す。
+    基準フォルダ → (Vault ルートが基準フォルダの祖先なら) Vault ルート、そうでなければ基準フォルダの親 → Vault ルート。
+    Vault ルートが基準フォルダの祖先のときは、Vault の外（Vault ルートの親）までは探しに行かない。
+    """
+    roots = [vault_dir]
+    if vault_root is not None and vault_root != vault_dir and vault_root in vault_dir.parents:
+        roots.append(vault_root)
+        return roots
+    roots.append(vault_dir.parent)
+    if vault_root is not None and vault_root not in roots:
+        roots.append(vault_root)
+    return roots
+
