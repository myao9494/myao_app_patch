@@ -169,3 +169,20 @@ def test_link_to_existing_folder_is_not_reported(tmp_path: Path) -> None:
     _, stats = export_documents_to_html(file_paths=[str(root)], file_depths={str(root): 1})
 
     assert stats["skipped_links"] == []
+
+
+def test_embedded_email_and_note_are_not_reported_as_missing_images(tmp_path: Path) -> None:
+    """`![[メール.msg]]` や `![[ノート]]`（埋め込み表示）は画像ではないため、画像として見つからなくても記録しない。"""
+    msg = EmailMessage()
+    msg["Subject"] = "埋め込んだメール"
+    msg["From"] = "a@example.com"
+    msg["To"] = "b@example.com"
+    msg.set_content("本文")
+    (tmp_path / "RE_test.eml").write_bytes(bytes(msg))
+    note = tmp_path / "note.md"
+    note.write_text("# ノート\n![[RE_test.eml]]\n![[埋め込みノート]]\n![[ない画像.png]]\n", encoding="utf-8")
+
+    _, stats = export_documents_to_html(file_paths=[str(note)])
+
+    assert stats["total_linked_emails"] == 1
+    assert _skips(stats) == [("image", "ない画像.png", "note.md", "not_found")]
diff --git a/backend/tests/test_ai_html_vault_root_assets.py b/backend/tests/test_ai_html_vault_root_assets.py
new file mode 100644
index 0000000000000000000000000000000000000000..19c8cf8ee24a4151c81bde0505396779171ae3d5
--- /dev/null
+++ b/backend/tests/test_ai_html_vault_root_assets.py
@@ -0,0 +1,104 @@
+"""
+AI用HTMLの書き出しで、ノートと別のフォルダにある画像・図面を Vault 全体から探して埋め込むテスト。
+
+仕様:
+- ノートを絶対パスで選んだとき（file_paths）、画像・図面の探索はノートのフォルダ配下とその親フォルダ配下だけでなく、
+  ノートが属する Obsidian Vault のルート（`.obsidian` フォルダがあるフォルダ）配下まで広げる。
+  例: 01_data/2026/04/11/ノート.md の `![[図.excalidraw]]` が 01_data/2026/05/02/図.excalidraw.md を指す。
+- 見つかった画像・図面は Data URL として埋め込み、skipped_links に「見つからない画像」として記録しない。
+- Vault ルートが見つからないとき（`.obsidian` が無い）は従来どおりノートのフォルダとその親フォルダだけを探す。
+"""
+
+from __future__ import annotations
+
+import base64
+from pathlib import Path
+from typing import Any, Dict, List
+
+from app.vector.html_exporter import export_documents_to_html
+
+PNG_BYTES = base64.b64decode("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=")
+
+EXCALIDRAW_NOTE = """---
+excalidraw-plugin: parsed
+tags: [excalidraw]
+---
+
+# Excalidraw Data
+
+## Text Elements
+別フォルダの図 ^abc12345
+
+## Drawing
+```json
+{
+  "type": "excalidraw",
+  "version": 2,
+  "elements": [
+    {"id": "r1", "type": "rectangle", "x": 0, "y": 0, "width": 100, "height": 50,
+     "strokeColor": "#000000", "backgroundColor": "transparent"}
+  ],
+  "files": {}
+}
+```
+"""
+
+
+def _image_skips(stats: Dict[str, Any]) -> List[Dict[str, Any]]:
+    return [s for s in stats["skipped_links"] if s["kind"] == "image"]
+
+
+def _make_vault(tmp_path: Path) -> Path:
+    vault = tmp_path / "vault"
+    (vault / ".obsidian").mkdir(parents=True)
+    return vault
+
+
+def test_figure_in_other_date_folder_of_vault_is_embedded(tmp_path: Path) -> None:
+    vault = _make_vault(tmp_path)
+    note_dir = vault / "01_data" / "2026" / "04" / "11"
+    fig_dir = vault / "01_data" / "2026" / "05" / "02"
+    note_dir.mkdir(parents=True)
+    fig_dir.mkdir(parents=True)
+    (fig_dir / "図_別フォルダ.excalidraw.md").write_text(EXCALIDRAW_NOTE, encoding="utf-8")
+    note = note_dir / "ノート.md"
+    note.write_text("# ノート\n![[図_別フォルダ.excalidraw|1475]]\n", encoding="utf-8")
+
+    html, stats = export_documents_to_html(file_paths=[str(note)], file_depths={})
+
+    assert _image_skips(stats) == []
+    assert "![[図_別フォルダ.excalidraw" not in html
+    assert 'alt="図_別フォルダ.excalidraw" width="1475"' in html
+    assert "data:image/svg+xml;base64," in html
+
+
+def test_image_in_vault_attachment_folder_is_embedded(tmp_path: Path) -> None:
+    vault = _make_vault(tmp_path)
+    note_dir = vault / "01_data" / "2026" / "04" / "11"
+    img_dir = vault / "99_attachments"
+    note_dir.mkdir(parents=True)
+    img_dir.mkdir(parents=True)
+    (img_dir / "Pasted image 20260215201159.png").write_bytes(PNG_BYTES)
+    note = note_dir / "ノート.md"
+    note.write_text("# ノート\n![[Pasted image 20260215201159.png]]\n", encoding="utf-8")
+
+    html, stats = export_documents_to_html(file_paths=[str(note)], file_depths={})
+
+    assert _image_skips(stats) == []
+    assert "data:image/png;base64," in html
+
+
+def test_without_vault_root_search_stays_near_the_note(tmp_path: Path) -> None:
+    """`.obsidian` が無ければ、ノートの親フォルダより上へは探しに行かない（従来どおり）。"""
+    top = tmp_path / "top"
+    note_dir = top / "a" / "b"
+    far_dir = top / "far"
+    note_dir.mkdir(parents=True)
+    far_dir.mkdir(parents=True)
+    (far_dir / "遠い画像.png").write_bytes(PNG_BYTES)
+    note = note_dir / "ノート.md"
+    note.write_text("# ノート\n![[遠い画像.png]]\n", encoding="utf-8")
+
+    _, stats = export_documents_to_html(file_paths=[str(note)], file_depths={})
+
+    assert [s["target"] for s in _image_skips(stats)] == ["遠い画像.png"]
diff --git a/docs/ai_context_export_spec.md b/docs/ai_context_export_spec.md
index 2b2fc398cd9661108b0939bbea063db88e76372f..590bc38f70ca1fa3b2b3dee41d3e4729ea17a2ad 100644
--- a/docs/ai_context_export_spec.md
+++ b/docs/ai_context_export_spec.md
@@ -40,6 +40,14 @@
    - Markdown やテキスト内の画像リンク（`![alt](path)`）を検出し、ローカルの画像実体（PNG, JPG, GIF, SVG 等）を Base64 Data URI に変換して `<img>` タグへ置換。
    - `.excalidraw` / `.excalidraw.md`: 描画シーンの SVG データを生成または埋め込み画像から復元し、SVG/Base64 として埋め込み。
    - `.dio` / `.dio.svg`: draw.io の XML/SVG データをそのまま SVG としてインライン展開。
+   - **探索範囲**（`figure_assets.resolve_image_or_figure_data_url`）: 埋め込み先の画像・図面は、ノートのフォルダ → 基準フォルダ直下 →
+     Obsidian Vault ルート（ノートから親を遡って `.obsidian` がある最初のフォルダ）からの相対パス → 基準フォルダの親直下 →
+     基準フォルダ配下の再帰探索 → Vault ルート配下の再帰探索、の順に探す。
+     ノートを絶対パスで選ぶと基準フォルダはノートのフォルダになるため、別の日付フォルダ（例: `01_data/2026/04/11/ノート.md` の
+     `![[図.excalidraw]]` が `01_data/2026/05/02/図.excalidraw.md`）や添付フォルダの画像は Vault ルート配下の探索で見つかる。
+     Vault ルートが基準フォルダの祖先のときは Vault の外（Vault ルートの親）は探さない。
+     Vault ルートが見つからないとき（`.obsidian` が無い）は、従来どおり基準フォルダとその親フォルダ配下だけを探す。
+   - Excalidraw のキャッシュ画像（`.excalidraw-cache/index.json` のキーは Vault 相対パス）と、図面内の貼り付け画像の探索も Vault ルートを基準にする。
 2. **構造化ドキュメント**:
    - 先頭に AI 向けの `<system-instruction>` / プロンプトブロック。
    - 目次（Table of Contents）リンク一覧（指定されたドキュメント順序通りに #1, #2... とナンバリング）。
@@ -120,6 +128,8 @@
 - 項目が例外を出したときも飛ばして続ける。見つからない項目（選んだノート・リンク先ノート・`![[...]]` / `![...](...)` の画像・メール）も記録する。
   埋め込みでない `[[...]]` は通常のノートへのリンクでもあるため、画像として見つからなくても記録しない。
   リンク先が実在するフォルダ（ノートへのリンクではない）のときも記録しない。
+  `![[...]]` / `![...](...)` でも、画像・図面の拡張子（`IMAGE_EXTENSIONS` / `FIGURE_EXTENSIONS`）でないもの
+  （`![[メール.msg]]`、ノートの埋め込み表示 `![[ノート]]` など）は、画像として見つからなくても記録しない。
 - 時間切れのまま続いているフォルダ走査（ファイル名索引）があれば、同じフォルダの探索は重ねて走査せず、待たずに「見つからない」として返し、
   `folder_scan` として 1 度だけ記録する。
 - 記録（`skipped_links`）: 種類（note / linked_note / image / figure / email / render / folder_scan）・対象・リンク元・
