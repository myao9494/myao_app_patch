+            if saved_model:
+                res = vector_state.load_saved_model()
+                if res.get("loaded"):
+                    logger.info("起動時ベクトルモデル自動ロード完了: %s", vector_state.model_path)
+                else:
+                    logger.warning("起動時ベクトルモデル自動ロード待機: %s", res.get("message"))
+            else:
+                logger.info("起動時ベクトルモデル自動ロード: 記録がないためスキップしました（初回待機状態）")
         except Exception as e:
             logger.warning("起動時のベクトルモデル自動ロードに失敗しました: %s", e)
 
