+def test_search_supports_only_exclude_terms_like_minus_png(tmp_path: Path) -> None:
+    """
+    検索語が `-.png` のように除外語のみの場合でも、通常語に誤フォールバックせず、
+    全ファイルから `.png`（ファイル名・拡張子・本文）を含む候補を除外して検索結果を返す。
+    """
+    service = SearchService(connection=_create_connection(tmp_path))
+    target = tmp_path / "docs"
+    target.mkdir()
+    (target / "document.md").write_text("hello document", encoding="utf-8")
+    (target / "diagram.png").write_bytes(b"fake png content")
+
+    result = service.search(
+        SearchQueryParams(
+            q="-.png",
+            full_path=str(target),
+            index_depth=5,
+            refresh_window_minutes=60,
+        )
+    )
+
+    assert result.total == 1
+    assert [item.file_name for item in result.items] == ["document.md"]
+
+
+def test_search_supports_extension_filter_negative_exclusion(tmp_path: Path) -> None:
+    """
+    拡張子フィルタ（types）に `-png` または `-.png` を指定した場合、
+    その拡張子のファイルが除外される。
+    """
+    service = SearchService(connection=_create_connection(tmp_path))
+    target = tmp_path / "docs"
+    target.mkdir()
+    (target / "memo.md").write_text("memo data", encoding="utf-8")
+    (target / "sheet.txt").write_text("sheet data", encoding="utf-8")
+    (target / "image.png").write_bytes(b"fake png")
+
+    # -png で指定
+    result = service.search(
+        SearchQueryParams(
+            q="data",
+            full_path=str(target),
+            index_depth=5,
+            refresh_window_minutes=60,
+            types="-png",
+        )
+    )
+    assert sorted(item.file_name for item in result.items) == ["memo.md", "sheet.txt"]
+
+    # -.png で指定
+    result2 = service.search(
+        SearchQueryParams(
+            q="data",
+            full_path=str(target),
+            index_depth=5,
+            refresh_window_minutes=60,
+            types="-.png",
+        )
+    )
+    assert sorted(item.file_name for item in result2.items) == ["memo.md", "sheet.txt"]
+
+
+def test_search_supports_positive_and_negative_extension_filter(tmp_path: Path) -> None:
+    """
+    拡張子フィルタ（types）に通常指定と除外指定を組み合わせた場合（例: `md -txt`）、
+    通常指定に合致し、かつ除外指定に含まれないファイルのみを返す。
+    """
+    service = SearchService(connection=_create_connection(tmp_path))
+    target = tmp_path / "docs"
+    target.mkdir()
+    (target / "a.md").write_text("content_alpha target", encoding="utf-8")
+    (target / "b.txt").write_text("content_alpha target", encoding="utf-8")
+
+    result = service.search(
+        SearchQueryParams(
+            q="content_alpha",
+            full_path=str(target),
+            index_depth=5,
+            refresh_window_minutes=60,
+            types="md -txt",
+        )
+    )
+    assert [item.file_name for item in result.items] == ["a.md"]
+
+
