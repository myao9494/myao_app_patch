diff --git a/launcher/windows/LocalSearchLauncher.Tests/Program.cs b/launcher/windows/LocalSearchLauncher.Tests/Program.cs
index 883684f1d287b2f344343941abcb26e1b55cc22a..0798d493ba9fd554183ea5638fa106c2b94952b2 100644
--- a/launcher/windows/LocalSearchLauncher.Tests/Program.cs
+++ b/launcher/windows/LocalSearchLauncher.Tests/Program.cs
@@ -38,6 +38,10 @@ var (defaultEndpoint, defaultPayload) = LauncherSearchRequestBuilder.Build("alph
 Assert(defaultEndpoint == "api/search", "既定のハイブリッド検索は統合APIを使う");
 Assert(defaultPayload is LauncherSearchRequest { SourceType: "local_web", SearchType: "hybrid" }, "ハイブリッド検索はSearchTypeにhybridを指定する");
 
+var (excludeQueryEndpoint, excludeQueryPayload) = LauncherSearchRequestBuilder.Build("-.png", 8, false, "-png");
+Assert(excludeQueryEndpoint == "api/search", "除外語検索も統合APIを使う");
+Assert(excludeQueryPayload is LauncherSearchRequest { Q: "-.png", Types: "-png" }, "除外語および除外拡張子フィルタをリクエストへ反映する");
+
 var (indexedEndpoint, indexedPayload) = LauncherSearchRequestBuilder.Build("alpha", 8, false, ".md", searchType: "keyword");
 Assert(indexedEndpoint == "api/search/indexed", "通常キーワード検索は既存DB専用APIを使う");
 Assert(indexedPayload is IndexedLauncherSearchRequest { SourceType: "local_web" }, "通常検索はlocalとwebを横断する");
