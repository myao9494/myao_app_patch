+    4ペイン画面では、どのペインで隠しても再表示時は検索欄へ focus し、共有設定・OpenCode の履歴とモデル一覧の再取得を裏で始める。
     """
     calls: list[str] = []
 
@@ -137,13 +137,15 @@ def test_show_panel_always_focuses_search_field_and_refreshes_settings(monkeypat
         _prepare_panel_for_active_space=lambda: calls.append("prepare"),
         _center_panel_on_mouse_screen=lambda: calls.append("center"),
         _refresh_shared_settings_async=lambda: calls.append("refresh"),
+        _refresh_opencode_history_async=lambda: calls.append("opencode-history"),
+        _load_opencode_models_async=lambda: calls.append("opencode-models"),
     )
     delegate.show_panel = native_mac.LauncherDelegate.show_panel.__get__(delegate)
 
     delegate.show_panel()
 
     assert panel.first_responder == "search-field"
-    assert "refresh" in calls
+    assert {"refresh", "opencode-history", "opencode-models"} <= set(calls)
 
 
 class FakeKeyDelegate:
diff --git a/launcher/tests/test_python_env.py b/launcher/tests/test_python_env.py
new file mode 100644
index 0000000000000000000000000000000000000000..aaa2a3258141d24ec50e360872c8ad85abbf6727
--- /dev/null
+++ b/launcher/tests/test_python_env.py
@@ -0,0 +1,180 @@
+"""
+ランチャーで .py を開くときに使う Python（venv）の選び方と起動のしかたを検証する。
+
+- スクリプトと同じ階層の .venv があればその Python で実行する。
+- 無ければ設定（python_venv_path）の venv の Python で実行する。
+- どちらも無い（設定が空欄）ときは、システムの Python（PATH 上の python。macOS は python3）で実行する。
+- 設定した venv が見つからないときは、別の Python で代わりに動かさずエラーにする。
+"""
+
+from pathlib import Path
+
+import pytest
+
+from launcher_app.python_env import (
+    PythonEnvError,
+    is_python_script,
+    system_python_command,
+    open_python_script,
+    resolve_python_interpreter,
+    run_python_script,
+    venv_interpreter,
+)
+
+
+def make_venv(folder: Path, *, windows: bool = False) -> Path:
+    """venv の中の Python 実行ファイルだけを置いた最小の venv を作り、その実行ファイルを返す。"""
+    interpreter = folder / ("Scripts/python.exe" if windows else "bin/python")
+    interpreter.parent.mkdir(parents=True)
+    interpreter.write_text("")
+    return interpreter
+
+
+def make_script(folder: Path) -> Path:
+    folder.mkdir(parents=True, exist_ok=True)
+    script = folder / "job.py"
+    script.write_text("print('hello')\n")
+    return script
+
+
+def test_only_py_files_are_python_scripts() -> None:
+    assert is_python_script("/work/job.py") is True
+    assert is_python_script("C:/work/JOB.PY") is True
+    assert is_python_script("/work/job.bat") is False
+    assert is_python_script("/work/job.pyc") is False
+
+
+def test_venv_interpreter_finds_posix_and_windows_layouts(tmp_path: Path) -> None:
+    posix = make_venv(tmp_path / "posix" / ".venv")
+    windows = make_venv(tmp_path / "win" / ".venv", windows=True)
+
+    assert venv_interpreter(str(tmp_path / "posix" / ".venv")) == str(posix)
+    assert venv_interpreter(str(tmp_path / "win" / ".venv")) == str(windows)
+    assert venv_interpreter(str(tmp_path / "missing" / ".venv")) is None
+
+
+def test_venv_interpreter_accepts_the_python_executable_itself(tmp_path: Path) -> None:
+    """設定に venv フォルダでなく python 実行ファイルを書いても、そのまま使う。"""
+    interpreter = make_venv(tmp_path / ".venv")
+
+    assert venv_interpreter(str(interpreter)) == str(interpreter)
+
+
+def test_sibling_venv_is_used_first(tmp_path: Path) -> None:
+    """スクリプトと同じ階層の .venv は、設定の venv より優先する。"""
+    script = make_script(tmp_path / "project")
+    sibling = make_venv(tmp_path / "project" / ".venv")
+    configured_dir = tmp_path / "shared" / ".venv"
+    make_venv(configured_dir)
+
+    assert resolve_python_interpreter(str(script), str(configured_dir)) == str(sibling)
+
+
+def test_configured_venv_is_used_when_no_sibling_venv(tmp_path: Path) -> None:
+    script = make_script(tmp_path / "project")
+    configured_dir = tmp_path / "shared" / ".venv"
+    configured = make_venv(configured_dir)
+
+    assert resolve_python_interpreter(str(script), f"  {configured_dir}  ") == str(configured)
+
+
+def test_venv_in_parent_folder_is_not_treated_as_sibling(tmp_path: Path) -> None:
+    """同じ階層だけを見る。親フォルダの .venv は使わない。"""
+    script = make_script(tmp_path / "project" / "sub")
+    make_venv(tmp_path / "project" / ".venv")
+
+    assert resolve_python_interpreter(str(script), "") == system_python_command()
+
+
+def test_system_python_command_is_python_on_windows_and_python3_elsewhere(monkeypatch) -> None:
+    monkeypatch.setattr("platform.system", lambda: "Windows")
+    assert system_python_command() == "python"
+    monkeypatch.setattr("platform.system", lambda: "Darwin")
+    assert system_python_command() == "python3"
+
+
+def test_no_venv_and_no_setting_uses_system_python(tmp_path: Path) -> None:
+    """同じ階層に .venv が無く、設定も空欄なら、システムの Python（PATH から探すコマンド名）で実行する。"""
+    script = make_script(tmp_path / "project")
+
+    assert resolve_python_interpreter(str(script), "") == system_python_command()
+    assert resolve_python_interpreter(str(script), "   ") == system_python_command()
+
+
+def test_missing_configured_venv_is_an_error(tmp_path: Path) -> None:
+    """設定した venv が無いときは、システムの Python など別の Python で代わりに動かさない。"""
+    script = make_script(tmp_path / "project")
+
+    with pytest.raises(PythonEnvError, match="見つかりません"):
+        resolve_python_interpreter(str(script), str(tmp_path / "missing" / ".venv"))
+
+
+def test_relative_configured_venv_is_an_error(tmp_path: Path) -> None:
+    script = make_script(tmp_path / "project")
+
+    with pytest.raises(PythonEnvError, match="絶対パス"):
+        resolve_python_interpreter(str(script), ".venv")
+
+
+def test_scripts_run_through_the_bundled_wrapper_by_default() -> None:
+    """失敗をポップアップで知らせるため、既定では同梱の起動用ラッパー経由で実行する。"""
+    from launcher_app import python_env, python_run_wrapper
+
+    assert python_env.PYTHON_RUN_WRAPPER == python_run_wrapper.__file__
+    assert Path(python_env.PYTHON_RUN_WRAPPER).is_file()
+
+
+def test_windows_runs_script_with_venv_python_in_new_console(monkeypatch) -> None:
+    """Windows は新しいコンソールで、スクリプトの親フォルダを current dir にして、ラッパー経由で venv の Python で実行する。"""
+    started: list[tuple[list[str], dict[str, object]]] = []
+    monkeypatch.setattr("platform.system", lambda: "Windows")
+    monkeypatch.setattr("subprocess.Popen", lambda command, **kwargs: started.append((command, kwargs)))
+
+    run_python_script("C:/work/scripts/job.py", "C:/venvs/tool/Scripts/python.exe", wrapper_path="C:/launcher/python_run_wrapper.py")
+
+    assert started == [(
+        [
+            "cmd", "/c", "start", "", "/d", "C:/work/scripts",
+            "C:/venvs/tool/Scripts/python.exe", "C:/launcher/python_run_wrapper.py", "C:/work/scripts/job.py",
+        ],
+        {},
+    )]
+
+
+def test_macos_runs_script_in_terminal_with_quoted_paths(monkeypatch) -> None:
+    """macOS はターミナルで、親フォルダへ cd してから venv の Python で実行する（空白・引用符を含むパスも崩さない）。"""
+    started: list[list[str]] = []
+    monkeypatch.setattr("platform.system", lambda: "Darwin")
+    monkeypatch.setattr("subprocess.Popen", lambda command, **kwargs: started.append(command))
+
+    run_python_script('/Users/me/my work/say "hi".py', "/Users/me/.venv/bin/python", wrapper_path="/Apps/launcher app/python_run_wrapper.py")
+
+    assert len(started) == 1
+    command = started[0]
+    assert command[0] == "osascript"
+    applescript = "\n".join(command[2::2])
+    assert 'tell application "Terminal"' in applescript
+    # シェルでは cd '/Users/me/my work' && /Users/me/.venv/bin/python '/Apps/launcher app/python_run_wrapper.py' '/Users/me/my work/say "hi".py'
+    # AppleScript の文字列では " と \ を逃がす
+    assert "do script \"cd '/Users/me/my work' && /Users/me/.venv/bin/python '/Apps/launcher app/python_run_wrapper.py' '/Users/me/my work/say \\\"hi\\\".py'\"" in applescript
+
+
+def test_open_python_script_runs_system_python_without_venv(tmp_path: Path, monkeypatch) -> None:
+    script = make_script(tmp_path / "project")
+    ran: list[tuple[str, str]] = []
+    monkeypatch.setattr("launcher_app.python_env.run_python_script", lambda path, interpreter: ran.append((path, interpreter)))
+
+    open_python_script(str(script), "")
+
+    assert ran == [(str(script), system_python_command())]
+
+
+def test_open_python_script_runs_with_resolved_venv(tmp_path: Path, monkeypatch) -> None:
+    script = make_script(tmp_path / "project")
+    sibling = make_venv(tmp_path / "project" / ".venv")
+    ran: list[tuple[str, str]] = []
+    monkeypatch.setattr("launcher_app.python_env.run_python_script", lambda path, interpreter: ran.append((path, interpreter)))
+
+    open_python_script(str(script), "")
+
+    assert ran == [(str(script), str(sibling))]
diff --git a/launcher/tests/test_python_run_wrapper.py b/launcher/tests/test_python_run_wrapper.py
new file mode 100644
index 0000000000000000000000000000000000000000..04bc70db77e9cb525684401c31aa6607acc9be62
--- /dev/null
+++ b/launcher/tests/test_python_run_wrapper.py
@@ -0,0 +1,169 @@
+"""
+ランチャーが .py を実行するときに挟む起動用ラッパー（launcher_app/python_run_wrapper.py）を検証する。
+
+- 対象スクリプトを `python script.py` と同じ条件（__main__・sys.argv・sys.path[0]）で実行する。
+- 例外で止まったら、コンソールへトレースバックを出し（ラッパー自身の行は出さない）、末尾をポップアップで知らせる。
+- 0 以外の終了コードで終わったときもポップアップで知らせ、終了コードはそのまま返す。
+- 正常終了と Ctrl+C（KeyboardInterrupt）ではポップアップを出さない。
+"""
+
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from launcher_app import python_run_wrapper
+from launcher_app.python_run_wrapper import run
+
+WRAPPER_PATH = Path(python_run_wrapper.__file__)
+
+
+@pytest.fixture
+def popups(monkeypatch) -> list[tuple[str, str]]:
+    """ポップアップの代わりに (タイトル, 本文) を記録する。sys.argv / sys.path は実行後に元へ戻す。"""
+    monkeypatch.setattr(sys, "argv", list(sys.argv))
+    monkeypatch.setattr(sys, "path", list(sys.path))
+    return []
+
+
+def write_script(folder: Path, body: str, name: str = "job.py") -> Path:
+    folder.mkdir(parents=True, exist_ok=True)
+    script = folder / name
+    script.write_text(body, encoding="utf-8")
+    return script
+
+
+def run_script(script: Path, popups: list[tuple[str, str]], *args: str) -> int:
+    return run(["python_run_wrapper.py", str(script), *args], show_popup=lambda title, message: popups.append((title, message)))
+
+
+def test_successful_script_runs_as_main_without_popup(tmp_path: Path, popups, capsys) -> None:
+    script = write_script(
+        tmp_path / "project",
+        "import sys\n"
+        "print(__name__, sys.argv[1:], sys.path[0] == __import__('os').path.dirname(__file__))\n"
+        "print(__file__)\n",
+    )
+
+    assert run_script(script, popups, "a", "b c") == 0
+
+    out = capsys.readouterr().out.splitlines()
+    assert out[0] == "__main__ ['a', 'b c'] True"
+    assert out[1] == str(script)
+    assert popups == []
+
+
+def test_script_can_import_modules_next_to_it(tmp_path: Path, popups, capsys) -> None:
+    write_script(tmp_path / "project", "VALUE = 42\n", name="helper.py")
+    script = write_script(tmp_path / "project", "import helper\nprint(helper.VALUE)\n")
+
+    assert run_script(script, popups) == 0
+    assert capsys.readouterr().out.strip() == "42"
+
+
+def test_exception_prints_traceback_without_wrapper_frames_and_shows_popup(tmp_path: Path, popups, capsys) -> None:
+    script = write_script(tmp_path / "project", "def main():\n    return 1 / 0\n\nmain()\n")
+
+    assert run_script(script, popups) == 1
+
+    err = capsys.readouterr().err
+    assert err.startswith("Traceback (most recent call last):")
+    assert "ZeroDivisionError: division by zero" in err
+    assert str(script) in err
+    assert "python_run_wrapper" not in err and "runpy" not in err
+    assert len(popups) == 1
+    title, message = popups[0]
+    assert "job.py" in title
+    assert "ZeroDivisionError: division by zero" in message
+    assert "python_run_wrapper" not in message
+
+
+def test_syntax_error_is_reported(tmp_path: Path, popups, capsys) -> None:
+    script = write_script(tmp_path / "project", "def broken(:\n    pass\n")
+
+    assert run_script(script, popups) == 1
+
+    assert "SyntaxError" in capsys.readouterr().err
+    assert "SyntaxError" in popups[0][1]
+
+
+def test_missing_module_is_reported(tmp_path: Path, popups, capsys) -> None:
+    script = write_script(tmp_path / "project", "import module_that_does_not_exist_12345\n")
+
+    assert run_script(script, popups) == 1
+
+    assert "ModuleNotFoundError" in popups[0][1]
+
+
+def test_long_traceback_is_trimmed_in_popup_but_kept_in_console(tmp_path: Path, popups, capsys) -> None:
+    script = write_script(tmp_path / "project", "raise ValueError('x' * 5000)\n")
+
+    run_script(script, popups)
+
+    assert "x" * 5000 in capsys.readouterr().err
+    message = popups[0][1]
+    assert len(message) <= python_run_wrapper.POPUP_MAX_CHARS + 200
+    assert message.rstrip().endswith("x"), "末尾（例外の行）を残して前を省く"
+
+
+def test_nonzero_exit_code_is_kept_and_reported(tmp_path: Path, popups, capsys) -> None:
+    script = write_script(tmp_path / "project", "import sys\nsys.exit(3)\n")
+
+    assert run_script(script, popups) == 3
+
+    assert len(popups) == 1
+    assert "終了コード 3" in popups[0][1]
+
+
+def test_exit_with_message_prints_it_and_reports(tmp_path: Path, popups, capsys) -> None:
+    """sys.exit("...") は python と同じく stderr へ出して終了コード 1。ポップアップにも文言を載せる。"""
+    script = write_script(tmp_path / "project", "import sys\nsys.exit('設定ファイルがありません')\n")
+
+    assert run_script(script, popups) == 1
+
+    assert "設定ファイルがありません" in capsys.readouterr().err
+    assert "設定ファイルがありません" in popups[0][1]
+
+
+def test_zero_exit_and_keyboard_interrupt_do_not_show_popup(tmp_path: Path, popups, capsys) -> None:
+    zero = write_script(tmp_path / "a", "import sys\nsys.exit(0)\n")
+    interrupted = write_script(tmp_path / "b", "raise KeyboardInterrupt\n")
+
+    assert run_script(zero, popups) == 0
+    assert run_script(interrupted, popups) == 130
+    assert popups == []
+
+
+def test_popup_failure_does_not_hide_the_error(tmp_path: Path, popups, capsys) -> None:
+    """ポップアップを出せなくても、コンソールのトレースバックと終了コードは保つ。"""
+    script = write_script(tmp_path / "project", "raise RuntimeError('boom')\n")
+
+    def _broken_popup(title: str, message: str) -> None:
+        raise OSError("no display")
+
+    code = run(["python_run_wrapper.py", str(script)], show_popup=_broken_popup)
+
+    assert code == 1
+    assert "RuntimeError: boom" in capsys.readouterr().err
+
+
+def test_wrapper_runs_as_a_standalone_file(tmp_path: Path) -> None:
+    """ランチャーは venv の Python で、このファイルを単体で起動する（launcher_app を import できない環境でも動く）。"""
+    script = write_script(tmp_path / "project", "import sys, os\nprint(sys.argv[1], os.getcwd() == os.path.dirname(__file__))\n")
+
+    completed = subprocess.run(
+        [sys.executable, "-I", str(WRAPPER_PATH), str(script), "arg1"],
+        cwd=script.parent,
+        capture_output=True,
+        text=True,
+        timeout=30,
+    )
+
+    assert completed.returncode == 0, completed.stderr
+    assert completed.stdout.strip() == "arg1 True"
+
+
+def test_missing_script_argument_is_usage_error(popups, capsys) -> None:
+    assert run(["python_run_wrapper.py"], show_popup=lambda *_: popups.append(_)) == 2
+    assert "使い方" in capsys.readouterr().err
diff --git a/launcher/windows/LocalSearchLauncher.Tests/Program.cs b/launcher/windows/LocalSearchLauncher.Tests/Program.cs
index 551e1b3b42f5442ddf87fb7d794a61905132770e..d778040781d1973941613677078a918161e8f130 100644
--- a/launcher/windows/LocalSearchLauncher.Tests/Program.cs
+++ b/launcher/windows/LocalSearchLauncher.Tests/Program.cs
@@ -467,6 +467,64 @@ var fourPaneState = new LauncherWindowState(
 );
 Assert(fourPaneState.OpenCodePrompt == "下書きプロンプト" && fourPaneState.MemoTitle == "title", "ウィンドウ再生成時も入力途中の文字を保持する");
 
+// --- .py を実行する Python の選び方（PythonEnv。Python 版 launcher_app/python_env.py と同じ約束） ---
+Assert(PythonEnv.IsPythonScript("C:\\work\\JOB.PY") && !PythonEnv.IsPythonScript("C:\\work\\job.bat") && !PythonEnv.IsPythonScript("C:\\work\\job.pyc"), ".py だけを Python スクリプトとして扱う");
+var pyRoot = Directory.CreateTempSubdirectory("launcher-python-env-");
+try
+{
+    string MakeVenv(string venvDir)
+    {
+        var interpreter = Path.Combine(venvDir, "Scripts", "python.exe");
+        Directory.CreateDirectory(Path.GetDirectoryName(interpreter)!);
+        File.WriteAllText(interpreter, "");
+        return interpreter;
+    }
+    string MakeScript(string folder)
+    {
+        Directory.CreateDirectory(folder);
+        var script = Path.Combine(folder, "job.py");
+        File.WriteAllText(script, "print('hello')");
+        return script;
+    }
+
+    var projectScript = MakeScript(Path.Combine(pyRoot.FullName, "project"));
+    var sharedVenv = Path.Combine(pyRoot.FullName, "shared", ".venv");
+    var sharedPython = MakeVenv(sharedVenv);
+    Assert(PythonEnv.Resolve(projectScript, "") == PythonEnv.SystemPythonCommand && PythonEnv.Resolve(projectScript, "   ") == "python", "同じ階層に .venv が無く設定も空欄ならシステムの Python");
+    Assert(PythonEnv.Resolve(projectScript, $"  {sharedVenv}  ") == sharedPython, "同じ階層に .venv が無ければ設定の venv");
+    Assert(PythonEnv.Resolve(projectScript, sharedPython) == sharedPython, "設定に python 実行ファイルそのものを書いてもよい");
+    var siblingPython = MakeVenv(Path.Combine(pyRoot.FullName, "project", ".venv"));
+    Assert(PythonEnv.Resolve(projectScript, sharedVenv) == siblingPython, "同じ階層の .venv を設定より優先する");
+    var nestedScript = MakeScript(Path.Combine(pyRoot.FullName, "project", "sub"));
+    Assert(PythonEnv.Resolve(nestedScript, "") == "python", "親フォルダの .venv は同じ階層として扱わない");
+
+    var missing = Path.Combine(pyRoot.FullName, "missing", ".venv");
+    try { PythonEnv.Resolve(nestedScript, missing); Assert(false, "設定した venv が無いときは例外"); }
+    catch (PythonEnvException error) { Assert(error.Message.Contains("見つかりません"), "設定した venv が無いときはシステムの Python で代わりに動かさない"); }
+    try { PythonEnv.Resolve(nestedScript, ".venv"); Assert(false, "相対パスは例外"); }
+    catch (PythonEnvException error) { Assert(error.Message.Contains("絶対パス"), "設定の venv は絶対パスだけを受け付ける"); }
+
+    var wrapperDir = Path.Combine(pyRoot.FullName, "wrapper dir");
+    var wrapperPath = PythonEnv.EnsureRunWrapper(wrapperDir);
+    Assert(wrapperPath == Path.Combine(wrapperDir, "python_run_wrapper.py") && File.ReadAllText(wrapperPath).Contains("runpy.run_path"), "埋め込んだ起動用ラッパーを取り出す");
+    File.WriteAllText(wrapperPath, "古い中身");
+    Assert(PythonEnv.EnsureRunWrapper(wrapperDir) == wrapperPath && File.ReadAllText(wrapperPath).Contains("runpy.run_path"), "中身が違えば書き直す");
+
+    var runInfo = PythonEnv.BuildRunStartInfo(projectScript, sharedPython, wrapperPath);
+    Assert(runInfo.FileName == sharedPython && runInfo.ArgumentList.SequenceEqual([wrapperPath, projectScript]) && !runInfo.UseShellExecute, "選んだ Python に起動用ラッパーとスクリプトを別々の引数で渡す（空白を含むパスも崩さない）");
+    Assert(runInfo.WorkingDirectory == Path.Combine(pyRoot.FullName, "project"), "current dir はスクリプトの親フォルダ");
+}
+finally { pyRoot.Delete(recursive: true); }
+
+using (var venvSettings = System.Text.Json.JsonDocument.Parse("{\"python_venv_path\":\"  C:\\\\tools\\\\.venv  \"}"))
+using (var noVenvSettings = System.Text.Json.JsonDocument.Parse("{\"gantt_parent\":3}"))
+using (var emptyVenvSettings = System.Text.Json.JsonDocument.Parse("{\"python_venv_path\":\"\"}"))
+{
+    Assert(LauncherApiClient.ParsePythonVenvPath(venvSettings.RootElement) == "C:\\tools\\.venv", "共有設定の venv は前後の空白を除いて読む");
+    Assert(LauncherApiClient.ParsePythonVenvPath(noVenvSettings.RootElement) is null, "項目が無い応答では今の値を保つ（null）");
+    Assert(LauncherApiClient.ParsePythonVenvPath(emptyVenvSettings.RootElement) == "", "空欄で保存されたら空（システムの Python）");
+}
+
 Console.WriteLine("LocalSearchLauncher tests passed");
 
 /// <summary>opencode の代わりに決めた NDJSON 行を返すテスト用ランナー。capture は引数ごとに決めた結果を返す。</summary>
