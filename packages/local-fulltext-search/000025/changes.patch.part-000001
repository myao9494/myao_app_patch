+def test_app_settings_persist_python_venv_path(tmp_path: Path) -> None:
+    """
+    ランチャーが .py を実行するときの venv（絶対パス）は共有設定として保存・再読込でき、
+    前後の空白だけを取り除く。未設定と空欄で保存したときは空のまま（既定のフォルダを補わない）。
+    """
+    connection = _create_connection(tmp_path)
+    service = IndexService(connection=connection)
+
+    assert service.get_app_settings().python_venv_path == ""
+
+    saved = service.update_app_settings(python_venv_path=r"  C:\Users\me\tools\.venv  ")
+
+    assert saved.python_venv_path == r"C:\Users\me\tools\.venv"
+    assert IndexService(connection=connection).get_app_settings().python_venv_path == r"C:\Users\me\tools\.venv"
+
+    untouched = service.update_app_settings(gantt_parent=5)
+    assert untouched.python_venv_path == r"C:\Users\me\tools\.venv"
+
+    cleared = service.update_app_settings(python_venv_path="   ")
+    assert cleared.python_venv_path == ""
+
+
 def test_app_settings_persist_obsidian_sidebar_explorer_data_path(tmp_path: Path) -> None:
     """
     Obsidian sidebar-explorer の data.json パスはアプリ共有設定として保存・再読込できる。
diff --git a/docs/runtime_and_distribution.md b/docs/runtime_and_distribution.md
index 491324da6e27afdf59312ae364dfbe1a07c8c84f..d48c515776067536021d0e55621c76ad2925d489 100644
--- a/docs/runtime_and_distribution.md
+++ b/docs/runtime_and_distribution.md
@@ -169,6 +169,7 @@ $env:SEARCH_APP_PORT="8079"
 - `hidden_indexed_targets.txt`
 - `synonym_groups.txt`
 - `obsidian_sidebar_explorer_data_path.txt`
+- `python_venv_path.txt`（ランチャーが `.py` を実行するときの venv。空ならシステムの Python）
 - `index_selected_extensions.txt`
 - `custom_content_extensions.txt`
 - `custom_filename_extensions.txt`
