-    """極端な更新日時のファイルをインデックスする。"""
+    """
+    極端な更新日時（1960 年・1970 年・3499 年）のファイルをインデックスし、ファイルシステムが実際に保存した日時を返す。
+    遠い将来の日時は、ファイルシステムが保存できる上限で切り詰められる（NTFS は 3499 年のまま、
+    macOS の APFS は 1970 年からのナノ秒の 64 ビット上限の 2262-04-11）。どちらでも Windows の時刻変換の上限
+    （1970 年より前・3000 年より後）や 2038 年問題の範囲を越えるため、検索が壊れないことを確かめられる。
+    """
     target = (tmp_path / "times").resolve()
     target.mkdir()
-    times = {"past": -315619200.0, "epoch": 0.0, "future": 48281000000.0}
-    for name, value in times.items():
+    requested = {"past": -315619200.0, "epoch": 0.0, "future": 48281000000.0}
+    times: dict[str, float] = {}
+    for name, value in requested.items():
         path = target / f"{name}.md"
         path.write_text(f"zebra {name}", encoding="utf-8")
         os.utime(path, (value, value))
+        times[name] = path.stat().st_mtime
     client.post("/api/index/search-targets", json={"folder_path": target.as_posix(), "index_depth": 5})
     client.post("/api/index/search-targets/reindex", json={"folder_paths": [target.as_posix()]})
     return times
@@ -192,7 +200,11 @@ def test_files_with_extreme_times_are_searchable(
 
     assert response.status_code == 200
     assert response.json()["total"] == len(indexed_times)
-    assert {item["mtime"][:4] for item in response.json()["items"]} == {"1960", "1970", "3499"}
+    expected_years = {
+        f"{(datetime(1970, 1, 1, tzinfo=timezone.utc) + timedelta(seconds=value)).year:04d}" for value in indexed_times.values()
+    }
+    assert expected_years >= {"1960", "1970"} and max(expected_years) >= "2262", "遠い将来の日時を保存できている"
+    assert {item["mtime"][:4] for item in response.json()["items"]} == expected_years
 
 
