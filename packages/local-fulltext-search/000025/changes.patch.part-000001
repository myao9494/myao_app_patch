+                // .py は 同じ階層の .venv → 設定の venv → システムの Python の順で選ぶ（PythonEnv）。設定した venv が無ければ開かない
+                var pythonInterpreter = PythonEnv.IsPythonScript(item.FullPath) ? PythonEnv.Resolve(item.FullPath, _pythonVenvPath) : null;
                 var clickTask = _api.RecordClickAsync(item, QueryBox.Text.Trim());
-                if (UsesSystemFileLauncher(item.FullPath)) OpenFileWithSystemDefault(item.FullPath);
+                if (pythonInterpreter is not null)
+                    Process.Start(PythonEnv.BuildRunStartInfo(item.FullPath, pythonInterpreter, PythonEnv.EnsureRunWrapper(PythonEnv.DefaultRunWrapperDirectory)));
+                else if (UsesSystemFileLauncher(item.FullPath)) OpenFileWithSystemDefault(item.FullPath);
                 else OpenUrl(PrimaryUrl(item));
                 try { await clickTask; } catch { }
             }
             HideLauncherWindow();
         }
-        catch (Exception error) { Status.Text = $"結果を開けません: {error.Message}"; }
+        catch (Exception error)
+        {
+            Status.Text = $"結果を開けません: {error.Message}";
+            // .py を実行できなかった理由（venv が見つからない・python が PATH に無い等）はステータスだけだと見落とすため、ポップアップでも知らせる
+            if (!item.IsGantt && PythonEnv.IsPythonScript(item.FullPath))
+                MessageBox.Show(this, error.Message, "Python を実行できません", MessageBoxButton.OK, MessageBoxImage.Error);
+        }
     }
 
     private async void Results_MouseDoubleClick(object sender, MouseButtonEventArgs e)
@@ -387,13 +399,14 @@ public partial class MainWindow : Window
         target.Focus();
     }
 
-    /// <summary>Web の設定（gantt parent・opencode 実行フォルダ・常時保持メモ）を取り直して反映する。</summary>
+    /// <summary>Web の設定（gantt parent・opencode 実行フォルダ・.py 実行用の venv・常時保持メモ）を取り直して反映する。</summary>
     private async Task RefreshSharedSettingsAsync()
     {
         try
         {
             var shared = await _api.GetSharedSettingsAsync(_ganttParent, _services.OpenCode.WorkingDir);
             _ganttParent = shared.GanttParent;
+            if (shared.PythonVenvPath is not null) _pythonVenvPath = shared.PythonVenvPath;
             _services.OpenCode.SetWorkingDir(shared.OpenCodeWorkingDir);
             if (shared.HasLauncherMemo) _services.Memo.Load(shared.LauncherMemo);
             _services.OpenCode.SlashCommands = await _api.GetSlashCommandsAsync();
diff --git a/launcher/windows/LocalSearchLauncher/PythonEnv.cs b/launcher/windows/LocalSearchLauncher/PythonEnv.cs
new file mode 100644
index 0000000000000000000000000000000000000000..d1a8d08861d949608df230cafbb9af6dd3e9900c
--- /dev/null
+++ b/launcher/windows/LocalSearchLauncher/PythonEnv.cs
@@ -0,0 +1,111 @@
+/**
+ * ランチャーで .py を開くときに使う Python（venv）を選び、起動のしかたを組み立てる。
+ * Python 版（launcher_app/python_env.py）と同じ約束で動く。
+ *
+ * 【仕様】
+ * - スクリプトと同じ階層（親フォルダの直下）に .venv があれば、その venv の Python で実行する。さらに上の階層の .venv は見ない。
+ * - 無ければ、Web 設定ドロワーの「Python 実行環境（.venv）」（共有設定 python_venv_path。絶対パス）の venv で実行する。
+ *   venv フォルダの代わりに python 実行ファイルそのものを指定してもよい。
+ * - どちらも無い（設定が空欄）ときは、システムの Python（コマンド名 python。実行ファイルは PATH から探す）で実行する。
+ * - 設定した venv が見つからない・絶対パスでないときは、別の Python で代わりに動かさず PythonEnvException にする。
+ * - 実行時の current dir はスクリプトの親フォルダ。ランチャーはコンソールを持たないため、Python は新しいコンソールで動く。
+ * - 起動用ラッパー（launcher/src/launcher_app/python_run_wrapper.py を埋め込んだもの）を挟んで実行し、
+ *   スクリプトが例外や 0 以外の終了コードで終わったらトレースバックの末尾をポップアップで知らせる（コンソールの表示はそのまま）。
+ **/
+using System.Diagnostics;
+using System.IO;
+
+namespace LocalSearchLauncher;
+
+/// <summary>設定した venv が使えないため、.py を実行しなかったことを表す。</summary>
+internal sealed class PythonEnvException(string message) : Exception(message);
+
+internal static class PythonEnv
+{
+    /// <summary>venv の中で Python 実行ファイルが置かれる場所（Windows の venv と macOS / Linux の venv）。</summary>
+    private static readonly string[] InterpreterCandidates =
+    [
+        Path.Combine("Scripts", "python.exe"),
+        Path.Combine("bin", "python"),
+        Path.Combine("bin", "python3"),
+    ];
+
+    internal const string SiblingVenvName = ".venv";
+
+    /// <summary>埋め込んだ起動用ラッパーのリソース名とファイル名。</summary>
+    internal const string RunWrapperResourceName = "LocalSearchLauncher.python_run_wrapper.py";
+    internal const string RunWrapperFileName = "python_run_wrapper.py";
+
+    /// <summary>起動用ラッパーを取り出す既定のフォルダ（%TEMP%\\LocalSearchLauncher）。</summary>
+    internal static string DefaultRunWrapperDirectory => Path.Combine(Path.GetTempPath(), "LocalSearchLauncher");
+
+    /// <summary>システムの Python のコマンド名（PATH から探す）。Python 版の Windows での値と同じ。</summary>
+    internal const string SystemPythonCommand = "python";
+
+    /// <summary>拡張子が .py（大文字小文字は問わない）のファイルかを返す。</summary>
+    internal static bool IsPythonScript(string path) =>
+        string.Equals(Path.GetExtension(path), ".py", StringComparison.OrdinalIgnoreCase);
+
+    /// <summary>venv フォルダから Python 実行ファイルのパスを返す。python 実行ファイルそのものならそのまま返す。無ければ null。</summary>
+    internal static string? VenvInterpreter(string venvPath)
+    {
+        if (File.Exists(venvPath)) return venvPath;
+        if (!Directory.Exists(venvPath)) return null;
+        foreach (var candidate in InterpreterCandidates)
+        {
+            var interpreter = Path.Combine(venvPath, candidate);
+            if (File.Exists(interpreter)) return interpreter;
+        }
+        return null;
+    }
+
+    /// <summary>
+    /// スクリプトを実行する Python（パスまたはコマンド名）を返す。
+    /// 優先順: スクリプトと同じ階層の .venv → 設定の venv → システムの Python。
+    /// 設定した venv が使えないときは PythonEnvException（システムの Python で代わりに動かさない）。
+    /// </summary>
+    internal static string Resolve(string scriptPath, string? configuredVenv)
+    {
+        var scriptDir = Path.GetDirectoryName(scriptPath);
+        var sibling = string.IsNullOrEmpty(scriptDir) ? null : VenvInterpreter(Path.Combine(scriptDir, SiblingVenvName));
+        if (sibling is not null) return sibling;
+        var configured = (configuredVenv ?? "").Trim();
+        if (configured.Length == 0) return SystemPythonCommand;
+        if (!Path.IsPathFullyQualified(configured))
+            throw new PythonEnvException($"Python 実行環境（.venv）は絶対パスで指定してください: {configured}");
+        return VenvInterpreter(configured)
+            ?? throw new PythonEnvException($"Python 実行環境（.venv）が見つかりません: {configured}");
+    }
+
+    /// <summary>
+    /// 埋め込んだ起動用ラッパーを directory へ書き出し、そのパスを返す。
+    /// 一時フォルダが掃除されたときや、ランチャーの更新で中身が変わったときは書き直す（同じなら書かない）。
+    /// </summary>
+    internal static string EnsureRunWrapper(string directory)
+    {
+        using var stream = typeof(PythonEnv).Assembly.GetManifestResourceStream(RunWrapperResourceName)
+            ?? throw new InvalidOperationException($"起動用ラッパーがランチャーに含まれていません: {RunWrapperResourceName}");
+        using var memory = new MemoryStream();
+        stream.CopyTo(memory);
+        var content = memory.ToArray();
+        var path = Path.Combine(directory, RunWrapperFileName);
+        if (File.Exists(path) && File.ReadAllBytes(path).AsSpan().SequenceEqual(content)) return path;
+        Directory.CreateDirectory(directory);
+        File.WriteAllBytes(path, content);
+        return path;
+    }
+
+    /// <summary>指定した Python で、起動用ラッパー経由でスクリプトを実行する起動情報（current dir はスクリプトの親フォルダ）。</summary>
+    internal static ProcessStartInfo BuildRunStartInfo(string scriptPath, string interpreter, string wrapperPath)
+    {
+        // 標準入出力をつなぎ替えないので、コンソールを持たないランチャーから起動すると新しいコンソールが開く
+        var info = new ProcessStartInfo(interpreter)
+        {
+            UseShellExecute = false,
+            WorkingDirectory = Path.GetDirectoryName(scriptPath) ?? Environment.CurrentDirectory,
+        };
+        info.ArgumentList.Add(wrapperPath);
+        info.ArgumentList.Add(scriptPath);
+        return info;
+    }
+}
diff --git a/launcher/windows/README.md b/launcher/windows/README.md
index e8c658f75d9553e7a1e308020fb5e4c74c36477d..20bb7dc507db370b6fad15495c7580742b01a633 100644
--- a/launcher/windows/README.md
+++ b/launcher/windows/README.md
@@ -10,7 +10,7 @@ Windows標準APIと.NET標準機能だけで動く、Windows x64向けランチ
 - ウィンドウ上部の「Local Search」領域をドラッグして表示位置を移動可能
 - 多重起動防止
 
-WPF版はmacOSネイティブ版の操作仕様に合わせ、検索欄右側の拡張子フィルタ、gantt検索、タスク名・メモ・送信・キャンセル、共有parent取得、パスコピー、保存場所、フォルダ、ganttリンク、GUIボタン、上下キー循環選択を提供します。表示直後に検索欄へフォーカスし、検索結果の先頭が選択されていれば矢印操作なしの `Return` / `Enter` で開きます。縦画面モニターでも収まる幅（1040×940）に4ペイン（左上: 検索、右上: OpenCode CLI、左下: 常時保持メモ、右下: ganttメモ）を統合し、`Tab` / `Shift + Tab` は「検索欄 → 拡張子欄 → OpenCode入力 → OpenCode送信 → 常時保持メモ → タスク名 → メモ → gantt送信 → 検索欄」を循環します。OpenCode入力欄およびgantt入力欄では `Ctrl + Enter` で即時送信できます。opencode の会話と常時保持メモはアプリ側が持つため、Esc でウィンドウを閉じても実行中の opencode とメモの保存は止まらず、再表示すると途中経過から表示します（仕様は `docs/gantt_launcher_ui.md`）。`.py`、`.bat`、`.exe`、`.lnk` は8001のOpenハブを経由せず、親フォルダをcurrent directoryとして直接起動します。検索結果領域は横スクロールを使わず、長いパス・抜粋・操作ボタンを折り返します。Windowsの検索性能仕様に従い、通常時（「更新」チェックOFF）は既存DB専用API（`/api/search/indexed`）を使用してベクトルのインデックス作成を待たず既存DBだけで即座に高速検索し、「更新」チェックON時は最新のインデックス作成・更新を待ってから検索します。gantt選択時は `skip_refresh=true` の `/api/search` を使用し、いずれもローカルファイルとWebページの両方を既存DBから横断検索します。
+WPF版はmacOSネイティブ版の操作仕様に合わせ、検索欄右側の拡張子フィルタ、gantt検索、タスク名・メモ・送信・キャンセル、共有parent取得、パスコピー、保存場所、フォルダ、ganttリンク、GUIボタン、上下キー循環選択を提供します。表示直後に検索欄へフォーカスし、検索結果の先頭が選択されていれば矢印操作なしの `Return` / `Enter` で開きます。縦画面モニターでも収まる幅（1040×940）に4ペイン（左上: 検索、右上: OpenCode CLI、左下: 常時保持メモ、右下: ganttメモ）を統合し、`Tab` / `Shift + Tab` は「検索欄 → 拡張子欄 → OpenCode入力 → OpenCode送信 → 常時保持メモ → タスク名 → メモ → gantt送信 → 検索欄」を循環します。OpenCode入力欄およびgantt入力欄では `Ctrl + Enter` で即時送信できます。opencode の会話と常時保持メモはアプリ側が持つため、Esc でウィンドウを閉じても実行中の opencode とメモの保存は止まらず、再表示すると途中経過から表示します（仕様は `docs/gantt_launcher_ui.md`）。`.py`、`.bat`、`.exe`、`.lnk` は8001のOpenハブを経由せず、親フォルダをcurrent directoryとして直接起動します。`.py` はスクリプトと同じ階層の `.venv` → Web 設定ドロワーの「Python 実行環境（.venv）」（絶対パス）→ システムの `python` の順に選んだ Python で、新しいコンソールに実行します。設定した venv が見つからないなど実行できないときは理由をポップアップで出し、実行したスクリプトが例外や 0 以外の終了コードで終わったときは、埋め込んだ起動用ラッパー（`launcher/src/launcher_app/python_run_wrapper.py`）がトレースバックの末尾をポップアップで出します（仕様は `launcher/docs/spec.md`）。検索結果領域は横スクロールを使わず、長いパス・抜粋・操作ボタンを折り返します。Windowsの検索性能仕様に従い、通常時（「更新」チェックOFF）は既存DB専用API（`/api/search/indexed`）を使用してベクトルのインデックス作成を待たず既存DBだけで即座に高速検索し、「更新」チェックON時は最新のインデックス作成・更新を待ってから検索します。gantt選択時は `skip_refresh=true` の `/api/search` を使用し、いずれもローカルファイルとWebページの両方を既存DBから横断検索します。
 
 右上の OpenCode ペインは Obsidian の Claudian 風チャットです（吹き出し・思考/ツールの折りたたみ・コピー・使用量、Enter で送信 / Shift+Enter で改行 / ↑↓ で過去の指示、履歴からの再開・モデル・Plan・自動承認、実行中の送信は待ち行列で送信ボタンは「停止」、「/ コマンド」で登録したスラッシュコマンドを `/` の候補・Tab 補完で実行、左上の ☰ メニューで opencode 実行フォルダを選ぶ／既定に戻す）。詳細は `docs/opencode_chat_pane_spec.md`。
 
