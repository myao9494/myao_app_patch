+
+    await typeInto(venv, "");
+    await click(saveRowAfter(venv).button);
+
+    assert.deepEqual(app.lastBody("PUT /api/index/settings"), { python_venv_path: "" });
+    assert.equal(saveRowAfter(venv).status(), "保存済み");
+  });
+});
