+      assert.equal(app.api.requestsTo("POST /api/export/config").length, posts, "0 はサーバーへ保存しない");
+      await click(findByText(modal, ".ai-preview-modal-header button", "2ファイルを保存"));
+      assert.equal(app.lastBody("POST /api/export/ai-bundle/save").figure_pdf_max_mb, 4.5, "直前の有効な値を使う");
     },
   );
 });
