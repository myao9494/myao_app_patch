diff --git a/backend/tests/test_export_timing.py b/backend/tests/test_export_timing.py
new file mode 100644
index 0000000000000000000000000000000000000000..ec53132ea0124fa48c708856f5e2ea34e8f839ef
--- /dev/null
+++ b/backend/tests/test_export_timing.py
@@ -0,0 +1,105 @@
+"""
+書き出しの段階別所要時間（app.vector.export_timing）のテスト。
+
+仕様:
+- スコープ内の `stage(名前, 詳細)` で、段階ごとの合計秒・回数・遅い上位の詳細を集計する。
+- スコープ外の `stage` は何もしない（例外も出さない）。
+- スコープ終了時に集計を返し、`format_report` で人が読める表にできる。
+- `timed_export` で包んだ関数は、戻り値の stats に `timings` を足し、データフォルダへレポートを追記する。
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from app.vector.export_timing import (
+    TIMING_LOG_FILE_NAME,
+    format_report,
+    stage,
+    timed_export,
+    timing_scope,
+)
+
+
+def test_stage_outside_scope_is_noop() -> None:
+    with stage("画像解決", "a.png"):
+        pass
+
+
+def test_scope_aggregates_count_total_and_slowest(monkeypatch) -> None:
+    clock = iter([0.0, 0.0, 1.0, 1.0, 4.0, 4.0, 4.5, 4.5])
+    monkeypatch.setattr("app.vector.export_timing.time.perf_counter", lambda: next(clock))
+    with timing_scope() as result:
+        with stage("画像解決", "a.png"):
+            pass
+        with stage("画像解決", "b.png"):
+            pass
+        with stage("メール解析", "m.msg"):
+            pass
+    images = result["stages"]["画像解決"]
+    assert images["count"] == 2
+    assert images["seconds"] == 4.0
+    assert images["slowest"][0] == {"detail": "b.png", "seconds": 3.0}
+    assert result["stages"]["メール解析"]["count"] == 1
+
+
+def test_nested_stage_is_recorded_independently(monkeypatch) -> None:
+    with timing_scope() as result:
+        with stage("外側"):
+            with stage("内側"):
+                pass
+    assert set(result["stages"]) == {"外側", "内側"}
+
+
+def test_format_report_lists_stages_sorted_by_time() -> None:
+    report = format_report(
+        {
+            "total_seconds": 10.0,
+            "stages": {
+                "速い": {"count": 1, "seconds": 1.0, "slowest": []},
+                "遅い": {"count": 3, "seconds": 8.0, "slowest": [{"detail": "x.png", "seconds": 5.0}]},
+            },
+        },
+        label="export",
+    )
+    assert report.index("遅い") < report.index("速い")
+    assert "x.png" in report
+
+
+def test_timed_export_adds_timings_and_writes_report(tmp_path: Path, monkeypatch) -> None:
+    monkeypatch.setattr("app.vector.export_timing.get_timing_log_dir", lambda: tmp_path)
+
+    @timed_export("テスト書き出し")
+    def run():
+        with stage("画像解決", "a.png"):
+            pass
+        return "body", {"total_documents": 1}
+
+    body, stats = run()
+    assert body == "body"
+    assert "画像解決" in stats["timings"]["stages"]
+    log_text = (tmp_path / TIMING_LOG_FILE_NAME).read_text(encoding="utf-8")
+    assert "テスト書き出し" in log_text and "画像解決" in log_text
+
+
+def test_timed_export_survives_log_write_failure(tmp_path: Path, monkeypatch) -> None:
+    monkeypatch.setattr("app.vector.export_timing.get_timing_log_dir", lambda: tmp_path / "missing" / "dir")
+
+    @timed_export("x")
+    def run():
+        return "b", {}
+
+    assert run()[0] == "b"
+
+
+def test_html_export_stats_include_stage_timings(tmp_path: Path) -> None:
+    from app.vector.html_exporter import export_documents_to_html
+
+    note = tmp_path / "note.md"
+    note.write_text("# t\n![[missing.png]]\n", encoding="utf-8")
+    _, stats = export_documents_to_html(file_paths=[str(note)], include_images=True)
+
+    stages = stats["timings"]["stages"]
+    assert "画像・図面の埋め込み" in stages
+    assert "Markdown→HTML変換" in stages
+    assert stats["timings"]["total_seconds"] >= 0
diff --git a/backend/tests/test_file_name_index.py b/backend/tests/test_file_name_index.py
new file mode 100644
index 0000000000000000000000000000000000000000..7cf736dc0a2b7a93811114cabdb96f1a9b415afb
--- /dev/null
+++ b/backend/tests/test_file_name_index.py
@@ -0,0 +1,138 @@
+"""
+ファイル名索引（app.vector.file_name_index）のテスト。
+
+仕様:
+- 同じ根フォルダへの探索は、スコープ内では 1 回の走査結果を共有する（os.walk を繰り返さない）。
+- 候補名が複数あるときは、走査順で先に現れるフォルダを優先し、同じフォルダ内では候補の並び順を優先する。
+- スコープ外では従来どおり早期終了する走査で、結果は同じになる。
+- 隠しフォルダの扱いは hidden 指定（skip_files / prune / none）で従来の各探索と一致させる。
+"""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+import pytest
+
+from app.vector import file_name_index
+from app.vector.file_name_index import find_file_by_names, file_name_index_scope
+
+
+def _make_tree(root: Path) -> None:
+    (root / "a").mkdir()
+    (root / "b").mkdir()
+    (root / ".hidden").mkdir()
+    (root / "a" / "pic.png").write_bytes(b"a")
+    (root / "b" / "pic.png").write_bytes(b"b")
+    (root / "b" / "pic.svg").write_bytes(b"s")
+    (root / ".hidden" / "only.png").write_bytes(b"h")
+
+
+def test_finds_first_match_in_walk_order(tmp_path: Path) -> None:
+    _make_tree(tmp_path)
+    found = find_file_by_names(tmp_path, ["pic.png"])
+    assert found is not None and found.name == "pic.png"
+    assert found.parent.name in {"a", "b"}
+
+
+def test_candidate_priority_within_same_directory(tmp_path: Path) -> None:
+    (tmp_path / "d").mkdir()
+    (tmp_path / "d" / "x.png").write_bytes(b"1")
+    (tmp_path / "d" / "x.svg").write_bytes(b"2")
+    assert find_file_by_names(tmp_path, ["x.svg", "x.png"]).name == "x.svg"
+    with file_name_index_scope():
+        assert find_file_by_names(tmp_path, ["x.svg", "x.png"]).name == "x.svg"
+        assert find_file_by_names(tmp_path, ["x.png", "x.svg"]).name == "x.png"
+
+
+def test_scope_and_unscoped_give_same_result(tmp_path: Path) -> None:
+    _make_tree(tmp_path)
+    names = ["missing.png", "pic.svg", "pic.png"]
+    plain = find_file_by_names(tmp_path, names)
+    with file_name_index_scope():
+        scoped = find_file_by_names(tmp_path, names)
+    assert plain == scoped
+
+
+def test_hidden_modes(tmp_path: Path) -> None:
+    _make_tree(tmp_path)
+    for scoped in (False, True):
+        def run(hidden: str):
+            if scoped:
+                with file_name_index_scope():
+                    return find_file_by_names(tmp_path, ["only.png"], hidden=hidden)
+            return find_file_by_names(tmp_path, ["only.png"], hidden=hidden)
+
+        assert run("skip_files") is None
+        assert run("prune") is None
+        assert run("none") is not None
+
+
+def test_missing_returns_none(tmp_path: Path) -> None:
+    _make_tree(tmp_path)
+    with file_name_index_scope():
+        assert find_file_by_names(tmp_path, ["nope.png"]) is None
+    assert find_file_by_names(tmp_path / "does-not-exist", ["x"]) is None
+
+
+def test_scope_walks_each_root_only_once(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    _make_tree(tmp_path)
+    calls = {"n": 0}
+    real_walk = os.walk
+
+    def counting_walk(*args, **kwargs):
+        calls["n"] += 1
+        return real_walk(*args, **kwargs)
+
+    monkeypatch.setattr(file_name_index.os, "walk", counting_walk)
+    with file_name_index_scope():
+        for _ in range(20):
+            find_file_by_names(tmp_path, ["missing.png"])
+            find_file_by_names(tmp_path, ["pic.png"])
+    assert calls["n"] == 1
+
+
+def test_nested_scope_shares_outer_index(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    _make_tree(tmp_path)
+    calls = {"n": 0}
+    real_walk = os.walk
+
+    def counting_walk(*args, **kwargs):
+        calls["n"] += 1
+        return real_walk(*args, **kwargs)
+
+    monkeypatch.setattr(file_name_index.os, "walk", counting_walk)
+    with file_name_index_scope():
+        find_file_by_names(tmp_path, ["pic.png"])
+        with file_name_index_scope():
+            find_file_by_names(tmp_path, ["pic.svg"])
+    assert calls["n"] == 1
+
+
+def test_scope_does_not_leak_after_exit(tmp_path: Path) -> None:
+    _make_tree(tmp_path)
+    with file_name_index_scope():
+        assert find_file_by_names(tmp_path, ["late.png"]) is None
+    (tmp_path / "a" / "late.png").write_bytes(b"x")
+    assert find_file_by_names(tmp_path, ["late.png"]) is not None
+
+
+def test_html_export_walks_vault_once_for_many_missing_images(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    """見つからない画像が多数あっても、書き出し 1 回で同じフォルダの走査は 1 回だけ（根ごと）。"""
+    from app.vector.html_exporter import export_documents_to_html
+
+    note = tmp_path / "note.md"
+    note.write_text("\n".join(f"![[missing_{i}.png]]" for i in range(30)), encoding="utf-8")
+
+    walked: list[str] = []
+    real_walk = os.walk
+
+    def recording_walk(top, *args, **kwargs):
+        walked.append(str(top))
+        return real_walk(top, *args, **kwargs)
+
+    monkeypatch.setattr(file_name_index.os, "walk", recording_walk)
+    export_documents_to_html(file_paths=[str(note)], include_images=True)
+
+    assert len(walked) == len(set(walked)), walked
