+test("プレビューに、生成した HTML の文字数（画像を除く）を上限とともに表示する", async () => {
+  const routes: Routes = {
+    "POST /api/export/ai-html": (request) => {
+      const response = (generateRoute["POST /api/export/ai-html"] as (r: typeof request) => Record<string, unknown>)(request);
+      const html = response.html_content as string;
+      return {
+        ...response,
+        total_chars: 123_456,
+        char_limit: 200_000,
+        size_limit_bytes: 4_500_000,
+        html_parts: [{ index: 1, total: 1, chars: 123_456, bytes: 2_100_000, html_content: html }],
+      };
+    },
+  };
+  await withAiInput({ routes }, async (app, page) => {
+    const modal = await generate(app, page);
+    const summary = normalizeText(findBySelector(modal, ".ai-output-summary").textContent);
+    assert.match(summary, /合計 12\.35万文字/);
+    assert.match(summary, /123,456\s*\/\s*上限\s*200,000/);
+    assert.match(summary, /2\.10MB\s*\/\s*上限\s*4\.50MB/);
+    assert.equal(hasElement(modal, ".ai-output-part-tabs"), false, "1 ファイルならパートの切り替えは出さない");
+  });
+});
+
+test("上限を超えて分割されたら、パートを切り替えて表示・コピー・ダウンロード・保存できる", async () => {
+  const partHtml = ["<html><body>パート1</body></html>", "<html><body>パート2</body></html>"];
+  const routes: Routes = {
+    "POST /api/export/ai-html": (request) => {
+      const response = (generateRoute["POST /api/export/ai-html"] as (r: typeof request) => Record<string, unknown>)(request);
+      return {
+        ...response,
+        html_content: partHtml[0],
+        total_chars: 216_441,
+        char_limit: 200_000,
+        size_limit_bytes: 4_500_000,
+        html_parts: [
+          { index: 1, total: 2, chars: 160_731, bytes: 3_880_469, html_content: partHtml[0] },
+          { index: 2, total: 2, chars: 55_710, bytes: 4_332_827, html_content: partHtml[1] },
+        ],
+      };
+    },
+    "POST /api/export/ai-html/save-parts": {
+      success: true,
+      saved_paths: ["/tmp/export/AI_Context_Document_part1of2.html", "/tmp/export/AI_Context_Document_part2of2.html"],
+      file_names: ["AI_Context_Document_part1of2.html", "AI_Context_Document_part2of2.html"],
+      sizes: [1, 1],
+      problems: [],
+      attachment_warning: "",
+    },
+  };
+  await withAiInput({ routes }, async (app, page) => {
+    const modal = await generate(app, page);
+    const summary = normalizeText(findBySelector(modal, ".ai-output-summary").textContent);
+    assert.match(summary, /合計 21\.64万文字/);
+    assert.match(summary, /上限を超えるため全2ファイルに分割して出力します/);
+    const tabs = [...modal.querySelectorAll<HTMLButtonElement>(".ai-output-part-tabs button")];
+    assert.deepEqual(tabs.map((tab) => normalizeText(tab.textContent)), [
+      "パート1/2 (16.07万文字・3.88MB)",
+      "パート2/2 (5.57万文字・4.33MB)",
+    ]);
+    assert.equal(previewHtml(modal), partHtml[0]);
+
+    await click(tabs[1]);
+    assert.equal(previewHtml(modal), partHtml[1]);
+    await click(findByText(modal, ".ai-preview-modal-header button", "コードコピー"));
+    assert.deepEqual(app.dom.clipboardWrites, [partHtml[1]], "コピーは表示中のパート");
+
+    await click(findByText(modal, ".ai-preview-modal-header button", "HTML DL"));
+    assert.deepEqual(await Promise.all(app.dom.downloads.map((blob) => blob.text())), partHtml, "ダウンロードは全パート");
+
+    await click(findBySelector(modal, "button.save-copy-path-button"));
+    assert.deepEqual(app.lastBody("POST /api/export/ai-html/save-parts"), {
+      html_parts: partHtml,
+      file_name: "AI_Context_Document.html",
+    });
+    assert.equal(app.api.requestsTo("POST /api/export/ai-html/save").length, 0);
+    assert.equal(last(app.dom.clipboardWrites), "/tmp/export/AI_Context_Document_part1of2.html\n/tmp/export/AI_Context_Document_part2of2.html");
+    assert.match(normalizeText(modal.textContent), /2ファイルのパスをコピーしました/);
+  });
+});
+
