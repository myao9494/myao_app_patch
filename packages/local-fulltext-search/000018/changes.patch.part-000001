+
+def _toc_item(anchor_id: str, escaped_title: str, escaped_rel_path: str, depth_level: int, parent_text: str) -> str:
+    """目次の 1 行。リンク先ノートは階層に応じて字下げする。"""
+    if depth_level > 0:
+        indent_style = f"margin-left: {depth_level * 18}px;"
+        return (
+            f'<li class="toc-child" style="{indent_style}">↳ <span class="badge depth-badge">階層 {depth_level}</span>'
+            f'<a href="#{anchor_id}">{escaped_title}</a>{parent_text} <span style="font-size: 11px; color: #94a3b8;">({escaped_rel_path})</span></li>'
+        )
+    return f'<li><a href="#{anchor_id}">{escaped_title}</a> <span style="font-size: 11px; color: #94a3b8;">({escaped_rel_path})</span></li>'
+
+
+def _raw_markdown_details(cleaned_raw: str) -> str:
+    """マークダウン元データの折りたたみ欄。"""
+    return f"""
+            <details class="doc-raw-markdown" open>
+                <summary>📝 マークダウンファイルの元データ</summary>
+                <pre><code>{html.escape(cleaned_raw)}</code></pre>
+            </details>
+            """
+
+
+# 長いノートを分けるときの区切り（見出し行を優先する）
+_MARKDOWN_HEADING_BOUNDARY = re.compile(r"(?m)^#{1,6}\s")
+# 分けるときは埋め込み画像の base64 を数えないよう、いったん短い印に置き換える
+_EMBEDDED_DATA_URL = re.compile(r"data:[\w.+/-]+;base64,[A-Za-z0-9+/=]+")
+
+
+def _split_long_document(
+    processed_md: str,
+    cleaned_raw: str,
+    budget: int,
+    render_body: Callable[[str], str],
+) -> List[Tuple[str, str]]:
+    """
+    1 ノートで文字数の予算を超える本文を、見出し → 空行 → 改行 の順に区切って (本文 HTML, 元データ HTML) の並びにする。
+    描画すると文字数が増えるため、描画後に予算を超えた塊があれば、区切りを細かくしてやり直す。
+    元データは本文の後ろに、予算に収まる大きさで分けて続ける。
+    """
+    images: List[str] = []
+
+    def stash(match: "re.Match[str]") -> str:
+        images.append(match.group(0))
+        return f"\x00IMG{len(images) - 1}\x00"
+
+    masked = _EMBEDDED_DATA_URL.sub(stash, processed_md)
+
+    def restore(text: str) -> str:
+        return re.sub(r"\x00IMG(\d+)\x00", lambda m: images[int(m.group(1))], text)
+
+    chunk_budget = max(500, budget // 2)
+    bodies: List[str] = []
+    for _ in range(6):
+        bodies = [render_body(restore(chunk)) for chunk in split_text_chunks(masked, chunk_budget, _MARKDOWN_HEADING_BOUNDARY)]
+        if all(html_text_chars(body) <= budget - 2_000 for body in bodies) or chunk_budget <= 500:
+            break
+        chunk_budget = max(500, int(chunk_budget * 0.6))
+    pieces = [(body, "") for body in bodies]
+    if cleaned_raw:
+        raw_budget = max(500, (budget - 2_000) // 2)
+        pieces.extend(("", _raw_markdown_details(chunk)) for chunk in split_text_chunks(cleaned_raw, raw_budget, _MARKDOWN_HEADING_BOUNDARY))
+    return pieces
