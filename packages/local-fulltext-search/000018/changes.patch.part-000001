+test("メールの宛先は既定で含めず、チェックを入れて作り直すと宛先つきで生成する（トークン最適化はそのまま）", async () => {
+  await withAiInput({}, async (app, page) => {
+    const modal = await generate(app, page);
+    assert.equal(generateBodies(app)[0].include_email_recipients, false);
+    const recipients = findBySelector<HTMLInputElement>(findByText(modal, "label", "メールの宛先を含める"), "input");
+    assert.equal(recipients.checked, false);
+
+    await click(recipients);
+    await wait(REGENERATE_WAIT_MS);
+
+    assert.equal(recipients.checked, true);
+    assert.equal(last(generateBodies(app))?.include_email_recipients, true);
+    assert.equal(last(generateBodies(app))?.optimize_tokens, true);
+  });
+});
