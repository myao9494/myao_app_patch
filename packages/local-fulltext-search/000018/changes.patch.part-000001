diff --git a/frontend/src/outputSize.test.ts b/frontend/src/outputSize.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..563a455c7af27ebe78c1b2e21641c3f52c7ab4ef
--- /dev/null
+++ b/frontend/src/outputSize.test.ts
@@ -0,0 +1,22 @@
+/**
+ * 出力の文字数・容量の表示（outputSize）のテスト。
+ */
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { countChars, formatMan, formatMegabytes } from "./outputSize.ts";
+
+test("文字数は「12.35万文字」の形にする", () => {
+  assert.equal(formatMan(123_456), "12.35万文字");
+  assert.equal(formatMan(0), "0.00万文字");
+});
+
+test("容量は MB（小数 2 桁、1MB = 1,000,000 バイト）で表す", () => {
+  assert.equal(formatMegabytes(4_500_000), "4.50MB");
+  assert.equal(formatMegabytes(3_880_469), "3.88MB");
+});
+
+test("絵文字などのサロゲートペアは 1 文字と数える（サーバーの数え方と同じ）", () => {
+  assert.equal(countChars("あ😀b"), 3);
+  assert.equal(countChars(""), 0);
+});
diff --git a/frontend/src/outputSize.ts b/frontend/src/outputSize.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fdcfff2d99855e8739249e2a8ab9b2d7f7390e82
--- /dev/null
+++ b/frontend/src/outputSize.ts
@@ -0,0 +1,24 @@
+/**
+ * AIインプット出力の文字数・容量の表示。
+ * - countChars: サロゲートペア（絵文字など）を 1 文字と数える（バックエンドの Python len と同じ数え方）。
+ * - formatMan: 文字数を「12.35万文字」の形にする。
+ * - formatMegabytes: 容量を「4.50MB」（1MB = 1,000,000 バイト、社内AIの 4.5MB 制限と同じ単位）の形にする。
+ * - DEFAULT_CHAR_LIMIT / DEFAULT_SIZE_LIMIT_BYTES: サーバーが上限を返さないときに使う社内AIの上限。
+ */
+export const DEFAULT_CHAR_LIMIT = 200_000;
+export const DEFAULT_SIZE_LIMIT_BYTES = 4_500_000;
+
+const SURROGATE_PAIR = /[\uD800-\uDBFF][\uDC00-\uDFFF]/g;
+
+export function countChars(text: string | null | undefined): number {
+  const value = text ?? "";
+  return value.length - (value.match(SURROGATE_PAIR)?.length ?? 0);
+}
+
+export function formatMan(count: number): string {
+  return `${(count / 10_000).toFixed(2)}万文字`;
+}
+
+export function formatMegabytes(bytes: number): string {
+  return `${(bytes / 1_000_000).toFixed(2)}MB`;
+}
diff --git a/frontend/src/types.ts b/frontend/src/types.ts
index 2bddcf0097b52788580cbd4455add0a0c021e4ce..f70ca432c4152662c5ab902a4b9dc6713acbd22c 100644
--- a/frontend/src/types.ts
+++ b/frontend/src/types.ts
@@ -143,6 +143,24 @@ export type AiHtmlExportResponse = {
   expanded_nodes?: ExpandedNode[];
   /** 見つからない・時間切れ・エラーで飛ばした項目（出力を優先し、詰まった箇所を示すため） */
   skipped_links?: SkippedLink[];
+  /** 社内AIの上限（20万文字・4.5MB）に収めた HTML ファイル。上限以内なら 1 つ */
+  html_parts?: AiHtmlPart[];
+  /** 分割前の文字数（埋め込み画像の base64 部分を除く） */
+  total_chars?: number;
+  char_limit?: number;
+  size_limit_bytes?: number;
+  /** 上限に収めきれなかったときの内容（空なら収まっている） */
+  limit_problems?: string[];
+};
+
+/** 上限に合わせて分割した HTML の 1 ファイル分 */
+export type AiHtmlPart = {
+  index: number;
+  total: number;
+  /** 文字数（埋め込み画像の base64 部分を除く） */
+  chars: number;
+  bytes: number;
+  html_content: string;
 };
 
 /** AI用HTMLの書き出しで処理できなかった項目 */
