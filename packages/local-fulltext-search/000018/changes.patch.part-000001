diff --git a/backend/tests/test_email_recipient_strip.py b/backend/tests/test_email_recipient_strip.py
new file mode 100644
index 0000000000000000000000000000000000000000..fc9957611b378078b2ad74ababf8e044b68927a0
--- /dev/null
+++ b/backend/tests/test_email_recipient_strip.py
@@ -0,0 +1,189 @@
+"""
+メール本文から宛先（To）・Cc・Bcc の行を除く strip_email_recipient_lines のテスト。
+
+仕様:
+- 見出しは日本語（宛先 / CC / BCC）と英語（To / Cc / Bcc）の両方。全角の「ＣＣ」「：」も対象。
+- 差出人・送信日時・件名などの他のヘッダー行と本文は残す。
+- プレーンテキスト:
+  - 行頭の見出し（引用の「>」が付いていてもよい）で始まる行を除く。
+  - 続く折り返し行は、インデントされた行か、直前の宛先行が「,」「;」で終わる行だけを除く。
+- HTML:
+  - <br>・</p>・</div>・</tr> で区切った 1 行の表示文字が見出しで始まるとき、その行の文字だけを除く（タグは残す）。
+  - Outlook の「<b>宛先<span>:</span></b>」のように見出しとコロンの間にタグがあっても対象にする。
+  - 文中の「mailto:」や「Go to: ...」のように行頭でない見出しは消さない。
+- 長い本文でも、本文の長さに対して線形に近い時間で終わる。
+"""
+
+from __future__ import annotations
+
+import time
+
+from app.vector.email_recipients import strip_email_recipient_lines
+
+
+def _tables(n: int) -> str:
+    return "".join(
+        f'<table><tr><td><p class="MsoNormal">本文{i} テキスト <b>太字</b></p></td><td>x</td></tr></table>'
+        for i in range(n)
+    )
+
+
+# ---------- プレーンテキスト ----------
+
+
+def test_plain_removes_to_cc_bcc_and_keeps_other_headers() -> None:
+    body = (
+        "お疲れ様です。\n"
+        "\n"
+        "-----Original Message-----\n"
+        "From: satou@example.com\n"
+        "Sent: Monday, October 20, 2026 10:00 AM\n"
+        "To: yamada@example.com; kato@example.com\n"
+        "Cc: suzuki@example.com\n"
+        "Bcc: hidden@example.com\n"
+        "Subject: 進捗確認\n"
+        "\n"
+        "進捗の件、了解しました。\n"
+    )
+    cleaned = strip_email_recipient_lines(body)
+    for address in ("yamada@example.com", "kato@example.com", "suzuki@example.com", "hidden@example.com"):
+        assert address not in cleaned
+    assert "From: satou@example.com" in cleaned
+    assert "Sent: Monday" in cleaned
+    assert "Subject: 進捗確認" in cleaned
+    assert "進捗の件、了解しました。" in cleaned
+
+
+def test_plain_removes_japanese_and_fullwidth_headings() -> None:
+    body = "差出人: 佐藤\n宛先: 山田 <yamada@example.com>\nＣＣ：鈴木 <suzuki@example.com>\nBCC: 隠し <h@example.com>\n件名: 会議\n本文です。\n"
+    cleaned = strip_email_recipient_lines(body)
+    assert "yamada@example.com" not in cleaned
+    assert "suzuki@example.com" not in cleaned
+    assert "h@example.com" not in cleaned
+    assert "差出人: 佐藤" in cleaned
+    assert "件名: 会議" in cleaned
+    assert "本文です。" in cleaned
+
+
+def test_plain_removes_quoted_reply_headers() -> None:
+    body = "了解です。\n\n> From: a@example.com\n> To: b@example.com\n> Subject: 件名\n> 元の本文\n"
+    cleaned = strip_email_recipient_lines(body)
+    assert "b@example.com" not in cleaned
+    assert "> From: a@example.com" in cleaned
+    assert "> 元の本文" in cleaned
+
+
+def test_plain_removes_continuation_lines() -> None:
+    body = (
+        "To: a@example.com, b@example.com,\n"
+        "    c@example.com\n"
+        "Cc: d@example.com;\n"
+        "e@example.com\n"
+        "Subject: 件名\n"
+    )
+    cleaned = strip_email_recipient_lines(body)
+    for address in ("a@example.com", "c@example.com", "d@example.com", "e@example.com"):
+        assert address not in cleaned
+    assert "Subject: 件名" in cleaned
+
+
+def test_plain_keeps_body_line_right_after_recipient_line() -> None:
+    """宛先行が区切り文字で終わっていなければ、次の行は本文として残す（カンマを含んでいても消さない）"""
+    body = "To: a@example.com\nHi John, thanks for the update.\n"
+    cleaned = strip_email_recipient_lines(body)
+    assert "a@example.com" not in cleaned
+    assert "Hi John, thanks for the update." in cleaned
+
+
+def test_plain_keeps_words_containing_to_or_cc() -> None:
+    body = "Go to: the shared folder\nmailto:a@example.com\nAccount: 123\n"
+    assert strip_email_recipient_lines(body) == body
+
+
+# ---------- HTML ----------
+
+
+def test_html_outlook_japanese_header_with_tags_between_heading_and_colon() -> None:
+    html_text = (
+        '<p class="MsoNormal"><b><span lang="JA">差出人</span><span lang="EN-US">:</span></b>'
+        '<span lang="EN-US"> 佐藤 &lt;sato@example.com&gt;<br></span>'
+        '<b>送信日時<span lang="EN-US">:</span></b><span lang="EN-US"> 2026年10月20日<br>'
+        '<b>宛先<span lang="EN-US">:</span></b><span lang="EN-US"> 山田 &lt;yamada@example.com&gt;<br>'
+        '<b>CC</b><b><span lang="EN-US">:</span></b> 鈴木 &lt;suzuki@example.com&gt;<br>'
+        '<b>件名<span lang="EN-US">:</span></b> 会議の件</span></p>'
+        "<p>明日のアジェンダです。</p>"
+    )
+    cleaned = strip_email_recipient_lines(html_text, is_html=True)
+    assert "yamada@example.com" not in cleaned
+    assert "suzuki@example.com" not in cleaned
+    assert "sato@example.com" in cleaned
+    assert "2026年10月20日" in cleaned
+    assert "会議の件" in cleaned
+    assert "明日のアジェンダです。" in cleaned
+
+
+def test_html_inline_bold_removes_addresses_not_only_heading() -> None:
+    cleaned = strip_email_recipient_lines(
+        "<b>From:</b> a@example.com<br><b>To:</b> b@example.com; c@example.com<br><b>Subject:</b> s<br>本文<br>",
+        is_html=True,
+    )
+    assert "b@example.com" not in cleaned
+    assert "c@example.com" not in cleaned
+    assert "a@example.com" in cleaned
+    assert "<b>Subject:</b> s" in cleaned
+    assert "本文" in cleaned
+
+
+def test_html_paragraph_and_table_row_forms() -> None:
+    assert "x@y.z" not in strip_email_recipient_lines("<p><b>Cc:</b> x@y.z</p><p>本文</p>", is_html=True)
+    table = (
+        "<table>"
+        "<tr><th>差出人:</th><td>alice</td></tr>"
+        "<tr><th>To:</th><td>bob@example.com</td></tr>"
+        "<tr><th>件名:</th><td>subject</td></tr>"
+        "</table>"
+    )
+    cleaned = strip_email_recipient_lines(table, is_html=True)
+    assert "bob@example.com" not in cleaned
+    assert "alice" in cleaned and "subject" in cleaned
+
+
+def test_html_keeps_mailto_links_and_mid_sentence_headings() -> None:
+    html_text = (
+        '<table><tr><td>問い合わせ: <a href="mailto:help@example.com">help@example.com</a></td></tr></table>'
+        "<p>Please go to: the portal</p>"
+    )
+    cleaned = strip_email_recipient_lines(html_text, is_html=True)
+    assert "help@example.com" in cleaned
+    assert "Please go to: the portal" in cleaned
+
+
+def test_html_keeps_tags_balanced() -> None:
+    """消すのは文字だけで、タグは残す（開始タグだけ消えて表示が崩れることがない）"""
+    html_text = '<div><span style="x"><b>To:</b> a@example.com<br></span><b>Subject:</b> s</div>'
+    cleaned = strip_email_recipient_lines(html_text, is_html=True)
+    assert cleaned.count("<span") == cleaned.count("</span>")
+    assert cleaned.count("<div") == cleaned.count("</div>")
+
+
+def test_html_without_recipients_is_fast() -> None:
+    html_text = _tables(3000)
+    started = time.perf_counter()
+    result = strip_email_recipient_lines(html_text, is_html=True)
+    assert time.perf_counter() - started < 1.0
+    assert result == html_text
+
+
+def test_html_with_recipient_at_end_is_fast_and_keeps_earlier_rows() -> None:
+    html_text = _tables(3000) + "<table><tr><th>Cc:</th><td>a@example.com</td></tr><tr><th>件名:</th><td>x</td></tr></table>"
+    started = time.perf_counter()
+    result = strip_email_recipient_lines(html_text, is_html=True)
+    assert time.perf_counter() - started < 1.0
+    assert "本文0 " in result and "本文2999 " in result
+    assert "a@example.com" not in result
+    assert "件名:" in result
+
+
+def test_empty_input() -> None:
+    assert strip_email_recipient_lines("") == ""
+    assert strip_email_recipient_lines("", is_html=True) == ""
diff --git a/backend/tests/test_output_limits.py b/backend/tests/test_output_limits.py
new file mode 100644
index 0000000000000000000000000000000000000000..a927859321c996a4ff4143698c8791a483956318
--- /dev/null
+++ b/backend/tests/test_output_limits.py
@@ -0,0 +1,117 @@
+"""
+AIインプット出力の上限（テキスト20万文字・ファイル4.5MB）に収める部品（app.vector.output_limits）のテスト。
+
+仕様:
+- 上限は 200,000 文字・4,500,000 バイト。
+- split_text_parts: 上限以内ならそのまま 1 パート。超えたら、ノートの境界 → 空行 → 改行 の順で切り、
+  各パートの先頭に「分割ファイル n/m」、末尾に「続きあり」/「ここまで」を書く。注記込みで上限以内。
+  ほぼ空のパートは作らない。本文は欠けない。
+- part_file_name: 分割なしは `{base}_{kind}{ext}`、分割ありは `{base}_{kind}_part{n}of{m}{ext}`。
+- html_text_chars: HTML の文字数から、埋め込み画像（data URL の base64 部分）を除いて数える。
+- verify_saved_files: 書き出したファイルを読み直し、文字数・容量・画像として読めるかを確かめる。
+"""
+
+from __future__ import annotations
+
+import io
+from pathlib import Path
+
+import pytest
+from PIL import Image
+
+from app.vector.output_limits import (
+    MAX_IMAGE_BYTES,
+    MAX_TEXT_CHARS,
+    html_text_chars,
+    part_file_name,
+    split_text_parts,
+    verify_saved_files,
+)
+
+
+def test_limits_match_company_ai() -> None:
+    assert MAX_TEXT_CHARS == 200_000
+    assert MAX_IMAGE_BYTES == 4_500_000
+
+
+def test_text_within_limit_is_returned_as_is() -> None:
+    assert split_text_parts("短い本文", limit=5_000) == ["短い本文"]
+
+
+def test_split_parts_fit_limit_and_keep_all_content() -> None:
+    notes = [f"# ===== [ファイル {i}/30] note{i}.md =====\n" + ("本文の行です。\n" * 60) for i in range(1, 31)]
+    text = "\n\n".join(notes)
+    parts = split_text_parts(text, limit=5_000)
+
+    assert len(parts) > 1
+    assert all(len(part) <= 5_000 for part in parts)
+    total = len(parts)
+    for index, part in enumerate(parts, start=1):
+        assert part.startswith(f"【分割ファイル {index}/{total}】")
+        if index < total:
+            assert f"続きは {index + 1}/{total} 番目" in part
+        else:
+            assert "ここまで" in part
+    for i in range(1, 31):
+        assert sum(part.count(f"note{i}.md") for part in parts) == 1, "各ノートの見出しはちょうど 1 回現れる"
+    assert sum(part.count("本文の行です。") for part in parts) == 30 * 60, "本文は欠けない"
+
+
+def test_split_prefers_note_boundaries() -> None:
+    notes = [f"# ===== [ファイル {i}/10] n{i}.md =====\n" + ("あ" * 40 + "\n") * 20 for i in range(1, 11)]
+    parts = split_text_parts("\n\n".join(notes), limit=3_000)
+    for part in parts:
+        body = part.split("\n\n", 1)[1]
+        assert body.startswith("# ===== [ファイル"), "各パートの本文はノートの見出しから始まる"
+
+
+def test_split_does_not_make_nearly_empty_parts() -> None:
+    text = "# ===== [ファイル 1/2] a.md =====\n短い\n\n" + "# ===== [ファイル 2/2] b.md =====\n" + ("長い行\n" * 2_000)
+    parts = split_text_parts(text, limit=3_000)
+    assert all(len(part) > 3_000 * 0.25 for part in parts[:-1])
+
+
+def test_split_rejects_too_small_limit() -> None:
+    with pytest.raises(ValueError):
+        split_text_parts("x" * 5_000, limit=1_200)
+
+
+def test_part_file_name() -> None:
+    assert part_file_name("AI", "context", 1, 1, ".md") == "AI_context.md"
+    assert part_file_name("AI", "context", 2, 3, ".md") == "AI_context_part2of3.md"
+
+
+def test_html_text_chars_excludes_embedded_image_data() -> None:
+    payload = "A" * 50_000
+    html = f'<p>本文</p><img src="data:image/png;base64,{payload}" /><img src="data:image/svg+xml;base64,{payload}">'
+    without = '<p>本文</p><img src="data:image/png;base64," /><img src="data:image/svg+xml;base64,">'
+    assert html_text_chars(html) == len(without)
+
+
+def _png_bytes(size: tuple[int, int] = (10, 10)) -> bytes:
+    buf = io.BytesIO()
+    Image.new("RGB", size, (200, 10, 10)).save(buf, format="PNG")
+    return buf.getvalue()
+
+
+def test_verify_saved_files_reports_problems(tmp_path: Path) -> None:
+    ok_text = tmp_path / "ok.md"
+    ok_text.write_text("短い", encoding="utf-8")
+    long_text = tmp_path / "long.md"
+    long_text.write_text("あ" * (MAX_TEXT_CHARS + 1), encoding="utf-8")
+    ok_image = tmp_path / "ok.png"
+    ok_image.write_bytes(_png_bytes())
+    broken_image = tmp_path / "broken.png"
+    broken_image.write_bytes(b"not an image")
+
+    problems = verify_saved_files([ok_text, long_text], [ok_image, broken_image])
+
+    assert len(problems) == 2
+    assert "long.md" in problems[0] and "200,000" in problems[0]
+    assert "broken.png" in problems[1]
+
+
+def test_verify_saved_html_counts_text_without_image_data(tmp_path: Path) -> None:
+    html_file = tmp_path / "a.html"
+    html_file.write_text(f'<p>本文</p><img src="data:image/png;base64,{"A" * (MAX_TEXT_CHARS + 10)}">', encoding="utf-8")
+    assert verify_saved_files([html_file], []) == []
diff --git a/docs/ai_context_export_spec.md b/docs/ai_context_export_spec.md
index 590bc38f70ca1fa3b2b3dee41d3e4729ea17a2ad..cf0613291963606acdfda1c50d1191f1e13438f1 100644
--- a/docs/ai_context_export_spec.md
+++ b/docs/ai_context_export_spec.md
@@ -113,6 +113,8 @@
   （35 KB で約 30 秒）。
 - 対応: Cc 見出しが 1 つも無い本文では除去用の正規表現を走らせない。表の Cc 行の除去は 1 つの `<tr>` の中だけに限る
   （以前は手前の行まで巻き込んで消すことがあった）。
+- その後、宛先（To・CC・BCC）の除去は `strip_email_recipient_lines` に置き換えた。HTML を行区切りで 1 回分割し、行ごとの先頭一致だけで
+  判定するので、本文の長さに対して線形の時間で終わる（`ai_context_token_optimization_spec.md` の 2.2）。
 - MSG 解析は、オープン・プロパティ取得・HTML 本文取得とデコード・HTML→テキスト変換・添付取得を段階別に計測する（`export_timing.log`）。
 
 ## 処理できないリンクを飛ばして出力を優先する（AI用HTML）
@@ -139,6 +141,29 @@
   0 件なら出さない。HTML 本体には載せない（AI へのトークンを増やさない）。
 - スコープの外（Markdown+画像の書き出し、`/api/export/resolve-links`）では従来どおり、制限時間なしでその場で処理する。
 
+## 社内AIの上限に収める（AI用HTML: 20 万文字・4.5MB）
+
+- 上限: 1 ファイルあたり **20 万文字**・**4.5MB（4,500,000 バイト）**（`app/vector/output_limits.py`）。
+  文字数は **埋め込み画像（data URL の base64 部分）を除いて** 数える（`html_text_chars`）。容量はファイル全体の UTF-8 バイト数。
+- `html_exporter` はノート 1 件・メール 1 通を「節」として作り、`app/vector/html_size_fitting.py` が振り分ける:
+  1. 全体が上限以内なら 1 ファイル。
+  2. 文字数は上限以内で、容量が **6MB 以下**なら、埋め込み画像（3 万文字以上の PNG / JPEG / WebP / GIF / BMP と、ラスタライズできる SVG）を
+     白背景の JPEG にして段階的に縮小（品質 85 → 35、縮小率 1.0 → 0.25）し、1 ファイルに収める。元より大きくなる画像は元のまま。
+  3. それ以外は、節の境目で順序を保って複数ファイルに分割する。1 節だけで容量の予算を超えるものは先に画像を縮小してから詰め、
+     組み上がって容量を超えたファイルも画像を縮小する。
+  - 1 ノートだけで文字数の予算を超えるときは、本文を見出し → 空行 → 改行で区切り、「(続き k/K)」の記事に分けてから振り分ける
+    （元データ欄は本文の後ろに分けて続ける）。
+- 分割した各ファイル: 先頭に「【分割ファイル n/m】…」、そのファイルに含むノートの目次（APPENDIX のメールも）、末尾に続きの有無。
+  AI への指示（prompt）は 1 番目のファイルにだけ載せる。タイトルに `(n/m)` を付ける。
+- 組み上がった各ファイルを確かめ、超えていれば上限を厳しくして最大 3 回まで振り分け直す。収めきれなければ `limit_problems` に書く。
+- 応答（`POST /api/export/ai-html`）: `html_parts`（番号・全体数・文字数・容量・HTML）、`total_chars`（分割前の文字数）、
+  `char_limit`、`size_limit_bytes`、`limit_problems`。`html_content` は 1 番目のファイル（分割しなければ全体）。
+- 保存（`POST /api/export/ai-html/save-parts`）: 1 つなら `{名前}.html`、複数なら `{名前}_part{n}of{m}.html`。
+  どれかが既にあれば全ファイルに ` (1)` などを付け、既存のファイルを上書きしない。保存後に読み直して上限を確かめる。
+- 画面（プレビューのモーダルと生成結果）: 「合計 12.35万文字（123,456 / 上限200,000）」と表示中のファイルの容量（MB / 上限 4.50MB）を出す。
+  分割されたときは「上限を超えるため全 N ファイルに分割して出力します」とパートのタブ（文字数・容量つき）を出し、タブで表示を切り替える。
+  コードコピーは表示中のパート、HTML DL と HTML 保存は全パートが対象（保存したパスは改行区切りでコピー）。1 ファイルなら従来どおり。
+
 ## 書き出し対象の拡張子（変換対象）
 
 - `app/vector/export_document_reader.py` が対象文書の本文を読む。HTML 書き出しと Markdown+画像の書き出しで共通。
diff --git a/docs/ai_context_token_optimization_spec.md b/docs/ai_context_token_optimization_spec.md
index e749c899bd7cd53846efad74a5dfaae69896d3d2..503d810fb625b6859913357e1d56d4cce7aea45d 100644
--- a/docs/ai_context_token_optimization_spec.md
