+    # 最終フォールバック: さらに縮小・品質を下げて上限に収める
+    data = b""
+    for scale, quality in ((0.45, 65), (0.35, 50), (0.25, 35)):
+        buf = io.BytesIO()
+        render_combined_canvas(scale).save(buf, format="JPEG", quality=quality, optimize=True)
+        data = buf.getvalue()
+        if len(data) <= max_bytes:
+            break
+    return data
+
+
+@dataclass(frozen=True)
+class ImagePart:
+    """結合画像 1 枚分。figures は収録した図番号の範囲（最初, 最後）。"""
+
+    data: bytes
+    figures: Tuple[int, int]
+
+
+def _split_index(group: List[Dict[str, Any]]) -> int:
+    """高さの累計が半分を超える位置で 2 分割する（両側が空にならないよう 1〜len-1 に収める）。"""
+    half = sum(item["image"].height for item in group) / 2
+    total = 0
+    for position, item in enumerate(group, start=1):
+        total += item["image"].height
+        if total >= half:
+            return min(max(position, 1), len(group) - 1)
+    return len(group) - 1
+
+
+def build_image_parts(
+    images_data: List[Dict[str, Any]],
+    target_width: Optional[int] = None,
+    max_bytes: int = MAX_IMAGE_BYTES,
+    split_threshold: int = IMAGE_SPLIT_THRESHOLD_BYTES,
+) -> List[ImagePart]:
+    """
+    図を縦連結した画像を、各 max_bytes 以下の 1 枚以上に仕上げる。
+    連結した無圧縮PNGが max_bytes 以下ならそのまま、split_threshold 以下なら縮小・JPEG化で圧縮して 1 枚、
+    それを超えるなら図の境界で 2 分割して各々に同じ規則を適用する。1 枚の図は分割できないため、その図だけを圧縮する。
+    連結 PNG の容量は図ごとの PNG の容量の合計で見積もり、実際の連結画像は振り分けが決まった枚ごとに作る。
+    """
+    if not images_data:
+        return []
+    unlimited = 1 << 60
+
+    # 連結した PNG の容量は、図ごとの PNG の容量の合計で見積もる（分割のたびに全体を PNG にすると非常に遅い）。
+    # 図は連結時と同じく基準幅を超えるものだけ縮小して測る。実際の連結画像は最後に 1 度だけ作り、容量を確かめる。
+    if target_width and target_width > 0:
+        width_cap = target_width
+    else:
+        width_cap = max(2800, min(3200, max((item["image"].width for item in images_data), default=2800)))
+    estimated: Dict[int, int] = {}
+
+    def estimate(group: List[Dict[str, Any]]) -> int:
+        total = 0
+        for item in group:
+            key = id(item)
+            if key not in estimated:
+                image = item["image"]
+                if image.width > width_cap and image.width > 0 and image.height > 0:
+                    image = image.resize((width_cap, max(1, int(image.height * width_cap / image.width))), Image.Resampling.BILINEAR)
+                buf = io.BytesIO()
+                flatten_to_rgb(image).save(buf, format="PNG")
+                estimated[key] = len(buf.getvalue())
+            total += estimated[key]
+        return total
+
+    def fit(group: List[Dict[str, Any]]) -> List[ImagePart]:
+        figures = (group[0]["index"], group[-1]["index"])
+        size = estimate(group)
+        if size <= max_bytes:
+            png = build_image_strip(group, target_width, max_bytes=unlimited) or b""
+            if len(png) <= max_bytes:
+                return [ImagePart(png, figures)]
+        if size > split_threshold and len(group) > 1:
+            cut = _split_index(group)
+            return fit(group[:cut]) + fit(group[cut:])
+        compressed = build_image_strip(group, target_width, max_bytes=max_bytes) or b""
+        if len(compressed) <= max_bytes or len(group) == 1:
+            return [ImagePart(compressed, figures)]
+        cut = _split_index(group)
+        return fit(group[:cut]) + fit(group[cut:])
+
+    return fit(images_data)
 
 
