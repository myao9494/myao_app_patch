index 0000000000000000000000000000000000000000..4a4b630efde62ad5bf411bd98e54f8ee04ccd19f
--- /dev/null
+++ b/backend/app/vector/output_limits.py
@@ -0,0 +1,211 @@
+"""
+AIインプット出力の上限（テキスト 20 万文字・ファイル 4.5MB）に収めるための分割・命名・検証。
+
+仕様（社内AIの添付制限に合わせる。spoon_feeder2 の output_limits と同じ規則）:
+1. テキストは MAX_TEXT_CHARS 文字以内、ファイル（画像・HTML）は MAX_IMAGE_BYTES バイト以内に収める。
+2. テキストが上限を超えるときは、ノートの境界（なければ空行・改行）で分割し、各パートの先頭と末尾に
+   「何番目/全何個か」「続きがあるか」を書く。上限以内なら本文をそのまま返す。
+   予算の 1/4 未満しか使えない切り位置は、ほぼ空のパートになるため採らない。
+3. HTML の文字数は、埋め込み画像（data URL の base64 部分）を除いて数える（html_text_chars）。
+   画像は容量（バイト）で別に制限する。
+4. 保存後はディスクから読み直して上限を確かめる（verify_saved_files）。NG なら呼び出し側が条件を厳しくして
+   最大 MAX_ATTEMPTS 回までやり直す。
+5. 画像の分割・圧縮は結合画像（markdown_image_exporter.build_image_parts）と HTML（html_size_fitting）が行う。
+"""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+from typing import Any, Dict, List
+
+from PIL import Image
+
+MAX_TEXT_CHARS = 200_000
+MAX_IMAGE_BYTES = 4_500_000
+# 連結した無圧縮の画像（または HTML 全体）がこのサイズ以下なら、圧縮して 1 つに収める。超えたら分割する。
+IMAGE_SPLIT_THRESHOLD_BYTES = 6_000_000
+MAX_ATTEMPTS = 3
+# 分割ファイルの先頭・末尾の注記に使う文字数の見込み（本文の予算から差し引く）
+PART_MARKER_RESERVE = 800
+# やり直しのたびに文字数上限を下げる量
+RETRY_TEXT_STEP = 10_000
+# やり直しのたびに容量上限へ掛ける係数
+RETRY_IMAGE_FACTOR = 0.9
+
+_MIN_FILL_RATIO = 0.25
+# Markdown+画像の書き出しで、ノート・メール付録の区切りとみなす行
+_FILE_BOUNDARY = re.compile(r"(?m)^# ===== \[ファイル|^# ✉️ 付録|^### ✉️ \[メール")
+# 埋め込み画像の base64 部分（data:...;base64, の後ろ）
+_DATA_URL_PAYLOAD = re.compile(r"(data:[\w.+/-]+;base64,)[A-Za-z0-9+/=]+")
+
+
+def text_limit_for_attempt(attempt: int, limit: int = MAX_TEXT_CHARS) -> int:
+    """やり直し回数（0 始まり）に応じた文字数上限。回を重ねるほど余裕を持たせる。"""
+    return limit - RETRY_TEXT_STEP * attempt
+
+
+def image_limit_for_attempt(attempt: int, limit: int = MAX_IMAGE_BYTES) -> int:
+    """やり直し回数（0 始まり）に応じた容量上限。"""
+    return int(limit * (RETRY_IMAGE_FACTOR ** attempt))
+
+
+def html_text_chars(html: str) -> int:
+    """HTML の文字数。埋め込み画像の base64 部分は数えない。"""
+    removed = sum(len(match.group(0)) - len(match.group(1)) for match in _DATA_URL_PAYLOAD.finditer(html))
+    return len(html) - removed
+
+
+def find_cut(text: str, start: int, budget: int, boundary: "re.Pattern[str]" = _FILE_BOUNDARY) -> int:
+    """
+    text[start:] の先頭から budget 文字以内で、分割に最適な終端位置を返す。
+    境界 → 空行 → 改行 の順に優先するが、予算の 1/4 未満しか使えない候補は採らない
+    （どれも満たさなければ最も後ろの改行、なければ予算いっぱいで切る）。
+    """
+    end = start + budget
+    if end >= len(text):
+        return len(text)
+    last_boundary = None
+    for match in boundary.finditer(text, start + 1, end):
+        last_boundary = match.start()
+    blank = text.rfind("\n\n", start + 1, end)
+    newline = text.rfind("\n", start + 1, end)
+    candidates = [
+        last_boundary,
+        blank + 2 if blank != -1 else None,
+        newline + 1 if newline != -1 else None,
+    ]
+    for cut in candidates:
+        if cut is not None and cut - start >= budget * _MIN_FILL_RATIO:
+            return cut
+    return newline + 1 if newline != -1 else end
+
+
+def split_text_chunks(text: str, budget: int, boundary: "re.Pattern[str]" = _FILE_BOUNDARY) -> List[str]:
+    """text を budget 文字以内の塊に、境界・空行・改行で切り分ける（注記は付けない）。"""
+    if budget < 1:
+        raise ValueError(f"分割の予算が小さすぎます: {budget}")
+    chunks: List[str] = []
+    start = 0
+    while start < len(text):
+        cut = find_cut(text, start, budget, boundary)
+        chunks.append(text[start:cut])
+        start = cut
+    return chunks
+
+
+def part_header(index: int, total: int) -> str:
+    """分割ファイルの先頭に書く注記。"""
+    lines = [
+        f"【分割ファイル {index}/{total}】このファイルは全{total}個に分割された内容の{index}番目です。"
+        f"全{total}個を順番にすべて読み込んでから回答してください。"
+    ]
+    if index > 1:
+        lines.append("指示文などの前提は1番目のファイルに記載されています。")
+    return "\n".join(lines)
+
+
+def part_footer(index: int, total: int) -> str:
+    """分割ファイルの末尾に書く注記。"""
+    if index < total:
+        return (
+            f"【続きあり】このファイルは途中までです。続きは {index + 1}/{total} 番目のファイルにあります。"
+            "（ファイルの途中で切れている場合は、次のファイルの先頭からそのまま続きます）"
+        )
+    return f"【分割ファイルはここまでです】{index}/{total} 番目が最後のファイルです。"
+
+
+def split_text_parts(text: str, limit: int = MAX_TEXT_CHARS) -> List[str]:
+    """text を limit 文字以内（注記込み）のパートへ分割する。収まる場合は [text] をそのまま返す。"""
+    if len(text) <= limit:
+        return [text]
+    budget = limit - PART_MARKER_RESERVE
+    if budget < 1000:
+        raise ValueError(f"分割の上限が小さすぎます: {limit}")
+    bodies = split_text_chunks(text, budget)
+    total = len(bodies)
+    return [
+        f"{part_header(index, total)}\n\n{body.strip(chr(10))}\n\n{part_footer(index, total)}\n"
+        for index, body in enumerate(bodies, start=1)
+    ]
+
+
+def part_file_name(base: str, kind: str, index: int, total: int, extension: str) -> str:
+    """出力ファイル名。分割なしは `{base}_{kind}{ext}`、分割ありは `{base}_{kind}_part{n}of{m}{ext}`。"""
+    if total <= 1:
+        return f"{base}_{kind}{extension}"
+    return f"{base}_{kind}_part{index}of{total}{extension}"
+
+
+def image_extension(data: bytes) -> str:
+    """画像バイト列の拡張子（PNG でなければ JPEG）。"""
+    return ".png" if data.startswith(b"\x89PNG\r\n\x1a\n") else ".jpg"
+
+
+def write_text_files(folder: Path, base: str, kind: str, extension: str, parts: List[str]) -> List[Path]:
+    """テキストパートを UTF-8・LF で書き出す（文字数を OS 間で一致させるため改行は変換しない）。"""
+    paths = []
+    for index, part in enumerate(parts, start=1):
+        path = folder / part_file_name(base, kind, index, len(parts), extension)
+        with path.open("w", encoding="utf-8", newline="\n") as handle:
+            handle.write(part)
+        paths.append(path)
+    return paths
+
+
+def write_image_files(folder: Path, base: str, kind: str, parts: List[bytes]) -> List[Path]:
+    """画像パートを書き出す。"""
+    paths = []
+    for index, data in enumerate(parts, start=1):
+        path = folder / part_file_name(base, kind, index, len(parts), image_extension(data))
+        path.write_bytes(data)
+        paths.append(path)
+    return paths
+
+
+def verify_saved_files(
+    text_paths: List[Path],
+    image_paths: List[Path],
+    max_chars: int = MAX_TEXT_CHARS,
+    max_bytes: int = MAX_IMAGE_BYTES,
+) -> List[str]:
+    """
+    書き出した実ファイルを読み直して上限を確かめ、問題点の一覧を返す（空なら合格）。
+    テキストは文字数（HTML は埋め込み画像を除く）と容量、画像は容量と画像として読めるかを確かめる。
+    """
+    problems: List[str] = []
+    for path in text_paths:
+        try:
+            raw = path.read_bytes()
+            text = raw.decode("utf-8")
+        except (OSError, UnicodeDecodeError) as exc:
+            problems.append(f"{path.name} を読み直せません: {exc}")
+            continue
+        chars = html_text_chars(text) if path.suffix.lower() == ".html" else len(text)
+        if chars > max_chars:
+            problems.append(f"{path.name} が {chars:,} 文字で上限 {max_chars:,} 文字を超えています")
+        if len(raw) > max_bytes:
+            problems.append(f"{path.name} が {len(raw):,} バイトで上限 {max_bytes:,} バイトを超えています")
+    for path in image_paths:
+        try:
+            size = path.stat().st_size
+            with Image.open(path) as image:
+                image.verify()
+        except (OSError, SyntaxError) as exc:
+            problems.append(f"{path.name} を画像として読み直せません: {exc}")
+            continue
+        if size > max_bytes:
+            problems.append(f"{path.name} が {size:,} バイトで上限 {max_bytes:,} バイトを超えています")
+    return problems
+
+
+def text_parts_summary(parts: List[str]) -> List[Dict[str, Any]]:
+    """API 応答用: 各パートの番号・全体数・文字数。"""
+    return [{"index": index, "total": len(parts), "chars": len(part)} for index, part in enumerate(parts, start=1)]
+
+
+def attachment_warning(file_count: int) -> str:
+    """チャットの添付上限（5 ファイル）を超えるときの注意文。超えなければ空文字。"""
+    if file_count <= 5:
+        return ""
+    return f"出力が{file_count}ファイルになりました。チャットの添付上限(5ファイル)を超えるため、複数回に分けて添付してください。"
diff --git a/backend/tests/test_ai_bundle_output_limits.py b/backend/tests/test_ai_bundle_output_limits.py
new file mode 100644
index 0000000000000000000000000000000000000000..81e3efd4a3c988ae541b0103f47542442a21cfc5
--- /dev/null
+++ b/backend/tests/test_ai_bundle_output_limits.py
@@ -0,0 +1,136 @@
+"""
+「2 ファイルを保存」（統合マークダウン＋結合画像）を社内AIの上限（20万文字・4.5MB）に収めるテスト。
+
+仕様:
+- 結合画像: 連結した無圧縮 PNG が上限以下ならそのまま 1 枚、分割しきい値（6MB）以下なら縮小・JPEG 化で 1 枚、
+  それを超えるなら図の境界で分割し、各枚を上限以下にする（build_image_parts）。各枚は収録した図番号の範囲を持つ。
+- 結合画像が複数枚のときは、統合マークダウンの冒頭に枚数と「結合画像 n/m: 【図a】〜【図b】」の対応を書く。
+- 保存（POST /api/export/ai-bundle/save）: マークダウンが 20 万文字を超えたら `_context_part{n}of{m}.md` に分割し、
+  画像が複数枚なら `_images_part{n}of{m}` で保存する。保存後に読み直して上限を確かめ、結果を返す。
+- 応答には、各パートの文字数（text_parts）・画像の容量（image_sizes）・保存したファイル名の一覧を含める。
+"""
+
+from __future__ import annotations
+
+import io
+import random
+from pathlib import Path
+
+from fastapi.testclient import TestClient
+from PIL import Image
+
+from app.vector.markdown_image_exporter import build_image_parts, export_documents_to_markdown_and_image
+from app.vector.output_limits import MAX_TEXT_CHARS
+
+
+def _noise_image(width: int, height: int, seed: int) -> Image.Image:
+    """圧縮の効きにくい画像（容量の大きい PNG になる）。"""
+    rng = random.Random(seed)
+    return Image.frombytes("RGB", (width, height), bytes(rng.getrandbits(8) for _ in range(width * height * 3)))
+
+
+def _figures(count: int, size: int = 300) -> list[dict]:
+    return [
+        {"index": i, "note_name": f"n{i}.md", "link_text": f"![[img{i}.png]]", "image": _noise_image(size, size, i)}
+        for i in range(1, count + 1)
+    ]
+
+
+def test_small_images_stay_in_one_png() -> None:
+    images = [
+        {"index": i, "note_name": "n.md", "link_text": f"![[{i}.png]]", "image": Image.new("RGB", (50, 50), (255, 0, 0))}
+        for i in (1, 2)
+    ]
+    parts = build_image_parts(images)
+    assert len(parts) == 1
+    assert parts[0].figures == (1, 2)
+    assert parts[0].data.startswith(b"\x89PNG")
+
+
+def test_images_over_threshold_are_split_and_each_part_fits() -> None:
+    images = _figures(4)
+    parts = build_image_parts(images, target_width=320, max_bytes=300_000, split_threshold=400_000)
+
+    assert len(parts) > 1
+    assert all(len(part.data) <= 300_000 for part in parts)
+    ranges = [part.figures for part in parts]
+    assert ranges[0][0] == 1 and ranges[-1][1] == 4
+    for (_, prev_end), (next_start, _) in zip(ranges, ranges[1:]):
+        assert next_start == prev_end + 1, "図番号の範囲は欠けも重なりもなく続く"
+
+
+def test_images_between_limit_and_threshold_are_compressed_into_one() -> None:
+    images = _figures(2)
+    parts = build_image_parts(images, target_width=320, max_bytes=300_000, split_threshold=10_000_000)
+    assert len(parts) == 1
+    assert len(parts[0].data) <= 300_000
+    assert Image.open(io.BytesIO(parts[0].data)).format == "JPEG"
+
+
+def test_markdown_lists_image_parts_when_split(tmp_path: Path) -> None:
+    lines = []
+    for i in range(1, 5):
+        _noise_image(300, 300, i).save(tmp_path / f"img{i}.png")
+        lines.append(f"![[img{i}.png]]")
+    note = tmp_path / "note.md"
+    note.write_text("# 図だらけ\n" + "\n".join(lines) + "\n", encoding="utf-8")
+
+    md, parts, stats = export_documents_to_markdown_and_image(
+        file_paths=[str(note)], vault_path=str(tmp_path), image_max_bytes=300_000, image_split_threshold=400_000
+    )
+
+    assert len(parts) > 1
+    assert f"結合画像は容量制限のため全{len(parts)}枚に分割されています" in md
+    assert f"結合画像 1/{len(parts)}: 【図1】" in md
+    assert stats["image_part_count"] == len(parts)
+    assert stats["image_sizes"] == [len(part.data) for part in parts]
+
+
+def test_save_splits_long_markdown_and_reports_parts(tmp_path: Path, monkeypatch) -> None:
+    from app.config import settings
+    from app.main import app
+
+    monkeypatch.setattr(settings, "data_dir", tmp_path / "data")
+    out = tmp_path / "out"
+    notes = []
+    for i in range(3):
+        note = tmp_path / f"long{i}.md"
+        note.write_text(f"# 長いノート{i}\n" + ("長い本文の行です。\n" * 10_000), encoding="utf-8")
+        notes.append(str(note))
+
+    resp = TestClient(app).post(
+        "/api/export/ai-bundle/save",
+        json={"file_paths": notes, "file_base_name": "AI", "target_dir": str(out)},
+    )
+
+    assert resp.status_code == 200
+    data = resp.json()
+    total = len(data["text_parts"])
+    assert total > 1
+    assert data["markdown_names"] == [f"AI_context_part{n}of{total}.md" for n in range(1, total + 1)]
+    for name, part in zip(data["markdown_names"], data["text_parts"]):
+        saved = (out / name).read_text(encoding="utf-8")
+        assert len(saved) == part["chars"] <= MAX_TEXT_CHARS
+    assert data["problems"] == []
+    assert data["markdown_name"] == data["markdown_names"][0], "従来の項目（先頭のファイル）も返す"
+
+
+def test_save_keeps_single_names_when_within_limits(tmp_path: Path, monkeypatch) -> None:
+    from app.config import settings
+    from app.main import app
+
+    monkeypatch.setattr(settings, "data_dir", tmp_path / "data")
+    Image.new("RGB", (40, 40), (0, 0, 255)).save(tmp_path / "a.png")
+    note = tmp_path / "short.md"
+    note.write_text("# 短い\n![[a.png]]\n", encoding="utf-8")
+    out = tmp_path / "out"
+
+    data = TestClient(app).post(
+        "/api/export/ai-bundle/save",
+        json={"file_paths": [str(note)], "vault_path": str(tmp_path), "file_base_name": "AI", "target_dir": str(out)},
+    ).json()
+
+    assert data["markdown_names"] == ["AI_context.md"]
+    assert data["image_names"] == ["AI_images.png"]
+    assert len(data["text_parts"]) == 1 and data["text_parts"][0]["chars"] > 0
+    assert data["has_images"] is True and data["image_name"] == "AI_images.png"
diff --git a/backend/tests/test_ai_email_recipients_option.py b/backend/tests/test_ai_email_recipients_option.py
new file mode 100644
index 0000000000000000000000000000000000000000..a72b56346c42b4eba7e152033665992049224347
--- /dev/null
+++ b/backend/tests/test_ai_email_recipients_option.py
@@ -0,0 +1,126 @@
+"""
+AIインプット書き出しで、リンクされたメールの宛先（To・Cc・Bcc）を含めるかを切り替える include_email_recipients のテスト。
+
+仕様:
+- 既定（False）は宛先を含めない。メールの見出し枠に「宛先」を出さず、本文の引用・転送ヘッダーからも To / Cc / Bcc の行を除く。
+- True のときは見出し枠に宛先を出し、本文の宛先行も残す。
+- トークン最適化（optimize_tokens）とは独立に切り替わる。
+- HTML（export_documents_to_html）と Markdown＋画像（export_documents_to_markdown_and_image）の両方に効く。
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from fastapi.testclient import TestClient
+
+from app.main import app
+from app.vector.html_exporter import export_documents_to_html
+from app.vector.markdown_image_exporter import export_documents_to_markdown_and_image
+
+_EML = """Subject: 進捗報告
+From: leader@example.com
+To: member@example.com
+Cc: boss@example.com
+Date: Wed, 24 Sep 2026 10:00:00 +0900
+Content-Type: text/plain; charset=utf-8
+
+本日の報告です。
+
+-----Original Message-----
+From: client@example.com
+To: quoted_to@example.com
+Cc: quoted_cc@example.com
+Subject: 依頼
+元の依頼本文です。
+"""
+
+
+def _note_with_mail(tmp_path: Path) -> Path:
+    (tmp_path / "report.eml").write_text(_EML, encoding="utf-8")
+    note = tmp_path / "note.md"
+    note.write_text("# メモ\n\n参照: [[report.eml]]\n", encoding="utf-8")
+    return note
+
+
+def test_html_excludes_recipients_by_default(tmp_path: Path) -> None:
+    note = _note_with_mail(tmp_path)
+    html_content, _ = export_documents_to_html(file_paths=[str(note)], include_linked_emails=True)
+
+    assert "<dt>宛先:</dt>" not in html_content
+    for address in ("member@example.com", "quoted_to@example.com", "quoted_cc@example.com"):
+        assert address not in html_content
+    assert "leader@example.com" in html_content
+    assert "client@example.com" in html_content
+    assert "元の依頼本文です。" in html_content
+
+
+def test_html_includes_recipients_when_enabled_even_with_token_optimization(tmp_path: Path) -> None:
+    note = _note_with_mail(tmp_path)
+    html_content, _ = export_documents_to_html(
+        file_paths=[str(note)],
+        include_linked_emails=True,
+        optimize_tokens=True,
+        include_email_recipients=True,
+    )
+
+    assert "<dt>宛先:</dt><dd>member@example.com</dd>" in html_content
+    assert "quoted_to@example.com" in html_content
+    assert "quoted_cc@example.com" in html_content
+
+
+def test_html_excludes_recipients_without_token_optimization(tmp_path: Path) -> None:
+    note = _note_with_mail(tmp_path)
+    html_content, _ = export_documents_to_html(
+        file_paths=[str(note)],
+        include_linked_emails=True,
+        optimize_tokens=False,
+        include_email_recipients=False,
+    )
+
+    assert "quoted_to@example.com" not in html_content
+    assert "quoted_cc@example.com" not in html_content
+
+
+def test_markdown_excludes_recipients_by_default(tmp_path: Path) -> None:
+    note = _note_with_mail(tmp_path)
+    md_content, _, _ = export_documents_to_markdown_and_image(file_paths=[str(note)], vault_path=str(tmp_path))
+
+    for address in ("member@example.com", "quoted_to@example.com", "quoted_cc@example.com"):
+        assert address not in md_content
+    assert "宛先およびCCは除外" in md_content
+    assert "元の依頼本文です。" in md_content
+
+
+def test_markdown_includes_recipients_when_enabled(tmp_path: Path) -> None:
+    note = _note_with_mail(tmp_path)
+    md_content, _, _ = export_documents_to_markdown_and_image(
+        file_paths=[str(note)],
+        vault_path=str(tmp_path),
+        include_email_recipients=True,
+    )
+
+    assert "- **宛先**: member@example.com" in md_content
+    assert "quoted_to@example.com" in md_content
+    assert "quoted_cc@example.com" in md_content
+    assert "宛先およびCCは除外" not in md_content
+
+
+def test_api_passes_include_email_recipients(tmp_path: Path) -> None:
+    note = _note_with_mail(tmp_path)
+    client = TestClient(app)
+
+    default = client.post("/api/export/ai-html", json={"file_paths": [str(note)]})
+    assert default.status_code == 200
+    assert "member@example.com" not in default.json()["html_content"]
+
+    included = client.post("/api/export/ai-html", json={"file_paths": [str(note)], "include_email_recipients": True})
+    assert included.status_code == 200
+    assert "member@example.com" in included.json()["html_content"]
+
+    bundle = client.post(
+        "/api/export/ai-bundle/generate",
+        json={"file_paths": [str(note)], "vault_path": str(tmp_path), "include_email_recipients": True},
+    )
+    assert bundle.status_code == 200
+    assert "member@example.com" in bundle.json()["markdown_content"]
