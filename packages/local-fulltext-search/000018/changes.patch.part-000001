@@ -381,3 +429,58 @@ def save_ai_html_endpoint(req: SaveAiHtmlRequest) -> Dict[str, Any]:
         "file_name": target_file.name,
         "size_bytes": target_file.stat().st_size,
     }
+
+
+def _html_save_dir(target_dir: Optional[str]) -> Path:
+    """HTML の保存先。指定が無ければダウンロードフォルダ（無ければ作業フォルダ）。"""
+    if target_dir and target_dir.strip():
+        save_dir = Path(target_dir.strip()).expanduser().resolve()
+    else:
+        downloads_dir = Path.home() / "Downloads"
+        save_dir = downloads_dir if downloads_dir.is_dir() else Path.cwd()
+    save_dir.mkdir(parents=True, exist_ok=True)
+    return save_dir
+
+
+@router.post("/ai-html/save-parts")
+def save_ai_html_parts_endpoint(req: SaveAiHtmlPartsRequest) -> Dict[str, Any]:
+    """
+    上限に合わせて分割した HTML（1 つ以上）をまとめて保存し、絶対パスの一覧を返す。
+    1 つなら `{名前}.html`、複数なら `{名前}_part{n}of{m}.html`。どれかが既にあれば、全ファイルの名前に
+    ` (1)`・` (2)` … を付けて、既存のファイルを上書きしない。保存後に読み直して上限を確かめる。
+    """
+    parts = [part for part in req.html_parts if part and part.strip()]
+    if not parts:
+        raise HTTPException(status_code=400, detail="HTMLコンテンツが空です")
+    save_dir = _html_save_dir(req.target_dir)
+
+    raw_name = re.sub(r'[\/:*?"<>|]', "_", (req.file_name or "ai_context_document.html").strip())
+    stem = Path(raw_name).stem if raw_name.lower().endswith(".html") else raw_name
+    total = len(parts)
+
+    def names_for(base: str) -> List[str]:
+        if total == 1:
+            return [f"{base}.html"]
+        return [f"{base}_part{index}of{total}.html" for index in range(1, total + 1)]
+
+    names = names_for(stem)
+    counter = 1
+    while any((save_dir / name).exists() for name in names):
+        names = names_for(f"{stem} ({counter})")
+        counter += 1
+
+    paths: List[Path] = []
+    for name, part in zip(names, parts):
+        path = save_dir / name
+        with path.open("w", encoding="utf-8", newline="\n") as handle:
+            handle.write(part)
+        paths.append(path)
+
+    return {
+        "success": True,
+        "saved_paths": [str(path.resolve()) for path in paths],
+        "file_names": names,
+        "sizes": [path.stat().st_size for path in paths],
+        "problems": verify_saved_files(paths, []),
+        "attachment_warning": attachment_warning(len(paths)),
+    }
