+
+
+def _check_parts(parts: List[str], text_limit: int, size_limit: int) -> List[str]:
+    """各ファイルが上限に収まっているかを確かめ、問題点の一覧を返す（空なら合格）。"""
+    problems = []
+    total = len(parts)
+    for index, part in enumerate(parts, start=1):
+        chars = html_text_chars(part)
+        size = html_bytes(part)
+        if chars > text_limit:
+            problems.append(f"HTML {index}/{total} が {chars:,} 文字で上限 {text_limit:,} 文字を超えています")
+        if size > size_limit:
+            problems.append(f"HTML {index}/{total} が {size:,} バイトで上限 {size_limit:,} バイトを超えています")
+    return problems
+
+
+def _fit_with_retries(
+    sections: List[HtmlSection],
+    render: Callable[[Sequence[HtmlSection], int, int], str],
+    text_limit: int,
+    size_limit: int,
+    split_threshold: int,
+) -> Tuple[str, List[str], List[str]]:
+    """上限に収めて確かめ、超えていれば上限を厳しくして最大 MAX_ATTEMPTS 回まで振り分け直す。"""
+    whole, parts, problems = "", [""], []
+    for attempt in range(MAX_ATTEMPTS):
+        whole, parts = fit_html_parts(
+            sections,
+            render,
+            text_limit_for_attempt(attempt, text_limit),
+            image_limit_for_attempt(attempt, size_limit),
+            split_threshold,
+        )
+        problems = _check_parts(parts, text_limit, size_limit)
+        if not problems:
+            break
+        logger.warning("AI HTML exceeded the limits (attempt %d): %s", attempt + 1, problems)
+    return whole, parts, problems
 
 
