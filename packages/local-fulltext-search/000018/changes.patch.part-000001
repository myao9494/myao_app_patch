+test("2 ファイルを保存で上限を超えて分割されたら、保存したファイルとマークダウンの文字数を知らせる", async () => {
+  await withAiInput(
+    {
+      routes: {
+        "POST /api/export/ai-bundle/save": {
+          success: true,
+          markdown_name: "AI_context_part1of2.md",
+          markdown_names: ["AI_context_part1of2.md", "AI_context_part2of2.md"],
+          image_name: "AI_images.png",
+          image_names: ["AI_images.png"],
+          has_images: true,
+          text_parts: [{ index: 1, total: 2, chars: 198_000 }, { index: 2, total: 2, chars: 52_000 }],
+          image_sizes: [3_000_000],
+          problems: [],
+          attachment_warning: "",
+        },
+      },
+    },
+    async (app, page) => {
+      const modal = await generate(app, page);
+      await click(findByText(modal, ".ai-preview-modal-header button", "2ファイルを保存"));
+      const text = normalizeText(modal.textContent);
+      assert.match(text, /3ファイル保存完了: AI_context_part1of2\.md, AI_context_part2of2\.md & AI_images\.png/);
+      assert.match(text, /マークダウン 19\.80万文字 \/ 5\.20万文字/);
+    },
+  );
+});
