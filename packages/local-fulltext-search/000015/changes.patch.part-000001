@@ -33,6 +33,19 @@ def sanitize_outlook_html(html_text: str) -> str:
     return clean.strip()
 
 
+# Cc 見出し（半角・全角）。これが無い本文では Cc の除去処理を飛ばす
+_CC_LABEL_PATTERN = re.compile(r"(?:cc|ｃｃ)\s*[:：]", re.IGNORECASE)
+
+# 表の Cc 行: 1 つの <tr> の中の、見出しセルに Cc があり、その行末までを除去する。
+# 行をまたいで先読みしない（tempered greedy）ので、Cc が無い行で文書末尾まで探して遅くなることがない。
+_CC_TABLE_ROW_PATTERN = re.compile(
+    r"<tr\b[^>]*>(?:(?!</tr\s*>)[\s\S])*?"
+    r"<t[hd]\b[^>]*>(?:(?!</t[hd]\s*>)[\s\S])*?(?:cc|ｃｃ)\s*[:：]"
+    r"(?:(?!</tr\s*>)[\s\S])*</tr\s*>",
+    re.IGNORECASE,
+)
+
+
 def strip_email_cc_lines(text: str, is_html: bool = False) -> str:
     """
     メール本文（プレーンテキストまたはHTML）からCc行・Ccブロックを自動除去する。
@@ -41,33 +54,31 @@ def strip_email_cc_lines(text: str, is_html: bool = False) -> str:
         return ""
 
     if is_html:
-        # 1. <tr><th>Cc:</th><td>...</td></tr>
-        cleaned = re.sub(
-            r"<tr\b[^>]*>[\s\S]*?<t[hd][^>]*>[\s\S]*?(?:cc|ｃｃ)\s*[:：][\s\S]*?</t[hd]>[\s\S]*?</tr>",
-            "",
-            text,
-            flags=re.IGNORECASE,
-        )
-        # 2. <p> または <div> が Cc 行単体で構成されている場合
-        cleaned = re.sub(
-            r"<(?:p|div)\b[^>]*>\s*<b>\s*(?:cc|ｃｃ)\s*[:：]</b>[\s\S]*?</(?:p|div)>",
-            "",
-            cleaned,
-            flags=re.IGNORECASE,
-        )
-        # 3. <b>Cc:</b> ... <br> のインライン形式（後ろの <br> も巻き込んで除去）
-        cleaned = re.sub(
-            r"<b>\s*(?:cc|ｃｃ)\s*[:：]</b>[\s\S]*?(?:<br\s*/?>|(?=<b>|</(?:p|div|tr|td)>|$))",
-            "",
-            cleaned,
-            flags=re.IGNORECASE,
-        )
-        # 4. Cc: ... <br> （<b>なし）の形式
-        cleaned = re.sub(
-            r"(?im)^\s*(?:cc|ｃｃ)\s*[:：][^<]*(?:<[^>]+>[^<]*)*?(?:<br\s*/?>|$)",
-            "",
-            cleaned,
-        )
+        cleaned = text
+        # Cc 見出しが 1 つも無ければ、除去用の正規表現は走らせない（表だらけの長い本文で遅くなるため）
+        if _CC_LABEL_PATTERN.search(cleaned):
+            # 1. <tr><th>Cc:</th><td>...</td></tr>（その行の中だけを対象にする。手前・後ろの行は消さない）
+            cleaned = _CC_TABLE_ROW_PATTERN.sub("", cleaned)
+            # 2. <p> または <div> が Cc 行単体で構成されている場合
+            cleaned = re.sub(
+                r"<(?:p|div)\b[^>]*>\s*<b>\s*(?:cc|ｃｃ)\s*[:：]</b>[\s\S]*?</(?:p|div)>",
+                "",
+                cleaned,
+                flags=re.IGNORECASE,
+            )
+            # 3. <b>Cc:</b> ... <br> のインライン形式（後ろの <br> も巻き込んで除去）
+            cleaned = re.sub(
+                r"<b>\s*(?:cc|ｃｃ)\s*[:：]</b>[\s\S]*?(?:<br\s*/?>|(?=<b>|</(?:p|div|tr|td)>|$))",
+                "",
+                cleaned,
+                flags=re.IGNORECASE,
+            )
+            # 4. Cc: ... <br> （<b>なし）の形式
+            cleaned = re.sub(
+                r"(?im)^\s*(?:cc|ｃｃ)\s*[:：][^<]*(?:<[^>]+>[^<]*)*?(?:<br\s*/?>|$)",
+                "",
+                cleaned,
+            )
         # <br> の重複整理
         cleaned = re.sub(r"(?:<br\s*/?>\s*){3,}", "<br><br>", cleaned, flags=re.IGNORECASE)
         return cleaned
