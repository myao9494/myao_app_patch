diff --git a/backend/tests/test_change_tracking_service.py b/backend/tests/test_change_tracking_service.py
index f1295bb73d6ccf00132c0600e4b53a7e550baf62..45f35f3adaa35c16c57c897906286b70b739aeb4 100644
--- a/backend/tests/test_change_tracking_service.py
+++ b/backend/tests/test_change_tracking_service.py
@@ -489,3 +489,66 @@ def test_fsevents_observer_can_be_restarted_after_stop(monkeypatch) -> None:
     observer.stop()
 
     assert stop_flags_at_start == [False, False]
+
+
+def test_failed_background_refresh_is_backed_off_instead_of_retried_every_cycle(monkeypatch, tmp_path: Path) -> None:
+    """
+    バックグラウンド差分更新が失敗した対象は、待機時間が過ぎるまで再試行しない。
+    dirty のまま 0.5 秒ごとに全走査をやり直すと、サーバーが負荷で応答しなくなるため。
+    待機時間は失敗が続くほど延び、成功すると解除される。
+    """
+    database_path = tmp_path / "search.db"
+    root = tmp_path / "tracked"
+    root.mkdir()
+    connection = sqlite3.connect(database_path)
+    connection.row_factory = sqlite3.Row
+    initialize_schema(connection)
+    cursor = connection.execute(
+        """INSERT INTO targets (full_path, index_depth, source_type, created_at, updated_at)
+           VALUES (?, 1, 'local', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)""",
+        (root.as_posix(),),
+    )
+    connection.execute(
+        "INSERT INTO target_change_states (target_id, is_tracking, is_dirty) VALUES (?, 1, 1)",
+        (cursor.lastrowid,),
+    )
+    connection.commit()
+    connection.close()
+
+    def create_connection() -> sqlite3.Connection:
+        created = sqlite3.connect(database_path)
+        created.row_factory = sqlite3.Row
+        return created
+
+    calls = {"count": 0, "fail": True}
+
+    class FlakyIndexService:
+        def __init__(self, connection=None, **kwargs):
+            pass
+
+        def is_running(self):
+            return False
+
+        def ensure_fresh_target(self, **kwargs):
+            calls["count"] += 1
+            if calls["fail"]:
+                raise OSError("boom")
+
+    monkeypatch.setattr("app.services.index_service.IndexService", FlakyIndexService)
+    now = {"value": 1000.0}
+    service = ChangeTrackingService(connection_factory=create_connection, clock=lambda: now["value"])
+
+    service._refresh_one_debounced_dirty_target()
+    assert calls["count"] == 1
+    service._refresh_one_debounced_dirty_target()  # 待機中なので再試行しない
+    assert calls["count"] == 1
+
+    now["value"] += 10_000  # 待機時間が過ぎたので再試行する
+    service._refresh_one_debounced_dirty_target()
+    assert calls["count"] == 2
+
+    calls["fail"] = False
+    now["value"] += 10_000
+    service._refresh_one_debounced_dirty_target()
+    assert calls["count"] == 3
+    assert service._refresh_failures == {}  # 成功すると待機状態は解除される
diff --git a/backend/tests/test_email_cc_strip_performance.py b/backend/tests/test_email_cc_strip_performance.py
new file mode 100644
index 0000000000000000000000000000000000000000..f7ae84ee3ba23e8c9438bbc4fe019568b65ee3ea
--- /dev/null
+++ b/backend/tests/test_email_cc_strip_performance.py
@@ -0,0 +1,58 @@
+"""
+メール本文の Cc 行除去（strip_email_cc_lines）の速度と範囲のテスト。
+
+仕様:
+- Cc 行が無い、表だらけの長い HTML メールでも、本文の長さに対して線形に近い時間で終わる
+  （以前は <tr> ごとに文書末尾まで探して 3 乗で遅くなり、数十 KB で数十秒かかった）。
+- 表の Cc 行の除去は、その行（<tr>）の中だけに限る。手前の行・後ろの行の内容は消さない。
+"""
+
+from __future__ import annotations
+
+import time
+
+from app.vector.email_html import strip_email_cc_lines
+
+
+def _tables(n: int) -> str:
+    return "".join(
+        f'<table><tr><td><p class="MsoNormal">本文{i} テキスト <b>太字</b></p></td><td>x</td></tr></table>'
+        for i in range(n)
+    )
+
+
+def test_html_without_cc_is_fast() -> None:
+    html_text = _tables(600)
+    started = time.perf_counter()
+    result = strip_email_cc_lines(html_text, is_html=True)
+    assert time.perf_counter() - started < 1.0
+    assert "本文0 " in result and "本文599 " in result
+
+
+def test_html_with_cc_at_end_is_fast_and_keeps_earlier_rows() -> None:
+    html_text = _tables(600) + "<table><tr><th>Cc:</th><td>a@example.com</td></tr><tr><th>件名:</th><td>x</td></tr></table>"
+    started = time.perf_counter()
+    result = strip_email_cc_lines(html_text, is_html=True)
+    assert time.perf_counter() - started < 1.0
+    assert "本文0 " in result and "本文599 " in result
+    assert "a@example.com" not in result
+    assert "件名:" in result
+
+
+def test_table_cc_row_removal_is_limited_to_that_row() -> None:
+    html_text = (
+        "<table>"
+        "<tr><th>差出人:</th><td>alice</td></tr>"
+        "<tr><th>Cc:</th><td>bob@example.com</td></tr>"
+        "<tr><th>件名:</th><td>subject</td></tr>"
+        "</table>"
+    )
+    result = strip_email_cc_lines(html_text, is_html=True)
+    assert "bob@example.com" not in result
+    assert "alice" in result and "subject" in result
+
+
+def test_inline_forms_still_removed() -> None:
+    assert "x@y.z" not in strip_email_cc_lines("<p><b>Cc:</b> x@y.z</p><p>本文</p>", is_html=True)
+    assert "x@y.z" not in strip_email_cc_lines("<b>Cc:</b> x@y.z<br>本文<br>", is_html=True)
+    assert "本文" in strip_email_cc_lines("<b>Cc:</b> x@y.z<br>本文<br>", is_html=True)
diff --git a/backend/tests/test_export_document_reader.py b/backend/tests/test_export_document_reader.py
new file mode 100644
index 0000000000000000000000000000000000000000..8d2ac8c39080979d04868d3e23572f1fbd68065a
--- /dev/null
+++ b/backend/tests/test_export_document_reader.py
@@ -0,0 +1,104 @@
+"""
+AIインプット書き出しの文書読み込み（app.vector.export_document_reader）のテスト。
+
+仕様:
+- Markdown / テキストは文字コードを判定して読み、.docx / .pptx は本文テキストを抽出して読む。
+- Excel・PDF・画像・その他の拡張子は変換対象外（None）。バイナリを Markdown 変換へ流さない。
+- HTML 書き出しと Markdown+画像の書き出しは、対象外の文書を出力に含めない。
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from app.vector.export_document_reader import read_export_document_text
+from app.vector.html_exporter import export_documents_to_html
+from app.vector.markdown_image_exporter import export_documents_to_markdown_and_image
+
+
+def _make_docx(path: Path) -> None:
+    from docx import Document
+
+    doc = Document()
+    doc.add_paragraph("ワード本文のテキスト")
+    doc.save(str(path))
+
+
+def _make_pptx(path: Path) -> None:
+    from pptx import Presentation
+    from pptx.util import Inches
+
+    prs = Presentation()
+    slide = prs.slides.add_slide(prs.slide_layouts[5])
+    box = slide.shapes.add_textbox(Inches(1), Inches(1), Inches(4), Inches(1))
+    box.text_frame.text = "パワポ本文のテキスト"
+    prs.save(str(path))
+
+
+def test_markdown_and_text_are_read(tmp_path: Path) -> None:
+    md = tmp_path / "a.md"
+    md.write_text("# 見出し", encoding="utf-8")
+    txt = tmp_path / "b.txt"
+    txt.write_bytes("日本語".encode("cp932"))
+    assert read_export_document_text(md) == "# 見出し"
+    assert read_export_document_text(txt) == "日本語"
+
+
+def test_docx_and_pptx_are_extracted(tmp_path: Path) -> None:
+    docx_path = tmp_path / "a.docx"
+    pptx_path = tmp_path / "b.pptx"
+    _make_docx(docx_path)
+    _make_pptx(pptx_path)
+    assert "ワード本文のテキスト" in (read_export_document_text(docx_path) or "")
+    assert "パワポ本文のテキスト" in (read_export_document_text(pptx_path) or "")
+
+
+def test_broken_office_file_becomes_empty_text(tmp_path: Path) -> None:
+    broken = tmp_path / "broken.docx"
+    broken.write_bytes(b"not a zip")
+    assert read_export_document_text(broken) == ""
+
+
+def test_other_extensions_are_not_converted(tmp_path: Path) -> None:
+    for name in ("t.xlsx", "t.xlsm", "t.pdf", "t.png", "t.msg", "t.zip", "noext"):
+        p = tmp_path / name
+        p.write_bytes(b"\x00\x01binary")
+        assert read_export_document_text(p) is None, name
+
+
+def test_html_export_skips_unsupported_and_reads_office(tmp_path: Path) -> None:
+    md = tmp_path / "note.md"
+    md.write_text("# ノート本文", encoding="utf-8")
+    docx_path = tmp_path / "doc.docx"
+    pptx_path = tmp_path / "slide.pptx"
+    _make_docx(docx_path)
+    _make_pptx(pptx_path)
+    xlsx = tmp_path / "sheet.xlsx"
+    xlsx.write_bytes(b"PK\x03\x04binary")
+
+    html_content, stats = export_documents_to_html(
+        file_paths=[str(md), str(docx_path), str(pptx_path), str(xlsx)],
+    )
+
+    assert stats["total_documents"] == 3
+    assert "ワード本文のテキスト" in html_content
+    assert "パワポ本文のテキスト" in html_content
+    assert "sheet.xlsx" not in html_content
+
+
+def test_markdown_export_skips_unsupported_and_reads_office(tmp_path: Path) -> None:
+    md = tmp_path / "note.md"
+    md.write_text("# ノート本文", encoding="utf-8")
+    pptx_path = tmp_path / "slide.pptx"
+    _make_pptx(pptx_path)
+    xlsx = tmp_path / "sheet.xlsx"
+    xlsx.write_bytes(b"PK\x03\x04binary")
+
+    text, _image, stats = export_documents_to_markdown_and_image(
+        file_paths=[str(md), str(pptx_path), str(xlsx)],
+        vault_path=str(tmp_path),
+    )
+
+    assert "パワポ本文のテキスト" in text
+    assert "sheet.xlsx" not in text
+    assert stats["total_documents"] == 2
diff --git a/backend/tests/test_file_walker.py b/backend/tests/test_file_walker.py
new file mode 100644
index 0000000000000000000000000000000000000000..b6b0b193ed979332852e19ddcd2c97bf3e31c862
--- /dev/null
+++ b/backend/tests/test_file_walker.py
@@ -0,0 +1,136 @@
+"""
+file_walker の走査中エラーの扱いのテスト。
+
+- WinError 59（到達不能な共有先）: そのフォルダを auto_excluded_paths へ追加して走査を続ける。
+- WinError 3（走査中に消えた / 開けない名前のフォルダ）: そのフォルダだけ読み飛ばす。
+  一時的な事象なので auto_excluded_paths へは追加しない（除外設定へ永続化させない）。
+- 対象フォルダ自体が見つからない場合は握りつぶさず例外にする。
+"""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+
+from app.services import file_walker
+
+
+def _walk(root: Path, auto_excluded: set[str]) -> list[str]:
+    return sorted(
+        path.name
+        for path in file_walker.walk_indexable_files(
+            root,
+            frozenset(),
+            [],
+            excluded_path_prefixes=(),
+            auto_excluded_paths=auto_excluded,
+            allowed_extensions=frozenset({".md"}),
+            sorted_allowed_extensions=(".md",),
+            max_depth=5,
+        )
+    )
+
+
+def _make_tree(tmp_path: Path) -> Path:
+    root = tmp_path / "docs"
+    (root / "broken").mkdir(parents=True)
+    (root / "ok.md").write_text("a", encoding="utf-8")
+    (root / "broken" / "inside.md").write_text("b", encoding="utf-8")
+    return root
+
+
+def _scandir_failing_for(name: str, winerror: int, exc_type: type[OSError]):
+    original = os.scandir
+
+    def fake(path):
+        if Path(path).name == name:
+            error = exc_type(f"[WinError {winerror}]")
+            error.winerror = winerror
+            raise error
+        return original(path)
+
+    return fake
+
+
+def test_winerror_3_in_subfolder_is_skipped_without_auto_exclude(tmp_path: Path) -> None:
+    root = _make_tree(tmp_path)
+    auto_excluded: set[str] = set()
+
+    with patch("app.services.file_walker.os.scandir", side_effect=_scandir_failing_for("broken", 3, FileNotFoundError)):
+        names = _walk(root, auto_excluded)
+
+    assert names == ["ok.md"]
+    assert auto_excluded == set()
+
+
+def test_winerror_59_in_subfolder_is_auto_excluded(tmp_path: Path) -> None:
+    root = _make_tree(tmp_path)
+    auto_excluded: set[str] = set()
+
+    with patch("app.services.file_walker.os.scandir", side_effect=_scandir_failing_for("broken", 59, OSError)):
+        names = _walk(root, auto_excluded)
+
+    assert names == ["ok.md"]
+    assert len(auto_excluded) == 1
+
+
+def test_missing_root_still_raises(tmp_path: Path) -> None:
+    with pytest.raises(FileNotFoundError):
+        _walk(tmp_path / "does-not-exist", set())
+
+
+def test_unreadable_entry_does_not_abort_siblings(tmp_path: Path) -> None:
+    """1 つのエントリの判定が OSError になっても、同じフォルダの残りのエントリは走査する。"""
+    root = tmp_path / "docs"
+    (root / "a").mkdir(parents=True)
+    (root / "z.md").write_text("z", encoding="utf-8")
+    (root / "a" / "in.md").write_text("i", encoding="utf-8")
+    original = os.scandir
+
+    class _Entry:
+        def __init__(self, real):
+            self._real = real
+            self.name = real.name
+            self.path = real.path
+
+        def is_dir(self, follow_symlinks=True):
+            if self.name == "a":
+                raise OSError(22, "invalid")
+            return self._real.is_dir(follow_symlinks=follow_symlinks)
+
+        def is_file(self, follow_symlinks=True):
+            return self._real.is_file(follow_symlinks=follow_symlinks)
+
+    class _Scan:
+        def __init__(self, real):
+            self._real = real
+
+        def __enter__(self):
+            self._entries = [_Entry(e) for e in self._real.__enter__()]
+            return iter(self._entries)
+
+        def __exit__(self, *args):
+            return self._real.__exit__(*args)
+
+    def fake(path):
+        return _Scan(original(path))
+
+    with patch("app.services.file_walker.os.scandir", side_effect=fake):
+        names = _walk(root, set())
+
+    assert "z.md" in names
+
+
+def test_other_oserror_in_subfolder_is_skipped(tmp_path: Path) -> None:
+    """配下フォルダの想定外の OSError で走査全体を止めない（対象フォルダ自体は例外にする）。"""
+    root = _make_tree(tmp_path)
+    auto_excluded: set[str] = set()
+
+    with patch("app.services.file_walker.os.scandir", side_effect=_scandir_failing_for("broken", 22, OSError)):
+        names = _walk(root, auto_excluded)
+
+    assert names == ["ok.md"]
+    assert auto_excluded == set()
diff --git a/docs/ai_context_export_spec.md b/docs/ai_context_export_spec.md
index 30427f2058aaa93dc0453fbda770ca81aed15287..61f17b2f6236dbf0fbf93c6d85aabad3a2c8517a 100644
--- a/docs/ai_context_export_spec.md
+++ b/docs/ai_context_export_spec.md
@@ -95,3 +95,20 @@
   段階: リンク展開 / ノート読み込み / 画像・図面の埋め込み・解決 / Excalidraw図面のSVG生成 / SVGラスタライズ / Markdown→HTML変換 /
   メールリンク探索・解析・描画 / 結合画像の生成 / フォルダ走査（索引作成・早期終了）。
 - 集計は、書き出し応答の stats（`timings`）、INFO ログ、データフォルダの `export_timing.log`（追記）へ出す。出力内容は変えない。
+
+### メール Cc 行除去の高速化（実測に基づく修正）
+
+- 社内 Windows の実測で、メール描画が書き出し全体の約半分（25 通で 128 秒、1 通 47 秒）を占めた。
+  原因は `strip_email_cc_lines`（HTML）の表の Cc 行用の正規表現が、Cc の無い表だらけの本文で `<tr>` ごとに文書末尾まで探して 3 乗で遅くなること
+  （35 KB で約 30 秒）。
+- 対応: Cc 見出しが 1 つも無い本文では除去用の正規表現を走らせない。表の Cc 行の除去は 1 つの `<tr>` の中だけに限る
+  （以前は手前の行まで巻き込んで消すことがあった）。
+- MSG 解析は、オープン・プロパティ取得・HTML 本文取得とデコード・HTML→テキスト変換・添付取得を段階別に計測する（`export_timing.log`）。
+
+## 書き出し対象の拡張子（変換対象）
+
+- `app/vector/export_document_reader.py` が対象文書の本文を読む。HTML 書き出しと Markdown+画像の書き出しで共通。
+- 変換対象は `.md` / `.markdown` / `.txt`（UTF-8、読めなければ CP932）と、`.docx` / `.pptx`（`extract_text` による本文テキスト抽出。壊れたファイルは空文字）。
+- Excel（`.xlsx` / `.xlsm`）・PDF・画像・メール・その他の拡張子は変換対象外。出力に含めず、文書数にも数えない。
+  以前はバイナリを UTF-8 テキストとして Markdown 変換へ流しており、文字化けするうえ 1 ファイル約 10 秒かかっていた。
+- リンク展開が辿るのは従来どおり `.md` / `.excalidraw.md` のみ。
diff --git a/docs/change_tracking.md b/docs/change_tracking.md
index 3b58fe5f80abf301cb1a114a573e77d53d87221f..9fc9a8f6a058289a60d5a3804bb1b94bedacd424 100644
--- a/docs/change_tracking.md
+++ b/docs/change_tracking.md
@@ -66,6 +66,8 @@ macOS の FSEvents は通知の頻度が高いため、受信そのものは DEB
 
 `dirty_refresh_worker` によるバックグラウンド差分更新では、スレッドセーフな専用 DB 接続を `IndexService(connection=connection, enable_vector_sync=True)` に渡す。これにより、通常の全文検索（SQLite / FTS5）の更新と削除クリーンアップだけでなく、**ベクトルインデックス（Vector DB）の差分更新（`vector_state.sync_index`）も自動連動**して実行される。ファイル名変更（リネーム）や新規作成が発生した場合も、デフォルトのハイブリッド検索（`hybrid`）ですぐに最新状態が反映される。
 
+バックグラウンド差分更新が失敗した対象は dirty のまま残すが、すぐには再試行しない。失敗が続くごとに待機時間を 30 秒から倍にし（上限 10 分）、成功すると解除する（`ChangeTrackingService._refresh_failures`）。待機中の対象があっても、他の dirty 対象の更新は止めない。失敗直後に全走査を 0.5 秒ごとに繰り返すと、サーバーが応答しなくなるため。
+
 ## 検索時の並行インデックス耐性 (409 Conflict 回避)
 
 ファイル変更直後にデスクトップランチャー等から検索が行われ、バックグラウンド更新とタイミングが重複した場合、`IndexService.ensure_fresh_target()` は `HTTP 409 Conflict: Indexing is already running.` を送出する。
