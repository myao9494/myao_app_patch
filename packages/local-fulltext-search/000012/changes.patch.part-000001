diff --git a/backend/app/services/exclude_rules.py b/backend/app/services/exclude_rules.py
new file mode 100644
index 0000000000000000000000000000000000000000..1cd79fc29b06e59f59b28be424ef85c369f8d44a
--- /dev/null
+++ b/backend/app/services/exclude_rules.py
@@ -0,0 +1,207 @@
+"""
+除外キーワードの解析と、パス・名前に対する除外判定。
+
+仕様:
+- 除外キーワードは 1 行 1 件。`/` または `\\` を含むものは「パス形式」、それ以外は「名前形式」として扱う。
+- 名前形式: フォルダ名・ファイル名・ステム・ASCII 記号区切りトークンとの完全一致で判定する
+  （`old` が `older` に誤一致しない）。
+  語の区切りを持たないキーワードは部分一致で判定する: 非 ASCII を含むもの、および記号だけで 2 文字以上のもの
+  （`~$` は `~$draft.docx` に一致する。ドットだけのものは、ほぼすべての名前に一致するため対象外）。
+- パス形式: 絶対パス（`/foo`, `c:/foo`）は先頭一致、相対パス（`foo/bar`）は祖先の途中一致を許可する。
+  `foo/.` は foo 配下のドット始まり要素をまとめて除外する。
+- 全文インデックス・ベクトルインデックス・検索結果の絞り込みで同じ判定を共有する。
+"""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+
+def parse_exclude_keywords(value: str | None) -> list[str]:
+    seen: set[str] = set()
+    keywords: list[str] = []
+    for line in (value or "").splitlines():
+        keyword = line.strip()
+        normalized_keyword = normalize_keyword_identity(keyword)
+        if not keyword or normalized_keyword in seen:
+            continue
+        seen.add(normalized_keyword)
+        keywords.append(keyword)
+    return keywords
+
+
+def normalize_keyword_identity(keyword: str) -> str:
+    """
+    除外キーワードの重複判定・差分判定に使うキーを返す。
+    パス形式は大文字小文字を維持し、名前キーワードは小文字で同一視する。
+    """
+    return keyword if normalize_excluded_path_prefix(keyword) is not None else keyword.lower()
+
+
+def normalize_keyword_list(keywords: list[str]) -> str:
+    return "\n".join(parse_exclude_keywords("\n".join(keywords)))
+
+
+def merge_exclude_keyword_strings(*values: str) -> str:
+    merged: list[str] = []
+    for value in values:
+        merged.extend(parse_exclude_keywords(value))
+    return normalize_keyword_list(merged)
+
+
+def normalize_excluded_path_prefix(value: str | os.PathLike[str] | Path) -> str | None:
+    """
+    除外キーワードがフルパス形式なら比較しやすい表記へ正規化する。
+    """
+    raw_value = os.fspath(value).strip()
+    if "/" not in raw_value and "\\" not in raw_value:
+        return None
+    normalized = raw_value.replace("\\", "/")
+    if len(normalized) > 1:
+        normalized = normalized.rstrip("/")
+    return normalized
+
+
+def compile_exclude_keywords(keywords: list[str]) -> tuple[frozenset[str], list[str], tuple[str, ...]]:
+    """
+    名前一致用キーワードとフルパス除外用プレフィックスを分離して前処理する。
+    戻り値は（完全一致させる名前キーワード, 部分一致させる名前キーワード, パス形式のキーワード）。
+    """
+    name_keywords: list[str] = []
+    path_prefixes: list[str] = []
+    for keyword in keywords:
+        normalized_path = normalize_excluded_path_prefix(keyword)
+        if normalized_path is not None:
+            path_prefixes.append(normalized_path)
+            continue
+        name_keywords.append(keyword)
+    normalized_name_keywords = [keyword.lower() for keyword in name_keywords]
+    keyword_set = frozenset(normalized_name_keywords)
+    substring_keywords = [kw for kw in normalized_name_keywords if _matches_as_substring(kw)]
+    return keyword_set, substring_keywords, tuple(path_prefixes)
+
+
+def _matches_as_substring(keyword: str) -> bool:
+    """語の区切りで判定できないキーワード（非 ASCII を含む、または記号だけ）かを返す。"""
+    if any(ord(char) > 127 for char in keyword):
+        return True
+    is_symbol_only = not any(char.isalnum() for char in keyword)
+    return is_symbol_only and len(keyword) >= 2 and keyword.strip(".") != ""
+
+
+def should_exclude_path(path: Path, keywords: list[str]) -> bool:
+    """
+    パスの各パートが除外キーワードに一致するか判定する。検索サービスからも利用される。
+    """
+    if not keywords:
+        return False
+    keyword_set, substring_keywords, excluded_path_prefixes = compile_exclude_keywords(keywords)
+    return should_exclude_path_with_keywords(path, keyword_set, substring_keywords, excluded_path_prefixes)
+
+
+def should_exclude_path_with_keywords(path: Path,
+    keyword_set: frozenset[str],
+    substring_keywords: list[str],
+    excluded_path_prefixes: tuple[str, ...],
+) -> bool:
+    """
+    事前計算済みキーワード集合を用いてパス全体の除外判定を行う。
+    """
+    normalized_path = normalize_excluded_path_prefix(path)
+    if normalized_path is not None and is_excluded_path_prefix(normalized_path, excluded_path_prefixes):
+        return True
+    return any(is_excluded_name(part, keyword_set, substring_keywords) for part in path.parts)
+
+
+def is_excluded_path_prefix(normalized_path: str, excluded_path_prefixes: tuple[str, ...]) -> bool:
+    """
+    パス全体またはその祖先が除外パスキーワードに一致するか判定する。
+    絶対パス指定は先頭一致、相対パス指定は祖先の途中一致を許可する。
+    """
+    for prefix in excluded_path_prefixes:
+        if is_hidden_child_path_prefix(prefix):
+            if matches_hidden_child_path_prefix(normalized_path, prefix):
+                return True
+            continue
+
+        if is_absolute_excluded_path_prefix(prefix):
+            if normalized_path == prefix or normalized_path.startswith(f"{prefix}/"):
+                return True
+            continue
+
+        if normalized_path == prefix or normalized_path.startswith(f"{prefix}/"):
+            return True
+
+        bounded_prefix = f"/{prefix}"
+        if normalized_path.endswith(bounded_prefix) or f"{bounded_prefix}/" in normalized_path:
+            return True
+    return False
+
+
+def is_hidden_child_path_prefix(prefix: str) -> bool:
+    """
+    `foo/.` 形式は、foo 配下のドット始まり要素をまとめて除外するショートハンドとして扱う。
+    """
+    return prefix.endswith("/.")
+
+
+def matches_hidden_child_path_prefix(normalized_path: str, prefix: str) -> bool:
+    """
+    `foo/.` 形式の除外キーワードが、foo 配下の `.bar` や `.baz/...` に一致するか判定する。
+    """
+    if normalized_path.startswith(prefix):
+        return True
+
+    if is_absolute_excluded_path_prefix(prefix):
+        return False
+
+    bounded_prefix = f"/{prefix}"
+    return normalized_path.endswith(bounded_prefix) or bounded_prefix in normalized_path
+
+
+def is_absolute_excluded_path_prefix(prefix: str) -> bool:
+    """
+    除外パスキーワードが絶対パスかどうかを判定する。
+    `/foo/bar` と `c:/foo/bar` の両方を受け付ける。
+    """
+    if prefix.startswith("/"):
+        return True
+    return len(prefix) >= 3 and prefix[1] == ":" and prefix[2] == "/"
+
+
+def is_excluded_name(name: str, keyword_set: frozenset[str], substring_keywords: list[str]) -> bool:
+    """
+    ディレクトリ名/ファイル名が除外キーワードに一致するか判定する。
+    keyword_set による O(1) ルックアップで高速化。
+    """
+    lower_name = name.lower()
+    stripped_name = lower_name.lstrip(".")
+    if lower_name in keyword_set or stripped_name in keyword_set:
+        return True
+    stem = Path(lower_name).stem
+    if stem in keyword_set or stem.lstrip(".") in keyword_set:
+        return True
+    for kw in substring_keywords:
+        if kw in lower_name:
+            return True
+    tokens = set(split_ascii_tokens(lower_name))
+    return bool(tokens & keyword_set)
+
+
+def split_ascii_tokens(value: str) -> list[str]:
+    """
+    ASCII 記号で区切られたトークン列を返す。
+    """
+    token = []
+    tokens: list[str] = []
+    for char in value:
+        if char.isascii() and char.isalnum():
+            token.append(char)
+            continue
+        if token:
+            tokens.append("".join(token))
+            token.clear()
+    if token:
+        tokens.append("".join(token))
+    return tokens
diff --git a/backend/app/services/file_walker.py b/backend/app/services/file_walker.py
new file mode 100644
index 0000000000000000000000000000000000000000..a5757a24a8196d7bdb3818fd91bd81f2c3494e19
--- /dev/null
+++ b/backend/app/services/file_walker.py
@@ -0,0 +1,116 @@
+"""
+フォルダ配下の「インデックス対象ファイル」の走査。
+
+全文インデックスとベクトルインデックスが同じ関数を使い、対象範囲（除外キーワード・階層数・拡張子）を一致させる。
+- 除外フォルダへは再帰しない。エントリ名だけで除外判定する（親フォルダは再帰の途中で判定済み）。
+- 階層数は対象フォルダ直下を 0 と数え、max_depth より深いフォルダへは入らない。
+- シンボリックリンクはたどらない。
+"""
+
+from __future__ import annotations
+
+import os
+from collections.abc import Iterator
+from pathlib import Path
+
+from app.services import exclude_rules
+
+
+def walk_indexable_files(
+    root: Path,
+    keyword_set: frozenset[str],
+    substring_keywords: list[str],
+    *,
+    excluded_path_prefixes: tuple[str, ...],
+    auto_excluded_paths: set[str],
+    allowed_extensions: frozenset[str],
+    sorted_allowed_extensions: tuple[str, ...],
+    max_depth: int,
+) -> Iterator[Path]:
+    """
+    root 配下で、除外条件・階層・拡張子の条件を満たすファイルを順に返す。
+    到達不能な共有先（Windows の WinError 59）は auto_excluded_paths へ追加して走査を続ける。
+    """
+    yield from _walk_files(
+        root,
+        keyword_set,
+        substring_keywords,
+        excluded_path_prefixes=excluded_path_prefixes,
+        auto_excluded_paths=auto_excluded_paths,
+        allowed_extensions=allowed_extensions,
+        sorted_allowed_extensions=sorted_allowed_extensions,
+        max_depth=max_depth,
+    )
+
+
+def _walk_files(
+    root: Path,
+    keyword_set: frozenset[str],
+    substring_keywords: list[str],
+    *,
+    excluded_path_prefixes: tuple[str, ...],
+    auto_excluded_paths: set[str],
+    allowed_extensions: frozenset[str],
+    sorted_allowed_extensions: tuple[str, ...],
+    max_depth: int,
+    current_depth: int = 0,
+):
+    """
+    os.scandir ベースの高速ファイル走査。
+    除外ディレクトリには再帰せず、深さと拡張子の条件を満たすファイルだけを返す。
+    """
+    normalized_root = exclude_rules.normalize_excluded_path_prefix(root)
+    if normalized_root is not None and exclude_rules.is_excluded_path_prefix(normalized_root, excluded_path_prefixes):
+        return
+
+    try:
+        with os.scandir(root) as entries:
+            for entry in entries:
+                # 再帰走査なので親パーツは既にチェック済み。現在のエントリ名だけで判定する
+                if exclude_rules.is_excluded_name(entry.name, keyword_set, substring_keywords):
+                    continue
+
+                normalized_entry_path = exclude_rules.normalize_excluded_path_prefix(entry.path)
+                if normalized_entry_path is not None and exclude_rules.is_excluded_path_prefix(
+                    normalized_entry_path,
+                    excluded_path_prefixes,
+                ):
+                    continue
+
+                if entry.is_dir(follow_symlinks=False):
+                    if current_depth < max_depth:
+                        yield from _walk_files(
+                            Path(entry.path),
+                            keyword_set,
+                            substring_keywords,
+                            excluded_path_prefixes=excluded_path_prefixes,
+                            auto_excluded_paths=auto_excluded_paths,
+                            allowed_extensions=allowed_extensions,
+                            sorted_allowed_extensions=sorted_allowed_extensions,
+                            max_depth=max_depth,
+                            current_depth=current_depth + 1,
+                        )
+                    continue
+
+                if entry.is_file(follow_symlinks=False):
+                    resolved_extension = next(
+                        (extension for extension in sorted_allowed_extensions if entry.name.lower().endswith(extension)),
+                        None,
+                    )
+                    if resolved_extension in allowed_extensions:
+                        yield Path(entry.path)
+    except PermissionError:
+        pass
+    except OSError as error:
+        if is_unexpected_network_error(error):
+            if normalized_root is not None:
+                auto_excluded_paths.add(normalized_root)
+            return
+        raise
+
+
+def is_unexpected_network_error(error: OSError) -> bool:
+    """
+    Windows の WinError 59 はアクセス不能な共有先として扱い、以降の走査対象から外す。
+    """
+    return getattr(error, "winerror", None) == 59
diff --git a/backend/app/services/fts_search.py b/backend/app/services/fts_search.py
new file mode 100644
index 0000000000000000000000000000000000000000..1c94bc4b06771b0cd1ce32087a972256781cc21c
--- /dev/null
+++ b/backend/app/services/fts_search.py
@@ -0,0 +1,523 @@
+"""
+FTS5 を使う通常の全文検索。
+
+- 除外条件もフォルダ検索も無いときは、総件数と表示ページ分を 1 つの SQL で取得する（高速ページング）。
+- 除外キーワード・除外語・フォルダ検索があるときは、一致したファイルをすべて読み、Python 側で絞り込む。
+- 検索語が除外語（`-語`）だけのときは、候補全体から除外語に該当しないものを返す。
+"""
+
+from __future__ import annotations
+
+import logging
+import time as time_module
+from collections.abc import Callable, Sequence
+from datetime import UTC, datetime
+from sqlite3 import Connection
+
+from app.models.indexing import AppSettingsResponse
+from app.models.search import SearchQueryParams, SearchResponse, SearchResultItem
+from app.services import search_query, search_result_items, search_snippets, search_sql
+
+logger = logging.getLogger(__name__)
+
+
+def search_with_fts(
+    connection: Connection,
+    *,
+    params: SearchQueryParams,
+    normalized_target_path: str,
+    excluded_keywords: list[str],
+    app_settings: AppSettingsResponse,
+    path_depth_limit: int | None,
+    resolve_default_target_paths: Callable[[str], list[str]] | None = None,
+    restrict_file_ids: Sequence[int] | None = None,
+) -> SearchResponse:
+    """
+    通常モードでは既存の FTS5 ベース全文検索を利用する。
+    CTE を1回だけ評価し、COUNT と結果を同時に取得する。
+    """
+    fts_start = time_module.perf_counter()
+
+    scoped_files_cte_sql, scoped_file_values = search_sql.build_scoped_files_cte(
+        normalized_target_path=normalized_target_path,
+        search_all_enabled=params.search_all_enabled,
+        path_depth_limit=path_depth_limit,
+        types=params.types,
+        date_field=params.date_field,
+        created_from=params.created_from,
+        created_to=params.created_to,
+        custom_content_extensions=app_settings.custom_content_extensions,
+        custom_filename_extensions=app_settings.custom_filename_extensions,
+        source_type=params.source_type,
+        resolve_default_target_paths=resolve_default_target_paths,
+        restrict_file_ids=restrict_file_ids,
+    )
+    cte_elapsed = time_module.perf_counter() - fts_start
+    logger.info("FTS: Scoped files CTE build time: %.3fs", cte_elapsed)
+
+    normalized_query = params.q.strip()
+    include_terms, exclude_terms = search_query.split_search_terms(normalized_query)
+    expanded_include_terms = search_query.expand_include_terms_with_synonyms(include_terms, app_settings.synonym_groups)
+    search_body = search_query.search_target_includes_body(params.search_target)
+    search_filename = search_query.search_target_includes_filename(params.search_target)
+    search_folder = search_query.search_target_includes_folder(params.search_target)
+
+    matched_queries, query_values = search_sql.build_term_match_queries(
+        expanded_include_terms,
+        search_body=search_body,
+        search_filename=search_filename,
+    )
+    prep_elapsed = time_module.perf_counter() - fts_start - cte_elapsed
+    logger.info("FTS: Query preparation time: %.3fs", prep_elapsed)
+
+    highlight_terms = search_query.flatten_highlight_terms(expanded_include_terms)
+    file_items: list[SearchResultItem] = []
+    if matched_queries:
+        order_by_clause = search_sql.build_order_by_clause(
+            sort_by=params.sort_by,
+            sort_order=params.sort_order,
+            table_alias="scoped_files",
+        )
+        matched_files_cte = search_sql.build_matched_files_cte(
+            scoped_files_cte_sql=scoped_files_cte_sql,
+            matched_queries=matched_queries,
+            expanded_include_terms=expanded_include_terms,
+        )
+        filename_phrase = f"%{search_query.escape_like_pattern(normalized_query.lower())}%"
+        all_query_values = [
+            *scoped_file_values,
+            search_query.normalize_query_for_history(normalized_query),
+            *query_values,
+            normalized_query.lower(),
+            filename_phrase,
+            normalized_query.lower(),
+        ]
+        # フォルダ検索が有効、または除外条件がある場合は、全件を一旦取得して Python 側で処理する必要がある
+        should_fetch_all_files = (
+            search_folder
+            or exclude_terms
+            or (not normalized_target_path and excluded_keywords)
+        )
+        if not should_fetch_all_files:
+            return _search_matched_files_paged(
+                connection,
+                matched_files_cte=matched_files_cte,
+                all_query_values=all_query_values,
+                order_by_clause=order_by_clause,
+                params=params,
+                normalized_target_path=normalized_target_path,
+                highlight_terms=highlight_terms,
+            )
+        file_items = _collect_matched_file_items(
+            connection,
+            matched_files_cte=matched_files_cte,
+            all_query_values=all_query_values,
+            order_by_clause=order_by_clause,
+            params=params,
+            normalized_target_path=normalized_target_path,
+            excluded_keywords=excluded_keywords,
+            exclude_terms=exclude_terms,
+            highlight_terms=highlight_terms,
+        )
+    elif exclude_terms:
+        file_items = _collect_exclude_only_file_items(
+            connection,
+            scoped_files_cte_sql=scoped_files_cte_sql,
+            scoped_file_values=scoped_file_values,
+            params=params,
+            normalized_target_path=normalized_target_path,
+            excluded_keywords=excluded_keywords,
+            exclude_terms=exclude_terms,
+        )
+
+    if not search_folder:
+        return search_result_items.paginate_search_items(file_items, params)
+
+    folder_items = _search_folder_results(
+        connection,
+        scoped_files_cte_sql=scoped_files_cte_sql,
+        scoped_file_values=scoped_file_values,
+        normalized_target_path=normalized_target_path,
+        excluded_keywords=excluded_keywords,
+        expanded_include_terms=expanded_include_terms,
+        exclude_terms=exclude_terms,
+        sort_by=params.sort_by,
+        sort_order=params.sort_order,
+    )
+    merged_items = search_result_items.sort_search_result_items(
+        [*file_items, *folder_items],
+        sort_by=params.sort_by,
+        sort_order=params.sort_order,
+    )
+    return search_result_items.paginate_search_items(merged_items, params)
+
+
+def _collect_matched_file_items(
+    connection: Connection,
+    *,
+    matched_files_cte: str,
+    all_query_values: list[object],
+    order_by_clause: str,
+    params: SearchQueryParams,
+    normalized_target_path: str,
+    excluded_keywords: list[str],
+    exclude_terms: list[str],
+    highlight_terms: list[str],
+) -> list[SearchResultItem]:
+    """
+    全件取得モード: 一致したファイルをすべて取得し、除外キーワードと除外語を Python 側で適用する。
+    フォルダ検索との統合や除外条件があり、SQL だけではページングできない場合に使う。
+    """
+    file_items: list[SearchResultItem] = []
+    exec_start = time_module.perf_counter()
+    db_start = time_module.perf_counter()
+    cursor = connection.execute(
+        f"""
+        {matched_files_cte}
+        SELECT
+            scoped_files.id AS file_id,
+            'file' AS result_kind,
+            scoped_files.file_name,
+            scoped_files.normalized_path,
+            scoped_files.file_ext,
+            scoped_files.created_at,
+            scoped_files.mtime,
+            scoped_files.click_count,
+            scoped_files.obsidian_click_count,
+            scoped_files.obsidian_rank_score,
+            scoped_files.has_obsidian_top_tag,
+            scoped_files.source_type,
+            filtered.snippet,
+            filtered.segment_type,
+            filtered.body_content,
+            filtered.filename_match_level,
+            filtered.relevance_bucket,
+            {search_sql.build_utility_score_expression('scoped_files')} AS utility_score,
+            COALESCE(query_affinity.query_click_score, 0.0) AS query_click_score
+        FROM filtered
+        JOIN scoped_files ON scoped_files.id = filtered.file_id
+        LEFT JOIN query_affinity ON query_affinity.file_id = scoped_files.id
+        ORDER BY {order_by_clause}
+        """,
+        tuple(all_query_values),
+    )
+    db_elapsed = time_module.perf_counter() - db_start
+    logger.info("FTS: SQL cursor creation time (all file search): %.3fs", db_elapsed)
+
+    process_start = time_module.perf_counter()
+    for row in cursor:
+        if search_result_items.should_exclude_search_result(
+            target_path=normalized_target_path,
+            candidate_path=str(row["normalized_path"]),
+            excluded_keywords=excluded_keywords,
+        ):
+            continue
+        if search_query.matches_excluded_search_terms(
+            file_name=str(row["file_name"]),
+            body_content=str(row["body_content"] or ""),
+            folder_path=search_result_items.resolve_folder_path(str(row["normalized_path"]), str(row["file_name"])),
+            exclude_terms=exclude_terms,
+        ):
+            continue
+        file_items.append(
+            search_result_items.build_search_result_item(
+                row=row,
+                normalized_target_path=normalized_target_path,
+                highlight_terms=highlight_terms,
+                include_snippets=params.include_snippets,
+            )
+        )
+    process_elapsed = time_module.perf_counter() - process_start
+    logger.info("FTS: Result fetch/filter/build time (all): %.3fs (matched=%d)", process_elapsed, len(file_items))
+
+    exec_elapsed = time_module.perf_counter() - exec_start
+    logger.info("FTS: Total execution and fetching time (all): %.3fs", exec_elapsed)
+    return file_items
+
+
+def _search_matched_files_paged(
+    connection: Connection,
+    *,
+    matched_files_cte: str,
+    all_query_values: list[object],
+    order_by_clause: str,
+    params: SearchQueryParams,
+    normalized_target_path: str,
+    highlight_terms: list[str],
+) -> SearchResponse:
+    """
+    高速ページングモード: 総件数と表示ページ分だけを 1 クエリで取得する。
+    """
+    paged_order_by_clause = search_sql.build_paged_order_by_clause(
+        sort_by=params.sort_by,
+        sort_order=params.sort_order,
+        table_alias="paged_matches",
+    )
+    exec_start = time_module.perf_counter()
+    paged_query_values = [*all_query_values, params.limit + 1, params.offset]
+
+    db_start = time_module.perf_counter()
+    rows = connection.execute(
+        f"""
+        {matched_files_cte},
+        total_count AS (
+            SELECT COUNT(*) AS total
+            FROM filtered
+        ),
+        paged_matches AS (
+            SELECT
+                scoped_files.id AS file_id,
+                'file' AS result_kind,
+                scoped_files.file_name,
+                scoped_files.normalized_path,
+                scoped_files.file_ext,
+                scoped_files.created_at,
+                scoped_files.mtime,
+                scoped_files.click_count,
+                scoped_files.obsidian_click_count,
+                scoped_files.obsidian_rank_score,
+                scoped_files.has_obsidian_top_tag,
+                scoped_files.source_type,
+                filtered.snippet,
+                filtered.segment_type,
+                filtered.body_content,
+                filtered.filename_match_level,
+                filtered.relevance_bucket,
+                {search_sql.build_utility_score_expression('scoped_files')} AS utility_score,
+                COALESCE(query_affinity.query_click_score, 0.0) AS query_click_score,
+                filtered.match_rank,
+                filtered.score
+            FROM filtered
+            JOIN scoped_files ON scoped_files.id = filtered.file_id
+            LEFT JOIN query_affinity ON query_affinity.file_id = scoped_files.id
+            ORDER BY {order_by_clause}
+            LIMIT ? OFFSET ?
+        )
+        SELECT
+            paged_matches.file_id,
+            paged_matches.result_kind,
+            paged_matches.file_name,
+            paged_matches.normalized_path,
+            paged_matches.file_ext,
+            paged_matches.created_at,
+            paged_matches.mtime,
+            paged_matches.click_count,
+            paged_matches.obsidian_click_count,
+            paged_matches.obsidian_rank_score,
+            paged_matches.has_obsidian_top_tag,
+            paged_matches.source_type,
+            paged_matches.snippet,
+            paged_matches.segment_type,
+            paged_matches.body_content,
+            paged_matches.filename_match_level,
+            paged_matches.relevance_bucket,
+            paged_matches.utility_score,
+            paged_matches.query_click_score,
+            total_count.total
+        FROM total_count
+            LEFT JOIN paged_matches ON 1 = 1
+        ORDER BY {paged_order_by_clause}
+        """,
+        tuple(paged_query_values),
+    ).fetchall()
+    db_elapsed = time_module.perf_counter() - db_start
+    logger.info("FTS: SQL execution time (count + paged file search): %.3fs", db_elapsed)
+
+    proc_start = time_module.perf_counter()
+    total = int(rows[0]["total"]) if rows else 0
+    page_rows = [row for row in rows if row["file_id"] is not None]
+    has_more = len(page_rows) > params.limit
+    visible_rows = page_rows[: params.limit]
+    items = [
+        search_result_items.build_search_result_item(
+            row=row,
+            normalized_target_path=normalized_target_path,
+            highlight_terms=highlight_terms,
+            include_snippets=params.include_snippets,
+        )
+        for row in visible_rows
+    ]
+    proc_elapsed = time_module.perf_counter() - proc_start
+    logger.info(
+        "FTS: Result processing time: %.3fs (rows=%d, visible=%d, total=%d)",
+        proc_elapsed,
+        len(page_rows),
+        len(visible_rows),
+        total,
+    )
+
+    exec_elapsed = time_module.perf_counter() - exec_start
+    logger.info("FTS: Total execution and fetching time (paged): %.3fs", exec_elapsed)
+
+    return SearchResponse(
+        total=total,
+        items=items,
+        has_more=has_more,
+        next_offset=params.offset + len(items) if has_more else None,
+    )
+
+
+def _collect_exclude_only_file_items(
+    connection: Connection,
+    *,
+    scoped_files_cte_sql: str,
+    scoped_file_values: list[object],
+    params: SearchQueryParams,
+    normalized_target_path: str,
+    excluded_keywords: list[str],
+    exclude_terms: list[str],
+) -> list[SearchResultItem]:
+    """
+    検索語が除外語（`-keyword`）だけのとき、スコープ内の全ファイルから除外語に該当しないものを返す。
+    """
+    file_items: list[SearchResultItem] = []
+    cursor = connection.execute(
+        f"""
+        {scoped_files_cte_sql}
+        SELECT
+            scoped_files.id AS file_id,
+            'file' AS result_kind,
+            scoped_files.file_name,
+            scoped_files.normalized_path,
+            scoped_files.file_ext,
+            scoped_files.created_at,
+            scoped_files.mtime,
+            scoped_files.click_count,
+            scoped_files.obsidian_click_count,
+            scoped_files.obsidian_rank_score,
+            scoped_files.has_obsidian_top_tag,
+            scoped_files.source_type,
+            '' AS snippet,
+            'filename' AS segment_type,
+            file_segments.content AS body_content,
+            0 AS filename_match_level,
+            10 AS relevance_bucket,
+            {search_sql.build_utility_score_expression('scoped_files')} AS utility_score,
+            0.0 AS query_click_score
+        FROM scoped_files
+        LEFT JOIN file_segments
+          ON file_segments.file_id = scoped_files.id
+         AND file_segments.segment_type = 'body'
+        ORDER BY {search_sql.build_scan_order_by_clause(sort_by=params.sort_by, sort_order=params.sort_order, table_alias='scoped_files')}
+        """,
+        tuple(scoped_file_values),
+    )
+    seen_ids = set()
+    for row in cursor:
+        fid = int(row["file_id"])
+        if fid in seen_ids:
+            continue
+        seen_ids.add(fid)
+        if search_result_items.should_exclude_search_result(
+            target_path=normalized_target_path,
+            candidate_path=str(row["normalized_path"]),
+            excluded_keywords=excluded_keywords,
+        ):
+            continue
+        if search_query.matches_excluded_search_terms(
+            file_name=str(row["file_name"]),
+            body_content=str(row["body_content"] or ""),
+            folder_path=search_result_items.resolve_folder_path(str(row["normalized_path"]), str(row["file_name"])),
+            exclude_terms=exclude_terms,
+        ):
+            continue
+        file_items.append(
+            search_result_items.build_search_result_item(
+                row=row,
+                normalized_target_path=normalized_target_path,
+                highlight_terms=[],
+                include_snippets=params.include_snippets,
+            )
+        )
+    return file_items
+
+
+def _search_folder_results(
+    connection: Connection,
+    *,
+    scoped_files_cte_sql: str,
+    scoped_file_values: list[object],
+    normalized_target_path: str,
+    excluded_keywords: list[str],
+    expanded_include_terms: list[list[str]],
+    exclude_terms: list[str],
+    sort_by: str,
+    sort_order: str,
+) -> list[SearchResultItem]:
+    """
+    フォルダ名検索は SQL 側で親フォルダを集約し、Python 側の全件一意化を避ける。
+    """
+    if not expanded_include_terms:
+        return []
+
+    lowered_exclude_terms = [term.lower() for term in exclude_terms if term]
+    folder_path_expression = search_sql.build_folder_path_sql_expression("scoped_files")
+    filters: list[str] = []
+    values: list[object] = [*scoped_file_values]
+
+    for term_group in expanded_include_terms:
+        group_filters: list[str] = []
+        for term in term_group:
+            if term:
+                group_filters.append(f"lower({folder_path_expression}) LIKE ? ESCAPE '\\'")
+                values.append(f"%{search_query.escape_like_pattern(term.lower())}%")
+        if group_filters:
+            filters.append(f"({' OR '.join(group_filters)})")
+
+    for term in lowered_exclude_terms:
+        filters.append(f"lower({folder_path_expression}) NOT LIKE ? ESCAPE '\\'")
+        values.append(f"%{search_query.escape_like_pattern(term)}%")
+
+    where_clause = " AND ".join(filters) if filters else "1 = 1"
+    folder_sql_start = time_module.perf_counter()
+    try:
+        rows = connection.execute(
+            f"""
+            {scoped_files_cte_sql}
+            SELECT
+                {folder_path_expression} AS folder_path,
+                MAX(scoped_files.created_at) AS created_at,
+                MAX(scoped_files.mtime) AS mtime
+            FROM scoped_files
+            WHERE {where_clause}
+            GROUP BY folder_path
+            """,
+            tuple(values),
+        ).fetchall()
+    finally:
+        folder_sql_elapsed = time_module.perf_counter() - folder_sql_start
+        logger.info("FTS: SQL execution time (folder search): %.3fs", folder_sql_elapsed)
+
+    flat_highlight_terms = search_query.flatten_highlight_terms(expanded_include_terms)
+    items: list[SearchResultItem] = []
+    for index, row in enumerate(rows):
+        folder_path = str(row["folder_path"])
+        if search_result_items.should_exclude_search_result(
+            target_path=normalized_target_path,
+            candidate_path=folder_path,
+            excluded_keywords=excluded_keywords,
+        ):
+            continue
+        display_name = search_result_items.resolve_result_display_name("folder", folder_path, folder_path)
+        items.append(
+            SearchResultItem(
+                # フォルダ結果は files に行が無いため、負の連番を割り当てる
+                file_id=-(index + 1),
+                result_kind="folder",
+                target_path=normalized_target_path,
+                file_name=display_name,
+                full_path=folder_path,
+                file_ext="",
+                created_at=datetime.fromtimestamp(float(row["created_at"]), tz=UTC),
+                mtime=datetime.fromtimestamp(float(row["mtime"]), tz=UTC),
+                click_count=0,
+                snippet=search_snippets.resolve_snippet(
+                    snippet=None,
+                    file_name=display_name,
+                    segment_type="folder",
+                    folder_path=folder_path,
+                    highlight_terms=flat_highlight_terms,
+                ),
+            )
+        )
+    return search_result_items.sort_search_result_items(items, sort_by=sort_by, sort_order=sort_order)
diff --git a/backend/app/services/gantt_search.py b/backend/app/services/gantt_search.py
new file mode 100644
index 0000000000000000000000000000000000000000..fd661e60aede744989e131570cf5d1400621d734
--- /dev/null
+++ b/backend/app/services/gantt_search.py
@@ -0,0 +1,171 @@
+"""
+gantt アプリのタスク検索。
+
+gantt アプリの `/tasks` を検索のたびに取得し、タスクの内容に検索語が含まれるものを検索結果として返す。
+インデックスは作らない。file_id は他の結果と衝突しないよう負の値（-タスクID）にする。
+リンク項目（hyperlink 等）は検索対象にも除外語の判定にも使わない。
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from datetime import UTC, datetime
+from html import escape
+from urllib.request import Request, urlopen
+
+from fastapi import HTTPException, status
+
+from app.config import settings
+from app.models.search import SearchQueryParams, SearchResponse, SearchResultItem
+from app.services import search_query, search_result_items
+
+GANTT_LINK_FIELD_NAMES = frozenset({"hyperlink", "link", "url", "href", "input_url", "external_url"})
+GANTT_REQUEST_TIMEOUT_SECONDS = 3.0
+
+
+def search_gantt_tasks(params: SearchQueryParams, *, synonym_groups: str) -> SearchResponse:
+    """
+    gantt アプリの `/tasks` JSON をオンデマンドで取得し、タスク本文を検索結果として返す。
+    """
+    tasks = fetch_gantt_tasks()
+    include_groups, exclude_terms = search_query.split_search_terms(params.q.strip())
+    expanded_include_terms = search_query.expand_include_terms_with_synonyms(include_groups, synonym_groups)
+    flat_highlight_terms = search_query.flatten_highlight_terms(expanded_include_terms)
+    lowered_exclude_terms = [term.lower() for term in exclude_terms]
+    matched_items: list[SearchResultItem] = []
+    now = datetime.now(tz=UTC)
+    for index, task in enumerate(tasks, start=1):
+        task_text = stringify_gantt_task(task)
+        haystack = task_text.lower()
+        if expanded_include_terms and not all(
+            any(term.lower() in haystack for term in group) for group in expanded_include_terms
+        ):
+            continue
+        if lowered_exclude_terms and any(term in haystack for term in lowered_exclude_terms):
+            continue
+        task_id = extract_gantt_task_id(task, fallback=index)
+        task_name = extract_gantt_task_name(task, fallback=f"Task {task_id}")
+        task_link = extract_gantt_task_link(task)
+        matched_items.append(
+            SearchResultItem(
+                file_id=-task_id,
+                result_kind="file",
+                source_type="gantt",
+                target_path=settings.gantt_api_base_url.rstrip("/") + "/tasks",
+                file_name=task_name,
+                full_path=f"gantt://tasks/{task_id}",
+                file_ext=".gantt",
+                created_at=now,
+                mtime=now,
+                click_count=0,
+                snippet=build_gantt_snippet(task_text, flat_highlight_terms) if params.include_snippets else "",
+                gantt_link=task_link,
+            )
+        )
+    return search_result_items.paginate_search_items(matched_items, params)
+
+
+def fetch_gantt_tasks() -> list[object]:
+    """
+    gantt API のタスク一覧レスポンスからタスク配列を取り出す。
+    """
+    url = settings.gantt_api_base_url.rstrip("/") + "/tasks"
+    request = Request(url, headers={"Accept": "application/json"})
+    try:
+        with urlopen(request, timeout=3.0) as response:
+            payload = json.loads(response.read().decode("utf-8"))
+    except (OSError, ValueError) as error:
+        raise HTTPException(status_code=status.HTTP_502_BAD_GATEWAY, detail=f"gantt API からタスクを取得できません: {error}") from error
+    if isinstance(payload, list):
+        return payload
+    if isinstance(payload, dict):
+        for key in ("tasks", "data", "items"):
+            value = payload.get(key)
+            if isinstance(value, list):
+                return value
+    return []
+
+
+def stringify_gantt_task(task: object) -> str:
+    """
+    gantt タスクの任意 JSON を検索しやすい平文へ変換する。
+    hyperlink などのリンク項目は検索・除外語判定に使わない。
+    """
+    if isinstance(task, dict):
+        parts: list[str] = []
+        for key, value in task.items():
+            if key.lower() in GANTT_LINK_FIELD_NAMES:
+                continue
+            if isinstance(value, (dict, list)):
+                parts.append(stringify_gantt_task(value))
+            elif value is not None:
+                parts.append(f"{key}: {value}")
+        return " ".join(parts)
+    if isinstance(task, list):
+        return " ".join(stringify_gantt_task(item) for item in task)
+    return str(task)
+
+
+def extract_gantt_task_id(task: object, *, fallback: int) -> int:
+    """
+    gantt タスクの代表 ID を整数へ寄せ、なければ表示順を使う。
+    """
+    if isinstance(task, dict):
+        for key in ("id", "task_id", "uid"):
+            value = task.get(key)
+            try:
+                return max(1, int(str(value)))
+            except (TypeError, ValueError):
+                continue
+    return fallback
+
+
+def extract_gantt_task_name(task: object, *, fallback: str) -> str:
+    """
+    gantt タスクのタイトル候補を検索結果名として返す。
+    """
+    if isinstance(task, dict):
+        for key in ("text", "title", "name", "label", "content"):
+            value = task.get(key)
+            if isinstance(value, str) and value.strip():
+                return value.strip()
+    return fallback
+
+
+def extract_gantt_task_link(task: object) -> str | None:
+    """
+    gantt タスクに設定された外部リンク候補を取り出す。
+    """
+    if not isinstance(task, dict):
+        return None
+    for key in ("hyperlink", "link", "url", "href", "input_url", "external_url"):
+        value = task.get(key)
+        if isinstance(value, str) and value.strip():
+            return value.strip()
+    return None
+
+
+def open_gantt_task_input(task_id: int) -> None:
+    """
+    gantt アプリの入力画面を、開いているガント画面上で表示する。
+    """
+    url = f"{settings.gantt_api_base_url.rstrip('/')}/tasks/{task_id}/open-input"
+    request = Request(url, data=b"{}", headers={"Content-Type": "application/json"}, method="POST")
+    try:
+        with urlopen(request, timeout=3.0):
+            return
+    except OSError as error:
+        raise HTTPException(status_code=status.HTTP_502_BAD_GATEWAY, detail=f"gantt タスクを開けません: {error}") from error
+
+
+def build_gantt_snippet(task_text: str, terms: list[str]) -> str:
+    """
+    gantt タスク本文の先頭付近を、検索語を mark で強調した短いスニペットにする。
+    """
+    snippet = escape(task_text[:280])
+    for term in terms:
+        if not term:
+            continue
+        snippet = re.sub(re.escape(escape(term)), lambda match: f"<mark>{match.group(0)}</mark>", snippet, flags=re.IGNORECASE)
+    return snippet
diff --git a/backend/app/services/hybrid_search_service.py b/backend/app/services/hybrid_search_service.py
index 4a96d445c32152b0bfe95fb0c024c0e7c4e216b2..9c03c97efdb4e6478e5de2abe367a44d65021946 100644
