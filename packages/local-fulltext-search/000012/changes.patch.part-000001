+def test_try_begin_run_allows_only_one_runner(tmp_path: Path) -> None:
+    """
+    実行中フラグは 1 つの処理だけが取得でき、解放されるまで他の接続からは取得できない。
+    """
+    connection = _create_connection(tmp_path)
+    other_connection = sqlite3.connect(tmp_path / "test_index.db")
+    other_connection.row_factory = sqlite3.Row
+    try:
+        first = IndexService(connection=connection)
+        second = IndexService(connection=other_connection)
+
+        assert first.run_state.try_begin(started_at="2026-01-01T00:00:00+00:00") is True
+        assert second.run_state.try_begin(started_at="2026-01-01T00:00:01+00:00") is False
+        assert second.is_running() is True
+
+        first.run_state.update(is_running=False)
+        assert second.run_state.try_begin(started_at="2026-01-01T00:00:02+00:00") is True
+    finally:
+        other_connection.close()
+
+
+def test_ensure_fresh_target_does_not_clear_running_flag_owned_by_another_run(tmp_path: Path) -> None:
+    """
+    事前確認をすり抜けたあとで別の走査が先に始まっていた場合は 409 を返し、
+    その走査の実行中フラグを解除しない（解除すると同時に 2 本の走査が動いてしまう）。
+    """
+    connection = _create_connection(tmp_path)
+    service = IndexService(connection=connection)
+    target = tmp_path / "docs"
+    target.mkdir()
+    (target / "note.md").write_text("alpha", encoding="utf-8")
+    connection.execute(
+        "UPDATE index_runs SET is_running = 1, last_started_at = '2026-01-01T00:00:00+00:00' WHERE id = 1"
+    )
+    connection.commit()
+
+    # 事前確認（is_running）の直後に他の走査が開始した状況を再現する
+    with patch.object(service.run_state, "is_running", return_value=False):
+        with pytest.raises(HTTPException) as error:
+            service.ensure_fresh_target(full_path=str(target), refresh_window_minutes=0, index_depth=5)
+
+    assert error.value.status_code == 409
+    row = connection.execute("SELECT is_running, last_started_at, last_error FROM index_runs WHERE id = 1").fetchone()
+    assert row["is_running"] == 1
+    assert row["last_started_at"] == "2026-01-01T00:00:00+00:00"
+    assert row["last_error"] is None
+    assert connection.execute("SELECT COUNT(*) FROM files").fetchone()[0] == 0
+
+
+def _index_with_failing_file(service: IndexService, target: Path, failing_file: Path, **kwargs: object) -> list[Path]:
+    """failing_file の抽出だけを失敗させて走査し、抽出を試みたファイルの一覧を返す。"""
+    original_extract_text = local_target_indexer.extract_text
+    attempted: list[Path] = []
+
+    def fake_extract_text(path: Path, *args, **extract_kwargs) -> str:
+        attempted.append(path)
+        if path == failing_file:
+            raise OSError("simulated read failure")
+        return original_extract_text(path)
+
+    with patch("app.services.local_target_indexer.extract_text", side_effect=fake_extract_text):
+        service.ensure_fresh_target(full_path=str(target), refresh_window_minutes=0, **kwargs)
+    return attempted
+
+
+def _prepare_target_with_failing_file(tmp_path: Path) -> tuple[sqlite3.Connection, IndexService, Path, Path]:
+    connection = _create_connection(tmp_path)
+    service = IndexService(connection=connection)
+    target = tmp_path / "docs"
+    target.mkdir()
+    (target / "ok.md").write_text("searchable content", encoding="utf-8")
+    failing_file = target / "ng.md"
+    failing_file.write_text("broken content", encoding="utf-8")
+    return connection, service, target, failing_file
+
+
+def test_unchanged_failed_file_is_not_extracted_again_on_next_scan(tmp_path: Path) -> None:
+    """
+    抽出に失敗してから更新されていないファイルは、次の走査で再抽出しない。
+    失敗の記録とエラー件数は保持する。
+    """
+    connection, service, target, failing_file = _prepare_target_with_failing_file(tmp_path)
+
+    first_attempts = _index_with_failing_file(service, target, failing_file)
+    second_attempts = _index_with_failing_file(service, target, failing_file)
+
+    assert failing_file in first_attempts
+    assert second_attempts == []
+    failed_rows = connection.execute("SELECT file_name FROM failed_files").fetchall()
+    assert [row["file_name"] for row in failed_rows] == ["ng.md"]
+    assert service.get_status().error_count == 1
+    assert [row["file_name"] for row in connection.execute("SELECT file_name FROM files")] == ["ok.md"]
+
+
+def test_failed_file_is_extracted_again_after_it_is_modified(tmp_path: Path) -> None:
+    """
+    失敗後に更新されたファイルは、次の走査で再抽出する。成功すれば失敗の記録は消える。
+    """
+    import os
+    import time
+
+    connection, service, target, failing_file = _prepare_target_with_failing_file(tmp_path)
+    _index_with_failing_file(service, target, failing_file)
+
+    failing_file.write_text("fixed content", encoding="utf-8")
+    future_time = time.time() + 5
+    os.utime(failing_file, (future_time, future_time))
+    service.ensure_fresh_target(full_path=str(target), refresh_window_minutes=0)
+
+    assert connection.execute("SELECT COUNT(*) FROM failed_files").fetchone()[0] == 0
+    assert sorted(row["file_name"] for row in connection.execute("SELECT file_name FROM files")) == ["ng.md", "ok.md"]
+
+
+def test_failed_file_is_extracted_again_after_retry_interval(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    """
+    更新されていない失敗ファイルも、再試行間隔が過ぎたら次の走査で再抽出する（一時的な失敗からの自動回復）。
+    """
+    connection, service, target, failing_file = _prepare_target_with_failing_file(tmp_path)
+    _index_with_failing_file(service, target, failing_file)
+
+    monkeypatch.setattr("app.services.local_target_indexer.FAILED_FILE_RETRY_INTERVAL_SECONDS", 0)
+    attempts = _index_with_failing_file(service, target, failing_file)
+
+    assert attempts == [failing_file]
+
+
+def test_manual_reindex_always_retries_failed_files(tmp_path: Path) -> None:
+    """
+    画面からの再インデックス（reindex_search_targets）は、再試行間隔に関係なく失敗ファイルを再抽出する。
+    """
+    connection, service, target, failing_file = _prepare_target_with_failing_file(tmp_path)
+    service.add_search_target(folder_path=str(target), index_depth=5)
+    _index_with_failing_file(service, target, failing_file, index_depth=5)
+
+    service.reindex_search_targets([str(target)])
+
+    assert connection.execute("SELECT COUNT(*) FROM failed_files").fetchone()[0] == 0
+    assert sorted(row["file_name"] for row in connection.execute("SELECT file_name FROM files")) == ["ng.md", "ok.md"]
+
+
+def test_file_deleted_during_scan_is_skipped_without_aborting(tmp_path: Path, monkeypatch) -> None:
+    """
+    走査で見つけた直後に削除されたファイル（一時ファイルなど）があっても、走査全体は失敗しない。
+    """
+    connection = _create_connection(tmp_path)
+    service = IndexService(connection=connection)
+    target = tmp_path / "docs"
+    target.mkdir()
+    (target / "ok.md").write_text("searchable content", encoding="utf-8")
+    vanished = target / "vanished.md"
+    original_walk_files = local_target_indexer.walk_indexable_files
+
+    def walk_with_vanished_file(*args, **kwargs):
+        yield from original_walk_files(*args, **kwargs)
+        yield vanished
+
+    monkeypatch.setattr(local_target_indexer, "walk_indexable_files", walk_with_vanished_file)
+    service.ensure_fresh_target(full_path=str(target), refresh_window_minutes=0)
+
+    assert [row["file_name"] for row in connection.execute("SELECT file_name FROM files")] == ["ok.md"]
+    assert service.get_status().last_error is None
+
+
+def test_vector_sync_runs_after_the_fulltext_run_is_finished(tmp_path: Path, monkeypatch) -> None:
+    """
+    ベクトル同期は「インデックス実行中」を解除してから行う（Embedding が長くても再インデックス要求を拒否しない）。
+    全文インデックスと同じ階層数・除外キーワードを渡す。
+    """
+    from app.vector.state import vector_state
+
+    connection = _create_connection(tmp_path)
+    folder = tmp_path / "vector_after_run"
+    folder.mkdir()
+    (folder / "file.txt").write_text("vector sync test", encoding="utf-8")
+    service = IndexService(connection=connection, enable_vector_sync=True)
+    calls: list[dict[str, object]] = []
+
+    def fake_sync(target_folders, **kwargs):
+        calls.append({"folders": target_folders, "is_running": service.is_running(), **kwargs})
+
+    monkeypatch.setattr(vector_state, "sync_index", fake_sync)
+
+    service.ensure_fresh_target(
+        full_path=str(folder), refresh_window_minutes=0, index_depth=2, exclude_keywords="backup"
+    )
+
+    assert len(calls) == 1
+    assert calls[0]["is_running"] is False
+    assert calls[0]["folders"] == [folder.resolve().as_posix()]
+    assert calls[0]["folder_depths"] == {folder.resolve().as_posix(): 2}
+    assert "backup" in str(calls[0]["exclude_keywords"])
