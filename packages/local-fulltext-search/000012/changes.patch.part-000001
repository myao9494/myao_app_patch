diff --git a/frontend/src/apiClientSearch.test.ts b/frontend/src/apiClientSearch.test.ts
index 55de2748cf9496ada0a1a9a3116f93315ef34086..9a19274d172dc412525f6fd85756910fe9f16b0d 100644
--- a/frontend/src/apiClientSearch.test.ts
+++ b/frontend/src/apiClientSearch.test.ts
@@ -183,3 +183,37 @@ test("fetchSearchPage は 50 件とスニペット有無をそのまま API へ
     globalThis.fetch = originalFetch;
   }
 });
+
+/**
+ * 検索方式（ハイブリッド / ベクトル / 通常）は、指定された値をそのまま API へ渡す。
+ */
+test("search は search_type をそのまま API へ渡す", async () => {
+  const originalFetch = globalThis.fetch;
+  let requestedBody: { search_type?: string } | null = null;
+
+  globalThis.fetch = (async (_url: string | URL | Request, init?: RequestInit) => {
+    requestedBody = JSON.parse(String(init?.body ?? "{}"));
+    return new Response(
+      JSON.stringify({
+        total: 0,
+        items: [],
+        has_more: false,
+        next_offset: null,
+        used_existing_index: false,
+        background_refresh_scheduled: false,
+        search_type: "hybrid",
+      }),
+      { status: 200 },
+    );
+  }) as typeof fetch;
+
+  try {
+    for (const searchType of ["hybrid", "vector", "keyword"] as const) {
+      await search({ q: "テスト", full_path: "/docs", refresh_window_minutes: 0, search_type: searchType });
+      assert.equal((requestedBody as { search_type?: string } | null)?.search_type, searchType);
+    }
+  } finally {
+    globalThis.fetch = originalFetch;
+  }
+});
+
diff --git a/frontend/src/appDefaults.ts b/frontend/src/appDefaults.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8b38034597c0e7f6b1c376e2e66b212d5bebf753
--- /dev/null
+++ b/frontend/src/appDefaults.ts
@@ -0,0 +1,26 @@
+/**
+ * 設定を読み込む前に画面へ表示する既定値。
+ * 保存済みの設定を読み込めたら、その値で置き換える。
+ */
+export const DEFAULT_EXCLUDE_KEYWORDS = [
+  "node_modules",
+  ".git",
+  "old",
+  "旧",
+  "__pycache__",
+  ".pytest_cache",
+  ".mypy_cache",
+  ".ruff_cache",
+  ".tox",
+  ".venv",
+  "venv",
+  "env",
+  "dist",
+  "build",
+  "coverage",
+  ".next",
+  ".turbo",
+  ".parcel-cache",
+].join("\n");
+export const DEFAULT_SYNONYM_GROUPS = "";
+export const DEFAULT_SEARCH_FILTER_TEXT = "";
diff --git a/frontend/src/appInteraction.test.ts b/frontend/src/appInteraction.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a5ebd7ae3785188247ce564742188a255c3f638d
--- /dev/null
+++ b/frontend/src/appInteraction.test.ts
@@ -0,0 +1,126 @@
+/**
+ * アプリ全体を DOM へ描画し、起動時の読み込みとページの切り替えを検証するテスト。
+ * 各画面の操作は、画面ごとの *Interaction.test.ts で検証する。
+ */
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { searchResponse, searchResult } from "./testing/apiFixtures.ts";
+import { withApp } from "./testing/appHarness.ts";
+import { findBySelector, findByText, hasElement, httpError, normalizeText, queryAllByText, typeInto } from "./testing/dom.ts";
+import { closeRenderer } from "./testing/render.ts";
+
+test.after(() => closeRenderer());
+
+const pageRoutes = {
+  "GET /api/vector/model/status": httpError(503, "unavailable"),
+  "GET /api/export/config": { export_folder: "", default_select_count: 10 },
+};
+
+test("起動時に設定・状態・検索対象を読み込み、エラーを出さない", async () => {
+  await withApp({}, async (app) => {
+    for (const route of [
+      "GET /api/index/settings",
+      "GET /api/index/status",
+      "GET /api/index/scheduler",
+      "GET /api/launcher/status",
+      "GET /api/index/search-targets",
+    ]) {
+      assert.ok(app.api.requestsTo(route).length >= 1, `${route} を呼ぶ`);
+    }
+    assert.equal(app.error(), "");
+  });
+});
+
+test("上部のタブで、すべてのページへ切り替えられる", async () => {
+  const pages: Array<[string, RegExp]> = [
+    ["インデックス済みフォルダ", /インデックス済みフォルダ/],
+    ["インデックス済みWebページ", /インデックス済みWebページ/],
+    ["検索対象フォルダ", /検索対象フォルダを有効\/無効で管理/],
+    ["検索ルール管理", /除外キーワード/],
+    ["ベクトル管理", /Embedding|ベクトル/],
+    ["AIインプット", /AI/],
+    ["ランチャー", /ランチャー/],
+    ["検索", /Search Results/],
+  ];
+  await withApp({ routes: pageRoutes }, async (app) => {
+    for (const [tabName, heading] of pages) {
+      await app.openPage(tabName);
+
+      const activeTabs = queryAllByText(app.container, "button.page-tab.active", "");
+      assert.deepEqual(activeTabs.map((tab) => normalizeText(tab.textContent)), [tabName]);
+      assert.match(app.pageText(), heading, `${tabName} の画面を表示する`);
+      assert.equal(app.error(), "", `${tabName} でエラーを出さない`);
+    }
+  });
+});
+
+test("管理ページを開くたびに、そのページの最新の一覧・状態を読み込む", async () => {
+  await withApp({ routes: pageRoutes }, async (app) => {
+    const count = (route: string): number => app.api.requestsTo(route).length;
+    const before = {
+      targets: count("GET /api/index/targets"),
+      searchTargets: count("GET /api/index/search-targets"),
+      launcher: count("GET /api/launcher/status"),
+    };
+
+    await app.openPage("インデックス済みフォルダ");
+    assert.equal(count("GET /api/index/targets"), before.targets + 1);
+    await app.openPage("検索対象フォルダ");
+    assert.equal(count("GET /api/index/search-targets"), before.searchTargets + 1);
+    await app.openPage("ランチャー");
+    assert.equal(count("GET /api/launcher/status"), before.launcher + 1);
+  });
+});
+
+test("ページを切り替えて戻っても、検索語・絞り込み・検索結果を保つ", async () => {
+  await withApp(
+    { routes: { ...pageRoutes, "POST /api/search": searchResponse([searchResult({ file_name: "alpha.md" })]) } },
+    async (app) => {
+      await typeInto(findBySelector<HTMLInputElement>(app.container, "input.path-input"), "/docs");
+      await app.runSearch("alpha");
+      await app.openPage("検索ルール管理");
+      assert.equal(hasElement(app.container, "article.result-card"), false);
+
+      await app.openPage("検索");
+
+      assert.equal(findBySelector<HTMLInputElement>(app.container, "input.search-input").value, "alpha");
+      assert.equal(findBySelector<HTMLInputElement>(app.container, "input.path-input").value, "/docs");
+      assert.equal(queryAllByText(app.container, "article.result-card", "alpha.md").length, 1);
+      assert.equal(app.api.requestsTo("POST /api/search").length, 1, "戻っただけでは再検索しない");
+    },
+  );
+});
+
+test("ページを切り替えると、前のページのエラー・通知を消す", async () => {
+  await withApp({ routes: { ...pageRoutes, "POST /api/search": httpError(500, "検索に失敗しました") } }, async (app) => {
+    await app.runSearch("alpha");
+    assert.match(app.error(), /検索に失敗しました/);
+
+    await app.openPage("検索ルール管理");
+
+    assert.equal(app.error(), "");
+  });
+});
+
+test("AIインプットへ切り替えると、直前の検索結果を候補として引き継ぐ", async () => {
+  await withApp(
+    {
+      routes: {
+        ...pageRoutes,
+        "POST /api/search": searchResponse([
+          searchResult({ file_id: 1, file_name: "alpha.md", full_path: "/docs/alpha.md" }),
+          searchResult({ file_id: 2, file_name: "beta.md", full_path: "/docs/beta.md" }),
+        ]),
+      },
+    },
+    async (app) => {
+      await app.runSearch("alpha");
+      await app.openPage("AIインプット");
+
+      assert.match(app.pageText(), /alpha\.md/);
+      assert.match(app.pageText(), /beta\.md/);
+      assert.equal(findByText(app.container, "button.page-tab.active", "AIインプット") !== null, true);
+    },
+  );
+});
diff --git a/frontend/src/appRender.test.ts b/frontend/src/appRender.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..180ba6360372dba9ebdc358e1f3d0765bf99284e
--- /dev/null
+++ b/frontend/src/appRender.test.ts
@@ -0,0 +1,67 @@
+/**
+ * アプリ全体を描画して、初期表示を検証するテスト。
+ * ブラウザーを使わないサーバー描画のため、検証できるのは最初に表示される内容だけ（操作や通信は行わない）。
+ */
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { closeRenderer, installBrowserStubs, loadSourceModule, renderToHtml, visibleText } from "./testing/render.ts";
+
+type AppModule = typeof import("./App.tsx");
+
+test.after(() => closeRenderer());
+
+async function renderApp(options: Parameters<typeof installBrowserStubs>[0] = {}): Promise<string> {
+  installBrowserStubs(options);
+  const { default: App } = await loadSourceModule<AppModule>("/src/App.tsx");
+  return renderToHtml(App, {});
+}
+
+test("初期表示は検索画面で、すべてのページへのタブが並ぶ", async () => {
+  const html = await renderApp();
+  const text = visibleText(html);
+
+  for (const tab of [
+    "検索",
+    "インデックス済みフォルダ",
+    "インデックス済みWebページ",
+    "検索対象フォルダ",
+    "検索ルール管理",
+    "ベクトル管理",
+    "AIインプット",
+    "ランチャー",
+  ]) {
+    assert.match(html, new RegExp(`class="[^"]*\\bpage-tab\\b[^"]*"[^>]*>${tab}<`), `タブ「${tab}」が表示される`);
+  }
+  assert.match(html, /class="[^"]*\bpage-tab active"[^>]*>検索</, "検索タブが選択中になる");
+  assert.match(text, /Search Results 0 \/ 0件/);
+  assert.match(text, /一致する結果はありません。/);
+  assert.doesNotMatch(html, /class="error-banner"/);
+  assert.doesNotMatch(html, /class="notice-banner"/);
+});
+
+test("設定ドロワーは閉じた状態で描画され、各設定の入力欄を持つ", async () => {
+  const html = await renderApp();
+
+  assert.match(html, /<aside class="settings-drawer " aria-hidden="true">/);
+  for (const id of ["web-fetch-mode", "gantt-parent"]) {
+    assert.match(html, new RegExp(`id="${id}"`));
+  }
+  assert.match(visibleText(html), /状態: インデックス待機中/);
+});
+
+test("起動 URL の検索条件が検索欄へ反映される", async () => {
+  const html = await renderApp({ search: "?q=alpha+beta&full_path=%2Ftmp%2Fdocs&index_depth=2" });
+
+  assert.match(html, /value="alpha beta"/);
+  assert.match(html, /value="\/tmp\/docs"/);
+  assert.match(html, /value="2"/);
+});
+
+test("検索方式の既定はハイブリッドで、保存済みの選択があればそれを使う", async () => {
+  const selectedSearchType = (html: string): string | undefined =>
+    html.match(/<button[^>]*search-type-button[^>]*aria-pressed="true"[^>]*>([^<]*)<\/button>/)?.[1];
+
+  assert.match(selectedSearchType(await renderApp()) ?? "", /ハイブリッド/);
+  assert.match(selectedSearchType(await renderApp({ storage: { search_type: "keyword" } })) ?? "", /通常/);
+});
