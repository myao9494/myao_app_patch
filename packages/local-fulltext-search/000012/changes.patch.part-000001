diff --git a/backend/tests/test_hybrid_search_service.py b/backend/tests/test_hybrid_search_service.py
index f435a7245aab8b6b30a133c1b0dac2fe9f8767b0..62669d33d30409b172682702bd34a15fd2e05ac7 100644
--- a/backend/tests/test_hybrid_search_service.py
+++ b/backend/tests/test_hybrid_search_service.py
@@ -112,3 +112,25 @@ def test_reciprocal_rank_fusion_single_source_rank1_normalized_to_half() -> None
         assert item.hybrid_score == pytest.approx(0.5, rel=1e-3)
 
 
+
+
+def test_normalize_path_key_treats_windows_separators_as_equal() -> None:
+    """Windows の絶対パスは、実行 OS に関係なく区切り文字と大文字小文字の違いを同一視する。"""
+    assert normalize_path_key("C:\\Work\\Docs\\Report.md") == normalize_path_key("C:/work/docs/report.md")
+    assert normalize_path_key("\\\\server\\share\\a.md") == normalize_path_key("//server/share/a.md")
+    assert normalize_path_key("/Users/me/Note.md") == "/users/me/note.md"
+    assert normalize_path_key("") == ""
+
+
+def test_reciprocal_rank_fusion_merges_windows_paths_with_different_separators() -> None:
+    """ベクトルDB（\\ 区切り）と全文検索DB（/ 区切り）の同一ファイルを「両方一致」として融合する。"""
+    vector_items = [
+        SearchResultItem(document_id=9, path="C:\\work\\a.md", title="a", score=0.9, full_path="C:\\work\\a.md"),
+    ]
+    keyword_items = [{"full_path": "C:/work/a.md", "file_name": "a.md", "snippet": "kw"}]
+
+    fused = reciprocal_rank_fusion(vector_items=vector_items, keyword_items=keyword_items)
+
+    assert len(fused) == 1
+    assert fused[0].match_type == "both"
+    assert fused[0].hybrid_score == 1.0
