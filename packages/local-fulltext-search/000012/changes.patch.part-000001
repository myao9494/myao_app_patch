     assert stats["total_documents"] == 1
     assert "architecture" in html_content
     assert "data:image/" in html_content
+
+
+def test_compressed_excalidraw_with_emoji_text_can_be_rendered_as_svg() -> None:
+    """
+    圧縮された図面データに絵文字（UTF-16 では 2 つの符号単位になる文字）が含まれていても、SVG にして埋め込める。
+    展開した文字列に対になっていないサロゲートが残ると、UTF-8 へ変換できず図面ごと表示されなくなる。
+    """
+    import json
+
+    import lzstring
+
+    from app.vector.image_data_url import svg_text_to_base64_data_url
+
+    drawing = {
+        "type": "excalidraw",
+        "elements": [
+            {
+                "id": "t1",
+                "type": "text",
+                "x": 10,
+                "y": 10,
+                "width": 200,
+                "height": 30,
+                "text": "進捗 🚀 メモ",
+                "fontSize": 20,
+            }
+        ],
+        "files": {},
+    }
+    # Obsidian のプラグイン（JavaScript）は UTF-16 の符号単位の並びとして圧縮するので、同じ形の文字列を作って圧縮する
+    encoded = json.dumps(drawing, ensure_ascii=False).encode("utf-16-le")
+    utf16_units = "".join(chr(int.from_bytes(encoded[index : index + 2], "little")) for index in range(0, len(encoded), 2))
+    compressed = lzstring.LZString().compressToBase64(utf16_units)
+    note = f"# Excalidraw Data\n\n## Drawing\n```compressed-json\n{compressed}\n```\n"
+
+    data = extract_excalidraw_data(note)
+    assert data is not None
+    assert data["elements"][0]["text"] == "進捗 🚀 メモ"
+
+    data_url = svg_text_to_base64_data_url(excalidraw_to_svg(data))
+
+    assert data_url.startswith("data:image/svg+xml;base64,")
