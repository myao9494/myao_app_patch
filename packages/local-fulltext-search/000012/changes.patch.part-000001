+
+test("検索対象フォルダは、確認のうえ登録だけを外せる（インデックスは消さない）", async () => {
+  let targets = searchTargets;
+  await withApp(
+    {
+      routes: targetRoutes({
+        "GET /api/index/search-targets": () => ({ items: targets }),
+        "DELETE /api/index/search-targets": (request) => {
+          const paths = (request.body as { folder_paths: string[] }).folder_paths;
+          targets = targets.filter((item) => !paths.includes(item.full_path));
+          return { deleted_count: paths.length };
+        },
+      }),
+      page: "検索対象フォルダ",
+    },
+    async (app) => {
+      await click(findByText(row(app.container, "/work/notes"), "button", "削除"));
+
+      assert.match(last(app.dom.dialogs) ?? "", /検索対象フォルダから削除しますか/);
+      assert.deepEqual(app.lastBody("DELETE /api/index/search-targets"), { folder_paths: ["/work/notes"] });
+      assert.equal(app.api.requestsTo("DELETE /api/index/targets").length, 0);
+      assert.deepEqual(listedPaths(app.container), ["/docs"]);
+      assert.match(app.notice(), /1件の検索対象フォルダを削除しました/);
+    },
+  );
+});
+
+test("行のボタンで、そのフォルダのインデックス削除と再取得を実行できる", async () => {
+  await withApp(
+    {
+      routes: targetRoutes({
+        "DELETE /api/index/targets": { deleted_count: 1 },
+        "POST /api/index/search-targets/reindex": { reindexed_count: 1 },
+      }),
+      page: "検索対象フォルダ",
+    },
+    async (app) => {
+      await click(findByText(row(app.container, "/docs"), "button", "インデックス削除"));
+      assert.deepEqual(app.lastBody("DELETE /api/index/targets"), { target_paths: ["/docs"] });
+      assert.match(app.notice(), /1件のインデックスを削除しました/);
+
+      await click(findByText(row(app.container, "/docs"), "button", "インデックス再取得"));
+      assert.deepEqual(app.lastBody("POST /api/index/search-targets/reindex"), { folder_paths: ["/docs"] });
+      assert.match(app.notice(), /1件のインデックスを再取得しました/);
+    },
+  );
+});
+
+test("インデックス取得ボタンは、有効な検索対象だけをまとめて取得する", async () => {
+  await withApp(
+    { routes: targetRoutes({ "POST /api/index/search-targets/reindex": { reindexed_count: 1 } }), page: "検索対象フォルダ" },
+    async (app) => {
+      await click(findByText(app.container, "button.indexed-targets-primary-action", "インデックス取得"));
+
+      assert.deepEqual(app.lastBody("POST /api/index/search-targets/reindex"), { folder_paths: ["/docs"] });
+      assert.match(app.notice(), /1件の検索対象フォルダをインデックス取得しました/);
+    },
+  );
+});
+
+test("検索欄のフォルダを検索対象へ追加すると、全データベース検索を解除してそのフォルダを対象にする", async () => {
+  let registered = searchTargets;
+  await withApp(
+    {
+      routes: targetRoutes({
+        "GET /api/index/search-targets": () => ({ items: registered }),
+        "POST /api/index/search-targets": (request) => {
+          registered = [...registered, { ...searchTargets[0], full_path: (request.body as { folder_path: string }).folder_path }];
+          return { items: registered };
+        },
+      }),
+    },
+    async (app) => {
+      await click(findBySelector(app.container, "button.search-all-button"));
+      const pathInput = findBySelector<HTMLInputElement>(app.container, "input.path-input");
+      await typeInto(pathInput, "/other");
+      await wait(260);
+      const addButton = queryAllByText(app.container, "button", "検索対象").find((button) => !button.classList.contains("page-tab"));
+      assert.ok(addButton);
+
+      await click(addButton);
+
+      // 階層の欄が空（無制限）なら、無制限として登録する
+      assert.deepEqual(app.lastBody("POST /api/index/search-targets"), { folder_path: "/other", index_depth: null });
+      assert.equal(findBySelector(app.container, "button.search-all-button").getAttribute("aria-pressed"), "false");
+
+      await app.openPage("検索対象フォルダ");
+      assert.deepEqual(listedPaths(app.container), ["/docs", "/work/notes", "/other"]);
+    },
+  );
+});
diff --git a/frontend/src/testing/apiFixtures.ts b/frontend/src/testing/apiFixtures.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8e7a4665e6e3836f02c184ebde9108f893d951d4
--- /dev/null
+++ b/frontend/src/testing/apiFixtures.ts
@@ -0,0 +1,123 @@
+/**
+ * 画面の操作テストで使う、バックエンド API の応答のひな形。
+ * installAppApi は、アプリが起動時に呼ぶ API へ既定の応答を返す fetch の代用品を設定する。
+ * テストごとに、確かめたい経路の応答だけを差し替える。
+ */
+import type {
+  AppSettings,
+  IndexStatus,
+  LauncherStatus,
+  SchedulerSettings,
+  SearchResponse,
+  SearchResult,
+} from "../types.ts";
+import { installFetchStub, type FetchStub } from "./dom.ts";
+
+export function appSettings(overrides: Partial<AppSettings> = {}): AppSettings {
+  return {
+    exclude_keywords: ".git\nnode_modules",
+    web_exclude_keywords: "",
+    web_fetch_mode: "http",
+    hidden_indexed_targets: "",
+    synonym_groups: "",
+    obsidian_sidebar_explorer_data_path: "",
+    gantt_parent: 0,
+    launcher_hotkey: "command_option",
+    index_selected_extensions: ".md\n.txt\n.pdf",
+    custom_content_extensions: "",
+    custom_filename_extensions: "",
+    confirm_index_deletion: true,
+    ...overrides,
+  };
+}
+
+export function indexStatus(overrides: Partial<IndexStatus> = {}): IndexStatus {
+  return {
+    last_started_at: null,
+    last_finished_at: null,
+    total_files: 0,
+    error_count: 0,
+    is_running: false,
+    cancel_requested: false,
+    last_error: null,
+    ...overrides,
+  };
+}
+
+export function schedulerSettings(overrides: Partial<SchedulerSettings> = {}): SchedulerSettings {
+  return {
+    paths: [],
+    start_at: null,
+    is_enabled: false,
+    status: "idle",
+    last_started_at: null,
+    last_finished_at: null,
+    current_path: null,
+    last_error: null,
+    logs: [],
+    ...overrides,
+  };
+}
+
+export function launcherStatus(overrides: Partial<LauncherStatus> = {}): LauncherStatus {
+  return {
+    status: "stopped",
+    is_running: false,
+    pid: null,
+    returncode: null,
+    autostart: false,
+    log_path: "/tmp/launcher.log",
+    logs: [],
+    ...overrides,
+  };
+}
+
+export function searchResult(overrides: Partial<SearchResult> = {}): SearchResult {
+  return {
+    file_id: 1,
+    result_kind: "file",
+    source_type: "local",
+    target_path: "/docs",
+    file_name: "note.md",
+    full_path: "/docs/note.md",
+    file_ext: ".md",
+    created_at: "2026-01-01T00:00:00Z",
+    mtime: "2026-01-02T00:00:00Z",
+    click_count: 0,
+    snippet: "本文の抜粋",
+    ...overrides,
+  } as SearchResult;
+}
+
+export function searchResponse(items: SearchResult[], overrides: Partial<SearchResponse> = {}): SearchResponse {
+  return {
+    total: items.length,
+    items,
+    has_more: false,
+    next_offset: null,
+    used_existing_index: false,
+    background_refresh_scheduled: false,
+    search_type: "hybrid",
+    ...overrides,
+  };
+}
+
+/** アプリが起動時に呼ぶ API へ既定の応答を返す。routes で経路ごとに差し替えられる。 */
+export function installAppApi(routes: Parameters<typeof installFetchStub>[0] = {}): FetchStub {
+  return installFetchStub({
+    "GET /api/index/settings": appSettings(),
+    "GET /api/index/status": indexStatus(),
+    "GET /api/index/scheduler": schedulerSettings(),
+    "GET /api/launcher/status": launcherStatus(),
+    "GET /api/index/search-targets": { items: [] },
+    "GET /api/index/targets": { items: [] },
+    "GET /api/index/failed-files": { items: [] },
+    "GET /api/index/search-targets/coverage": {
+      normalized_path: "",
+      source_type: "local",
+      is_covered: false,
+      covering_path: null,
+    },
+    ...routes,
+  });
+}
diff --git a/frontend/src/testing/appHarness.ts b/frontend/src/testing/appHarness.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1da3be871c9fc5c456525b22e4287c5d732b17f4
--- /dev/null
+++ b/frontend/src/testing/appHarness.ts
@@ -0,0 +1,87 @@
+/**
+ * アプリ全体を DOM へ描画して操作するテストの共通の準備。
+ * 起動時の API へ既定の応答を返し、ページの切り替えや通知の読み取りなど、よく使う操作をまとめる。
+ */
+import { installAppApi } from "./apiFixtures.ts";
+import {
+  click,
+  findBySelector,
+  findByText,
+  hasElement,
+  installAppStyles,
+  installDom,
+  last,
+  mount,
+  normalizeText,
+  typeInto,
+} from "./dom.ts";
+import { loadSourceModule } from "./render.ts";
+
+type AppModule = typeof import("../App.tsx");
+export type Routes = NonNullable<Parameters<typeof installAppApi>[0]>;
+
+export type OpenAppOptions = {
+  /** 起動 URL のクエリ文字列（例: "?q=alpha"） */
+  search?: string;
+  /** 保存済みの localStorage の値 */
+  storage?: Record<string, string>;
+  /** 差し替える API の応答 */
+  routes?: Routes;
+  /** 開いた直後に切り替えるページ（上部タブの表示名） */
+  page?: string;
+  /** アプリのスタイルシートを読み込む（適用されるスタイルを確かめるテスト用） */
+  withStyles?: boolean;
+};
+
+export async function openApp(options: OpenAppOptions = {}) {
+  const dom = installDom({ search: options.search, storage: options.storage });
+  const api = installAppApi(options.routes);
+  if (options.withStyles) {
+    await installAppStyles();
+  }
+  const { default: App } = await loadSourceModule<AppModule>("/src/App.tsx");
+  const view = await mount(App, {});
+  const container = view.container;
+  const app = {
+    api,
+    dom,
+    container,
+    /** 画面全体の文字（要素の間に空白は入らない） */
+    text: () => normalizeText(container.textContent),
+    /** ページ本体（設定ドロワーを除く）の文字 */
+    pageText: () => normalizeText(findBySelector(container, "main.content-grid > :first-child").parentElement?.firstElementChild?.textContent),
+    notice: () => normalizeText(container.querySelector(".notice-banner")?.textContent),
+    error: () => normalizeText(container.querySelector(".error-banner")?.textContent),
+    openPage: async (tabName: string) => {
+      await click(findByText(container, "button.page-tab", tabName));
+    },
+    isDrawerOpen: () => hasElement(container, "aside.settings-drawer.open"),
+    drawer: () => findBySelector(container, "aside.settings-drawer"),
+    runSearch: async (query = "alpha") => {
+      await typeInto(findBySelector<HTMLInputElement>(container, "input.search-input"), query);
+      await click(findBySelector(container, ".search-nav .primary-button"));
+    },
+    lastBody: (route: string) => last(api.requestsTo(route))?.body as Record<string, unknown>,
+    close: async () => {
+      await view.unmount();
+      api.restore();
+      dom.close();
+    },
+  };
+  if (options.page) {
+    await app.openPage(options.page);
+  }
+  return app;
+}
+
+export type AppHarness = Awaited<ReturnType<typeof openApp>>;
+
+/** アプリを開いてテスト本体を実行し、成功・失敗にかかわらず後始末をする。 */
+export async function withApp(options: OpenAppOptions, body: (app: AppHarness) => Promise<void>): Promise<void> {
+  const app = await openApp(options);
+  try {
+    await body(app);
+  } finally {
+    await app.close();
+  }
+}
diff --git a/frontend/src/testing/dom.ts b/frontend/src/testing/dom.ts
new file mode 100644
index 0000000000000000000000000000000000000000..777fbbb87dfb242749a51065c3a84f389233d568
--- /dev/null
+++ b/frontend/src/testing/dom.ts
@@ -0,0 +1,513 @@
+/**
+ * 画面を DOM（jsdom）へ描画し、クリックや入力のあとの動きまで検証するためのテスト補助。
+ *
+ * render.ts のサーバー描画は初回の表示しか確かめられない。こちらは React を実際に動かすので、
+ * useEffect・状態の更新・API 呼び出し（fetch の代用品で記録する）まで検証できる。
+ *
+ * 使い方:
+ *   const dom = installDom({ search: "?q=abc" });
+ *   const api = installFetchStub({ "GET /api/index/status": { is_running: false } });
+ *   const { App } = await loadSourceModule("/src/App.tsx");
+ *   const view = await mount(App, {});
+ *   await click(findByText(view.container, "button", "検索"));
+ *   await view.unmount(); dom.close();
+ */
+import { createElement, type ComponentType } from "react";
+import { JSDOM } from "jsdom";
+
+type DomHandle = {
+  window: JSDOM["window"];
+  /** window.confirm / alert / prompt に渡された文言 */
+  dialogs: string[];
+  /** 次の confirm の答え（既定は true） */
+  setConfirmAnswer(answer: boolean): void;
+  /** window.open で開こうとした URL */
+  openedUrls: string[];
+  /** クリップボードへ書き込まれた文字列 */
+  clipboardWrites: string[];
+  /** クリップボードへの書き込みを失敗させる（権限が無い環境の再現） */
+  denyClipboard(): void;
+  /** ダウンロード用に作られた Blob の内容（URL.createObjectURL に渡されたもの） */
+  downloads: Blob[];
+  /** 監視中の要素が画面に入ったことにする（一覧の末尾での追加読み込みなど） */
+  triggerIntersection(): Promise<void>;
+  /** 要素の描画サイズを偽装する（jsdom はレイアウトを計算しないため、はみ出しの判定に使う） */
+  setElementSize(size: { scrollHeight: number; clientHeight: number }): void;
+  close(): void;
+};
+
+const GLOBAL_NAMES = [
+  "window",
+  "document",
+  "navigator",
+  "localStorage",
+  "sessionStorage",
+  "HTMLElement",
+  "HTMLInputElement",
+  "HTMLTextAreaElement",
+  "HTMLSelectElement",
+  "Element",
+  "Node",
+  "Event",
+  "MouseEvent",
+  "KeyboardEvent",
+  "CustomEvent",
+  "MutationObserver",
+  "getComputedStyle",
+  "requestAnimationFrame",
+  "cancelAnimationFrame",
+] as const;
+
+/** jsdom のウィンドウを作り、React が参照するグローバルへ設定する。 */
+export function installDom(options: { search?: string; storage?: Record<string, string> } = {}): DomHandle {
+  const dom = new JSDOM("<!doctype html><html><body><div id=\"root\"></div></body></html>", {
+    url: `http://127.0.0.1:8079/${options.search ?? ""}`,
+    pretendToBeVisual: true,
+  });
+  const globals = globalThis as Record<string, unknown>;
+  const previous = new Map<string, PropertyDescriptor | undefined>();
+  for (const name of GLOBAL_NAMES) {
+    previous.set(name, Object.getOwnPropertyDescriptor(globalThis, name));
+    Object.defineProperty(globalThis, name, {
+      value: (dom.window as unknown as Record<string, unknown>)[name],
+      configurable: true,
+      writable: true,
+    });
+  }
+  globals.IS_REACT_ACT_ENVIRONMENT = true;
+  for (const [key, value] of Object.entries(options.storage ?? {})) {
+    dom.window.localStorage.setItem(key, value);
+  }
+
+  const dialogs: string[] = [];
+  let confirmAnswer = true;
+  dom.window.confirm = (message?: string) => {
+    dialogs.push(String(message ?? ""));
+    return confirmAnswer;
+  };
+  dom.window.alert = (message?: string) => void dialogs.push(String(message ?? ""));
+  // 画面のコードは window. を付けずに alert / confirm を呼ぶことがある
+  for (const name of ["alert", "confirm"] as const) {
+    previous.set(name, Object.getOwnPropertyDescriptor(globalThis, name));
+    globals[name] = (message?: string) => dom.window[name](message);
+  }
+
+  // 「保存しました」の表示を数秒後に消すタイマーなどが、テストの終了後まで残らないよう、作られたタイマーを覚えておく
+  // Node のタイマー（DOM の型定義では戻り値が number になるため、型を明示して扱う）
+  type TimerHandle = unknown;
+  type TimerFunction = (handler: () => void, delay?: number) => TimerHandle;
+  const originalSetTimeout = globals.setTimeout as TimerFunction;
+  const originalSetInterval = globals.setInterval as TimerFunction;
+  const clearTimer = (timer: TimerHandle): void => {
+    (globals.clearTimeout as (handle: TimerHandle) => void)(timer);
+    (globals.clearInterval as (handle: TimerHandle) => void)(timer);
+  };
+  const pendingTimers = new Set<TimerHandle>();
+  globals.setTimeout = (handler: () => void, delay?: number) => {
+    const timer: TimerHandle = originalSetTimeout(() => {
+      pendingTimers.delete(timer);
+      handler();
+    }, delay);
+    pendingTimers.add(timer);
+    return timer;
+  };
+  globals.setInterval = (handler: () => void, delay?: number) => {
+    const timer = originalSetInterval(handler, delay);
+    pendingTimers.add(timer);
+    return timer;
+  };
+
+  const downloads: Blob[] = [];
+  const originalCreateObjectUrl = URL.createObjectURL;
+  const originalRevokeObjectUrl = URL.revokeObjectURL;
+  URL.createObjectURL = (blob: Blob) => {
+    downloads.push(blob);
+    return `blob:test/${downloads.length}`;
+  };
+  URL.revokeObjectURL = () => undefined;
+  // jsdom はリンクのクリックによる画面遷移を実装していない（ダウンロード用の a 要素のクリックで警告を出さない）
+  dom.window.HTMLAnchorElement.prototype.click = () => undefined;
+  dom.window.scrollTo = () => undefined;
+  const openedUrls: string[] = [];
+  dom.window.open = (url?: string | URL) => {
+    openedUrls.push(String(url ?? ""));
+    return null;
+  };
+  // jsdom は要素のスクロール位置合わせを実装していない
+  dom.window.Element.prototype.scrollIntoView = () => undefined;
+
+  const clipboardWrites: string[] = [];
+  let isClipboardDenied = false;
+  Object.defineProperty(dom.window.navigator, "clipboard", {
+    value: {
+      writeText: async (text: string) => {
+        if (isClipboardDenied) {
+          throw new Error("NotAllowedError: Write permission denied.");
+        }
+        clipboardWrites.push(text);
+      },
+    },
+    configurable: true,
+  });
+  // 権限が無いときの代替手段（document.execCommand("copy")）も、同じように成否を切り替える
+  dom.window.document.execCommand = () => !isClipboardDenied;
+
+  // jsdom には IntersectionObserver が無い。監視の開始だけ記録し、テストから発火させる。
+  type IntersectionCallback = (entries: Array<{ isIntersecting: boolean; target: Element }>) => void;
+  const intersectionObservers = new Set<{ callback: IntersectionCallback; targets: Set<Element> }>();
+  class IntersectionObserverStub {
+    private readonly record: { callback: IntersectionCallback; targets: Set<Element> };
+    constructor(callback: IntersectionCallback) {
+      this.record = { callback, targets: new Set() };
+      intersectionObservers.add(this.record);
+    }
+    observe(target: Element): void {
+      this.record.targets.add(target);
+    }
+    unobserve(target: Element): void {
+      this.record.targets.delete(target);
+    }
+    disconnect(): void {
+      intersectionObservers.delete(this.record);
+    }
+  }
+  previous.set("IntersectionObserver", Object.getOwnPropertyDescriptor(globalThis, "IntersectionObserver"));
+  globals.IntersectionObserver = IntersectionObserverStub;
+  (dom.window as unknown as Record<string, unknown>).IntersectionObserver = IntersectionObserverStub;
+
+  return {
+    window: dom.window,
+    dialogs,
+    setConfirmAnswer: (answer) => {
+      confirmAnswer = answer;
+    },
+    openedUrls,
+    clipboardWrites,
+    denyClipboard: () => {
+      isClipboardDenied = true;
+    },
+    downloads,
+    triggerIntersection: async () => {
+      await reactAct(() => {
+        for (const record of [...intersectionObservers]) {
+          record.callback([...record.targets].map((target) => ({ isIntersecting: true, target })));
+        }
+      });
+      await settle();
+    },
+    setElementSize: ({ scrollHeight, clientHeight }) => {
+      Object.defineProperty(dom.window.HTMLElement.prototype, "scrollHeight", { get: () => scrollHeight, configurable: true });
+      Object.defineProperty(dom.window.HTMLElement.prototype, "clientHeight", { get: () => clientHeight, configurable: true });
+    },
+    close: () => {
+      for (const timer of pendingTimers) {
+        clearTimer(timer);
+      }
+      globals.setTimeout = originalSetTimeout;
+      globals.setInterval = originalSetInterval;
+      URL.createObjectURL = originalCreateObjectUrl;
+      URL.revokeObjectURL = originalRevokeObjectUrl;
+      dom.window.close();
+      for (const [name, descriptor] of previous) {
+        if (descriptor) Object.defineProperty(globalThis, name, descriptor);
+        else delete globals[name];
+      }
+    },
+  };
+}
+
+export type RecordedRequest = { method: string; path: string; query: URLSearchParams; body: unknown };
+type RouteResponse = object | string | number | boolean | null;
+type RouteHandler = RouteResponse | ((request: RecordedRequest) => unknown);
+
+export type FetchStub = {
+  requests: RecordedRequest[];
+  /** 経路（"GET /api/..." のように書く）への応答を追加・差し替える */
+  respond(route: string, handler: RouteHandler): void;
+  /** その経路へ送られた要求（古い順） */
+  requestsTo(route: string): RecordedRequest[];
+  restore(): void;
+};
+
+/** 配列の最後の要素を返す（無ければ undefined）。 */
+export function last<T>(items: readonly T[]): T | undefined {
+  return items[items.length - 1];
+}
+
+/** 応答として返すと、その状態コードのエラー応答になる。 */
+export function httpError(status: number, detail: string): { __httpError: true; status: number; detail: string } {
+  return { __httpError: true, status, detail };
+}
+
+/**
+ * fetch を代用品へ差し替える。routes は「"メソッド パス"」→ 応答（JSON にする値、または要求を受け取る関数）。
+ * 登録の無い経路への要求は 404 を返し、テストが気づけるよう requests に記録する。
+ */
+export function installFetchStub(routes: Record<string, RouteHandler> = {}): FetchStub {
+  const table = new Map(Object.entries(routes));
+  const requests: RecordedRequest[] = [];
+  const originalFetch = globalThis.fetch;
+  const stub = async (input: RequestInfo | URL, init?: RequestInit): Promise<Response> => {
+    const url = new URL(String(input), "http://127.0.0.1:8079");
+    const method = (init?.method ?? "GET").toUpperCase();
+    let body: unknown = undefined;
+    if (typeof init?.body === "string") {
+      try {
+        body = JSON.parse(init.body);
+      } catch {
+        body = init.body;
+      }
+    }
+    const request: RecordedRequest = { method, path: url.pathname, query: url.searchParams, body };
+    requests.push(request);
+    const handler = table.get(`${method} ${url.pathname}`);
+    if (handler === undefined) {
+      return new Response(JSON.stringify({ detail: `no stub for ${method} ${url.pathname}` }), {
+        status: 404,
+        headers: { "Content-Type": "application/json" },
+      });
+    }
+    const result = typeof handler === "function" ? (handler as (r: RecordedRequest) => unknown)(request) : handler;
+    if (result && typeof result === "object" && (result as { __httpError?: boolean }).__httpError) {
+      const error = result as { status: number; detail: string };
+      return new Response(JSON.stringify({ detail: error.detail }), {
+        status: error.status,
+        headers: { "Content-Type": "application/json" },
+      });
+    }
+    return new Response(JSON.stringify(result ?? null), {
+      status: 200,
+      headers: { "Content-Type": "application/json" },
+    });
+  };
+  globalThis.fetch = stub as typeof fetch;
+  return {
+    requests,
+    respond: (route, handler) => void table.set(route, handler),
+    requestsTo: (route) => requests.filter((request) => `${request.method} ${request.path}` === route),
+    restore: () => {
+      globalThis.fetch = originalFetch;
+    },
+  };
+}
+
+async function reactAct(callback: () => void | Promise<void>): Promise<void> {
+  const { act } = await import("react");
+  await act(async () => {
+    await callback();
+  });
+}
+
+/** 保留中の Promise とタイマー（0 ミリ秒）を進め、その結果の再描画まで終わらせる。 */
+export async function settle(rounds = 5): Promise<void> {
+  for (let index = 0; index < rounds; index += 1) {
+    await reactAct(async () => {
+      await new Promise((resolve) => setTimeout(resolve, 0));
+    });
+  }
+}
+
+/** 指定ミリ秒だけ待ち、その間に動いたタイマー（入力から少し遅れて動く自動保存など）の結果まで反映する。 */
+export async function wait(milliseconds: number): Promise<void> {
+  await reactAct(async () => {
+    await new Promise((resolve) => setTimeout(resolve, milliseconds));
+  });
+  await settle();
+}
+
+/**
+ * アプリのスタイルシート（src/styles/app.css）を DOM へ読み込む。
+ * 読み込んだあとは getComputedStyle で、実際の要素に適用されるスタイルを確かめられる
+ * （jsdom はレイアウトを計算しないので、確かめられるのは宣言された値だけ）。
+ */
+export async function installAppStyles(): Promise<void> {
+  const { readFileSync } = await import("node:fs");
+  const { fileURLToPath } = await import("node:url");
+  const cssPath = fileURLToPath(new URL("../styles/app.css", import.meta.url));
+  const style = document.createElement("style");
+  style.textContent = readFileSync(cssPath, "utf-8");
+  document.head.appendChild(style);
+}
+
+/** 要素に適用されるスタイルの値を返す。 */
+export function styleOf(element: Element, property: string): string {
+  return window.getComputedStyle(element).getPropertyValue(property);
+}
+
+export type MountedView = { container: HTMLElement; unmount(): Promise<void> };
+
+/** コンポーネントを DOM へ描画する。初回の useEffect と、そこから始まる通信の完了まで待つ。 */
+export async function mount<P extends object>(component: ComponentType<P>, props: P): Promise<MountedView> {
+  const { createRoot } = await import("react-dom/client");
+  const container = document.getElementById("root") as HTMLElement;
+  const root = createRoot(container);
+  await reactAct(() => {
+    root.render(createElement(component, props));
+  });
+  await settle();
+  return {
+    container,
+    unmount: async () => {
+      await reactAct(() => root.unmount());
+    },
+  };
+}
+
+/** 表示されている文字（前後の空白を除く）が一致、または含む要素を探す。見つからなければ失敗させる。 */
+export function findByText(scope: ParentNode, selector: string, text: string | RegExp): HTMLElement {
+  const found = queryAllByText(scope, selector, text);
+  if (found.length === 0) {
+    const candidates = [...scope.querySelectorAll(selector)].map((element) => normalizeText(element.textContent)).slice(0, 30);
+    throw new Error(`"${selector}" with text ${String(text)} not found. candidates: ${JSON.stringify(candidates)}`);
+  }
+  return found[0];
+}
+
+export function queryAllByText(scope: ParentNode, selector: string, text: string | RegExp): HTMLElement[] {
+  return [...scope.querySelectorAll<HTMLElement>(selector)].filter((element) => {
+    const content = normalizeText(element.textContent);
+    return typeof text === "string" ? content === text || content.includes(text) : text.test(content);
+  });
+}
+
+/** セレクターに一致する最初の要素を返す。無ければ失敗させる。 */
+export function findBySelector<T extends HTMLElement = HTMLElement>(scope: ParentNode, selector: string): T {
+  const element = scope.querySelector<T>(selector);
+  if (!element) throw new Error(`"${selector}" not found`);
+  return element;
+}
+
+/**
+ * セレクターに一致する要素があるかを返す。
+ * assert へ DOM の要素そのものを渡すと、失敗時の差分表示で要素全体をたどって極端に遅くなるため、真偽値で比べる。
+ */
+export function hasElement(scope: ParentNode, selector: string): boolean {
+  return scope.querySelector(selector) !== null;
+}
+
+export function normalizeText(value: string | null | undefined): string {
+  return (value ?? "").replace(/\s+/g, " ").trim();
+}
+
+/** クリックし、その結果の更新（通信を含む）が終わるまで待つ。 */
+export async function click(element: Element): Promise<void> {
+  await reactAct(() => {
+    element.dispatchEvent(new window.MouseEvent("click", { bubbles: true, cancelable: true }));
+  });
+  await settle();
+}
+
+/** 入力欄・テキストエリアへ値を入れる（React が変更を検知できる方法で設定する）。 */
+export async function typeInto(element: HTMLInputElement | HTMLTextAreaElement, value: string): Promise<void> {
+  const prototype = element instanceof window.HTMLTextAreaElement
+    ? window.HTMLTextAreaElement.prototype
+    : window.HTMLInputElement.prototype;
+  const setter = Object.getOwnPropertyDescriptor(prototype, "value")?.set;
+  await reactAct(() => {
+    setter?.call(element, value);
+    element.dispatchEvent(new window.Event("input", { bubbles: true }));
+  });
+  await settle(2);
+}
+
+/** チェックボックス・ラジオボタンの状態を切り替える。 */
+export async function setChecked(element: HTMLInputElement, checked: boolean): Promise<void> {
+  if (element.checked !== checked) await click(element);
+}
+
+/** セレクトボックスの値を選ぶ。 */
+export async function selectOption(element: HTMLSelectElement, value: string): Promise<void> {
+  const setter = Object.getOwnPropertyDescriptor(window.HTMLSelectElement.prototype, "value")?.set;
+  await reactAct(() => {
+    setter?.call(element, value);
+    element.dispatchEvent(new window.Event("change", { bubbles: true }));
+  });
+  await settle(2);
+}
+
+/**
+ * キーを押す（Enter での検索実行、ショートカットなど）。
+ * 入力欄以外で押したことにするには document.body を渡す。isComposing は日本語入力の変換中を表す。
+ */
+export async function pressKey(
+  element: Element,
+  key: string,
+  modifiers: { ctrlKey?: boolean; metaKey?: boolean; shiftKey?: boolean; altKey?: boolean; isComposing?: boolean } = {},
+): Promise<void> {
+  await reactAct(() => {
+    element.dispatchEvent(new window.KeyboardEvent("keydown", { key, bubbles: true, cancelable: true, ...modifiers }));
+  });
+  await settle();
+}
+
+/** ダブルクリックする（行のインライン編集の開始など）。 */
+export async function doubleClick(element: Element): Promise<void> {
+  await reactAct(() => {
+    element.dispatchEvent(new window.MouseEvent("dblclick", { bubbles: true, cancelable: true }));
+  });
+  await settle(2);
+}
+
+/** 右クリックする（コンテキストメニューを開く）。 */
+export async function rightClick(element: Element): Promise<void> {
+  await reactAct(() => {
+    element.dispatchEvent(new window.MouseEvent("contextmenu", { bubbles: true, cancelable: true, clientX: 10, clientY: 20 }));
+  });
+  await settle(2);
+}
+
+/** マウスのボタンを押し下げる（ポップアップの外側を押して閉じる操作、ドラッグでの連続選択の開始など）。 */
+export async function mouseDown(element: Element, modifiers: { shiftKey?: boolean } = {}): Promise<void> {
+  await reactAct(() => {
+    element.dispatchEvent(new window.MouseEvent("mousedown", { bubbles: true, cancelable: true, button: 0, ...modifiers }));
+  });
+  await settle(2);
+}
+
+/** マウスを要素の上へ移動する（ドラッグ中に通過した行の選択など）。 */
+export async function mouseEnter(element: Element, modifiers: { shiftKey?: boolean } = {}): Promise<void> {
+  await reactAct(() => {
+    // React の onMouseEnter は、外から入ってきた mouseover で発火する
+    element.dispatchEvent(
+      new window.MouseEvent("mouseover", { bubbles: true, cancelable: true, relatedTarget: document.body, ...modifiers }),
+    );
+  });
+  await settle(2);
+}
+
+/** マウスのボタンを離す（ドラッグの終了）。 */
+export async function mouseUp(): Promise<void> {
+  await reactAct(() => {
+    window.dispatchEvent(new window.MouseEvent("mouseup", { bubbles: true }));
+  });
+  await settle(2);
+}
+
+/** source を target の上へドラッグして離す（一覧の並べ替え）。 */
+export async function dragAndDrop(source: Element, target: Element): Promise<void> {
+  const fire = (element: Element, type: string): void => {
+    element.dispatchEvent(new window.Event(type, { bubbles: true, cancelable: true }));
+  };
+  await reactAct(() => fire(source, "dragstart"));
+  await reactAct(() => fire(target, "dragover"));
+  await reactAct(() => fire(target, "drop"));
+  await reactAct(() => fire(source, "dragend"));
+  await settle(2);
+}
+
+/** 入力欄からフォーカスを外す（インライン編集の確定など）。 */
+export async function blur(element: HTMLElement): Promise<void> {
+  await reactAct(() => {
+    element.focus();
+    element.blur();
+  });
+  await settle(2);
+}
+
+/** フォームを送信する。 */
+export async function submitForm(form: Element): Promise<void> {
+  await reactAct(() => {
+    form.dispatchEvent(new window.Event("submit", { bubbles: true, cancelable: true }));
+  });
+  await settle();
+}
diff --git a/frontend/src/testing/render.ts b/frontend/src/testing/render.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0b619ab74f8e8500be13b5470bd5bc2eb1399277
--- /dev/null
+++ b/frontend/src/testing/render.ts
@@ -0,0 +1,64 @@
+/**
+ * コンポーネントを実際に描画して検証するテスト用の描画処理。
+ *
+ * Vite でソース（TSX）をその場で読み込み、React のサーバー描画で HTML 文字列にする。
+ * ブラウザーを使わないため、描画されるのは初回の表示内容だけで、useEffect やクリック操作は実行されない。
+ * 「この状態を渡すと、この内容が表示される」を確かめる用途に使う。
+ */
+import { createElement, type ComponentType } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { createServer, type ViteDevServer } from "vite";
+
+let serverPromise: Promise<ViteDevServer> | null = null;
+
+function getServer(): Promise<ViteDevServer> {
+  serverPromise ??= createServer({
+    appType: "custom",
+    logLevel: "error",
+    optimizeDeps: { noDiscovery: true },
+    server: { middlewareMode: true, hmr: false, ws: false },
+  });
+  return serverPromise;
+}
+
+/** src からのパス（例: "/src/pages/SchedulerPage.tsx"）でモジュールを読み込む。 */
+export async function loadSourceModule<T = Record<string, unknown>>(sourcePath: string): Promise<T> {
+  const server = await getServer();
+  return (await server.ssrLoadModule(sourcePath)) as T;
+}
+
+/** コンポーネントを描画し、HTML 文字列を返す。 */
+export function renderToHtml<P extends object>(component: ComponentType<P>, props: P): string {
+  return renderToStaticMarkup(createElement(component, props));
+}
+
+/** HTML からタグを取り除き、表示される文字だけを返す。 */
+export function visibleText(html: string): string {
+  return html.replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim();
+}
+
+/** テストの最後に呼び、読み込み用のサーバーを止める。 */
+export async function closeRenderer(): Promise<void> {
+  if (serverPromise) {
+    const server = await serverPromise;
+    serverPromise = null;
+    await server.close();
+  }
+}
+
+/**
+ * ブラウザーにしか無いグローバル（window.location / localStorage / navigator）の代用品を用意する。
+ * 起動 URL のクエリ文字列と、保存済みの設定値を指定できる。
+ */
+export function installBrowserStubs(options: { search?: string; storage?: Record<string, string> } = {}): void {
+  const storage = new Map(Object.entries(options.storage ?? {}));
+  const localStorageStub = {
+    getItem: (key: string) => storage.get(key) ?? null,
+    setItem: (key: string, value: string) => void storage.set(key, value),
+    removeItem: (key: string) => void storage.delete(key),
+  };
+  const globals = globalThis as Record<string, unknown>;
+  globals.localStorage = localStorageStub;
+  globals.window = { location: { search: options.search ?? "" }, localStorage: localStorageStub };
+  Object.defineProperty(globalThis, "navigator", { value: { userAgent: "node" }, configurable: true });
+}
