 def normalize_path_key(path_str: str) -> str:
-    """パスの比較用キー（小文字化・スラッシュ統一）を生成"""
+    """
+    パスの比較用キー（小文字化・スラッシュ統一）を生成する。
+    Windows の絶対パスは実行 OS に関係なく `\\` 区切りと `/` 区切りを同一視する
