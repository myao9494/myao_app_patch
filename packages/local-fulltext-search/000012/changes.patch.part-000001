+    if expected_path is not None and normalize_path_key(expected_path) != normalize_path_key(full_path):
+        raise HTTPException(
+            status_code=status.HTTP_409_CONFLICT,
+            detail="File path does not match the indexed file. Nothing was deleted.",
+        )
 
     try:
         os.remove(full_path)
     except FileNotFoundError:
         # 既に存在しない場合はスキップしてDBからの削除のみ行う
