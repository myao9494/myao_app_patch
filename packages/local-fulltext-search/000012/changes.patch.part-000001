-    if (!normalized) {
-      setErrorMessage("スケジューラーに追加するパスを入力してください。");
-      return;
-    }
-    setSchedulerPaths((current) => (current.includes(normalized) ? current : [...current, normalized]));
-    setSchedulerPathDraft("");
-    setErrorMessage("");
-  }
