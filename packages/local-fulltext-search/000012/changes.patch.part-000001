+test("入力したフォルダが検索対象に含まれていないときだけ、検索対象へ追加するボタンを表示する", async () => {
+  const target = { full_path: "/docs", source_type: "local", is_enabled: true, last_indexed_at: null, indexed_file_count: 0 };
+  const app = await openApp({
+    routes: {
+      "GET /api/index/search-targets": { items: [target] },
+      "GET /api/index/search-targets/coverage": (request) => {
+        const path = request.query.get("folder_path") ?? "";
+        const isCovered = path.startsWith("/docs");
+        return { normalized_path: path, source_type: "local", is_covered: isCovered, covering_path: isCovered ? "/docs" : null };
+      },
+      "POST /api/index/search-targets": {
+        items: [target, { ...target, full_path: "/other" }],
+      },
+    },
+  });
+  try {
+    const pathInput = findBySelector<HTMLInputElement>(app.container, "input.path-input");
+    const addButtons = () => queryAllByText(app.container, "button", "検索対象");
+
+    await typeInto(pathInput, "/docs/sub");
+    await wait(260);
+    await typeInto(pathInput, "/docs/sub");
+    assert.equal(addButtons().filter((button) => !button.classList.contains("page-tab")).length, 0);
+
+    await typeInto(pathInput, "/other");
+    await wait(260);
+    await typeInto(pathInput, "/other");
+    const addButton = addButtons().find((button) => !button.classList.contains("page-tab"));
+    assert.ok(addButton, "検索対象外のフォルダには追加ボタンを表示する");
+
+    await click(addButton);
+
+    const added = app.api.requestsTo("POST /api/index/search-targets")[0].body as { folder_path: string };
+    assert.equal(added.folder_path, "/other");
+    assert.match(normalizeText(findBySelector(app.container, ".notice-banner").textContent), /検索対象に追加しました/);
+  } finally {
+    await app.close();
+  }
+});
diff --git a/frontend/src/searchResultSort.test.ts b/frontend/src/searchResultSort.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bb78b166e2898132a13eee459e944302509ac072
--- /dev/null
+++ b/frontend/src/searchResultSort.test.ts
@@ -0,0 +1,96 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { sortSearchResults } from "./searchResultSort.ts";
+import type { SearchResult } from "./types";
+
+/**
+ * 並び替えテスト用の検索結果を、必要な項目だけ指定して作る。
+ */
+function item(fileId: number, overrides: Partial<SearchResult> = {}): SearchResult {
+  return {
+    file_id: fileId,
+    target_path: "/docs",
+    file_name: `file-${fileId}.md`,
+    full_path: `/docs/file-${fileId}.md`,
+    file_ext: ".md",
+    created_at: "2026-01-01T00:00:00+09:00",
+    mtime: "2026-01-01T00:00:00+09:00",
+    click_count: 0,
+    snippet: "",
+    ...overrides,
+  } as SearchResult;
+}
+
+function ids(items: readonly SearchResult[]): number[] {
+  return items.map((entry) => entry.file_id);
+}
+
+test("既定順はハイブリッド融合スコアの高い順を最優先する", () => {
+  const sorted = sortSearchResults(
+    [
+      item(1, { hybrid_score: 0.4, filename_match_level: 8, click_count: 99 }),
+      item(2, { hybrid_score: 0.9 }),
+      item(3, { hybrid_score: 0.6, has_obsidian_top_tag: true }),
+    ],
+    { sortBy: "default", sortOrder: "desc" },
+  );
+
+  assert.deepEqual(ids(sorted), [2, 3, 1]);
+});
+
+test("既定順はハイブリッドスコアを持つ結果を、持たない結果より先に並べる", () => {
+  const sorted = sortSearchResults(
+    [item(1, { filename_match_level: 8 }), item(2, { hybrid_score: 0.1 })],
+    { sortBy: "default", sortOrder: "desc" },
+  );
+
+  assert.deepEqual(ids(sorted), [2, 1]);
+});
+
+test("既定順はスコアが無いとき、ファイル名一致・top タグ・検索語別クリック・関連度・利用価値・更新日時の順で比べる", () => {
+  const sorted = sortSearchResults(
+    [
+      item(1, { mtime: "2026-03-01T00:00:00+09:00" }),
+      item(2, { utility_score: 5 }),
+      item(3, { relevance_bucket: 3 }),
+      item(4, { query_click_score: 0.5 }),
+      item(5, { has_obsidian_top_tag: true }),
+      item(6, { filename_match_level: 2 }),
+      item(7, { mtime: "2026-02-01T00:00:00+09:00" }),
+    ],
+    { sortBy: "default", sortOrder: "desc" },
+  );
+
+  assert.deepEqual(ids(sorted), [6, 5, 4, 3, 2, 1, 7]);
+});
+
+test("既定順は昇順指定でも順序を変えない", () => {
+  const items = [item(1, { hybrid_score: 0.2 }), item(2, { hybrid_score: 0.8 })];
+
+  assert.deepEqual(
+    ids(sortSearchResults(items, { sortBy: "default", sortOrder: "asc" })),
+    ids(sortSearchResults(items, { sortBy: "default", sortOrder: "desc" })),
+  );
+});
+
+test("スコア・日付・アクセス数の並び替えは指定した向きで並べ、同値は file_id 順にする", () => {
+  const items = [
+    item(3, { vector_score: 0.5, click_count: 2, created_at: "2026-01-03T00:00:00+09:00" }),
+    item(1, { vector_score: 0.9, click_count: 2, created_at: "2026-01-01T00:00:00+09:00" }),
+    item(2, { click_count: 7, created_at: "2026-01-02T00:00:00+09:00" }),
+  ];
+
+  assert.deepEqual(ids(sortSearchResults(items, { sortBy: "vector_score", sortOrder: "desc" })), [1, 3, 2]);
+  assert.deepEqual(ids(sortSearchResults(items, { sortBy: "vector_score", sortOrder: "asc" })), [2, 3, 1]);
+  assert.deepEqual(ids(sortSearchResults(items, { sortBy: "click_count", sortOrder: "desc" })), [2, 1, 3]);
+  assert.deepEqual(ids(sortSearchResults(items, { sortBy: "created", sortOrder: "asc" })), [1, 2, 3]);
+});
+
+test("並び替えは元の配列を変更しない", () => {
+  const items = [item(2, { hybrid_score: 0.1 }), item(1, { hybrid_score: 0.9 })];
+
+  sortSearchResults(items, { sortBy: "default", sortOrder: "desc" });
+
+  assert.deepEqual(ids(items), [2, 1]);
+});
diff --git a/frontend/src/searchResultSort.ts b/frontend/src/searchResultSort.ts
new file mode 100644
index 0000000000000000000000000000000000000000..02815024253054532282d7c5576091d587b295c9
--- /dev/null
+++ b/frontend/src/searchResultSort.ts
@@ -0,0 +1,82 @@
+/**
+ * 検索結果の並び替え。
+ * 再検索せずに、現在の UI 指定（並び順キーと昇順 / 降順）だけで安定した順序を作る。
+ * 既定順ではハイブリッド融合スコアを最優先し、同点ならファイル名一致レベル、top タグ、
+ * 検索語別クリック、本文関連度、利用価値、更新日時の順で比較する。
+ **/
+
+import type { SearchResult } from "./types";
+
+/**
+ * 検索結果は再検索せずに、現在の UI 指定だけで安定した並び替えを行う。
+ */
+export function sortSearchResults(
+  items: readonly SearchResult[],
+  {
+    sortBy,
+    sortOrder,
+  }: {
+    sortBy: "default" | "hybrid_score" | "vector_score" | "keyword_score" | "created" | "modified" | "click_count",
+    sortOrder: "asc" | "desc",
+  },
+): SearchResult[] {
+  if (sortBy === "default") {
+    return [...items].sort((left, right) => {
+      // ハイブリッド検索結果の場合は、ハイブリッド融合スコア順（RRF順位）を最優先
+      const hybridDifference = (right.hybrid_score ?? -1) - (left.hybrid_score ?? -1);
+      if (hybridDifference !== 0 && (right.hybrid_score != null || left.hybrid_score != null)) {
+        return hybridDifference;
+      }
+      const filenameDifference = (right.filename_match_level ?? 0) - (left.filename_match_level ?? 0);
+      if (filenameDifference !== 0) return filenameDifference;
+      const topDifference = Number(Boolean(right.has_obsidian_top_tag)) - Number(Boolean(left.has_obsidian_top_tag));
+      if (topDifference !== 0) return topDifference;
+      const queryClickDifference = (right.query_click_score ?? 0) - (left.query_click_score ?? 0);
+      if (queryClickDifference !== 0) return queryClickDifference;
+      const relevanceDifference = (right.relevance_bucket ?? 0) - (left.relevance_bucket ?? 0);
+      if (relevanceDifference !== 0) return relevanceDifference;
+      const utilityDifference = (right.utility_score ?? 0) - (left.utility_score ?? 0);
+      if (utilityDifference !== 0) return utilityDifference;
+      const modifiedDifference = new Date(right.mtime).getTime() - new Date(left.mtime).getTime();
+      return modifiedDifference !== 0 ? modifiedDifference : right.file_id - left.file_id;
+    });
+  }
+  const direction = sortOrder === "asc" ? 1 : -1;
+
+  return [...items].sort((left, right) => {
+    const leftValue = getSortableValue(left, sortBy);
+    const rightValue = getSortableValue(right, sortBy);
+    if (leftValue < rightValue) {
+      return -1 * direction;
+    }
+    if (leftValue > rightValue) {
+      return 1 * direction;
+    }
+    return left.file_id - right.file_id;
+  });
+}
+
+/**
+ * 並び替えキーごとの比較値を数値へ正規化する。
+ */
+function getSortableValue(
+  item: SearchResult,
+  sortBy: "hybrid_score" | "vector_score" | "keyword_score" | "created" | "modified" | "click_count",
+): number {
+  if (sortBy === "hybrid_score") {
+    return item.hybrid_score ?? -1;
+  }
+  if (sortBy === "vector_score") {
+    return item.vector_score ?? -1;
+  }
+  if (sortBy === "keyword_score") {
+    return item.keyword_score ?? -1;
+  }
+  if (sortBy === "click_count") {
+    return item.click_count;
+  }
+  if (sortBy === "created") {
+    return new Date(item.created_at).getTime();
+  }
+  return new Date(item.mtime).getTime();
+}
diff --git a/frontend/src/searchTargetCoverage.ts b/frontend/src/searchTargetCoverage.ts
new file mode 100644
index 0000000000000000000000000000000000000000..247e88c7007616448d5cb006b041ba469e75a02e
--- /dev/null
+++ b/frontend/src/searchTargetCoverage.ts
@@ -0,0 +1,32 @@
+/**
+ * 検索対象フォルダの包含判定。
+ * 指定パスが登録済みの検索対象フォルダ（またはその配下）に含まれるかを、区切り文字の違いを吸収して判定する。
+ **/
+
+import type { SearchTargetFolder } from "./types";
+
+/**
+ * 検索対象フォルダの親子判定用に、区切りを統一して末尾スラッシュを除去する。
+ */
+export function normalizeComparablePath(path: string): string {
+  const trimmed = path.trim().replace(/\\/g, "/");
+  if (trimmed.length <= 1) {
+    return trimmed;
+  }
+  return trimmed.endsWith("/") ? trimmed.slice(0, -1) : trimmed;
+}
+
+/**
+ * 検索対象フォルダ一覧に、指定パス（または親）が含まれるか判定する。
+ * 有効/無効に関わらず、親フォルダが登録済みなら子の自動追加候補は表示しない。
+ */
+export function isPathCoveredByTarget(path: string, searchTargets: readonly SearchTargetFolder[]): boolean {
+  const normalizedPath = normalizeComparablePath(path);
+  if (!normalizedPath) {
+    return false;
+  }
+  const registeredPaths = searchTargets
+    .map((item) => normalizeComparablePath(item.full_path))
+    .filter(Boolean);
+  return registeredPaths.some((rootPath) => normalizedPath === rootPath || normalizedPath.startsWith(`${rootPath}/`));
+}
diff --git a/frontend/src/settingsHelpers.test.ts b/frontend/src/settingsHelpers.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2eb6e5765f596e20107880787bd829be98966b5b
--- /dev/null
+++ b/frontend/src/settingsHelpers.test.ts
@@ -0,0 +1,106 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import {
+  resolveRelativeDateInputValue,
+  resolveTodayDateInputValue,
+  toLocalDateTimeInputValue,
+  toSchedulerStartAtIso,
+} from "./dateInput.ts";
+import {
+  BASE_CONTENT_EXTENSIONS,
+  DEFAULT_INDEX_EXTENSIONS,
+  buildAvailableExtensions,
+  normalizeCustomExtensions,
+  normalizeIndexExtensions,
+  parseExtensionText,
+} from "./indexExtensions.ts";
+import { isPathCoveredByTarget, normalizeComparablePath } from "./searchTargetCoverage.ts";
+import {
+  normalizeExcludeKeywords,
+  normalizeGanttParent,
+  normalizeHiddenIndexedTargets,
+  normalizeSynonymGroups,
+} from "./settingsNormalization.ts";
+import type { SearchTargetFolder } from "./types";
+
+test("日付ショートカットは UTC ではなくローカルの年月日を返す", () => {
+  // ローカル時刻の深夜 0 時台（日本時間では UTC の前日にあたる時間帯）でも当日を返す
+  const earlyMorning = new Date(2026, 9, 11, 0, 30, 0);
+
+  assert.equal(resolveTodayDateInputValue(earlyMorning), "2026-10-11");
+  assert.equal(resolveRelativeDateInputValue(7, earlyMorning), "2026-10-04");
+  assert.equal(resolveRelativeDateInputValue(11, earlyMorning), "2026-09-30");
+  assert.equal(earlyMorning.getDate(), 11, "引数の Date を変更しない");
+});
+
+test("スケジューラーの日時は datetime-local の値と ISO 文字列を往復できる", () => {
+  const iso = new Date(2026, 4, 5, 6, 7, 0).toISOString();
+
+  assert.equal(toLocalDateTimeInputValue(iso), "2026-05-05T06:07");
+  assert.equal(toSchedulerStartAtIso("2026-05-05T06:07"), iso);
+  assert.equal(toLocalDateTimeInputValue(null), "");
+});
+
+test("除外キーワードと非表示キーワードは空行・前後空白・重複を取り除く", () => {
+  assert.equal(normalizeExcludeKeywords("  node_modules \r\n\n.git\nnode_modules\n"), "node_modules\n.git");
+  assert.equal(normalizeHiddenIndexedTargets("a\n\n a \nb"), "a\nb");
+  assert.equal(normalizeExcludeKeywords(""), "");
+});
+
+test("類似語リストは用語の重複を大文字小文字を無視して除き、解説を保持する", () => {
+  const normalized = normalizeSynonymGroups(
+    ["PC, パソコン，pc : 個人向け端末", "", "スマホ,スマートフォン", " ： 用語なし", "AI：人工知能の略"].join("\n"),
+  );
+
+  assert.equal(normalized, ["PC,パソコン:個人向け端末", "スマホ,スマートフォン", "AI:人工知能の略"].join("\n"));
+  assert.equal(normalizeSynonymGroups(null), "");
+});
+
+test("gantt parent ID は 0 以上の整数だけを受け付ける", () => {
+  assert.equal(normalizeGanttParent(" 239 "), 239);
+  assert.equal(normalizeGanttParent(12), 12);
+  assert.equal(normalizeGanttParent("-1"), 0);
+  assert.equal(normalizeGanttParent("1.5"), 0);
+  assert.equal(normalizeGanttParent("abc"), 0);
+  assert.equal(normalizeGanttParent(undefined), 0);
+});
+
+test("標準の対象拡張子に XLSM・Excalidraw・DIO・XML とメール・画像を含める", () => {
+  for (const extension of [".xlsm", ".excalidraw", ".excalidraw.md", ".dio", ".dio.svg", ".xml", ".msg"]) {
+    assert.ok(BASE_CONTENT_EXTENSIONS.includes(extension), `${extension} は本文抽出対象`);
+  }
+  for (const extension of [".png", ".jpg", ".svg", ".mp3"]) {
+    assert.ok(DEFAULT_INDEX_EXTENSIONS.includes(extension), `${extension} は既定のインデックス対象`);
+    assert.ok(!BASE_CONTENT_EXTENSIONS.includes(extension), `${extension} はファイル名のみ検索`);
+  }
+});
+
+test("拡張子一覧はドットを補い、重複を除き、表示順を保つ", () => {
+  assert.deepEqual(normalizeCustomExtensions([" py", ".PY", ".dat", ""]), [".py", ".dat"]);
+  assert.deepEqual(parseExtensionText(".py, dat\n.py  .cae"), [".py", ".dat", ".cae"]);
+
+  const available = buildAvailableExtensions([".py", ".md"], [".cae"]);
+  assert.deepEqual(available.slice(0, BASE_CONTENT_EXTENSIONS.length), [...BASE_CONTENT_EXTENSIONS]);
+  assert.deepEqual(available.slice(-2), [".py", ".cae"]);
+  assert.equal(available.filter((extension) => extension === ".md").length, 1);
+  assert.deepEqual(buildAvailableExtensions([], []), DEFAULT_INDEX_EXTENSIONS);
+
+  assert.deepEqual(normalizeIndexExtensions(["png", ".md", ".unknown", ".md"], available), [".md", ".png"]);
+});
+
+test("検索対象フォルダの包含判定は区切り文字と末尾スラッシュの違いを吸収する", () => {
+  const targets = [
+    { full_path: "C:\\work\\docs\\" },
+    { full_path: "/Users/me/vault" },
+  ] as SearchTargetFolder[];
+
+  assert.equal(normalizeComparablePath("C:\\work\\docs\\"), "C:/work/docs");
+  assert.equal(normalizeComparablePath("/"), "/");
+  assert.equal(isPathCoveredByTarget("C:/work/docs/sub/a.md", targets), true);
+  assert.equal(isPathCoveredByTarget("C:/work/docs", targets), true);
+  assert.equal(isPathCoveredByTarget("C:/work/docs2/a.md", targets), false);
+  assert.equal(isPathCoveredByTarget("/Users/me/vault/notes", targets), true);
+  assert.equal(isPathCoveredByTarget("/Users/me", targets), false);
+  assert.equal(isPathCoveredByTarget("  ", targets), false);
+});
diff --git a/frontend/src/settingsInteraction.test.ts b/frontend/src/settingsInteraction.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4e5b3c102e510dfb10124f50548a8f893e6b7d15
--- /dev/null
+++ b/frontend/src/settingsInteraction.test.ts
@@ -0,0 +1,323 @@
+/**
+ * 設定メニュー（設定ドロワー）を DOM へ描画し、操作のあとの API 呼び出しと表示を検証するテスト。
+ */
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { appSettings, indexStatus, searchResponse, searchResult } from "./testing/apiFixtures.ts";
+import { withApp, type AppHarness, type Routes } from "./testing/appHarness.ts";
+import {
+  click,
+  findBySelector,
+  findByText,
+  hasElement,
+  httpError,
+  normalizeText,
+  queryAllByText,
+  selectOption,
+  typeInto,
+  last,
+} from "./testing/dom.ts";
+import { closeRenderer } from "./testing/render.ts";
+
+test.after(() => closeRenderer());
+
+/** 送られた設定をそのまま保存済みとして返す */
+const echoSettings: Routes = {
+  "PUT /api/index/settings": (request) => appSettings(request.body as Partial<ReturnType<typeof appSettings>>),
+};
+
+async function openDrawer(app: AppHarness): Promise<HTMLElement> {
+  await click(findBySelector(app.container, ".search-nav .menu-button"));
+  return app.drawer();
+}
+
+/** 入力欄のすぐ後ろにある「保存」ボタンと保存状態の表示を返す */
+function saveRowAfter(field: Element): { button: HTMLButtonElement; status: () => string } {
+  let node = field.nextElementSibling;
+  while (node && !node.classList.contains("settings-action-row")) {
+    node = node.nextElementSibling;
+  }
+  assert.ok(node, "入力欄の後ろに保存の行がある");
+  const row = node;
+  return {
+    button: findBySelector<HTMLButtonElement>(row, "button.settings-save-button"),
+    status: () => normalizeText(row.querySelector(".settings-save-status")?.textContent),
+  };
+}
+
+test("設定メニューは、設定ボタンで開き、閉じるボタンで閉じる", async () => {
+  await withApp({}, async (app) => {
+    assert.equal(app.isDrawerOpen(), false);
+
+    const drawer = await openDrawer(app);
+    assert.equal(app.isDrawerOpen(), true);
+    assert.equal(drawer.getAttribute("aria-hidden"), "false");
+
+    await click(findByText(drawer, "button", "閉じる"));
+    assert.equal(app.isDrawerOpen(), false);
+  });
+});
+
+test("設定メニューから、スケジューラー・ベクトル管理・AIインプット・ランチャーの各画面へ移れる", async () => {
+  const destinations: Array<[string, RegExp]> = [
+    ["スケジューラー", /スケジューラー/],
+    ["ベクトル管理", /Embedding|ベクトル/],
+    ["AIインプット", /AI/],
+    ["ランチャー", /ランチャー/],
+  ];
+  for (const [label, heading] of destinations) {
+    await withApp(
+      {
+        routes: {
+          "GET /api/vector/model/status": httpError(503, "unavailable"),
+          "GET /api/export/config": { export_folder: "", default_select_count: 10 },
+        },
+      },
+      async (app) => {
+        const drawer = await openDrawer(app);
+        await click(findByText(drawer, ".settings-action-row > button", label));
+
+        assert.equal(hasElement(app.container, "input.search-input") && hasElement(app.container, "article.result-card"), false);
+        assert.match(app.pageText(), heading, `${label} の画面を表示する`);
+      },
+    );
+  }
+});
+
+test("スケジューラーを開くと、設定メニューを閉じて最新のスケジューラー状態を読み込む", async () => {
+  await withApp({}, async (app) => {
+    const before = app.api.requestsTo("GET /api/index/scheduler").length;
+    const drawer = await openDrawer(app);
+    await click(findByText(drawer, ".settings-action-row > button", "スケジューラー"));
+
+    assert.equal(app.isDrawerOpen(), false);
+    assert.equal(app.api.requestsTo("GET /api/index/scheduler").length, before + 1);
+  });
+});
+
+test("設定メニューに、既定の検索フォルダ・除外キーワード・インデックス対象拡張子の入力欄は置かない", async () => {
+  await withApp({}, async (app) => {
+    const drawer = await openDrawer(app);
+    const fieldIds = [...drawer.querySelectorAll("input, textarea, select")].map((element) => element.id);
+
+    assert.deepEqual(fieldIds.sort(), [
+      "confirm-index-deletion",
+      "gantt-parent",
+      "obsidian-sidebar-explorer-data-path",
+      "refresh-window",
+      "ui-zoom",
+      "web-exclude-keywords",
+      "web-fetch-mode",
+    ]);
+  });
+});
+
+test("表示倍率は、スライダーでアプリの表示だけを変え、次回の起動でも同じ倍率を使う", async () => {
+  await withApp({}, async (app) => {
+    const drawer = await openDrawer(app);
+    const slider = findBySelector<HTMLInputElement>(drawer, "#ui-zoom");
+    await typeInto(slider, "110");
+
+    assert.equal(app.dom.window.document.body.style.getPropertyValue("zoom") || (app.dom.window.document.body.style as unknown as { zoom: string }).zoom, "1.1");
+    assert.equal(app.dom.window.localStorage.getItem("ui_zoom"), "110");
+    assert.match(normalizeText(findBySelector(drawer, ".zoom-settings").textContent), /110\s*%/);
+
+    await click(findByText(drawer, "button", "100%に戻す"));
+    assert.equal(app.dom.window.localStorage.getItem("ui_zoom"), "100");
+  });
+
+  await withApp({ storage: { ui_zoom: "90" } }, async (app) => {
+    assert.equal(findBySelector<HTMLInputElement>(app.drawer(), "#ui-zoom").value, "90");
+  });
+});
+
+test("Web 除外キーワードは、変更すると未保存と表示し、保存ボタンで保存する", async () => {
+  await withApp({ routes: echoSettings }, async (app) => {
+    const drawer = await openDrawer(app);
+    const textarea = findBySelector<HTMLTextAreaElement>(drawer, "#web-exclude-keywords");
+    const saveRow = saveRowAfter(textarea);
+    assert.equal(saveRow.button.disabled, true);
+    assert.equal(saveRow.status(), "保存済み");
+
+    await typeInto(textarea, "/login\n/tag/");
+    assert.equal(saveRowAfter(textarea).button.disabled, false);
+    assert.notEqual(saveRowAfter(textarea).status(), "保存済み");
+
+    await click(saveRowAfter(textarea).button);
+
+    assert.deepEqual(app.lastBody("PUT /api/index/settings"), { web_exclude_keywords: "/login\n/tag/" });
+    assert.equal(saveRowAfter(textarea).status(), "保存済み");
+  });
+});
+
+test("未保存の Web 除外キーワードがあるまま Web を検索すると、今回の検索には反映していないと知らせる", async () => {
+  await withApp({ routes: { "POST /api/search": searchResponse([searchResult()]) } }, async (app) => {
+    const drawer = await openDrawer(app);
+    await typeInto(findBySelector<HTMLTextAreaElement>(drawer, "#web-exclude-keywords"), "/login");
+    await click(findByText(app.container, "button.source-toggle-button", "Web"));
+    await app.runSearch();
+
+    assert.match(app.notice(), /未保存のWeb除外キーワードは今回の検索に反映していません/);
+  });
+});
+
+test("Web ページの取得方式は、選んだ時点で共有設定へ保存する", async () => {
+  await withApp({ routes: echoSettings }, async (app) => {
+    const drawer = await openDrawer(app);
+    await selectOption(findBySelector<HTMLSelectElement>(drawer, "#web-fetch-mode"), "edge");
+
+    assert.deepEqual(app.lastBody("PUT /api/index/settings"), { web_fetch_mode: "edge" });
+    assert.equal(findBySelector<HTMLSelectElement>(drawer, "#web-fetch-mode").value, "edge");
+  });
+});
+
+test("Obsidian の data.json のパスと gantt parent は、それぞれの保存ボタンで保存する", async () => {
+  await withApp({ routes: echoSettings }, async (app) => {
+    const drawer = await openDrawer(app);
+    const obsidian = findBySelector<HTMLTextAreaElement>(drawer, "#obsidian-sidebar-explorer-data-path");
+    await typeInto(obsidian, "  /Users/me/Vault/.obsidian/plugins/x/data.json  ");
+    await click(saveRowAfter(obsidian).button);
+
+    assert.deepEqual(app.lastBody("PUT /api/index/settings"), {
+      obsidian_sidebar_explorer_data_path: "/Users/me/Vault/.obsidian/plugins/x/data.json",
+    });
+
+    const gantt = findBySelector<HTMLInputElement>(drawer, "#gantt-parent");
+    await typeInto(gantt, "42");
+    await click(saveRowAfter(gantt).button);
+
+    assert.deepEqual(app.lastBody("PUT /api/index/settings"), { gantt_parent: 42 });
+    assert.match(app.notice(), /gantt parent を保存しました/);
+  });
+});
+
+test("インデックス削除時の確認は、チェックを切り替えた時点で保存する", async () => {
+  await withApp({ routes: echoSettings }, async (app) => {
+    const drawer = await openDrawer(app);
+    const checkbox = findBySelector<HTMLInputElement>(drawer, "#confirm-index-deletion");
+    assert.equal(checkbox.checked, true);
+
+    await click(checkbox);
+
+    assert.deepEqual(app.lastBody("PUT /api/index/settings"), { confirm_index_deletion: false });
+    assert.equal(findBySelector<HTMLInputElement>(drawer, "#confirm-index-deletion").checked, false);
+    assert.match(app.notice(), /確認通知を無効にしました/);
+  });
+});
+
+test("インデックス更新間隔を変えると、その分数で検索し、次回の起動でも同じ値を使う", async () => {
+  await withApp({ routes: { "POST /api/search": searchResponse([searchResult()]) } }, async (app) => {
+    const drawer = await openDrawer(app);
+    await typeInto(findBySelector<HTMLInputElement>(drawer, "#refresh-window"), "30");
+    await app.runSearch();
+
+    assert.equal(app.lastBody("POST /api/search").refresh_window_minutes, 30);
+    assert.equal(app.dom.window.localStorage.getItem("refresh_window_minutes"), "30");
+  });
+});
+
+test("インデックス更新間隔が不正なときは検索せず、設定メニューを開いて知らせる", async () => {
+  await withApp({}, async (app) => {
+    const drawer = await openDrawer(app);
+    await typeInto(findBySelector<HTMLInputElement>(drawer, "#refresh-window"), "-1");
+    await click(findByText(drawer, "button", "閉じる"));
+    await app.runSearch();
+
+    assert.equal(app.api.requestsTo("POST /api/search").length, 0);
+    assert.match(app.error(), /更新間隔は 0 以上の分で入力してください/);
+    assert.equal(app.isDrawerOpen(), true);
+  });
+});
+
+test("失敗したファイルの一覧は、開いたときに読み込み、開いているあいだは検索のたびに更新する", async () => {
+  let failedFiles = [
+    { normalized_path: "/docs/broken.pdf", file_name: "broken.pdf", error_message: "壊れた PDF", last_failed_at: "2026-01-01T00:00:00Z" },
+  ];
+  await withApp(
+    {
+      routes: {
+        "GET /api/index/failed-files": () => ({ items: failedFiles }),
+        "POST /api/search": searchResponse([searchResult()]),
+      },
+    },
+    async (app) => {
+      const drawer = await openDrawer(app);
+      assert.equal(app.api.requestsTo("GET /api/index/failed-files").length, 0, "開くまでは読み込まない");
+
+      await click(findByText(drawer, "button", "失敗したファイル"));
+      assert.equal(app.api.requestsTo("GET /api/index/failed-files").length, 1);
+      assert.match(normalizeText(drawer.textContent), /broken\.pdf/);
+      assert.match(normalizeText(drawer.textContent), /壊れた PDF/);
+
+      failedFiles = [];
+      await app.runSearch();
+      assert.equal(app.api.requestsTo("GET /api/index/failed-files").length, 2);
+      assert.match(normalizeText(drawer.textContent), /記録されている失敗ファイルはありません/);
+    },
+  );
+});
+
+test("データベースの初期化は、確認のうえ実行し、検索結果・失敗ファイル・状態表示を初期状態へ戻す", async () => {
+  const resetStatus = indexStatus({ total_files: 0, error_count: 0 });
+  await withApp(
+    {
+      routes: {
+        "GET /api/index/status": indexStatus({ total_files: 120, error_count: 2 }),
+        "GET /api/index/failed-files": {
+          items: [{ normalized_path: "/docs/broken.pdf", file_name: "broken.pdf", error_message: "壊れた PDF", last_failed_at: "2026-01-01T00:00:00Z" }],
+        },
+        "POST /api/search": searchResponse([searchResult({ file_name: "alpha.md" })]),
+        "POST /api/index/reset": { message: "reset", status: resetStatus },
+      },
+    },
+    async (app) => {
+      await app.runSearch();
+      const drawer = await openDrawer(app);
+      await click(findByText(drawer, "button", "失敗したファイル"));
+      assert.match(normalizeText(findBySelector(drawer, ".status-card").textContent), /総ファイル数: 120/);
+
+      app.dom.setConfirmAnswer(false);
+      await click(findByText(drawer, "button", "データベースを初期化"));
+      assert.equal(app.api.requestsTo("POST /api/index/reset").length, 0, "確認を断ったら初期化しない");
+      assert.match(last(app.dom.dialogs) ?? "", /検索インデックス、対象キャッシュ、失敗履歴がすべて消えます/);
+
+      app.dom.setConfirmAnswer(true);
+      await click(findByText(drawer, "button", "データベースを初期化"));
+
+      assert.equal(app.api.requestsTo("POST /api/index/reset").length, 1);
+      assert.match(app.notice(), /データベースを初期化しました/);
+      assert.equal(hasElement(app.container, "article.result-card"), false);
+      assert.match(normalizeText(findBySelector(drawer, ".status-card").textContent), /総ファイル数: 0/);
+      assert.doesNotMatch(normalizeText(drawer.textContent), /broken\.pdf/);
+
+      await app.openPage("検索対象フォルダ");
+      assert.equal(queryAllByText(app.container, ".target-list-item", "").length, 0);
+    },
+  );
+});
+
+test("データベースの初期化に失敗したら、理由をエラーとして表示し、検索結果は残す", async () => {
+  await withApp(
+    {
+      routes: {
+        "POST /api/search": searchResponse([searchResult({ file_name: "alpha.md" })]),
+        "POST /api/index/reset": httpError(409, "Indexing is already running."),
+      },
+    },
+    async (app) => {
+      await app.runSearch();
+      const drawer = await openDrawer(app);
+      await click(findByText(drawer, "button", "データベースを初期化"));
+
+      assert.match(app.error(), /Indexing is already running\./);
+      assert.equal(hasElement(app.container, "article.result-card"), true);
+    },
+  );
+});
+
+test("設定の読み込みに失敗したら、起動時にエラーを表示する", async () => {
+  await withApp({ routes: { "GET /api/index/settings": httpError(500, "設定を読めません") } }, async (app) => {
+    assert.match(app.error(), /設定を読めません/);
+  });
+});
diff --git a/frontend/src/settingsNormalization.ts b/frontend/src/settingsNormalization.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bcc1bfbdc955fabb44d01e94fad138e4174e09f8
--- /dev/null
+++ b/frontend/src/settingsNormalization.ts
@@ -0,0 +1,73 @@
+/**
+ * 検索ルール・設定値の正規化。
+ * 画面で編集した除外キーワード・非表示キーワード・類似語リスト・gantt parent ID を、
+ * 保存形式（改行区切り・重複なし）へ安定化する。バックエンドの正規化と同じ規則に合わせている。
+ **/
+
+/**
+ * 除外キーワードは空行除去・前後空白除去・重複排除を行い、保存形式を安定化する。
+ */
+export function normalizeExcludeKeywords(value: string): string {
+  return [...new Set(value.split(/\r?\n/).map((item) => item.trim()).filter(Boolean))].join("\n");
+}
+
+/**
+ * 一覧から隠したい確認済みキーワードも改行区切りで正規化し、再起動後も同じ順序で扱えるようにする。
+ */
+export function normalizeHiddenIndexedTargets(value: string): string {
+  return [...new Set(value.split(/\r?\n/).map((item) => item.trim()).filter(Boolean))].join("\n");
+}
+
+/**
+ * 類似語・専門用語リストは 1 行を 1 エントリとして扱い、
+ * コロン前の類似語の重複を除去し、コロン後の意味・解説を保持する。
+ */
+export function normalizeSynonymGroups(value: string | null | undefined): string {
+  return (value ?? "")
+    .split(/\r?\n/)
+    .map((line) => {
+      const lineStr = line.trim();
+      if (!lineStr) return "";
+      let termsPart = lineStr;
+      let descPart = "";
+      if (lineStr.includes(":")) {
+        const idx = lineStr.indexOf(":");
+        termsPart = lineStr.slice(0, idx);
+        descPart = lineStr.slice(idx + 1).trim();
+      } else if (lineStr.includes("：")) {
+        const idx = lineStr.indexOf("：");
+        termsPart = lineStr.slice(0, idx);
+        descPart = lineStr.slice(idx + 1).trim();
+      }
+
+      const rawTokens = termsPart.split(/[，,]/).map((item) => item.trim()).filter(Boolean);
+      const normalizedTokens = [...new Set(rawTokens.map((item) => item.toLowerCase()))];
+      const originalTokens: string[] = [];
+      for (const token of rawTokens) {
+        if (!normalizedTokens.includes(token.toLowerCase())) {
+          continue;
+        }
+        if (originalTokens.some((item) => item.toLowerCase() === token.toLowerCase())) {
+          continue;
+        }
+        originalTokens.push(token);
+      }
+      const termsStr = originalTokens.join(",");
+      if (!termsStr) return "";
+      return descPart ? `${termsStr}:${descPart}` : termsStr;
+    })
+    .filter(Boolean)
+    .join("\n");
+}
+
+/**
+ * gantt parent ID は 0 以上の整数だけを保存対象にする。
+ */
+export function normalizeGanttParent(value: string | number | null | undefined): number {
+  const rawValue = String(value ?? "").trim();
+  if (!/^\d+$/.test(rawValue)) {
+    return 0;
+  }
+  const parsed = Number.parseInt(rawValue, 10);
+  return Number.isFinite(parsed) && parsed >= 0 ? parsed : 0;
+}
diff --git a/frontend/src/stylesInteraction.test.ts b/frontend/src/stylesInteraction.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..67025836ca5ac98b0d2b751bd65c0f76c4208412
--- /dev/null
+++ b/frontend/src/stylesInteraction.test.ts
@@ -0,0 +1,139 @@
+/**
+ * アプリのスタイルシートを読み込んだ状態で画面を描画し、実際の要素に適用されるスタイルを検証するテスト。
+ * jsdom はレイアウトを計算しないため、確かめるのは「どの値が適用されるか」まで（見た目の位置や大きさは対象外）。
+ */
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { searchResponse, searchResult } from "./testing/apiFixtures.ts";
+import { withApp } from "./testing/appHarness.ts";
+import { click, findBySelector, findByText, styleOf } from "./testing/dom.ts";
+import { closeRenderer } from "./testing/render.ts";
+
+test.after(() => closeRenderer());
+
+const routes = {
+  "POST /api/search": searchResponse([
+    searchResult({ file_name: "alpha.md", full_path: "/docs/alpha.md", match_source: "both", salient_sentence: "核心の文" }),
+  ]),
+  "GET /api/index/targets": { items: [{ full_path: "/docs", source_type: "local", indexed_file_count: 3, last_indexed_at: null }] },
+  "GET /api/export/config": { export_folder: "/tmp/export", default_select_count: 10 },
+  "POST /api/export/ai-html": {
+    html_content: "<html></html>",
+    file_name: "a.html",
+    total_documents: 1,
+    total_images_embedded: 0,
+    size_bytes: 13,
+    expanded_nodes: [],
+  },
+};
+
+test("検索結果のフルパスは、文字を選択して部分コピーできる", async () => {
+  await withApp({ routes, withStyles: true }, async (app) => {
+    await app.runSearch();
+
+    assert.equal(styleOf(findBySelector(app.container, "code.result-path-text"), "user-select"), "text");
+  });
+});
+
+test("検索結果の抜粋は、折りたたんでいるあいだ 5 行で切る", async () => {
+  await withApp({ routes, withStyles: true }, async (app) => {
+    await app.runSearch();
+    const snippet = findBySelector(app.container, "p.result-snippet-clamped");
+
+    assert.equal(styleOf(snippet, "-webkit-line-clamp"), "5");
+    assert.equal(styleOf(snippet, "overflow"), "hidden");
+  });
+});
+
+test("一致理由のバッジと核心文は、種類ごとに色分けして表示する", async () => {
+  await withApp({ routes, withStyles: true }, async (app) => {
+    await app.runSearch();
+    const badge = findBySelector(app.container, ".result-match-badge.match-both");
+
+    assert.notEqual(styleOf(badge, "background-color"), "");
+    assert.notEqual(styleOf(badge, "color"), styleOf(findBySelector(app.container, "code.result-path-text"), "color"));
+    assert.notEqual(styleOf(findBySelector(app.container, ".result-salient-sentence"), "border-left-color"), "");
+  });
+});
+
+test("検索対象の切り替えボタンは、幅が狭くてもラベルを折り返さない", async () => {
+  await withApp({ routes, withStyles: true }, async (app) => {
+    const button = findByText(app.container, "button.source-toggle-button", "ローカル");
+
+    assert.equal(styleOf(button, "white-space"), "nowrap");
+    assert.equal(styleOf(button, "flex-shrink"), "0");
+    assert.equal(styleOf(findBySelector(app.container, ".source-toggle"), "flex-shrink"), "0");
+    assert.equal(styleOf(findBySelector(app.container, ".path-picker-row.top-path-picker"), "flex-wrap"), "wrap");
+  });
+});
+
+test("エラーの帯は赤系で表示する", async () => {
+  await withApp({ routes, withStyles: true }, async (app) => {
+    await app.runSearch("");
+
+    assert.match(app.error(), /検索語を入力してください/);
+    assert.match(styleOf(findBySelector(app.container, ".error-banner"), "background-color"), /239, 68, 68/);
+  });
+});
+
+test("通知の帯は青系で表示する", async () => {
+  await withApp(
+    { routes: { ...routes, "PUT /api/index/settings": (request) => ({ ...(request.body as object) }) }, withStyles: true },
+    async (app) => {
+      await click(findBySelector(app.container, ".search-nav .menu-button"));
+      await click(findBySelector(app.drawer(), "#confirm-index-deletion"));
+
+      assert.match(styleOf(findBySelector(app.container, ".notice-banner"), "background-color"), /59, 130, 246/);
+    },
+  );
+});
+
+test("インデックス済みフォルダ画面は、一覧の部分だけを縦にスクロールさせる", async () => {
+  await withApp({ routes, withStyles: true, page: "インデックス済みフォルダ" }, async (app) => {
+    const list = findBySelector(app.container, ".indexed-targets-list");
+
+    assert.equal(styleOf(list, "overflow-y"), "auto");
+    assert.equal(styleOf(list, "min-height"), "0px");
+  });
+});
+
+test("設定メニューは、閉じているあいだ画面の外へずらして操作できないようにし、開くと元の位置へ戻す", async () => {
+  await withApp({ routes, withStyles: true }, async (app) => {
+    assert.equal(styleOf(app.drawer(), "pointer-events"), "none");
+    const closedTransform = styleOf(app.drawer(), "transform");
+
+    await click(findBySelector(app.container, ".search-nav .menu-button"));
+
+    assert.notEqual(styleOf(app.drawer(), "pointer-events"), "none");
+    assert.notEqual(styleOf(app.drawer(), "transform"), closedTransform);
+  });
+});
+
+test("AIインプットの候補の表は、画面の高さに合わせて広げ、表の中だけをスクロールさせる", async () => {
+  await withApp({ routes, withStyles: true }, async (app) => {
+    await app.runSearch();
+    await app.openPage("AIインプット");
+    const table = findBySelector(app.container, ".ai-candidate-table-container");
+
+    assert.match(styleOf(table, "height"), /100vh/);
+    assert.equal(styleOf(table, "max-height"), "none", "固定の高さで切らない");
+    assert.equal(styleOf(table, "overflow-y"), "auto");
+  });
+});
+
+test("AIインプットのプレビューは、余白なしで画面全体を使う", async () => {
+  await withApp({ routes, withStyles: true }, async (app) => {
+    await app.runSearch();
+    await app.openPage("AIインプット");
+    await click(findBySelector(app.container, "button.ai-generate-top-btn"));
+    const backdrop = findBySelector(app.dom.window.document.body, ".ai-preview-modal-backdrop");
+    const modal = findBySelector(backdrop, ".ai-preview-modal");
+
+    assert.equal(styleOf(backdrop, "position"), "fixed");
+    assert.equal(styleOf(backdrop, "padding"), "0px");
+    assert.equal(styleOf(modal, "width"), "100vw");
+    assert.equal(styleOf(modal, "height"), "100vh");
+    assert.equal(styleOf(modal, "max-width"), "none");
+  });
+});
diff --git a/frontend/src/targetsInteraction.test.ts b/frontend/src/targetsInteraction.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..341920958704907d3dcd05cdc4d2b3e0a4d88714
--- /dev/null
+++ b/frontend/src/targetsInteraction.test.ts
@@ -0,0 +1,355 @@
+/**
+ * インデックス済みフォルダ・インデックス済み Web ページ・検索対象フォルダの各画面を DOM へ描画し、
+ * 操作のあとの API 呼び出しと表示を検証するテスト。
+ */
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { appSettings, indexStatus, searchResponse, searchResult } from "./testing/apiFixtures.ts";
+import { withApp, type Routes } from "./testing/appHarness.ts";
+import { click, findBySelector, findByText, hasElement, normalizeText, queryAllByText, typeInto, wait, last } from "./testing/dom.ts";
+import { closeRenderer } from "./testing/render.ts";
+
+test.after(() => closeRenderer());
+
+const indexedTargets = [
+  { full_path: "/docs", source_type: "local", indexed_file_count: 12, last_indexed_at: "2026-01-01T00:00:00Z" },
+  { full_path: "/docs/archive", source_type: "local", indexed_file_count: 2, last_indexed_at: "2026-01-01T00:00:00Z" },
+  { full_path: "/work/notes", source_type: "local", indexed_file_count: 5, last_indexed_at: null },
+];
+const searchTargets = [
+  { full_path: "/docs", source_type: "local", is_enabled: true, last_indexed_at: "2026-01-01T00:00:00Z", indexed_file_count: 12 },
+  { full_path: "/work/notes", source_type: "local", is_enabled: false, last_indexed_at: null, indexed_file_count: 0 },
+];
+
+function targetRoutes(overrides: Routes = {}): Routes {
+  return {
+    "GET /api/index/targets": { items: indexedTargets },
+    "GET /api/index/search-targets": { items: searchTargets },
+    ...overrides,
+  };
+}
+
+function listedPaths(container: ParentNode): string[] {
+  return [...container.querySelectorAll(".target-list-path")].map((element) => normalizeText(element.textContent));
+}
+
+function row(container: ParentNode, path: string): HTMLElement {
+  const found = [...container.querySelectorAll<HTMLElement>(".target-list-item")].find(
+    (item) => normalizeText(item.querySelector(".target-list-path")?.textContent) === path,
+  );
+  assert.ok(found, `${path} の行が表示される`);
+  return found;
+}
+
+test("インデックス済みフォルダ画面は、一覧をファイル数の多い順に並べ、件数・ファイル数を表示する", async () => {
+  await withApp({ routes: targetRoutes(), page: "インデックス済みフォルダ" }, async (app) => {
+    assert.equal(last(app.api.requestsTo("GET /api/index/targets"))?.query.get("source_type"), "local");
+    assert.deepEqual(listedPaths(app.container), ["/docs", "/work/notes", "/docs/archive"]);
+    assert.match(normalizeText(findBySelector(app.container, ".section-header-actions").textContent), /3\s*件/);
+    assert.match(normalizeText(row(app.container, "/docs").textContent), /ファイル数\s*:\s*12/);
+  });
+});
+
+test("キーワードで一覧を絞り込み、クリアで戻せる", async () => {
+  await withApp({ routes: targetRoutes(), page: "インデックス済みフォルダ" }, async (app) => {
+    const filter = findBySelector<HTMLInputElement>(app.container, "input.indexed-targets-search");
+    await typeInto(filter, "archive");
+
+    assert.deepEqual(listedPaths(app.container), ["/docs/archive"]);
+
+    await click(findBySelector(app.container, "button[aria-label='絞り込みをクリア']"));
+    assert.equal(listedPaths(app.container).length, 3);
+  });
+});
+
+test("絞り込みに使ったキーワードを除外キーワードの下書きへ追加でき、検索ルール管理で保存待ちになる", async () => {
+  await withApp({ routes: targetRoutes(), page: "インデックス済みフォルダ" }, async (app) => {
+    const addButton = findByText(app.container, "button", "除外キーワードへ追加") as HTMLButtonElement;
+    assert.equal(addButton.disabled, true, "キーワードが空のあいだは押せない");
+
+    await typeInto(findBySelector<HTMLInputElement>(app.container, "input.indexed-targets-search"), "archive");
+    await click(findByText(app.container, "button", "除外キーワードへ追加"));
+
+    assert.match(app.notice(), /「archive」を除外キーワードへ追加しました/);
+    assert.equal(findBySelector<HTMLInputElement>(app.container, "input.indexed-targets-search").value, "");
+    assert.equal(app.isDrawerOpen(), true);
+
+    await app.openPage("検索ルール管理");
+    assert.match(app.text(), /archive/);
+  });
+});
+
+test("非表示キーワードは一覧から該当フォルダを隠し、共有設定へ自動で保存する", async () => {
+  await withApp(
+    {
+      routes: targetRoutes({
+        "PUT /api/index/settings": (request) =>
+          appSettings({ hidden_indexed_targets: (request.body as { hidden_indexed_targets: string }).hidden_indexed_targets }),
+      }),
+      page: "インデックス済みフォルダ",
+    },
+    async (app) => {
+      await typeInto(findBySelector<HTMLTextAreaElement>(app.container, "textarea.indexed-targets-hide-box"), "work");
+
+      assert.deepEqual(listedPaths(app.container), ["/docs", "/docs/archive"]);
+
+      await wait(450);
+      assert.deepEqual(app.lastBody("PUT /api/index/settings"), { hidden_indexed_targets: "work" });
+    },
+  );
+});
+
+test("保存済みの非表示キーワードは、開いた時点で一覧に効いている", async () => {
+  await withApp(
+    {
+      routes: targetRoutes({ "GET /api/index/settings": appSettings({ hidden_indexed_targets: "archive" }) }),
+      page: "インデックス済みフォルダ",
+    },
+    async (app) => {
+      assert.deepEqual(listedPaths(app.container), ["/docs", "/work/notes"]);
+      assert.equal(findBySelector<HTMLTextAreaElement>(app.container, "textarea.indexed-targets-hide-box").value, "archive");
+    },
+  );
+});
+
+test("選択したフォルダのインデックスを、確認のうえ削除し、検索結果も空にする", async () => {
+  let remaining = indexedTargets;
+  await withApp(
+    {
+      routes: targetRoutes({
+        "GET /api/index/targets": () => ({ items: remaining }),
+        "DELETE /api/index/targets": (request) => {
+          const paths = (request.body as { target_paths: string[] }).target_paths;
+          remaining = remaining.filter((item) => !paths.includes(item.full_path));
+          return { deleted_count: paths.length };
+        },
+        "POST /api/search": searchResponse([searchResult({ file_name: "alpha.md", full_path: "/docs/archive/alpha.md" })]),
+      }),
+    },
+    async (app) => {
+      await app.runSearch();
+      await app.openPage("インデックス済みフォルダ");
+      const deleteButton = () => findByText(app.container, "button", "選択したフォルダのインデックスを削除") as HTMLButtonElement;
+      assert.equal(deleteButton().disabled, true, "何も選んでいないあいだは押せない");
+
+      await click(findBySelector(row(app.container, "/docs/archive"), "input[type='checkbox']"));
+      assert.match(normalizeText(findBySelector(app.container, ".indexed-targets-selection-status").textContent), /選択中: 1件/);
+
+      app.dom.setConfirmAnswer(false);
+      await click(deleteButton());
+      assert.equal(app.api.requestsTo("DELETE /api/index/targets").length, 0, "確認を断ったら削除しない");
+
+      app.dom.setConfirmAnswer(true);
+      await click(deleteButton());
+
+      assert.deepEqual(app.lastBody("DELETE /api/index/targets"), { target_paths: ["/docs/archive"] });
+      assert.deepEqual(listedPaths(app.container), ["/docs", "/work/notes"]);
+      assert.match(app.notice(), /1件のインデックス済みフォルダを削除し、一覧への反映を確認しました/);
+
+      await app.openPage("検索");
+      assert.equal(hasElement(app.container, "article.result-card"), false, "削除したインデックスの検索結果を残さない");
+    },
+  );
+});
+
+test("インデックス取得中は削除ボタンを押せない", async () => {
+  await withApp(
+    { routes: targetRoutes({ "GET /api/index/status": indexStatus({ is_running: true }) }), page: "インデックス済みフォルダ" },
