diff --git a/backend/app/services/index_cleanup.py b/backend/app/services/index_cleanup.py
new file mode 100644
index 0000000000000000000000000000000000000000..54ef6a7d2d3f86a6ff24772ea7308ebd6f02d6ed
--- /dev/null
+++ b/backend/app/services/index_cleanup.py
@@ -0,0 +1,97 @@
+"""
+検索ルール（除外キーワード・対象拡張子）の変更で対象外になったファイルを、インデックスから取り除く。
+
+全文検索DB（files / file_segments / failed_files）と、全モデル分のベクトルDBの両方を掃除する。
+掃除の失敗（DB ロック等）で設定の保存そのものを失敗させないよう、失敗は警告ログに残して続行する。
+"""
+
+from __future__ import annotations
+
+import logging
+from collections.abc import Callable
+from pathlib import Path
+from sqlite3 import Error as SQLiteError
+
+from app.config import settings
+from app.services import app_settings_store, exclude_rules
+from app.services.indexed_file_store import IndexedFileStore
+
+logger = logging.getLogger(__name__)
+
+
+def cleanup_excluded_extension_files(files: IndexedFileStore, *, allowed_extensions_text: str) -> None:
+    """
+    検索ルール管理で除外された拡張子を持つローカルファイルを、
+    DB（files, file_segments, failed_files）および全モデル分のベクトルDBからクリーンアップする。
+    """
+    allowed_set = set(app_settings_store.parse_extension_entries(allowed_extensions_text))
+    if not allowed_set:
+        return
+    sorted_allowed = tuple(sorted(allowed_set, key=len, reverse=True))
+
+    def has_allowed_extension(path: str) -> bool:
+        return path.lower().endswith(sorted_allowed)
+
+    try:
+        rows = files.connection.execute(
+            "SELECT id, normalized_path, file_ext FROM files WHERE source_type = 'local'"
+        ).fetchall()
+        files.delete_file_rows(
+            int(row["id"])
+            for row in rows
+            if str(row["file_ext"] or "").lower() not in allowed_set
+            and not has_allowed_extension(str(row["normalized_path"]))
+        )
+        files.delete_failed_file_rows(
+            lambda path: not path.lower().startswith(("http://", "https://")) and not has_allowed_extension(path)
+        )
+    except SQLiteError:
+        # クリーンアップの失敗（DB ロック等）で設定保存そのものを失敗させない
+        files.rollback()
+        logger.warning("Failed to clean up index rows for excluded extensions.", exc_info=True)
+    purge_vector_documents(lambda path: not has_allowed_extension(path))
+
+
+def cleanup_excluded_keyword_files(files: IndexedFileStore, *, new_exclude_keywords: str) -> None:
+    """
+    検索ルール管理で追加された除外キーワードに合致するファイルを、
+    DB（files, file_segments, failed_files）および全モデル分のベクトルDBからクリーンアップする。
+    """
+    raw_keywords = exclude_rules.parse_exclude_keywords(new_exclude_keywords)
+    if not raw_keywords:
+        return
+    keyword_set, substring_keywords, excluded_path_prefixes = exclude_rules.compile_exclude_keywords(raw_keywords)
+
+    def is_excluded(path: str) -> bool:
+        return exclude_rules.should_exclude_path_with_keywords(
+            Path(path), keyword_set, substring_keywords, excluded_path_prefixes
+        )
+
+    try:
+        rows = files.connection.execute("SELECT id, normalized_path FROM files").fetchall()
+        files.delete_file_rows(int(row["id"]) for row in rows if is_excluded(str(row["normalized_path"])))
+        files.delete_failed_file_rows(is_excluded)
+    except SQLiteError:
+        # クリーンアップの失敗（DB ロック等）で設定保存そのものを失敗させない
+        files.rollback()
+        logger.warning("Failed to clean up index rows for excluded keywords.", exc_info=True)
+    purge_vector_documents(is_excluded)
+
+
+def purge_vector_documents(should_delete: Callable[[str], bool]) -> None:
+    """
+    全モデル分のベクトルDB（data_dir 内の vector_index_*.db）から、条件に合致する文書を削除する。
+    ベクトル側の失敗で設定保存全体を止めないよう、失敗は警告ログに残して継続する。
+    """
+    try:
+        from app.vector.db import delete_documents, get_all_documents_metadata, list_vector_db_paths
+        from app.vector.state import vector_state
+
+        deleted_count = 0
+        for db_path in list_vector_db_paths(settings.data_dir):
+            target_paths = [path for path in get_all_documents_metadata(db_path) if should_delete(path)]
+            deleted_count += delete_documents(db_path, target_paths)
+        if deleted_count and vector_state.searcher:
+            vector_state.searcher.reset_index()
+    except Exception:
+        logger.warning("Failed to clean up vector index documents.", exc_info=True)
diff --git a/backend/app/services/index_run_state.py b/backend/app/services/index_run_state.py
new file mode 100644
index 0000000000000000000000000000000000000000..dd7bd5d1fbd944bbb0c9539b02404e9fbb2bc98c
--- /dev/null
+++ b/backend/app/services/index_run_state.py
@@ -0,0 +1,202 @@
+"""
+インデックス実行状態（index_runs テーブル）と中止要求の管理。
+
+実行中フラグは DB に 1 行だけ持ち、検索前更新・変更通知・スケジューラーなど複数の契機が
+同時に走査を始めないようにする。中止要求は同じプロセス内ではメモリ上のフラグで、
+別プロセス・別接続からは DB のフラグで受け取る。
+"""
+
+from __future__ import annotations
+
+import threading
+import time as time_module
+from dataclasses import dataclass
+from datetime import UTC, datetime
+from sqlite3 import Connection
+
+from fastapi import HTTPException, status
+
+from app.models.indexing import IndexStatusResponse
+
+# 別接続からの中止要求を DB へ確認しに行く最短間隔。走査速度へ影響しない程度に間引く。
+CANCEL_DATABASE_POLL_INTERVAL_SECONDS = 0.25
+
+
+class IndexingCancelledError(Exception):
+    """
+    利用者がインデックス中止を要求したことを表す。
+    """
+
+
+class IndexAlreadyRunningError(Exception):
+    """
+    別のインデックス処理が実行中のため、新しい走査を開始できなかったことを表す。
+    """
+
+
+class IndexRunController:
+    """
+    DB接続ごとに、インデックス中止要求の状態を保持する。
+    """
+
+    def __init__(self) -> None:
+        self._lock = threading.Lock()
+        self._cancel_requested = False
+        self._last_database_check_at = 0.0
+
+    def reset(self) -> None:
+        with self._lock:
+            self._cancel_requested = False
+            self._last_database_check_at = 0.0
+
+    def request_cancel(self) -> None:
+        with self._lock:
+            self._cancel_requested = True
+
+    def is_cancel_requested(self) -> bool:
+        with self._lock:
+            return self._cancel_requested
+
+    def should_check_database_cancel(self, *, now: float, interval_seconds: float) -> bool:
+        with self._lock:
+            if now - self._last_database_check_at < interval_seconds:
+                return False
+            self._last_database_check_at = now
+            return True
+
+
+@dataclass(frozen=True)
+class TargetIndexResult:
+    """
+    1 つの検索対象を走査した結果。
+    exclude_keywords は、走査中に自動で除外したパス（到達不能な共有先など）を加えた除外条件。
+    """
+
+    file_count: int
+    error_count: int
+    exclude_keywords: str
+
+
+class IndexRunState:
+    """index_runs テーブルの 1 行と、この接続で受けた中止要求を扱う。"""
+
+    def __init__(self, connection: Connection) -> None:
+        self.connection = connection
+        self.controller = IndexRunController()
+
+    def is_running(self) -> bool:
+        """インデックス処理が実行中かを返す。"""
+        row = self.connection.execute("SELECT is_running FROM index_runs WHERE id = 1").fetchone()
+        return bool(row["is_running"]) if row else False
+
+    def try_begin(self, *, started_at: str) -> bool:
+        """
+        実行中フラグを「未実行のときだけ」立てる。立てられた場合だけ True を返す。
+        確認と設定を 1 つの UPDATE で行うため、複数の契機（検索前更新・変更通知・スケジューラー）が
+        同時に走査を始めることはない。
+        """
+        cursor = self.connection.execute(
+            """
+            UPDATE index_runs
+            SET is_running = 1,
+                cancel_requested = 0,
+                last_started_at = ?,
+                last_error = NULL
+            WHERE id = 1 AND is_running = 0
+            """,
+            (started_at,),
+        )
+        self.connection.commit()
+        return cursor.rowcount == 1
+
+    def update(
+        self,
+        *,
+        is_running: bool | None = None,
+        cancel_requested: bool | None = None,
+        last_started_at: str | None = None,
+        last_finished_at: str | None = None,
+        last_error: str | None = None,
+        total_files: int | None = None,
+        error_count: int | None = None,
+    ) -> None:
+        """
+        インデックス実行ステータスを更新する。
+        """
+        self.connection.execute(
+            """
+            UPDATE index_runs
+            SET is_running = COALESCE(?, is_running),
+                cancel_requested = COALESCE(?, cancel_requested),
+                last_started_at = COALESCE(?, last_started_at),
+                last_finished_at = COALESCE(?, last_finished_at),
+                last_error = ?,
+                total_files = COALESCE(?, total_files),
+                error_count = COALESCE(?, error_count)
+            WHERE id = 1
+            """,
+            (
+                int(is_running) if is_running is not None else None,
+                int(cancel_requested) if cancel_requested is not None else None,
+                last_started_at,
+                last_finished_at,
+                last_error,
+                total_files,
+                error_count,
+            ),
+        )
+        self.connection.commit()
+
+    def get_status(self) -> IndexStatusResponse:
+        """直近の実行状態（開始・終了時刻、件数、エラー）を返す。"""
+        row = self.connection.execute(
+            """
+            SELECT last_started_at, last_finished_at, total_files, error_count, is_running, last_error
+                   , cancel_requested
+            FROM index_runs
+            WHERE id = 1
+            """
+        ).fetchone()
+        if row is None:
+            raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail="Index status unavailable.")
+        return IndexStatusResponse.model_validate(dict(row))
+
+    def request_cancel(self) -> None:
+        """
+        実行中インデックスへ中止要求を送る。
+        """
+        self.controller.request_cancel()
+        self.update(cancel_requested=True)
+
+    def raise_if_cancel_requested(self) -> None:
+        """
+        中止要求が来ていたら即座に処理を打ち切る。
+        別プロセス・別接続からの要求は、速度影響を避けるため短い間隔で DB を確認する。
+        """
+        if self.controller.is_cancel_requested():
+            raise IndexingCancelledError("Indexing was cancelled.")
+        should_check_database = self.controller.should_check_database_cancel(
+            now=time_module.monotonic(),
+            interval_seconds=CANCEL_DATABASE_POLL_INTERVAL_SECONDS,
+        )
+        if should_check_database and self._is_cancel_requested_in_database():
+            raise IndexingCancelledError("Indexing was cancelled.")
+
+    def _is_cancel_requested_in_database(self) -> bool:
+        """
+        プロセスをまたいで共有される中止要求フラグを読み取る。
+        """
+        row = self.connection.execute("SELECT cancel_requested FROM index_runs WHERE id = 1").fetchone()
+        return bool(row["cancel_requested"]) if row else False
+
+    def recover_interrupted(self) -> bool:
+        """前回プロセスの終了で残った実行中状態を、起動時に安全に解除する。"""
+        if not self.is_running():
+            return False
+        self.update(
+            is_running=False,
+            cancel_requested=False,
+            last_finished_at=datetime.now(UTC).isoformat(),
+            last_error="Indexing was interrupted by application restart.",
+        )
+        return True
diff --git a/backend/app/services/index_scope.py b/backend/app/services/index_scope.py
new file mode 100644
index 0000000000000000000000000000000000000000..dc2f45d905e59e3d898bab5518fe68d0816d58e8
--- /dev/null
+++ b/backend/app/services/index_scope.py
@@ -0,0 +1,133 @@
+"""
+インデックスの走査範囲（階層・拡張子・除外）とフォルダの包含関係を判定する純粋関数。
+
+走査後の後始末で「今回の走査が責任を持つ範囲か」を決めるために使う。
+範囲外の行（より深い階層、対象外の拡張子、除外されたパス）は、別条件の走査結果かもしれないので消さない。
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from app.services import exclude_rules
+
+
+def relative_directory_depth(root_path: str, descendant_path: str) -> int:
+    """
+    ルートから子孫フォルダまでの相対ディレクトリ階層数を返す。
+    大文字小文字の差異や末尾スラッシュの二重化を防ぐため正規化して比較する。
+    """
+    r_path = root_path.replace("\\", "/").rstrip("/")
+    d_path = descendant_path.replace("\\", "/").rstrip("/")
+
+    if not r_path:
+        r_path = "/"
+    if not d_path:
+        d_path = "/"
+
+    if r_path.lower() == d_path.lower():
+        return 0
+
+    root_prefix = r_path if r_path.endswith("/") else f"{r_path}/"
+    if not d_path.lower().startswith(root_prefix.lower()):
+        return 0
+    relative_path = d_path[len(root_prefix):]
+    return len([part for part in relative_path.split("/") if part])
+
+
+def is_path_within_index_depth(normalized_path: str, *, root_path: str, index_depth: int | None) -> bool:
+    """
+    指定パスが今回の index_depth で走査責任を持つ階層内か判定する。
+    """
+    if index_depth is None:
+        return True
+    if index_depth < 0:
+        return False
+
+    if root_path == "/":
+        relative_path = normalized_path.lstrip("/")
+    elif normalized_path == root_path:
+        relative_path = ""
+    elif normalized_path.startswith(f"{root_path}/"):
+        relative_path = normalized_path[len(root_path) + 1:]
+    else:
+        return False
+
+    if not relative_path:
+        return True
+    relative_parts = [part for part in relative_path.split("/") if part]
+    file_depth = max(len(relative_parts) - 1, 0)
+    return file_depth <= index_depth
+
+
+def is_path_within_extension_scope(
+    normalized_path: str,
+    *,
+    file_ext: str | None = None,
+    allowed_extensions: frozenset[str] | None,
+) -> bool:
+    """
+    指定パスが今回の拡張子フィルタで走査責任を持つ対象か判定する。
+    """
+    if allowed_extensions is None:
+        return True
+    normalized_file_ext = str(file_ext or "").lower()
+    if normalized_file_ext in allowed_extensions:
+        return True
+    lower_path = normalized_path.lower()
+    return any(lower_path.endswith(extension) for extension in sorted(allowed_extensions, key=len, reverse=True))
+
+
+def is_path_excluded_from_current_scope(
+    normalized_path: str,
+    *,
+    keyword_set: frozenset[str] | None,
+    substring_keywords: list[str] | None,
+    excluded_path_prefixes: tuple[str, ...] | None,
+) -> bool:
+    """
+    今回の除外条件で走査しなかったパスか判定する。
+    """
+    if excluded_path_prefixes and exclude_rules.is_excluded_path_prefix(normalized_path, excluded_path_prefixes):
+        return True
+    if not keyword_set and not substring_keywords:
+        return False
+
+    path_parts = [part for part in normalized_path.replace("\\", "/").split("/") if part]
+    return any(
+        exclude_rules.is_excluded_name(part, keyword_set or frozenset(), substring_keywords or [])
+        for part in path_parts
+    )
+
+
+def paths_overlap(left: str, right: str) -> bool:
+    """
+    フォルダどうしが同一または祖先・子孫関係にあるかを判定する。
+    """
+    return left == right or left.startswith(f"{right}/") or right.startswith(f"{left}/")
+
+
+def find_nearest_target_root(file_path: str, target_roots: list[str]) -> str:
+    """
+    指定ファイルを含む最も深い target ルートを返す。
+    """
+    for root_path in target_roots:
+        if file_path == root_path or file_path.startswith(f"{root_path}/"):
+            return root_path
+    return Path(file_path).parent.as_posix()
+
+
+def expand_indexed_folder_paths(file_path: Path, target_roots: list[str]) -> list[str]:
+    """
+    ファイルから、最も近い target までの祖先フォルダを展開する。
+    """
+    file_path_str = file_path.as_posix()
+    limit_path = find_nearest_target_root(file_path_str, target_roots)
+    folders: list[str] = []
+    current = file_path.parent
+    while True:
+        folders.append(current.as_posix())
+        if current.as_posix() == limit_path or current.parent == current:
+            break
+        current = current.parent
+    return folders
