+    from app.db.connection import get_connection
+    from app.db.schema import initialize_schema
+
+    folder = str(tmp_path / "depth_folder")
+    connection = get_connection()
+    try:
+        initialize_schema(connection)
+        connection.execute(
+            "INSERT INTO targets (full_path, index_depth, created_at, updated_at) VALUES (?, 2, 'now', 'now')",
+            (folder,),
+        )
+        connection.commit()
+    finally:
+        connection.close()
+    sync_index = MagicMock(return_value=None)
+    monkeypatch.setattr(vector_state, "sync_index", sync_index)
+
+    res = client.post("/api/vector/index/start", json={"force_reindex": False})
+
+    assert res.status_code == 200
+    assert sync_index.call_args.kwargs["folder_depths"] == {folder: 2}
+
+
+def test_vector_measure_text_endpoint_does_not_change_the_index(client: TestClient, monkeypatch, tmp_path: Path) -> None:
+    """画面で作った本文の測定は、ファイルもインデックスも変更しないこと"""
+    from app.vector.db import get_db_stats, get_model_db_path
+
+    monkeypatch.setattr(vector_state, "data_dir", tmp_path)
+    vector_state.load_model(use_mock=True, mock_dim=64)
+    try:
+        res = client.post("/api/vector/benchmark/text", json={"name": "preset.md", "content": "# 見出し\n\n本文です。"})
+    finally:
+        vector_state.embedder = None
+        vector_state.searcher = None
+        vector_state.model_path = None
+
+    assert res.status_code == 200
+    data = res.json()
+    assert data["status"] == "measured"
+    assert data["chunk_count"] >= 1
+    assert get_db_stats(get_model_db_path("mock_model", data_dir=tmp_path))["document_count"] == 0
diff --git a/backend/tests/test_vector_exclude_keywords.py b/backend/tests/test_vector_exclude_keywords.py
index 5905a9053f021b1b1450de35ca4ea51483e5f043..1ca46ae75a1ab3038a2b1dcb40aba2f499061aac 100644
--- a/backend/tests/test_vector_exclude_keywords.py
+++ b/backend/tests/test_vector_exclude_keywords.py
@@ -194,3 +194,50 @@ def test_update_app_settings_cleans_up_newly_excluded_keyword_files(
     docs_after = get_all_documents_metadata(db_path)
     assert str(file_keep.resolve()) in docs_after
     assert str(file_drop.resolve()) not in docs_after
+
+
+def _index_into_vector_db(model_identifier: str, target_dir: Path) -> str:
+    """指定モデル用のベクトルDBへ対象フォルダをインデックスし、DBパスを返す。"""
+    from app.vector.embedder import MockEmbedder
+
+    db_path = get_model_db_path(model_identifier, data_dir=settings.data_dir)
+    VectorIndexManager([str(target_dir)], db_path, embedder=MockEmbedder(dim=16)).index_all()
+    return db_path
+
+
+def test_update_app_settings_purges_excluded_extensions_from_every_model_vector_db(tmp_path: Path) -> None:
+    """
+    拡張子を除外して既存インデックスの削除を許可した場合、稼働中モデルを含む全モデル分の
+    ベクトルDBから除外拡張子の文書が削除されること（default DB だけを掃除して実DBに残る不具合の再発防止）。
+    """
+    target_dir = tmp_path / "targets"
+    target_dir.mkdir()
+    markdown_file = target_dir / "note.md"
+    json_file = target_dir / "data.json"
+    markdown_file.write_text("markdown", encoding="utf-8")
+    json_file.write_text('{"key": "value"}', encoding="utf-8")
+    db_paths = [_index_into_vector_db(name, target_dir) for name in ("ruri-v3-30m", "ruri-v3-310m")]
+    for db_path in db_paths:
+        assert set(get_all_documents_metadata(db_path)) == {str(markdown_file.resolve()), str(json_file.resolve())}
+
+    svc = IndexService(connection=_create_db(tmp_path))
+    svc.update_app_settings(index_selected_extensions=".md", clean_excluded_files=True)
+
+    for db_path in db_paths:
+        assert set(get_all_documents_metadata(db_path)) == {str(markdown_file.resolve())}
+
+
+def test_update_app_settings_keeps_vector_documents_when_cleanup_is_not_requested(tmp_path: Path) -> None:
+    """削除を許可しない（clean_excluded_files=False）場合、除外拡張子の文書もベクトルDBに保持されること"""
+    target_dir = tmp_path / "targets"
+    target_dir.mkdir()
+    markdown_file = target_dir / "note.md"
+    json_file = target_dir / "data.json"
+    markdown_file.write_text("markdown", encoding="utf-8")
+    json_file.write_text('{"key": "value"}', encoding="utf-8")
+    db_path = _index_into_vector_db("ruri-v3-30m", target_dir)
+
+    svc = IndexService(connection=_create_db(tmp_path))
+    svc.update_app_settings(index_selected_extensions=".md")
+
+    assert set(get_all_documents_metadata(db_path)) == {str(markdown_file.resolve()), str(json_file.resolve())}
diff --git a/backend/tests/test_vector_indexer.py b/backend/tests/test_vector_indexer.py
index 6ecfae5645048a43ab7311675bae2e5e86712058..9ad795995312e3cebef6604ad2e6b75e642ef023 100644
--- a/backend/tests/test_vector_indexer.py
+++ b/backend/tests/test_vector_indexer.py
@@ -161,3 +161,136 @@ def test_vector_indexer_preserves_files_by_default_when_missing_from_scan(tmp_pa
     assert get_db_stats(db_file)["document_count"] == 1
 
 
+
+
+def _write(path: Path, text: str = "本文") -> Path:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(text, encoding="utf-8")
+    return path
+
+
+def test_scan_files_respects_folder_depth(tmp_path: Path) -> None:
+    """階層数を指定した対象フォルダでは、全文インデックスと同じ深さまでしか走査しない。"""
+    vault = tmp_path / "vault"
+    _write(vault / "root.md")
+    _write(vault / "sub" / "child.md")
+    _write(vault / "sub" / "deep" / "grandchild.md")
+
+    manager = VectorIndexManager(
+        target_folders=[str(vault)],
+        db_path=str(tmp_path / "depth.db"),
+        embedder=MockEmbedder(dim=64),
+        folder_depths={str(vault): 1},
+    )
+
+    assert {path.name for path in manager.scan_files()} == {"root.md", "child.md"}
+
+
+def test_scan_files_uses_the_same_scope_as_the_fulltext_index(tmp_path: Path) -> None:
+    """ドット始まりのフォルダや dist なども、除外キーワードに無ければ全文インデックスと同じく対象にする。"""
+    vault = tmp_path / "vault"
+    _write(vault / "note.md")
+    _write(vault / ".notes" / "hidden.md")
+    _write(vault / "dist" / "built.md")
+    db_file = str(tmp_path / "scope.db")
+
+    without_keywords = VectorIndexManager(target_folders=[str(vault)], db_path=db_file, embedder=MockEmbedder(dim=64))
+    with_keywords = VectorIndexManager(
+        target_folders=[str(vault)],
+        db_path=db_file,
+        embedder=MockEmbedder(dim=64),
+        exclude_keywords=".notes\ndist",
+    )
+
+    assert {path.name for path in without_keywords.scan_files()} == {"note.md", "hidden.md", "built.md"}
+    assert {path.name for path in with_keywords.scan_files()} == {"note.md"}
+
+
+def test_index_all_stops_when_cancel_is_requested(tmp_path: Path) -> None:
+    """中止を要求されたら次のファイルへ進まずに終わる。そこまでに保存した文書は残る。"""
+    vault = tmp_path / "vault"
+    for index in range(5):
+        _write(vault / f"{index}.md", f"本文 {index}")
+    db_file = str(tmp_path / "cancel.db")
+    manager = VectorIndexManager(target_folders=[str(vault)], db_path=db_file, embedder=MockEmbedder(dim=64))
+    processed: list[str] = []
+
+    result = manager.index_all(
+        progress_callback=lambda progress: processed.append(progress.current_file),
+        should_cancel=lambda: len(processed) >= 2,
+    )
+
+    assert result.cancelled is True
+    assert result.new_count == 2
+    assert get_db_stats(db_file)["document_count"] == 2
+
+
+def test_force_reindex_keeps_existing_documents_until_they_are_replaced(tmp_path: Path) -> None:
+    """全件再作成は最初に全データを消さない。途中で中止しても、検索できる状態のまま残る。"""
+    vault = tmp_path / "vault"
+    for index in range(3):
+        _write(vault / f"{index}.md", f"本文 {index}")
+    db_file = str(tmp_path / "force.db")
+    manager = VectorIndexManager(target_folders=[str(vault)], db_path=db_file, embedder=MockEmbedder(dim=64))
+    manager.index_all()
+
+    cancelled = manager.index_all(force_reindex=True, should_cancel=lambda: True)
+
+    assert cancelled.cancelled is True
+    assert get_db_stats(db_file)["document_count"] == 3
+
+
+def test_force_reindex_re_embeds_every_file_and_removes_stale_documents(tmp_path: Path) -> None:
+    """全件再作成が最後まで終わったら、すべてのファイルを作り直し、もう存在しない文書を消す。"""
+    vault = tmp_path / "vault"
+    files = [_write(vault / f"{index}.md", f"本文 {index}") for index in range(3)]
+    db_file = str(tmp_path / "force_full.db")
+    manager = VectorIndexManager(target_folders=[str(vault)], db_path=db_file, embedder=MockEmbedder(dim=64))
+    manager.index_all()
+    files[0].unlink()
+
+    result = manager.index_all(force_reindex=True)
+
+    assert result.cancelled is False
+    assert result.skipped_count == 0
+    assert result.updated_count == 2
+    assert result.deleted_count == 1
+    assert get_db_stats(db_file)["document_count"] == 2
+
+
+def test_force_reindex_keeps_documents_under_unreachable_folders(tmp_path: Path) -> None:
+    """全件再作成でも、到達できない対象フォルダ（未接続のドライブ等）の文書は消さない。"""
+    reachable = tmp_path / "reachable"
+    offline = tmp_path / "offline"
+    _write(reachable / "a.md")
+    _write(offline / "b.md")
+    db_file = str(tmp_path / "force_offline.db")
+    VectorIndexManager(
+        target_folders=[str(reachable), str(offline)], db_path=db_file, embedder=MockEmbedder(dim=64)
+    ).index_all()
+    (offline / "b.md").unlink()
+    offline.rmdir()
+
+    result = VectorIndexManager(
+        target_folders=[str(reachable), str(offline)], db_path=db_file, embedder=MockEmbedder(dim=64)
+    ).index_all(force_reindex=True)
+
+    assert result.deleted_count == 0
+    assert get_db_stats(db_file)["document_count"] == 2
+
+
+def test_measure_text_reports_timings_without_touching_the_index(tmp_path: Path) -> None:
+    """本文を渡す測定は、チャンク化と推論の時間だけを測り、インデックスには何も保存しない。"""
+    db_file = str(tmp_path / "measure.db")
+    manager = VectorIndexManager(target_folders=[], db_path=db_file, embedder=MockEmbedder(dim=64))
+
+    result = manager.measure_text("sample.md", "# 見出し\n\n本文です。\n\n## 次の見出し\n\n続きの本文です。")
+    empty = manager.measure_text("empty.md", "")
+
+    assert result.status == "measured"
+    assert result.relative_path == "sample.md"
+    assert result.chunk_count >= 1
+    assert result.db_time_ms == 0.0
+    assert empty.status == "measured"
+    assert empty.chunk_count == 0
+    assert get_db_stats(db_file)["document_count"] == 0
diff --git a/backend/tests/test_vector_robustness.py b/backend/tests/test_vector_robustness.py
new file mode 100644
index 0000000000000000000000000000000000000000..86c14631fbe2cb6f17375c9d75857cf96bc733df
--- /dev/null
+++ b/backend/tests/test_vector_robustness.py
@@ -0,0 +1,261 @@
+"""
+ベクトルインデックスの堅牢性（アトミック書き込み・失敗の再試行・削除候補の保護・接続の使い回し）の単体テスト。
+
+仕様:
+- 文書とチャンクは 1 トランザクションで保存し、途中失敗時に「チャンクの無い登録済み文書」を残さない。
+- 1 ファイルの失敗で全体を止めず、失敗したファイルは次回の差分更新で再試行される。
+- 到達不能な対象フォルダ配下の文書は、削除許可があっても削除候補にしない。
+- 文書ベクトルとチャンクベクトルは 1 ファイルにつき 1 回のバッチ推論で生成する。
+- 未初期化のベクトルDBに対する検索・統計取得は、例外ではなく 0 件として扱う。
+"""
+
+from pathlib import Path
+import sqlite3
+
+import numpy as np
+import pytest
+
+from app.vector import db as vector_db
+from app.vector.embedder import MockEmbedder
+from app.vector.indexer import VectorIndexManager
+from app.vector.searcher import SearchMode, VectorSearcher
+
+
+class CountingEmbedder(MockEmbedder):
+    """推論呼び出し回数を記録するモック Embedder。"""
+
+    def __init__(self, dim: int = 16) -> None:
+        super().__init__(dim=dim, model_path="mock_model")
+        self.single_calls = 0
+        self.batch_calls = 0
+
+    def encode(self, text: str, is_query: bool = False) -> np.ndarray:
+        self.single_calls += 1
+        return super().encode(text, is_query=is_query)
+
+    def encode_batch(self, texts, is_query: bool = False, batch_size: int = 32) -> np.ndarray:
+        self.batch_calls += 1
+        return super().encode_batch(texts, is_query=is_query, batch_size=batch_size)
+
+
+def _document_paths(db_path: str) -> set[str]:
+    return set(vector_db.get_all_documents_metadata(db_path).keys())
+
+
+def test_save_document_with_chunks_rolls_back_document_when_chunks_fail(tmp_path: Path) -> None:
+    db_path = str(tmp_path / "vector.db")
+    vector_db.init_db(db_path)
+    broken_chunks = [{"chunk_index": 0, "text": "chunk without embedding"}]
+
+    with vector_db.open_db(db_path) as conn:
+        with pytest.raises(KeyError):
+            vector_db.save_document_with_chunks(
+                conn,
+                path="/docs/a.md",
+                title="a",
+                mtime=1.0,
+                size=10,
+                sha256="hash",
+                text="body",
+                embedding=None,
+                chunks_data=broken_chunks,
+            )
+
+    assert vector_db.get_all_documents_metadata(db_path) == {}
+    assert vector_db.get_db_stats(db_path)["chunk_count"] == 0
+
+
+def test_save_document_with_chunks_replaces_existing_chunks(tmp_path: Path) -> None:
+    db_path = str(tmp_path / "vector.db")
+    vector_db.init_db(db_path)
+    vector = np.ones(4, dtype=np.float32).tobytes()
+
+    def chunks(count: int) -> list[dict[str, object]]:
+        return [{"chunk_index": i, "text": f"c{i}", "embedding": vector, "embedding_dim": 4} for i in range(count)]
+
+    with vector_db.open_db(db_path) as conn:
+        first_id = vector_db.save_document_with_chunks(
+            conn, path="/docs/a.md", title="a", mtime=1.0, size=1, sha256="h1", text="t", embedding=vector,
+            chunks_data=chunks(3),
+        )
+        second_id = vector_db.save_document_with_chunks(
+            conn, path="/docs/a.md", title="a", mtime=2.0, size=2, sha256="h2", text="t2", embedding=vector,
+            chunks_data=chunks(1),
+        )
+
+    assert first_id == second_id
+    stats = vector_db.get_db_stats(db_path)
+    assert stats["document_count"] == 1
+    assert stats["chunk_count"] == 1
+    assert vector_db.get_all_documents_metadata(db_path)["/docs/a.md"]["sha256"] == "h2"
+
+
+def test_open_db_closes_connection_and_rolls_back_on_error(tmp_path: Path) -> None:
+    db_path = str(tmp_path / "vector.db")
+    vector_db.init_db(db_path)
+
+    with pytest.raises(RuntimeError):
+        with vector_db.open_db(db_path) as conn:
+            conn.execute(
+                "INSERT INTO documents (path, title, mtime, size, sha256) VALUES ('/x.md', 'x', 1, 1, 'h')"
+            )
+            raise RuntimeError("boom")
+
+    assert vector_db.get_all_documents_metadata(db_path) == {}
+    with pytest.raises(sqlite3.ProgrammingError):
+        conn.execute("SELECT 1")
+
+
+def test_delete_documents_removes_only_given_paths_with_their_chunks(tmp_path: Path) -> None:
+    db_path = str(tmp_path / "vector.db")
+    vector_db.init_db(db_path)
+    vector = np.ones(4, dtype=np.float32).tobytes()
+    with vector_db.open_db(db_path) as conn:
+        for name in ("a", "b", "c"):
+            vector_db.save_document_with_chunks(
+                conn, path=f"/docs/{name}.md", title=name, mtime=1.0, size=1, sha256=name, text=name,
+                embedding=vector,
+                chunks_data=[{"chunk_index": 0, "text": name, "embedding": vector, "embedding_dim": 4}],
+            )
+
+    deleted = vector_db.delete_documents(db_path, ["/docs/a.md", "/docs/c.md", "/docs/missing.md"])
+
+    assert deleted == 2
+    assert _document_paths(db_path) == {"/docs/b.md"}
+    assert vector_db.get_db_stats(db_path)["chunk_count"] == 1
+    assert vector_db.delete_documents(db_path, []) == 0
+
+
+def test_get_chunks_with_context_returns_neighbors_for_each_chunk(tmp_path: Path) -> None:
+    db_path = str(tmp_path / "vector.db")
+    vector_db.init_db(db_path)
+    vector = np.ones(4, dtype=np.float32).tobytes()
+    with vector_db.open_db(db_path) as conn:
+        vector_db.save_document_with_chunks(
+            conn, path="/docs/a.md", title="a", mtime=1.0, size=1, sha256="h", text="t", embedding=vector,
+            chunks_data=[
+                {"chunk_index": i, "text": f"chunk-{i}", "embedding": vector, "embedding_dim": 4} for i in range(3)
+            ],
+        )
+        chunk_ids = [int(row["id"]) for row in conn.execute("SELECT id FROM chunks ORDER BY chunk_index")]
+
+    contexts = vector_db.get_chunks_with_context(db_path, [*chunk_ids, 9999])
+
+    assert set(contexts) == set(chunk_ids)
+    assert contexts[chunk_ids[0]]["prev_text"] is None
+    assert contexts[chunk_ids[0]]["next_text"] == "chunk-1"
+    assert contexts[chunk_ids[1]]["prev_text"] == "chunk-0"
+    assert contexts[chunk_ids[1]]["hit_text"] == "chunk-1"
+    assert contexts[chunk_ids[2]]["next_text"] is None
+    assert contexts[chunk_ids[1]] == vector_db.get_chunk_with_context(db_path, chunk_ids[1])
+    assert vector_db.get_chunks_with_context(db_path, []) == {}
+
+
+def test_uninitialized_vector_db_is_treated_as_empty(tmp_path: Path) -> None:
+    db_path = str(tmp_path / "empty.db")
+    sqlite3.connect(db_path).close()
+
+    ids, vectors = vector_db.get_all_chunk_embeddings(db_path)
+    searcher = VectorSearcher(db_path=db_path, embedder=MockEmbedder(dim=8))
+
+    assert ids == []
+    assert vectors.shape[0] == 0
+    assert vector_db.get_all_documents_metadata(db_path) == {}
+    assert vector_db.get_db_stats(db_path)["document_count"] == 0
+    assert searcher.search("anything").results == []
+    assert searcher.search("anything", mode=SearchMode.DOCUMENT).results == []
+
+
+def test_index_all_uses_one_batch_inference_per_file(tmp_path: Path) -> None:
+    folder = tmp_path / "docs"
+    folder.mkdir()
+    (folder / "a.md").write_text("# Title\n\n本文 A", encoding="utf-8")
+    (folder / "b.txt").write_text("plain text B", encoding="utf-8")
+    embedder = CountingEmbedder()
+    manager = VectorIndexManager([str(folder)], str(tmp_path / "vector.db"), embedder=embedder)
+
+    result = manager.index_all()
+
+    assert result.new_count == 2
+    assert embedder.batch_calls == 2
+    assert embedder.single_calls == 0
+    ids, vectors = vector_db.get_all_document_embeddings(manager.db_path)
+    assert len(ids) == 2
+    assert vectors.shape == (2, embedder.embedding_dim)
+
+
+def test_document_embedding_matches_single_encoding_of_leading_text(tmp_path: Path) -> None:
+    """バッチ化しても、文書ベクトルは本文先頭 1000 文字を単独で推論した結果と一致する。"""
+    folder = tmp_path / "docs"
+    folder.mkdir()
+    body = "あ" * 1500
+    (folder / "long.txt").write_text(body, encoding="utf-8")
+    embedder = MockEmbedder(dim=16, model_path="mock_model")
+    manager = VectorIndexManager([str(folder)], str(tmp_path / "vector.db"), embedder=embedder)
+
+    manager.index_all()
+
+    _, vectors = vector_db.get_all_document_embeddings(manager.db_path)
+    np.testing.assert_array_equal(vectors[0], embedder.encode(body[:1000]))
+
+
+def test_index_all_continues_after_failure_and_retries_failed_file_next_time(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, caplog: pytest.LogCaptureFixture
+) -> None:
+    folder = tmp_path / "docs"
+    folder.mkdir()
+    good = folder / "good.md"
+    bad = folder / "bad.md"
+    good.write_text("good", encoding="utf-8")
+    bad.write_text("bad", encoding="utf-8")
+    manager = VectorIndexManager([str(folder)], str(tmp_path / "vector.db"), embedder=MockEmbedder(dim=16))
+    original = manager._process_file_chunks
+
+    def failing_process(file_path: Path):
+        if file_path.name == "bad.md":
+            raise RuntimeError("extraction exploded")
+        return original(file_path)
+
+    monkeypatch.setattr(manager, "_process_file_chunks", failing_process)
+    with caplog.at_level("WARNING", logger="app.vector.indexer"):
+        first = manager.index_all()
+
+    assert first.new_count == 1
+    assert _document_paths(manager.db_path) == {str(good.resolve())}
+    assert "bad.md" in caplog.text
+    assert "extraction exploded" in caplog.text
+
+    monkeypatch.setattr(manager, "_process_file_chunks", original)
+    second = manager.index_all()
+
+    assert second.new_count == 1
+    assert second.skipped_count == 1
+    assert _document_paths(manager.db_path) == {str(good.resolve()), str(bad.resolve())}
+
+
+def test_deletion_candidates_exclude_documents_under_unreachable_target_folder(tmp_path: Path) -> None:
+    mounted = tmp_path / "mounted"
+    network = tmp_path / "network_drive"
+    mounted.mkdir()
+    network.mkdir()
+    kept = mounted / "kept.md"
+    removed = mounted / "removed.md"
+    remote = network / "remote.md"
+    for path in (kept, removed, remote):
+        path.write_text(path.stem, encoding="utf-8")
+    db_path = str(tmp_path / "vector.db")
+    embedder = MockEmbedder(dim=16)
+    VectorIndexManager([str(mounted), str(network)], db_path, embedder=embedder).index_all()
+
+    # mounted 内のファイルは実際に削除され、network は「接続が切れて見えなくなった」状態にする
+    removed.unlink()
+    remote.unlink()
+    network.rmdir()
+    manager = VectorIndexManager([str(mounted), str(network)], db_path, embedder=embedder)
+
+    assert manager.get_pending_deletions() == [str(removed.resolve())]
+
+    result = manager.index_all(clean_deleted_files=True)
+
+    assert result.deleted_count == 1
+    assert _document_paths(db_path) == {str(kept.resolve()), str(remote.resolve())}
