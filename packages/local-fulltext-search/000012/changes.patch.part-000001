diff --git a/backend/app/services/search_dispatcher.py b/backend/app/services/search_dispatcher.py
new file mode 100644
index 0000000000000000000000000000000000000000..98a17d6e892eccfc6a6a38ca21850c38c958f455
--- /dev/null
+++ b/backend/app/services/search_dispatcher.py
@@ -0,0 +1,524 @@
+"""
+検索方式（keyword / vector / hybrid）ごとの実行と結果整形を担うディスパッチャ。
+
+仕様:
+- keyword: FTS5 全文検索の結果をそのまま返す。
+- vector: ベクトル検索の結果を、除外キーワード・拡張子・除外語・有効ターゲット・実在性で絞り込んで返す。
+- hybrid（既定）: キーワード検索とベクトル検索を RRF で融合する。ベクトル検索が使えない、
+  または結果 0 件のときはキーワード検索結果だけを返す。
+- ベクトル検索由来の結果の file_id は、全文検索DB（files テーブル）の ID へ解決する。
+  files に存在しない文書は、どの files.id とも衝突しない負の合成 ID を割り当てる
+  （ベクトルDBの documents.id を files.id として扱うと、クリック記録や削除が別ファイルへ作用するため）。
+- hybrid の全体順位は「先頭 1 ページ分のキーワード結果とベクトル結果を RRF 融合した部分」に、
+  残りのキーワード結果を元の順位のまま続けたものとする。1 ページ目は融合結果の上位 limit 件で、
+  2 ページ目以降もこの全体順位から切り出すため、ページをまたいでベクトル結果が重複しない。
+- hybrid の total は、キーワード検索とベクトル検索のどちらかに一致したファイルの数（重複なし）とする。
+  先頭ページでは「ベクトルのみ」に見える結果が、後ろのページのキーワード結果でもある場合は 1 件として数える。
+"""
+
+from __future__ import annotations
+
+import logging
+import sqlite3
+from collections.abc import Callable
+from datetime import datetime, timezone
+from pathlib import Path
+
+from app.extractors.text_extractor import parse_extension_filter
+from app.models.search import IndexedSearchRequest, SearchQueryParams, SearchResponse, SearchResultItem
+from app.services import exclude_rules, search_query
+from app.services.hybrid_search_service import (
+    HybridSearchResultItem,
+    normalize_path_key,
+    reciprocal_rank_fusion,
+)
+from app.services.path_service import matches_exclude_keyword, normalize_path, normalize_path_str
+from app.services.search_service import SearchService
+from app.vector.searcher import SearchResponse as VectorSearchResponse
+from app.vector.searcher import SearchResultItem as VectorItem
+from app.vector.state import vector_state
+
+logger = logging.getLogger(__name__)
+
+SearchParams = SearchQueryParams | IndexedSearchRequest
+FileExistsChecker = Callable[[str], bool]
+
+# files テーブルに存在しないベクトル文書へ割り当てる合成 ID の基点（負数側・フォルダ/gantt の負 ID と重ならない帯域）
+VECTOR_ONLY_FILE_ID_BASE = 1_000_000_000
+RRF_K = 60
+RRF_VECTOR_WEIGHT = 0.5
+RRF_KEYWORD_WEIGHT = 0.5
+_SQLITE_IN_CHUNK_SIZE = 500
+
+
+def is_existing_local_file(path: str) -> bool:
+    """ローカルファイルが実在するかを返す。到達不能なパスは存在しないものとして扱う。"""
+    try:
+        return Path(path).is_file()
+    except OSError:
+        return False
+
+
+def resolve_vector_only_file_id(document_id: int | None) -> int:
+    """files テーブルに無いベクトル文書用の、files.id と衝突しない合成 ID を返す。"""
+    return -(VECTOR_ONLY_FILE_ID_BASE + int(document_id or 0))
+
+
+def _is_path_descendant(path: str, root: str) -> bool:
+    """パスが指定ルート自身またはその配下に属するかを、区切り文字と大文字小文字を無視して判定する。"""
+    normalized_path = path.replace("\\", "/").rstrip("/").lower()
+    normalized_root = root.replace("\\", "/").rstrip("/").lower()
+    if normalized_path == normalized_root:
+        return True
+    return normalized_path.startswith(f"{normalized_root}/")
+
+
+def _is_url(path: str) -> bool:
+    return "://" in path
+
+
+class VectorCandidateFilter:
+    """ベクトル検索結果を、キーワード検索と同じ条件（除外・拡張子・対象フォルダ・実在性）で絞り込む。"""
+
+    def __init__(
+        self,
+        *,
+        service: SearchService,
+        excluded_keywords: list[str],
+        include_extensions: tuple[str, ...],
+        exclude_extensions: tuple[str, ...],
+        query_exclude_terms: list[str],
+        target_folder: str,
+        enabled_targets: list[str],
+        file_exists: FileExistsChecker,
+    ) -> None:
+        self._service = service
+        self._excluded_keywords = [keyword.strip() for keyword in excluded_keywords if keyword.strip()]
+        self._include_extensions = include_extensions
+        self._exclude_extensions = exclude_extensions
+        self._query_exclude_terms = [term.lower() for term in query_exclude_terms]
+        self._target_folder = target_folder
+        self._enabled_targets = enabled_targets
+        self._file_exists = file_exists
+
+    def accepts(self, item: VectorItem) -> bool:
+        path = item.full_path or item.path
+        return (
+            not self.is_excluded_by_keywords(path)
+            and self._matches_extension_filter(path)
+            and not self._matches_query_exclude_terms(path, f"{item.hit_text or ''} {item.preview or ''}")
+            and self._is_within_search_scope(path)
+        )
+
+    def is_excluded_by_keywords(self, path: str) -> bool:
+        """除外キーワードは本文ではなく、ファイル名・ステム・パス構成要素に対して判定する。"""
+        if not path or not self._excluded_keywords:
+            return False
+        if path.startswith(("http://", "https://")):
+            lowered = path.lower()
+            return any(keyword.lower() in lowered for keyword in self._excluded_keywords)
+        normalized = normalize_path(path)
+        for keyword in self._excluded_keywords:
+            if "/" in keyword or "\\" in keyword:
+                continue
+            if matches_exclude_keyword(normalized.name, keyword) or matches_exclude_keyword(normalized.stem, keyword):
+                return True
+        return exclude_rules.should_exclude_path(normalized, self._excluded_keywords)
+
+    def _matches_extension_filter(self, path: str) -> bool:
+        lowered = path.lower()
+        if self._exclude_extensions and any(lowered.endswith(ext) for ext in self._exclude_extensions):
+            return False
+        if self._include_extensions and not any(lowered.endswith(ext) for ext in self._include_extensions):
+            return False
+        return True
+
+    def _matches_query_exclude_terms(self, path: str, text: str) -> bool:
+        if not self._query_exclude_terms:
+            return False
+        lowered_path = path.lower()
+        lowered_text = text.lower()
+        return any(term in lowered_path or term in lowered_text for term in self._query_exclude_terms)
+
+    def _is_within_search_scope(self, path: str) -> bool:
+        """現在有効な検索対象フォルダ配下にあり、ローカルファイルなら実在することを検証する。"""
+        if not path:
+            return False
+        if self._target_folder:
+            if not _is_path_descendant(path, self._target_folder):
+                return False
+        elif self._enabled_targets and not any(_is_path_descendant(path, target) for target in self._enabled_targets):
+            return False
+        if _is_url(path):
+            return True
+        return self._file_exists(path)
+
+
+def dispatch_search(
+    params: SearchParams,
+    service: SearchService,
+    *,
+    file_exists: FileExistsChecker = is_existing_local_file,
+) -> SearchResponse:
+    """検索方式に応じて検索を実行し、統一レスポンスを返す。"""
+    if params.search_type == "keyword":
+        return _mark_keyword_only(_run_keyword_search(params, service), search_type="keyword")
+    if params.search_type == "vector":
+        return _search_vector(params, service, file_exists=file_exists)
+    return _search_hybrid(params, service, file_exists=file_exists)
+
+
+def _run_keyword_search(params: SearchParams, service: SearchService) -> SearchResponse:
+    if isinstance(params, IndexedSearchRequest):
+        return service.search_existing_index(params)
+    return service.search(params)
+
+
+def _mark_keyword_only(response: SearchResponse, *, search_type: str) -> SearchResponse:
+    response.search_type = search_type
+    for item in response.items:
+        item.match_type = "keyword_only"
+    return response
+
+
+def _resolve_excluded_keywords(params: SearchParams, service: SearchService) -> list[str]:
+    """リクエスト指定があればそれを、無ければ保存済みの除外キーワード（Web は Web 用）を使う。"""
+    index_service = service.index_service
+    app_settings = index_service.get_app_settings()
+    default_keywords = app_settings.web_exclude_keywords if params.source_type == "web" else app_settings.exclude_keywords
+    requested_keywords = getattr(params, "exclude_keywords", None)
+    return exclude_rules.parse_exclude_keywords(requested_keywords if requested_keywords is not None else default_keywords)
+
+
+def _list_enabled_targets(connection: sqlite3.Connection) -> list[str]:
+    try:
+        rows = connection.execute("SELECT full_path FROM targets WHERE is_search_target_enabled = 1").fetchall()
+    except sqlite3.Error as error:
+        logger.debug("Failed to query enabled targets: %s", error)
+        return []
+    return [str(row["full_path"]) for row in rows]
+
+
+def _build_vector_query_and_filter(
+    params: SearchParams,
+    service: SearchService,
+    *,
+    file_exists: FileExistsChecker,
+) -> tuple[str, VectorCandidateFilter]:
+    """ベクトル検索へ渡すポジティブ語だけのクエリと、結果の絞り込み条件を組み立てる。"""
+    include_term_groups, query_exclude_terms = search_query.split_search_terms(params.q)
+    vector_query = " ".join(term for group in include_term_groups for term in group if term).strip()
+    include_extensions, exclude_extensions = parse_extension_filter(
+        params.types or params.extensions or params.index_types
+    )
+    target_folder = params.folder_path if isinstance(params, IndexedSearchRequest) else params.full_path
+    candidate_filter = VectorCandidateFilter(
+        service=service,
+        excluded_keywords=_resolve_excluded_keywords(params, service),
+        include_extensions=tuple(include_extensions),
+        exclude_extensions=tuple(exclude_extensions),
+        query_exclude_terms=query_exclude_terms,
+        target_folder=(target_folder or "").strip(),
+        enabled_targets=_list_enabled_targets(service.connection),
+        file_exists=file_exists,
+    )
+    return vector_query, candidate_filter
+
+
+def _run_vector_search(
+    searcher,
+    vector_query: str,
+    *,
+    limit: int,
+    candidate_filter: VectorCandidateFilter,
+) -> tuple[VectorSearchResponse | None, list[VectorItem]]:
+    """ベクトル検索を実行して絞り込む。失敗時は検索全体を止めず、結果なしとして扱う。"""
+    try:
+        vector_response = searcher.search(query=vector_query, top_k=max(limit * 2, 40))
+    except Exception as error:
+        logger.warning("Vector search failed: %s", error, exc_info=True)
+        return None, []
+    return vector_response, [item for item in vector_response.results if candidate_filter.accepts(item)]
+
+
+def _lookup_indexed_files(connection: sqlite3.Connection, paths: list[str]) -> dict[str, sqlite3.Row]:
+    """ベクトル結果のパスに対応する files 行を、パス比較キーで引けるようまとめて取得する。"""
+    normalized_paths = sorted({normalize_path_str(path) for path in paths if path and not _is_url(path)})
+    found: dict[str, sqlite3.Row] = {}
+    for start in range(0, len(normalized_paths), _SQLITE_IN_CHUNK_SIZE):
+        chunk = normalized_paths[start : start + _SQLITE_IN_CHUNK_SIZE]
+        placeholders = ",".join("?" * len(chunk))
+        try:
+            rows = connection.execute(
+                f"""
+                SELECT id, normalized_path, click_count, has_obsidian_top_tag
+                FROM files
+                WHERE normalized_path IN ({placeholders})
+                """,
+                chunk,
+            ).fetchall()
+        except sqlite3.Error as error:
+            logger.debug("Failed to look up indexed files: %s", error)
+            return found
+        for row in rows:
+            found[normalize_path_key(str(row["normalized_path"]))] = row
+    return found
+
+
+def _build_item_from_vector_path(
+    *,
+    path: str,
+    document_id: int | None,
+    indexed_files: dict[str, sqlite3.Row],
+    snippet: str,
+    match_type: str,
+    vector_score: float | None,
+    salient_sentence: str | None,
+    hybrid_score: float | None = None,
+    keyword_score: float | None = None,
+) -> SearchResultItem:
+    """ベクトル検索由来の結果を SearchResultItem へ変換する。"""
+    file_path = Path(path)
+    now = datetime.now(timezone.utc)
+    try:
+        stat = file_path.stat()
+        mtime = datetime.fromtimestamp(stat.st_mtime, timezone.utc)
+        created_at = datetime.fromtimestamp(stat.st_ctime, timezone.utc)
+    except OSError:
+        mtime = now
+        created_at = now
+
+    indexed_file = indexed_files.get(normalize_path_key(normalize_path_str(path))) if not _is_url(path) else None
+    return SearchResultItem(
+        file_id=int(indexed_file["id"]) if indexed_file is not None else resolve_vector_only_file_id(document_id),
+        result_kind="file",
+        source_type="local",
+        target_path=str(file_path.parent),
+        file_name=file_path.name,
+        full_path=str(file_path),
+        file_ext=file_path.suffix.lower(),
+        created_at=created_at,
+        mtime=mtime,
+        click_count=int(indexed_file["click_count"]) if indexed_file is not None else 0,
+        has_obsidian_top_tag=bool(indexed_file["has_obsidian_top_tag"]) if indexed_file is not None else False,
+        snippet=snippet,
+        match_type=match_type,
+        hybrid_score=hybrid_score,
+        vector_score=vector_score,
+        keyword_score=keyword_score,
+        salient_sentence=salient_sentence,
+    )
+
+
+def _search_vector(params: SearchParams, service: SearchService, *, file_exists: FileExistsChecker) -> SearchResponse:
+    empty_response = SearchResponse(total=0, items=[], has_more=False, search_type="vector")
+    searcher = vector_state.get_searcher()
+    if not searcher:
+        return empty_response
+    vector_query, candidate_filter = _build_vector_query_and_filter(params, service, file_exists=file_exists)
+    if not vector_query:
+        return empty_response
+    vector_response, vector_items = _run_vector_search(
+        searcher, vector_query, limit=params.limit, candidate_filter=candidate_filter
+    )
+    if vector_response is None:
+        return empty_response
+
+    page_items = vector_items[: params.limit]
+    indexed_files = _lookup_indexed_files(service.connection, [item.full_path or item.path for item in page_items])
+    items = [
+        _build_item_from_vector_path(
+            path=item.full_path or item.path,
+            document_id=item.document_id,
+            indexed_files=indexed_files,
+            snippet=item.hit_text or item.preview or "",
+            match_type="vector_only",
+            vector_score=item.score,
+            salient_sentence=item.salient_sentence,
+        )
+        for item in page_items
+    ]
+    return SearchResponse(
+        total=len(items),
+        items=items,
+        has_more=False,
+        search_type="vector",
+        rag_context_xml=vector_response.rag_context_xml,
+        rag_context_markdown=vector_response.rag_context_markdown,
+        detected_terms=vector_response.detected_terms,
+    )
+
+
+def _sort_hybrid_candidates(candidates: list[SearchResultItem], *, sort_by: str, sort_order: str) -> None:
+    reverse = sort_order == "desc"
+    if sort_by == "vector_score":
+        candidates.sort(key=lambda item: (item.vector_score or 0.0, item.file_id), reverse=reverse)
+    elif sort_by == "keyword_score":
+        candidates.sort(key=lambda item: (item.keyword_score or 0.0, item.file_id), reverse=reverse)
+    elif sort_by == "hybrid_score":
+        candidates.sort(key=lambda item: (item.hybrid_score or 0.0, item.file_id), reverse=reverse)
+    elif sort_by == "click_count":
+        candidates.sort(key=lambda item: (item.click_count or 0, item.file_id), reverse=reverse)
+    elif sort_by == "created":
+        candidates.sort(key=lambda item: (item.created_at.timestamp(), item.file_id), reverse=reverse)
+    elif sort_by == "modified":
+        candidates.sort(key=lambda item: (item.mtime.timestamp(), item.file_id), reverse=reverse)
+    else:
+        # 既定はハイブリッド順位（hybrid_score 降順）を最優先する
+        candidates.sort(
+            key=lambda item: (
+                item.hybrid_score or 0.0,
+                item.filename_match_level or 0,
+                item.mtime.timestamp(),
+                item.file_id,
+            ),
+            reverse=True,
+        )
+
+
+def _build_hybrid_candidates(
+    fused_items: list[HybridSearchResultItem],
+    keyword_items: list[SearchResultItem],
+    *,
+    candidate_filter: VectorCandidateFilter,
+    connection: sqlite3.Connection,
+) -> list[SearchResultItem]:
+    """融合結果を、キーワード結果の情報（クリック数・スニペット等）を優先して SearchResultItem へ変換する。"""
+    keyword_items_by_key = {normalize_path_key(item.full_path): item for item in keyword_items}
+    visible_fused_items = [item for item in fused_items if not candidate_filter.is_excluded_by_keywords(item.full_path)]
+    vector_only_paths = [
+        item.full_path for item in visible_fused_items if normalize_path_key(item.full_path) not in keyword_items_by_key
+    ]
+    indexed_files = _lookup_indexed_files(connection, vector_only_paths)
+
+    candidates: list[SearchResultItem] = []
+    for fused in visible_fused_items:
+        keyword_item = keyword_items_by_key.get(normalize_path_key(fused.full_path))
+        if keyword_item is not None:
+            candidate = keyword_item.model_copy()
+            candidate.match_type = fused.match_type
+            candidate.hybrid_score = fused.hybrid_score
+            candidate.salient_sentence = fused.salient_sentence
+            candidate.vector_score = fused.vector_score
+            candidate.keyword_score = fused.keyword_score
+            if fused.snippet and not candidate.snippet:
+                candidate.snippet = fused.snippet
+            candidates.append(candidate)
+            continue
+        candidates.append(
+            _build_item_from_vector_path(
+                path=fused.full_path or fused.path,
+                document_id=fused.document_id,
+                indexed_files=indexed_files,
+                snippet=fused.snippet or fused.hit_text or "",
+                match_type=fused.match_type,
+                vector_score=fused.vector_score,
+                salient_sentence=fused.salient_sentence,
+                hybrid_score=fused.hybrid_score,
+                keyword_score=fused.keyword_score,
+            )
+        )
+    return candidates
+
+
+def _count_keyword_matches_outside_head(
+    vector_only_candidates: list[SearchResultItem],
+    keyword_response: SearchResponse,
+    params: SearchParams,
+    service: SearchService,
+) -> int:
+    """
+    先頭ページの融合では「ベクトルのみ」になった結果のうち、先頭ページの外のキーワード結果でもあるものを数える
+    （total に同じファイルを 2 回数えないため）。
+    キーワード結果をすべて取得済みならその中から、まだ続きがあるなら DB へ問い合わせて調べる。
+    """
+    # 負の ID は files に無い文書（合成 ID）なので、キーワード結果にはなり得ない
+    indexed_file_ids = [item.file_id for item in vector_only_candidates if item.file_id > 0]
+    if not indexed_file_ids:
+        return 0
+    if keyword_response.total <= len(keyword_response.items):
+        fetched_file_ids = {item.file_id for item in keyword_response.items if item.result_kind == "file"}
+        return sum(1 for file_id in indexed_file_ids if file_id in fetched_file_ids)
+    return len(service.find_matching_file_ids(params, indexed_file_ids))
+
+
+def _search_hybrid(params: SearchParams, service: SearchService, *, file_exists: FileExistsChecker) -> SearchResponse:
+    # 全体順位からページを切り出せるよう、キーワード結果は常に先頭から offset + limit 件を取得する
+    keyword_response = _run_keyword_search(
+        params.model_copy(update={"offset": 0, "limit": params.offset + params.limit}),
+        service,
+    )
+
+    vector_response: VectorSearchResponse | None = None
+    vector_items: list[VectorItem] = []
+    candidate_filter: VectorCandidateFilter | None = None
+    searcher = vector_state.get_searcher()
+    if searcher:
+        vector_query, candidate_filter = _build_vector_query_and_filter(params, service, file_exists=file_exists)
+        if vector_query:
+            vector_response, vector_items = _run_vector_search(
+                searcher, vector_query, limit=params.limit, candidate_filter=candidate_filter
+            )
+
+    if not vector_items or candidate_filter is None:
+        candidates = list(keyword_response.items)
+        total = keyword_response.total
+    else:
+        # ベクトル結果と融合するのは先頭 1 ページ分のキーワード結果だけに固定する。
+        # 融合対象を offset に依存させないことで、ページをまたいでも順位が動かず重複しない。
+        head_keyword_items = keyword_response.items[: params.limit]
+        fused_items = reciprocal_rank_fusion(
+            vector_items=vector_items,
+            keyword_items=[item.model_dump() for item in head_keyword_items],
+            vector_weight=RRF_VECTOR_WEIGHT,
+            keyword_weight=RRF_KEYWORD_WEIGHT,
+            k=RRF_K,
+        )
+        head_candidates = _build_hybrid_candidates(
+            fused_items,
+            head_keyword_items,
+            candidate_filter=candidate_filter,
+            connection=service.connection,
+        )
+        if isinstance(params, SearchQueryParams):
+            _sort_hybrid_candidates(head_candidates, sort_by=params.sort_by, sort_order=params.sort_order)
+        else:
+            _sort_hybrid_candidates(head_candidates, sort_by="default", sort_order="desc")
+
+        # 2 ページ目以降は、融合済みの先頭部分に続けて残りのキーワード結果を元の順位のまま並べる
+        head_keys = {normalize_path_key(item.full_path) for item in head_candidates}
+        tail_candidates = [
+            item
+            for item in keyword_response.items[params.limit :]
+            if normalize_path_key(item.full_path) not in head_keys
+            and not candidate_filter.is_excluded_by_keywords(item.full_path)
+        ]
+        candidates = [*head_candidates, *tail_candidates]
+        vector_only_candidates = [item for item in head_candidates if item.match_type == "vector_only"]
+        total = (
+            keyword_response.total
+            + len(vector_only_candidates)
+            - _count_keyword_matches_outside_head(vector_only_candidates, keyword_response, params, service)
+        )
+
+    for item in candidates:
+        if item.match_type is None:
+            item.match_type = "keyword_only"
+
+    page_items = candidates[params.offset : params.offset + params.limit]
+    has_more = bool(page_items) and (
+        params.offset + len(page_items) < len(candidates) or keyword_response.has_more
+    )
+    has_vector_results = vector_response is not None and bool(vector_items)
+    return SearchResponse(
+        total=total,
+        items=page_items,
+        has_more=has_more,
+        next_offset=params.offset + len(page_items) if has_more else None,
+        used_existing_index=keyword_response.used_existing_index,
+        background_refresh_scheduled=keyword_response.background_refresh_scheduled,
+        search_type="hybrid",
+        rag_context_xml=vector_response.rag_context_xml if has_vector_results else None,
+        rag_context_markdown=vector_response.rag_context_markdown if has_vector_results else None,
+        detected_terms=vector_response.detected_terms if has_vector_results else None,
+    )
diff --git a/backend/app/services/search_query.py b/backend/app/services/search_query.py
new file mode 100644
index 0000000000000000000000000000000000000000..c9a1eab69e2c3cb23fb611451dec194754846da0
--- /dev/null
+++ b/backend/app/services/search_query.py
@@ -0,0 +1,228 @@
+"""
+検索語の解析（DB に依存しない純粋関数）。
+
+- 入力は空白区切りの AND。`OR` / `or` でつないだ語は同じグループ（どれかに一致すればよい）になる。
+- `-語` は除外語。`\\-語` や `\\OR` のように `\\` を付けると通常の語として扱う。
+- 類似語リストに含まれる語は、同じグループの候補へ展開する。
+- 利用者の入力は FTS5 の構文としては解釈しない。必ず引用符で囲んだ語として渡す。
+"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+
+from fastapi import HTTPException, status
+
+from app.services import app_settings_store
+
+
+def split_search_terms(value: str) -> tuple[list[list[str]], list[str]]:
+    """
+    利用者入力を空白および OR / or 演算子で区切り、ORグループのリスト (AND結合) と `-keyword` の除外語へ分離する。
+    `\\-keyword` や `\\OR`, `\\or` はエスケープされた通常語として扱う。
+    ただし全語が `-` 始まりのときなどは従来互換のため通常語として扱う。
+    """
+    raw_tokens = [item for item in value.split() if item]
+    if not raw_tokens:
+        return [], []
+
+    processed_tokens: list[tuple[str, str]] = []
+    for token in raw_tokens:
+        if token.startswith("\\-") or (token.startswith(("\\or", "\\OR", "\\Or", "\\oR")) and len(token) == 3):
+            processed_tokens.append(("TERM", token[1:]))
+        elif token.startswith("-") and len(token) > 1:
+            processed_tokens.append(("EXCLUDE", token[1:]))
+        elif token.lower() == "or":
+            processed_tokens.append(("OR", token))
+        else:
+            processed_tokens.append(("TERM", token))
+
+    term_count = sum(1 for tag, _ in processed_tokens if tag == "TERM")
+    exclude_terms: list[str] = [val for tag, val in processed_tokens if tag == "EXCLUDE"]
+    if term_count == 0:
+        if exclude_terms:
+            return [], exclude_terms
+        fallback_terms = [[term] for term in raw_tokens if term]
+        return fallback_terms, []
+
+    groups: list[list[str]] = []
+    current_group: list[str] = []
+    in_or = False
+
+    for tag, val in processed_tokens:
+        if tag == "EXCLUDE":
+            continue
+        if tag == "OR":
+            if current_group:
+                in_or = True
+        elif tag == "TERM":
+            if in_or and current_group:
+                current_group.append(val)
+                in_or = False
+            else:
+                if current_group:
+                    groups.append(current_group)
+                current_group = [val]
+                in_or = False
+
+    if current_group:
+        groups.append(current_group)
+
+    if not groups:
+        fallback_terms = [[term] for term in raw_tokens if term]
+        return fallback_terms, []
+
+    return groups, exclude_terms
+
+
+def expand_include_terms_with_synonyms(include_terms: list[list[str]], synonym_groups_text: str) -> list[list[str]]:
+    """
+    同義語リストに含まれる語は OR 条件の候補へ展開し、各入力語は「同じキーワード」として扱う。
+    """
+    synonym_groups = app_settings_store.parse_synonym_groups(synonym_groups_text)
+    expanded_terms: list[list[str]] = []
+    for group in include_terms:
+        seen: set[str] = set()
+        expanded_group: list[str] = []
+        for term in group:
+            normalized_term = term.casefold()
+            matched_group = next(
+                (candidate_group for candidate_group in synonym_groups if any(candidate.casefold() == normalized_term for candidate in candidate_group)),
+                None,
+            )
+            candidates = [term, *matched_group] if matched_group else [term]
+            for candidate in candidates:
+                normalized_candidate = candidate.casefold()
+                if normalized_candidate in seen:
+                    continue
+                seen.add(normalized_candidate)
+                expanded_group.append(candidate)
+        if expanded_group:
+            expanded_terms.append(expanded_group)
+    return expanded_terms
+
+
+def flatten_highlight_terms(expanded_include_terms: list[list[str]]) -> list[str]:
+    """
+    スニペット生成では、入力語だけでなく同義語展開後の候補もまとめてハイライト対象にする。
+    """
+    seen: set[str] = set()
+    highlight_terms: list[str] = []
+    for group in expanded_include_terms:
+        for term in group:
+            normalized_term = term.casefold()
+            if normalized_term in seen:
+                continue
+            seen.add(normalized_term)
+            highlight_terms.append(term)
+    return highlight_terms
+
+
+def matches_excluded_search_terms(
+    *,
+    file_name: str,
+    body_content: str,
+    folder_path: str,
+    exclude_terms: list[str],
+) -> bool:
+    """
+    `-keyword` 指定の語がファイル名・フォルダーパス・本文に含まれる候補は除外する。
+    """
+    if not exclude_terms:
+        return False
+
+    lowered_file_name = file_name.lower()
+    lowered_body_content = body_content.lower()
+    lowered_folder_path = folder_path.lower()
+    for term in exclude_terms:
+        lowered_term = term.lower()
+        if (
+            lowered_term in lowered_file_name
+            or lowered_term in lowered_body_content
+            or lowered_term in lowered_folder_path
+        ):
+            return True
+    return False
+
+
+def normalize_query_for_history(query: str) -> str:
+    """
+    検索履歴のキーをUnicode正規化し、空白と大文字小文字の差を吸収する。
+    """
+    return " ".join(unicodedata.normalize("NFKC", query).casefold().split())
+
+
+def search_target_includes_body(search_target: str) -> bool:
+    """
+    検索種別が本文検索を含むかを返す。
+    """
+    return search_target in {"all", "body"}
+
+
+def search_target_includes_filename(search_target: str) -> bool:
+    """
+    検索種別がファイル名検索を含むかを返す。
+    """
+    return search_target in {"all", "filename", "filename_and_folder"}
+
+
+def search_target_includes_folder(search_target: str) -> bool:
+    """
+    検索種別がフォルダー名検索を含むかを返す。
+    """
+    return search_target in {"all", "folder", "filename_and_folder"}
+
+
+def should_use_literal_term_search(term: str) -> bool:
+    """
+    先頭が `-` の語や `mp3` のような英数字混在語は FTS5 MATCH で取りこぼすことがあるため、
+    LIKE ベースの文字列検索へ切り替える。
+    """
+    return term.startswith("-") or contains_ascii_letters_and_digits(term)
+
+
+def contains_ascii_letters_and_digits(term: str) -> bool:
+    """
+    ASCII 英字と数字を両方含む検索語かどうかを返す。
+    `mp3`, `h264`, `mp4a` などの語は SQLite の標準 tokenizer で安定しないため特別扱いする。
+    """
+    has_ascii_letter = any(("a" <= char.lower() <= "z") for char in term)
+    has_digit = any(char.isdigit() for char in term)
+    return has_ascii_letter and has_digit
+
+
+def should_use_filename_fts(term: str) -> bool:
+    """
+    trigram FTS は 3 文字以上の部分一致で有効に使い、短すぎる語だけ LIKE へフォールバックする。
+    """
+    return len(term) >= 3
+
+
+def quote_fts_term(term: str) -> str:
+    escaped_term = term.replace('"', '""')
+    return f'"{escaped_term}"'
+
+
+def build_fts_content_query(query: str) -> str:
+    """
+    FTS5 の本文検索は content カラムだけへ限定し、segment_label 側の誤一致を避ける。
+    """
+    return f"content:({query})"
+
+
+def escape_like_pattern(value: str) -> str:
+    return value.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
+
+
+def compile_regex(pattern: str) -> re.Pattern[str]:
+    """
+    不正な正規表現は 400 系エラーとして利用者に返す。
+    """
+    try:
+        return re.compile(pattern, re.IGNORECASE)
+    except re.error as error:
+        raise HTTPException(
+            status_code=status.HTTP_400_BAD_REQUEST,
+            detail=f"正規表現が不正です: {error}",
+        ) from error
diff --git a/backend/app/services/search_refresh.py b/backend/app/services/search_refresh.py
new file mode 100644
index 0000000000000000000000000000000000000000..8f48386b1076f593e2539d5773d41bcfb145b7a6
--- /dev/null
+++ b/backend/app/services/search_refresh.py
@@ -0,0 +1,232 @@
+"""
+検索前のインデックス更新。
+
+- フォルダ未指定の検索: 登録済みの検索対象のうち、更新が必要なものを順に走査してから検索する。
+- フォルダ指定の検索: 既にインデックスがあれば検索は待たせず、更新はバックグラウンドへ回す。
+  まだインデックスが無いフォルダは、その場で走査してから検索する。
+- 到達できないフォルダや、別の走査が実行中の場合は、更新を諦めて既存のインデックスで検索する。
+"""
+
+from __future__ import annotations
+
+import logging
+import threading
+import time as time_module
+from sqlite3 import Connection
+
+from fastapi import HTTPException, status
+
+from app.db.connection import get_connection
+from app.services import app_settings_store, exclude_rules, web_pages
+from app.services.background_tasks import start_background_thread
+from app.services.index_service import IndexService
+
+# 同じ条件のバックグラウンド更新を、連続して予約しない間隔
+BACKGROUND_REFRESH_RETRY_COOLDOWN_SECONDS = 30.0
+logger = logging.getLogger(__name__)
+
+_BACKGROUND_REFRESH_LOCK = threading.Lock()
+_BACKGROUND_REFRESH_KEYS: set[tuple[str, str, int, str]] = set()
+_BACKGROUND_REFRESH_LAST_SCHEDULED_AT: dict[tuple[str, str, int, str], float] = {}
+
+
+class SearchRefresher:
+    """検索の直前に、対象のインデックスを必要な分だけ更新する。"""
+
+    def __init__(self, index_service: IndexService) -> None:
+        self.index_service = index_service
+
+
+    def refresh_registered_targets(
+        self,
+        *,
+        refresh_window_minutes: int,
+        effective_exclude_keywords: str,
+        index_depth: int,
+        index_types: str | None,
+        custom_content_extensions: str,
+        custom_filename_extensions: str,
+        source_type: str = "local",
+    ) -> None:
+        """
+        フォルダ未指定かつ全 DB 検索 OFF のときは、検索対象フォルダを順次再インデックスする。
+        有効対象があればそれを優先し、0 件なら登録済みフォルダ全体へフォールバックする。
+        """
+        target_paths = self.index_service.list_search_scope_paths(source_type=source_type)
+        if not target_paths:
+            return
+
+        normalized_extensions = app_settings_store.normalize_selected_extensions(
+            index_types,
+            custom_content_extensions=custom_content_extensions,
+            custom_filename_extensions=custom_filename_extensions,
+        )
+        for target_path in target_paths:
+            try:
+                target = self.index_service.targets.ensure_target(
+                    full_path=target_path,
+                    exclude_keywords=effective_exclude_keywords,
+                    index_depth=index_depth,
+                    selected_extensions=normalized_extensions,
+                )
+            except HTTPException as error:
+                if error.status_code == status.HTTP_400_BAD_REQUEST:
+                    continue
+                raise
+            effective_keywords = exclude_rules.merge_exclude_keyword_strings(
+                effective_exclude_keywords,
+                str(target.get("exclude_keywords") or ""),
+            )
+            if not self.index_service.targets.needs_refresh(
+                target,
+                refresh_window_minutes,
+                effective_keywords,
+                index_depth,
+                normalized_extensions,
+            ):
+                continue
+            try:
+                self.index_service.ensure_fresh_target(
+                    full_path=target_path,
+                    refresh_window_minutes=refresh_window_minutes,
+                    exclude_keywords=effective_keywords,
+                    index_depth=index_depth,
+                    types=index_types,
+                )
+            except HTTPException as error:
+                # 無効なパスや、バックグラウンド更新中（409 Conflict）は同期更新をスキップして既存インデックスで検索する
+                if error.status_code in (status.HTTP_400_BAD_REQUEST, status.HTTP_409_CONFLICT):
+                    continue
+                raise
+
+    def refresh_target(
+        self,
+        *,
+        normalized_target_path: str,
+        refresh_window_minutes: int,
+        effective_exclude_keywords: str,
+        index_depth: int,
+        index_types: str | None,
+        custom_content_extensions: str,
+        custom_filename_extensions: str,
+    ) -> dict[str, bool]:
+        """
+        既存インデックスがあるフォルダは既存結果を優先し、必要な再更新だけをバックグラウンドへ回す。
+        初回検索や未インデックス状態では従来どおり同期インデックスを行う。
+        """
+        normalized_extensions = app_settings_store.normalize_selected_extensions(
+            index_types,
+            custom_content_extensions=custom_content_extensions,
+            custom_filename_extensions=custom_filename_extensions,
+        )
+        effective_target_path = (
+            self.index_service.targets.resolve_enabled_covering_path(
+                normalized_target_path,
+                source_type="web" if web_pages.is_web_url(normalized_target_path) else "local",
+            )
+            or normalized_target_path
+        )
+        try:
+            target = self.index_service.targets.ensure_target(
+                full_path=effective_target_path,
+                exclude_keywords=effective_exclude_keywords,
+                index_depth=index_depth,
+                selected_extensions=normalized_extensions,
+            )
+        except HTTPException as error:
+            # 既存インデックスだけでも検索できるよう、到達不能/未接続パスでは再更新を諦めて現在の DB を使う。
+            if error.status_code == status.HTTP_400_BAD_REQUEST:
+                return {"used_existing_index": True, "background_refresh_scheduled": False}
+            raise
+        effective_keywords = exclude_rules.merge_exclude_keyword_strings(
+            effective_exclude_keywords,
+            str(target.get("exclude_keywords") or ""),
+        )
+        needs_refresh = self.index_service.targets.needs_refresh(
+            target,
+            refresh_window_minutes,
+            effective_keywords,
+            index_depth,
+            normalized_extensions,
+        )
+        has_existing_index = target.get("last_indexed_at") is not None
+        if not needs_refresh:
+            return {"used_existing_index": False, "background_refresh_scheduled": False}
+        if not has_existing_index:
+            try:
+                self.index_service.ensure_fresh_target(
+                    full_path=effective_target_path,
+                    refresh_window_minutes=refresh_window_minutes,
+                    exclude_keywords=effective_keywords,
+                    index_depth=index_depth,
+                    types=index_types,
+                )
+            except HTTPException as error:
+                if error.status_code != status.HTTP_409_CONFLICT:
+                    raise
+            return {"used_existing_index": False, "background_refresh_scheduled": False}
+
+        scheduled = self.schedule_background_refresh(
+            normalized_target_path=effective_target_path,
+            effective_exclude_keywords=effective_keywords,
+            index_depth=index_depth,
+            index_types=index_types,
+        )
+        return {"used_existing_index": True, "background_refresh_scheduled": scheduled}
+
+    def schedule_background_refresh(
+        self,
+        *,
+        normalized_target_path: str,
+        effective_exclude_keywords: str,
+        index_depth: int,
+        index_types: str | None,
+    ) -> bool:
+        """
+        同一条件の再インデックスは1本だけ裏で実行し、検索レスポンス自体は待たない。
+        """
+        normalized_index_types = index_types or ""
+        refresh_key = (
+            normalized_target_path,
+            effective_exclude_keywords,
+            index_depth,
+            normalized_index_types,
+        )
+        with _BACKGROUND_REFRESH_LOCK:
+            if refresh_key in _BACKGROUND_REFRESH_KEYS:
+                return False
+            last_scheduled_at = _BACKGROUND_REFRESH_LAST_SCHEDULED_AT.get(refresh_key)
+            now = time_module.monotonic()
+            if last_scheduled_at is not None and now - last_scheduled_at < BACKGROUND_REFRESH_RETRY_COOLDOWN_SECONDS:
+                return False
+            _BACKGROUND_REFRESH_KEYS.add(refresh_key)
+            _BACKGROUND_REFRESH_LAST_SCHEDULED_AT[refresh_key] = now
+
+        def run_refresh() -> None:
+            connection: Connection | None = None
+            try:
+                connection = get_connection()
+                index_service = IndexService(connection=connection)
+                if index_service.is_running():
+                    return
+                index_service.ensure_fresh_target(
+                    full_path=normalized_target_path,
+                    refresh_window_minutes=0,
+                    exclude_keywords=effective_exclude_keywords,
+                    index_depth=index_depth,
+                    types=normalized_index_types,
+                )
+            except HTTPException:
+                pass
+            except Exception:
+                logger.warning(
+                    "Background refresh failed: target=%s", normalized_target_path, exc_info=True
+                )
+            finally:
+                if connection is not None:
+                    connection.close()
+                with _BACKGROUND_REFRESH_LOCK:
+                    _BACKGROUND_REFRESH_KEYS.discard(refresh_key)
+
+        start_background_thread(run_refresh, name="search-background-refresh")
+        return True
diff --git a/backend/app/services/search_result_items.py b/backend/app/services/search_result_items.py
new file mode 100644
index 0000000000000000000000000000000000000000..5844a158d609dfcdaa7e982de1b11cd60c1912aa
--- /dev/null
+++ b/backend/app/services/search_result_items.py
@@ -0,0 +1,204 @@
+"""
+検索結果（SearchResultItem）の組み立て・除外判定・並び替え・ページ切り出し。
+
+DB から読んだ行を画面用のモデルへ変換する。SQL で並び替えられない場合（フォルダ結果との統合、
+正規表現検索、gantt タスクとの統合）は、ここの並び替えで SQL と同じ順序規則を再現する。
+"""
+
+from __future__ import annotations
+
+import time as time_module
+from datetime import UTC, datetime
+
+from app.models.search import SearchQueryParams, SearchResponse, SearchResultItem
+from app.services import exclude_rules, search_snippets
+from app.services.path_service import matches_exclude_keyword, normalize_path
+
+
+def should_exclude_search_result(
+    *,
+    target_path: str,
+    candidate_path: str,
+    excluded_keywords: list[str],
+) -> bool:
+    """
+    検索結果の除外判定。
+    1. Web URL またはローカルファイル名/ステムに除外キーワードが含まれる場合は除外。
+    2. パス形式またはディレクトリ名による除外判定を対象フォルダ配下の相対パスに対して行う。
+    """
+    if not excluded_keywords:
+        return False
+    if target_path.startswith(("http://", "https://")) or candidate_path.startswith(("http://", "https://")):
+        lowered_candidate = candidate_path.lower()
+        return any(keyword.lower() in lowered_candidate for keyword in excluded_keywords)
+
+    result_path = normalize_path(candidate_path)
+    # ファイル名（または末尾の名前）およびステムに対する除外キーワード判定
+    file_name = result_path.name
+    stem = result_path.stem
+    for kw in excluded_keywords:
+        kw_clean = kw.strip()
+        if not kw_clean:
+            continue
+        # パス区切りを含まないキーワードはファイル名またはステムの部分一致で除外
+        if "/" not in kw_clean and "\\" not in kw_clean:
+            if matches_exclude_keyword(file_name, kw_clean) or matches_exclude_keyword(stem, kw_clean):
+                return True
+
+    if not target_path:
+        return exclude_rules.should_exclude_path(result_path, excluded_keywords)
+
+    target_root = normalize_path(target_path)
+    try:
+        relative_path = result_path.relative_to(target_root)
+    except ValueError:
+        relative_path = result_path
+    return exclude_rules.should_exclude_path(relative_path, excluded_keywords)
+
+
+def resolve_folder_path(normalized_path: str, file_name: str) -> str:
+    """
+    正規化済みフルパスから、検索用の親フォルダーパスを取り出す。
+    """
+    if normalized_path.endswith(file_name):
+        return normalized_path[: -len(file_name)].rstrip("/") or "/"
+    parts = normalized_path.rsplit("/", 1)
+    return parts[0] if len(parts) == 2 and parts[0] else "/"
+
+
+def resolve_result_display_name(result_kind: str, full_path: str, file_name: str) -> str:
+    """
+    フォルダ結果ではフルパスではなく末尾名を表示名として返す。
+    """
+    if result_kind != "folder":
+        return file_name
+    trimmed = full_path.rstrip("/\\")
+    if not trimmed:
+        return full_path
+    last_separator_index = max(trimmed.rfind("/"), trimmed.rfind("\\"))
+    if last_separator_index < 0:
+        return trimmed
+    if last_separator_index == 0:
+        return trimmed
+    return trimmed[last_separator_index + 1 :]
+
+
+def resolve_folder_path_for_result(result_kind: str, full_path: str, file_name: str) -> str:
+    """
+    結果種別に応じて、スニペットや除外判定に使うフォルダーパスを返す。
+    """
+    if result_kind == "folder":
+        return full_path
+    return resolve_folder_path(full_path, file_name)
+
+
+def build_search_result_item(
+    *,
+    row,
+    normalized_target_path: str,
+    highlight_terms: list[str],
+    include_snippets: bool,
+) -> SearchResultItem:
+    """
+    DB 行から UI 用の検索結果モデルを組み立てる。
+    """
+    result_kind = str(row["result_kind"] or "file")
+    try:
+        source_type = str(row["source_type"] or "local")
+    except (KeyError, IndexError):
+        source_type = "local"
+    full_path = str(row["normalized_path"])
+    raw_name = str(row["file_name"])
+    display_name = resolve_result_display_name(result_kind, full_path, raw_name)
+    folder_path = resolve_folder_path_for_result(result_kind, full_path, raw_name)
+    return SearchResultItem(
+        file_id=int(row["file_id"]),
+        result_kind="folder" if result_kind == "folder" else "file",
+        source_type=source_type if source_type in {"web", "gantt"} else "local",
+        target_path=normalized_target_path,
+        file_name=display_name,
+        full_path=full_path,
+        file_ext=str(row["file_ext"]),
+        created_at=datetime.fromtimestamp(float(row["created_at"]), tz=UTC),
+        mtime=datetime.fromtimestamp(float(row["mtime"]), tz=UTC),
+        click_count=int(row["click_count"] or 0) + int(row["obsidian_click_count"] or 0),
+        has_obsidian_top_tag=bool(row["has_obsidian_top_tag"]),
+        filename_match_priority=int(row["filename_match_level"] or 0) >= 2,
+        filename_match_level=int(row["filename_match_level"] or 0),
+        relevance_bucket=int(row["relevance_bucket"] or 0),
+        utility_score=float(row["utility_score"] or 0.0),
+        query_click_score=float(row["query_click_score"] or 0.0),
+        snippet=(
+            search_snippets.resolve_snippet(
+                snippet=row["snippet"],
+                file_name=display_name,
+                segment_type=str(row["segment_type"] or "filename"),
+                body_content=row["body_content"],
+                folder_path=folder_path,
+                highlight_terms=highlight_terms,
+            )
+            if include_snippets
+            else ""
+        ),
+    )
+
+
+def sort_search_result_items(
+    items: list[SearchResultItem],
+    *,
+    sort_by: str,
+    sort_order: str,
+) -> list[SearchResultItem]:
+    """
+    Python 側で構築した検索結果を UI 指定の並び順で安定ソートする。
+    """
+    if sort_by == "default":
+        return sorted(
+            items,
+            key=lambda item: (
+                item.filename_match_level,
+                item.has_obsidian_top_tag,
+                item.query_click_score,
+                item.relevance_bucket,
+                item.utility_score,
+                item.mtime.timestamp(),
+                item.file_id,
+            ),
+            reverse=True,
+        )
+
+    reverse = sort_order == "desc"
+
+    def key(item: SearchResultItem) -> tuple[float, int]:
+        if sort_by == "click_count":
+            return (float(item.click_count), item.file_id)
+        if sort_by == "created":
+            return (item.created_at.timestamp(), item.file_id)
+        return (item.mtime.timestamp(), item.file_id)
+
+    return sorted(items, key=key, reverse=reverse)
+
+
+def paginate_search_items(items: list[SearchResultItem], params: SearchQueryParams) -> SearchResponse:
+    """
+    並び替え済みの結果一覧から、offset / limit の範囲を切り出してレスポンスにする。
+    """
+    page_items = items[params.offset : params.offset + params.limit]
+    has_more = params.offset + len(page_items) < len(items)
+    return SearchResponse(
+        total=len(items),
+        items=page_items,
+        has_more=has_more,
+        next_offset=params.offset + len(page_items) if has_more else None,
+    )
+
+
+def calculate_utility_score(*, click_count: int, obsidian_rank_score: float, mtime: float) -> float:
+    """
+    SQL版と同じ利用価値スコアを、正規表現検索などPython側の並び替え用に計算する。
+    """
+    popularity = click_count / (click_count + 10.0)
+    obsidian_importance = min(max(obsidian_rank_score / 1000.0, 0.0), 1.0)
+    age_seconds = max(time_module.time() - mtime, 0.0)
+    recency = 1.0 / (1.0 + age_seconds / (90 * 24 * 60 * 60))
+    return 0.55 * popularity + 0.25 * obsidian_importance + 0.20 * recency
