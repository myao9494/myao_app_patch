+def _prepare_obsidian_vault(tmp_path: Path, service: SearchService, access_counts: dict[str, int]) -> tuple[Path, Path]:
+    """sidebar-explorer の data.json を持つ Vault を作成し、連携先として設定する。"""
+    vault_root = tmp_path / "obsidian-vault"
+    (vault_root / "notes").mkdir(parents=True)
+    stats_path = vault_root / ".obsidian" / "plugins" / "obsidian-sidebar-explorer" / "data.json"
+    stats_path.parent.mkdir(parents=True)
+    stats_path.write_text(json.dumps({"accessCounts": access_counts}), encoding="utf-8")
+    service.index_service.update_app_settings(obsidian_sidebar_explorer_data_path=str(stats_path))
+    return vault_root, stats_path
+
+
+def _obsidian_click_count(connection: Connection, note_path: Path) -> int:
+    return int(
+        connection.execute(
+            "SELECT obsidian_click_count FROM files WHERE normalized_path = ?", (note_path.as_posix(),)
+        ).fetchone()[0]
+    )
+
+
+def test_sync_obsidian_access_counts_skips_database_write_when_nothing_changed(tmp_path: Path) -> None:
+    """
+    data.json と Vault 配下のインデックスが前回同期時から変わっていなければ、DB へ書き込まない。
+    """
+    connection = _create_connection(tmp_path)
+    service = SearchService(connection=connection)
+    vault_root, _stats_path = _prepare_obsidian_vault(tmp_path, service, {"notes/daily.md": 7})
+    note_path = vault_root / "notes" / "daily.md"
+    _insert_indexed_markdown(
+        connection=connection, file_name="daily.md", full_path=str(note_path),
+        created_at=datetime(2026, 4, 10, tzinfo=UTC), mtime=datetime(2026, 4, 10, tzinfo=UTC),
+        body="alpha", click_count=0,
+    )
+
+    _sync_obsidian_access_counts(service)
+    assert _obsidian_click_count(connection, note_path) == 7
+    changes_after_first_sync = connection.total_changes
+
+    _sync_obsidian_access_counts(service)
+
+    assert connection.total_changes == changes_after_first_sync
+    assert _obsidian_click_count(connection, note_path) == 7
+
+
+def test_sync_obsidian_access_counts_resyncs_when_data_file_changes(tmp_path: Path) -> None:
+    """
+    data.json が更新されたら、同期済みでも新しい値を取り込む。
+    """
+    connection = _create_connection(tmp_path)
+    service = SearchService(connection=connection)
+    vault_root, stats_path = _prepare_obsidian_vault(tmp_path, service, {"notes/daily.md": 7})
+    note_path = vault_root / "notes" / "daily.md"
+    _insert_indexed_markdown(
+        connection=connection, file_name="daily.md", full_path=str(note_path),
+        created_at=datetime(2026, 4, 10, tzinfo=UTC), mtime=datetime(2026, 4, 10, tzinfo=UTC),
+        body="alpha", click_count=0,
+    )
+    _sync_obsidian_access_counts(service)
+
+    stats_path.write_text(json.dumps({"accessCounts": {"notes/daily.md": 123}}), encoding="utf-8")
+    _sync_obsidian_access_counts(service)
+
+    assert _obsidian_click_count(connection, note_path) == 123
+
+
+def test_sync_obsidian_access_counts_resyncs_when_new_file_is_indexed(tmp_path: Path) -> None:
+    """
+    data.json が同じでも、Vault 配下に新しくインデックスされたファイルへは次の同期で値を反映する。
+    """
+    connection = _create_connection(tmp_path)
+    service = SearchService(connection=connection)
+    vault_root, _stats_path = _prepare_obsidian_vault(
+        tmp_path, service, {"notes/daily.md": 7, "notes/later.md": 4}
+    )
+    daily_path = vault_root / "notes" / "daily.md"
+    later_path = vault_root / "notes" / "later.md"
+    _insert_indexed_markdown(
+        connection=connection, file_name="daily.md", full_path=str(daily_path),
+        created_at=datetime(2026, 4, 10, tzinfo=UTC), mtime=datetime(2026, 4, 10, tzinfo=UTC),
+        body="alpha", click_count=0,
+    )
+    _sync_obsidian_access_counts(service)
+
+    _insert_indexed_markdown(
+        connection=connection, file_name="later.md", full_path=str(later_path),
+        created_at=datetime(2026, 4, 11, tzinfo=UTC), mtime=datetime(2026, 4, 11, tzinfo=UTC),
+        body="beta", click_count=0,
+    )
+    _sync_obsidian_access_counts(service)
+
+    assert _obsidian_click_count(connection, daily_path) == 7
+    assert _obsidian_click_count(connection, later_path) == 4
+
+
+def test_search_does_not_start_obsidian_sync_thread_when_integration_is_not_configured(
+    tmp_path: Path, monkeypatch
+) -> None:
+    """
+    Obsidian 連携先が未設定のときは、検索のたびに同期スレッドを起動しない。
+    """
+    connection = _create_connection(tmp_path)
+    service = SearchService(connection=connection)
+    started_threads: list[str] = []
+    monkeypatch.setattr(
+        obsidian_access_sync,
+        "start_background_thread",
+        lambda target, *, name: started_threads.append(name),
+    )
+
+    service.search(SearchQueryParams(q="alpha", search_all_enabled=True))
+    assert started_threads == []
+
+    service.index_service.update_app_settings(obsidian_sidebar_explorer_data_path=str(tmp_path / "data.json"))
+    service.search(SearchQueryParams(q="alpha", search_all_enabled=True))
+    assert started_threads == ["search-obsidian-sync"]
+    monkeypatch.setattr(obsidian_access_sync, "_OBSIDIAN_SYNC_RUNNING", False)
+
+
