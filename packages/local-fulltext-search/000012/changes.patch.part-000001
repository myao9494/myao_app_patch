         initialize_schema(connection)
+        _insert_file(connection, "/docs/a.md")
+        connection.commit()
+
+        initialize_schema(connection)
+
+        count = connection.execute("SELECT COUNT(*) FROM files").fetchone()[0]
+    finally:
+        connection.close()
+
+    assert count == 1
+    assert _backup_files(tmp_path / "search.db") == []
+
 
