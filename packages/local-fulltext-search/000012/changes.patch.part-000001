diff --git a/backend/tests/test_vector_state.py b/backend/tests/test_vector_state.py
index 5fdf7dd58d259ecdee850cc64a7d00e34361aac8..29e6a02af72cdb6ff3a6163f76502fc02542e632 100644
--- a/backend/tests/test_vector_state.py
+++ b/backend/tests/test_vector_state.py
@@ -122,3 +122,53 @@ def test_load_saved_model_safe_when_no_models_exist(tmp_path: Path) -> None:
     assert not state.is_loaded
 
 
+
+
+def test_request_cancel_stops_running_sync(tmp_path: Path) -> None:
+    """実行中のベクトルインデックス作成を中止できる。実行していないときの中止要求は何もしない。"""
+    folder = tmp_path / "cancel_folder"
+    folder.mkdir()
+    for index in range(5):
+        (folder / f"{index}.txt").write_text(f"テキスト {index}", encoding="utf-8")
+    state = VectorState(data_dir=tmp_path)
+    state.load_model(use_mock=True, mock_dim=64)
+
+    assert state.request_cancel() is False
+
+    def cancel_on_second_file(progress) -> None:
+        if progress.processed_files == 2:
+            assert state.request_cancel() is True
+
+    result = state.sync_index(target_folders=[str(folder)], progress_callback=cancel_on_second_file)
+
+    assert result is not None
+    assert result.cancelled is True
+    # 中止を要求した時点で処理中だった 2 件目までは保存し、3 件目へは進まない
+    assert result.new_count == 2
+    assert state.is_indexing is False
+
+
+def test_sync_requested_while_indexing_runs_after_the_current_one(tmp_path: Path) -> None:
+    """同期の実行中に来た別フォルダの同期要求は捨てず、今の同期が終わったら続けて実行する。"""
+    first = tmp_path / "first"
+    second = tmp_path / "second"
+    first.mkdir()
+    second.mkdir()
+    (first / "a.txt").write_text("テキスト A", encoding="utf-8")
+    (second / "b.txt").write_text("テキスト B", encoding="utf-8")
+    state = VectorState(data_dir=tmp_path)
+    state.load_model(use_mock=True, mock_dim=64)
+    queued_results: list[object] = []
+
+    def request_second_sync(progress) -> None:
+        if not queued_results:
+            queued_results.append(state.sync_index(target_folders=[str(second)], exclude_keywords=""))
+
+    state.sync_index(target_folders=[str(first)], exclude_keywords="", progress_callback=request_second_sync)
+
+    from app.vector.db import get_all_documents_metadata, get_model_db_path
+
+    documents = get_all_documents_metadata(get_model_db_path("mock_model", data_dir=tmp_path))
+    assert queued_results == [None]
+    assert {Path(path).name for path in documents} == {"a.txt", "b.txt"}
+    assert state.is_indexing is False
