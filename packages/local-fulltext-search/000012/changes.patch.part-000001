diff --git a/backend/tests/test_change_relevance.py b/backend/tests/test_change_relevance.py
new file mode 100644
index 0000000000000000000000000000000000000000..0aa9837ae5e4b067194fd9dc57605edc5fd947b4
--- /dev/null
+++ b/backend/tests/test_change_relevance.py
@@ -0,0 +1,156 @@
+"""
+変更通知がインデックスへ影響しうるかの判定（app.services.change_relevance）の単体テスト。
+
+仕様:
+- 検索対象フォルダ配下の変更だけが、その対象を dirty にする。
+- 除外キーワード（名前形式・パス形式・`foo/.` 形式）に該当する変更は、走査しても結果が変わらないため無視する。
+- 判定はインデックス走査と同じ規則で、`old` が `older` に誤一致するような過剰な除外はしない。
+- macOS(FSEvents) と Windows(ReadDirectoryChangesW / USN) の両方の dirty 化経路に適用される。
+"""
+
+import sqlite3
+from pathlib import Path
+
+import pytest
+
+from app.db.schema import initialize_schema
+from app.services.change_relevance import find_targets_affected_by_changes, is_change_relevant_to_target
+from app.services.change_tracking_service import ChangeTrackingService
+from app.services.windows_change_tracking import WindowsChangeTracker
+
+ROOT = "/Users/me/work"
+
+
+@pytest.mark.parametrize(
+    ("changed_path", "exclude_keywords", "expected"),
+    [
+        # 対象フォルダ配下の通常ファイル
+        (f"{ROOT}/notes/todo.md", "", True),
+        (f"{ROOT}/notes/todo.md", ".git\nnode_modules", True),
+        # 対象フォルダ自身への通知は常に関係あり
+        (ROOT, ".git", True),
+        # 対象フォルダの外・前方一致するだけの別フォルダ
+        ("/Users/me/other/todo.md", "", False),
+        ("/Users/me/work2/todo.md", "", False),
+        # 名前形式の除外（フォルダ名・ドット始まり・ファイル名）
+        (f"{ROOT}/repo/.git/index.lock", ".git", False),
+        (f"{ROOT}/repo/node_modules/pkg/index.js", "node_modules", False),
+        # 記号だけの名前キーワードは部分一致（インデックス走査と同じ規則。Office の一時ファイル ~$xxx を除外できる）
+        (f"{ROOT}/docs/~$draft.docx", "~$", False),
+        (f"{ROOT}/docs/~$/draft.docx", "~$", False),
+        (f"{ROOT}/docs/backup/report.md", "backup", False),
+        # 単語境界: old は older に一致しない
+        (f"{ROOT}/older/report.md", "old", True),
+        (f"{ROOT}/old/report.md", "old", False),
+        (f"{ROOT}/archive_old/report.md", "old", False),
+        # パス形式（絶対パス）: 先頭一致
+        (f"{ROOT}/app/src/main.py", f"{ROOT}/app", False),
+        (f"{ROOT}/application/main.py", f"{ROOT}/app", True),
+        # パス形式（相対パス）: 祖先の途中一致
+        (f"{ROOT}/vault/plugins/data.json", "vault/plugins", False),
+        (f"{ROOT}/vault/notes/data.json", "vault/plugins", True),
+        # foo/. 形式: foo 配下のドット始まり要素
+        (f"{ROOT}/vault/.obsidian/plugins/x/data.json", "vault/.", False),
+        (f"{ROOT}/vault/notes/a.md", "vault/.", True),
+        # 非 ASCII キーワードは部分一致
+        (f"{ROOT}/資料_旧版/a.md", "旧", False),
+    ],
+)
+def test_is_change_relevant_to_target(changed_path: str, exclude_keywords: str, expected: bool) -> None:
+    assert is_change_relevant_to_target(changed_path, ROOT, exclude_keywords) is expected
+
+
+def test_find_targets_affected_by_changes_uses_each_targets_own_exclude_keywords() -> None:
+    targets = [
+        {"id": 1, "full_path": "/data/a", "exclude_keywords": ".git"},
+        {"id": 2, "full_path": "/data/b", "exclude_keywords": ""},
+        {"id": 3, "full_path": "/data/c", "exclude_keywords": None},
+    ]
+
+    affected = find_targets_affected_by_changes(
+        targets,
+        ["/data/a/repo/.git/HEAD", "/data/b/repo/.git/HEAD", "/elsewhere/x.md"],
+    )
+
+    assert [target["id"] for target in affected] == [2]
+
+
+def _create_database(tmp_path: Path, root: Path, exclude_keywords: str) -> Path:
+    database_path = tmp_path / "search.db"
+    connection = sqlite3.connect(database_path)
+    connection.row_factory = sqlite3.Row
+    initialize_schema(connection)
+    connection.execute(
+        """
+        INSERT INTO targets (full_path, index_depth, exclude_keywords, source_type, created_at, updated_at)
+        VALUES (?, 5, ?, 'local', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)
+        """,
+        (root.as_posix(), exclude_keywords),
+    )
+    connection.commit()
+    connection.close()
+    return database_path
+
+
+def _dirty_flags(database_path: Path) -> list[int | None]:
+    connection = sqlite3.connect(database_path)
+    try:
+        rows = connection.execute(
+            """
+            SELECT target_change_states.is_dirty
+            FROM targets
+            LEFT JOIN target_change_states ON target_change_states.target_id = targets.id
+            """
+        ).fetchall()
+        return [row[0] for row in rows]
+    finally:
+        connection.close()
+
+
+def _connection_factory(database_path: Path):
+    def create_connection() -> sqlite3.Connection:
+        connection = sqlite3.connect(database_path)
+        connection.row_factory = sqlite3.Row
+        return connection
+
+    return create_connection
+
+
+def test_fsevents_change_inside_excluded_folder_does_not_mark_target_dirty(tmp_path: Path) -> None:
+    root = (tmp_path / "work").resolve()
+    root.mkdir()
+    database_path = _create_database(tmp_path, root, ".git\nnode_modules")
+    service = ChangeTrackingService(connection_factory=_connection_factory(database_path), ignored_paths=(tmp_path / "data",))
+
+    service.mark_changed_paths((str(root / "repo" / ".git" / "index.lock"), str(root / "node_modules" / "a.js")))
+    assert _dirty_flags(database_path) == [None]
+
+    service.mark_changed_paths((str(root / "repo" / ".git" / "index.lock"), str(root / "repo" / "README.md")))
+    assert _dirty_flags(database_path) == [1]
+
+
+def test_windows_change_inside_excluded_folder_does_not_mark_target_dirty(tmp_path: Path) -> None:
+    root = (tmp_path / "work").resolve()
+    root.mkdir()
+    database_path = _create_database(tmp_path, root, ".git")
+    tracker = WindowsChangeTracker(_connection_factory(database_path))
+
+    tracker.mark_changed_paths((str(root / "repo" / ".git" / "index.lock"),))
+    assert _dirty_flags(database_path) == [None]
+
+    tracker.mark_changed_paths((str(root / "notes" / "todo.md"),))
+    assert _dirty_flags(database_path) == [1]
+
+
+def test_rotated_backend_log_is_treated_as_internal_change(tmp_path: Path) -> None:
+    root = (tmp_path / "work").resolve()
+    root.mkdir()
+    log_path = root / "app" / "backend.log"
+    database_path = _create_database(tmp_path, root, "")
+    service = ChangeTrackingService(connection_factory=_connection_factory(database_path), ignored_paths=(log_path,))
+
+    service.mark_changed_paths((str(log_path), f"{log_path}.1", f"{log_path}.5"))
+    assert _dirty_flags(database_path) == [None]
+
+    service.mark_changed_paths((str(root / "app" / "backend.logic.md"),))
+    assert _dirty_flags(database_path) == [1]
diff --git a/backend/tests/test_change_tracking_service.py b/backend/tests/test_change_tracking_service.py
index 2bbbb44b854ea66d2887f6f241e8d436ed3d2d60..f1295bb73d6ccf00132c0600e4b53a7e550baf62 100644
--- a/backend/tests/test_change_tracking_service.py
+++ b/backend/tests/test_change_tracking_service.py
@@ -407,7 +407,7 @@ def test_dirty_refresh_worker_enables_vector_sync(monkeypatch, tmp_path: Path) -
             captured_init_kwargs.update(kwargs)
             captured_init_kwargs["connection"] = connection
 
-        def _is_running(self):
+        def is_running(self):
             return False
 
         def ensure_fresh_target(self, **kwargs):
@@ -420,3 +420,72 @@ def test_dirty_refresh_worker_enables_vector_sync(monkeypatch, tmp_path: Path) -
 
     assert captured_init_kwargs.get("enable_vector_sync") is True
 
+
+
+def test_macos_service_starts_dirty_refresh_worker_when_no_targets_exist_at_startup(monkeypatch, tmp_path: Path) -> None:
+    """
+    起動時に検索対象が 0 件でも dirty_refresh_worker を起動する。
+    起動後に追加された対象は target_synchronizer が dirty にするため、worker が無いと再起動まで自動更新されない。
+    """
+    import platform
+
+    from app.services.change_tracking_service import MacFSEventsObserver
+
+    monkeypatch.setattr(platform, "system", lambda: "Darwin")
+    monkeypatch.setattr(MacFSEventsObserver, "is_available", staticmethod(lambda: True))
+
+    database_path = tmp_path / "search.db"
+    connection = sqlite3.connect(database_path)
+    connection.row_factory = sqlite3.Row
+    initialize_schema(connection)
+    connection.close()
+
+    def create_connection() -> sqlite3.Connection:
+        created = sqlite3.connect(database_path)
+        created.row_factory = sqlite3.Row
+        return created
+
+    service = ChangeTrackingService(connection_factory=create_connection, ignored_paths=(tmp_path / "data",))
+    started = service.start()
+    try:
+        assert started is False
+        assert service._sync_thread is not None
+        assert service._sync_thread.is_alive()
+        assert service._refresh_thread is not None
+        assert service._refresh_thread.is_alive()
+    finally:
+        service.stop()
+
+
+def test_fsevents_observer_can_be_restarted_after_stop(monkeypatch) -> None:
+    """
+    stop() のあとに start() し直した監視スレッドは、停止フラグが解除された状態で動き始める。
+    （検索対象の追加・変更時に監視を張り直すため。フラグを使い回すと再開直後に監視が終了する）
+    """
+    import threading
+
+    from app.services.change_tracking_service import MacFSEventsObserver
+
+    monkeypatch.setattr(MacFSEventsObserver, "is_available", staticmethod(lambda: True))
+    observer = MacFSEventsObserver()
+    stop_flags_at_start: list[bool] = []
+    release = threading.Event()
+
+    def fake_run(stop_event: threading.Event) -> None:
+        stop_flags_at_start.append(stop_event.is_set())
+        release.wait(timeout=2.0)
+
+    monkeypatch.setattr(observer, "_run", fake_run)
+
+    # 未開始の状態で stop() が呼ばれても、その後の start() に影響しない
+    observer.stop()
+    assert observer.start(("/tmp/first",), lambda paths: None) is True
+    release.set()
+    observer.stop()
+
+    release.clear()
+    assert observer.start(("/tmp/second",), lambda paths: None) is True
+    release.set()
+    observer.stop()
+
+    assert stop_flags_at_start == [False, False]
diff --git a/backend/tests/test_db_maintenance.py b/backend/tests/test_db_maintenance.py
new file mode 100644
index 0000000000000000000000000000000000000000..0413226571c55ba81a403952021de088aa94f875
--- /dev/null
+++ b/backend/tests/test_db_maintenance.py
@@ -0,0 +1,98 @@
+"""
+DB 保守（空き領域の回収）の単体テスト。
+
+仕様:
+- 全文検索DBの圧縮は、削除済みデータが占めていた領域を回収し、残っているデータと検索結果を変えない。
+- インデックス実行中の DB には実行しない。
+- ベクトルDBの圧縮は、文書・チャンクを変えずに空き領域だけを回収する。
+"""
+
+from pathlib import Path
+import sqlite3
+
+import numpy as np
+import pytest
+
+from app.db.maintenance import DatabaseBusyError, compact_search_database, compact_vector_database
+from app.db.schema import initialize_schema
+from app.models.search import SearchQueryParams
+from app.services.search_service import SearchService
+from app.vector import db as vector_db
+
+
+def _open(db_path: Path) -> sqlite3.Connection:
+    connection = sqlite3.connect(db_path)
+    connection.row_factory = sqlite3.Row
+    connection.execute("PRAGMA foreign_keys = ON;")
+    return connection
+
+
+def test_compact_search_database_reclaims_space_and_keeps_search_results(tmp_path: Path) -> None:
+    db_path = tmp_path / "search.db"
+    connection = _open(db_path)
+    initialize_schema(connection)
+    service = SearchService(connection=connection)
+    kept = tmp_path / "kept"
+    removed = tmp_path / "removed"
+    kept.mkdir()
+    removed.mkdir()
+    (kept / "keep.md").write_text("apple pie recipe", encoding="utf-8")
+    for index in range(60):
+        (removed / f"bulk_{index}.md").write_text(f"filler {index} " + "lorem ipsum dolor " * 400, encoding="utf-8")
+    for folder in (kept, removed):
+        service.index_service.add_search_target(folder_path=folder.as_posix(), index_depth=5)
+    service.index_service.reindex_search_targets([kept.as_posix(), removed.as_posix()])
+    service.index_service.delete_indexed_targets([removed.as_posix()])
+    connection.execute("UPDATE files SET click_count = 3 WHERE file_name = 'keep.md'")
+    connection.commit()
+    before = service.search(SearchQueryParams(q="apple", search_all_enabled=True))
+    connection.close()
+
+    result = compact_search_database(db_path)
+
+    assert result.size_after < result.size_before
+    assert result.reclaimed_bytes == result.size_before - result.size_after
+    assert db_path.stat().st_size == result.size_after
+    connection = _open(db_path)
+    try:
+        after = SearchService(connection=connection).search(SearchQueryParams(q="apple", search_all_enabled=True))
+        assert [item.full_path for item in after.items] == [item.full_path for item in before.items]
+        assert [item.click_count for item in after.items] == [3]
+        assert SearchService(connection=connection).search(
+            SearchQueryParams(q="lorem", search_all_enabled=True)
+        ).items == []
+        assert connection.execute("PRAGMA integrity_check").fetchone()[0] == "ok"
+    finally:
+        connection.close()
+
+
+def test_compact_search_database_refuses_while_indexing_is_running(tmp_path: Path) -> None:
+    db_path = tmp_path / "search.db"
+    connection = _open(db_path)
+    initialize_schema(connection)
+    connection.execute("UPDATE index_runs SET is_running = 1 WHERE id = 1")
+    connection.commit()
+    connection.close()
+
+    with pytest.raises(DatabaseBusyError):
+        compact_search_database(db_path)
+
+
+def test_compact_vector_database_reclaims_space_and_keeps_documents(tmp_path: Path) -> None:
+    db_path = str(tmp_path / "vector.db")
+    vector_db.init_db(db_path)
+    vector = np.ones(256, dtype=np.float32).tobytes()
+    with vector_db.open_db(db_path) as conn:
+        for index in range(200):
+            vector_db.save_document_with_chunks(
+                conn, path=f"/docs/{index}.md", title=str(index), mtime=1.0, size=1, sha256=str(index),
+                text="body " * 200, embedding=vector,
+                chunks_data=[{"chunk_index": 0, "text": "chunk", "embedding": vector, "embedding_dim": 256}],
+            )
+    vector_db.delete_documents(db_path, [f"/docs/{index}.md" for index in range(1, 200)])
+
+    result = compact_vector_database(db_path)
+
+    assert result.size_after < result.size_before
+    assert set(vector_db.get_all_documents_metadata(db_path)) == {"/docs/0.md"}
+    assert vector_db.get_db_stats(db_path)["chunk_count"] == 1
