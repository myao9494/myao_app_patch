-def get_fnv1a_hash(val: str) -> str:
-    """Obsidian Excalidrawプラグイン互換のFNV-1aハッシュ計算 (32-bit unsigned hex)"""
-    normalized = val.replace("\\", "/").strip("/")
-    h = 2166136261
-    for c in normalized:
-        h = ((h ^ ord(c)) * 16777619) & 0xFFFFFFFF
-    return hex(h)[2:]
-
