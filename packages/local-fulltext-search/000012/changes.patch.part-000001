diff --git a/launcher/tests/conftest.py b/launcher/tests/conftest.py
new file mode 100644
index 0000000000000000000000000000000000000000..1d57bc1287fa8bfd90fee3374ced8401a8978afa
--- /dev/null
+++ b/launcher/tests/conftest.py
@@ -0,0 +1,22 @@
+"""
+ランチャーテスト共通の後始末。
+
+仕様:
+- 検索入力のデバウンスは threading.Timer で遅延実行される。テストが終わったあとにタイマーが発火すると、
+  すでに閉じられた出力へログを書こうとしてエラーが出る（テスト結果とは無関係なノイズになる）。
+- 各テストの終了時に、残っているタイマーを取り消して終了を待つ。
+"""
+
+import threading
+
+import pytest
+
+
+@pytest.fixture(autouse=True)
+def cancel_pending_timers():
+    """テスト中に開始され、まだ発火していないタイマーを取り消す。"""
+    yield
+    for thread in threading.enumerate():
+        if isinstance(thread, threading.Timer):
+            thread.cancel()
+            thread.join(timeout=1.0)
diff --git a/start_dev.sh b/start_dev.sh
index 5bd34a965b859e80e39554ece1d22e5ffaebb62e..ce8f0ed7e8d7764bd28caa938a1c217ac63e4a97 100755
--- a/start_dev.sh
+++ b/start_dev.sh
@@ -7,7 +7,9 @@ FRONTEND_DIR="${ROOT_DIR}/frontend"
 RUN_DIR="${ROOT_DIR}/.run"
 BACKEND_PORT="${BACKEND_PORT:-8079}"
 OPEN_HUB_BASE_URL="${OPEN_HUB_BASE_URL:-http://127.0.0.1:8001}"
-BACKEND_HOST="${BACKEND_HOST:-0.0.0.0}"
+# 既定は自端末からのみ接続可能にする（API に認証が無いため）。
+# 他の端末から使う場合だけ BACKEND_HOST=0.0.0.0 ./start_dev.sh のように明示する。
+BACKEND_HOST="${BACKEND_HOST:-127.0.0.1}"
 
 mkdir -p "${RUN_DIR}"
 
