+++ b/backend/app/services/local_target_indexer.py
@@ -0,0 +1,428 @@
+"""
+ローカルフォルダの検索対象を走査して全文インデックスへ反映する。
+
+走査は os.scandir、本文抽出はスレッド並列、SQLite への書き込みは直列で行う。
+- 除外フォルダへは再帰しない。エントリ名だけで除外判定する（親フォルダは再帰の途中で判定済み）。
+- 更新されていない成功済みファイルと、最近失敗して更新されていないファイルは再抽出しない。
+- 走査後、今回の走査範囲（階層・拡張子・除外条件）に含まれるのに見つからなかった行だけを削除する。
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+import time as time_module
+from concurrent.futures import FIRST_COMPLETED, Future, ThreadPoolExecutor, wait
+from dataclasses import dataclass
+
+from app.extractors.text_extractor import (
+    extract_text,
+    normalize_extension_filter,
+    resolve_supported_extension,
+    supports_content_extraction,
+)
+from app.services import app_settings_store, exclude_rules
+from app.services.file_walker import walk_indexable_files
+from app.services.index_run_state import IndexingCancelledError, IndexRunState, TargetIndexResult
+from app.services.indexed_file_store import IndexedFileCandidate, IndexedFileStore
+from app.services.path_service import normalize_path
+
+# 抽出に失敗し、その後も更新されていないファイルを再試行するまでの間隔。
+# 走査のたびに同じ壊れたファイルを解析し直さないための間隔で、一時的な失敗（他アプリによるロック等）は
+# この時間が過ぎれば次の走査で自動的に再試行される。画面からの再インデックスでは間隔に関係なく再試行する。
+FAILED_FILE_RETRY_INTERVAL_SECONDS = 60 * 60
+# 抽出済みファイルをまとめて commit する件数
+WRITE_BATCH_SIZE = 100
+logger = logging.getLogger(__name__)
+
+
+@dataclass(frozen=True)
+class IndexDrainStats:
+    """
+    抽出完了待ちの結果と、待機時間・DB反映時間をまとめて返す。
+    """
+
+    file_count: int
+    error_count: int
+    write_count: int
+    wait_seconds: float
+    db_write_seconds: float
+
+
+def resolve_extract_worker_count() -> int:
+    """
+    本文抽出スレッド数を CPU 数に応じて上限付きで決める。
+    I/Oバウンドタスクが支配的なため、CPU数の2倍（上限16）を使用する。
+    """
+    cpu_count = os.cpu_count() or 4
+    return max(2, min(16, cpu_count * 2))
+
+
+def can_skip_recently_failed_file(failed_at: float | None, stat: os.stat_result, *, now: float) -> bool:
+    """
+    前回の失敗以降に更新されておらず、再試行間隔も過ぎていない失敗ファイルは再抽出を省略する。
+    """
+    if failed_at is None:
+        return False
+    if stat.st_mtime > failed_at:
+        return False
+    return now - failed_at < FAILED_FILE_RETRY_INTERVAL_SECONDS
+
+
+def can_skip_existing_file(existing: dict[str, object] | None, stat: os.stat_result) -> bool:
+    """
+    変更のない成功済みファイルは再抽出を省略する。
+    """
+    if existing is None:
+        return False
+    if existing.get("last_error"):
+        return False
+    return float(existing["mtime"]) == stat.st_mtime and int(existing["size"]) == stat.st_size
+
+
+def resolve_created_at(stat: os.stat_result) -> float:
+    """
+    作成日時が取得できる環境では birth time を優先し、未対応環境では ctime へフォールバックする。
+    Linux では ctime が inode 変更時刻のため厳密な作成日ではないが、列を常に埋めて検索条件を維持する。
+    """
+    birth_time = getattr(stat, "st_birthtime", None)
+    if isinstance(birth_time, (int, float)):
+        return float(birth_time)
+    return float(stat.st_ctime)
+
+
+class LocalTargetIndexer:
+    """ローカルフォルダ 1 件分の走査と DB 反映を行う。"""
+
+    def __init__(self, files: IndexedFileStore, run_state: IndexRunState) -> None:
+        self.files = files
+        self.run_state = run_state
+
+    def index(
+        self,
+        target: dict[str, object],
+        exclude_keywords: str,
+        *,
+        index_depth: int,
+        cleanup_root_path: str,
+        cleanup_index_depth: int,
+        selected_extensions: str,
+        custom_content_extensions: str,
+        custom_filename_extensions: str,
+        retry_failed_files: bool = False,
+    ) -> TargetIndexResult:
+        """
+        指定ターゲット配下を高速に再走査する。
+        走査は os.scandir、本文抽出はスレッド並列、DB 書き込みは直列でまとめる。
+        前回抽出に失敗してから更新されていないファイルは、再試行間隔が過ぎるまで再抽出しない
+        （retry_failed_files=True のときは常に再試行する）。
+        """
+        total_start = time_module.perf_counter()
+        folder_path = normalize_path(str(target["full_path"]))
+        normalized_paths: set[str] = set()
+        failed_paths: set[str] = set()
+        auto_excluded_paths: set[str] = set()
+        file_count = 0
+        error_count = 0
+        write_count = 0
+        skipped_count = 0
+        submitted_extract_count = 0
+        filename_only_count = 0
+        batch_commit_count = 0
+        extraction_wait_seconds = 0.0
+        db_write_seconds = 0.0
+
+        setup_start = time_module.perf_counter()
+        keywords = exclude_rules.parse_exclude_keywords(exclude_keywords)
+        keyword_set, substring_keywords, excluded_path_prefixes = exclude_rules.compile_exclude_keywords(keywords)
+        custom_content_extension_list = tuple(app_settings_store.parse_extension_entries(custom_content_extensions))
+        custom_filename_extension_list = tuple(app_settings_store.parse_extension_entries(custom_filename_extensions))
+        allowed_extensions = normalize_extension_filter(
+            selected_extensions,
+            extra_content_extensions=custom_content_extension_list,
+            extra_filename_extensions=custom_filename_extension_list,
+        )
+        setup_elapsed = time_module.perf_counter() - setup_start
+        logger.info(
+            "Index: setup time: %.3fs (target=%s, keywords=%d, extensions=%d)",
+            setup_elapsed,
+            folder_path.as_posix(),
+            len(keywords),
+            len(allowed_extensions),
+        )
+        existing_start = time_module.perf_counter()
+        existing_files = self.files.load_existing_files(folder_path.as_posix())
+        failed_file_times = {} if retry_failed_files else self.files.load_failed_file_times(folder_path.as_posix())
+        scan_started_at = time_module.time()
+        existing_elapsed = time_module.perf_counter() - existing_start
+        logger.info(
+            "Index: existing metadata load time: %.3fs (target=%s, existing=%d)",
+            existing_elapsed,
+            folder_path.as_posix(),
+            len(existing_files),
+        )
+        sorted_allowed_extensions = tuple(sorted(allowed_extensions, key=len, reverse=True))
+        max_workers = resolve_extract_worker_count()
+        max_pending = max_workers * 4
+        pending: dict[Future[str], IndexedFileCandidate] = {}
+
+        executor = ThreadPoolExecutor(max_workers=max_workers)
+        cancelled = False
+        scan_start = time_module.perf_counter()
+        try:
+            for path in walk_indexable_files(
+                folder_path,
+                keyword_set,
+                substring_keywords,
+                excluded_path_prefixes=excluded_path_prefixes,
+                auto_excluded_paths=auto_excluded_paths,
+                allowed_extensions=allowed_extensions,
+                sorted_allowed_extensions=sorted_allowed_extensions,
+                max_depth=index_depth,
+            ):
+                self.run_state.raise_if_cancel_requested()
+                try:
+                    stat = path.stat()
+                    normalized_path = path.resolve().as_posix()
+                except FileNotFoundError:
+                    # 走査中に削除されたファイル（一時ファイルなど）。存在しないものとして扱う。
+                    continue
+                normalized_paths.add(normalized_path)
+                existing = existing_files.get(normalized_path)
+
+                if can_skip_existing_file(existing, stat):
+                    file_count += 1
+                    skipped_count += 1
+                    continue
+
+                if can_skip_recently_failed_file(
+                    failed_file_times.get(normalized_path), stat, now=scan_started_at
+                ):
+                    # 失敗記録を保持したまま再抽出だけを省く（件数上は従来どおり失敗として数える）
+                    failed_paths.add(normalized_path)
+                    error_count += 1
+                    continue
+
+                candidate = IndexedFileCandidate(
+                    path=path,
+                    normalized_path=normalized_path,
+                    created_at=resolve_created_at(stat),
+                    mtime=stat.st_mtime,
+                    size=stat.st_size,
+                    file_ext=resolve_supported_extension(
+                        path,
+                        extra_content_extensions=custom_content_extension_list,
+                        extra_filename_extensions=custom_filename_extension_list,
+                    )
+                    or path.suffix.lower(),
+                    existing_id=int(existing["id"]) if existing is not None else None,
+                )
+
+                if supports_content_extraction(
+                    path,
+                    extra_content_extensions=custom_content_extension_list,
+                    extra_filename_extensions=custom_filename_extension_list,
+                ):
+                    pending[
+                        executor.submit(
+                            extract_text,
+                            path,
+                            extra_content_extensions=custom_content_extension_list,
+                            extra_filename_extensions=custom_filename_extension_list,
+                        )
+                    ] = candidate
+                    submitted_extract_count += 1
+                    if len(pending) >= max_pending:
+                        result = self._drain_pending_futures(
+                            pending,
+                            failed_paths,
+                            drain_all=False,
+                        )
+                        file_count += result.file_count
+                        error_count += result.error_count
+                        write_count += result.write_count
+                        extraction_wait_seconds += result.wait_seconds
+                        db_write_seconds += result.db_write_seconds
+                else:
+                    write_start = time_module.perf_counter()
+                    self.files.upsert_file(candidate=candidate, content=None)
+                    db_write_seconds += time_module.perf_counter() - write_start
+                    file_count += 1
+                    write_count += 1
+                    filename_only_count += 1
+                    if write_count % WRITE_BATCH_SIZE == 0:
+                        commit_start = time_module.perf_counter()
+                        self.files.commit()
+                        db_write_seconds += time_module.perf_counter() - commit_start
+                        batch_commit_count += 1
+
+            result = self._drain_pending_futures(
+                pending,
+                failed_paths,
+                drain_all=True,
+            )
+            file_count += result.file_count
+            error_count += result.error_count
+            write_count += result.write_count
+            extraction_wait_seconds += result.wait_seconds
+            db_write_seconds += result.db_write_seconds
+            scan_elapsed = time_module.perf_counter() - scan_start - extraction_wait_seconds - db_write_seconds
+            logger.info(
+                "Index: scan/dispatch time: %.3fs (target=%s, scanned=%d, skipped=%d, submitted=%d, filename_only=%d, workers=%d, max_pending=%d)",
+                max(scan_elapsed, 0.0),
+                folder_path.as_posix(),
+                len(normalized_paths),
+                skipped_count,
+                submitted_extract_count,
+                filename_only_count,
+                max_workers,
+                max_pending,
+            )
+            logger.info(
+                "Index: extraction wait time: %.3fs (target=%s, submitted=%d, errors=%d)",
+                extraction_wait_seconds,
+                folder_path.as_posix(),
+                submitted_extract_count,
+                error_count,
+            )
+            logger.info(
+                "Index: DB write time: %.3fs (target=%s, writes=%d, batch_commits=%d)",
+                db_write_seconds,
+                folder_path.as_posix(),
+                write_count,
+                batch_commit_count,
+            )
+        except IndexingCancelledError:
+            cancelled = True
+            commit_start = time_module.perf_counter()
+            self.files.commit()
+            db_write_seconds += time_module.perf_counter() - commit_start
+            raise
+        finally:
+            executor.shutdown(wait=False, cancel_futures=True)
+
+        if not cancelled:
+            final_commit_start = time_module.perf_counter()
+            self.files.commit()
+            final_commit_elapsed = time_module.perf_counter() - final_commit_start
+            db_write_seconds += final_commit_elapsed
+            logger.info(
+                "Index: final commit time: %.3fs (target=%s, writes=%d)",
+                final_commit_elapsed,
+                folder_path.as_posix(),
+                write_count,
+            )
+            cleanup_start = time_module.perf_counter()
+            self.files.remove_deleted_files(
+                normalized_paths,
+                root_path=cleanup_root_path,
+                index_depth=cleanup_index_depth,
+                allowed_extensions=allowed_extensions,
+                preloaded_existing_files=existing_files,
+                keyword_set=keyword_set,
+                substring_keywords=substring_keywords,
+                excluded_path_prefixes=(*excluded_path_prefixes, *tuple(sorted(auto_excluded_paths))),
+            )
+            self.files.clear_resolved_failed_files(
+                root_path=cleanup_root_path,
+                failed_paths=failed_paths,
+                index_depth=cleanup_index_depth,
+                allowed_extensions=allowed_extensions,
+                keyword_set=keyword_set,
+                substring_keywords=substring_keywords,
+                excluded_path_prefixes=(*excluded_path_prefixes, *tuple(sorted(auto_excluded_paths))),
+            )
+            cleanup_elapsed = time_module.perf_counter() - cleanup_start
+            total_elapsed = time_module.perf_counter() - total_start
+            logger.info(
+                "Index: cleanup time: %.3fs (target=%s, failed_remaining=%d, auto_excluded=%d)",
+                cleanup_elapsed,
+                folder_path.as_posix(),
+                len(failed_paths),
+                len(auto_excluded_paths),
+            )
+            logger.info(
+                "Index: total time: %.3fs (target=%s, files=%d, writes=%d, skipped=%d, errors=%d)",
+                total_elapsed,
+                folder_path.as_posix(),
+                file_count,
+                write_count,
+                skipped_count,
+                error_count,
+            )
+
+        return TargetIndexResult(
+            file_count=file_count,
+            error_count=error_count,
+            exclude_keywords=exclude_rules.normalize_keyword_list([*keywords, *sorted(auto_excluded_paths)]),
+        )
+
+    def _drain_pending_futures(
+        self,
+        pending: dict[Future[str], IndexedFileCandidate],
+        failed_paths: set[str],
+        *,
+        drain_all: bool,
+    ) -> IndexDrainStats:
+        """
+        完了した抽出タスクだけを取り出して DB へ反映する。
+        """
+        if not pending:
+            return IndexDrainStats(
+                file_count=0,
+                error_count=0,
+                write_count=0,
+                wait_seconds=0.0,
+                db_write_seconds=0.0,
+            )
+
+        wait_start = time_module.perf_counter()
+        # ``extract_text`` は外部ファイル（特に破損・巨大PDF）の解析で長時間戻らない
+        # 場合がある。無期限の wait はキャンセル要求を確認できず、index_runs が実行中の
+        # まま残るため、短い待機ごとにDBの中止フラグを確認する。
+        remaining = set(pending)
+        done: set[Future[str]] = set()
+        while remaining:
+            completed, not_done = wait(
+                remaining,
+                timeout=0.25,
+                return_when=FIRST_COMPLETED,
+            )
+            if not completed:
+                self.run_state.raise_if_cancel_requested()
+                continue
+            done.update(completed)
+            remaining = not_done
+            if not drain_all:
+                break
+            self.run_state.raise_if_cancel_requested()
+        wait_seconds = time_module.perf_counter() - wait_start
+
+        file_count = 0
+        error_count = 0
+        write_count = 0
+        db_write_seconds = 0.0
+        for future in done:
+            self.run_state.raise_if_cancel_requested()
+            candidate = pending.pop(future)
+            try:
+                content = future.result()
+                write_start = time_module.perf_counter()
+                self.files.upsert_file(candidate=candidate, content=content)
+                db_write_seconds += time_module.perf_counter() - write_start
+                file_count += 1
+                write_count += 1
+            except Exception as error:
+                error_count += 1
+                failed_paths.add(candidate.normalized_path)
+                write_start = time_module.perf_counter()
+                self.files.record_file_error(candidate.path, error)
+                db_write_seconds += time_module.perf_counter() - write_start
+
+        return IndexDrainStats(
+            file_count=file_count,
+            error_count=error_count,
+            write_count=write_count,
+            wait_seconds=wait_seconds,
+            db_write_seconds=db_write_seconds,
+        )
diff --git a/backend/app/services/obsidian_access_sync.py b/backend/app/services/obsidian_access_sync.py
new file mode 100644
index 0000000000000000000000000000000000000000..19386138e1d5f2274b1e9d52365c7346cbebab93
--- /dev/null
+++ b/backend/app/services/obsidian_access_sync.py
@@ -0,0 +1,226 @@
+"""
+Obsidian（sidebar-explorer プラグイン）の利用状況を、検索順位の補助スコアとして取り込む。
+
+- プラグインの data.json から、ノートごとのアクセス数と重要度（被リンク数・最終閲覧日など）を読み、
+  files.obsidian_click_count / obsidian_rank_score へ保存する。
+- 同期は検索の完了後にバックグラウンドで行い、次回以降の検索順位へ反映する。同時に走るのは 1 本だけ。
+- data.json と Vault 配下のインデックス内容が前回の同期から変わっていなければ、DB へは書き込まない。
+- 連携先が未設定・存在しない・Vault を特定できない場合は何もしない。
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import math
+import threading
+import time as time_module
+from pathlib import Path
+from sqlite3 import Connection
+
+from app.db.connection import get_connection
+from app.services.background_tasks import start_background_thread
+from app.services.path_service import get_descendant_path_range, normalize_path_str
+
+OBSIDIAN_RANK_SCORE_SCALE = 1000.0
+logger = logging.getLogger(__name__)
+
+_OBSIDIAN_SYNC_LOCK = threading.Lock()
+_OBSIDIAN_SYNC_RUNNING = False
+# (DB の識別子, data.json のパス) ごとに、最後に同期した入力の状態を覚える
+_OBSIDIAN_SYNC_LAST_STATES: dict[tuple[str, str], tuple[int, int, int, int]] = {}
+
+
+def schedule_obsidian_access_sync(configured_data_path: str) -> None:
+    """
+    Obsidian の利用状況同期は検索完了後に非同期で行い、次回検索の順位へ反映する。
+    連携先が未設定のときは何もしない（検索のたびにスレッドとDB接続を作らない）。
+    """
+    if not configured_data_path:
+        return
+    global _OBSIDIAN_SYNC_RUNNING
+    with _OBSIDIAN_SYNC_LOCK:
+        if _OBSIDIAN_SYNC_RUNNING:
+            return
+        _OBSIDIAN_SYNC_RUNNING = True
+
+    def run_sync() -> None:
+        connection: Connection | None = None
+        try:
+            connection = get_connection()
+            sync_obsidian_access_counts(connection, configured_data_path)
+        except Exception:
+            logger.warning("Obsidian access sync failed.", exc_info=True)
+        finally:
+            if connection is not None:
+                connection.close()
+            global _OBSIDIAN_SYNC_RUNNING
+            with _OBSIDIAN_SYNC_LOCK:
+                _OBSIDIAN_SYNC_RUNNING = False
+
+    start_background_thread(run_sync, name="search-obsidian-sync")
+
+
+def sync_obsidian_access_counts(connection: Connection, configured_path: str) -> None:
+    """
+    sidebar-explorer の data.json からアクセス数と重要度スコアを files へ同期する。
+    data.json と Vault 配下のインデックス内容が前回同期時から変わっていなければ、
+    同じ値を書き直すだけになるため DB への書き込みを省略する。
+    """
+    if not configured_path:
+        return
+
+    data_path = Path(configured_path)
+    if not data_path.exists():
+        # 指定されたパスが存在しない場合は何もしない
+        return
+
+    # .obsidian ディレクトリの親を Vault ルートとして特定する。
+    data_path_abs = data_path.resolve()
+    vault_root_path: Path | None = None
+    for parent in data_path_abs.parents:
+        if (parent / ".obsidian").is_dir():
+            vault_root_path = parent
+            break
+
+    if vault_root_path is None:
+        # Vaultルート（.obsidianの親）が特定できない場合は、不正な構造とみなして終了する
+        return
+
+    vault_root = normalize_path_str(vault_root_path)
+    prefix_start, prefix_end = get_descendant_path_range(vault_root)
+    sync_state = _resolve_obsidian_sync_state(connection, data_path_abs, prefix_start, prefix_end)
+    state_key = (_resolve_database_identity(connection), str(data_path_abs))
+    with _OBSIDIAN_SYNC_LOCK:
+        if sync_state is not None and _OBSIDIAN_SYNC_LAST_STATES.get(state_key) == sync_state:
+            return
+
+    try:
+        payload = json.loads(data_path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError):
+        # 読み取り失敗時は静かに終了する
+        return
+
+    raw_metrics = payload.get("fileMetrics") or payload.get("files") or payload.get("metrics")
+    raw_access_counts = payload.get("accessCounts")
+    if raw_metrics is not None and not isinstance(raw_metrics, dict):
+        raw_metrics = None
+    if raw_metrics is None and not isinstance(raw_access_counts, dict):
+        return
+
+    connection.execute(
+        """
+        UPDATE files
+        SET obsidian_click_count = 0,
+            obsidian_rank_score = 0.0
+        WHERE normalized_path >= ? AND normalized_path < ?
+        """,
+        (prefix_start, prefix_end),
+    )
+
+    updates: list[tuple[int, float, str]] = []
+    raw_items = raw_metrics if isinstance(raw_metrics, dict) else raw_access_counts
+    for relative_path, raw_value in raw_items.items():
+        if not isinstance(relative_path, str):
+            continue
+        metrics = raw_value if isinstance(raw_value, dict) else {"accessCount": raw_value}
+        access_count = _coerce_non_negative_int(
+            metrics.get("accessCount", raw_access_counts.get(relative_path) if isinstance(raw_access_counts, dict) else 0)
+        )
+        rank_score = calculate_obsidian_rank_score(metrics)
+        normalized_full_path = normalize_path_str(Path(vault_root) / Path(relative_path))
+        updates.append((access_count, rank_score, normalized_full_path))
+
+    if updates:
+        connection.executemany(
+            "UPDATE files SET obsidian_click_count = ?, obsidian_rank_score = ? WHERE normalized_path = ?",
+            updates,
+        )
+    connection.commit()
+    if sync_state is not None:
+        with _OBSIDIAN_SYNC_LOCK:
+            _OBSIDIAN_SYNC_LAST_STATES[state_key] = sync_state
+    logger.info("Synced %d Obsidian ranking metrics from %s", len(updates), vault_root)
+
+
+def _resolve_database_identity(connection: Connection) -> str:
+    """接続先DBファイルを識別する文字列を返す（同期済み状態をDBごとに覚えるため）。"""
+    row = connection.execute("PRAGMA database_list").fetchone()
+    return str(row[2]) if row is not None and row[2] else f"memory:{id(connection)}"
+
+
+def _resolve_obsidian_sync_state(connection: Connection, data_path: Path, prefix_start: str, prefix_end: str
+) -> tuple[int, int, int, int] | None:
+    """
+    同期結果を左右する入力（data.json の更新時刻・サイズ、Vault 配下の件数と最大ID）を返す。
+    ファイルの追加・削除・再作成があれば値が変わり、同期をやり直す。
+    """
+    try:
+        stat = data_path.stat()
+    except OSError:
+        return None
+    row = connection.execute(
+        """
+        SELECT COUNT(*) AS file_count, COALESCE(MAX(id), 0) AS max_id
+        FROM files
+        WHERE normalized_path >= ? AND normalized_path < ?
+        """,
+        (prefix_start, prefix_end),
+    ).fetchone()
+    return (stat.st_mtime_ns, stat.st_size, int(row["file_count"]), int(row["max_id"]))
+
+
+def calculate_obsidian_rank_score(metrics: dict[str, object]) -> float:
+    """
+    Obsidian ノートの重要度を、検索語一致を壊さない補助スコアへ正規化する。
+    """
+    now_ms = time_module.time() * 1000
+    access_score = _log_score(metrics.get("accessCount"))
+    backlink_score = _log_score(metrics.get("backlinkCount"))
+    last_opened_score = _recency_score(metrics.get("lastOpenedAt"), now_ms, half_life_days=21)
+    modified_score = _recency_score(metrics.get("modifiedAt"), now_ms, half_life_days=45)
+    outgoing_score = _log_score(metrics.get("outgoingLinkCount"))
+    attachment_score = _log_score(metrics.get("attachmentCount"))
+    heading_score = _log_score(metrics.get("headingCount"))
+    tag_score = _log_score(metrics.get("tagCount"))
+
+    return round(
+        OBSIDIAN_RANK_SCORE_SCALE
+        * (
+            0.28 * backlink_score
+            + 0.22 * access_score
+            + 0.16 * last_opened_score
+            + 0.1 * modified_score
+            + 0.08 * outgoing_score
+            + 0.06 * tag_score
+            + 0.05 * heading_score
+            + 0.05 * attachment_score
+        ),
+        6,
+    )
+
+
+def _log_score(value: object) -> float:
+    return min(1.0, math.log1p(_coerce_non_negative_int(value)) / math.log1p(50))
+
+
+def _recency_score(value: object, now_ms: float, *, half_life_days: int) -> float:
+    timestamp = _coerce_non_negative_float(value)
+    if timestamp <= 0 or timestamp > now_ms:
+        return 0.0
+    age_days = (now_ms - timestamp) / (1000 * 60 * 60 * 24)
+    return 0.5 ** (age_days / half_life_days)
+
+
+def _coerce_non_negative_int(value: object) -> int:
+    try:
+        return max(int(value), 0)
+    except (TypeError, ValueError):
+        return 0
+
+
+def _coerce_non_negative_float(value: object) -> float:
+    try:
+        return max(float(value), 0.0)
+    except (TypeError, ValueError):
+        return 0.0
diff --git a/backend/app/services/regex_search.py b/backend/app/services/regex_search.py
new file mode 100644
index 0000000000000000000000000000000000000000..6a8bacfc34a89f3d6e9fb048dddd241c04e9145b
--- /dev/null
+++ b/backend/app/services/regex_search.py
@@ -0,0 +1,243 @@
+"""
+正規表現検索。
+
+候補のファイルを DB から順に読み、本文・ファイル名・フォルダパスを Python の re で評価する。
+フォルダパスだけに一致した場合は、フォルダを 1 件の結果として返す（file_id は負の連番）。
+"""
+
+from __future__ import annotations
+
+import logging
+import re
+import time as time_module
+from collections.abc import Callable, Sequence
+from datetime import UTC, datetime
+from sqlite3 import Connection, Row
+
+from app.models.indexing import AppSettingsResponse
+from app.models.search import SearchQueryParams, SearchResponse, SearchResultItem
+from app.services import exclude_rules, search_query, search_result_items, search_snippets, search_sql
+from app.services.path_service import normalize_path
+
+logger = logging.getLogger(__name__)
+
+
+def search_with_regex(
+    connection: Connection,
+    *,
+    params: SearchQueryParams,
+    normalized_target_path: str,
+    excluded_keywords: list[str],
+    app_settings: AppSettingsResponse,
+    path_depth_limit: int | None,
+    resolve_default_target_paths: Callable[[str], list[str]] | None = None,
+    restrict_file_ids: Sequence[int] | None = None,
+) -> SearchResponse:
+    """
+    正規表現モードでは Python の re で本文とファイル名を評価する。
+    イテレータで逐次処理し、メモリ使用量を抑える。
+    """
+    regex_start = time_module.perf_counter()
+    scoped_files_cte_sql, values = search_sql.build_scoped_files_cte(
+        normalized_target_path=normalized_target_path,
+        search_all_enabled=params.search_all_enabled,
+        path_depth_limit=path_depth_limit,
+        types=params.types,
+        date_field=params.date_field,
+        created_from=params.created_from,
+        created_to=params.created_to,
+        custom_content_extensions=app_settings.custom_content_extensions,
+        custom_filename_extensions=app_settings.custom_filename_extensions,
+        source_type=params.source_type,
+        resolve_default_target_paths=resolve_default_target_paths,
+        restrict_file_ids=restrict_file_ids,
+    )
+    cte_elapsed = time_module.perf_counter() - regex_start
+    logger.info("Regex: Scoped files CTE build time: %.3fs", cte_elapsed)
+
+    normalized_query = params.q.strip()
+    include_groups, exclude_terms = search_query.split_search_terms(normalized_query)
+    flat_include_terms = [term for group in include_groups for term in group]
+    pattern = search_query.compile_regex(" ".join(flat_include_terms))
+    search_body = search_query.search_target_includes_body(params.search_target)
+
+    search_filename = search_query.search_target_includes_filename(params.search_target)
+    search_folder = search_query.search_target_includes_folder(params.search_target)
+    cursor = connection.execute(
+        f"""
+        {scoped_files_cte_sql}
+        SELECT
+            scoped_files.id AS file_id,
+            scoped_files.file_name,
+            scoped_files.normalized_path,
+            scoped_files.file_ext,
+            scoped_files.created_at,
+            scoped_files.mtime,
+            scoped_files.click_count,
+            scoped_files.obsidian_click_count,
+            scoped_files.obsidian_rank_score,
+            scoped_files.has_obsidian_top_tag,
+            scoped_files.source_type,
+            file_segments.content
+        FROM scoped_files
+        LEFT JOIN file_segments
+            ON file_segments.file_id = scoped_files.id
+           AND file_segments.segment_type = 'body'
+        ORDER BY {search_sql.build_scan_order_by_clause(
+            sort_by=params.sort_by,
+            sort_order=params.sort_order,
+            table_alias="scoped_files",
+        )}
+        """,
+        tuple(values),
+    )
+
+    exec_elapsed = time_module.perf_counter() - regex_start - cte_elapsed
+    logger.info("Regex: DB execution time: %.3fs", exec_elapsed)
+
+    proc_start = time_module.perf_counter()
+
+    file_items: list[SearchResultItem] = []
+    folder_items_by_path: dict[str, SearchResultItem] = {}
+    for row in cursor:
+        normalized_path = str(row["normalized_path"])
+        if exclude_rules.should_exclude_path(normalize_path(normalized_path), excluded_keywords):
+            continue
+
+        file_name = str(row["file_name"])
+        folder_path = search_result_items.resolve_folder_path(normalized_path, file_name)
+        content = str(row["content"] or "")
+        content_match = pattern.search(content) if search_body else None
+        file_name_match = pattern.search(file_name) if search_filename else None
+        folder_path_match = pattern.search(folder_path) if search_folder else None
+        if content_match is None and file_name_match is None and folder_path_match is None:
+            continue
+        if search_query.matches_excluded_search_terms(
+            file_name=file_name,
+            body_content=content,
+            folder_path=folder_path,
+            exclude_terms=exclude_terms,
+        ):
+            continue
+
+        if content_match is not None or file_name_match is not None:
+            file_items.append(
+                _build_file_item(
+                    row,
+                    normalized_target_path=normalized_target_path,
+                    folder_path=folder_path,
+                    content_match=content_match,
+                    file_name_match=file_name_match,
+                    include_snippets=params.include_snippets,
+                )
+            )
+
+        if folder_path_match is not None and folder_path not in folder_items_by_path:
+            folder_items_by_path[folder_path] = _build_folder_item(
+                row,
+                # フォルダ結果は files に行が無いため、負の連番を割り当てる
+                file_id=-len(folder_items_by_path) - 1,
+                normalized_target_path=normalized_target_path,
+                folder_path=folder_path,
+                folder_path_match=folder_path_match,
+                include_snippets=params.include_snippets,
+            )
+
+    all_items = search_result_items.sort_search_result_items(
+        [*file_items, *folder_items_by_path.values()],
+        sort_by=params.sort_by,
+        sort_order=params.sort_order,
+    )
+    response = search_result_items.paginate_search_items(all_items, params)
+
+    proc_elapsed = time_module.perf_counter() - proc_start
+    logger.info(
+        "Regex: Result processing and matching time: %.3fs (total=%d, visible=%d)",
+        proc_elapsed,
+        len(all_items),
+        len(response.items),
+    )
+    return response
+
+
+def _build_file_item(
+    row: Row,
+    *,
+    normalized_target_path: str,
+    folder_path: str,
+    content_match: re.Match[str] | None,
+    file_name_match: re.Match[str] | None,
+    include_snippets: bool,
+) -> SearchResultItem:
+    """本文またはファイル名が一致したファイルの検索結果を作る。"""
+    file_name = str(row["file_name"])
+    click_count = int(row["click_count"] or 0) + int(row["obsidian_click_count"] or 0)
+    return SearchResultItem(
+        file_id=int(row["file_id"]),
+        result_kind="file",
+        source_type="web" if str(row["source_type"] or "local") == "web" else "local",
+        target_path=normalized_target_path,
+        file_name=file_name,
+        full_path=str(row["normalized_path"]),
+        file_ext=str(row["file_ext"]),
+        created_at=datetime.fromtimestamp(float(row["created_at"]), tz=UTC),
+        mtime=datetime.fromtimestamp(float(row["mtime"]), tz=UTC),
+        click_count=click_count,
+        has_obsidian_top_tag=bool(row["has_obsidian_top_tag"]),
+        filename_match_priority=file_name_match is not None,
+        filename_match_level=2 if file_name_match is not None else 0,
+        relevance_bucket=10,
+        utility_score=search_result_items.calculate_utility_score(
+            click_count=click_count,
+            obsidian_rank_score=float(row["obsidian_rank_score"] or 0.0),
+            mtime=float(row["mtime"]),
+        ),
+        snippet=(
+            search_snippets.build_regex_snippet(
+                content=str(row["content"] or ""),
+                file_name=file_name,
+                folder_path=folder_path,
+                content_match=content_match,
+                file_name_match=file_name_match,
+                folder_path_match=None,
+            )
+            if include_snippets
+            else ""
+        ),
+    )
+
+
+def _build_folder_item(
+    row: Row,
+    *,
+    file_id: int,
+    normalized_target_path: str,
+    folder_path: str,
+    folder_path_match: re.Match[str],
+    include_snippets: bool,
+) -> SearchResultItem:
+    """フォルダパスが一致したフォルダの検索結果を作る。日時は、最初に見つかった配下ファイルのものを使う。"""
+    return SearchResultItem(
+        file_id=file_id,
+        result_kind="folder",
+        source_type="local",
+        target_path=normalized_target_path,
+        file_name=search_result_items.resolve_result_display_name("folder", folder_path, folder_path),
+        full_path=folder_path,
+        file_ext="",
+        created_at=datetime.fromtimestamp(float(row["created_at"]), tz=UTC),
+        mtime=datetime.fromtimestamp(float(row["mtime"]), tz=UTC),
+        click_count=0,
+        snippet=(
+            search_snippets.build_regex_snippet(
+                content=str(row["content"] or ""),
+                file_name=str(row["file_name"]),
+                folder_path=folder_path,
+                content_match=None,
+                file_name_match=None,
+                folder_path_match=folder_path_match,
+            )
+            if include_snippets
+            else ""
+        ),
+    )
diff --git a/backend/app/services/scheduler_service.py b/backend/app/services/scheduler_service.py
