+    def _resolve_deletion_candidates(self, existing_paths: Sequence[str], seen_paths: Set[str]) -> List[str]:
+        """
+        DB に登録済みで今回の走査では見つからなかった文書のうち、削除してよいものを返す。
+        到達不能な対象フォルダ配下の文書は「消えた」のではなく「今は見えない」だけなので候補から外す
