+    setIsSaving(true);
+    try {
+      const res = await saveAiHtmlToFile({
+        html_content: generatedData.html_content,
+        file_name: generatedData.file_name || `${docTitle || "AI_Context_Document"}.html`,
+      });
+      if (res.saved_path) {
+        await navigator.clipboard.writeText(res.saved_path);
+        setSavedPathFeedback(`✅ パスをコピーしました: ${res.saved_path}`);
+        setTimeout(() => setSavedPathFeedback(null), 5000);
+      }
+    } catch (err: any) {
+      alert(`HTML保存に失敗しました: ${err.message}`);
+    } finally {
+      setIsSaving(false);
+    }
+  };
