+:root{--primary: hsl(217, 91%, 60%);--primary-hover: hsl(217, 91%, 65%);--bg-base: #0f172a;--bg-gradient-top: #1e293b;--bg-surface: rgba(30, 41, 59, .6);--border-light: rgba(255, 255, 255, .1);--text-main: #f8fafc;--text-muted: #94a3b8;--danger: hsl(348, 83%, 57%);font-family:Inter,-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;color:var(--text-main);background-color:var(--bg-base);background-image:radial-gradient(circle at 15% 50%,rgba(56,189,248,.08),transparent 25%),radial-gradient(circle at 85% 30%,rgba(129,140,248,.08),transparent 25%);background-attachment:fixed;line-height:1.6}*{box-sizing:border-box}body{margin:0;min-width:320px;min-height:100vh}button,input,textarea,select{font:inherit;transition:all .2s ease}.page-shell{max-width:1440px;margin:0 auto;padding:0 32px 80px}h1,h2,h3{font-weight:600;margin:0}.top-nav{position:sticky;top:0;z-index:40;padding:12px 0 10px;background:var(--bg-base);border-bottom:1px solid var(--border-light);margin-bottom:14px}.search-nav{display:flex;gap:8px;width:100%;align-items:center}.search-panel{display:grid;gap:8px}.view-switcher{display:flex;gap:8px;margin-bottom:10px;flex-wrap:wrap}.top-nav .page-tab{padding:7px 12px;font-size:.82rem;line-height:1.2}.top-nav .top-filters{gap:12px;margin-bottom:6px}.top-nav .top-filters-main,.top-nav .top-filters-status{gap:8px}.top-nav .filter-group,.top-nav .depth-field-inline{gap:6px}.top-nav .search-input{padding:10px 16px}.top-nav .primary-button,.top-nav .index-cancel-button{min-height:42px;padding:0 18px;font-size:.92rem}.top-nav .menu-button,.top-nav .regex-toggle-button{min-height:42px;padding:0 12px}.top-nav .index-status-pill{min-width:0;height:40px;padding:0 12px;font-size:.85rem}.top-nav .extension-filter-input{padding:10px 14px}.top-nav .search-subfilters{margin-top:0}.divider{border:0;height:1px;background:var(--border-light);margin:16px 0}.menu-button{border:1px solid var(--border-light);background:var(--bg-surface);color:var(--text-main);-webkit-backdrop-filt