 ) -> bytes | None:
     """
     収集された画像リスト（PIL Image、所属ファイルパス、リンク記法）を上から下へ縦1列に連結し、
@@ -511,8 +514,8 @@ def build_image_strip(
 
         return combined
 
-    scale_steps = [1.0, 0.85, 0.70, 0.55]
-    jpeg_qualities = [92, 85, 75]
+    scale_steps = [1.0, 0.85, 0.70, 0.55, 0.45]
+    jpeg_qualities = [92, 85, 75, 60]
 
     canvas = render_combined_canvas(1.0)
     buf = io.BytesIO()
@@ -531,10 +534,65 @@ def build_image_strip(
             if len(data) <= max_bytes:
                 return data
 
-    canvas = render_combined_canvas(0.45)
-    buf = io.BytesIO()
-    canvas.save(buf, format="JPEG", quality=65, optimize=True)
-    return buf.getvalue()
+    data = b""
+    for scale, quality in ((0.45, 65), (0.35, 50), (0.25, 35)):
+        buf = io.BytesIO()
+        render_combined_canvas(scale).save(buf, format="JPEG", quality=quality, optimize=True)
+        data = buf.getvalue()
+        if len(data) <= max_bytes:
+            break
+    return data
+
+
+@dataclass(frozen=True)
+class ImagePart:
+    """結合画像1枚分。figures は収録した図番号の範囲 (最初, 最後)。"""
+
+    data: bytes
+    figures: tuple[int, int]
+
+
+def _split_index(group: list[dict[str, Any]]) -> int:
+    """高さの累計が半分を超える位置で2分割する（両側が空にならないよう1〜len-1に収める）。"""
+    half = sum(item["image"].height for item in group) / 2
+    total = 0
+    for position, item in enumerate(group, start=1):
+        total += item["image"].height
+        if total >= half:
+            return min(max(position, 1), len(group) - 1)
+    return len(group) - 1
+
+
+def build_image_parts(
+    images_data: list[dict[str, Any]],
+    target_width: int | None = None,
+    max_bytes: int = MAX_IMAGE_BYTES,
+    split_threshold: int = IMAGE_SPLIT_THRESHOLD_BYTES,
+) -> list[ImagePart]:
+    """
+    図を縦連結した画像を、各 max_bytes 以下の1枚以上に仕上げる。
+    連結した無圧縮PNGが max_bytes 以下ならそのまま、split_threshold 以下なら縮小・JPEG化で圧縮して1枚、
+    それを超えるなら図の境界で2分割して各々に同じ規則を適用する。1枚の図は分割できないため、その図だけを圧縮する。
+    """
+    if not images_data:
+        return []
+    unlimited = 1 << 60
+
+    def fit(group: list[dict[str, Any]]) -> list[ImagePart]:
+        figures = (group[0]["index"], group[-1]["index"])
+        png = build_image_strip(group, target_width, max_bytes=unlimited)
+        if len(png) <= max_bytes:
+            return [ImagePart(png, figures)]
+        if len(png) > split_threshold and len(group) > 1:
+            cut = _split_index(group)
+            return fit(group[:cut]) + fit(group[cut:])
+        compressed = build_image_strip(group, target_width, max_bytes=max_bytes)
+        if len(compressed) <= max_bytes or len(group) == 1:
+            return [ImagePart(compressed, figures)]
+        cut = _split_index(group)
+        return fit(group[:cut]) + fit(group[cut:])
+
+    return fit(images_data)
 
 
