diff --git a/frontend/src/lib/charCount.js b/frontend/src/lib/charCount.js
new file mode 100644
index 0000000000000000000000000000000000000000..4ec69eb84f853b53e4a2f01db9f52a51c4ae011e
--- /dev/null
+++ b/frontend/src/lib/charCount.js
@@ -0,0 +1,19 @@
+/**
+ * 出力テキストの文字数表示 (charCount.js)
+ *
+ * 仕様:
+ * 1. countChars: サロゲートペア(絵文字など)を1文字として数える（バックエンドのPython len と同じ数え方）。
+ * 2. formatMan: 文字数を「12.35万文字」の形式にする。
+ * 3. CHAR_LIMIT: 社内AIに添付できるテキストの上限（20万文字）。
+ **/
+
+export const CHAR_LIMIT = 200000;
+
+const SURROGATE_PAIR = /[\uD800-\uDBFF][\uDC00-\uDFFF]/g;
+
+export const countChars = text => {
+  const value = text || '';
+  return value.length - (value.match(SURROGATE_PAIR)?.length || 0);
+};
+
+export const formatMan = count => `${(count / 10000).toFixed(2)}万文字`;
diff --git a/frontend/src/lib/charCount.test.js b/frontend/src/lib/charCount.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..f0b0eb7dd0d8d45875af76a46b5ddf301bc068b0
--- /dev/null
+++ b/frontend/src/lib/charCount.test.js
@@ -0,0 +1,23 @@
+import { describe, expect, it } from 'vitest';
+import { CHAR_LIMIT, countChars, formatMan } from './charCount';
+
+describe('countChars', () => {
+  it('空や未定義は0文字', () => {
+    expect(countChars('')).toBe(0);
+    expect(countChars(undefined)).toBe(0);
+  });
+
+  it('日本語と改行を1文字ずつ数える', () => expect(countChars('あい\nう')).toBe(4));
+
+  it('絵文字などのサロゲートペアは1文字として数える', () => expect(countChars('a😀b')).toBe(3));
+});
+
+describe('formatMan', () => {
+  it('万文字単位で小数2桁まで表示する', () => {
+    expect(formatMan(123456)).toBe('12.35万文字');
+    expect(formatMan(200000)).toBe('20.00万文字');
+    expect(formatMan(0)).toBe('0.00万文字');
+  });
+
+  it('上限は20万文字', () => expect(CHAR_LIMIT).toBe(200000));
+});
diff --git a/frontend/src/lib/download.js b/frontend/src/lib/download.js
index 19dfd61a0babab6de182d6cfd0ff37f938b02c7c..4d16885a1a8c91c09ffabde35b88f9257e0efce7 100644
--- a/frontend/src/lib/download.js
