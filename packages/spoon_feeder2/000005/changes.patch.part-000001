@@ -111,4 +111,13 @@
 .mkdocs-combined-image{width:100%;height:auto;border-radius:6px;border:1px solid #2b3a59;background:#fff}
 .mkdocs-actions{justify-content:space-between}
 .mkdocs-sub-actions,.mkdocs-main-actions{display:flex;align-items:center;gap:6px}
-
+.context-summary{padding:0 16px 8px}
+.char-count{display:flex;align-items:baseline;flex-wrap:wrap;gap:6px;font-size:10px;color:#8d9ab1;margin-bottom:6px}
+.char-count strong{color:#e8ecf7;font-size:12px}
+.char-count span{font-family:"JetBrains Mono",monospace;font-size:9px}
+.char-count em{font-style:normal;color:#fbbf24;font-weight:700}
+.char-count.over strong{color:#fbbf24}
+.part-tabs{padding:0;flex-wrap:wrap}
+.preview-char-count{margin:0 12px 0 auto;align-items:center}
+.mkdocs-image-part{margin:0;display:flex;flex-direction:column;gap:6px}
+.mkdocs-image-part figcaption{font-size:10px;font-weight:700;color:#c7d2e8}
