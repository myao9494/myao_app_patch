diff --git a/frontend/src/lib/download.js b/frontend/src/lib/download.js
index 4d16885a1a8c91c09ffabde35b88f9257e0efce7..8fc54dc1f9f104881f97e5d8650088e22fef6fcc 100644
--- a/frontend/src/lib/download.js
+++ b/frontend/src/lib/download.js
@@ -3,13 +3,11 @@
  *
  * 仕様:
  * 1. downloadText: テキストをUTF-8のファイルとして保存する。
- * 2. downloadDataUrl: Data URL(画像等)をファイルとして保存する。
- * 3. imageExtension: 結合画像のData URLからPNG/JPEGの拡張子を判定する。
+ * 2. downloadDataUrl: Data URL(図PDF等)をBlob経由でファイルとして保存する（大きなData URLをそのままリンクにしない）。
+ * 3. dataUrlToBlob: Base64のData URLをBlobへ変換する（PDFのプレビュー表示にも使う）。
  * 4. partFileName: 分割出力のファイル名（分割なしは `base.ext`、ありは `base_part2of3.ext`。バックエンドの命名と揃える）。
  **/
 
-export const imageExtension = dataUrl => (dataUrl.startsWith('data:image/png') ? 'png' : 'jpg');
-
 export const partFileName = (base, index, total, extension) => (total <= 1 ? `${base}.${extension}` : `${base}_part${index}of${total}.${extension}`);
 
 const clickDownload = (href, filename) => {
@@ -23,6 +21,16 @@ export function downloadText(filename, text) {
   URL.revokeObjectURL(url);
 }
 
+export function dataUrlToBlob(dataUrl) {
+  const [head, body = ''] = dataUrl.split(',');
+  const binary = atob(body);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i += 1) bytes[i] = binary.charCodeAt(i);
+  return new Blob([bytes], { type: head.slice(5, head.indexOf(';')) || 'application/octet-stream' });
+}
+
 export function downloadDataUrl(filename, dataUrl) {
-  clickDownload(dataUrl, filename);
+  const url = URL.createObjectURL(dataUrlToBlob(dataUrl));
+  clickDownload(url, filename);
+  setTimeout(() => URL.revokeObjectURL(url), 10000);
 }
