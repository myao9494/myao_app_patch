   });
 });
 
diff --git a/frontend/src/lib/pdfLimit.js b/frontend/src/lib/pdfLimit.js
new file mode 100644
index 0000000000000000000000000000000000000000..d92af9c7f37b00d7824aa77da33b65506d35c07a
--- /dev/null
+++ b/frontend/src/lib/pdfLimit.js
@@ -0,0 +1,17 @@
+/**
+ * 図PDFの上限サイズ(MB)の入力解釈 (pdfLimit.js)
+ *
+ * 仕様:
+ * 1. 既定は10MB。バックエンド(output_limits.py)の範囲(0.5〜1000MB)に合わせる。
+ * 2. 空・数値でない・範囲外の入力は、有効な値に丸める（空・数値でない場合は既定値、範囲外は上限/下限）。
+ **/
+
+export const DEFAULT_PDF_MAX_MB = 10;
+export const MIN_PDF_MAX_MB = 0.5;
+export const MAX_PDF_MAX_MB = 1000;
+
+export function parsePdfMaxMb(raw) {
+  const value = Number.parseFloat(raw);
+  if (!Number.isFinite(value)) return DEFAULT_PDF_MAX_MB;
+  return Math.min(MAX_PDF_MAX_MB, Math.max(MIN_PDF_MAX_MB, value));
+}
diff --git a/frontend/src/lib/pdfLimit.test.js b/frontend/src/lib/pdfLimit.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..342e71b5be4e68359336f2e47dd399f6b6ff7a4c
--- /dev/null
+++ b/frontend/src/lib/pdfLimit.test.js
@@ -0,0 +1,20 @@
+import { describe, expect, it } from 'vitest';
+import { DEFAULT_PDF_MAX_MB, parsePdfMaxMb } from './pdfLimit';
+
+describe('parsePdfMaxMb', () => {
+  it('既定は10MB', () => {
+    expect(DEFAULT_PDF_MAX_MB).toBe(10);
+    expect(parsePdfMaxMb(null)).toBe(10);
+  });
+
+  it('数値でない入力は既定値にする', () => {
+    expect(parsePdfMaxMb('')).toBe(10);
+    expect(parsePdfMaxMb('abc')).toBe(10);
+  });
+
+  it('小数を受け付け、範囲外は0.5〜1000MBに丸める', () => {
+    expect(parsePdfMaxMb('7.5')).toBe(7.5);
+    expect(parsePdfMaxMb('0')).toBe(0.5);
+    expect(parsePdfMaxMb('99999')).toBe(1000);
+  });
+});
