diff --git a/frontend/src/api.js b/frontend/src/api.js
new file mode 100644
index 0000000000000000000000000000000000000000..a02a9821eb07789c5dbec61d5d8fda24c74563ec
--- /dev/null
+++ b/frontend/src/api.js
@@ -0,0 +1,19 @@
+/**
+ * バックエンドAPIクライアント (api.js)
+ *
+ * 仕様:
+ * 1. JSONをPOST（またはGET）し、レスポンスのJSONを返す。HTTPエラー時は detail / message / HTTPステータスを持つErrorを投げる。
+ * 2. createApi(baseUrl) で接続先を切り替えられる（既定は同一オリジンの相対URL）。
+ **/
+
+export const createApi = (baseUrl = '') => async (url, body, method = 'POST') => {
+  const response = await fetch(`${baseUrl}${url}`, {
+    method, headers: { 'Content-Type': 'application/json' },
+    ...(body === undefined ? {} : { body: JSON.stringify(body) })
+  });
+  const data = await response.json().catch(() => ({}));
+  if (!response.ok) throw new Error(data.detail || data.message || `HTTP ${response.status}`);
+  return data;
+};
+
+export const api = createApi();
diff --git a/frontend/src/api.test.js b/frontend/src/api.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..6149425587e212bedfe3b993da1afc0bf0ca1779
--- /dev/null
+++ b/frontend/src/api.test.js
@@ -0,0 +1,54 @@
+/**
+ * APIクライアントのテスト (api.test.js)
+ *
+ * 仕様: モックを使わず、ローカルに立てた実HTTPサーバーに対して成功・エラー・GET・本文なしを確認する。
+ **/
+
+import { createServer } from 'node:http';
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import { createApi } from './api';
+
+let server;
+let api;
+let lastRequest;
+
+beforeAll(async () => {
+  server = createServer((request, response) => {
+    const chunks = [];
+    request.on('data', chunk => chunks.push(chunk));
+    request.on('end', () => {
+      lastRequest = { method: request.method, url: request.url, contentType: request.headers['content-type'], body: Buffer.concat(chunks).toString() };
+      const send = (status, payload) => { response.writeHead(status, { 'Content-Type': 'application/json' }); response.end(payload === undefined ? '' : JSON.stringify(payload)); };
+      if (request.url === '/ok') return send(200, { value: 1 });
+      if (request.url === '/detail') return send(400, { detail: 'フォルダが存在しません' });
+      if (request.url === '/message') return send(500, { message: 'サーバー内部のメッセージ' });
+      if (request.url === '/empty-error') return send(502);
+      return send(404, {});
+    });
+  });
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+  api = createApi(`http://127.0.0.1:${server.address().port}`);
+});
+
+afterAll(() => new Promise(resolve => server.close(resolve)));
+
+describe('api', () => {
+  it('JSONをPOSTし、レスポンスのJSONを返す', async () => {
+    expect(await api('/ok', { a: 'あ' })).toEqual({ value: 1 });
+    expect(lastRequest).toMatchObject({ method: 'POST', contentType: 'application/json', body: '{"a":"あ"}' });
+  });
+
+  it('GETでは本文を送らない', async () => {
+    await api('/ok', undefined, 'GET');
+    expect(lastRequest).toMatchObject({ method: 'GET', body: '' });
+  });
+
+  it('HTTPエラーはdetail、messageの順でエラーメッセージにする', async () => {
+    await expect(api('/detail', {})).rejects.toThrow('フォルダが存在しません');
+    await expect(api('/message', {})).rejects.toThrow('サーバー内部のメッセージ');
+  });
+
+  it('本文がJSONでないエラーはHTTPステータスをメッセージにする', async () => {
+    await expect(api('/empty-error', {})).rejects.toThrow('HTTP 502');
+  });
+});
diff --git a/frontend/src/components/CodeContextPanel.jsx b/frontend/src/components/CodeContextPanel.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..5793620343e101ea2d82b313573f2a0c1e21c5ff
--- /dev/null
+++ b/frontend/src/components/CodeContextPanel.jsx
@@ -0,0 +1,18 @@
+/**
+ * コードモードのコンテキスト作成パネル (CodeContextPanel.jsx)
+ *
+ * 仕様:
+ * 1. 「コンテキストを作成」で選択ファイル(＋参照ライブラリ)を1つのテキストにし、コピー・保存できる。
+ * 2. 「呼び出されているモジュールを含む」で外部ライブラリを含めるか切り替える（既定ON）。
+ * 3. 未作成のときはプレースホルダーを表示する。
+ **/
+
+import { Clipboard, Copy, Download, File, LoaderCircle } from 'lucide-react';
+
+export function CodeContextPanel({ context, path, loading, selectedCount, includeExternalModules, setIncludeExternalModules, onGenerate, onCopy, onDownload }) {
+  return <>
+    <p className="section-help">メインの選択ファイルと、実際に参照している外部ソースを1つのテキストにまとめます。</p>
+    <div className="context-output">{context ? <textarea readOnly value={context}/> : <div className="context-placeholder"><File/><strong>repository_context.txt</strong><span>チャットへ添付できる形式で生成します</span></div>}</div>
+    <div className="context-actions">{context ? <><button onClick={onCopy}><Copy/>コピー</button><button onClick={onDownload}><Download/>保存</button></> : <span/>}<label className="include-module-toggle" title="リポジトリ外の呼び出されているモジュール（PYTHONPATH等）をコンテキストに含めます"><input type="checkbox" checked={includeExternalModules} onChange={event => setIncludeExternalModules(event.target.checked)}/><span>呼び出されているモジュールを含む</span></label><button className="primary large" onClick={onGenerate} disabled={!path || loading || selectedCount === 0}>{loading ? <LoaderCircle className="spin"/> : <Clipboard/>}コンテキストを作成</button></div>
+  </>;
+}
diff --git a/frontend/src/components/FileSelectPanel.jsx b/frontend/src/components/FileSelectPanel.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..85d5771b9b2ea5f0aec18d05399ff3b15c3326e3
--- /dev/null
+++ b/frontend/src/components/FileSelectPanel.jsx
@@ -0,0 +1,56 @@
+/**
+ * ファイル選択パネル (FileSelectPanel.jsx)
+ *
+ * 仕様:
+ * 1. ファイルツリー（検索・全選択/解除・キーボード操作・右クリックメニュー）と選択数を表示する。
+ * 2. 「ライブラリを自動チェック」(MkDocsモードでは「リンク先MDを自動チェック」)で呼び出し先を自動選択する。
+ * 3. コードモードで外部ライブラリが検出されたときは、ツリー下部に参照ライブラリ(読み取り専用)と未解決・警告を表示する。
+ **/
+
+import { AlertTriangle, Folder, FolderOpen, GitBranch, LoaderCircle, Search, Sparkles } from 'lucide-react';
+import { TreeNode } from './TreeNode';
+
+function ReferenceTreeSection({ referenceData, referenceSelected, setReferenceSelected, referenceFileCount, filter, onPreview, onOpenReferenceEditor }) {
+  const { repositories = [], unresolved = [], warnings = [] } = referenceData;
+  return <div className="reference-tree-section">
+    <div className="reference-tree-title"><span><GitBranch/>参照ライブラリ</span><em>{referenceSelected.size} / {referenceFileCount}</em></div>
+    {repositories.map(repo => <section className="reference-repository" key={repo.path}>
+      <header><span><Folder/>{repo.name}</span><small title={repo.path}>{repo.reason === 'manual' ? '手動' : repo.reason === 'project-reference' ? 'ProjectReference' : '環境から検出'}</small></header>
+      {(repo.tree || []).map(node => <TreeNode key={`${repo.path}:${node.path}`} node={node} selected={referenceSelected} setSelected={setReferenceSelected} filter={filter} onPreview={file => onPreview(file, repo.path)} selectionPrefix={`${repo.path}::`}/>) }
+    </section>)}
+    {unresolved.length > 0 && <button className="unresolved-reference" onClick={() => onOpenReferenceEditor()}><AlertTriangle/>{unresolved.length}件の参照先を確認</button>}
+    {warnings.map(warning => <div className="reference-warning" key={warning}><AlertTriangle/>{warning}</div>)}
+  </div>;
+}
+
+export function FileSelectPanel({
+  tree, allFiles, selected, setSelected, filter, setFilter, treeRef, onTreeKeyDown, onPreview, onContextMenu,
+  path, loading, activeMode, autoCheckLoading, onAutoCheck,
+  referenceData, referenceSelected, setReferenceSelected, referenceFileCount, onOpenReferenceEditor
+}) {
+  const hasReferences = activeMode !== 'mkdocs' && referenceData.enabled
+    && ((referenceData.repositories || []).length > 0 || (referenceData.unresolved || []).length > 0 || (referenceData.warnings || []).length > 0);
+  return <section className="card repository-card">
+    <div className="section-heading">
+      <div><span className="eyebrow">SELECT</span><h2><Folder/>ファイルを選択</h2></div>
+      <div className="section-heading-actions">
+        <button
+          className="auto-check-button"
+          onClick={onAutoCheck}
+          disabled={!path || loading || autoCheckLoading || selected.size === 0}
+          title={activeMode === 'mkdocs' ? '選択中のMarkdownやmkdocs.ymlからリンクされている同一リポジトリ内のMarkdownに自動でチェックを入れます' : '現在選択されているファイルから呼び出されている同一リポジトリ内のモジュールに自動でチェックを入れます'}
+        >
+          {autoCheckLoading ? <LoaderCircle className="spin"/> : <Sparkles/>}
+          {activeMode === 'mkdocs' ? 'リンク先MDを自動チェック' : 'ライブラリを自動チェック'}
+        </button>
+        <span className="count-badge">{selected.size} / {allFiles.length}</span>
+      </div>
+    </div>
+    <div className="tree-tools"><div><Search/><input value={filter} onChange={event => setFilter(event.target.value)} placeholder="ファイルを検索"/></div><button onClick={() => setSelected(selected.size === allFiles.length ? new Set() : new Set(allFiles))}>{selected.size === allFiles.length ? '選択解除' : 'すべて選択'}</button></div>
+    <div className="tree-scroll" ref={treeRef} tabIndex={0} role="tree" aria-label="ファイル選択ツリー" onKeyDown={onTreeKeyDown}>
+      {tree.length ? tree.map(node => <TreeNode key={`${node.path}:${node.ignored}`} node={node} selected={selected} setSelected={setSelected} filter={filter} onPreview={onPreview} onContextMenu={onContextMenu}/>) : <div className="empty-state"><FolderOpen/><p>リポジトリを読み込むと<br/>ファイルが表示されます</p></div>}
+      {hasReferences && <ReferenceTreeSection referenceData={referenceData} referenceSelected={referenceSelected} setReferenceSelected={setReferenceSelected} referenceFileCount={referenceFileCount} filter={filter} onPreview={onPreview} onOpenReferenceEditor={onOpenReferenceEditor}/>}
+    </div>
+    <p className="tree-hint">クリックでプレビュー · 右クリックで無視設定／未解決リポジトリを追加</p>
+  </section>;
+}
diff --git a/frontend/src/components/HelpModal.jsx b/frontend/src/components/HelpModal.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..4981bc77bb4590e35e8410f93e3abcc4d5b9682f
--- /dev/null
+++ b/frontend/src/components/HelpModal.jsx
@@ -0,0 +1,17 @@
+/**
+ * ショートカットと設定の説明モーダル (HelpModal.jsx)
+ **/
+
+import { X } from 'lucide-react';
+
+export function HelpModal({ open, close }) {
+  if (!open) return null;
+  return <div className="modal-layer" onMouseDown={close}><div className="modal help-modal" onMouseDown={event => event.stopPropagation()}>
+    <header><div><span className="eyebrow">SHORTCUTS & SETTINGS</span><h3>ショートカットと設定</h3></div><button className="icon-button" onClick={close}><X/></button></header>
+    <div className="help-grid">
+      <section><h4>ショートカット</h4><dl><div><dt><kbd>I</kbd></dt><dd>無視リスト編集モーダルを開く</dd></div><div><dt><kbd>H</kbd></dt><dd>この説明を開く／閉じる</dd></div><div><dt><kbd>Ctrl</kbd> + <kbd>S</kbd></dt><dd>編集中の無視リストを保存して閉じる</dd></div><div><dt><kbd>Esc</kbd></dt><dd>保存せずにモーダルを閉じる</dd></div><div><dt><kbd>Ctrl</kbd> + <kbd>Z</kbd></dt><dd>無視リスト編集中の変更を戻す</dd></div><div><dt><kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>Z</kbd></dt><dd>戻した変更を進める</dd></div></dl></section>
+      <section><h4>ハンバーガーメニュー</h4><dl><div><dt>ignored項目を表示</dt><dd>無視対象の入口を取り消し線で表示します。</dd></div><div><dt>無視リストを編集</dt><dd>1行1パターンで編集し、リポジトリの設定ファイルへ保存します。</dd></div><div><dt>Python実行モード</dt><dd>通常版はvenvと環境変数から参照ソースも自動検出します。Embedded版では参照リポジトリ機能を無効にします。</dd></div><div><dt>Git差分コマンド</dt><dd>クリップボードへ格納する差分を取得するコマンドを指定します（デフォルト: git diff HEAD -- *.py）。</dd></div><div><dt>対象リポジトリを追加</dt><dd>ファイルの右クリックから、未解決モジュールと外部ソースリポジトリを手動で対応付けます。</dd></div></dl></section>
+    </div>
+    <p className="help-note">入力欄やターミナルにカーソルがある間は、I/Hを通常の入力として扱います。</p>
+  </div></div>;
+}
diff --git a/frontend/src/components/IgnorePatternsModal.jsx b/frontend/src/components/IgnorePatternsModal.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..dcda730b38c09d85628276ea7190bac7fb57e776
--- /dev/null
+++ b/frontend/src/components/IgnorePatternsModal.jsx
@@ -0,0 +1,63 @@
+/**
+ * 無視リスト編集モーダル (IgnorePatternsModal.jsx)
+ *
+ * 仕様:
+ * 1. 開いたときに現在の無視リストを読み込み、1行1パターンのテキストとして編集する。
+ * 2. Ctrl/Cmd+S で保存して閉じる、Esc で破棄して閉じる、Ctrl/Cmd+Z・Shift+Z・Y でUndo/Redoする。
+ * 3. 保存時は区切りを / に統一し、空行と重複を除いたパターンを送る。
+ **/
+
+import { useEffect, useRef, useState } from 'react';
+import { AlertTriangle, Save, X } from 'lucide-react';
+import { api } from '../api';
+import { TextHistory } from '../lib/ignoreHistory';
+import { parseIgnoreText } from '../lib/selection';
+
+export function IgnorePatternsModal({ open, close, path, initialPattern, onSaved, notify }) {
+  const [text, setText] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [configFile, setConfigFile] = useState('');
+  const historyRef = useRef(new TextHistory());
+  useEffect(() => {
+    if (!open || !path) return undefined;
+    let active = true;
+    setBusy(true); setError('');
+    api('/api/ignore_patterns', { library_path: path }).then(data => {
+      if (!active) return;
+      const patterns = Array.isArray(data.patterns) ? data.patterns : [];
+      if (initialPattern && !patterns.includes(initialPattern)) patterns.push(initialPattern);
+      const nextText = patterns.join('\n');
+      setText(nextText); setConfigFile(data.config_file || '');
+      historyRef.current = new TextHistory(nextText);
+    }).catch(err => { if (active) setError(err.message); }).finally(() => { if (active) setBusy(false); });
+    return () => { active = false; };
+  }, [open, path, initialPattern]);
+  if (!open) return null;
+  const updateText = nextText => { historyRef.current.push(nextText); setText(nextText); };
+  const undo = () => setText(historyRef.current.undo());
+  const redo = () => setText(historyRef.current.redo());
+  const handleKeyDown = event => {
+    const key = event.key.toLowerCase();
+    const modifier = event.ctrlKey || event.metaKey;
+    if (modifier && key === 's') { event.preventDefault(); event.stopPropagation(); save(); return; }
+    if (modifier && key === 'z') { event.preventDefault(); event.stopPropagation(); event.shiftKey ? redo() : undo(); return; }
+    if (modifier && key === 'y') { event.preventDefault(); event.stopPropagation(); redo(); return; }
+    if (event.key === 'Escape') { event.preventDefault(); event.stopPropagation(); close(); }
+  };
+  const save = async () => {
+    const patterns = parseIgnoreText(text);
+    setBusy(true); setError('');
+    try {
+      const data = await api('/api/save_ignore_patterns', { library_path: path, patterns });
+      onSaved(data.patterns || patterns); notify(`無視リストを${data.config_file || configFile || '設定ファイル'}に保存しました。`); close();
+    } catch (err) { setError(err.message); } finally { setBusy(false); }
+  };
+  return <div className="modal-layer" onMouseDown={close}><div className="modal ignore-modal" onMouseDown={event => event.stopPropagation()} onKeyDown={handleKeyDown}>
+    <header><div><span className="eyebrow">IGNORE LIST</span><h3>無視リストを編集</h3></div><button className="icon-button" onClick={close}><X/></button></header>
+    <p className="ignore-help">1行に1つずつ、ファイル名・フォルダ名・globパターンを入力します。保存後にツリーへ反映されます。</p>
+    <textarea className="ignore-editor" value={text} onChange={event => updateText(event.target.value)} placeholder={'例:\n.venv\n__pycache__\n*.generated.cs'} autoFocus/>
+    {error && <div className="error-box"><AlertTriangle/>{error}</div>}
+    <div className="ignore-actions"><span>{busy ? '読み込み中…' : `${text.split(/\r?\n/).filter(item => item.trim()).length}件`}</span><button onClick={close}>キャンセル</button><button className="primary" onClick={save} disabled={busy || !path}><Save/>保存</button></div>
+  </div></div>;
+}
diff --git a/frontend/src/components/MkdocsContextPanel.jsx b/frontend/src/components/MkdocsContextPanel.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..54713581aeca8114bb6e4f8db6c58978e4e9bfae
--- /dev/null
+++ b/frontend/src/components/MkdocsContextPanel.jsx
@@ -0,0 +1,76 @@
+/**
+ * MkDocsモードのコンテキスト作成パネル (MkdocsContextPanel.jsx)
+ *
+ * 仕様:
+ * 1. 保存先フォルダの指定・Finder/Explorerで開く操作を提供する。
+ * 2. 「プレビュー生成」で統合マークダウンと結合画像を表示し、タブで切り替える。
+ * 3. 「2ファイルを保存」でMD＋結合画像を保存先へ書き出す。MD/画像を個別にコピー・保存できる。
+ **/
+
+import { BookOpen, Clipboard, Copy, Download, File, FolderOpen, Image as ImageIcon, LoaderCircle, Save } from 'lucide-react';
+
+export function MkdocsContextPanel({ context, path, loading, selectedCount, mkdocs, onGenerate, onCopy, onDownload }) {
+  const { exportFolder, setExportFolder, imageDataUrl, stats, viewTab, setViewTab, saving } = mkdocs;
+  const busy = !path || loading || saving || selectedCount === 0;
+  return <>
+    <p className="section-help">呼び出されている全画像をリンク記法付きの1枚の画像に縦結合し、統合マークダウンと2ファイルに分けて出力します（5ファイル添付制限対応）。</p>
+    <div className="mkdocs-export-bar">
+      <label className="mkdocs-folder-label">
+        <span>保存先:</span>
+        <input value={exportFolder} onChange={event => setExportFolder(event.target.value)} placeholder="~/Desktop/AI_Inputs"/>
+      </label>
+      <button onClick={mkdocs.onOpenFolder} title="保存先フォルダをFinder / Explorerで開く"><FolderOpen size={15}/>フォルダを開く</button>
+    </div>
+    {context && (
+      <div className="mkdocs-view-tabs">
+        <button className={viewTab === 'markdown' ? 'active' : ''} onClick={() => setViewTab('markdown')}>
+          <File size={14}/>統合マークダウン ({stats?.total_documents || 0}件)
+        </button>
+        <button className={viewTab === 'image' ? 'active' : ''} onClick={() => setViewTab('image')}>
+          <ImageIcon size={14}/>結合画像プレビュー ({stats?.total_images || 0}枚連結)
+        </button>
+      </div>
+    )}
+    <div className="context-output">
+      {context ? (
+        viewTab === 'image' ? (
+          imageDataUrl ? (
+            <div className="mkdocs-image-preview-wrap">
+              <div className="mkdocs-image-meta-list">
+                {(stats?.images_meta || []).map(item => (
+                  <span key={item.index} className="mkdocs-image-chip">
+                    【図{item.index}】 {item.doc_path} → <code>{item.link_text}</code>
+                  </span>
+                ))}
+              </div>
+              <img src={imageDataUrl} alt="結合画像プレビュー" className="mkdocs-combined-image" />
+            </div>
+          ) : (
+            <div className="context-placeholder"><ImageIcon/><strong>呼び出されている画像はありません</strong><span>選択中のMarkdownに画像リンクが含まれていないため、マークダウンのみ出力されます</span></div>
+          )
+        ) : (
+          <textarea readOnly value={context}/>
+        )
+      ) : (
+        <div className="context-placeholder"><BookOpen/><strong>*_context.md ＋ *_images.png</strong><span>MkDocsのMarkdownと呼び出し画像を2ファイルに分けて生成します</span></div>
+      )}
+    </div>
+    <div className="context-actions mkdocs-actions">
+      {context ? (
+        <div className="mkdocs-sub-actions">
+          <button onClick={onCopy}><Copy/>MDをコピー</button>
+          <button onClick={onDownload}><Download/>MD保存</button>
+          {imageDataUrl && <button onClick={mkdocs.downloadImage}><ImageIcon/>結合画像保存</button>}
+        </div>
+      ) : <span/>}
+      <div className="mkdocs-main-actions">
+        <button onClick={onGenerate} disabled={busy}>
+          {loading ? <LoaderCircle className="spin"/> : <Clipboard/>}プレビュー生成
+        </button>
+        <button className="primary large" onClick={mkdocs.onSave} disabled={busy}>
+          {saving ? <LoaderCircle className="spin"/> : <Save/>}2ファイルを保存 (MD＋画像)
+        </button>
+      </div>
+    </div>
+  </>;
+}
diff --git a/frontend/src/components/PatchPanel.jsx b/frontend/src/components/PatchPanel.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..13fd346b5df674fe6d7e189780993f3b4bfd9f9a
--- /dev/null
+++ b/frontend/src/components/PatchPanel.jsx
@@ -0,0 +1,63 @@
+/**
+ * AI出力の反映・テスト実行パネル (PatchPanel.jsx)
+ *
+ * 仕様:
+ * 1. AIの回答を貼り付けて差分プレビューを作り、反映先が未確定の変更は候補から選ぶ。
+ * 2. 差分が妥当ならまとめて反映する。反映後にテストコマンドを実行し、失敗時はLLMへ戻す文面をコピーできる。
+ * 3. API・クリップボードのエラーは画面内のエラー欄に表示する。
+ **/
+
+import { useState } from 'react';
+import { AlertTriangle, CirclePlay, Code2, Copy, LoaderCircle, Save, Search, TestTube2 } from 'lucide-react';
+import { api } from '../api';
+
+export function PatchPanel({ path, pythonMode, embeddedDir, notify, activeMode }) {
+  const [output, setOutput] = useState('');
+  const [targetPath, setTargetPath] = useState('');
+  const [preview, setPreview] = useState(null);
+  const [overrides, setOverrides] = useState({});
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [testCommand, setTestCommand] = useState('python -m pytest');
+  const [testResult, setTestResult] = useState(null);
+  const requestPreview = async (nextOverrides = overrides) => {
+    if (!path || !output.trim()) return setError('リポジトリとAI出力を指定してください。');
+    setBusy(true); setError('');
+    try { setPreview(await api('/api/patch/preview', { library_path: path, ai_output: output, target_path: targetPath, overrides: nextOverrides })); }
+    catch (err) { setError(err.message); } finally { setBusy(false); }
+  };
+  const choose = (key, value) => { const next = { ...overrides, [key]: value }; setOverrides(next); requestPreview(next); };
+  const apply = async () => {
+    setBusy(true); setError('');
+    try { const data = await api('/api/patch/apply', { library_path: path, ai_output: output, target_path: targetPath, overrides }); if (data.status !== 'success') throw new Error(data.message); notify(data.message); setPreview(null); }
+    catch (err) { setError(err.message); } finally { setBusy(false); }
+  };
+  const test = async () => {
+    setBusy(true); setError('');
+    try { setTestResult(await api('/api/test', { library_path: path, test_command: testCommand, python_mode: pythonMode, embedded_python_dir: embeddedDir })); }
+    catch (err) { setError(err.message); } finally { setBusy(false); }
+  };
+  const feedback = async () => {
+    const merged = `${testResult?.stdout || ''}\n${testResult?.stderr || ''}`.trim();
+    try {
+      const data = await api('/api/feedback_context', { library_path: path, test_command: testCommand, output: merged, exit_code: testResult?.exit_code });
+      await navigator.clipboard.writeText(data.context); notify('修正依頼用のテスト結果をコピーしました。');
+    } catch (err) { setError(err.message); }
+  };
+  return <section className="card patch-card">
+    <div className="section-heading"><div><span className="eyebrow">APPLY</span><h2><Code2/>AIの変更を反映</h2></div><span className="format-pill">{activeMode === 'mkdocs' ? 'Markdown・YAML反映対応' : '3形式を自動判定'}</span></div>
+    <p className="section-help">{activeMode === 'mkdocs' ? 'AIが出力した <file_changes>、ファイルパス付きMarkdownブロック (```markdown path: docs/...)、またはファイル見出し形式を貼り付けてください。' : '関数全体、ファイルパス付きコードブロック、または <file_changes> を貼り付けてください。'}</p>
+    <div className="patch-inputs"><textarea value={output} onChange={event => { setOutput(event.target.value); setPreview(null); }} placeholder="AIの回答をここに貼り付けます"/><div className="target-line"><input value={targetPath} onChange={event => setTargetPath(event.target.value)} placeholder="反映先ファイル（通常は空欄でOK）"/><button className="primary" onClick={() => requestPreview()} disabled={busy}>{busy ? <LoaderCircle className="spin"/> : <Search/>}差分を確認</button></div></div>
+    {error && <div className="error-box"><AlertTriangle/>{error}</div>}
+    {preview && <div className="preview-area">
+      <div className="preview-title"><strong>{preview.message}</strong>{preview.status === 'success' && <button className="success-button" onClick={apply} disabled={busy}><Save/>この差分を反映</button>}</div>
+      {preview.changes.map(change => <div className="change" key={change.key}>
+        <div className="change-meta"><span>{change.path || change.symbol || '反映先未確定'}</span><em>{change.action}</em></div>
+        {!change.path && <select value="" onChange={event => choose(change.key, event.target.value)}><option value="">反映先を選択…</option>{change.candidates.map(candidate => <option key={candidate}>{candidate}</option>)}</select>}
+        {change.diff && <pre className="diff">{change.diff}</pre>}
+      </div>)}
+    </div>}
+    <div className="test-row"><TestTube2/><input value={testCommand} onChange={event => setTestCommand(event.target.value)}/><button onClick={test} disabled={!path || busy}><CirclePlay/>テスト</button>{testResult && <span className={testResult.exit_code === 0 ? 'test-ok' : 'test-ng'}>{testResult.exit_code === 0 ? '成功' : `失敗 (${testResult.exit_code ?? 'timeout'})`}</span>}</div>
+    {testResult && <div className="test-output"><pre>{`${testResult.stdout || ''}\n${testResult.stderr || ''}`}</pre>{testResult.exit_code !== 0 && <button onClick={feedback}><Copy/>LLMへ戻す文面をコピー</button>}</div>}
+  </section>;
+}
diff --git a/frontend/src/components/PathBar.jsx b/frontend/src/components/PathBar.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..368315044b69ea48bbeab35ac21eb162adef8d2a
--- /dev/null
+++ b/frontend/src/components/PathBar.jsx
@@ -0,0 +1,46 @@
+/**
+ * リポジトリ選択バー (PathBar.jsx)
+ *
+ * 仕様:
+ * 1. RepositorySelector（履歴選択・検索・削除）、コード/MkDocsモード切替、Git差分コピー、VS Code起動を並べる。
+ * 2. Git差分コピーのツールチップには実際に実行されるコマンド（空欄時は既定）を表示する。
+ **/
+
+import { BookOpen, Code2, GitBranch, GitCompare, LoaderCircle, MonitorCog } from 'lucide-react';
+import { resolveGitDiffCommand } from '../gitDiff';
+import { RepositorySelector } from './RepositorySelector';
+
+export function PathBar({
+  path, setPath, repositories, setRepositories, onLoad, loading, showIgnored, notify,
+  activeMode, isMkdocsRepo, mkdocsConfig, onToggleMode,
+  gitDiffCommand, loadingDiff, onCopyGitDiff, onOpenCode
+}) {
+  return <section className="path-bar card">
+    <div className="path-label"><GitBranch/><span>REPOSITORY</span></div>
+    <RepositorySelector
+      path={path}
+      setPath={setPath}
+      repositories={repositories}
+      setRepositories={setRepositories}
+      onLoad={onLoad}
+      loading={loading}
+      showIgnored={showIgnored}
+      notify={notify}
+    />
+    {path && <button
+      className={`mode-switch-button ${activeMode === 'mkdocs' ? 'mkdocs-active' : 'code-active'}`}
+      onClick={onToggleMode}
+      title={isMkdocsRepo ? `YAML検出: ${mkdocsConfig.config_file || 'mkdocs.yml'} (${mkdocsConfig.site_name || ''}) — クリックでモード切替` : 'クリックで通常コードモード / MkDocsモードを切り替え'}
+    >
+      {activeMode === 'mkdocs' ? <><BookOpen size={16}/>MkDocsモード</> : <><Code2 size={16}/>コードモード</>}
+    </button>}
+    <button
+      onClick={onCopyGitDiff}
+      disabled={!path || loadingDiff}
+      title={`Git差分をクリップボードにコピー (${resolveGitDiffCommand(gitDiffCommand)})`}
+    >
+      {loadingDiff ? <LoaderCircle className="spin"/> : <GitCompare/>}Git差分コピー
+    </button>
+    <button onClick={onOpenCode} disabled={!path}><MonitorCog/>VS Code</button>
+  </section>;
+}
diff --git a/frontend/src/components/PreviewModal.jsx b/frontend/src/components/PreviewModal.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..d0c0f53b7211b1a7ad0471bb1020b516a7882b75
--- /dev/null
+++ b/frontend/src/components/PreviewModal.jsx
@@ -0,0 +1,20 @@
+/**
+ * ファイルプレビューモーダル (PreviewModal.jsx)
+ *
+ * 仕様:
+ * 1. Markdownは整形表示、それ以外はコード表示で、検索バー付きで表示する。
+ * 2. Esc で閉じる。
+ **/
+
+import { X } from 'lucide-react';
+import { PreviewSearch } from '../PreviewSearch';
+import { CodePreview, MarkdownPreview } from '../previewRenderer';
+
+export function PreviewModal({ file, content, close }) {
+  if (!file) return null;
+  const isMarkdown = /\.md$/i.test(file);
+  return <div className="modal-layer" onMouseDown={close}><div className={`modal preview-modal ${isMarkdown ? 'markdown-modal' : 'code-modal'}`} tabIndex="-1" onMouseDown={event => event.stopPropagation()} onKeyDown={event => { if (event.key === 'Escape') { event.preventDefault(); close(); } }}>
+    <header><div><span className="eyebrow">FILE PREVIEW · {isMarkdown ? 'MARKDOWN' : 'CODE'}</span><h3>{file}</h3></div><button className="icon-button" onClick={close}><X/></button></header>
+    <PreviewSearch>{isMarkdown ? <MarkdownPreview content={content}/> : <CodePreview content={content} path={file}/>}</PreviewSearch>
+  </div></div>;
+}
diff --git a/frontend/src/components/ReferenceRepositoryModal.jsx b/frontend/src/components/ReferenceRepositoryModal.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..26713e81a2c187b687f3a25672e5c620035c9faa
--- /dev/null
+++ b/frontend/src/components/ReferenceRepositoryModal.jsx
@@ -0,0 +1,57 @@
+/**
+ * 未解決モジュールと参照リポジトリの手動対応付けモーダル (ReferenceRepositoryModal.jsx)
+ *
+ * 仕様:
+ * 1. 自動解決できなかったモジュールを選び、参照元リポジトリのパスと対応付けて保存する（メインリポジトリごと）。
+ * 2. 保存済みの手動設定を一覧し、個別に解除できる。
+ * 3. Enter で追加、Esc で閉じる。
+ **/
+
+import { useEffect, useState } from 'react';
+import { AlertTriangle, Check, ListPlus, X } from 'lucide-react';
+import { api } from '../api';
+
+export function ReferenceRepositoryModal({ open, close, path, repositories, unresolved, initialFile, manualReferences, onSaved, notify }) {
+  const matching = unresolved.filter(item => !initialFile || (item.source_files || []).includes(initialFile));
+  const choices = matching.length ? matching : unresolved;
+  const [module, setModule] = useState('');
+  const [repositoryPath, setRepositoryPath] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  useEffect(() => {
+    if (!open) return;
+    setModule(choices[0]?.module || ''); setRepositoryPath(''); setError('');
+  }, [open, initialFile, unresolved]);
+  if (!open) return null;
+  const save = async () => {
+    if (!module || !repositoryPath.trim()) return;
+    setBusy(true); setError('');
+    try {
+      await api('/api/save_reference_mapping', { library_path: path, module, repository_path: repositoryPath.trim() });
+      notify(`「${module}」の参照リポジトリを保存しました。`); await onSaved(); close();
+    } catch (err) { setError(err.message); } finally { setBusy(false); }
+  };
+  const remove = async (mappedModule, mappedPath) => {
+    setBusy(true); setError('');
+    try {
+      await api('/api/remove_reference_mapping', { library_path: path, module: mappedModule, repository_path: mappedPath });
+      notify(`「${mappedModule}」の手動設定を解除しました。`); await onSaved();
+    } catch (err) { setError(err.message); } finally { setBusy(false); }
+  };
+  const handleKeyDown = event => {
+    if (event.key === 'Escape') { event.preventDefault(); event.stopPropagation(); close(); }
+    if (event.key === 'Enter' && !event.shiftKey) { event.preventDefault(); save(); }
+  };
+  return <div className="modal-layer" onMouseDown={close}><div className="modal reference-modal" onMouseDown={event => event.stopPropagation()} onKeyDown={handleKeyDown}>
+    <header><div><span className="eyebrow">REFERENCE REPOSITORY</span><h3>対象リポジトリを追加</h3></div><button className="icon-button" onClick={close}><X/></button></header>
+    <p className="ignore-help">自動解決できなかったモジュールと、そのソースリポジトリを対応付けます。設定はメインリポジトリごとに保存されます。</p>
+    {choices.length ? <div className="reference-form">
+      <label>未解決モジュール<select value={module} onChange={event => setModule(event.target.value)}>{choices.map(item => <option key={`${item.language}:${item.module}`} value={item.module}>{item.module} ({item.language === 'python' ? 'Python' : 'C#'})</option>)}</select></label>
+      <label>参照リポジトリのパス<input list="reference-repository-list" value={repositoryPath} onChange={event => setRepositoryPath(event.target.value)} placeholder="例: C:\\work\\shared_library または /work/shared_library" autoFocus/></label>
+      <datalist id="reference-repository-list">{repositories.filter(repo => repo !== path).map(repo => <option key={repo} value={repo}/>)}</datalist>
+    </div> : <div className="reference-resolved"><Check/>未解決の参照はありません。</div>}
+    {Object.keys(manualReferences || {}).length > 0 && <div className="manual-reference-list"><strong>手動設定</strong>{Object.entries(manualReferences).map(([mappedModule, mappedPath]) => <div key={mappedModule}><span><code>{mappedModule}</code><small>{mappedPath}</small></span><button className="icon-button tiny" title="手動設定を解除" onClick={() => remove(mappedModule, mappedPath)}><X/></button></div>)}</div>}
+    {error && <div className="error-box"><AlertTriangle/>{error}</div>}
+    <div className="ignore-actions"><span>{choices.length ? `${choices.length}件が未解決` : '自動解決済み'}</span><button onClick={close}>キャンセル</button><button className="primary" onClick={save} disabled={busy || !module || !repositoryPath.trim()}><ListPlus/>追加</button></div>
+  </div></div>;
+}
diff --git a/frontend/src/components/SettingsDrawer.jsx b/frontend/src/components/SettingsDrawer.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..8f7edcc8e5fbb7707e655737cbed1a1e4d30cbb1
--- /dev/null
+++ b/frontend/src/components/SettingsDrawer.jsx
@@ -0,0 +1,32 @@
+/**
+ * 設定ドロワー (SettingsDrawer.jsx)
+ *
+ * 仕様:
+ * 1. ignored項目の表示、無視リスト編集、Python実行モード(通常/Embedded)、Git差分コマンドを設定する。
+ * 2. Embedded選択時のみ python.exe のフォルダ入力欄を表示する。
+ **/
+
+import { ListPlus, Settings, X } from 'lucide-react';
+import { DEFAULT_GIT_DIFF_COMMAND } from '../gitDiff';
+
+export function SettingsDrawer({ open, close, path, openIgnoreEditor, showIgnored, setShowIgnored, pythonMode, setPythonMode, embeddedDir, setEmbeddedDir, gitDiffCommand, setGitDiffCommand, reload }) {
+  if (!open) return null;
+  return <div className="drawer-layer" onMouseDown={close}>
+    <aside className="drawer" onMouseDown={event => event.stopPropagation()}>
+      <div className="drawer-title"><div><span className="eyebrow">SYSTEM</span><h2><Settings/>設定</h2></div><button className="icon-button" onClick={close}><X/></button></div>
+      <div className="setting-group">
+        <label className="switch-line"><div><strong>ignored項目を表示</strong><small>内部は走査せず、入口だけ取り消し線で表示します</small></div><input type="checkbox" checked={showIgnored} onChange={event => { setShowIgnored(event.target.checked); reload(event.target.checked); }}/></label>
+      </div>
+      <div className="setting-group"><button className="drawer-action" onClick={openIgnoreEditor} disabled={!path}><ListPlus/>無視リストを編集</button><small className="drawer-subnote">現在のリポジトリの設定ファイルを編集します。</small></div>
+      <div className="setting-group"><label>Python実行モード</label>
+        <select value={pythonMode} onChange={event => setPythonMode(event.target.value)}><option value="normal">通常版（venv自動検出）</option><option value="embedded">Embedded Python</option></select>
+        {pythonMode === 'embedded' && <input value={embeddedDir} onChange={event => setEmbeddedDir(event.target.value)} placeholder="python.exeがあるフォルダ"/>}
+      </div>
+      <div className="setting-group"><label>Git差分コマンド</label>
+        <input value={gitDiffCommand} onChange={event => setGitDiffCommand(event.target.value)} placeholder={DEFAULT_GIT_DIFF_COMMAND}/>
+        <small className="drawer-subnote">差分コピー時に実行するgitコマンド（空欄時はデフォルト: {DEFAULT_GIT_DIFF_COMMAND}）</small>
+      </div>
+      <p className="drawer-note">設定はこのブラウザに自動保存されます。</p>
+    </aside>
+  </div>;
+}
diff --git a/frontend/src/components/TerminalPanel.jsx b/frontend/src/components/TerminalPanel.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..298b71db8a05c50e7a48091647313f583529cea1
--- /dev/null
+++ b/frontend/src/components/TerminalPanel.jsx
@@ -0,0 +1,98 @@
+/**
+ * 対話型ターミナルパネル (TerminalPanel.jsx)
+ *
+ * 仕様:
+ * 1. 開いたときに xterm.js を読み込み、/api/terminal/ws へ WebSocket 接続する（cwd・実行モードを指定）。
+ * 2. ready 受信でシェル名を表示し、output を描画、入力とリサイズをサーバーへ送る。
+ * 3. 再起動ボタンで接続し直す。閉じる/アンマウント時は接続と端末を破棄する。
+ **/
+
+import { useEffect, useRef, useState } from 'react';
+import '@xterm/xterm/css/xterm.css';
+import { ChevronDown, RefreshCw, TerminalSquare } from 'lucide-react';
+
+export function TerminalPanel({ path, pythonMode, embeddedDir }) {
+  const [open, setOpen] = useState(false);
+  const [status, setStatus] = useState('offline');
+  const [shellName, setShellName] = useState('terminal');
+  const [dimensions, setDimensions] = useState('100×28');
+  const [restartKey, setRestartKey] = useState(0);
+  const terminalHostRef = useRef(null);
+  const terminalRef = useRef(null);
+  const fitRef = useRef(null);
+  const socketRef = useRef(null);
+  useEffect(() => {
+    if (!open || !terminalHostRef.current) return;
+    let disposed = false;
+    let resizeObserver;
+    let dataSubscription;
+    let terminal;
+    let socket;
+    const workingPath = path || '.';
+    Promise.all([import('@xterm/xterm'), import('@xterm/addon-fit')]).then(([{ Terminal }, { FitAddon }]) => {
+      if (disposed || !terminalHostRef.current) return;
+      terminal = new Terminal({
+        cursorBlink: true, cursorStyle: 'block', scrollback: 8000,
+        fontFamily: '"SFMono-Regular", Menlo, Monaco, Consolas, "Liberation Mono", monospace',
+        fontSize: 14, lineHeight: 1.25, convertEol: false,
+        theme: {
+          background: '#171c28', foreground: '#e5e7eb', cursor: '#a8adb8',
+          cursorAccent: '#171c28', selectionBackground: '#53617a88',
+          black: '#1f2430', red: '#ff657a', green: '#9dd274', yellow: '#eacb64',
+          blue: '#72a7ff', magenta: '#ba8cff', cyan: '#5ccfe6', white: '#d8dee9',
+          brightBlack: '#666b7a', brightRed: '#ff8b98', brightGreen: '#b8e986',
+          brightYellow: '#ffe083', brightBlue: '#8fbcff', brightMagenta: '#cfa8ff',
+          brightCyan: '#8be9fd', brightWhite: '#ffffff'
+        }
+      });
+      const fit = new FitAddon(); terminal.loadAddon(fit); terminal.open(terminalHostRef.current);
+      terminalRef.current = terminal; fitRef.current = fit; fit.fit();
+      setDimensions(`${terminal.cols}×${terminal.rows}`);
+      terminal.writeln('\x1b[90mConnecting to interactive shell…\x1b[0m');
+      const protocol = location.protocol === 'https:' ? 'wss:' : 'ws:';
+      const params = new URLSearchParams({ cwd: workingPath, mode: pythonMode, embedded_python_dir: embeddedDir });
+      socket = new WebSocket(`${protocol}//${location.host}/api/terminal/ws?${params}`);
+      socketRef.current = socket; setStatus('connecting');
+      let localEcho = false;
+      socket.onopen = () => socket.send(JSON.stringify({ type: 'resize', cols: terminal.cols, rows: terminal.rows }));
+      socket.onmessage = event => {
+        const message = JSON.parse(event.data);
+        if (message.type === 'ready') {
+          localEcho = Boolean(message.localEcho); setStatus('ready'); setShellName(message.shell || 'shell');
+          terminal.clear(); terminal.focus();
+        } else if (message.type === 'output') terminal.write(message.data);
+        else if (message.type === 'error') terminal.writeln(`\r\n\x1b[31m${message.data}\x1b[0m`);
+      };
+      socket.onclose = () => { setStatus('offline'); if (!disposed) terminal.writeln('\r\n\x1b[90m[terminal disconnected]\x1b[0m'); };
+      socket.onerror = () => { setStatus('error'); terminal.writeln('\r\n\x1b[31m[connection error]\x1b[0m'); };
+      dataSubscription = terminal.onData(data => {
+        if (socket.readyState !== WebSocket.OPEN) return;
+        if (localEcho) {
+          if (data === '\r') terminal.write('\r\n');
+          else if (data === '\x7f') terminal.write('\b \b');
+          else if (!data.startsWith('\x1b')) terminal.write(data);
+        }
+        socket.send(JSON.stringify({ type: 'input', data }));
+      });
+      resizeObserver = new ResizeObserver(() => {
+        if (disposed) return; fit.fit(); setDimensions(`${terminal.cols}×${terminal.rows}`);
+        if (socket.readyState === WebSocket.OPEN) socket.send(JSON.stringify({ type: 'resize', cols: terminal.cols, rows: terminal.rows }));
+      });
+      resizeObserver.observe(terminalHostRef.current);
+    });
+    return () => {
+      disposed = true; resizeObserver?.disconnect(); dataSubscription?.dispose();
+      if (socket?.readyState === WebSocket.OPEN || socket?.readyState === WebSocket.CONNECTING) socket.close();
+      terminal?.dispose(); terminalRef.current = null; fitRef.current = null;
+    };
+  }, [open, path, pythonMode, embeddedDir, restartKey]);
+  return <section className={`terminal-panel ${open ? 'open' : ''}`}>
+    <div className="terminal-heading">
+      <button className="terminal-title" onClick={() => setOpen(!open)}><TerminalSquare/><strong>{path ? path.split(/[\\/]/).filter(Boolean).at(-1) : 'terminal'} — {shellName} — {dimensions}</strong></button>
+      <span className={`status-dot ${status}`}/>
+      {open && <button className="terminal-restart" title="ターミナルを再起動" onClick={() => setRestartKey(key => key + 1)}><RefreshCw/></button>}
+      <button className="terminal-toggle" onClick={() => setOpen(!open)}><ChevronDown/></button>
+    </div>
+    {open && <div className="terminal-content" ref={terminalHostRef}/>} 
+  </section>;
+}
diff --git a/frontend/src/components/Toast.jsx b/frontend/src/components/Toast.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..773955ca7e41c14e9e32464b30aa6575de59dacb
--- /dev/null
+++ b/frontend/src/components/Toast.jsx
@@ -0,0 +1,17 @@
+/**
+ * 一定時間後に自動で消える通知 (Toast.jsx)
+ *
+ * 仕様:
+ * 1. message が変わるたびに3.2秒のタイマーを張り直し、時間経過後に onClose を呼ぶ。
+ * 2. 親の再描画で onClose の参照が変わってもタイマーはリセットしない（最新の onClose を ref で保持）。
+ **/
+
+import { useEffect, useRef } from 'react';
+import { Check } from 'lucide-react';
+
+export function Toast({ message, onClose }) {
+  const closeRef = useRef(onClose);
+  closeRef.current = onClose;
+  useEffect(() => { const id = setTimeout(() => closeRef.current(), 3200); return () => clearTimeout(id); }, [message]);
+  return <div className="toast"><Check size={16}/><span>{message}</span></div>;
+}
diff --git a/frontend/src/components/TopBar.jsx b/frontend/src/components/TopBar.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..469838aa31ce2100da5a80d553d76092dd08aa8d
--- /dev/null
+++ b/frontend/src/components/TopBar.jsx
@@ -0,0 +1,13 @@
+/**
+ * 画面上部のヘッダー (TopBar.jsx)
+ *
+ * 仕様:
+ * 1. ブランド表示、依存関係マップ(別タブ)、無視リスト編集、設定ドロワーを開くボタンを提供する。
+ * 2. リポジトリ未選択のときはマップと無視リスト編集を無効にする。
+ **/
+
+import { ExternalLink, ListPlus, Map, Menu } from 'lucide-react';
+
+export function TopBar({ path, onOpenMap, onOpenIgnoreEditor, onOpenSettings }) {
+  return <header className="topbar"><div className="brand"><div className="logo">S</div><div><h1>Spoonfeeder<span>2</span></h1><p>Repository context workspace</p></div></div><div className="top-actions"><button onClick={onOpenMap} disabled={!path}><Map/>依存関係マップ<ExternalLink/></button><button onClick={onOpenIgnoreEditor} disabled={!path}><ListPlus/>無視リスト編集</button><button className="icon-button" onClick={onOpenSettings}><Menu/></button></div></header>;
+}
diff --git a/frontend/src/components/TreeContextMenu.jsx b/frontend/src/components/TreeContextMenu.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..6978ec261b1713e253e9f3a4cfa17c172674261b
--- /dev/null
+++ b/frontend/src/components/TreeContextMenu.jsx
@@ -0,0 +1,18 @@
+/**
+ * ファイルツリーの右クリックメニュー (TreeContextMenu.jsx)
+ *
+ * 仕様:
+ * 1. ignored項目では「無視リストから除外」、通常項目では「無視リストへ追加」を表示する。
+ * 2. Embedded Python以外では「対象リポジトリを追加」を表示する（未解決も手動設定もなければ無効）。
+ * 3. 画面外にはみ出さないよう表示位置を補正する。
+ **/
+
+import { Ban, GitBranch, ListPlus } from 'lucide-react';
+
+export function TreeContextMenu({ menu, pythonMode, referenceData, onAddIgnore, onRemoveIgnore, onOpenReferenceEditor }) {
+  const hasReferenceTargets = (referenceData.unresolved || []).length > 0 || Object.keys(referenceData.manual_references || {}).length > 0;
+  return <div className="tree-context-menu" style={{ top: `${Math.min(menu.y, Math.max(8, window.innerHeight - 112))}px`, left: `${Math.min(menu.x, Math.max(8, window.innerWidth - 250))}px` }} onClick={event => event.stopPropagation()}>
+    {menu.node.ignored ? <button onClick={() => onRemoveIgnore(menu.node)}><Ban/>無視リストから除外</button> : <button onClick={() => onAddIgnore(menu.node)}><ListPlus/>無視リストへ追加</button>}
+    {pythonMode !== 'embedded' && <button onClick={() => onOpenReferenceEditor(menu.node)} disabled={!hasReferenceTargets}><GitBranch/>対象リポジトリを追加</button>}
+  </div>;
+}
diff --git a/frontend/src/components/TreeNode.jsx b/frontend/src/components/TreeNode.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..a4fca4943fc15e9ba4537f2dd59cdc1f93045e9a
--- /dev/null
+++ b/frontend/src/components/TreeNode.jsx
@@ -0,0 +1,56 @@
+/**
+ * ファイルツリーの1ノード (TreeNode.jsx)
+ *
+ * 仕様:
+ * 1. ディレクトリは開閉、ファイルはチェックで選択切替・クリックでプレビュー、右クリックでメニューを開く。
+ * 2. フィルター一致時は祖先を自動展開し、一致しないノードは描画しない。
+ * 3. ignored項目はチェック不可で「ignored」バッジを表示する。
+ * 4. キーボード操作用の data-tree-* 属性を付与する（操作は usePreview の handleTreeKeyDown が担当）。
+ **/
+
+import { useEffect, useState } from 'react';
+import { ChevronDown, ChevronRight } from 'lucide-react';
+import { flattenFiles, nodeMatchesFilter, toggleSelection } from '../lib/selection';
+import { FileIcon } from './FileIcon';
+
+export function TreeNode({ node, selected, setSelected, filter, onPreview, onContextMenu, selectionPrefix = '', depth = 0 }) {
+  const children = node.children || [];
+  const matches = nodeMatchesFilter(node.path, filter);
+  const childMatches = children.some(child => child.path.toLowerCase().includes(filter.toLowerCase()));
+  const [open, setOpen] = useState(depth < 1 || Boolean(filter));
+  useEffect(() => { if (filter && childMatches) setOpen(true); }, [filter, childMatches]);
+  if (!matches && !childMatches) return null;
+  const paths = flattenFiles([node]).map(path => `${selectionPrefix}${path}`);
+  const checked = paths.length > 0 && paths.every(path => selected.has(path));
+  const toggle = () => setSelected(previous => toggleSelection(previous, paths, checked));
+  return <div className={`tree-entry ${node.ignored ? 'ignored' : ''}`}>
+    <div
+      className="tree-row"
+      role="treeitem"
+      tabIndex={-1}
+      data-tree-item="true"
+      data-tree-kind={node.type}
+      data-tree-ignored={node.ignored ? 'true' : 'false'}
+      data-tree-path={node.path}
+      data-tree-repository={selectionPrefix.endsWith('::') ? selectionPrefix.slice(0, -2) : ''}
+      aria-expanded={node.type === 'directory' ? open : undefined}
+      aria-selected={node.type === 'file' ? checked : undefined}
+      style={{ paddingLeft: `${depth * 16 + 6}px` }}
+      onMouseDown={event => event.currentTarget.focus()}
+      onDoubleClick={() => node.type === 'file' && !node.ignored && onPreview(node.path)}
+      onContextMenu={event => { if (!onContextMenu) return; event.preventDefault(); onContextMenu(event, node); }}
+    >
+      {node.type === 'directory' ? <button className="icon-button tiny" tabIndex={-1} data-tree-toggle="true" onClick={event => { setOpen(!open); event.currentTarget.closest('.tree-row')?.focus(); }}>{open ? <ChevronDown/> : <ChevronRight/>}</button> : <span className="tree-spacer"/>}
+      <input tabIndex={-1} type="checkbox" disabled={node.ignored || paths.length === 0} checked={checked} onChange={toggle} onClick={event => event.currentTarget.closest('.tree-row')?.focus()}/>
+      <FileIcon
+        name={node.name}
+        type={node.type}
+        isOpen={node.type === 'directory' && open}
+        className={node.type === 'directory' ? 'tree-folder-icon' : 'tree-file-icon'}
+      />
+      <button className="tree-name" tabIndex={-1} onClick={event => { event.currentTarget.closest('.tree-row')?.focus(); node.type === 'directory' ? setOpen(!open) : onPreview(node.path); }}>{node.name}</button>
+      {node.ignored && <span className="ignored-badge">ignored</span>}
+    </div>
+    {open && children.map(child => <TreeNode key={`${child.path}:${child.ignored}`} node={child} selected={selected} setSelected={setSelected} filter={filter} onPreview={onPreview} onContextMenu={onContextMenu} selectionPrefix={selectionPrefix} depth={depth + 1}/>) }
+  </div>;
+}
diff --git a/frontend/src/components/components.test.jsx b/frontend/src/components/components.test.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..ae1af7984840165495ab52a3d37d0515f2276673
--- /dev/null
+++ b/frontend/src/components/components.test.jsx
@@ -0,0 +1,204 @@
+/**
+ * 描画コンポーネントのテスト (components.test.jsx)
+ *
+ * 仕様: react-dom/server で実コンポーネントを描画し、props に応じた表示・無効状態・属性を確認する。
+ * （クリック等の実操作はビルド済み画面を実ブラウザ・実バックエンドで確認する）
+ **/
+
+import { renderToStaticMarkup } from 'react-dom/server';
+import { describe, expect, it } from 'vitest';
+import { CodeContextPanel } from './CodeContextPanel';
+import { FileSelectPanel } from './FileSelectPanel';
+import { HelpModal } from './HelpModal';
+import { MkdocsContextPanel } from './MkdocsContextPanel';
+import { PathBar } from './PathBar';
+import { SettingsDrawer } from './SettingsDrawer';
+import { Toast } from './Toast';
+import { TopBar } from './TopBar';
+import { TreeContextMenu } from './TreeContextMenu';
+import { TreeNode } from './TreeNode';
+
+const html = element => renderToStaticMarkup(element);
+const noop = () => {};
+
+describe('Toast', () => {
+  it('メッセージを表示する', () => expect(html(<Toast message="保存しました" onClose={noop}/>)).toContain('保存しました'));
+});
+
+describe('TreeNode', () => {
+  const directory = { type: 'directory', name: 'src', path: 'src', children: [
+    { type: 'file', name: 'main.py', path: 'src/main.py' },
+    { type: 'file', name: 'gen.py', path: 'src/gen.py', ignored: true },
+  ] };
+
+  it('チェック状態をaria-selectedに反映し、ignoredにはバッジとdisabledを付ける', () => {
+    const markup = html(<TreeNode node={directory} selected={new Set(['src/main.py'])} setSelected={noop} filter="" onPreview={noop}/>);
+    expect(markup).toContain('data-tree-path="src/main.py"');
+    expect(markup).toContain('aria-selected="true"');
+    expect(markup).toContain('ignored-badge');
+    expect(markup).toMatch(/<input[^>]*disabled[^>]*type="checkbox"|<input[^>]*type="checkbox"[^>]*disabled/);
+  });
+
+  it('フィルターに一致しないノードは描画しない', () => {
+    expect(html(<TreeNode node={directory} selected={new Set()} setSelected={noop} filter="zzz" onPreview={noop}/>)).toBe('');
+  });
+
+  it('フィルター一致時は祖先を展開して一致するファイルを表示する', () => {
+    const markup = html(<TreeNode node={directory} selected={new Set()} setSelected={noop} filter="main" onPreview={noop}/>);
+    expect(markup).toContain('main.py');
+  });
+});
+
+describe('HelpModal', () => {
+  it('閉じているときは何も描画せず、開くとショートカットを表示する', () => {
+    expect(html(<HelpModal open={false} close={noop}/>)).toBe('');
+    expect(html(<HelpModal open close={noop}/>)).toContain('ショートカット');
+  });
+});
+
+describe('SettingsDrawer', () => {
+  const base = { open: true, close: noop, path: '/repo', openIgnoreEditor: noop, showIgnored: false, setShowIgnored: noop, pythonMode: 'normal', setPythonMode: noop, embeddedDir: '', setEmbeddedDir: noop, gitDiffCommand: '', setGitDiffCommand: noop, reload: noop };
+
+  it('通常モードではEmbeddedのフォルダ入力を表示せず、Git差分コマンドの既定値を案内する', () => {
+    const markup = html(<SettingsDrawer {...base}/>);
+    expect(markup).not.toContain('python.exeがあるフォルダ');
+    expect(markup).toContain('git diff HEAD -- *.py');
+  });
+
+  it('Embeddedモードではフォルダ入力を表示する', () => {
+    expect(html(<SettingsDrawer {...base} pythonMode="embedded"/>)).toContain('python.exeがあるフォルダ');
+  });
+
+  it('リポジトリ未選択では無視リスト編集を無効にする', () => {
+    expect(html(<SettingsDrawer {...base} path=""/>)).toMatch(/<button[^>]*disabled[^>]*class="drawer-action"|<button[^>]*class="drawer-action"[^>]*disabled/);
+  });
+});
+
+describe('TopBar', () => {
+  it('リポジトリ未選択ではマップと無視リスト編集を無効にする', () => {
+    const markup = html(<TopBar path="" onOpenMap={noop} onOpenIgnoreEditor={noop} onOpenSettings={noop}/>);
+    expect(markup.match(/disabled=""/g)).toHaveLength(2);
+  });
+});
+
+describe('PathBar', () => {
+  const props = { path: '/repo', setPath: noop, repositories: [], setRepositories: noop, onLoad: noop, loading: false, showIgnored: false, notify: noop, activeMode: 'code', isMkdocsRepo: false, mkdocsConfig: {}, onToggleMode: noop, gitDiffCommand: '', loadingDiff: false, onCopyGitDiff: noop, onOpenCode: noop };
+
+  it('コードモード表示と、実行されるGit差分コマンド(空欄は既定)をツールチップに出す', () => {
+    const markup = html(<PathBar {...props}/>);
+    expect(markup).toContain('コードモード');
+    expect(markup).toContain('Git差分をクリップボードにコピー (git diff HEAD -- *.py)');
+  });
+
+  it('MkDocs検出時はYAMLファイル名を案内しMkDocsモードを表示する', () => {
+    const markup = html(<PathBar {...props} activeMode="mkdocs" isMkdocsRepo mkdocsConfig={{ config_file: 'mkdocs.yml', site_name: 'Docs' }}/>);
+    expect(markup).toContain('MkDocsモード');
+    expect(markup).toContain('YAML検出: mkdocs.yml (Docs)');
+  });
+
+  it('リポジトリ未選択ではモード切替を出さない', () => {
+    expect(html(<PathBar {...props} path=""/>)).not.toContain('mode-switch-button');
+  });
+});
+
+describe('CodeContextPanel', () => {
+  const props = { context: '', path: '/repo', loading: false, selectedCount: 2, includeExternalModules: true, setIncludeExternalModules: noop, onGenerate: noop, onCopy: noop, onDownload: noop };
+
+  it('未作成ならプレースホルダー、作成済みならコピー/保存ボタンと本文を表示する', () => {
+    expect(html(<CodeContextPanel {...props}/>)).toContain('repository_context.txt');
+    const created = html(<CodeContextPanel {...props} context="<file/>"/>);
+    expect(created).toContain('コピー');
+    expect(created).toContain('&lt;file/&gt;');
+  });
+
+  it('選択ファイルが0件なら作成ボタンを無効にし、外部モジュールのチェックを反映する', () => {
+    const markup = html(<CodeContextPanel {...props} selectedCount={0}/>);
+    expect(markup).toMatch(/<button[^>]*class="primary large"[^>]*disabled|<button[^>]*disabled[^>]*class="primary large"/);
+    expect(markup).toContain('checked=""');
+  });
+});
+
+describe('MkdocsContextPanel', () => {
+  const mkdocs = { exportFolder: '~/out', setExportFolder: noop, imageDataUrl: '', stats: null, viewTab: 'markdown', setViewTab: noop, saving: false, onOpenFolder: noop, onSave: noop, downloadImage: noop };
+  const props = { context: '', path: '/repo', loading: false, selectedCount: 1, onGenerate: noop, onCopy: noop, onDownload: noop, mkdocs };
+
+  it('保存先フォルダと未作成のプレースホルダーを表示する', () => {
+    const markup = html(<MkdocsContextPanel {...props}/>);
+    expect(markup).toContain('value="~/out"');
+    expect(markup).toContain('*_context.md ＋ *_images.png');
+  });
+
+  it('作成後は文書数と画像数のタブ、画像があれば結合画像保存ボタンを表示する', () => {
+    const stats = { total_documents: 3, total_images: 2, images_meta: [] };
+    const markup = html(<MkdocsContextPanel {...props} context="# md" mkdocs={{ ...mkdocs, stats, imageDataUrl: 'data:image/png;base64,AA' }}/>);
+    expect(markup).toContain('統合マークダウン (3件)');
+    expect(markup).toContain('結合画像プレビュー (2枚連結)');
+    expect(markup).toContain('結合画像保存');
+  });
+
+  it('画像タブで画像がなければ案内を表示し、結合画像があれば図の対応を表示する', () => {
+    const empty = html(<MkdocsContextPanel {...props} context="# md" mkdocs={{ ...mkdocs, viewTab: 'image' }}/>);
+    expect(empty).toContain('呼び出されている画像はありません');
+    const stats = { total_documents: 1, total_images: 1, images_meta: [{ index: 1, doc_path: 'docs/a.md', link_text: '![x](x.png)' }] };
+    const withImage = html(<MkdocsContextPanel {...props} context="# md" mkdocs={{ ...mkdocs, viewTab: 'image', stats, imageDataUrl: 'data:image/png;base64,AA' }}/>);
+    expect(withImage).toContain('【図1】');
+    expect(withImage).toContain('docs/a.md');
+  });
+
+  it('保存中は保存ボタンを無効にする', () => {
+    expect(html(<MkdocsContextPanel {...props} mkdocs={{ ...mkdocs, saving: true }}/>).match(/disabled=""/g).length).toBeGreaterThanOrEqual(2);
+  });
+});
+
+describe('FileSelectPanel', () => {
+  const tree = [{ type: 'file', name: 'a.py', path: 'a.py' }];
+  const base = {
+    tree, allFiles: ['a.py'], selected: new Set(['a.py']), setSelected: noop, filter: '', setFilter: noop, treeRef: { current: null },
+    onTreeKeyDown: noop, onPreview: noop, onContextMenu: noop, path: '/repo', loading: false, activeMode: 'code', autoCheckLoading: false,
+    onAutoCheck: noop, referenceData: { enabled: true, repositories: [], unresolved: [], warnings: [] }, referenceSelected: new Set(),
+    setReferenceSelected: noop, referenceFileCount: 0, onOpenReferenceEditor: noop
+  };
+
+  it('選択数、自動チェックボタンの文言(モード別)、全選択解除ボタンを表示する', () => {
+    const code = html(<FileSelectPanel {...base}/>);
+    expect(code).toContain('1 / 1');
+    expect(code).toContain('ライブラリを自動チェック');
+    expect(code).toContain('選択解除');
+    expect(html(<FileSelectPanel {...base} activeMode="mkdocs"/>)).toContain('リンク先MDを自動チェック');
+  });
+
+  it('ツリーが空なら案内を表示する', () => {
+    expect(html(<FileSelectPanel {...base} tree={[]} allFiles={[]}/>)).toContain('リポジトリを読み込むと');
+  });
+
+  it('コードモードでは参照ライブラリ・未解決・警告を表示し、MkDocsモードでは表示しない', () => {
+    const referenceData = {
+      enabled: true, warnings: ['解析に失敗'], unresolved: [{ module: 'x', language: 'python', source_files: [] }],
+      repositories: [{ path: '/lib', name: 'lib', reason: 'manual', files: ['u.py'], tree: [{ type: 'file', name: 'u.py', path: 'u.py' }] }]
+    };
+    const code = html(<FileSelectPanel {...base} referenceData={referenceData} referenceFileCount={1}/>);
+    expect(code).toContain('参照ライブラリ');
+    expect(code).toContain('手動');
+    expect(code).toContain('1件の参照先を確認');
+    expect(code).toContain('解析に失敗');
+    expect(html(<FileSelectPanel {...base} activeMode="mkdocs" referenceData={referenceData}/>)).not.toContain('参照ライブラリ');
+  });
+});
+
+describe('TreeContextMenu', () => {
+  globalThis.window = globalThis.window || { innerHeight: 800, innerWidth: 1200 };
+  const referenceData = { unresolved: [], manual_references: {} };
+  const menuFor = node => ({ x: 10, y: 20, node });
+
+  it('通常項目は追加、ignored項目は除外を表示する', () => {
+    expect(html(<TreeContextMenu menu={menuFor({ path: 'a', ignored: false })} pythonMode="normal" referenceData={referenceData}/>)).toContain('無視リストへ追加');
+    expect(html(<TreeContextMenu menu={menuFor({ path: 'a', ignored: true })} pythonMode="normal" referenceData={referenceData}/>)).toContain('無視リストから除外');
+  });
+
+  it('Embeddedでは対象リポジトリの追加を出さず、通常は未解決も手動設定もなければ無効にする', () => {
+    const node = { path: 'a' };
+    expect(html(<TreeContextMenu menu={menuFor(node)} pythonMode="embedded" referenceData={referenceData}/>)).not.toContain('対象リポジトリを追加');
+    expect(html(<TreeContextMenu menu={menuFor(node)} pythonMode="normal" referenceData={referenceData}/>)).toMatch(/disabled=""[^>]*>.*対象リポジトリを追加/);
+    expect(html(<TreeContextMenu menu={menuFor(node)} pythonMode="normal" referenceData={{ unresolved: [{}], manual_references: {} }}/>)).not.toMatch(/disabled=""[^>]*>.*対象リポジトリを追加/);
+  });
+});
