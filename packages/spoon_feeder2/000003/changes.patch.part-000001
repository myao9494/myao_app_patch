+import { describe, expect, it } from 'vitest';
+import { imageExtension } from './download';
+
+describe('imageExtension', () => {
+  it('PNGのData URLはpng、それ以外(JPEG)はjpgにする', () => {
+    expect(imageExtension('data:image/png;base64,AAA')).toBe('png');
+    expect(imageExtension('data:image/jpeg;base64,AAA')).toBe('jpg');
+  });
+});
diff --git a/frontend/src/lib/ignoreHistory.js b/frontend/src/lib/ignoreHistory.js
new file mode 100644
index 0000000000000000000000000000000000000000..39f179eb4d4472fdeee0b50a1f66a2d655a922cf
--- /dev/null
+++ b/frontend/src/lib/ignoreHistory.js
@@ -0,0 +1,35 @@
+/**
+ * 無視リスト編集用のUndo/Redo履歴 (ignoreHistory.js)
+ *
+ * 仕様:
+ * 1. 編集テキストを履歴として積み、undo / redo で前後のテキストを返す（端では現在値のまま）。
+ * 2. undo後に新しい編集をすると、redo側の履歴は破棄する。
+ * 3. 直前と同じテキストは履歴に積まない。
+ **/
+
+export class TextHistory {
+  constructor(initial = '') {
+    this.items = [initial];
+    this.index = 0;
+  }
+
+  get current() { return this.items[this.index]; }
+
+  push(text) {
+    const items = this.items.slice(0, this.index + 1);
+    if (items[items.length - 1] !== text) items.push(text);
+    this.items = items;
+    this.index = items.length - 1;
+    return this.current;
+  }
+
+  undo() {
+    if (this.index > 0) this.index -= 1;
+    return this.current;
+  }
+
+  redo() {
+    if (this.index < this.items.length - 1) this.index += 1;
+    return this.current;
+  }
+}
diff --git a/frontend/src/lib/ignoreHistory.test.js b/frontend/src/lib/ignoreHistory.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..73f569e977f36be8699aa69f38ea41d96ab94284
--- /dev/null
+++ b/frontend/src/lib/ignoreHistory.test.js
@@ -0,0 +1,37 @@
+/**
+ * 無視リスト編集のUndo/Redo履歴のテスト (ignoreHistory.test.js)
+ **/
+
+import { describe, expect, it } from 'vitest';
+import { TextHistory } from './ignoreHistory';
+
+describe('TextHistory', () => {
+  it('編集を積み、undo / redo で前後のテキストへ移動する', () => {
+    const history = new TextHistory('a');
+    history.push('ab');
+    history.push('abc');
+    expect(history.undo()).toBe('ab');
+    expect(history.undo()).toBe('a');
+    expect(history.undo()).toBe('a');
+    expect(history.redo()).toBe('ab');
+    expect(history.redo()).toBe('abc');
+    expect(history.redo()).toBe('abc');
+  });
+
+  it('undo後に新しく編集するとredo側の履歴を破棄する', () => {
+    const history = new TextHistory('a');
+    history.push('b');
+    history.undo();
+    history.push('c');
+    expect(history.redo()).toBe('c');
+    expect(history.undo()).toBe('a');
+  });
+
+  it('直前と同じテキストは履歴に積まない', () => {
+    const history = new TextHistory('a');
+    history.push('a');
+    history.push('b');
+    history.push('b');
+    expect(history.items).toEqual(['a', 'b']);
+  });
+});
diff --git a/frontend/src/lib/selection.js b/frontend/src/lib/selection.js
new file mode 100644
index 0000000000000000000000000000000000000000..29b7db5f1fab73a60d2d4ffde3d6be11487b618d
--- /dev/null
+++ b/frontend/src/lib/selection.js
@@ -0,0 +1,55 @@
+/**
+ * ファイル選択・モード判定の純粋ロジック (selection.js)
+ *
+ * 仕様:
+ * 1. flattenFiles: ツリーから選択可能なファイル(ignored除外)のパスを再帰的に列挙する。
+ * 2. filterReferenceFilesByInclusion: 「呼び出されているモジュールを含む」がONのときだけ、選択された参照ファイルをAPI形式で返す。
+ * 3. mergeAutoSelectedFiles: 現在の選択に自動検出ファイルを重複なく追加する。
+ * 4. resolveRepositoryMode: MkDocs判定と手動切替から実際のモード(code / mkdocs)を決める。
+ * 5. initialSelection: 保存済み選択とツリーを突き合わせ、存在するファイルだけを復元する（保存なしなら全選択）。
+ * 6. toggleSelection: ディレクトリ/ファイルのチェック切替後の選択集合を返す。
+ * 7. mergeReferenceSelection: 参照ライブラリの再解析後、新規に現れたファイルは選択、既存は直前の選択状態を維持する。
+ * 8. parseIgnoreText: 無視リスト編集テキストを、区切りを / に統一し空行と重複を除いたパターン配列にする。
+ * 9. nodeMatchesFilter: ファイル検索フィルターに一致するか（大文字小文字無視）。
+ **/
+
+export const flattenFiles = (nodes) => nodes.flatMap(node => node.type === 'file' ? (node.ignored ? [] : [node.path]) : flattenFiles(node.children || []));
+
+export const filterReferenceFilesByInclusion = (repositories, selected, includeExternal) => {
+  if (!includeExternal) return [];
+  return (repositories || []).map(repo => {
+    const files = (repo.files || []).filter(file => selected.has(`${repo.path}::${file}`));
+    return { repository_path: repo.path, files };
+  }).filter(repo => repo.files.length > 0);
+};
+
+export const mergeAutoSelectedFiles = (currentSelected, detectedFiles) => {
+  return new Set([...Array.from(currentSelected), ...detectedFiles]);
+};
+
+export const resolveRepositoryMode = (isMkdocsRepo, userOverrideMode = '') => {
+  if (userOverrideMode === 'mkdocs' || userOverrideMode === 'code') {
+    return userOverrideMode;
+  }
+  return isMkdocsRepo ? 'mkdocs' : 'code';
+};
+
+export const initialSelection = (savedFiles, allFiles) => {
+  if (!savedFiles?.length) return new Set(allFiles);
+  const available = new Set(allFiles);
+  return new Set(savedFiles.filter(file => available.has(file)));
+};
+
+export const toggleSelection = (previous, paths, checked) => {
+  const next = new Set(previous);
+  paths.forEach(path => (checked ? next.delete(path) : next.add(path)));
+  return next;
+};
+
+export const mergeReferenceSelection = (available, previousAvailable, previousSelected) =>
+  new Set(Array.from(available).filter(key => !previousAvailable.has(key) || previousSelected.has(key)));
+
+export const parseIgnoreText = text =>
+  Array.from(new Set(text.split(/\r?\n/).map(item => item.replaceAll('\\', '/').trim()).filter(Boolean)));
+
+export const nodeMatchesFilter = (path, filter) => !filter || path.toLowerCase().includes(filter.toLowerCase());
diff --git a/frontend/src/lib/selection.test.js b/frontend/src/lib/selection.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..dc7b9db1937f8161d060f1094878f62157f0a001
--- /dev/null
+++ b/frontend/src/lib/selection.test.js
@@ -0,0 +1,115 @@
+/**
+ * 選択・モード判定ロジックのテスト (selection.test.js)
+ * 
+ * 仕様:
+ * 1. flattenFiles で無視ファイルを除外して全選択可能ファイルを抽出する。
+ * 2. filterReferenceFilesByInclusion で「呼び出されているモジュールを含む」がONなら選択された参照ファイルを返し、OFFなら空配列を返す。
+ * 3. mergeAutoSelectedFiles で現在選択中のファイル一覧に自動検出されたモジュールを重複なく追加する。
+ **/
+
+import { describe, expect, it } from 'vitest';
+
+import {
+  filterReferenceFilesByInclusion, flattenFiles, initialSelection, mergeAutoSelectedFiles, mergeReferenceSelection,
+  nodeMatchesFilter, parseIgnoreText, resolveRepositoryMode, toggleSelection
+} from './selection';
+
+
+describe('flattenFiles', () => {
+  it('returns selectable files recursively and excludes ignored entries', () => {
+    const tree = [{
+      type: 'directory', path: 'src', children: [
+        { type: 'file', path: 'src/main.py', ignored: false },
+        { type: 'file', path: 'src/generated.py', ignored: true },
+      ],
+    }];
+
+    expect(flattenFiles(tree)).toEqual(['src/main.py']);
+  });
+});
+
+describe('filterReferenceFilesByInclusion', () => {
+  it('呼び出されているモジュールを含むがOFFなら空配列を返す', () => {
+    const repos = [{ path: '/common_lib', files: ['util.py'] }];
+    const selected = new Set(['/common_lib::util.py']);
+    expect(filterReferenceFilesByInclusion(repos, selected, false)).toEqual([]);
+  });
+
+  it('呼び出されているモジュールを含むがONなら選択された参照ファイルのみを返す', () => {
+    const repos = [
+      { path: '/common_lib', files: ['util.py', 'helper.py'] }
+    ];
+    const selected = new Set(['/common_lib::util.py']);
+    expect(filterReferenceFilesByInclusion(repos, selected, true)).toEqual([
+      { repository_path: '/common_lib', files: ['util.py'] }
+    ]);
+  });
+});
+
+describe('mergeAutoSelectedFiles', () => {
+  it('現在選択されているファイルに新規検出モジュールを追加する', () => {
+    const current = new Set(['main.py']);
+    const detected = ['service.py', 'helper.py'];
+    const merged = mergeAutoSelectedFiles(current, detected);
+    expect(Array.from(merged).sort()).toEqual(['helper.py', 'main.py', 'service.py']);
+  });
+});
+
+describe('resolveRepositoryMode', () => {
+  it('手動オーバーライドが未指定の場合、YAML判定がtrueならmkdocsモード、falseならcodeモードを返す', () => {
+    expect(resolveRepositoryMode(true, '')).toBe('mkdocs');
+    expect(resolveRepositoryMode(false, '')).toBe('code');
+  });
+
+  it('手動オーバーライドが指定されている場合はそのモードを優先する', () => {
+    expect(resolveRepositoryMode(true, 'code')).toBe('code');
+    expect(resolveRepositoryMode(false, 'mkdocs')).toBe('mkdocs');
+  });
+});
+
+
+describe('initialSelection', () => {
+  const all = ['a.py', 'b.py', 'c.py'];
+  it('保存済みの選択がなければ全ファイルを選択する', () => {
+    expect(Array.from(initialSelection([], all))).toEqual(all);
+    expect(Array.from(initialSelection(undefined, all))).toEqual(all);
+  });
+  it('保存済みの選択のうち現在も存在するファイルだけを復元する', () => {
+    expect(Array.from(initialSelection(['b.py', 'deleted.py'], all))).toEqual(['b.py']);
+  });
+});
+
+describe('toggleSelection', () => {
+  it('全チェック済みなら外し、そうでなければ全て追加する（元の集合は変更しない）', () => {
+    const before = new Set(['a', 'b']);
+    expect(Array.from(toggleSelection(before, ['a', 'b'], true))).toEqual([]);
+    expect(Array.from(toggleSelection(before, ['a', 'c'], false)).sort()).toEqual(['a', 'b', 'c']);
+    expect(Array.from(before)).toEqual(['a', 'b']);
+  });
+});
+
+describe('mergeReferenceSelection', () => {
+  it('新しく現れた参照ファイルは選択し、既存は直前の選択状態を維持する', () => {
+    const previousAvailable = new Set(['r::a', 'r::b']);
+    const available = new Set(['r::a', 'r::b', 'r::c']);
+    const previousSelected = new Set(['r::a']);
+    expect(Array.from(mergeReferenceSelection(available, previousAvailable, previousSelected)).sort()).toEqual(['r::a', 'r::c']);
+  });
+  it('消えた参照ファイルは選択から外れる', () => {
+    expect(Array.from(mergeReferenceSelection(new Set(['r::a']), new Set(['r::a', 'r::b']), new Set(['r::a', 'r::b'])))).toEqual(['r::a']);
+  });
+});
+
+describe('parseIgnoreText', () => {
+  it('区切りを/に統一し、空行と重複を除く', () => {
+    expect(parseIgnoreText('logs\r\n  build\\out  \n\nlogs\n*.tmp\n')).toEqual(['logs', 'build/out', '*.tmp']);
+  });
+});
+
+describe('nodeMatchesFilter', () => {
+  it('空フィルターは常に一致し、大文字小文字を区別しない', () => {
+    expect(nodeMatchesFilter('src/Main.py', '')).toBe(true);
+    expect(nodeMatchesFilter('src/Main.py', 'main')).toBe(true);
+    expect(nodeMatchesFilter('src/Main.py', 'zzz')).toBe(false);
+  });
+});
diff --git a/frontend/src/pages/DependencyMap.jsx b/frontend/src/pages/DependencyMap.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..d2c86f2057154d307882dee2def7c2c7f7b874c3
--- /dev/null
+++ b/frontend/src/pages/DependencyMap.jsx
@@ -0,0 +1,45 @@
+/**
+ * 依存関係マップ画面 (DependencyMap.jsx)
+ *
+ * 仕様:
+ * 1. /map?path=... で開き、/api/dependency_map の結果をd3の力学レイアウトで描画する（ズーム・ドラッグ対応）。
+ * 2. 包含 / import / 呼び出し の関係を個別に表示切替でき、ノード名で検索すると一致しないノードを薄く表示する。
+ * 3. ノードをクリックすると種類・ID・所属を詳細パネルに表示する。
+ **/
+
+import { useEffect, useRef, useState } from 'react';
+import * as d3 from 'd3';
+import { AlertTriangle, RefreshCw, Search, X } from 'lucide-react';
+import { api } from '../api';
+
+export function DependencyMap() {
+  const params = new URLSearchParams(location.search);
+  const [path, setPath] = useState(params.get('path') || localStorage.getItem('spoonfeederPath') || '');
+  const [data, setData] = useState({ nodes: [], edges: [] });
+  const [filters, setFilters] = useState({ contains: true, import: true, calls: true });
+  const [query, setQuery] = useState('');
+  const [selected, setSelected] = useState(null);
+  const [error, setError] = useState('');
+  const svgRef = useRef(null);
+  const load = async () => { try { setError(''); setData(await api('/api/dependency_map', { library_path: path })); } catch (err) { setError(err.message); } };
+  useEffect(() => { if (path) load(); }, []);
+  useEffect(() => {
+    if (!svgRef.current || !data.nodes.length) return;
+    const svg = d3.select(svgRef.current); svg.selectAll('*').remove();
+    const width = svgRef.current.clientWidth, height = svgRef.current.clientHeight;
+    const viewport = svg.append('g');
+    svg.call(d3.zoom().scaleExtent([0.15, 4]).on('zoom', event => viewport.attr('transform', event.transform)));
+    const nodes = data.nodes.map(item => ({ ...item }));
+    const visibleEdges = data.edges.filter(edge => filters[edge.type]);
+    const links = visibleEdges.map(item => ({ ...item }));
+    const simulation = d3.forceSimulation(nodes).force('link', d3.forceLink(links).id(d => d.id).distance(d => d.type === 'contains' ? 50 : 150)).force('charge', d3.forceManyBody().strength(-220)).force('center', d3.forceCenter(width / 2, height / 2)).force('collide', d3.forceCollide(22));
+    const link = viewport.append('g').selectAll('line').data(links).join('line').attr('class', d => `graph-link ${d.type}`);
+    const node = viewport.append('g').selectAll('g').data(nodes).join('g').attr('class', d => `graph-node ${d.type}`).call(d3.drag().on('start', (event, d) => { if (!event.active) simulation.alphaTarget(.3).restart(); d.fx = d.x; d.fy = d.y; }).on('drag', (event, d) => { d.fx = event.x; d.fy = event.y; }).on('end', (event, d) => { if (!event.active) simulation.alphaTarget(0); d.fx = null; d.fy = null; }));
+    node.append('circle').attr('r', d => d.type === 'file' ? 11 : d.type === 'class' ? 8 : 5).on('click', (_, d) => setSelected(d));
+    node.append('text').attr('x', 13).attr('y', 4).text(d => d.label);
+    simulation.on('tick', () => { link.attr('x1', d => d.source.x).attr('y1', d => d.source.y).attr('x2', d => d.target.x).attr('y2', d => d.target.y); node.attr('transform', d => `translate(${d.x},${d.y})`); });
+    return () => simulation.stop();
+  }, [data, filters]);
+  useEffect(() => { if (!svgRef.current) return; d3.select(svgRef.current).selectAll('.graph-node').classed('dim', d => query && !d.label.toLowerCase().includes(query.toLowerCase())); }, [query]);
+  return <div className="map-page"><svg ref={svgRef}/><aside className="map-controls"><div className="brand mini"><div className="logo">S</div><div><h1>Spoonfeeder Map</h1><p>Python + C# dependencies</p></div></div><label>解析パス</label><div className="map-path"><input value={path} onChange={event => setPath(event.target.value)}/><button onClick={load}><RefreshCw/></button></div><label>ノード検索</label><div className="search-box"><Search/><input value={query} onChange={event => setQuery(event.target.value)} placeholder="名前を入力"/></div><label>関係を表示</label>{Object.keys(filters).map(key => <label className="switch-line compact" key={key}><span>{key === 'contains' ? '包含関係' : key === 'import' ? 'import / using' : '呼び出し'}</span><input type="checkbox" checked={filters[key]} onChange={event => setFilters({ ...filters, [key]: event.target.checked })}/></label>)}<div className="legend"><span><i className="file"/>ファイル</span><span><i className="class"/>クラス</span><span><i className="function"/>関数</span></div>{error && <div className="error-box"><AlertTriangle/>{error}</div>}<a href="/">← コンテキスト画面へ戻る</a></aside>{selected && <aside className="node-detail"><button onClick={() => setSelected(null)}><X/></button><span className="eyebrow">{selected.type}</span><h2>{selected.label}</h2><code>{selected.id}</code>{selected.parent && <p>所属<br/><strong>{selected.parent}</strong></p>}</aside>}</div>;
+}
diff --git a/frontend/src/pages/MainPage.jsx b/frontend/src/pages/MainPage.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..4d6805dd058ef1553dfa87041f453a2aab76c461
--- /dev/null
+++ b/frontend/src/pages/MainPage.jsx
@@ -0,0 +1,215 @@
+/**
+ * メイン画面 (MainPage.jsx)
+ *
+ * 仕様:
+ * 1. リポジトリのパス指定・履歴選択、ファイルツリー、コンテキスト生成、コードパッチ適用、対話型ターミナルを統合提供。
+ * 2. 参照ライブラリ（Python/C#）の自動検出・ツリー表示・手動マッピング（useReferences）。
+ * 3. 「ライブラリを自動チェック」/「リンク先MDを自動チェック」による同一リポジトリ内の呼び出しモジュール・リンク先MDの自動選択。
+ * 4. mkdocs.yml / mkdocs.yaml によるMkDocsリポジトリの自動判定（手動でコード/MkDocsモード切替）と、MD＋結合画像の2ファイル出力（useMkdocsBundle）。
+ * 5. Git差分（既定: git diff HEAD -- *.py）のクリップボードコピー、ファイルプレビュー、無視リスト、設定ドロワー。
+ * 画面領域ごとの描画は components/、状態と副作用は hooks/、純粋ロジックは lib/ に分離している。
+ **/
+
+import { useCallback, useEffect, useMemo, useState } from 'react';
+import { AlertTriangle, BookOpen, Clipboard, X } from 'lucide-react';
+import { api } from '../api';
+import { CodeContextPanel } from '../components/CodeContextPanel';
+import { FileSelectPanel } from '../components/FileSelectPanel';
+import { HelpModal } from '../components/HelpModal';
+import { IgnorePatternsModal } from '../components/IgnorePatternsModal';
+import { MkdocsContextPanel } from '../components/MkdocsContextPanel';
+import { PatchPanel } from '../components/PatchPanel';
+import { PathBar } from '../components/PathBar';
+import { PreviewModal } from '../components/PreviewModal';
+import { ReferenceRepositoryModal } from '../components/ReferenceRepositoryModal';
+import { SettingsDrawer } from '../components/SettingsDrawer';
+import { TerminalPanel } from '../components/TerminalPanel';
+import { Toast } from '../components/Toast';
+import { TopBar } from '../components/TopBar';
+import { TreeContextMenu } from '../components/TreeContextMenu';
+import { DEFAULT_GIT_DIFF_COMMAND, formatGitDiffMessage, resolveGitDiffCommand } from '../gitDiff';
+import { useGlobalShortcuts } from '../hooks/useGlobalShortcuts';
+import { useMkdocsBundle } from '../hooks/useMkdocsBundle';
+import { usePersistentState } from '../hooks/usePersistentState';
+import { usePreview } from '../hooks/usePreview';
+import { useReferences } from '../hooks/useReferences';
+import { downloadText } from '../lib/download';
+import { filterReferenceFilesByInclusion, flattenFiles, initialSelection, mergeAutoSelectedFiles, resolveRepositoryMode } from '../lib/selection';
+
+const EMPTY_MKDOCS_CONFIG = { is_mkdocs: false, config_file: '', site_name: '', docs_dir: 'docs' };
+const storedPath = () => { try { return localStorage.getItem('spoonfeederPath') || ''; } catch { return ''; } };
+
+export function MainPage() {
+  const [path, setPath] = useState(storedPath);
+  const [activePath, setActivePath] = useState(storedPath);
+  const [repositories, setRepositories] = useState([]);
+  const [tree, setTree] = useState([]);
+  const [selected, setSelected] = useState(new Set());
+  const [filter, setFilter] = useState('');
+  const [showIgnored, setShowIgnored] = usePersistentState('showIgnored', false, raw => raw === 'true');
+  const [pythonMode, setPythonMode] = usePersistentState('pythonMode', 'normal', raw => raw || 'normal');
+  const [embeddedDir, setEmbeddedDir] = usePersistentState('embeddedDir', '', raw => raw || '');
+  const [gitDiffCommand, setGitDiffCommand] = usePersistentState('gitDiffCommand', DEFAULT_GIT_DIFF_COMMAND);
+  const [includeExternalModules, setIncludeExternalModules] = usePersistentState('includeExternalModules', true, raw => raw !== 'false');
+  const [loading, setLoading] = useState(false);
+  const [loadingDiff, setLoadingDiff] = useState(false);
+  const [autoCheckLoading, setAutoCheckLoading] = useState(false);
+  const [context, setContext] = useState('');
+  const [error, setError] = useState('');
+  const [toast, setToast] = useState('');
+  const [settingsOpen, setSettingsOpen] = useState(false);
+  const [helpOpen, setHelpOpen] = useState(false);
+  const [ignoreEditor, setIgnoreEditor] = useState({ open: false, pattern: '' });
+  const [referenceEditor, setReferenceEditor] = useState({ open: false, file: '' });
+  const [contextMenu, setContextMenu] = useState(null);
+  const [isMkdocsRepo, setIsMkdocsRepo] = useState(false);
+  const [mkdocsConfig, setMkdocsConfig] = useState(EMPTY_MKDOCS_CONFIG);
+  const [modeOverride, setModeOverride] = useState('');
+
+  const notify = useCallback(message => setToast(message), []);
+  const closeToast = useCallback(() => setToast(''), []);
+  const activeMode = useMemo(() => resolveRepositoryMode(isMkdocsRepo, modeOverride), [isMkdocsRepo, modeOverride]);
+  const libraryPath = activePath || path;
+  const allFiles = useMemo(() => flattenFiles(tree), [tree]);
+
+  const { referenceData, referenceSelected, setReferenceSelected, refreshReferences, referenceFileCount } = useReferences({ activePath, pythonMode, selected, activeMode });
+  const { treeRef, previewFile, previewContent, openPreview, closePreview, handleTreeKeyDown } = usePreview({ activePath, path });
+  const mkdocs = useMkdocsBundle({ libraryPath, selected, siteName: mkdocsConfig.site_name, notify, setContext });
+
+  /** 非同期操作のエラーを画面上部のエラー欄に表示する。 */
+  const guarded = action => async (...args) => {
+    setError('');
+    try { return await action(...args); } catch (err) { setError(err.message); return undefined; }
+  };
+
+  const load = useCallback(async (overrideShowIgnored = showIgnored, overridePath = path) => {
+    if (!overridePath.trim()) return setError('リポジトリのフォルダパスを入力してください。');
+    setLoading(true); setError(''); setContext(''); mkdocs.reset(); setModeOverride('');
+    try {
+      const data = await api('/api/repository_structure', { library_path: overridePath, show_ignored: overrideShowIgnored });
+      setTree(data.files || []);
+      setSelected(initialSelection(data.selected_files, flattenFiles(data.files || [])));
+      setIsMkdocsRepo(Boolean(data.is_mkdocs_repository));
+      setMkdocsConfig(data.mkdocs_config || EMPTY_MKDOCS_CONFIG);
+      setPath(overridePath); setActivePath(overridePath);
+      try { localStorage.setItem('spoonfeederPath', overridePath); } catch { /* 保存できなくても動作は継続する */ }
+      setRepositories(previous => Array.from(new Set([...previous, overridePath])));
+    } catch (err) { setError(err.message); } finally { setLoading(false); }
+  }, [path, showIgnored]);
+
+  useEffect(() => { api('/api/repositories', undefined, 'GET').then(data => setRepositories(data.repositories || [])).catch(() => {}); }, []);
+  useEffect(() => { if (path) load(showIgnored, path); }, []);
+
+  const openIgnoreEditor = (pattern = '') => { setSettingsOpen(false); setIgnoreEditor({ open: true, pattern }); };
+  const openReferenceEditor = node => { setReferenceEditor({ open: true, file: node?.type === 'file' ? node.path : '' }); setContextMenu(null); };
+
+  useGlobalShortcuts({
+    helpOpen, modalOpen: ignoreEditor.open || referenceEditor.open, previewFile,
+    onToggleHelp: setHelpOpen, onClosePreview: closePreview, onCloseContextMenu: () => setContextMenu(null),
+    onOpenIgnoreEditor: () => openIgnoreEditor()
+  });
+
+  const autoCheckModules = guarded(async () => {
+    if (!path || selected.size === 0) return;
+    setAutoCheckLoading(true);
+    try {
+      const data = await api('/api/auto_select_modules', { library_path: libraryPath, selected_files: Array.from(selected) });
+      setSelected(mergeAutoSelectedFiles(selected, data.selected_files || []));
+      const addedCount = (data.added_files || []).length;
+      const markdown = activeMode === 'mkdocs';
+      notify(addedCount > 0
+        ? (markdown ? `リンクされている${addedCount}件のMarkdownにチェックを入れました。` : `呼び出されている${addedCount}件のモジュールにチェックを入れました。`)
+        : (markdown ? 'リンク先のMarkdownはすべてチェック済みです。' : '呼び出されているモジュールはすべてチェック済みです。'));
+    } finally { setAutoCheckLoading(false); }
+  });
+
+  const addIgnorePattern = guarded(async node => {
+    setContextMenu(null);
+    const current = await api('/api/ignore_patterns', { library_path: path });
+    await api('/api/save_ignore_patterns', { library_path: path, patterns: Array.from(new Set([...(current.patterns || []), node.path])) });
+    await load(showIgnored, path); notify(`「${node.path}」を無視リストに追加しました。`);
+  });
+
+  const removeIgnorePattern = guarded(async node => {
+    setContextMenu(null);
+    const data = await api('/api/remove_ignore_pattern', { library_path: path, path: node.path });
+    await load(showIgnored, path);
+    notify(data.status === 'success' ? `「${node.path}」を無視リストから除外しました。` : data.message);
+  });
+
+  const generate = async () => {
+    setLoading(true); setError('');
+    try {
+      if (activeMode === 'mkdocs') {
+        await mkdocs.preview();
+      } else {
+        const referenceFiles = filterReferenceFilesByInclusion(referenceData.repositories || [], referenceSelected, includeExternalModules);
+        const data = await api('/api/repository_context', { library_path: libraryPath, selected_files: Array.from(selected), reference_files: referenceFiles });
+        setContext(data.context); notify(`メイン${data.file_count}件・参照${data.reference_file_count || 0}件のコンテキストを作成しました。`);
+      }
+    } catch (err) { setError(err.message); } finally { setLoading(false); }
+  };
+
+  const copy = guarded(async () => { await navigator.clipboard.writeText(context); notify('コンテキストをコピーしました。'); });
+  const download = () => {
+    const filename = activeMode === 'mkdocs' ? 'mkdocs_context.md' : 'repository_context.txt';
+    downloadText(filename, context); notify(`${filename}を保存しました。`);
+  };
+  const copyGitDiff = async () => {
+    if (!path) return;
+    setLoadingDiff(true); setError('');
+    try {
+      const data = await api('/api/git_diff', { library_path: path, command: resolveGitDiffCommand(gitDiffCommand) });
+      await navigator.clipboard.writeText(data.diff || '');
+      notify(formatGitDiffMessage(data.diff));
+    } catch (err) { setError(err.message); } finally { setLoadingDiff(false); }
+  };
+  const openCode = guarded(async () => { const data = await api('/api/open_in_code', { library_path: path }); if (data.status === 'success') notify(data.message); else setError(data.message); });
+  const openMap = () => window.open(`/map?path=${encodeURIComponent(path)}`, '_blank', 'noopener');
+
+  const mkdocsPanel = { ...mkdocs, onOpenFolder: guarded(mkdocs.openFolder), onSave: guarded(mkdocs.save) };
+  const contextPanelProps = { context, path, loading, selectedCount: selected.size, onGenerate: generate, onCopy: copy, onDownload: download };
+
+  return <div className="app-shell">
+    <TopBar path={path} onOpenMap={openMap} onOpenIgnoreEditor={() => openIgnoreEditor()} onOpenSettings={() => setSettingsOpen(true)}/>
+    <main>
+      <PathBar
+        path={path} setPath={setPath} repositories={repositories} setRepositories={setRepositories} onLoad={load} loading={loading}
+        showIgnored={showIgnored} notify={notify} activeMode={activeMode} isMkdocsRepo={isMkdocsRepo} mkdocsConfig={mkdocsConfig}
+        onToggleMode={() => setModeOverride(activeMode === 'mkdocs' ? 'code' : 'mkdocs')}
+        gitDiffCommand={gitDiffCommand} loadingDiff={loadingDiff} onCopyGitDiff={copyGitDiff} onOpenCode={openCode}
+      />
+      {error && <div className="error-box global"><AlertTriangle/>{error}<button onClick={() => setError('')}><X/></button></div>}
+      <div className="workspace-grid">
+        <FileSelectPanel
+          tree={tree} allFiles={allFiles} selected={selected} setSelected={setSelected} filter={filter} setFilter={setFilter}
+          treeRef={treeRef} onTreeKeyDown={handleTreeKeyDown} onPreview={openPreview} onContextMenu={(event, node) => setContextMenu({ x: event.clientX, y: event.clientY, node })}
+          path={path} loading={loading} activeMode={activeMode} autoCheckLoading={autoCheckLoading} onAutoCheck={autoCheckModules}
+          referenceData={referenceData} referenceSelected={referenceSelected} setReferenceSelected={setReferenceSelected}
+          referenceFileCount={referenceFileCount} onOpenReferenceEditor={openReferenceEditor}
+        />
+        <section className="card context-card">
+          <div className="section-heading">
+            <div>
+              <span className="eyebrow">{activeMode === 'mkdocs' ? `MKDOCS CONTEXT · ${mkdocsConfig.config_file || 'YAML'}` : 'CONTEXT'}</span>
+              <h2>{activeMode === 'mkdocs' ? <BookOpen/> : <Clipboard/>}{activeMode === 'mkdocs' ? 'MkDocs AIコンテキスト＆結合画像' : 'チャット添付用コンテキスト'}</h2>
+            </div>
+            {context && <span className="ready-pill">READY</span>}
+          </div>
+          {activeMode === 'mkdocs'
+            ? <MkdocsContextPanel {...contextPanelProps} mkdocs={mkdocsPanel}/>
+            : <CodeContextPanel {...contextPanelProps} includeExternalModules={includeExternalModules} setIncludeExternalModules={setIncludeExternalModules}/>}
+        </section>
+      </div>
+      <PatchPanel path={path} pythonMode={pythonMode} embeddedDir={embeddedDir} notify={notify} activeMode={activeMode}/>
+      <TerminalPanel path={path} pythonMode={pythonMode} embeddedDir={embeddedDir}/>
+    </main>
+    <SettingsDrawer open={settingsOpen} close={() => setSettingsOpen(false)} path={path} openIgnoreEditor={() => openIgnoreEditor()} showIgnored={showIgnored} setShowIgnored={setShowIgnored} pythonMode={pythonMode} setPythonMode={setPythonMode} embeddedDir={embeddedDir} setEmbeddedDir={setEmbeddedDir} gitDiffCommand={gitDiffCommand} setGitDiffCommand={setGitDiffCommand} reload={value => load(value)}/>
+    <PreviewModal file={previewFile} content={previewContent} close={closePreview}/>
+    <IgnorePatternsModal open={ignoreEditor.open} close={() => setIgnoreEditor(state => ({ ...state, open: false }))} path={path} initialPattern={ignoreEditor.pattern} onSaved={async () => { setIgnoreEditor(state => ({ ...state, open: false })); await load(showIgnored, path); }} notify={notify}/>
+    <ReferenceRepositoryModal open={referenceEditor.open} close={() => setReferenceEditor(state => ({ ...state, open: false }))} path={libraryPath} repositories={repositories} unresolved={referenceData.unresolved || []} initialFile={referenceEditor.file} manualReferences={referenceData.manual_references || {}} onSaved={refreshReferences} notify={notify}/>
+    <HelpModal open={helpOpen} close={() => setHelpOpen(false)}/>
+    {contextMenu && <TreeContextMenu menu={contextMenu} pythonMode={pythonMode} referenceData={referenceData} onAddIgnore={addIgnorePattern} onRemoveIgnore={removeIgnorePattern} onOpenReferenceEditor={openReferenceEditor}/>}
+    {toast && <Toast message={toast} onClose={closeToast}/>}<footer>Python + C# + MkDocs · Git-aware · Local only</footer>
+  </div>;
+}
diff --git a/frontend/src/styles.css b/frontend/src/styles.css
index ac0eae83d13d9d46960076c456768ccc49bc3c65..32f2659948176342cf89b74d05a38188b9c6a686 100644
--- a/frontend/src/styles.css
+++ b/frontend/src/styles.css
@@ -1,3 +1,10 @@
+/**
+ * Spoonfeeder2 グローバルスタイルシート (styles.css)
+ *
+ * 仕様:
+ * 1. ダークテーマベースのワークスペース、ファイルツリー、モーダル、ターミナル、依存関係マップのレイアウトと装飾を定義。
+ * 2. MkDocsモード用のモード切替バッジ、保存先フォルダ設定バー、統合MD・結合画像プレビュータブのスタイルを定義。
+ **/
 @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');
