"JetBrains Mono",monospace}.test-ok{color:var(--green);font-size:10px}.test-ng{color:var(--red);font-size:10px}.test-output{margin:10px 20px 0}.test-output pre{max-height:210px;overflow:auto;background:#080d18;border:1px solid var(--line);padding:11px;color:#aab5c9;font:10px/1.5 "JetBrains Mono",monospace}.test-output button{margin-left:auto}.error-box{display:flex;align-items:flex-start;gap:8px;margin:12px 20px 0;color:#ffc0cb;background:#44182666;border:1px solid #863347;border-radius:8px;padding:10px 12px;font-size:10px}.error-box svg{width:15px;flex:none}.error-box.global{margin:0 0 18px}.error-box.global button{margin-left:auto;background:0;border:0;color:inherit}.terminal-panel{margin-top:18px;border:1px solid var(--line);background:#090e1a;border-radius:13px;overflow:hidden}.terminal-heading{width:100%;height:47px;border:0;background:#10182a;color:#cfd7e6;display:flex;align-items:center;gap:8px;padding:0 16px}.terminal-heading>span:first-child{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:700}.terminal-heading>span:first-child svg{width:16px;color:var(--indigo)}.terminal-heading>svg{margin-left:auto;width:16px;transition:.2s}.terminal-panel.open .terminal-heading>svg{transform:rotate(180deg)}.status-dot{width:7px;height:7px;border-radius:99px;background:#64748b}.status-dot.ready{background:var(--green);box-shadow:0 0 8px var(--green)}.status-dot.connecting{background:#fbbf24}.terminal-content pre{height:270px;overflow:auto;margin:0;padding:14px;color:#b9c8ba;font:11px/1.55 "JetBrains Mono",monospace}.terminal-content form{height:42px;border-top:1px solid var(--line);display:flex;align-items:center;padding:0 12px;gap:8px;color:var(--green)}.terminal-content form input{flex:1;background:none;border:0;outline:0;color:#e4e9f1;font:11px "JetBrains Mono",monospace}.terminal-content form button{background:#202d46;color:#cdd5e3;border:0;border-radius:6px;padding:5px 11px;font-size:10px}footer{text-align:center;color:#4f5a70;font-size:9px;letter-spacing:1.5px;padding:26px}.drawer-layer,.modal-layer{position:fixed;inset:0;background:#03050ba8;backdrop-filter:blur(5px);z-index:50}.drawer{position:absolute;right:0;top:0;height:100%;width:min(410px,92vw);background:#0c1220;border-left:1px solid var(--line);padding:23px;box-shadow:-20px 0 70px #0008}.drawer-title,.modal header{display:flex;justify-content:space-between;align-items:center;padding-bottom:18px;border-bottom:1px solid var(--line)}.setting-group{margin-top:22px;padding:15px;background:#11192a;border:1px solid var(--line);border-radius:10px}.setting-group>label:not(.switch-line){display:block;color:#8d99b1;font-size:10px;font-weight:700;margin-bottom:8px}.setting-group input,.setting-group select{width:100%;margin-top:8px}.switch-line{display:flex;align-items:center;justify-content:space-between;gap:20px}.switch-line strong{display:block;font-size:12px}.switch-line small{display:block;color:#77849b;font-size:9px;margin-top:5px}.switch-line input{appearance:none;width:36px!important;height:20px;background:#263149;border:0;border-radius:99px;position:relative;flex:none}.switch-line input:after{content:"";position:absolute;width:14px;height:14px;top:3px;left:3px;background:#7d899e;border-radius:99px;transition:.2s}.switch-line input:checked{background:#615de0}.switch-line input:checked:after{left:19px;background:white}.drawer-note{color:#59667c;font-size:9px;margin-top:18px}.modal{width:min(1000px,90vw);height:min(760px,86vh);position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);background:#0d1424;border:1px solid var(--line);border-radius:14px;display:flex;flex-direction:column;padding:20px}.modal h3{margin:0;font:12px "JetBrains Mono",monospace}.modal pre{flex:1;overflow:auto;background:#070c16;border:1px solid var(--line);padding:16px;color:#b6c2d5;font:11px/1.6 "JetBrains Mono",monospace;white-space:pre-wrap}.toast{position:fixed;right:24px;bottom:24px;z-index:100;background:#172337;border:1px solid #31506c;color:#d5e8f2;border-radius:10px;padding:12px 16px;display:flex;align-items:center;gap:9px;font-size:11px;box-shadow:0 14px 45px #0008}.toast svg{color:var(--green)}.spin{animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
 .map-page{position:fixed;inset:0;background:radial-gradient(circle at center,#111c35,#050812);overflow:hidden}.map-page>svg{width:100%;height:100%}.map-controls,.node-detail{position:absolute;top:20px;bottom:20px;width:310px;background:#0b1220e8;backdrop-filter:blur(18px);border:1px solid #26324b;border-radius:14px;box-shadow:0 18px 70px #0008;padding:18px}.map-controls{left:20px}.brand.mini{margin-bottom:24px}.brand.mini .logo{width:34px;height:34px;font-size:16px}.brand.mini h1{font-size:15px}.map-controls>label:not(.switch-line){display:block;color:#74819a;font-size:8px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;margin:16px 0 7px}.map-path{display:flex;gap:5px}.map-path input{min-width:0;flex:1}.map-path button{width:35px;border:1px solid var(--line);background:#19243b;color:#cbd3e2;border-radius:8px}.map-path svg{width:14px}.switch-line.compact{padding:8px 0;color:#b3bdd0;font-size:11px}.switch-line.compact input{margin:0}.legend{display:flex;gap:12px;margin-top:18px;font-size:8px;color:#74819a}.legend span{display:flex;align-items:center;gap:5px}.legend i{width:7px;height:7px;border-radius:99px;background:#52a9ff}.legend i.class{background:#ad78ff}.legend i.function{background:#49dca0}.map-controls>a{position:absolute;bottom:18px;color:#8998b4;font-size:10px;text-decoration:none}.node-detail{right:20px;bottom:auto;min-height:210px}.node-detail>button{position:absolute;right:12px;top:12px;background:none;border:0;color:#91a0b9}.node-detail h2{font-size:20px;margin:4px 0 16px}.node-detail code{display:block;color:#9caac1;background:#080d18;padding:10px;border-radius:8px;font-size:9px;word-break:break-all}.node-detail p{font-size:9px;color:#71809a;margin-top:16px}.node-detail strong{color:#b9c4d5}.graph-link{stroke:#62708c;stroke-opacity:.2}.graph-link.import{stroke:#6ea8ff;stroke-opacity:.38}.graph-link.calls{stroke:#4de0b0;stroke-opacity:.42;stroke-dasharray:3 3}.graph-node circle{fill:#52a9ff;filter:drop-shadow(0 0 5px #52a9ff);cursor:pointer}.graph-node.class circle{fill:#ad78ff;filter:drop-shadow(0 0 5px #ad78ff)}.graph-node.function circle{fill:#49dca0;filter:drop-shadow(0 0 4px #49dca0)}.graph-node text{fill:#bfc9db;font:8px Inter,sans-serif;pointer-events:none}.graph-node.dim{opacity:.08}
@@ -85,3 +92,23 @@
 .include-module-toggle input{width:14px;height:14px;accent-color:var(--indigo);cursor:pointer}
 .include-module-toggle span{white-space:nowrap}
 
+/* MkDocs Mode UI */
+.mode-switch-button{border-radius:9px;padding:9px 12px;display:flex;align-items:center;gap:6px;font-weight:700;font-size:11px;transition:all .15s}
+.mode-switch-button.mkdocs-active{background:linear-gradient(135deg,#0f3c3e,#144b52)!important;border-color:#2ab3b8!important;color:#8cf4f8!important}
+.mode-switch-button.code-active{background:#11192b;border:1px solid var(--line);color:#a8b4cc}
+.mkdocs-export-bar{display:flex;align-items:center;gap:8px;padding:0 16px 10px}
+.mkdocs-folder-label{flex:1;display:flex;align-items:center;gap:6px;background:#090f1d;border:1px solid var(--line);border-radius:8px;padding:5px 10px;font-size:10px;color:#8d9ab1}
+.mkdocs-folder-label span{font-weight:700;white-space:nowrap}
+.mkdocs-folder-label input{flex:1;min-width:0;background:transparent;border:0;outline:0;color:#e4e9f3;font:11px "JetBrains Mono",monospace}
+.mkdocs-export-bar>button{background:#141e33;color:#cbd4e7;border:1px solid var(--line);border-radius:8px;padding:7px 11px;display:flex;align-items:center;gap:5px;font-size:10px;font-weight:600;white-space:nowrap}
+.mkdocs-view-tabs{display:flex;gap:6px;padding:0 16px 8px}
+.mkdocs-view-tabs button{background:#0d1424;color:#8591aa;border:1px solid var(--line);border-radius:7px;padding:5px 11px;display:flex;align-items:center;gap:6px;font-size:10px;font-weight:700}
+.mkdocs-view-tabs button.active{background:#1a2642;color:#e8ecf7;border-color:var(--indigo)}
+.mkdocs-image-preview-wrap{height:100%;overflow:auto;padding:12px;display:flex;flex-direction:column;gap:10px;background:#0a0f1c}
+.mkdocs-image-meta-list{display:flex;flex-wrap:wrap;gap:6px}
+.mkdocs-image-chip{background:#131d33;border:1px solid #2b3a59;color:#c7d2e8;border-radius:6px;padding:4px 8px;font-size:9px;font-family:"JetBrains Mono",monospace}
+.mkdocs-image-chip code{color:#7ee787}
+.mkdocs-combined-image{width:100%;height:auto;border-radius:6px;border:1px solid #2b3a59;background:#fff}
+.mkdocs-actions{justify-content:space-between}
+.mkdocs-sub-actions,.mkdocs-main-actions{display:flex;align-items:center;gap:6px}
+
