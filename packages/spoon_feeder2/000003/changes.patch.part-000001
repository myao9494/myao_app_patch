+++ b/pytest/context_reference_test.py
@@ -53,3 +53,26 @@ def test_参照モジュールが空の場合はメインリポジトリのみ
     assert file_count == 1
     assert ref_count == 0
     assert "<reference_repositories>\n\n</reference_repositories>" in context or "<reference_repository" not in context
+
+
+def test_参照リポジトリのパスが空でもカレントのgitを参照扱いにしない(tmp_path, monkeypatch):
+    import subprocess
+
+    work = tmp_path / "cwd_repo"
+    work.mkdir()
+    subprocess.run(["git", "init", "-q", str(work)], check=True, capture_output=True)
+    main_repo = tmp_path / "main_repo"
+    main_repo.mkdir()
+    (main_repo / "main.py").write_text("VALUE = 1\n", encoding="utf-8")
+    lib = tmp_path / "plain_lib"
+    lib.mkdir()
+    (lib / "lib.py").write_text("X = 1\n", encoding="utf-8")
+    monkeypatch.chdir(work)  # カレントに .git があっても影響しないこと
+    reference_files = [
+        {"repository_path": "", "files": []},
+        {"repository_path": str(lib), "files": ["lib.py"]},
+    ]
+    context, _, ref_count = build_context(main_repo, ["main.py"], reference_files)
+    assert ref_count == 1
+    assert "読み取り専用ライブラリ" in context
+    assert 'read_only="true"' in context
diff --git a/pytest/docs_test.py b/pytest/docs_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..c8b902ccdd383426d69b45d865a1e16f9505eada
--- /dev/null
+++ b/pytest/docs_test.py
@@ -0,0 +1,70 @@
+"""ドキュメントとコードの整合性テスト（コードを正として、記載漏れ・リンク切れを検出する）。"""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+from backend.main import app
+
+ROOT = Path(__file__).resolve().parents[1]
+DEV_SPEC = (ROOT / "claude.md").read_text(encoding="utf-8")
+README = (ROOT / "README.md").read_text(encoding="utf-8")
+
+
+def _documented_paths() -> set[str]:
+    """claude.md のAPI一覧表（`| メソッド | `/path` | ...`）に載っているパス。"""
+    return set(re.findall(r"^\| [A-Z /]+ \| `([^`]+)`", DEV_SPEC, flags=re.MULTILINE))
+
+
+def test_すべてのAPIエンドポイントが開発仕様書のAPI一覧に載っている():
+    documented = _documented_paths()
+    missing = []
+    for path in app.openapi()["paths"]:
+        listed = path if path == "/map" else path.removeprefix("/api")
+        if listed not in documented:
+            missing.append(path)
+    assert not missing, f"claude.md のAPI一覧に未記載: {missing}"
+
+
+def test_開発仕様書のAPI一覧に存在しないエンドポイントは載っていない():
+    actual = {path if path == "/map" else path.removeprefix("/api") for path in app.openapi()["paths"]}
+    actual.add("/terminal/ws")  # WebSocketはOpenAPIに現れない
+    stale = sorted(path for path in _documented_paths() if path not in actual)
+    assert not stale, f"claude.md に載っているが実装にない: {stale}"
+
+
+def test_コードが参照するSPOONFEEDER環境変数がすべて開発仕様書に載っている():
+    used: set[str] = set()
+    for source in list((ROOT / "backend").rglob("*.py")) + [ROOT / "start.sh", ROOT / "start.bat"]:
+        used |= set(re.findall(r"SPOONFEEDER_[A-Z_]+", source.read_text(encoding="utf-8")))
+    missing = sorted(name for name in used if f"`{name}`" not in DEV_SPEC)
+    assert not missing, f"claude.md の環境変数表に未記載: {missing}"
+
+
+def test_READMEのローカルリンク先が存在する():
+    broken = []
+    for target in re.findall(r"\]\(([^)#]+)\)", README):
+        if not target.startswith(("http://", "https://")) and not (ROOT / target).exists():
+            broken.append(target)
+    assert not broken, f"README のリンク切れ: {broken}"
+
+
+def _table_section(start: str, end: str) -> str:
+    return DEV_SPEC[DEV_SPEC.index(start):DEV_SPEC.index(end)]
+
+
+def test_開発仕様書のバックエンド構成表にあるモジュールがすべて存在する():
+    section = _table_section("### backend/", "### frontend/src/")
+    names = {name for row in re.findall(r"^\| ([^|]+) \|", section, flags=re.MULTILINE) for name in re.findall(r"`([^`]+)`", row)}
+    names -= {"モジュール"}
+    missing = sorted(name for name in names if not (ROOT / "backend" / name).exists())
+    assert names and not missing, f"claude.md のバックエンド構成表にあるが存在しない: {missing}"
+
+
+def test_開発仕様書のフロントエンド構成表にある場所がすべて存在する():
+    section = _table_section("### frontend/src/", "## 4.")
+    names = {name for row in re.findall(r"^\| ([^|]+) \|", section, flags=re.MULTILINE) for name in re.findall(r"`([^`]+)`", row)}
+    names = {name for name in names if name.endswith("/") or name.endswith((".jsx", ".js"))}
+    missing = sorted(name for name in names if not (ROOT / "frontend" / "src" / name).exists())
+    assert names and not missing, f"claude.md のフロントエンド構成表にあるが存在しない: {missing}"
diff --git a/pytest/external_roots_test.py b/pytest/external_roots_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..6db189a2da577160e3f2edc8884038fd54c9c285
--- /dev/null
+++ b/pytest/external_roots_test.py
@@ -0,0 +1,43 @@
+"""外部ライブラリルート検出(external_roots)の統合テスト。"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from backend.external_roots import get_external_roots
+
+
+def _make_repo(tmp_path: Path) -> tuple[Path, Path]:
+    repo = tmp_path / "main_repo"
+    repo.mkdir()
+    lib = tmp_path / "common_lib"
+    lib.mkdir()
+    return repo, lib
+
+
+def test_コード内のsys_pathの追加先を外部ルートとして検出する(tmp_path: Path):
+    repo, lib = _make_repo(tmp_path)
+    (repo / "app.py").write_text("import sys\nsys.path.append('../common_lib')\n", encoding="utf-8")
+    assert lib.resolve() in get_external_roots(repo)
+
+
+def test_ファイル数が多くても後ろのファイルのsys_pathを検出する(tmp_path: Path):
+    repo, lib = _make_repo(tmp_path)
+    for index in range(80):
+        (repo / f"module_{index:03d}.py").write_text("VALUE = 1\n", encoding="utf-8")
+    (repo / "zz_last.py").write_text("import sys\nsys.path.insert(0, '../common_lib')\n", encoding="utf-8")
+    assert lib.resolve() in get_external_roots(repo)
+
+
+def test_仮想環境内のファイルのsys_pathは外部ルートにしない(tmp_path: Path):
+    repo, lib = _make_repo(tmp_path)
+    venv_pkg = repo / ".venv" / "lib" / "pkg"
+    venv_pkg.mkdir(parents=True)
+    (venv_pkg / "hack.py").write_text("import sys\nsys.path.append('../../../../common_lib')\n", encoding="utf-8")
+    assert get_external_roots(repo) == []
+
+
+def test_PYTHONPATHのディレクトリを外部ルートに含める(tmp_path: Path, monkeypatch):
+    repo, lib = _make_repo(tmp_path)
+    monkeypatch.setenv("PYTHONPATH", str(lib))
+    assert get_external_roots(repo) == [lib.resolve()]
diff --git a/pytest/helpers_test.py b/pytest/helpers_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..516ad1677a826aa33d1927bef58f75b4ed79be27
--- /dev/null
+++ b/pytest/helpers_test.py
@@ -0,0 +1,141 @@
+"""pyenv / runner / settings_store / security の統合テスト（実ファイル・実プロセスを使用）。"""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+
+import pytest
+
+from backend.pyenv import executable_dir_name, executable_name, find_embedded_python, find_venv_python
+from backend.runner import resolve_test_command, run_shell_command
+from backend.security import UnsafeCommandError, is_allowed_websocket_origin, parse_git_command
+from backend.settings_store import load_settings, manual_references, settings_transaction
+
+
+def _fake_python(base: Path) -> Path:
+    target = base / executable_dir_name() / executable_name()
+    target.parent.mkdir(parents=True, exist_ok=True)
+    target.write_text("", encoding="utf-8")
+    return target
+
+
+# ---- pyenv ----------------------------------------------------------------
+
+def test_仮想環境は_venv_venv_envの順に検出する(tmp_path: Path):
+    env_python = _fake_python(tmp_path / "env")
+    assert find_venv_python(tmp_path) == env_python
+    venv_python = _fake_python(tmp_path / "venv")
+    assert find_venv_python(tmp_path) == venv_python
+    dot_venv_python = _fake_python(tmp_path / ".venv")
+    assert find_venv_python(tmp_path) == dot_venv_python
+
+
+def test_仮想環境がなければNoneを返す(tmp_path: Path):
+    assert find_venv_python(tmp_path) is None
+
+
+def test_EmbeddedPythonは直下を優先し無ければ1階層下のpythonを検出する(tmp_path: Path):
+    direct = tmp_path / "embedded" / executable_name()
+    direct.parent.mkdir()
+    direct.write_text("", encoding="utf-8")
+    assert find_embedded_python(tmp_path / "embedded") == direct
+    nested = tmp_path / "embedded2" / "python312" / executable_name()
+    nested.parent.mkdir(parents=True)
+    nested.write_text("", encoding="utf-8")
+    assert find_embedded_python(tmp_path / "embedded2") == nested
+    assert find_embedded_python(tmp_path / "missing") is None
+
+
+# ---- runner ---------------------------------------------------------------
+
+def test_テストコマンドは仮想環境のPythonへ書き換えられる(tmp_path: Path):
+    python = _fake_python(tmp_path / ".venv")
+    assert resolve_test_command(tmp_path, "python -m pytest -q") == f'"{python}" -m pytest -q'
+    assert resolve_test_command(tmp_path, "python3") == f'"{python}"'
+    assert resolve_test_command(tmp_path, "pytest -x") == f'"{python}" -m pytest -x'
+
+
+def test_python以外のコマンドや仮想環境なしでは書き換えない(tmp_path: Path):
+    assert resolve_test_command(tmp_path, "python -m pytest") == "python -m pytest"
+    _fake_python(tmp_path / ".venv")
+    assert resolve_test_command(tmp_path, "npm test") == "npm test"
+    assert resolve_test_command(tmp_path, "pythonw -m x") == "pythonw -m x"
+
+
+def test_Embeddedモードでは指定ディレクトリのPythonを使う(tmp_path: Path):
+    embedded = tmp_path / "embedded"
+    python = embedded / executable_name()
+    python.parent.mkdir()
+    python.write_text("", encoding="utf-8")
+    _fake_python(tmp_path / ".venv")
+    assert resolve_test_command(tmp_path, "python -V", mode="embedded", embedded_python_dir=str(embedded)) == f'"{python}" -V'
+
+
+def test_コマンドの終了コードと出力を取得できる(tmp_path: Path):
+    import sys
+
+    code, out, err = run_shell_command(f'"{sys.executable}" -c "import sys; print(\'out\'); sys.stderr.write(\'err\'); sys.exit(3)"', tmp_path, os.environ.copy(), 30)
+    assert (code, out.strip(), err.strip()) == (3, b"out", b"err")
+
+
+# ---- settings_store -------------------------------------------------------
+
+def test_設定トランザクションは正常終了時だけ保存する(tmp_path: Path, monkeypatch: pytest.MonkeyPatch):
+    settings_file = tmp_path / "configs.json"
+    monkeypatch.setenv("SPOONFEEDER_CONFIGS_FILE", str(settings_file))
+    with settings_transaction() as settings:
+        settings["ui"] = {"flag": True}
+    assert json.loads(settings_file.read_text(encoding="utf-8"))["ui"] == {"flag": True}
+    with pytest.raises(RuntimeError):
+        with settings_transaction() as settings:
+            settings["ui"] = {"flag": False}
+            raise RuntimeError("途中で失敗")
+    assert json.loads(settings_file.read_text(encoding="utf-8"))["ui"] == {"flag": True}
+
+
+def test_存在しない設定ファイルは空の設定として読める(tmp_path: Path):
+    assert load_settings(tmp_path / "none.json")["repositories"] == {}
+
+
+def test_手動参照設定は空要素と不正な型を除いて取得する(tmp_path: Path):
+    settings = {"repositories": {str(tmp_path): {"manual_references": {"lib": "/x/lib", "": "/y", "empty": " "}}}}
+    assert manual_references(settings, tmp_path) == {"lib": "/x/lib"}
+    assert manual_references({"repositories": {str(tmp_path): {"manual_references": []}}}, tmp_path) == {}
+
+
+# ---- security -------------------------------------------------------------
+
+def test_Gitコマンドは引数リストへ変換され引用符も解釈される():
+    assert parse_git_command('git diff HEAD -- "*.py"') == ["git", "diff", "--no-ext-diff", "HEAD", "--", "*.py"]
+    assert parse_git_command("")[:2] == ["git", "diff"]
+    assert parse_git_command("git status")[:2] == ["git", "status"]
+
+
+@pytest.mark.parametrize("command", ["ls -la", "git", "git push", "git diff --output=x", "git 'unterminated", "echo git diff"])
+def test_許可されないGitコマンドは拒否される(command: str):
+    with pytest.raises(UnsafeCommandError):
+        parse_git_command(command)
+
+
+def test_パス指定以降のオプション風文字列は拒否しない():
+    assert parse_git_command("git log -- --output")[-1] == "--output"
+
+
+def test_WebSocketのOrigin判定_ローカルホストとOriginなしは許可し他は拒否する(monkeypatch: pytest.MonkeyPatch):
+    monkeypatch.delenv("SPOONFEEDER_HOST", raising=False)
+    monkeypatch.delenv("SPOONFEEDER_ALLOWED_ORIGINS", raising=False)
+    assert is_allowed_websocket_origin(None, "localhost:8077")
+    assert is_allowed_websocket_origin("http://localhost:8077", "localhost:8077")
+    assert is_allowed_websocket_origin("http://[::1]:8077", "[::1]:8077")
+    assert not is_allowed_websocket_origin("http://192.168.0.5:8077", "192.168.0.5:8077")
+    assert not is_allowed_websocket_origin("not a url", "localhost")
+
+
+def test_WebSocketのOrigin判定_LAN公開時は同一Hostと明示許可Originだけ許可する(monkeypatch: pytest.MonkeyPatch):
+    monkeypatch.setenv("SPOONFEEDER_HOST", "0.0.0.0")
+    monkeypatch.setenv("SPOONFEEDER_ALLOWED_ORIGINS", "http://dev.example:3000/")
+    assert is_allowed_websocket_origin("http://192.168.0.5:8077", "192.168.0.5:8077")
+    assert not is_allowed_websocket_origin("http://evil.example", "192.168.0.5:8077")
+    assert is_allowed_websocket_origin("http://dev.example:3000", "192.168.0.5:8077")
diff --git a/pytest/mkdocs_support_test.py b/pytest/mkdocs_support_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..86f12916d4375e4824290604b76ce58694178a7c
--- /dev/null
+++ b/pytest/mkdocs_support_test.py
@@ -0,0 +1,419 @@
+"""
+MkDocsドキュメントリポジトリ判定、統合マークダウン＆結合画像出力、リンク先MD自動選択、およびMarkdownパッチ反映の統合テスト。
+
+仕様:
+1. リポジトリ内の mkdocs.yml / mkdocs.yaml を参照し、通常リポジトリか MkDocs ドキュメントリポジトリかを自動判定する。
+2. 選択された Markdown ファイル群から呼び出されている画像をすべて検出し、所属ファイル名・リンク記法のラベル付きで1枚の結合画像（PNG/JPEG）に縦連結し、統合マークダウンファイルと結合画像ファイルの2ファイルに分けて出力する。
+3. 選択中の Markdown ファイルからリンクされている同一リポジトリ内の別 Markdown ファイルを再帰的に自動検出して選択対象に追加する。
+4. AIが出力した Markdown ファイルの修正（内部にコードブロックを含むファイルパス付きコードブロック、`<file_changes>`、または `# ===== [ファイル ...] path =====` 形式）を解析し、差分プレビューと反映を行う。
+"""
+
+from __future__ import annotations
+
+import io
+from pathlib import Path
+
+import pytest
+from fastapi.testclient import TestClient
+from PIL import Image
+
+from backend.main import app
+from backend.mkdocs_support import (
+    build_mkdocs_bundle,
+    detect_mkdocs_config,
+    discover_linked_markdown_files,
+)
+
+
+def _create_mkdocs_sample(base: Path) -> Path:
+    """4文書・5画像のMkDocsサンプルリポジトリを作成する（個人環境のパスに依存しない）。"""
+    repo = base / "mkdocs_sample"
+    (repo / "docs" / "guide").mkdir(parents=True)
+    (repo / "docs" / "spec").mkdir(parents=True)
+    (repo / "mkdocs.yml").write_text("site_name: Sample\ndocs_dir: docs\n", encoding="utf-8")
+    (repo / "docs" / "index.md").write_text("# Index\n\n![システム全体構成図](images/architecture.png)\n", encoding="utf-8")
+    (repo / "docs" / "guide" / "setup.md").write_text("# Setup\n\n![初期設定画面](../images/setup_screen.png)\n", encoding="utf-8")
+    (repo / "docs" / "guide" / "usage.md").write_text(
+        "# Usage\n\n![メインダッシュボード画面](../images/main_dashboard.png)\n\n![エクスポート設定モーダル](../images/export_modal.png)\n",
+        encoding="utf-8",
+    )
+    (repo / "docs" / "spec" / "data_flow.md").write_text("# Flow\n\n![データ連携フロー図](../images/data_flow.png)\n", encoding="utf-8")
+    for name in ("architecture", "setup_screen", "main_dashboard", "export_modal", "data_flow"):
+        _create_sample_png(repo / "docs" / "images" / f"{name}.png", width=3000, height=400)
+    return repo
+
+
+def _create_sample_png(path: Path, width: int = 400, height: int = 200, color: tuple[int, int, int] = (200, 220, 255)) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    img = Image.new("RGB", (width, height), color=color)
+    img.save(path, format="PNG")
+
+
+def test_YAMLファイルからMkDocsリポジトリか通常リポジトリかを正しく判定する(tmp_path: Path) -> None:
+    normal_repo = tmp_path / "normal_repo"
+    normal_repo.mkdir()
+    (normal_repo / "main.py").write_text("print('hello')\n", encoding="utf-8")
+
+    mkdocs_repo = tmp_path / "mkdocs_repo"
+    mkdocs_repo.mkdir()
+    (mkdocs_repo / "mkdocs.yml").write_text(
+        "site_name: テスト設計ドキュメント\ndocs_dir: docs\nnav:\n  - Home: index.md\n",
+        encoding="utf-8",
+    )
+    (mkdocs_repo / "docs").mkdir()
+    (mkdocs_repo / "docs" / "index.md").write_text("# ホーム\n", encoding="utf-8")
+
+    normal_info = detect_mkdocs_config(normal_repo)
+    assert normal_info["is_mkdocs"] is False
+
+    mkdocs_info = detect_mkdocs_config(mkdocs_repo)
+    assert mkdocs_info["is_mkdocs"] is True
+    assert mkdocs_info["config_file"] == "mkdocs.yml"
+    assert mkdocs_info["site_name"] == "テスト設計ドキュメント"
+    assert mkdocs_info["docs_dir"] == "docs"
+
+
+def test_repository_structure_APIがMkDocsリポジトリ判定結果と設定情報を返す(tmp_path: Path) -> None:
+    mkdocs_repo = tmp_path / "mkdocs_repo"
+    (mkdocs_repo / "docs").mkdir(parents=True)
+    (mkdocs_repo / "mkdocs.yaml").write_text(
+        "site_name: API確認ドキュメント\ndocs_dir: docs\n",
+        encoding="utf-8",
+    )
+    (mkdocs_repo / "docs" / "index.md").write_text("# Top\n", encoding="utf-8")
+
+    client = TestClient(app)
+    response = client.post(
+        "/api/repository_structure",
+        json={"library_path": str(mkdocs_repo), "show_ignored": False},
+    )
+
+    assert response.status_code == 200
+    data = response.json()
+    assert data["is_mkdocs_repository"] is True
+    assert data["mkdocs_config"]["site_name"] == "API確認ドキュメント"
+    assert data["mkdocs_config"]["config_file"] == "mkdocs.yaml"
+
+
+def test_選択されたMarkdownからリンクされている別Markdownファイルを再帰的に自動検出する(tmp_path: Path) -> None:
+    repo = tmp_path / "mkdocs_links"
+    (repo / "docs" / "guide").mkdir(parents=True)
+    (repo / "docs" / "spec").mkdir(parents=True)
+    (repo / "mkdocs.yml").write_text("site_name: LinkTest\ndocs_dir: docs\n", encoding="utf-8")
+
+    (repo / "docs" / "index.md").write_text(
+        "# トップ\n詳細は [セットアップ](guide/setup.md) を参照。\n",
+        encoding="utf-8",
+    )
+    (repo / "docs" / "guide" / "setup.md").write_text(
+        "# セットアップ\n次は [データ仕様](../spec/flow.md#section-1) と [トップへ戻る](../index.md) を確認。\n",
+        encoding="utf-8",
+    )
+    (repo / "docs" / "spec" / "flow.md").write_text(
+        "# データ仕様\n本文です。\n",
+        encoding="utf-8",
+    )
+    (repo / "docs" / "unrelated.md").write_text(
+        "# 無関係なページ\n",
+        encoding="utf-8",
+    )
+
+    detected = discover_linked_markdown_files(repo, ["docs/index.md"])
+    assert "docs/guide/setup.md" in detected
+    assert "docs/spec/flow.md" in detected
+    assert "docs/unrelated.md" not in detected
+
+    client = TestClient(app)
+    res = client.post(
+        "/api/auto_select_modules",
+        json={"library_path": str(repo), "selected_files": ["docs/index.md"]},
+    )
+    assert res.status_code == 200
+    body = res.json()
+    assert set(body["selected_files"]) == {"docs/index.md", "docs/guide/setup.md", "docs/spec/flow.md"}
+
+
+def test_MkDocsのMarkdown群から統合マークダウンと結合画像を分けて生成する(tmp_path: Path) -> None:
+    repo = tmp_path / "mkdocs_bundle"
+    (repo / "docs" / "guide").mkdir(parents=True)
+    (repo / "docs" / "images").mkdir(parents=True)
+    (repo / "mkdocs.yml").write_text("site_name: BundleTest\ndocs_dir: docs\n", encoding="utf-8")
+
+    _create_sample_png(repo / "docs" / "images" / "arch.png", width=600, height=240, color=(220, 240, 255))
+    _create_sample_png(repo / "docs" / "images" / "screen.png", width=600, height=300, color=(220, 255, 220))
+
+    (repo / "docs" / "index.md").write_text(
+        "# システム概要\n\n![全体構成図](images/arch.png)\n\n説明テキストです。\n",
+        encoding="utf-8",
+    )
+    (repo / "docs" / "guide" / "usage.md").write_text(
+        "# 使い方\n\n![操作画面](../images/screen.png)\n\n手順の説明です。\n",
+        encoding="utf-8",
+    )
+
+    markdown_text, image_bytes, stats = build_mkdocs_bundle(
+        root=repo,
+        selected_files=["docs/index.md", "docs/guide/usage.md"],
+    )
+
+    assert "![全体構成図](images/arch.png)" in markdown_text
+    assert "![操作画面](../images/screen.png)" in markdown_text
+    assert "docs/index.md" in markdown_text
+    assert "docs/guide/usage.md" in markdown_text
+    assert "<file_changes>" in markdown_text
+    assert image_bytes is not None
+    assert stats["total_documents"] == 2
+    assert stats["total_images"] == 2
+    assert len(stats["images_meta"]) == 2
+    assert stats["images_meta"][0]["doc_path"] == "docs/index.md"
+    assert stats["images_meta"][0]["link_text"] == "![全体構成図](images/arch.png)"
+    assert stats["images_meta"][1]["doc_path"] == "docs/guide/usage.md"
+
+    combined_img = Image.open(io.BytesIO(image_bytes))
+    assert combined_img.height > 240 + 300
+
+
+def test_MkDocsサンプルリポジトリから2ファイルを指定フォルダへ分けて出力できる(tmp_path: Path) -> None:
+    sample_dir = _create_mkdocs_sample(tmp_path)
+    out_dir = tmp_path / "exported_ai_inputs"
+    client = TestClient(app)
+
+    response = client.post(
+        "/api/mkdocs/save_bundle",
+        json={
+            "library_path": str(sample_dir),
+            "selected_files": [
+                "mkdocs.yml",
+                "docs/index.md",
+                "docs/guide/setup.md",
+                "docs/guide/usage.md",
+                "docs/spec/data_flow.md",
+            ],
+            "target_dir": str(out_dir),
+            "file_base_name": "mkdocs_sample_export",
+        },
+    )
+
+    assert response.status_code == 200
+    data = response.json()
+    assert data["status"] == "success"
+    assert data["has_images"] is True
+    assert data["stats"]["total_images"] == 5
+
+    md_path = Path(data["markdown_path"])
+    img_path = Path(data["image_path"])
+    assert md_path.is_file()
+    assert img_path.is_file()
+
+    md_content = md_path.read_text(encoding="utf-8")
+    assert "![システム全体構成図](images/architecture.png)" in md_content
+    assert "![初期設定画面](../images/setup_screen.png)" in md_content
+    assert "![メインダッシュボード画面](../images/main_dashboard.png)" in md_content
+    assert "![エクスポート設定モーダル](../images/export_modal.png)" in md_content
+    assert "![データ連携フロー図](../images/data_flow.png)" in md_content
+
+    combined = Image.open(img_path)
+    assert combined.width >= 2800
+    assert combined.height > 320 * 5
+
+
+def test_MkDocsの保存先フォルダ設定を永続化および取得できる(tmp_path: Path) -> None:
+    client = TestClient(app)
+    custom_dir = str(tmp_path / "custom_ai_export")
+
+    post_res = client.post("/api/mkdocs/export_config", json={"export_folder": custom_dir})
+    assert post_res.status_code == 200
+    assert post_res.json()["export_folder"] == custom_dir
+
+    get_res = client.get("/api/mkdocs/export_config")
+    assert get_res.status_code == 200
+    assert get_res.json()["export_folder"] == custom_dir
+
+
+def test_AIが出力したコードブロック入りのMarkdown変更やファイル境界形式を差分反映できる(tmp_path: Path) -> None:
+    repo = tmp_path / "mkdocs_patch_repo"
+    (repo / "docs" / "guide").mkdir(parents=True)
+    (repo / "mkdocs.yml").write_text("site_name: PatchTest\ndocs_dir: docs\n", encoding="utf-8")
+    target_md = repo / "docs" / "guide" / "setup.md"
+    target_md.write_text(
+        "# セットアップ手順\n\n![初期設定画面](../images/setup_screen.png)\n\n古い説明文です。\n",
+        encoding="utf-8",
+    )
+
+    ai_output = """以下が修正後のドキュメントです。
+
+```markdown path: docs/guide/setup.md
+# セットアップ手順（改訂版）
+
+![初期設定画面](../images/setup_screen.png)
+
+インストールコマンドを実行します：
+
+```bash
+pip install -r requirements.txt
+```
+
+以上の手順で完了です。
+```
+"""
+
+    client = TestClient(app)
+    preview_res = client.post(
+        "/api/patch/preview",
+        json={"library_path": str(repo), "ai_output": ai_output},
+    )
+    assert preview_res.status_code == 200
+    preview_data = preview_res.json()
+    assert preview_data["status"] == "success"
+    assert len(preview_data["changes"]) == 1
+    assert preview_data["changes"][0]["path"] == "docs/guide/setup.md"
+
+    apply_res = client.post(
+        "/api/patch/apply",
+        json={"library_path": str(repo), "ai_output": ai_output},
+    )
+    assert apply_res.status_code == 200
+    assert apply_res.json()["status"] == "success"
+
+    updated_text = target_md.read_text(encoding="utf-8")
+    assert "# セットアップ手順（改訂版）" in updated_text
+    assert "pip install -r requirements.txt" in updated_text
+    assert "以上の手順で完了です。" in updated_text
+    assert "![初期設定画面](../images/setup_screen.png)" in updated_text
+
+
+# ---- 追加: YAML解析 / リンク抽出 / 画像解決 / 画像連結 ------------------------------
+
+from backend.mkdocs_support import (  # noqa: E402
+    _extract_markdown_doc_links,
+    _extract_nav_md_paths,
+    _parse_yaml_safely,
+    build_image_strip,
+    extract_markdown_image_links,
+    flatten_to_rgb,
+    image_bytes_to_data_url,
+    load_pil_image,
+    resolve_mkdocs_image_path,
+    strip_excalidraw_data_section,
+)
+
+
+def test_MkDocs固有のPythonタグを含むYAMLも辞書として解析できる():
+    parsed = _parse_yaml_safely("site_name: S\nmarkdown_extensions:\n  - pymdownx.emoji:\n      emoji_index: !!python/name:material.extensions.emoji.twemoji\nnav:\n  - Home: index.md\n")
+    assert parsed["site_name"] == "S" and parsed["nav"] == [{"Home": "index.md"}]
+
+
+def test_壊れたYAMLでも主要キーを簡易解析で取得する():
+    parsed = _parse_yaml_safely("site_name: 'Broken Site'\ndocs_dir: \"manual\"\nnav:\n  - [unclosed\n")
+    assert (parsed["site_name"], parsed["docs_dir"], parsed["nav"]) == ("Broken Site", "manual", [])
+
+
+def test_mkdocs_yamlでdocs_dirを変更した設定も検出する(tmp_path: Path) -> None:
+    (tmp_path / "mkdocs.yaml").write_text("site_name: Manual\ndocs_dir: manual/\n", encoding="utf-8")
+    info = detect_mkdocs_config(tmp_path)
+    assert (info["is_mkdocs"], info["config_file"], info["docs_dir"], info["site_name"]) == (True, "mkdocs.yaml", "manual", "Manual")
+
+
+def test_mkdocs以外のYAMLだけのリポジトリはMkDocsと判定しない(tmp_path: Path) -> None:
+    (tmp_path / "docker-compose.yml").write_text("services:\n  web:\n    image: nginx\n", encoding="utf-8")
+    assert detect_mkdocs_config(tmp_path)["is_mkdocs"] is False
+
+
+def test_navから入れ子のMarkdownパスだけを抽出する():
+    nav = ["index.md", {"Guide": ["guide/a.md", {"B": "guide/b.md"}, "https://example.com"]}, {"Img": "x.png"}]
+    assert _extract_nav_md_paths(nav) == ["index.md", "guide/a.md", "guide/b.md"]
+
+
+def test_Markdownリンクの抽出はコードブロックと外部リンクを除外する():
+    text = "[a](a.md) [ext](https://e.com) [anc](#x) [mail](mailto:x@y.z) [sp](My%20Doc.md#sec \"t\") [[wiki|alias]] ![img](p.png)\n```\n[code](c.md)\n```\n"
+    assert _extract_markdown_doc_links(text) == ["a.md", "My Doc.md", "wiki"]
+
+
+def test_mkdocs_ymlのnavを起点に未選択のMarkdownも再帰的に検出する(tmp_path: Path) -> None:
+    (tmp_path / "docs" / "sub").mkdir(parents=True)
+    (tmp_path / "mkdocs.yml").write_text("site_name: S\nnav:\n  - Home: index.md\n  - Sub: sub/page.md\n", encoding="utf-8")
+    (tmp_path / "docs" / "index.md").write_text("# Home\n", encoding="utf-8")
+    (tmp_path / "docs" / "sub" / "page.md").write_text("[deep](deep.md) [[wikipage]]\n", encoding="utf-8")
+    (tmp_path / "docs" / "sub" / "deep.md").write_text("# deep\n", encoding="utf-8")
+    (tmp_path / "docs" / "wikipage.md").write_text("# wiki\n", encoding="utf-8")
+    assert discover_linked_markdown_files(tmp_path, ["mkdocs.yml"]) == ["docs/index.md", "docs/sub/deep.md", "docs/sub/page.md", "docs/wikipage.md"]
+
+
+def test_ディレクトリ形式リンクや拡張子省略リンクもindex_mdへ解決する(tmp_path: Path) -> None:
+    (tmp_path / "docs" / "guide").mkdir(parents=True)
+    (tmp_path / "mkdocs.yml").write_text("site_name: S\n", encoding="utf-8")
+    (tmp_path / "docs" / "index.md").write_text("[g](guide/) [s](setup)\n", encoding="utf-8")
+    (tmp_path / "docs" / "guide" / "index.md").write_text("# g\n", encoding="utf-8")
+    (tmp_path / "docs" / "setup.md").write_text("# s\n", encoding="utf-8")
+    assert discover_linked_markdown_files(tmp_path, ["docs/index.md"]) == ["docs/guide/index.md", "docs/setup.md"]
+
+
+def test_画像リンクは4種類の記法を抽出し外部URLは除外する():
+    text = '![a](img/a.png "t") ![[b.png|300]] <img src="c.png" width="10"> [[d.excalidraw]] ![ext](https://e.com/x.png) ![d](data:image/png;base64,AAA)'
+    targets = [target for _, target in extract_markdown_image_links(text)]
+    assert sorted(targets) == ["b.png", "c.png", "d.excalidraw", "img/a.png"]
+
+
+def test_画像パスはURLエンコードとファイル名一致フォールバックでも解決する(tmp_path: Path) -> None:
+    _create_sample_png(tmp_path / "docs" / "images" / "my pic.png")
+    _create_sample_png(tmp_path / "assets" / "deep" / "found.png")
+    doc = tmp_path / "docs" / "index.md"
+    doc.write_text("x", encoding="utf-8")
+    assert resolve_mkdocs_image_path(tmp_path, "docs", doc, "images/my%20pic.png") == (tmp_path / "docs" / "images" / "my pic.png").resolve()
+    assert resolve_mkdocs_image_path(tmp_path, "docs", doc, "/images/my pic.png") == (tmp_path / "docs" / "images" / "my pic.png").resolve()
+    assert resolve_mkdocs_image_path(tmp_path, "docs", doc, "nowhere/found.png") == (tmp_path / "assets" / "deep" / "found.png").resolve()
+    assert resolve_mkdocs_image_path(tmp_path, "docs", doc, "missing.png") is None
+
+
+def test_透過画像は白背景に合成され黒潰れしない():
+    result = flatten_to_rgb(Image.new("RGBA", (4, 4), (0, 0, 0, 0)))
+    assert result.mode == "RGB" and result.getpixel((0, 0)) == (255, 255, 255)
+
+
+def test_壊れた画像やSVG変換器なしでは読み込みをNoneで諦める(tmp_path: Path):
+    broken = tmp_path / "broken.png"
+    broken.write_bytes(b"not an image")
+    svg = tmp_path / "a.svg"
+    svg.write_text("<svg xmlns='http://www.w3.org/2000/svg' width='10' height='10'/>", encoding="utf-8")
+    assert load_pil_image(broken) is None
+    assert load_pil_image(svg) in (None,) or load_pil_image(svg).width > 0  # resvg/cairosvg が入っていれば変換される
+
+
+def test_結合画像は上限を超えるとJPEGへ縮小圧縮して上限内に収める():
+    import random
+
+    random.seed(0)
+    noisy = Image.frombytes("RGB", (1200, 800), random.randbytes(1200 * 800 * 3))
+    items = [{"index": 1, "doc_path": "docs/a.md", "link_text": "![x](x.png)", "image": noisy}]
+    png = build_image_strip(items, max_bytes=100 * 1024 * 1024)
+    assert png.startswith(b"\x89PNG")
+    jpeg = build_image_strip(items, max_bytes=2 * 1024 * 1024)
+    assert jpeg[:2] == b"\xff\xd8" and len(jpeg) <= 2 * 1024 * 1024
+    assert build_image_strip([]) is None
+
+
+def test_上限をどう縮めても収まらない場合は最小スケールのJPEGを返す():
+    items = [{"index": 1, "doc_path": "d.md", "link_text": "l", "image": Image.new("RGB", (900, 300), (10, 20, 30))}]
+    assert build_image_strip(items, max_bytes=1)[:2] == b"\xff\xd8"
+
+
+def test_Excalidraw圧縮データ節は統合マークダウンから除去される():
+    assert strip_excalidraw_data_section("本文\n\n# Excalidraw Data\n\n圧縮JSON...") == "本文"
+    assert strip_excalidraw_data_section("本文のみ") == "本文のみ"
+
+
+def test_結合画像のData_URLはPNGとJPEGと空を区別する():
+    assert image_bytes_to_data_url(None) == ""
+    assert image_bytes_to_data_url(b"\x89PNG\r\n\x1a\nxx").startswith("data:image/png;base64,")
+    assert image_bytes_to_data_url(b"\xff\xd8xx").startswith("data:image/jpeg;base64,")
+
+
+def test_解決できない画像リンクと同一文書内で重複した画像は結合画像に1枚だけ含める(tmp_path: Path) -> None:
+    (tmp_path / "docs").mkdir()
+    (tmp_path / "mkdocs.yml").write_text("site_name: S\n", encoding="utf-8")
+    _create_sample_png(tmp_path / "docs" / "a.png")
+    (tmp_path / "docs" / "index.md").write_text("![a](a.png)\n![again](a.png)\n![missing](none.png)\n", encoding="utf-8")
+    _, image_bytes, stats = build_mkdocs_bundle(tmp_path, ["mkdocs.yml", "docs/index.md"])
+    assert image_bytes is not None
+    assert stats["total_images"] == 1
+    assert stats["images_meta"][0]["link_text"] == "![a](a.png)"
diff --git a/pytest/patch_parser_test.py b/pytest/patch_parser_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..1c18c85b4ca32909a38be0cf9472e35d3ed6cbac
--- /dev/null
+++ b/pytest/patch_parser_test.py
@@ -0,0 +1,77 @@
+"""AI出力の解析(patch_parser)とC#シンボル走査(csharp_symbols)の統合テスト。"""
+
+from __future__ import annotations
+
+import ast
+import time
+
+from backend.csharp_symbols import scan_csharp_symbols
+from backend.patch_parser import _normalize_ai_code, parse_ai_output
+
+
+def test_文字列リテラル内の物理改行はエスケープされる():
+    broken = 'message = "line1\nline2"\n'
+    normalized = _normalize_ai_code(broken)
+    assert normalized == 'message = "line1\\nline2"\n'
+    ast.parse(normalized)
+
+
+def test_docstring内の改行は維持される():
+    code = 'def f():\n    """説明\n    続き"""\n    return 1\n'
+    assert _normalize_ai_code(code) == code
+
+
+def test_コメント内のクォートは文字列開始と誤認しない():
+    code = "# it's a comment\nvalue = 'a\nb'\n"
+    assert _normalize_ai_code(code) == "# it's a comment\nvalue = 'a\\nb'\n"
+
+
+def test_接頭辞付き文字列の物理改行もエスケープされる():
+    assert _normalize_ai_code('x = f"a\nb"\ny = rb"c\nd"\n') == 'x = f"a\\nb"\ny = rb"c\\nd"\n'
+
+
+def test_大きな入力でも数秒以内に正規化できる():
+    code = "".join(f"value_{i} = 'text {i}'\n" for i in range(60000))
+    started = time.monotonic()
+    assert _normalize_ai_code(code) == code
+    assert time.monotonic() - started < 3
+
+
+def test_言語タグなしブロックはPython関数を優先して解釈する():
+    changes = parse_ai_output("```\ndef total(a, b):\n    return a + b\n```")
+    assert [(c.language, c.symbol, c.signature) for c in changes] == [("python", "total", "a,b")]
+
+
+def test_言語タグなしブロックはPythonに該当しなければC_メソッドを解釈する():
+    changes = parse_ai_output("```\npublic int Add(int a, int b) { return a + b; }\n```")
+    assert [(c.language, c.symbol) for c in changes] == [("csharp", "Add")]
+
+
+def test_パス付きブロックでシンボルがなければファイル全文置換になる():
+    changes = parse_ai_output("```json path: config/app.json\n{\"a\": 1}\n```")
+    assert (changes[0].path, changes[0].symbol, changes[0].action) == ("config/app.json", "", "modify")
+
+
+def test_Markdownブロック内のネストしたコードフェンスを含めて全文を取得する():
+    output = "```markdown path: docs/guide.md\n# 手順\n```bash\nls\n```\n終わり\n```\n"
+    changes = parse_ai_output(output)
+    assert changes[0].path == "docs/guide.md"
+    assert changes[0].content == "# 手順\n```bash\nls\n```\n終わり\n"
+
+
+def test_統合マークダウン見出し形式を複数ファイルに分割する():
+    output = "# ===== [ファイル 1/2] docs/a.md =====\nA\n# ===== [ファイル 2/2] docs/b.md =====\nB\n"
+    assert [(c.path, c.content) for c in parse_ai_output(output)] == [("docs/a.md", "A\n"), ("docs/b.md", "B\n")]
+
+
+def test_C_シンボル走査は文字列とコメント中の波括弧を無視する():
+    source = 'public class A { string s = "}"; // }\n void M() { } }\npublic static int Free(int x) { return x; }\n'
+    symbols = {symbol.name: source[symbol.start:symbol.end] for symbol in scan_csharp_symbols(source)}
+    assert symbols["A"].endswith("void M() { } }")
+    assert symbols["Free"] == "public static int Free(int x) { return x; }"
+
+
+def test_C_シンボル走査は式形式メンバーを検出して引数の空白を正規化する():
+    source = "public int Twice(int   x,\n int y) => x * 2;\n"
+    (symbol,) = scan_csharp_symbols(source)
+    assert (symbol.name, symbol.signature) == ("Twice", "int x, int y")
diff --git a/pytest/patch_test.py b/pytest/patch_test.py
index e9f86701f3397f31751ecb6666a5cd556d77e607..942dd6803e336af4a9ef5120c135b39761b0d91f 100644
--- a/pytest/patch_test.py
+++ b/pytest/patch_test.py
@@ -414,3 +414,14 @@ def test_同名関数がファイル内に複数存在する場合でも重複
 
 
 
+
+
+def test_リポジトリ名と同名のサブフォルダ配下のファイルを正しく解決する(tmp_path: Path):
+    repo = tmp_path / "myapp"
+    (repo / "myapp").mkdir(parents=True)
+    (repo / "myapp" / "utils.py").write_text("VALUE = 1\n", encoding="utf-8")
+    (repo / "utils.py").write_text("VALUE = 0\n", encoding="utf-8")
+    preview = prepare_preview(repo, "```python path: myapp/utils.py\nVALUE = 2\n```")
+    apply_preview(repo, preview)
+    assert (repo / "myapp" / "utils.py").read_text(encoding="utf-8") == "VALUE = 2\n"
+    assert (repo / "utils.py").read_text(encoding="utf-8") == "VALUE = 0\n"
diff --git a/pytest/reference_test.py b/pytest/reference_test.py
index 8a778e7bb22ce4e0f76d586e41273e9f96746cc6..5f084b845c70fbd730df324f73534c537809d1cd 100644
--- a/pytest/reference_test.py
+++ b/pytest/reference_test.py
@@ -166,3 +166,15 @@ def test_会社チャット向けのコード出力契約をコンテキスト
         "reference_repositoriesは読み取り専用",
         "<response_reminder>",
     ))
+
+
+def test_envフォルダのPythonも仮想環境として検出する(tmp_path):
+    import os
+    from backend.references import _python_executable
+
+    executable_dir = "Scripts" if os.name == "nt" else "bin"
+    executable_name = "python.exe" if os.name == "nt" else "python"
+    target = tmp_path / "env" / executable_dir / executable_name
+    target.parent.mkdir(parents=True)
+    target.write_text("", encoding="utf-8")
+    assert _python_executable(tmp_path) == target
diff --git a/pytest/repository_test.py b/pytest/repository_test.py
index a49fd9fcedbc4566cc331f8e6eaf6c9285f230fd..182bf631e0d0d22cbd6bacb3fa98edaf136c03ef 100644
--- a/pytest/repository_test.py
+++ b/pytest/repository_test.py
@@ -90,3 +90,28 @@ def test_リポジトリ履歴削除API(repository: Path):
     # 削除されていることを確認
     repos_after = client.get("/api/repositories").json()["repositories"]
     assert str(repository) not in repos_after
+
+
+def test_壊れた設定ファイルは退避され履歴が上書き消失しない(tmp_path: Path, monkeypatch: pytest.MonkeyPatch):
+    settings_file = tmp_path / "broken_configs.json"
+    broken = '{"repositories": {"/keep/me": {"selected_files": ["a.py"]}}, '  # 途中で切れたJSON
+    settings_file.write_text(broken, encoding="utf-8")
+    monkeypatch.setenv("SPOONFEEDER_CONFIGS_FILE", str(settings_file))
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    client.post("/api/save_settings", json={"library_path": str(repo), "selected_files": []})
+    backups = list(tmp_path.glob("broken_configs.json.corrupt*"))
+    assert len(backups) == 1
+    assert backups[0].read_text(encoding="utf-8") == broken
+
+
+@pytest.mark.skipif(os.name == "nt", reason="POSIXのsleepとプロセスグループで確認するテストです")
+def test_テスト実行は孫プロセスが残ってもタイムアウトで戻る(tmp_path: Path):
+    import time
+
+    started = time.monotonic()
+    response = client.post("/api/test", json={
+        "library_path": str(tmp_path), "test_command": "sleep 20 & sleep 20", "timeout_sec": 1,
+    })
+    assert time.monotonic() - started < 8
+    assert response.json()["status"] == "failed"
diff --git a/pytest/security_test.py b/pytest/security_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..2bed1709b6fc0369b1b7723a7af56951d4b8f06f
--- /dev/null
+++ b/pytest/security_test.py
@@ -0,0 +1,129 @@
+"""
+セキュリティ関連の統合テスト (security_test.py)
+
+仕様:
+1. /api/git_diff はシェルを経由せず、読み取り専用のgitサブコマンドだけを実行する（コマンド注入の防止）。
+2. ターミナルWebSocketは、別オリジンのWebページ（CSWSH）からの接続を拒否する。
+3. 起動スクリプトの既定待受アドレスはローカルホスト(127.0.0.1)である。
+"""
+
+from __future__ import annotations
+
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+from fastapi.testclient import TestClient
+from starlette.websockets import WebSocketDisconnect
+
+os.environ.setdefault("SPOONFEEDER_CONFIGS_FILE", str(Path(__file__).parent / ".test_configs.json"))
+
+from backend.main import app  # noqa: E402
+
+client = TestClient(app)
+GIT_AVAILABLE = shutil.which("git") is not None
+ROOT = Path(__file__).resolve().parents[1]
+
+
+@pytest.fixture
+def git_repo(tmp_path: Path) -> Path:
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    (repo / "main.py").write_text("print('a')\n", encoding="utf-8")
+    subprocess.run(["git", "init", "-q", str(repo)], check=True, capture_output=True)
+    subprocess.run(["git", "-C", str(repo), "config", "user.name", "Tester"], check=True, capture_output=True)
+    subprocess.run(["git", "-C", str(repo), "config", "user.email", "t@example.com"], check=True, capture_output=True)
+    subprocess.run(["git", "-C", str(repo), "add", "."], check=True, capture_output=True)
+    subprocess.run(["git", "-C", str(repo), "commit", "-q", "-m", "init"], check=True, capture_output=True)
+    return repo
+
+
+@pytest.mark.skipif(not GIT_AVAILABLE, reason="gitコマンドが必要です")
+@pytest.mark.skipif(os.name == "nt", reason="touchコマンドを使うPOSIX専用テストです")
+@pytest.mark.parametrize("suffix", ["; touch {marker}", "&& touch {marker}", "| touch {marker}", "$(touch {marker})", "`touch {marker}`"])
+def test_git差分コマンドにシェル構文を混ぜても実行されない(git_repo: Path, tmp_path: Path, suffix: str):
+    marker = tmp_path / "injected.txt"
+    command = "git status " + suffix.format(marker=marker)
+    client.post("/api/git_diff", json={"library_path": str(git_repo), "command": command})
+    assert not marker.exists()
+
+
+@pytest.mark.skipif(not GIT_AVAILABLE, reason="gitコマンドが必要です")
+def test_git差分コマンドの出力先オプションはファイルを書かずに拒否される(git_repo: Path, tmp_path: Path):
+    marker = tmp_path / "written.patch"
+    (git_repo / "main.py").write_text("print('b')\n", encoding="utf-8")
+    response = client.post("/api/git_diff", json={"library_path": str(git_repo), "command": f"git diff --output={marker}"})
+    assert response.status_code == 400
+    assert not marker.exists()
+
+
+@pytest.mark.skipif(not GIT_AVAILABLE, reason="gitコマンドが必要です")
+@pytest.mark.parametrize("command", ["git commit -am x", "git push", "git -c core.pager=sh log", "git checkout ."])
+def test_読み取り専用以外のgitサブコマンドは拒否される(git_repo: Path, command: str):
+    response = client.post("/api/git_diff", json={"library_path": str(git_repo), "command": command})
+    assert response.status_code == 400
+
+
+@pytest.mark.skipif(not GIT_AVAILABLE, reason="gitコマンドが必要です")
+def test_引用符付きのパス指定も従来どおり使える(git_repo: Path):
+    (git_repo / "main.py").write_text("print('b')\n", encoding="utf-8")
+    response = client.post("/api/git_diff", json={"library_path": str(git_repo), "command": 'git diff HEAD -- "*.py"'})
+    assert response.status_code == 200
+    assert "+print('b')" in response.json()["diff"]
+
+
+def test_別オリジンからのターミナル接続は拒否される(tmp_path: Path):
+    with pytest.raises(WebSocketDisconnect):
+        with client.websocket_connect(f"/api/terminal/ws?cwd={tmp_path}", headers={"origin": "http://evil.example"}) as ws:
+            ws.receive_json()
+
+
+@pytest.mark.skipif(os.name == "nt", reason="POSIX PTYで確認するテストです")
+@pytest.mark.parametrize("origin", ["http://localhost:8077", "http://127.0.0.1:8077", None])
+def test_ローカルオリジンまたはOriginなしのターミナル接続は許可される(tmp_path: Path, origin: str | None):
+    headers = {"origin": origin} if origin else {}
+    with client.websocket_connect(f"/api/terminal/ws?cwd={tmp_path}", headers=headers) as ws:
+        assert ws.receive_json()["type"] == "ready"
+
+
+@pytest.mark.parametrize("script", ["start.sh", "start.bat"])
+def test_起動スクリプトの既定待受アドレスはローカルホスト(script: str):
+    text = (ROOT / script).read_text(encoding="utf-8")
+    assert "127.0.0.1" in text
+    assert "0.0.0.0" not in text
+
+
+# ---- DNSリバインディング対策(Hostヘッダー検証) -----------------------------
+
+@pytest.mark.parametrize("host", ["localhost:8077", "127.0.0.1:8077", "[::1]:8077", "localhost"])
+def test_ローカルホストのHostヘッダーのAPI呼び出しは許可される(host: str):
+    assert client.get("/api/health", headers={"host": host}).status_code == 200
+
+
+@pytest.mark.parametrize("host", ["attacker.example:8077", "evil.example", "127.0.0.1.evil.example"])
+def test_ローカルホスト以外のHostヘッダーのAPI呼び出しは拒否される(host: str):
+    assert client.get("/api/health", headers={"host": host}).status_code == 403
+
+
+def test_リバインディングされたHostでは変更系APIも実行されない(tmp_path: Path):
+    response = client.post("/api/test", headers={"host": "attacker.example:8077"}, json={"library_path": str(tmp_path), "test_command": "touch pwned"})
+    assert response.status_code == 403
+    assert not (tmp_path / "pwned").exists()
+
+
+def test_別Hostのままターミナルへ接続しても拒否される(tmp_path: Path):
+    with pytest.raises(WebSocketDisconnect):
+        with client.websocket_connect(f"/api/terminal/ws?cwd={tmp_path}", headers={"host": "attacker.example:8077"}) as ws:
+            ws.receive_json()
+
+
+def test_SPOONFEEDER_ALLOWED_HOSTSに列挙したHostは許可される(monkeypatch: pytest.MonkeyPatch):
+    monkeypatch.setenv("SPOONFEEDER_ALLOWED_HOSTS", "testserver, dev.example")
+    assert client.get("/api/health", headers={"host": "dev.example:8077"}).status_code == 200
+
+
+def test_LAN公開を明示した場合は任意のHostを許可する(monkeypatch: pytest.MonkeyPatch):
+    monkeypatch.setenv("SPOONFEEDER_HOST", "0.0.0.0")
+    assert client.get("/api/health", headers={"host": "192.168.0.5:8077"}).status_code == 200
