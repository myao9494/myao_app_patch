diff --git a/backend/api/deps.py b/backend/api/deps.py
new file mode 100644
index 0000000000000000000000000000000000000000..b4b8b3a52cce04be514c143bc58e4d32488aaa02
--- /dev/null
+++ b/backend/api/deps.py
@@ -0,0 +1,14 @@
+"""APIルーター共通の入力検証 (deps.py)"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from fastapi import HTTPException
+
+
+def repository_root(value: str) -> Path:
+    path = Path(value).expanduser().resolve()
+    if not path.is_dir():
+        raise HTTPException(status_code=400, detail=f"フォルダが存在しません: {value}")
+    return path
diff --git a/backend/api/ignore.py b/backend/api/ignore.py
new file mode 100644
index 0000000000000000000000000000000000000000..b87017bd1f74a0c2b80d38a748fa3e14ecf5fcae
--- /dev/null
+++ b/backend/api/ignore.py
@@ -0,0 +1,64 @@
+"""無視リスト(.spoonfeeder.json)の取得・保存・削除API (ignore.py)"""
+
+from __future__ import annotations
+
+from fastapi import APIRouter, HTTPException
+
+from ..repository import load_ignore_patterns, match_ignore_patterns, save_ignore_patterns
+from .deps import repository_root
+from .schemas import IgnorePatternRemoveRequest, IgnorePatternsRequest, RepositoryRequest
+
+router = APIRouter()
+
+
+def normalize_ignore_patterns(patterns: list[str]) -> list[str]:
+    normalized: list[str] = []
+    for raw in patterns:
+        pattern = str(raw).replace("\\", "/").strip()
+        if pattern.startswith("!"):
+            pattern = "!" + pattern[1:].strip("/")
+        else:
+            pattern = pattern.strip("/")
+        if pattern and pattern not in normalized:
+            normalized.append(pattern)
+    return normalized
+
+
+@router.post("/ignore_patterns")
+def ignore_patterns(request: RepositoryRequest) -> dict:
+    root = repository_root(request.library_path)
+    patterns, config_file = load_ignore_patterns(root)
+    return {"patterns": patterns, "config_file": config_file}
+
+
+@router.post("/save_ignore_patterns")
+def save_repository_ignore_patterns(request: IgnorePatternsRequest) -> dict:
+    root = repository_root(request.library_path)
+    patterns = normalize_ignore_patterns(request.patterns)
+    try:
+        config_file = save_ignore_patterns(root, patterns)
+    except OSError as exc:
+        raise HTTPException(status_code=500, detail=f"無視リストを保存できませんでした: {exc}") from exc
+    return {"status": "success", "patterns": patterns, "config_file": config_file}
+
+
+@router.post("/remove_ignore_pattern")
+def remove_repository_ignore_pattern(request: IgnorePatternRemoveRequest) -> dict:
+    root = repository_root(request.library_path)
+    target = request.path.replace("\\", "/").strip("/")
+    if not target:
+        raise HTTPException(status_code=400, detail="除外するパスが指定されていません。")
+    patterns, config_file = load_ignore_patterns(root)
+    matching = [pattern for pattern in patterns if match_ignore_patterns(target, [pattern])[0]]
+    if target in patterns:
+        removed_pattern = target
+    elif len(matching) == 1:
+        removed_pattern = matching[0]
+    else:
+        return {"status": "unchanged", "patterns": patterns, "config_file": config_file, "message": "このパスは無視リストに登録されていません。Gitのignore設定はここから変更できません。"}
+    patterns = [pattern for pattern in patterns if pattern != removed_pattern]
+    try:
+        config_file = save_ignore_patterns(root, patterns)
+    except OSError as exc:
+        raise HTTPException(status_code=500, detail=f"無視リストを保存できませんでした: {exc}") from exc
+    return {"status": "success", "patterns": patterns, "config_file": config_file}
diff --git a/backend/api/mkdocs.py b/backend/api/mkdocs.py
new file mode 100644
index 0000000000000000000000000000000000000000..21284c392717af41df6b0a03c8994937ade6e016
--- /dev/null
+++ b/backend/api/mkdocs.py
@@ -0,0 +1,114 @@
+"""MkDocs統合マークダウン＋結合画像の生成・保存・フォルダ表示API (mkdocs.py)"""
+
+from __future__ import annotations
+
+import os
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+from fastapi import APIRouter, HTTPException
+
+from ..mkdocs_support import build_mkdocs_bundle, image_bytes_to_data_url
+from ..settings_store import get_settings_file, load_settings, remember_repository, settings_transaction
+from .deps import repository_root
+from .schemas import DEFAULT_MKDOCS_EXPORT_FOLDER, MkDocsBundleRequest, MkDocsExportConfigRequest
+
+router = APIRouter(prefix="/mkdocs")
+
+
+def _get_export_folder() -> str:
+    ui_config = load_settings(get_settings_file()).get("ui", {})
+    if isinstance(ui_config, dict):
+        folder = str(ui_config.get("mkdocs_export_folder") or "").strip()
+        if folder:
+            return folder
+    return DEFAULT_MKDOCS_EXPORT_FOLDER
+
+
+def _open_in_file_manager(folder: Path) -> None:
+    if sys.platform == "darwin":
+        subprocess.Popen(["open", str(folder)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    elif os.name == "nt":
+        os.startfile(str(folder))  # type: ignore[attr-defined]
+    else:
+        subprocess.Popen(["xdg-open", str(folder)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+
+
+@router.get("/export_config")
+def get_export_config() -> dict:
+    return {"export_folder": _get_export_folder()}
+
+
+@router.post("/export_config")
+def save_export_config(request: MkDocsExportConfigRequest) -> dict:
+    folder = request.export_folder.strip() or DEFAULT_MKDOCS_EXPORT_FOLDER
+    with settings_transaction() as settings:
+        settings.setdefault("ui", {})["mkdocs_export_folder"] = folder
+    return {"status": "success", "export_folder": folder}
+
+
+def _build_bundle(request: MkDocsBundleRequest):
+    root = repository_root(request.library_path)
+    markdown_text, image_bytes, stats = build_mkdocs_bundle(root=root, selected_files=request.selected_files, title=request.title)
+    remember_repository(root, selected_files=request.selected_files or [])
+    return root, markdown_text, image_bytes or None, stats
+
+
+@router.post("/context")
+def mkdocs_context(request: MkDocsBundleRequest) -> dict:
+    _, markdown_text, image_bytes, stats = _build_bundle(request)
+    return {
+        "context": markdown_text,
+        "has_images": image_bytes is not None,
+        "image_data_url": image_bytes_to_data_url(image_bytes),
+        "stats": stats,
+    }
+
+
+@router.post("/save_bundle")
+def save_bundle(request: MkDocsBundleRequest) -> dict:
+    root, markdown_text, image_bytes, stats = _build_bundle(request)
+
+    save_dir = Path(request.target_dir.strip() or _get_export_folder()).expanduser().resolve()
+    save_dir.mkdir(parents=True, exist_ok=True)
+
+    raw_base = request.file_base_name.strip() or stats.get("site_name") or root.name or "MkDocs_Context"
+    base_name = re.sub(r'[\\/:*?"<>|]', "_", raw_base).strip()
+    if base_name.lower().endswith(".md"):
+        base_name = base_name[:-3]
+
+    md_file = save_dir / f"{base_name}_context.md"
+    md_file.write_text(markdown_text, encoding="utf-8")
+
+    image_path = image_name = None
+    if image_bytes is not None:
+        extension = ".png" if image_bytes.startswith(b"\x89PNG\r\n\x1a\n") else ".jpg"
+        image_file = save_dir / f"{base_name}_images{extension}"
+        image_file.write_bytes(image_bytes)
+        image_path, image_name = str(image_file.resolve()), image_file.name
+
+    return {
+        "status": "success",
+        "folder_path": str(save_dir),
+        "markdown_path": str(md_file.resolve()),
+        "markdown_name": md_file.name,
+        "image_path": image_path,
+        "image_name": image_name,
+        "has_images": image_bytes is not None,
+        "context": markdown_text,
+        "image_data_url": image_bytes_to_data_url(image_bytes),
+        "stats": stats,
+    }
+
+
+@router.post("/open_folder")
+def open_export_folder(request: MkDocsExportConfigRequest) -> dict:
+    folder = Path(request.export_folder.strip() or _get_export_folder()).expanduser().resolve()
+    folder.mkdir(parents=True, exist_ok=True)
+    try:
+        _open_in_file_manager(folder)
+    except OSError as exc:
+        raise HTTPException(status_code=500, detail=f"フォルダを開けませんでした: {exc}") from exc
+    return {"status": "success", "opened_path": str(folder)}
diff --git a/backend/api/patch.py b/backend/api/patch.py
new file mode 100644
index 0000000000000000000000000000000000000000..015c63a53811518ca6d1a4de531928f35167a904
--- /dev/null
+++ b/backend/api/patch.py
@@ -0,0 +1,27 @@
+"""AI出力の差分プレビューと反映API (patch.py)"""
+
+from __future__ import annotations
+
+from fastapi import APIRouter
+
+from ..external_roots import get_external_roots
+from ..patcher import apply_preview, prepare_preview
+from .deps import repository_root
+from .schemas import PatchRequest
+
+router = APIRouter()
+
+
+@router.post("/patch/preview")
+def patch_preview(request: PatchRequest) -> dict:
+    root = repository_root(request.library_path)
+    extra_roots = get_external_roots(root)
+    return prepare_preview(root, request.ai_output, request.overrides, request.target_path, extra_roots=extra_roots)
+
+
+@router.post("/patch/apply")
+def patch_apply(request: PatchRequest) -> dict:
+    root = repository_root(request.library_path)
+    extra_roots = get_external_roots(root)
+    preview = prepare_preview(root, request.ai_output, request.overrides, request.target_path, extra_roots=extra_roots)
+    return apply_preview(root, preview, extra_roots=extra_roots)
diff --git a/backend/api/references.py b/backend/api/references.py
new file mode 100644
index 0000000000000000000000000000000000000000..3e0956b744f98c4fdc7cb20a72ec677cc5de8d53
--- /dev/null
+++ b/backend/api/references.py
@@ -0,0 +1,60 @@
+"""参照リポジトリ解析と手動対応付けAPI (references.py)"""
+
+from __future__ import annotations
+
+import subprocess
+
+from fastapi import APIRouter, HTTPException
+
+from ..references import discover_reference_modules
+from ..settings_store import get_settings_file, load_settings, manual_references, settings_transaction
+from .deps import repository_root
+from .schemas import ReferenceMappingRequest, ReferenceRequest
+
+router = APIRouter()
+
+
+@router.post("/reference_modules")
+def reference_modules(request: ReferenceRequest) -> dict:
+    root = repository_root(request.library_path)
+    references = manual_references(load_settings(get_settings_file()), root)
+    try:
+        return discover_reference_modules(root, request.selected_files, request.python_mode, references)
+    except (OSError, subprocess.SubprocessError) as exc:
+        # Optional discovery must not block the main repository workflow.
+        return {
+            "enabled": request.python_mode != "embedded",
+            "repositories": [],
+            "unresolved": [],
+            "manual_references": references,
+            "warnings": [f"参照リポジトリを自動解析できませんでした: {exc}"],
+        }
+
+
+def _manual_reference_map(settings: dict, root_key: str) -> dict:
+    config = settings.setdefault("repositories", {}).setdefault(root_key, {})
+    if not isinstance(config.get("manual_references"), dict):
+        config["manual_references"] = {}
+    return config["manual_references"]
+
+
+@router.post("/save_reference_mapping")
+def save_reference_mapping(request: ReferenceMappingRequest) -> dict:
+    root = repository_root(request.library_path)
+    reference_root = repository_root(request.repository_path)
+    module = request.module.strip()
+    if not module:
+        raise HTTPException(status_code=400, detail="未解決モジュールが指定されていません。")
+    if reference_root == root:
+        raise HTTPException(status_code=400, detail="メインリポジトリは参照先に指定できません。")
+    with settings_transaction() as settings:
+        _manual_reference_map(settings, str(root))[module] = str(reference_root)
+    return {"status": "success", "module": module, "repository_path": str(reference_root)}
+
+
+@router.post("/remove_reference_mapping")
+def remove_reference_mapping(request: ReferenceMappingRequest) -> dict:
+    root = repository_root(request.library_path)
+    with settings_transaction() as settings:
+        _manual_reference_map(settings, str(root)).pop(request.module.strip(), None)
+    return {"status": "success"}
diff --git a/backend/api/repositories.py b/backend/api/repositories.py
new file mode 100644
index 0000000000000000000000000000000000000000..f9b7a49e92fa98ef75e4fc935f42e5494bcfe67b
--- /dev/null
+++ b/backend/api/repositories.py
@@ -0,0 +1,108 @@
+"""リポジトリ一覧・ツリー・コンテキスト・ファイル内容・依存関係に関するAPI (repositories.py)"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from fastapi import APIRouter, HTTPException
+
+from ..analysis import build_dependency_map
+from ..mkdocs_support import detect_mkdocs_config, discover_linked_markdown_files
+from ..references import discover_internal_modules
+from ..repository import (
+    build_context,
+    entries_to_tree,
+    list_repository_entries,
+    load_legacy_ignore_config,
+    read_context_file,
+)
+from ..settings_store import get_settings_file, load_settings, remember_repository, repository_config, settings_transaction
+from .deps import repository_root
+from .schemas import AutoSelectRequest, ContextRequest, FileRequest, RepositoryRequest, SettingsRequest
+
+router = APIRouter()
+
+
+@router.get("/health")
+def health() -> dict:
+    return {"status": "ok"}
+
+
+@router.get("/repositories")
+def repositories() -> dict:
+    settings = load_settings(get_settings_file())
+    paths = [path for path in settings.get("repositories", {}) if Path(path).is_dir()]
+    return {"repositories": sorted(paths)}
+
+
+@router.post("/remove_repository")
+def remove_repository(request: RepositoryRequest) -> dict:
+    root = repository_root(request.library_path)
+    with settings_transaction() as settings:
+        settings.setdefault("repositories", {}).pop(str(root), None)
+    return {"status": "success", "removed": str(root)}
+
+
+@router.post("/repository_structure")
+def repository_structure(request: RepositoryRequest) -> dict:
+    root = repository_root(request.library_path)
+    try:
+        entries, git_repo = list_repository_entries(root, request.show_ignored)
+    except RuntimeError as exc:
+        raise HTTPException(status_code=500, detail=str(exc)) from exc
+    config = repository_config(load_settings(get_settings_file()), root)
+    legacy_config = load_legacy_ignore_config(root)
+    mkdocs_info = detect_mkdocs_config(root)
+    remember_repository(root, show_ignored=request.show_ignored)
+    return {
+        "files": entries_to_tree(entries),
+        "selected_files": config.get("selected_files") or legacy_config.get("selected_files", []),
+        "is_git_repository": git_repo,
+        "git_root": str(root) if git_repo else "",
+        "is_mkdocs_repository": mkdocs_info["is_mkdocs"],
+        "mkdocs_config": mkdocs_info,
+    }
+
+
+@router.post("/repository_context")
+def repository_context(request: ContextRequest) -> dict:
+    root = repository_root(request.library_path)
+    context, file_count, reference_file_count = build_context(root, request.selected_files, request.reference_files)
+    remember_repository(root, selected_files=request.selected_files or [])
+    return {"context": context, "file_count": file_count, "reference_file_count": reference_file_count}
+
+
+@router.post("/save_settings")
+def save_repository_settings(request: SettingsRequest) -> dict:
+    root = repository_root(request.library_path)
+    remember_repository(root, request.selected_files, request.show_ignored)
+    return {"status": "success"}
+
+
+@router.post("/file_content")
+def file_content(request: FileRequest) -> dict:
+    root = repository_root(request.library_path)
+    try:
+        content = read_context_file(root, request.file_path)
+        target = (root / request.file_path.replace("\\", "/")).resolve()
+        return {"content": content, "size": target.stat().st_size}
+    except ValueError as exc:
+        raise HTTPException(status_code=400, detail=str(exc)) from exc
+    except OSError as exc:
+        raise HTTPException(status_code=404, detail=f"ファイルを読み込めませんでした: {exc}") from exc
+
+
+@router.post("/dependency_map")
+def dependency_map(request: RepositoryRequest) -> dict:
+    return build_dependency_map(repository_root(request.library_path))
+
+
+@router.post("/auto_select_modules")
+def auto_select_modules(request: AutoSelectRequest) -> dict:
+    root = repository_root(request.library_path)
+    detected = sorted(set(discover_internal_modules(root, request.selected_files)) | set(discover_linked_markdown_files(root, request.selected_files)))
+    already_selected = set(request.selected_files)
+    return {
+        "selected_files": sorted(already_selected | set(detected)),
+        "added_files": [path for path in detected if path not in already_selected],
+    }
diff --git a/backend/api/schemas.py b/backend/api/schemas.py
new file mode 100644
index 0000000000000000000000000000000000000000..b67d3e833f218aacc0828789f6740cef941a8949
--- /dev/null
+++ b/backend/api/schemas.py
@@ -0,0 +1,103 @@
+"""APIリクエストのPydanticモデル定義 (schemas.py)"""
+
+from __future__ import annotations
+
+from typing import Optional
+
+from pydantic import BaseModel, Field
+
+from ..security import DEFAULT_GIT_DIFF_COMMAND
+
+DEFAULT_MKDOCS_EXPORT_FOLDER = "~/Desktop/AI_Inputs"
+
+
+class RepositoryRequest(BaseModel):
+    library_path: str
+    show_ignored: bool = False
+
+
+class ContextRequest(BaseModel):
+    library_path: str
+    selected_files: Optional[list[str]] = None
+    reference_files: list[dict] = Field(default_factory=list)
+
+
+class ReferenceRequest(BaseModel):
+    library_path: str
+    selected_files: list[str] = Field(default_factory=list)
+    python_mode: str = "normal"
+
+
+class ReferenceMappingRequest(BaseModel):
+    library_path: str
+    module: str
+    repository_path: str
+
+
+class SettingsRequest(BaseModel):
+    library_path: str
+    selected_files: list[str] = Field(default_factory=list)
+    show_ignored: bool = False
+
+
+class IgnorePatternsRequest(BaseModel):
+    library_path: str
+    patterns: list[str] = Field(default_factory=list)
+
+
+class IgnorePatternRemoveRequest(BaseModel):
+    library_path: str
+    path: str
+
+
+class FileRequest(BaseModel):
+    library_path: str
+    file_path: str
+
+
+class PatchRequest(BaseModel):
+    library_path: str
+    ai_output: str
+    target_path: str = ""
+    overrides: dict[str, str] = Field(default_factory=dict)
+
+
+class RunTestRequest(BaseModel):
+    library_path: str
+    test_command: str = "python -m pytest"
+    python_mode: str = "normal"
+    embedded_python_dir: str = ""
+    timeout_sec: int = Field(default=300, ge=1, le=3600)
+
+
+class FeedbackRequest(BaseModel):
+    library_path: str
+    test_command: str
+    output: str
+    exit_code: Optional[int] = None
+
+
+class OpenRequest(BaseModel):
+    library_path: str
+
+
+class GitDiffRequest(BaseModel):
+    library_path: str
+    command: str = DEFAULT_GIT_DIFF_COMMAND
+
+
+class AutoSelectRequest(BaseModel):
+    library_path: str
+    selected_files: list[str] = Field(default_factory=list)
+
+
+class MkDocsExportConfigRequest(BaseModel):
+    export_folder: str = DEFAULT_MKDOCS_EXPORT_FOLDER
+
+
+class MkDocsBundleRequest(BaseModel):
+    library_path: str
+    selected_files: Optional[list[str]] = None
+    target_dir: str = ""
+    file_base_name: str = ""
+    title: str = ""
diff --git a/backend/api/tools.py b/backend/api/tools.py
new file mode 100644
index 0000000000000000000000000000000000000000..eddd3dcb5d83e9b4fcf4fbab71066f8139dacf93
--- /dev/null
+++ b/backend/api/tools.py
@@ -0,0 +1,103 @@
+"""テスト実行・テスト結果のフィードバック・Git操作・エディタ起動API (tools.py)"""
+
+from __future__ import annotations
+
+import shutil
+import subprocess
+import sys
+from html import escape as html_escape
+from pathlib import Path
+
+from fastapi import APIRouter, HTTPException
+
+from ..repository import decode_process_output, is_git_repository
+from ..runner import resolve_test_command, run_shell_command
+from ..security import DEFAULT_GIT_DIFF_COMMAND, UnsafeCommandError, parse_git_command
+from ..terminal import build_environment
+from .deps import repository_root
+from .schemas import FeedbackRequest, GitDiffRequest, OpenRequest, RunTestRequest
+
+router = APIRouter()
+
+
+@router.post("/test")
+def run_test(request: RunTestRequest) -> dict:
+    root = repository_root(request.library_path)
+    resolved_command = resolve_test_command(root, request.test_command, request.python_mode, request.embedded_python_dir)
+    env = build_environment(root, request.python_mode, request.embedded_python_dir)
+    exit_code, stdout, stderr = run_shell_command(resolved_command, root, env, request.timeout_sec)
+    if exit_code is None:
+        return {
+            "status": "failed", "exit_code": None,
+            "stdout": decode_process_output(stdout), "stderr": f"テストが{request.timeout_sec}秒でタイムアウトしました。",
+            "resolved_command": resolved_command,
+        }
+    return {
+        "status": "success" if exit_code == 0 else "failed",
+        "exit_code": exit_code,
+        "stdout": decode_process_output(stdout),
+        "stderr": decode_process_output(stderr),
+        "resolved_command": resolved_command,
+    }
+
+
+@router.post("/feedback_context")
+def feedback_context(request: FeedbackRequest) -> dict:
+    root = repository_root(request.library_path)
+    safe_output = request.output.replace("]]>", "]]]]><![CDATA[>")
+    context = f"""<test_feedback>
+<repository>{html_escape(str(root))}</repository>
+<test_command>{html_escape(request.test_command)}</test_command>
+<exit_code>{request.exit_code}</exit_code>
+<test_output><![CDATA[
+{safe_output}
+]]></test_output>
+<request>上記の失敗原因を特定し、必要最小限の修正を行ってください。</request>
+</test_feedback>"""
+    return {"context": context}
+
+
+@router.post("/git_diff")
+def git_diff(request: GitDiffRequest) -> dict:
+    root = repository_root(request.library_path)
+    if not is_git_repository(root):
+        raise HTTPException(status_code=400, detail="Gitリポジトリではありません。")
+    cmd = request.command.strip() if request.command and request.command.strip() else DEFAULT_GIT_DIFF_COMMAND
+    try:
+        args = parse_git_command(cmd)
+    except UnsafeCommandError as exc:
+        raise HTTPException(status_code=400, detail=str(exc)) from exc
+    try:
+        result = subprocess.run(args, cwd=root, shell=False, capture_output=True, text=False, timeout=60)
+    except subprocess.TimeoutExpired as exc:
+        raise HTTPException(status_code=408, detail="Gitコマンドが60秒でタイムアウトしました。") from exc
+    except FileNotFoundError as exc:
+        raise HTTPException(status_code=500, detail="gitコマンドが見つかりません。") from exc
+    if result.returncode != 0:
+        raise HTTPException(status_code=400, detail=f"Gitコマンドが失敗しました: {decode_process_output(result.stderr)}")
+    return {"status": "success", "diff": decode_process_output(result.stdout), "command": cmd}
+
+
+@router.post("/git_init")
+def git_init(request: OpenRequest) -> dict:
+    root = repository_root(request.library_path)
+    if is_git_repository(root):
+        return {"status": "success", "message": "すでにGitリポジトリです。"}
+    result = subprocess.run(["git", "-C", str(root), "init"], capture_output=True, text=False)
+    return {"status": "success" if result.returncode == 0 else "error", "message": decode_process_output(result.stdout or result.stderr)}
+
+
+@router.post("/open_in_code")
+def open_in_code(request: OpenRequest) -> dict:
+    root = repository_root(request.library_path)
+    command = shutil.which("code")
+    try:
+        if command:
+            subprocess.Popen([command, str(root)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        elif sys.platform == "darwin" and Path("/Applications/Visual Studio Code.app").exists():
+            subprocess.Popen(["open", "-a", "Visual Studio Code", str(root)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        else:
+            return {"status": "error", "message": "VS Codeのcodeコマンドが見つかりません。"}
+        return {"status": "success", "message": "VS Codeで開きました。"}
+    except OSError as exc:
+        return {"status": "error", "message": str(exc)}
diff --git a/backend/csharp_symbols.py b/backend/csharp_symbols.py
new file mode 100644
index 0000000000000000000000000000000000000000..faf2d5566b7e93dfe767ee501814366a08ae915f
--- /dev/null
+++ b/backend/csharp_symbols.py
@@ -0,0 +1,87 @@
+"""
+C# の型・メソッド定義の位置を軽量に走査するモジュール (csharp_symbols.py)
+
+仕様:
+1. 正規表現と波括弧の対応で、class / interface / struct / record と（型の外にある）メソッドの範囲を求める。
+2. 波括弧の対応は、行コメント・ブロックコメント・文字列・文字リテラルを読み飛ばして数える。
+3. AI出力の抽出（patch_parser）と、既存ファイル内の置換位置特定（patcher / patch_paths）の両方で同じ走査結果を使う。
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+CS_METHOD_RE = re.compile(
+    r"(?P<all>(?:(?:public|private|protected|internal|static|virtual|override|async|sealed|partial|new|extern)\s+)+"
+    r"[\w<>,.?\[\]\s]+\s+(?P<name>[A-Za-z_]\w*)\s*\((?P<args>[^)]*)\)\s*(?:where[^\{=>]+)?(?:\{|=>))",
+    re.MULTILINE,
+)
+CS_NAMESPACE_RE = re.compile(r"\bnamespace\s+([A-Za-z_]\w*(?:\.[A-Za-z_]\w*)*)")
+CS_TYPE_RE = re.compile(
+    r"(?P<all>(?:(?:public|private|protected|internal|static|sealed|abstract|partial)\s+)*(?:class|interface|struct|record)\s+(?P<name>[A-Za-z_]\w*)(?:<[^>]+>)?(?:\s*:[^{]+)?\s*\{)",
+    re.MULTILINE,
+)
+
+
+@dataclass(frozen=True)
+class CsSymbol:
+    name: str
+    signature: str  # 型は空文字、メソッドは空白を正規化した引数文字列
+    start: int
+    end: int
+
+
+def brace_end(text: str, brace_start: int) -> int:
+    """`{` の位置から対応する `}` の直後のオフセットを返す（見つからなければ末尾）。"""
+    depth = 0
+    state = "code"
+    index = brace_start
+    while index < len(text):
+        ch = text[index]
+        pair = text[index:index + 2]
+        if state == "code":
+            if pair == "//":
+                state = "line"; index += 2; continue
+            if pair == "/*":
+                state = "block"; index += 2; continue
+            if ch == '"':
+                state = "string"
+            elif ch == "'":
+                state = "char"
+            elif ch == "{":
+                depth += 1
+            elif ch == "}":
+                depth -= 1
+                if depth == 0:
+                    return index + 1
+        elif state == "line" and ch in "\r\n":
+            state = "code"
+        elif state == "block" and pair == "*/":
+            state = "code"; index += 2; continue
+        elif state in {"string", "char"}:
+            if ch == "\\":
+                index += 2; continue
+            if (state == "string" and ch == '"') or (state == "char" and ch == "'"):
+                state = "code"
+        index += 1
+    return len(text)
+
+
+def scan_csharp_symbols(text: str) -> list[CsSymbol]:
+    """型 → 型の外にあるメソッドの順にシンボルを返す。"""
+    symbols: list[CsSymbol] = []
+    type_ranges: list[tuple[int, int]] = []
+    for match in CS_TYPE_RE.finditer(text):
+        start = match.start("all")
+        end = brace_end(text, text.find("{", match.start(), match.end()))
+        type_ranges.append((start, end))
+        symbols.append(CsSymbol(match.group("name"), "", start, end))
+    for match in CS_METHOD_RE.finditer(text):
+        start = match.start("all")
+        if any(type_start <= start < type_end for type_start, type_end in type_ranges):
+            continue
+        marker = text.find(match.group(0)[-1], match.start(), match.end())
+        end = brace_end(text, marker) if text[marker] == "{" else text.find(";", marker) + 1
+        symbols.append(CsSymbol(match.group("name"), re.sub(r"\s+", " ", match.group("args").strip()), start, end))
+    return symbols
diff --git a/backend/external_roots.py b/backend/external_roots.py
new file mode 100644
index 0000000000000000000000000000000000000000..eb628e536bf426153cdfe3ecc8405fe147dd3aa4
--- /dev/null
+++ b/backend/external_roots.py
@@ -0,0 +1,45 @@
+"""
+コード反映を許可する外部ライブラリルートの検出モジュール (external_roots.py)
+
+仕様:
+1. PYTHONPATH、手動参照リポジトリ設定、メインリポジトリ内コードの sys.path.append / insert 指定先を、
+   メインリポジトリ以外で反映を許可するルートとして列挙する。
+2. sys.path の走査は Git 管理（または無視設定適用後）のファイルだけを対象とし、.venv や node_modules を辿らない。
+"""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+from .references import extract_sys_path_entries
+from .repository import list_repository_entries
+from .settings_store import get_settings_file, load_settings, manual_references
+
+
+def get_external_roots(root: Path) -> list[Path]:
+    """PYTHONPATH、手動参照設定、およびコード内のsys.path追加先から外部ライブラリのルート一覧を取得する。"""
+    root = root.resolve()
+    roots: list[Path] = []
+
+    def add(raw: str) -> None:
+        candidate = Path(raw).expanduser().resolve()
+        if candidate.is_dir() and candidate != root:
+            roots.append(candidate)
+
+    for raw in os.environ.get("PYTHONPATH", "").split(os.pathsep):
+        if raw.strip():
+            add(raw)
+    try:
+        for ref_path in manual_references(load_settings(get_settings_file()), root).values():
+            add(ref_path)
+    except (OSError, RuntimeError):
+        pass
+    try:
+        entries, _ = list_repository_entries(root)
+        py_files = [root / entry.path for entry in entries if entry.kind == "file" and entry.path.endswith(".py")]
+        for entry in extract_sys_path_entries(root, py_files):
+            add(str(entry))
+    except (OSError, RuntimeError):
+        pass
+    return list(dict.fromkeys(roots))
