diff --git a/backend/runner.py b/backend/runner.py
new file mode 100644
index 0000000000000000000000000000000000000000..eecccbe8f31f8dafcba6ca43ae7c00d3b916c515
--- /dev/null
+++ b/backend/runner.py
@@ -0,0 +1,63 @@
+"""
+テストコマンドの解決と、子孫プロセスまで確実に終了できるコマンド実行モジュール (runner.py)
+
+仕様:
+1. resolve_test_command: `python ...` / `pytest ...` で始まるコマンドを、選択中の環境（仮想環境 / Embedded Python）のPythonで実行する形へ書き換える。
+2. run_shell_command: シェル経由で実行し、タイムアウト時はプロセスグループ（Windowsは taskkill /T）ごと終了する。
+   孫プロセスがパイプを握ったまま残ってもタイムアウトで確実に戻る。
+"""
+
+from __future__ import annotations
+
+import os
+import re
+import signal
+import subprocess
+from pathlib import Path
+
+from .pyenv import find_embedded_python, find_venv_python
+
+
+def resolve_test_command(root: Path, command: str, mode: str = "normal", embedded_python_dir: str = "") -> str:
+    """Prefer the selected environment's Python for default test commands."""
+    if mode == "embedded" and embedded_python_dir:
+        python_path = find_embedded_python(embedded_python_dir)
+    else:
+        python_path = find_venv_python(root)
+    if python_path is None:
+        return command
+
+    quoted_python = f'"{python_path}"'
+    stripped = command.strip()
+    if re.match(r"^(?:python|python3)(?:\s|$)", stripped, re.IGNORECASE):
+        rest = re.sub(r"^\S+", "", stripped)
+        return quoted_python + rest
+    if re.match(r"^pytest(?:\s|$)", stripped, re.IGNORECASE):
+        return f"{quoted_python} -m {stripped}"
+    return command
+
+
+def _kill_process_tree(process: subprocess.Popen) -> None:
+    try:
+        if os.name == "nt":
+            subprocess.run(["taskkill", "/F", "/T", "/PID", str(process.pid)], capture_output=True, timeout=10)
+        else:
+            os.killpg(process.pid, signal.SIGKILL)
+    except (OSError, subprocess.SubprocessError):
+        process.kill()
+
+
+def run_shell_command(command: str, cwd: Path, env: dict[str, str], timeout: int) -> tuple[int | None, bytes, bytes]:
+    """コマンドを実行し (終了コード, stdout, stderr) を返す。タイムアウト時の終了コードはNone。"""
+    options: dict = {"creationflags": subprocess.CREATE_NEW_PROCESS_GROUP} if os.name == "nt" else {"start_new_session": True}
+    process = subprocess.Popen(command, cwd=cwd, env=env, shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, **options)
+    try:
+        stdout, stderr = process.communicate(timeout=timeout)
+        return process.returncode, stdout, stderr
+    except subprocess.TimeoutExpired:
+        _kill_process_tree(process)
+        try:
+            stdout, stderr = process.communicate(timeout=5)
+        except subprocess.TimeoutExpired:
+            stdout, stderr = b"", b""
+        return None, stdout or b"", stderr or b""
diff --git a/backend/security.py b/backend/security.py
new file mode 100644
index 0000000000000000000000000000000000000000..9e8d37c4a9c9f995b22db0dd6df4c4a6ecffdc58
--- /dev/null
+++ b/backend/security.py
@@ -0,0 +1,124 @@
+"""
+ローカル実行ツールとしての安全策モジュール (security.py)
+
+仕様:
+1. Git差分コマンド（ユーザー編集可能）をシェルを介さずに実行できる引数リストへ検証・変換する。
+   読み取り専用のサブコマンドだけを許可し、ファイル出力や外部コマンド実行につながるオプションは拒否する。
+2. ターミナルWebSocketの接続元Originを検証し、別サイトのWebページからのシェル操作（CSWSH）を防ぐ。
+   Originなし（非ブラウザクライアント）とローカルホストは許可し、LAN公開時は同一Host、
+   SPOONFEEDER_ALLOWED_ORIGINS（カンマ区切り）に列挙したOriginだけを追加で許可する。
+3. Hostヘッダーを検証し、DNSリバインディング（攻撃者のドメインを127.0.0.1へ向けて同一オリジン扱いでAPIを呼ぶ手口）を防ぐ。
+   ローカルホスト待受（既定）ではlocalhost / 127.0.0.1 / [::1] と SPOONFEEDER_ALLOWED_HOSTS（カンマ区切り）のみ許可し、
+   LAN公開（SPOONFEEDER_HOSTがローカルホスト以外）を明示した場合は任意のHostを許可する。
+"""
+
+from __future__ import annotations
+
+import os
+import shlex
+from urllib.parse import urlsplit
+
+DEFAULT_GIT_DIFF_COMMAND = "git diff HEAD -- *.py"
+LOOPBACK_HOSTS = {"localhost", "127.0.0.1", "::1"}
+READ_ONLY_GIT_SUBCOMMANDS = {"diff", "log", "show", "status", "ls-files", "rev-parse", "blame", "describe", "shortlog"}
+FORBIDDEN_GIT_OPTION_PREFIXES = ("--output", "--ext-diff", "--textconv", "--open-files-in-pager", "--exec-path", "--upload-pack", "--receive-pack")
+
+
+class UnsafeCommandError(ValueError):
+    """許可されないGitコマンドが指定されたことを表す。"""
+
+
+def parse_git_command(command: str) -> list[str]:
+    """Gitコマンド文字列を、シェルを使わずに実行できる引数リストへ変換する。
+
+    `;` `&&` `|` `$(...)` などのシェル構文は解釈されず、gitへの単なる引数として渡る。
+    """
+    text = (command or "").strip() or DEFAULT_GIT_DIFF_COMMAND
+    try:
+        args = shlex.split(text, posix=os.name != "nt")
+    except ValueError as exc:
+        raise UnsafeCommandError(f"コマンドを解析できません: {exc}") from exc
+    if os.name == "nt":
+        args = [arg[1:-1] if len(arg) >= 2 and arg[0] == arg[-1] and arg[0] in "\"'" else arg for arg in args]
+    if not args or args[0] != "git":
+        raise UnsafeCommandError("gitコマンドのみ実行可能です。")
+    if len(args) < 2 or args[1] not in READ_ONLY_GIT_SUBCOMMANDS:
+        allowed = ", ".join(sorted(READ_ONLY_GIT_SUBCOMMANDS))
+        raise UnsafeCommandError(f"読み取り専用のgitサブコマンドのみ実行可能です（{allowed}）。")
+    for arg in args[2:]:
+        if arg == "--":
+            break
+        if arg.startswith(FORBIDDEN_GIT_OPTION_PREFIXES):
+            raise UnsafeCommandError(f"許可されないオプションです: {arg}")
+    if args[1] in {"diff", "log", "show"}:
+        # リポジトリ内 .git/config の diff.external による外部コマンド実行を無効化する。
+        args.insert(2, "--no-ext-diff")
+    return args
+
+
+def _origin_host(origin: str) -> str:
+    try:
+        return (urlsplit(origin).hostname or "").lower()
+    except ValueError:
+        return ""
+
+
+def _is_loopback_bind() -> bool:
+    return os.environ.get("SPOONFEEDER_HOST", "127.0.0.1").strip() in LOOPBACK_HOSTS
+
+
+def is_allowed_websocket_origin(origin: str | None, host_header: str | None) -> bool:
+    """WebSocket接続元Originを許可するか判定する。ブラウザは必ずOriginを付与する。"""
+    if not origin:
+        return True
+    host = _origin_host(origin)
+    if not host:
+        return False
+    if host in LOOPBACK_HOSTS:
+        return True
+    allowed = {item.strip().rstrip("/").lower() for item in os.environ.get("SPOONFEEDER_ALLOWED_ORIGINS", "").split(",") if item.strip()}
+    if origin.rstrip("/").lower() in allowed:
+        return True
+    if not _is_loopback_bind() and host_header:
+        # LAN公開を明示した場合のみ、同一Host（自分自身が配信したページ）からの接続を許可する。
+        return urlsplit(origin).netloc.lower() == host_header.strip().lower()
+    return False
+
+
+def _host_name(host_header: str) -> str:
+    """Hostヘッダー値からポートを除いたホスト名を小文字で返す（IPv6は角括弧を除く）。"""
+    value = host_header.strip().lower()
+    if value.startswith("["):
+        return value[1:].split("]", 1)[0]
+    return value.rsplit(":", 1)[0] if value.count(":") == 1 else value
+
+
+def is_allowed_host(host_header: str | None) -> bool:
+    """Hostヘッダーを許可するか判定する。"""
+    if not _is_loopback_bind():
+        return True
+    if not host_header:
+        return False
+    allowed = LOOPBACK_HOSTS | {item.strip().lower() for item in os.environ.get("SPOONFEEDER_ALLOWED_HOSTS", "").split(",") if item.strip()}
+    return _host_name(host_header) in allowed
+
+
+class HostGuardMiddleware:
+    """許可されないHostのHTTP/WebSocketリクエストを拒否するASGIミドルウェア。"""
+
+    def __init__(self, app):
+        self.app = app
+
+    async def __call__(self, scope, receive, send):
+        if scope["type"] in {"http", "websocket"}:
+            host = next((value.decode("latin-1") for key, value in scope.get("headers", []) if key == b"host"), None)
+            if not is_allowed_host(host):
+                if scope["type"] == "websocket":
+                    await receive()  # websocket.connect
+                    await send({"type": "websocket.close", "code": 1008})
+                else:
+                    body = b"Invalid Host header"
+                    await send({"type": "http.response.start", "status": 403, "headers": [(b"content-type", b"text/plain; charset=utf-8"), (b"content-length", str(len(body)).encode())]})
+                    await send({"type": "http.response.body", "body": body})
+                return
+        await self.app(scope, receive, send)
diff --git a/backend/settings_store.py b/backend/settings_store.py
new file mode 100644
index 0000000000000000000000000000000000000000..39931d106d1c55a3f0ff5a7721e269ceeccff96a
--- /dev/null
+++ b/backend/settings_store.py
@@ -0,0 +1,94 @@
+"""
+ユーザー設定ファイル (spoonfeeder_configs.json) の読み書きモジュール (settings_store.py)
+
+仕様:
+1. 設定ファイルの場所は環境変数 SPOONFEEDER_CONFIGS_FILE で切り替えられる（既定はプロジェクト直下）。
+2. 読み込み→変更→保存はプロセス内ロックの下で行い（settings_transaction）、保存は一時ファイル経由のアトミック置換とする。
+3. JSONが壊れていた場合は `<name>.corrupt[.N]` へ退避してから空の設定を返し、履歴や選択状態が上書きで消えないようにする。
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import threading
+from contextlib import contextmanager
+from pathlib import Path
+from typing import Iterator
+
+from .repository import read_text_file
+
+ROOT = Path(__file__).resolve().parents[1]
+SETTINGS_LOCK = threading.RLock()
+
+
+def get_settings_file() -> Path:
+    return Path(os.environ.get("SPOONFEEDER_CONFIGS_FILE", ROOT / "spoonfeeder_configs.json"))
+
+
+def _quarantine_corrupt_settings(path: Path) -> None:
+    with SETTINGS_LOCK:
+        if not path.exists():
+            return
+        for index in range(100):
+            backup = path.with_name(f"{path.name}.corrupt" + (f".{index}" if index else ""))
+            if not backup.exists():
+                try:
+                    os.replace(path, backup)
+                except OSError:
+                    pass
+                return
+
+
+def load_settings(path: Path) -> dict:
+    if not path.exists():
+        return {"repositories": {}, "ui": {"show_ignored": False}}
+    try:
+        data = json.loads(read_text_file(path)[0])
+    except json.JSONDecodeError:
+        _quarantine_corrupt_settings(path)
+        return {"repositories": {}, "ui": {}}
+    except OSError:
+        return {"repositories": {}, "ui": {}}
+    return data if isinstance(data, dict) else {"repositories": {}, "ui": {}}
+
+
+def save_settings(path: Path, data: dict) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_suffix(".tmp")
+    with SETTINGS_LOCK:
+        temporary.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
+        os.replace(temporary, path)
+
+
+@contextmanager
+def settings_transaction() -> Iterator[dict]:
+    """設定を読み込んで渡し、ブロックを正常に抜けたときだけ保存する。"""
+    with SETTINGS_LOCK:
+        path = get_settings_file()
+        settings = load_settings(path)
+        yield settings
+        save_settings(path, settings)
+
+
+def repository_config(settings: dict, root: Path) -> dict:
+    """読み取り専用で、リポジトリごとの設定辞書を返す（なければ空辞書）。"""
+    config = settings.get("repositories", {}).get(str(root), {})
+    return config if isinstance(config, dict) else {}
+
+
+def remember_repository(root: Path, selected_files: list[str] | None = None, show_ignored: bool | None = None) -> None:
+    with settings_transaction() as settings:
+        config = settings.setdefault("repositories", {}).setdefault(str(root), {})
+        if selected_files is not None:
+            config["selected_files"] = selected_files
+        if show_ignored is not None:
+            config["show_ignored"] = show_ignored
+
+
+def manual_references(settings: dict, root: Path) -> dict[str, str]:
+    """手動で対応付けた {モジュール名: 参照リポジトリのパス} を、空要素を除いて返す。"""
+    raw = repository_config(settings, root).get("manual_references", {})
+    if not isinstance(raw, dict):
+        return {}
+    return {str(module): str(path) for module, path in raw.items() if str(module).strip() and str(path).strip()}
