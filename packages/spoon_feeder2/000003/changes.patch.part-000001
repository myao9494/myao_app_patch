diff --git a/frontend/src/hooks/useGlobalShortcuts.js b/frontend/src/hooks/useGlobalShortcuts.js
new file mode 100644
index 0000000000000000000000000000000000000000..4c3ef475813862062da97c807940f78700d4f066
--- /dev/null
+++ b/frontend/src/hooks/useGlobalShortcuts.js
@@ -0,0 +1,38 @@
+/**
+ * 画面全体のショートカット (useGlobalShortcuts.js)
+ *
+ * 仕様:
+ * 1. I: 無視リスト編集を開く / H: ショートカット説明の開閉 / Esc: プレビューまたは右クリックメニューを閉じる。
+ * 2. 入力欄・テキストエリア・選択欄・ターミナル(xterm)にフォーカスがあるときは I/H を通常入力として扱う。
+ * 3. 無視リスト編集・参照リポジトリ編集モーダルが開いている間は何もしない（モーダル側で処理）。
+ * 4. 画面のクリックで右クリックメニューを閉じる。
+ * ハンドラーは常に最新の props を参照する（再登録は1度だけ）。
+ **/
+
+import { useEffect, useRef } from 'react';
+
+export function useGlobalShortcuts(handlers) {
+  const ref = useRef(handlers);
+  ref.current = handlers;
+  useEffect(() => {
+    const closeMenu = () => ref.current.onCloseContextMenu();
+    const onKeyDown = event => {
+      const { helpOpen, modalOpen, previewFile, onToggleHelp, onClosePreview, onCloseContextMenu, onOpenIgnoreEditor } = ref.current;
+      if (event.defaultPrevented) return;
+      const key = event.key.toLowerCase();
+      if (helpOpen) {
+        if (key === 'h' || event.key === 'Escape') { event.preventDefault(); onToggleHelp(false); }
+        return;
+      }
+      if (modalOpen) return;
+      if (event.key === 'Escape') { if (previewFile) onClosePreview(); else onCloseContextMenu(); return; }
+      const target = event.target;
+      if (target instanceof HTMLElement && (target.matches('input, textarea, select, [contenteditable="true"]') || target.closest('.xterm'))) return;
+      if (event.ctrlKey || event.metaKey || event.altKey) return;
+      if (key === 'i') { event.preventDefault(); onOpenIgnoreEditor(); }
+      if (key === 'h') { event.preventDefault(); onToggleHelp(true); }
+    };
+    window.addEventListener('click', closeMenu); window.addEventListener('keydown', onKeyDown);
+    return () => { window.removeEventListener('click', closeMenu); window.removeEventListener('keydown', onKeyDown); };
+  }, []);
+}
diff --git a/frontend/src/hooks/useMkdocsBundle.js b/frontend/src/hooks/useMkdocsBundle.js
new file mode 100644
index 0000000000000000000000000000000000000000..dc7b966a8285bab7be47806d23351df17d07df90
--- /dev/null
+++ b/frontend/src/hooks/useMkdocsBundle.js
@@ -0,0 +1,61 @@
+/**
+ * MkDocsモードの「統合マークダウン＋結合画像」state と操作 (useMkdocsBundle.js)
+ *
+ * 仕様:
+ * 1. 保存先フォルダ設定をサーバーから読み込み、変更後の保存時にサーバーへ永続化する。
+ * 2. preview: /api/mkdocs/context でコンテキストと結合画像のData URLを生成する（保存はしない）。
+ * 3. save: 保存先へ「*_context.md」と「*_images.png/.jpg」の2ファイルを書き出す。
+ * 4. openFolder: 保存先フォルダをFinder / Explorerで開く。
+ * エラーは呼び出し側(MainPage)へ例外として伝える。
+ **/
+
+import { useEffect, useState } from 'react';
+import { api } from '../api';
+import { downloadDataUrl, imageExtension } from '../lib/download';
+
+export function useMkdocsBundle({ libraryPath, selected, siteName, notify, setContext }) {
+  const [exportFolder, setExportFolder] = useState('~/Desktop/AI_Inputs');
+  const [imageDataUrl, setImageDataUrl] = useState('');
+  const [stats, setStats] = useState(null);
+  const [viewTab, setViewTab] = useState('markdown');
+  const [saving, setSaving] = useState(false);
+
+  useEffect(() => {
+    api('/api/mkdocs/export_config', undefined, 'GET').then(data => { if (data.export_folder) setExportFolder(data.export_folder); }).catch(() => {});
+  }, []);
+
+  const reset = () => { setImageDataUrl(''); setStats(null); };
+  const apply = data => { setContext(data.context || ''); setImageDataUrl(data.image_data_url || ''); setStats(data.stats || null); };
+
+  const preview = async () => {
+    const data = await api('/api/mkdocs/context', { library_path: libraryPath, selected_files: Array.from(selected), title: siteName || '' });
+    apply(data);
+    notify(`MkDocsコンテキスト（文書${data.stats?.total_documents || 0}件・結合画像${data.stats?.total_images || 0}枚）を作成しました。`);
+  };
+
+  const save = async () => {
+    setSaving(true);
+    try {
+      await api('/api/mkdocs/export_config', { export_folder: exportFolder });
+      const data = await api('/api/mkdocs/save_bundle', { library_path: libraryPath, selected_files: Array.from(selected), target_dir: exportFolder, title: siteName || '' });
+      apply(data);
+      notify(data.has_images
+        ? `保存完了: ${data.markdown_name} ＋ ${data.image_name} (${data.stats?.total_images || 0}枚結合)`
+        : `保存完了: ${data.markdown_name} (画像なし)`);
+    } finally { setSaving(false); }
+  };
+
+  const openFolder = async () => {
+    await api('/api/mkdocs/open_folder', { export_folder: exportFolder });
+    notify(`保存先フォルダを開きました: ${exportFolder}`);
+  };
+
+  const downloadImage = () => {
+    if (!imageDataUrl) return;
+    const filename = `mkdocs_images.${imageExtension(imageDataUrl)}`;
+    downloadDataUrl(filename, imageDataUrl);
+    notify(`${filename}を保存しました。`);
+  };
+
+  return { exportFolder, setExportFolder, imageDataUrl, stats, viewTab, setViewTab, saving, reset, preview, save, openFolder, downloadImage };
+}
diff --git a/frontend/src/hooks/usePersistentState.js b/frontend/src/hooks/usePersistentState.js
new file mode 100644
index 0000000000000000000000000000000000000000..73e127e37b4edaf26f26fc981e7a47656c646eb2
--- /dev/null
+++ b/frontend/src/hooks/usePersistentState.js
@@ -0,0 +1,18 @@
+/**
+ * localStorage に自動保存する state (usePersistentState.js)
+ *
+ * 仕様:
+ * 1. 初回は localStorage から読み出し（read で文字列→値へ変換）、変更のたびに保存する。
+ * 2. localStorage が使えない環境（プライベートモード等）でも例外にせず、メモリ上の state として動作する。
+ **/
+
+import { useEffect, useState } from 'react';
+
+const readStorage = key => { try { return localStorage.getItem(key); } catch { return null; } };
+const writeStorage = (key, value) => { try { localStorage.setItem(key, value); } catch { /* 保存できなくても動作は継続する */ } };
+
+export function usePersistentState(key, defaultValue, read = raw => raw ?? defaultValue) {
+  const [value, setValue] = useState(() => read(readStorage(key)));
+  useEffect(() => { writeStorage(key, String(value)); }, [key, value]);
+  return [value, setValue];
+}
diff --git a/frontend/src/hooks/usePreview.js b/frontend/src/hooks/usePreview.js
new file mode 100644
index 0000000000000000000000000000000000000000..5029af07cfa95bedfc2de38e32fdc520bb09f2d3
--- /dev/null
+++ b/frontend/src/hooks/usePreview.js
@@ -0,0 +1,76 @@
+/**
+ * ファイルツリーのキーボード操作とプレビュー表示 (usePreview.js)
+ *
+ * 仕様:
+ * 1. ツリー上で ↑/↓ でフォーカス移動、←/→ でフォルダ開閉、Enter でチェック反転・フォルダ開閉、Shift+Enter でプレビューを開く。
+ * 2. プレビューを閉じたら、開く前にフォーカスしていたツリー項目へフォーカスを戻す。
+ * 3. 参照ライブラリ配下のファイルは、そのリポジトリのパスでプレビューを取得する。
+ **/
+
+import { useRef, useState } from 'react';
+import { api } from '../api';
+
+export function usePreview({ activePath, path }) {
+  const [previewFile, setPreviewFile] = useState('');
+  const [previewContent, setPreviewContent] = useState('');
+  const treeRef = useRef(null);
+  const returnRef = useRef(null);
+
+  const closePreview = () => {
+    setPreviewFile('');
+    const returnFocus = returnRef.current;
+    setTimeout(() => {
+      const items = Array.from(treeRef.current?.querySelectorAll('[data-tree-item="true"]') || []);
+      const target = returnFocus && items.find(item => item.dataset.treePath === returnFocus.path && (item.dataset.treeRepository || activePath || path) === returnFocus.repository);
+      (target || treeRef.current)?.focus();
+    }, 0);
+  };
+
+  const openPreview = async (file, repositoryPath = activePath || path) => {
+    const focused = treeRef.current?.querySelector('[data-tree-item="true"]:focus');
+    if (focused) returnRef.current = { path: focused.dataset.treePath, repository: focused.dataset.treeRepository || activePath || path };
+    setPreviewFile(file); setPreviewContent('読み込み中…');
+    try { const data = await api('/api/file_content', { library_path: repositoryPath, file_path: file }); setPreviewContent(data.content); }
+    catch (err) { setPreviewContent(err.message); }
+  };
+
+  const handleTreeKeyDown = event => {
+    const tree = treeRef.current;
+    if (!tree) return;
+    const items = Array.from(tree.querySelectorAll('[data-tree-item="true"]'));
+    const current = event.target.closest?.('[data-tree-item="true"]');
+    const index = current ? items.indexOf(current) : -1;
+    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+      event.preventDefault();
+      const nextIndex = index < 0
+        ? (event.key === 'ArrowDown' ? 0 : items.length - 1)
+        : (index + (event.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length;
+      items[nextIndex]?.focus();
+      return;
+    }
+    if (!current) return;
+    if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
+      if (current.dataset.treeKind !== 'directory') return;
+      const expanded = current.getAttribute('aria-expanded') === 'true';
+      if ((event.key === 'ArrowRight' && !expanded) || (event.key === 'ArrowLeft' && expanded)) {
+        event.preventDefault();
+        current.querySelector('[data-tree-toggle="true"]')?.click();
+      }
+      return;
+    }
+    if (event.key === 'Enter') {
+      event.preventDefault();
+      if (event.shiftKey && current.dataset.treeKind === 'file' && current.dataset.treeIgnored !== 'true') {
+        openPreview(current.dataset.treePath, current.dataset.treeRepository || activePath || path);
+        return;
+      }
+      if (current.dataset.treeKind === 'directory') {
+        current.querySelector('[data-tree-toggle="true"]')?.click();
+      } else if (current.dataset.treeIgnored !== 'true') {
+        current.querySelector('input[type="checkbox"]:not(:disabled)')?.click();
+      }
+    }
+  };
+
+  return { treeRef, previewFile, previewContent, openPreview, closePreview, handleTreeKeyDown };
+}
diff --git a/frontend/src/hooks/useReferences.js b/frontend/src/hooks/useReferences.js
new file mode 100644
index 0000000000000000000000000000000000000000..45fa0952506eb79004ae266d02d7e349382bbd1d
--- /dev/null
+++ b/frontend/src/hooks/useReferences.js
@@ -0,0 +1,46 @@
+/**
+ * 参照ライブラリ（外部リポジトリ）の自動検出state (useReferences.js)
+ *
+ * 仕様:
+ * 1. 選択ファイルが変わるたびに220ms後(デバウンス)に /api/reference_modules を呼び、参照リポジトリ・未解決モジュール・警告を更新する。
+ * 2. Embedded Python / MkDocsモード / リポジトリ未選択では機能を無効にし、選択を空にする。
+ * 3. 再解析後、新しく現れた参照ファイルは選択状態にし、既存のファイルは直前の選択を維持する。
+ **/
+
+import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
+import { api } from '../api';
+import { mergeReferenceSelection } from '../lib/selection';
+
+const DISABLED = { enabled: false, repositories: [], unresolved: [], manual_references: {}, warnings: [] };
+
+export function useReferences({ activePath, pythonMode, selected, activeMode }) {
+  const [referenceData, setReferenceData] = useState({ ...DISABLED, enabled: true });
+  const [referenceSelected, setReferenceSelected] = useState(new Set());
+  const availableRef = useRef(new Set());
+
+  const refreshReferences = useCallback(async () => {
+    if (!activePath || pythonMode === 'embedded' || activeMode === 'mkdocs') {
+      availableRef.current = new Set(); setReferenceSelected(new Set());
+      setReferenceData(DISABLED);
+      return;
+    }
+    try {
+      const data = await api('/api/reference_modules', { library_path: activePath, selected_files: Array.from(selected), python_mode: pythonMode });
+      const available = new Set((data.repositories || []).flatMap(repo => (repo.files || []).map(file => `${repo.path}::${file}`)));
+      const previousAvailable = availableRef.current;
+      setReferenceSelected(previous => mergeReferenceSelection(available, previousAvailable, previous));
+      availableRef.current = available;
+      setReferenceData(data);
+    } catch (err) {
+      setReferenceData(previous => ({ ...previous, warnings: [err.message] }));
+    }
+  }, [activePath, pythonMode, selected, activeMode]);
+
+  useEffect(() => {
+    const timer = setTimeout(refreshReferences, 220);
+    return () => clearTimeout(timer);
+  }, [refreshReferences]);
+
+  const referenceFileCount = useMemo(() => (referenceData.repositories || []).reduce((total, repo) => total + (repo.files || []).length, 0), [referenceData]);
+  return { referenceData, referenceSelected, setReferenceSelected, refreshReferences, referenceFileCount };
+}
diff --git a/frontend/src/lib/download.js b/frontend/src/lib/download.js
new file mode 100644
index 0000000000000000000000000000000000000000..19dfd61a0babab6de182d6cfd0ff37f938b02c7c
--- /dev/null
+++ b/frontend/src/lib/download.js
@@ -0,0 +1,25 @@
+/**
+ * ブラウザでのファイル保存補助 (download.js)
+ *
+ * 仕様:
+ * 1. downloadText: テキストをUTF-8のファイルとして保存する。
+ * 2. downloadDataUrl: Data URL(画像等)をファイルとして保存する。
+ * 3. imageExtension: 結合画像のData URLからPNG/JPEGの拡張子を判定する。
+ **/
+
+export const imageExtension = dataUrl => (dataUrl.startsWith('data:image/png') ? 'png' : 'jpg');
+
+const clickDownload = (href, filename) => {
+  const link = document.createElement('a');
+  link.href = href; link.download = filename; link.click();
+};
+
+export function downloadText(filename, text) {
+  const url = URL.createObjectURL(new Blob([text], { type: 'text/plain;charset=utf-8' }));
+  clickDownload(url, filename);
+  URL.revokeObjectURL(url);
+}
+
+export function downloadDataUrl(filename, dataUrl) {
+  clickDownload(dataUrl, filename);
+}
diff --git a/frontend/src/lib/download.test.js b/frontend/src/lib/download.test.js
