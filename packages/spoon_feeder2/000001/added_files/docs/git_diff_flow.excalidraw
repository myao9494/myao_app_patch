{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    {
      "id": "rect_ui_button",
      "type": "rectangle",
      "x": 60,
      "y": 80,
      "width": 240,
      "height": 90,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e0f2fe",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": { "type": 3 }
    },
    {
      "id": "text_ui_button",
      "type": "text",
      "x": 80,
      "y": 105,
      "width": 200,
      "height": 40,
      "text": "UI: [Git差分コピー] ボタン\n(path-bar)",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "rect_drawer",
      "type": "rectangle",
      "x": 60,
      "y": 230,
      "width": 240,
      "height": 110,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ede9fe",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": { "type": 3 }
    },
    {
      "id": "text_drawer",
      "type": "text",
      "x": 70,
      "y": 250,
      "width": 220,
      "height": 70,
      "text": "ハンバーガーメニュー\nGit差分コマンド設定\n(デフォルト: git diff HEAD -- *.py)\nlocalStorage保存",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "arrow_config",
      "type": "arrow",
      "x": 180,
      "y": 230,
      "width": 0,
      "height": -60,
      "strokeColor": "#6366f1",
      "strokeWidth": 2,
      "points": [[0, 0], [0, -60]]
    },
    {
      "id": "arrow_request",
      "type": "arrow",
      "x": 300,
      "y": 125,
      "width": 140,
      "height": 0,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "points": [[0, 0], [140, 0]]
    },
    {
      "id": "text_arrow_req",
      "type": "text",
      "x": 310,
      "y": 100,
      "width": 120,
      "height": 20,
      "text": "POST /api/git_diff",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "rect_backend",
      "type": "rectangle",
      "x": 440,
      "y": 70,
      "width": 260,
      "height": 110,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fef3c7",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": { "type": 3 }
    },
    {
      "id": "text_backend",
      "type": "text",
      "x": 450,
      "y": 90,
      "width": 240,
      "height": 70,
      "text": "FastAPI: /api/git_diff\n- Gitリポジトリ判定\n- 'git' コマンド安全性検証\n- タイムアウト60秒制限",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "arrow_exec",
      "type": "arrow",
      "x": 570,
      "y": 180,
      "width": 0,
      "height": 70,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "points": [[0, 0], [0, 70]]
    },
    {
      "id": "rect_git",
      "type": "rectangle",
      "x": 440,
      "y": 250,
      "width": 260,
      "height": 90,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#f0fdf4",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": { "type": 3 }
    },
    {
      "id": "text_git",
      "type": "text",
      "x": 450,
      "y": 270,
      "width": 240,
      "height": 50,
      "text": "ローカルGitプロセス\n(例: git diff HEAD -- *.py)\nPythonファイル差分を出力",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "arrow_response",
      "type": "arrow",
      "x": 440,
      "y": 145,
      "width": -140,
      "height": 0,
      "strokeColor": "#16a34a",
      "strokeWidth": 2,
      "points": [[0, 0], [-140, 0]]
    },
    {
      "id": "text_arrow_res",
      "type": "text",
      "x": 310,
      "y": 150,
      "width": 120,
      "height": 20,
      "text": "JSON { diff: \"...\" }",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "rect_clipboard",
      "type": "rectangle",
      "x": 60,
      "y": -60,
      "width": 240,
      "height": 80,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ecfdf5",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": { "type": 3 }
    },
    {
      "id": "text_clipboard",
      "type": "text",
      "x": 70,
      "y": -40,
      "width": 220,
      "height": 40,
      "text": "navigator.clipboard.writeText\n差分行数トースト通知",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "arrow_clip",
      "type": "arrow",
      "x": 180,
      "y": 80,
      "width": 0,
      "height": -60,
      "strokeColor": "#16a34a",
      "strokeWidth": 2,
      "points": [[0, 0], [0, -60]]
    }
  ],
  "appState": {
    "viewBackgroundColor": "#ffffff",
    "gridSize": 20
  },
  "files": {}
}
