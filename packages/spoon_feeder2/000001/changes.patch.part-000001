 .map-page{position:fixed;inset:0;background:radial-gradient(circle at center,#111c35,#050812);overflow:hidden}.map-page>svg{width:100%;height:100%}.map-controls,.node-detail{position:absolute;top:20px;bottom:20px;width:310px;background:#0b1220e8;backdrop-filter:blur(18px);border:1px solid #26324b;border-radius:14px;box-shadow:0 18px 70px #0008;padding:18px}.map-controls{left:20px}.brand.mini{margin-bottom:24px}.brand.mini .logo{width:34px;height:34px;font-size:16px}.brand.mini h1{font-size:15px}.map-controls>label:not(.switch-line){display:block;color:#74819a;font-size:8px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;margin:16px 0 7px}.map-path{display:flex;gap:5px}.map-path input{min-width:0;flex:1}.map-path button{width:35px;border:1px solid var(--line);background:#19243b;color:#cbd3e2;border-radius:8px}.map-path svg{width:14px}.switch-line.compact{padding:8px 0;color:#b3bdd0;font-size:11px}.switch-line.compact input{margin:0}.legend{display:flex;gap:12px;margin-top:18px;font-size:8px;color:#74819a}.legend span{display:flex;align-items:center;gap:5px}.legend i{width:7px;height:7px;border-radius:99px;background:#52a9ff}.legend i.class{background:#ad78ff}.legend i.function{background:#49dca0}.map-controls>a{position:absolute;bottom:18px;color:#8998b4;font-size:10px;text-decoration:none}.node-detail{right:20px;bottom:auto;min-height:210px}.node-detail>button{position:absolute;right:12px;top:12px;background:none;border:0;color:#91a0b9}.node-detail h2{font-size:20px;margin:4px 0 16px}.node-detail code{display:block;color:#9caac1;background:#080d18;padding:10px;border-radius:8px;font-size:9px;word-break:break-all}.node-detail p{font-size:9px;color:#71809a;margin-top:16px}.node-detail strong{color:#b9c4d5}.graph-link{stroke:#62708c;stroke-opacity:.2}.graph-link.import{stroke:#6ea8ff;stroke-opacity:.38}.graph-link.calls{stroke:#4de0b0;stroke-opacity:.42;stroke-dasharray:3 3}.graph-node circle{fill:#52a9ff;filter:drop-shadow(0 0 5px #52a9ff);cursor:pointe