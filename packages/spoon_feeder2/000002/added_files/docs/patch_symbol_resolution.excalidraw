    },
    {
      "id": "rect_replace",
      "type": "rectangle",
      "x": 730,
      "y": 20,
      "width": 320,
      "height": 130,
      "strokeColor": "#16a34a",
      "backgroundColor": "#dcfce7",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": { "type": 3 }
    },
    {
      "id": "text_replace",
      "type": "text",
      "x": 740,
      "y": 30,
      "width": 300,
      "height": 110,
      "text": "【既存シンボル一致あり】\n1. トップレベル一致を最優先\n2. 同名重複時は最新(最後)を置換\n3. クラス内メソッド一致を置換\n★ 末尾への不要な多重追加を防止",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "arrow_to_replace",
      "type": "arrow",
      "x": 670,
      "y": 75,
      "width": 60,
      "height": -10,
      "strokeColor": "#16a34a",
      "strokeWidth": 2,
      "points": [[0, 0], [60, -10]]
    },
    {
      "id": "rect_guard_check",
      "type": "rectangle",
      "x": 370,
      "y": 190,
      "width": 300,
      "height": 80,
      "strokeColor": "#2563eb",
      "backgroundColor": "#ede9fe",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": { "type": 3 }
    },
    {
      "id": "text_guard_check",
      "type": "text",
      "x": 380,
      "y": 205,
      "width": 280,
      "height": 50,
      "text": "【新規シンボルの場合】\nif __name__ == '__main__':\nの有無を検出 (AST & 正規表現)",
