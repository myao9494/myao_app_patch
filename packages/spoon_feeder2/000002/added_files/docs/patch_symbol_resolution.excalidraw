      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "rect_search",
      "type": "rectangle",
      "x": 370,
      "y": 50,
      "width": 300,
      "height": 70,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fef3c7",
      "fillStyle": "solid",
