+# -*- coding: utf-8 -*-
+# 版を固定した依存一覧（backend/requirements.txt から書き出す）
+#
+# Windows の setup_windows.bat と macOS の start.sh が、.venv へ pip でこれを入れる。
+# 会社PCには uv が無いので、どの端末でも pip だけで同じ版を再現できるようにしている。
+# Python 3.14 用。全パッケージに Windows (win_amd64) / macOS のビルド済み wheel がある。
+#
+# requirements.txt を変えたら、uv のある端末（Mac）で書き出し直す（冒頭のコメントはそのまま残る）:
+#   cd backend
+#   { grep '^#' requirements-lock.txt; uv pip compile -q --universal --python-version 3.14 --no-header --no-annotate requirements.txt; } > requirements-lock.txt.new && mv requirements-lock.txt.new requirements-lock.txt
+# pytest/python_env_test.py が固定漏れを確かめる。
+annotated-doc==0.0.7
+annotated-types==0.8.0
+anyio==4.16.0
+certifi==2026.11.20
+click==8.5.1
+colorama==0.4.6 ; sys_platform == 'win32'
+fastapi==0.165.0
+h11==0.16.0
+httpcore==1.0.9
+httpx==0.28.1
+idna==3.20
+iniconfig==2.3.1
+opentelemetry-api==1.45.2
+packaging==26.4
+pillow==13.0.0
+pluggy==1.7.0
+pydantic==2.14.4
+pydantic-core==2.50.5
+pygments==2.21.0
+pytest==9.2.0
+pywinpty==3.1.2 ; sys_platform == 'win32'
+pyyaml==6.0.4
+resvg-py==0.5.0
+starlette==1.10.0
+typing-extensions==4.16.0
+typing-inspection==0.4.5
+uvicorn==0.54.0
+websockets==17.4
