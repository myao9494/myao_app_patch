diff --git a/backend/event_parser.py b/backend/event_parser.py
index 566469e6f864b38955fdbd832a9cf4f6055ae9d4..2461e392789d68e7a93146ef3c5ae74d39d4184f 100644
--- a/backend/event_parser.py
+++ b/backend/event_parser.py
@@ -143,17 +143,32 @@ def resolve_weekday(base: datetime, weekday_char: str, prefix: str) -> datetime:
 
 def extract_time_range(text: str) -> dict[str, object]:
     working = text.replace("正午", "12:00")
-    working = working.translate(str.maketrans({"－": "-", "ー": "-", "−": "-", "–": "-", "—": "-"}))
+    working = working.translate(
+        str.maketrans(
+            {
+                "－": "-",
+                "−": "-",
+                "–": "-",
+                "—": "-",
+                "―": "-",
+                "‐": "-",
+                "‑": "-",
+                "‒": "-",
+            }
+        )
+    )
     working = re.sub(r"\s*:\s*", ":", working)
     working = re.sub(r"([0-2]?\d)\s*時半", r"\1:30", working)
     working = re.sub(r"([0-2]?\d)\s*時\s*([0-5]?\d)\s*分", r"\1:\2", working)
     working = re.sub(r"([0-2]?\d)\s*時(?!\d)", r"\1:00", working)
 
+    time_sep = r"(?:\s*(?:から|より|to|[-－ー―—–−‐‑‒~～〜∼])\s*)"
     pattern = re.compile(
         r"(?<!\d)(?:(午前|午後|夕方|夜|昼)\s*)?([01]?\d|2[0-3])(?::([0-5]?\d))?"
-        r"(?:\s*(?:から|より|-|~|〜|～)\s*"
+        rf"(?:{time_sep}"
         r"(?:(午前|午後|夕方|夜|昼)\s*)?([01]?\d|2[0-3])(?::([0-5]?\d))?)?"
-        r"(?!\d)"
+        r"(?!\d)",
+        re.IGNORECASE,
     )
     match = next((candidate for candidate in pattern.finditer(working) if looks_like_time(candidate)), None)
     if not match:
diff --git a/backend/test_server.py b/backend/test_server.py
index cab96507dc53a98963096c7f9647911dba150075..fbe353e9b35ef6347caf62a39b887ea4cb58dbb4 100644
--- a/backend/test_server.py
+++ b/backend/test_server.py
@@ -240,6 +240,93 @@ class BackendServerTest(unittest.TestCase):
         self.assertEqual(event.subject, "会議")
         self.assertFalse(event.all_day)
 
+    def test_parse_event_text_supports_various_time_range_delimiters(self) -> None:
+        base = datetime(2026, 5, 18, 9, 0, tzinfo=ZoneInfo("Asia/Tokyo"))
+
+        patterns = [
+            "13:00-15:00 会議",
+            "13:00 - 15:00 会議",
+            "13:00ー15:00 会議",
+            "13:00 ー 15:00 会議",
+            "13:00―15:00 会議",
+            "13:00 ― 15:00 会議",
+            "13:00to15:00 会議",
+            "13:00 to 15:00 会議",
+            "13:00TO15:00 会議",
+            "13:00 TO 15:00 会議",
+            "13:00To15:00 会議",
+            "13:00 To 15:00 会議",
+            "13:00～15:00 会議",
+            "13:00 ～ 15:00 会議",
+            "13:00〜15:00 会議",
+            "13:00 〜 15:00 会議",
+            "１３：００－１５：００ 会議",
+            "１３：００ー１５：００ 会議",
+            "１３：００―１５：００ 会議",
+            "１３：００ｔｏ１５：００ 会議",
+            "１３：００ ＴＯ １５：００ 会議",
+            "１３：００～１５：００ 会議",
+            "13時ー15時 会議",
+            "13時―15時 会議",
+            "13時to15時 会議",
+            "13時 TO 15時 会議",
+            "13時～15時 会議",
+            "13時-15時 会議",
+            "13:00　to　15:00 会議",
+            "13:00　ー　15:00 会議",
+            "13:00　～　15:00 会議",
+            "午後1:00-午後3:00 会議",
+            "午後1:00to午後3:00 会議",
+            "午後1:00ー午後3:00 会議",
+            "午後1:00～午後3:00 会議",
+            "午後1:00 - 3:00 会議",
+            "午後1:00 to 3:00 会議",
+            "午後1:00 ー 3:00 会議",
+            "午後1:00 ～ 3:00 会議",
+        ]
+
+        for text in patterns:
+            with self.subTest(text=text):
+                event = parse_event_text(text, base)
+                self.assertEqual(event.start.isoformat(timespec="minutes"), "2026-05-18T13:00+09:00")
+                self.assertEqual(event.end.isoformat(timespec="minutes"), "2026-05-18T15:00+09:00")
+                self.assertEqual(event.duration_minutes, 120)
+                self.assertEqual(event.subject, "会議")
+                self.assertFalse(event.all_day)
+
+        date_patterns = [
+            "5/20 13:00-15:00 会議",
+            "5/20 13:00ー15:00 会議",
+            "5/20 13:00―15:00 会議",
+            "5/20 13:00to15:00 会議",
+            "5/20 13:00 TO 15:00 会議",
+            "5/20 13:00～15:00 会議",
+            "5/20 13:00〜15:00 会議",
+        ]
+        for text in date_patterns:
+            with self.subTest(text=text):
+                event = parse_event_text(text, base)
+                self.assertEqual(event.start.isoformat(timespec="minutes"), "2026-05-20T13:00+09:00")
+                self.assertEqual(event.end.isoformat(timespec="minutes"), "2026-05-20T15:00+09:00")
+                self.assertEqual(event.duration_minutes, 120)
+                self.assertEqual(event.subject, "会議")
+                self.assertFalse(event.all_day)
+
+    def test_parse_event_text_preserves_katakana_chouon_in_subject(self) -> None:
+        base = datetime(2026, 5, 18, 9, 0, tzinfo=ZoneInfo("Asia/Tokyo"))
+        cases = [
+            ("13:00-15:00 セミナー", "セミナー"),
+            ("13:00to15:00 ユーザーミーティング", "ユーザーミーティング"),
+            ("13:00ー15:00 リーダー会議", "リーダー会議"),
+        ]
+        for text, expected_subject in cases:
+            with self.subTest(text=text):
+                event = parse_event_text(text, base)
+                self.assertEqual(event.subject, expected_subject)
+                self.assertEqual(event.start.isoformat(timespec="minutes"), "2026-05-18T13:00+09:00")
+                self.assertEqual(event.end.isoformat(timespec="minutes"), "2026-05-18T15:00+09:00")
+
+
     def test_parse_event_text_uses_one_hour_for_start_time_only(self) -> None:
         base = datetime(2026, 5, 18, 9, 0, tzinfo=ZoneInfo("Asia/Tokyo"))
 
