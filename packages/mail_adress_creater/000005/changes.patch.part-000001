diff --git a/backend/test_python_env.py b/backend/test_python_env.py
index af2d73da07b40341970a15bf8bbe61e72d7492a5..55d33b17b32d906f1d24e96cba1c2916702a923b 100644
--- a/backend/test_python_env.py
+++ b/backend/test_python_env.py
@@ -13,7 +13,9 @@ Windows上での実行はこのMacでは確かめられないので、スクリ
 """
 from __future__ import annotations
 
+import ast
 import re
+import sys
 import unittest
 from pathlib import Path
 
@@ -52,6 +54,25 @@ class RequirementsLockTest(unittest.TestCase):
     def test_lock_installs_pywin32_only_on_windows(self) -> None:
         self.assertRegex(LOCK.read_text(encoding="utf-8"), re.compile(r"^pywin32==\S+ ; sys_platform == 'win32'$", re.MULTILINE))
 
+    def test_lock_installs_tzdata_only_on_windows(self) -> None:
+        # Windowsはタイムゾーン情報を持たないので、tzdataが無いと ZoneInfo("Asia/Tokyo") で起動に失敗する
+        self.assertRegex(LOCK.read_text(encoding="utf-8"), re.compile(r"^tzdata==\S+ ; sys_platform == 'win32'$", re.MULTILINE))
+
+    def test_every_third_party_import_is_required(self) -> None:
+        # 読み込むモジュール名と、それを提供するパッケージ名の対応。新しい依存を足したらここにも足す
+        providers = {"win32com": "pywin32", "pythoncom": "pywin32"}
+        imported: set[str] = set()
+        for path in (ROOT / "backend").rglob("*.py"):
+            for node in ast.walk(ast.parse(path.read_text(encoding="utf-8"))):
+                if isinstance(node, ast.Import):
+                    imported.update(alias.name.split(".")[0] for alias in node.names)
+                elif isinstance(node, ast.ImportFrom) and node.level == 0 and node.module:
+                    imported.add(node.module.split(".")[0])
+        third_party = imported - set(sys.stdlib_module_names) - {"backend"}
+        self.assertLessEqual(third_party, providers.keys(), "requirements.txt に対応が無い import があります")
+        required = _names(ROOT / "backend" / "requirements.txt")
+        self.assertLessEqual({providers[name] for name in third_party}, required)
+
     def test_lock_declares_utf8_first(self) -> None:
         # 宣言が無いと、pipが日本語版Windowsの既定（cp932）で読み、日本語コメントで失敗することがある
         self.assertEqual(LOCK.read_bytes().splitlines()[0], b"# -*- coding: utf-8 -*-")
diff --git a/setup_windows.bat b/setup_windows.bat
index d47173608f9e20359708b05303b6e160d171537f..d27cb2ba42215cef6a6e497ae3e076710969ee1c 100644
--- a/setup_windows.bat
+++ b/setup_windows.bat
@@ -8,7 +8,7 @@ rem 1. Find Python 3.14 (py -3.14 first, then python). Stop if it is missing.
 rem 2. Create .venv. Reuse it when it already runs on Python 3.14; otherwise
 rem    (broken, or made with another Python version) recreate it. Only the
 rem    contents of .venv are replaced. Never install into the system Python.
-rem 3. Install backend\requirements-lock.txt (pywin32, pinned) with pip.
+rem 3. Install backend\requirements-lock.txt (pywin32 and tzdata, pinned) with pip.
 rem Usage: double-click. Safe to run again.
 rem   start_windows.bat calls it with /nopause when .venv is missing.
 rem   If a proxy is required, configure pip (pip.ini or HTTPS_PROXY) first.
@@ -53,7 +53,7 @@ echo [Setup] Installing backend\requirements-lock.txt ...
 "%VENV_PY%" -m pip install -r backend\requirements-lock.txt
 if errorlevel 1 goto :fail
 
-"%VENV_PY%" -c "import win32com.client, sys; print('[Setup] Python', sys.version.split()[0], '/ pywin32 OK')"
+"%VENV_PY%" -c "import win32com.client, sys, zoneinfo; zoneinfo.ZoneInfo('Asia/Tokyo'); print('[Setup] Python', sys.version.split()[0], '/ pywin32 and tzdata OK')"
 if errorlevel 1 goto :fail
 
 echo [Setup] Done. Start the app with start_windows.bat
