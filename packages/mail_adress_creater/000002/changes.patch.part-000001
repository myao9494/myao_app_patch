   })
+
+  it('javascript: などスクリプトを実行するURLは href / src から取り除き、通常のURLは残す', () => {
+    const html = [
+      '<a href="javascript:alert(1)">a</a>',
+      '<a href=" JaVa\tScRiPt:alert(1)">b</a>',
+      '<img src="vbscript:msgbox(1)">',
+      '<a href="https://example.com/?q=javascript:">c</a>',
+      '<a href="mailto:user@example.com">d</a>',
+    ].join('')
+
+    const result = sanitizeHtml(html)
+
+    expect(result).not.toMatch(/javascript:alert|vbscript/i)
+    expect(result).toContain('<a>a</a>')
+    expect(result).toContain('<a>b</a>')
+    expect(result).toContain('href="https://example.com/?q=javascript:"')
+    expect(result).toContain('href="mailto:user@example.com"')
+  })
 })
diff --git a/src/utils/htmlSanitizer.ts b/src/utils/htmlSanitizer.ts
index c5b7dcf8ec9d3e971f78e11675c7167b75b9a332..4592bd8d6a2e957f224a7110a04e7f458b3cf863 100644
--- a/src/utils/htmlSanitizer.ts
+++ b/src/utils/htmlSanitizer.ts
@@ -33,6 +33,16 @@ const ALLOWED_ATTRIBUTES = [
   'target',
 ];
 
+/**
+ * スクリプトを実行しうるURLスキーム（javascript:, vbscript:）かどうか
+ * 制御文字や空白を挟んだ難読化（"java\tscript:"）も同じ扱いにする
+ */
+function isScriptUrl(value: string): boolean {
+  // eslint-disable-next-line no-control-regex
+  const compact = value.replace(/[\u0000-\u0020]/g, '').toLowerCase()
+  return compact.startsWith('javascript:') || compact.startsWith('vbscript:')
+}
+
 /**
  * インラインスタイルのフィルタリングを行う
  */
@@ -109,6 +119,9 @@ export function sanitizeHtml(html: string): string {
       } else if (!ALLOWED_ATTRIBUTES.includes(name)) {
         // classやid、その他Office固有の独自属性(x:strなど)はすべて除去する
         el.removeAttribute(attr.name);
+      } else if ((name === 'href' || name === 'src') && isScriptUrl(attr.value)) {
+        // 貼り付け元のリンクでスクリプトが実行されないようにする
+        el.removeAttribute(attr.name);
       }
     });
   }
