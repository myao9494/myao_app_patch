-def job_lock(job_name: str) -> threading.Lock:
-    with JOB_LOCKS_LOCK:
-        if job_name not in JOB_LOCKS:
-            JOB_LOCKS[job_name] = threading.Lock()
-        return JOB_LOCKS[job_name]
-
