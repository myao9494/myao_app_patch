diff --git a/src/components/ScheduleSection.tsx b/src/components/ScheduleSection.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..bc2d31c7c0c2f06d6d34f4ed54e7ed62f34f2d44
--- /dev/null
+++ b/src/components/ScheduleSection.tsx
@@ -0,0 +1,119 @@
+/**
+ * 予定入力セクション
+ * 自然文を解析して件名・日時・場所・本文を編集し、Outlook予定表へ追加する
+ */
+import type { ScheduleController } from '../hooks/useScheduleDraft'
+import type { RunningAction } from '../hooks/useOperation'
+import { toDateTimeLocalValue, toIsoFromDateTimeLocal } from '../utils/dateTime'
+import { HtmlEditor } from './HtmlEditor'
+import { scheduleInputClass } from './styles'
+
+type ScheduleSectionProps = {
+  schedule: ScheduleController
+  runningAction: RunningAction | null
+}
+
+export function ScheduleSection({ schedule, runningAction }: ScheduleSectionProps) {
+  const { event } = schedule
+  const busy = runningAction !== null
+  return (
+    <section className="shrink-0 grid gap-2 bg-gray-950/55 border border-gray-700/60 rounded-lg p-2 md:grid-cols-[1fr_auto]">
+      <label className="flex flex-col gap-1 text-[11px] text-gray-300">
+        予定を自然文で入力
+        <input
+          type="text"
+          value={schedule.text}
+          onChange={e => schedule.changeText(e.target.value)}
+          onKeyDown={e => {
+            if (e.key === 'Enter') {
+              e.preventDefault()
+              void schedule.parse()
+            }
+          }}
+          placeholder="例: 今週の水曜日 15:00から16:30 調整会議"
+          className="px-3 py-2 rounded bg-gray-950/80 border border-gray-700 text-sm text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500/70"
+        />
+      </label>
+      <div className="flex items-end gap-2">
+        <button
+          type="button"
+          onClick={() => void schedule.parse()}
+          disabled={busy}
+          className="px-3 py-2 rounded bg-indigo-600 text-white text-xs font-medium hover:bg-indigo-500 disabled:bg-gray-600 disabled:cursor-wait"
+        >
+          {runningAction === 'schedule' ? '処理中...' : '予定解析'}
+        </button>
+        <button
+          type="button"
+          onClick={() => void schedule.add()}
+          disabled={busy}
+          className="px-3 py-2 rounded bg-rose-600 text-white text-xs font-medium hover:bg-rose-500 disabled:bg-gray-600 disabled:cursor-wait"
+        >
+          Outlook追加
+        </button>
+      </div>
+      {event && (
+        <div className="md:col-span-2 grid gap-2 rounded border border-indigo-400/30 bg-indigo-400/10 px-3 py-3 text-xs text-indigo-50 md:grid-cols-[1.2fr_180px_180px_1fr_1fr_80px]">
+          <label className="flex min-w-0 flex-col gap-1 text-indigo-200">
+            件名
+            <input
+              type="text"
+              value={event.subject}
+              onChange={e => schedule.update({ subject: e.target.value })}
+              className={scheduleInputClass}
+            />
+          </label>
+          <label className="flex flex-col gap-1 text-indigo-200">
+            開始
+            <input
+              type="datetime-local"
+              value={toDateTimeLocalValue(event.start)}
+              step={300}
+              onChange={e => schedule.update({ start: toIsoFromDateTimeLocal(e.target.value) })}
+              onWheel={e => schedule.wheel(e, 'start')}
+              className={scheduleInputClass}
+            />
+          </label>
+          <label className="flex flex-col gap-1 text-indigo-200">
+            終了
+            <input
+              type="datetime-local"
+              value={toDateTimeLocalValue(event.end)}
+              step={300}
+              onChange={e => schedule.update({ end: toIsoFromDateTimeLocal(e.target.value) })}
+              onWheel={e => schedule.wheel(e, 'end')}
+              disabled={event.all_day}
+              className={`${scheduleInputClass} disabled:opacity-50`}
+            />
+          </label>
+          <label className="flex min-w-0 flex-col gap-1 text-indigo-200">
+            場所
+            <input
+              type="text"
+              value={event.location}
+              onChange={e => schedule.update({ location: e.target.value })}
+              className={scheduleInputClass}
+            />
+          </label>
+          <label className="flex min-w-0 flex-col gap-1 text-indigo-200">
+            本文
+            <HtmlEditor
+              value={event.body}
+              onChange={body => schedule.update({ body })}
+              className="min-h-[38px] max-h-[120px] overflow-auto px-2 py-2 rounded bg-gray-950/80 border border-indigo-300/30 text-sm text-gray-100 focus:ring-1 focus:ring-indigo-400"
+            />
+          </label>
+          <label className="flex items-end gap-2 pb-2 text-indigo-100">
+            <input
+              type="checkbox"
+              checked={event.all_day}
+              onChange={e => schedule.update({ all_day: e.target.checked })}
+              className="h-4 w-4 accent-indigo-500"
+            />
+            終日
+          </label>
+        </div>
+      )}
+    </section>
+  )
+}
diff --git a/src/components/SettingsPanel.tsx b/src/components/SettingsPanel.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..7bd37d15f7417f622e8a808b4ed662e9dba0291d
--- /dev/null
+++ b/src/components/SettingsPanel.tsx
@@ -0,0 +1,113 @@
+/**
+ * 設定メニュー（ハンバーガーメニューの中身）
+ * 上段: キーワード・自動実行間隔・保存・ダミーデータ投入 / 下段: プロフィール（かんたんコピー用）
+ */
+import type { BackendSettings } from '../utils/api'
+import type { RunningAction } from '../hooks/useOperation'
+import { settingsInputClass } from './styles'
+
+const PROFILE_FIELDS: Array<{
+  key: 'my_email' | 'my_phone' | 'my_address' | 'my_dept' | 'my_home_email'
+  label: string
+  type: 'email' | 'text'
+  placeholder: string
+}> = [
+  { key: 'my_email', label: 'メールアドレス', type: 'email', placeholder: 'your.email@example.com' },
+  { key: 'my_phone', label: '電話番号', type: 'text', placeholder: '090-0000-0000' },
+  { key: 'my_address', label: '住所', type: 'text', placeholder: '住所を入力してください' },
+  { key: 'my_dept', label: '部署', type: 'text', placeholder: '部署を入力してください' },
+  { key: 'my_home_email', label: '家アド', type: 'email', placeholder: 'home.email@example.com' },
+]
+
+type SettingsPanelProps = {
+  settings: BackendSettings
+  keywordText: string
+  runningAction: RunningAction | null
+  onKeywordTextChange: (text: string) => void
+  onSettingChange: <K extends keyof BackendSettings>(key: K, value: BackendSettings[K]) => void
+  onSave: () => void
+  onSeedDummy: () => void
+}
+
+export function SettingsPanel({
+  settings,
+  keywordText,
+  runningAction,
+  onKeywordTextChange,
+  onSettingChange,
+  onSave,
+  onSeedDummy,
+}: SettingsPanelProps) {
+  return (
+    <div className="mt-2 flex flex-col gap-3 bg-gray-900/80 border border-gray-700/60 rounded p-3 shadow-inner">
+      <div className="grid gap-2 md:grid-cols-[1fr_220px_220px_auto_auto]">
+        <label className="flex flex-col gap-1 text-[11px] text-gray-300">
+          キーワード
+          <input
+            type="text"
+            value={keywordText}
+            onChange={e => onKeywordTextChange(e.target.value)}
+            placeholder="棚卸,棚おろし,ユーザID"
+            className={settingsInputClass}
+          />
+        </label>
+        <label className="flex flex-col gap-1 text-[11px] text-gray-300">
+          アドレス再取得の頻度（分）
+          <input
+            type="number"
+            min={1}
+            value={settings.address_interval_minutes}
+            onChange={e => onSettingChange('address_interval_minutes', Number(e.target.value) || 1)}
+            className={settingsInputClass}
+          />
+          <span className="text-[10px] text-gray-500">既定値: 43200分（1ヶ月）</span>
+        </label>
+        <label className="flex flex-col gap-1 text-[11px] text-gray-300">
+          キーワードチェックの頻度（分）
+          <input
+            type="number"
+            min={1}
+            value={settings.keyword_interval_minutes}
+            onChange={e => onSettingChange('keyword_interval_minutes', Number(e.target.value) || 1)}
+            className={settingsInputClass}
+          />
+          <span className="text-[10px] text-gray-500">既定値: 60分（1時間）</span>
+        </label>
+        <div className="flex items-end">
+          <button
+            type="button"
+            onClick={onSave}
+            className="w-full px-3 py-2 rounded bg-gray-100 text-gray-950 text-xs font-semibold hover:bg-white"
+          >
+            設定保存
+          </button>
+        </div>
+        <div className="flex items-end">
+          <button
+            type="button"
+            onClick={onSeedDummy}
+            disabled={runningAction !== null}
+            className="w-full px-3 py-2 rounded bg-amber-400 text-gray-950 text-xs font-semibold hover:bg-amber-300 disabled:bg-gray-600 disabled:text-gray-300 disabled:cursor-wait"
+          >
+            {runningAction === 'dummy' ? '投入中...' : 'ダミーデータ投入'}
+          </button>
+        </div>
+      </div>
+
+      <div className="border-t border-gray-800/80 pt-2 grid gap-2 md:grid-cols-5">
+        {PROFILE_FIELDS.map(({ key, label, type, placeholder }) => (
+          <label key={key} className="flex flex-col gap-1 text-[11px] text-gray-300">
+            {label}
+            <input
+              type={type}
+              value={settings[key] ?? ''}
+              onChange={e => onSettingChange(key, e.target.value)}
+              placeholder={placeholder}
+              className={settingsInputClass}
+            />
+          </label>
+        ))}
+      </div>
+    </div>
+  )
+}
diff --git a/src/components/styles.ts b/src/components/styles.ts
new file mode 100644
index 0000000000000000000000000000000000000000..723e764ff3307814cecdc5f9579ae13b5dd06991
--- /dev/null
+++ b/src/components/styles.ts
@@ -0,0 +1,23 @@
+/**
+ * 複数のコンポーネントで共有するTailwindクラス
+ * （Tailwindは完全なクラス名を静的に検出するため、文字列連結ではなく定数として定義する）
+ */
+
+/** 設定メニュー内のテキスト入力 */
+export const settingsInputClass =
+  'px-2 py-2 rounded bg-gray-950/80 border border-gray-700 text-xs text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500/70'
+
+/** 予定編集欄の入力 */
+export const scheduleInputClass =
+  'px-2 py-2 rounded bg-gray-950/80 border border-indigo-300/30 text-sm text-gray-100 focus:outline-none focus:ring-1 focus:ring-indigo-400'
+
+/** ヘッダーの処理ボタン（色ごと） */
+export const headerButtonClass = {
+  blue: 'px-3 py-2 rounded bg-blue-600 text-white text-xs font-medium hover:bg-blue-500 disabled:bg-gray-600 disabled:cursor-wait',
+  emerald: 'px-3 py-2 rounded bg-emerald-600 text-white text-xs font-medium hover:bg-emerald-500 disabled:bg-gray-600 disabled:cursor-wait',
+  slate: 'px-3 py-2 rounded bg-slate-700 text-white text-xs font-medium hover:bg-slate-600 disabled:bg-gray-600 disabled:cursor-wait',
+  cyan: 'px-3 py-2 rounded bg-cyan-600 text-white text-xs font-medium hover:bg-cyan-500',
+} as const
+
+/** 画面右クリックメニューの項目 */
+export const contextMenuItemClass = 'w-full px-4 py-2 text-left hover:bg-gray-800'
diff --git a/src/hooks/useDatabaseViewer.test.ts b/src/hooks/useDatabaseViewer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a86403a1fc0bb127f8acdfe596bbb4380d740bf1
--- /dev/null
+++ b/src/hooks/useDatabaseViewer.test.ts
@@ -0,0 +1,139 @@
+/**
+ * useDatabaseViewerフックのテスト
+ * 閲覧・選択削除・ダミーデータ投入の確認ダイアログと、削除後の同期を確認する
+ */
+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest'
+import { renderHook, act } from '@testing-library/react'
+import { useDatabaseViewer } from './useDatabaseViewer'
+import { useTestOperations } from '../test/operations'
+import { deleteDatabaseRecords, loadDatabase, seedDummyData, type DatabaseSnapshot } from '../utils/api'
+
+vi.mock('../utils/api', async importOriginal => ({
+  ...(await importOriginal<typeof import('../utils/api')>()),
+  loadDatabase: vi.fn(),
+  deleteDatabaseRecords: vi.fn(),
+  seedDummyData: vi.fn(),
+}))
+
+const snapshot = (favorites: DatabaseSnapshot['favorites'] = []): DatabaseSnapshot => ({
+  settings: [],
+  recipients: [],
+  favorites,
+  keyword_matches: [],
+  job_runs: [],
+})
+
+function setup() {
+  const reloadRecipients = vi.fn().mockResolvedValue(undefined)
+  const onFavoritesChanged = vi.fn()
+  const hook = renderHook(() => {
+    const ops = useTestOperations()
+    return { ...ops, viewer: useDatabaseViewer(ops.operations, { reloadRecipients, onFavoritesChanged }) }
+  })
+  return { ...hook, reloadRecipients, onFavoritesChanged }
+}
+
+describe('useDatabaseViewer', () => {
+  beforeEach(() => {
+    vi.mocked(loadDatabase).mockReset()
+    vi.mocked(deleteDatabaseRecords).mockReset()
+    vi.mocked(seedDummyData).mockReset()
+  })
+  afterEach(() => vi.restoreAllMocks())
+
+  it('読み込むと開き、テーブルを切り替えると選択をクリアする', async () => {
+    vi.mocked(loadDatabase).mockResolvedValue(snapshot())
+    const { result } = setup()
+
+    await act(() => result.current.viewer.load())
+    act(() => result.current.viewer.setSelectedKeys(['1']))
+    act(() => result.current.viewer.selectTable('recipients'))
+
+    expect(result.current.viewer.open).toBe(true)
+    expect(result.current.viewer.table).toBe('recipients')
+    expect(result.current.viewer.selectedKeys).toEqual([])
+  })
+
+  it('選択が無い、またはsettingsテーブルのときは削除しない', async () => {
+    const confirm = vi.spyOn(window, 'confirm').mockReturnValue(true)
+    const { result } = setup()
+
+    await act(() => result.current.viewer.deleteSelected())
+    act(() => result.current.viewer.selectTable('settings'))
+    act(() => result.current.viewer.setSelectedKeys(['keywords']))
+    await act(() => result.current.viewer.deleteSelected())
+
+    expect(confirm).not.toHaveBeenCalled()
+    expect(deleteDatabaseRecords).not.toHaveBeenCalled()
+  })
+
+  it('削除の確認でキャンセルしたら何もしない', async () => {
+    vi.spyOn(window, 'confirm').mockReturnValue(false)
+    const { result } = setup()
+    act(() => result.current.viewer.selectTable('recipients'))
+    act(() => result.current.viewer.setSelectedKeys(['山田']))
+
+    await act(() => result.current.viewer.deleteSelected())
+
+    expect(deleteDatabaseRecords).not.toHaveBeenCalled()
+  })
+
+  it('宛先を削除すると結果を反映し、宛先一覧を再読み込みする', async () => {
+    vi.spyOn(window, 'confirm').mockReturnValue(true)
+    vi.mocked(deleteDatabaseRecords).mockResolvedValue({ result: { table: 'recipients', deleted: 1 }, database: snapshot() })
+    const { result, reloadRecipients, onFavoritesChanged } = setup()
+    act(() => result.current.viewer.selectTable('recipients'))
+    act(() => result.current.viewer.setSelectedKeys(['山田']))
+
+    await act(() => result.current.viewer.deleteSelected())
+
+    expect(deleteDatabaseRecords).toHaveBeenCalledWith('recipients', ['山田'])
+    expect(reloadRecipients).toHaveBeenCalled()
+    expect(onFavoritesChanged).not.toHaveBeenCalled()
+    expect(result.current.showToast).toHaveBeenCalledWith('1件を削除しました')
+  })
+
+  it('お気に入りを削除すると、画面のお気に入り一覧へ同期する', async () => {
+    vi.spyOn(window, 'confirm').mockReturnValue(true)
+    const remaining = [{ name: '営業', addresses: ['高橋'], cc_addresses: [], updated_at: '' }]
+    vi.mocked(deleteDatabaseRecords).mockResolvedValue({ result: { table: 'favorites', deleted: 1 }, database: snapshot(remaining) })
+    const { result, onFavoritesChanged } = setup()
+    act(() => result.current.viewer.selectTable('favorites'))
+    act(() => result.current.viewer.setSelectedKeys(['開発']))
+
+    await act(() => result.current.viewer.deleteSelected())
+
+    expect(onFavoritesChanged).toHaveBeenCalledWith(remaining)
+  })
+
+  it('ダミーデータ投入は確認でキャンセルされたら実行しない', async () => {
+    vi.spyOn(window, 'confirm').mockReturnValue(false)
+    const { result } = setup()
+
+    await act(() => result.current.viewer.seedDummy())
+
+    expect(seedDummyData).not.toHaveBeenCalled()
+  })
+
+  it('ダミーデータ投入は確認OKなら実行し、宛先を再読み込みする', async () => {
+    vi.spyOn(window, 'confirm').mockReturnValue(true)
+    vi.mocked(seedDummyData).mockResolvedValue({ inserted: { recipients: 4 }, database: snapshot() })
+    const { result, reloadRecipients } = setup()
+
+    await act(() => result.current.viewer.seedDummy())
+
+    expect(reloadRecipients).toHaveBeenCalled()
+    expect(result.current.viewer.open).toBe(true)
+    expect(result.current.showToast).toHaveBeenCalledWith('ダミーデータを投入しました（宛先 4件）')
+  })
+
+  it('失敗したらエラーメッセージを表示する', async () => {
+    vi.mocked(loadDatabase).mockRejectedValue(new Error('backend down'))
+    const { result } = setup()
+
+    await act(() => result.current.viewer.load())
+
+    expect(result.current.operation.error).toBe('backend down')
+    expect(result.current.viewer.open).toBe(false)
+  })
+})
diff --git a/src/hooks/useDatabaseViewer.ts b/src/hooks/useDatabaseViewer.ts
new file mode 100644
index 0000000000000000000000000000000000000000..dee047dcc6ca151f79ef77bbd961e70df32b54aa
--- /dev/null
+++ b/src/hooks/useDatabaseViewer.ts
@@ -0,0 +1,89 @@
+/**
+ * SQLiteの内容閲覧・選択削除・ダミーデータ投入
+ */
+import { useCallback, useState } from 'react'
+import {
+  deleteDatabaseRecords,
+  loadDatabase,
+  seedDummyData,
+  type DatabaseSnapshot,
+  type Favorite,
+} from '../utils/api'
+import type { Operations } from './useOperation'
+
+export type DatabaseTableName = keyof DatabaseSnapshot
+export type DeletableDatabaseTableName = Exclude<DatabaseTableName, 'settings'>
+
+type Dependencies = {
+  /** 宛先一覧（CSV）を再読み込みする */
+  reloadRecipients: () => Promise<void>
+  /** お気に入りがDB側で変わったときに画面の一覧を同期する */
+  onFavoritesChanged: (favorites: Favorite[]) => void
+}
+
+export function useDatabaseViewer(
+  { run, showToast }: Operations,
+  { reloadRecipients, onFavoritesChanged }: Dependencies,
+) {
+  const [open, setOpen] = useState(false)
+  const [snapshot, setSnapshot] = useState<DatabaseSnapshot | null>(null)
+  const [table, setTable] = useState<DatabaseTableName>('keyword_matches')
+  const [selectedKeys, setSelectedKeys] = useState<string[]>([])
+
+  const show = useCallback((next: DatabaseSnapshot) => {
+    setSnapshot(next)
+    setOpen(true)
+    setSelectedKeys([])
+  }, [])
+
+  const load = useCallback(() => run('database', 'DBの読み込みに失敗しました', async () => {
+    show(await loadDatabase())
+    showToast('DBを読み込みました')
+  }), [run, show, showToast])
+
+  const selectTable = useCallback((next: DatabaseTableName) => {
+    setTable(next)
+    setSelectedKeys([])
+  }, [])
+
+  const close = useCallback(() => setOpen(false), [])
+
+  const deleteSelected = useCallback(async () => {
+    if (table === 'settings' || selectedKeys.length === 0) {
+      return
+    }
+    if (!window.confirm(`${table} の選択レコード ${selectedKeys.length}件を削除します。よろしいですか？`)) {
+      return
+    }
+    await run('database', 'DBレコード削除に失敗しました', async () => {
+      const result = await deleteDatabaseRecords(table, selectedKeys)
+      setSnapshot(result.database)
+      if (table === 'favorites') {
+        onFavoritesChanged(result.database.favorites)
+      }
+      setSelectedKeys([])
+      await reloadRecipients()
+      showToast(`${result.result.deleted}件を削除しました`)
+    })
+  }, [onFavoritesChanged, reloadRecipients, run, selectedKeys, showToast, table])
+
+  /** 実データを上書きするため、確認ダイアログでOKされた場合のみ実行する */
+  const seedDummy = useCallback(async () => {
+    const confirmed = window.confirm(
+      'ダミーデータを投入します。現在の宛先一覧（DBと送信履歴CSV）はダミーデータで上書きされ、元に戻せません。よろしいですか？',
+    )
+    if (!confirmed) {
+      return
+    }
+    await run('dummy', 'ダミーデータ投入に失敗しました', async () => {
+      const result = await seedDummyData()
+      show(result.database)
+      await reloadRecipients()
+      showToast(`ダミーデータを投入しました（宛先 ${result.inserted.recipients}件）`)
+    })
+  }, [reloadRecipients, run, show, showToast])
+
+  return { open, snapshot, table, selectedKeys, setSelectedKeys, selectTable, load, close, deleteSelected, seedDummy }
+}
+
+export type DatabaseViewerController = ReturnType<typeof useDatabaseViewer>
diff --git a/src/hooks/useFavorites.test.ts b/src/hooks/useFavorites.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..86f533a7a50afe78266a02c57234831f28569153
--- /dev/null
+++ b/src/hooks/useFavorites.test.ts
@@ -0,0 +1,195 @@
+/**
+ * useFavoritesフックのテスト
+ * 保存時の入力検証、新規名の採番、削除、現在の選択状態からの追加を確認する
+ */
+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest'
+import { renderHook, act, waitFor } from '@testing-library/react'
+import { useFavorites } from './useFavorites'
+import { useTestOperations } from '../test/operations'
+import { addFavorite, loadFavorites, saveFavorites, type Favorite } from '../utils/api'
+
+vi.mock('../utils/api', async importOriginal => ({
+  ...(await importOriginal<typeof import('../utils/api')>()),
+  loadFavorites: vi.fn(),
+  saveFavorites: vi.fn(),
+  addFavorite: vi.fn(),
+}))
+
+const dev: Favorite = { name: '開発', addresses: ['山田', '佐藤'], cc_addresses: ['鈴木'] }
+const sales: Favorite = { name: '営業', addresses: ['高橋'], cc_addresses: [] }
+
+async function setup(initial: Favorite[] = [dev, sales]) {
+  vi.mocked(loadFavorites).mockResolvedValue({ favorites: initial })
+  const hook = renderHook(() => {
+    const ops = useTestOperations()
+    return { ...ops, favorites: useFavorites(ops.operations) }
+  })
+  await waitFor(() => expect(hook.result.current.favorites.favorites).toEqual(initial))
+  return hook
+}
+
+describe('useFavorites', () => {
+  beforeEach(() => {
+    vi.mocked(saveFavorites).mockReset()
+    vi.mocked(addFavorite).mockReset()
+  })
+  afterEach(() => vi.restoreAllMocks())
+
+  it('読み込み後は先頭のお気に入りを選択し、下書きに内容を入れる', async () => {
+    const { result } = await setup()
+
+    expect(result.current.favorites.selectedName).toBe('開発')
+    expect(result.current.favorites.draft).toEqual({ name: '開発', toText: '山田\n佐藤', ccText: '鈴木' })
+  })
+
+  it('新規作成では重複しない名前を採番し、空の下書きにする', async () => {
+    const { result } = await setup([{ ...dev, name: '新しいお気に入り3' }, sales])
+
+    act(() => result.current.favorites.startNew())
+
+    expect(result.current.favorites.selectedName).toBe('')
+    expect(result.current.favorites.draft).toEqual({ name: '新しいお気に入り4', toText: '', ccText: '' })
+  })
+
+  it('名前が空の保存はAPIを呼ばずにエラーを表示する', async () => {
+    const { result } = await setup()
+    act(() => result.current.favorites.updateDraft({ name: '  ' }))
+
+    await act(() => result.current.favorites.saveDraft())
+
+    expect(saveFavorites).not.toHaveBeenCalled()
+    expect(result.current.operation.error).toBe('お気に入り名を入力してください')
+  })
+
+  it('宛先もCCも空の保存はAPIを呼ばずにエラーを表示する', async () => {
+    const { result } = await setup()
+    act(() => result.current.favorites.updateDraft({ toText: '', ccText: '' }))
+
+    await act(() => result.current.favorites.saveDraft())
+
+    expect(saveFavorites).not.toHaveBeenCalled()
+    expect(result.current.operation.error).toContain('宛先またはCC')
+  })
+
+  it('名前を変えて保存すると、元の名前を置き換えた一覧をAPIへ送る', async () => {
+    const { result } = await setup()
+    const renamed = { name: '開発チーム', addresses: ['山田', '佐藤'], cc_addresses: ['鈴木'] }
+    vi.mocked(saveFavorites).mockResolvedValue({ favorites: [sales, renamed] })
+    act(() => result.current.favorites.updateDraft({ name: '開発チーム' }))
+
+    await act(() => result.current.favorites.saveDraft())
+
+    expect(saveFavorites).toHaveBeenCalledWith([sales, renamed])
+    expect(result.current.favorites.selectedName).toBe('開発チーム')
+    expect(result.current.showToast).toHaveBeenCalledWith('お気に入りを保存しました')
+  })
+
+  it('削除は確認ダイアログでキャンセルすると何もしない', async () => {
+    const { result } = await setup()
+    vi.spyOn(window, 'confirm').mockReturnValue(false)
+
+    await act(() => result.current.favorites.deleteSelected())
+
+    expect(saveFavorites).not.toHaveBeenCalled()
+  })
+
+  it('削除すると残りの先頭を選択する', async () => {
+    const { result } = await setup()
+    vi.spyOn(window, 'confirm').mockReturnValue(true)
+    vi.mocked(saveFavorites).mockResolvedValue({ favorites: [sales] })
+
+    await act(() => result.current.favorites.deleteSelected())
+
+    expect(saveFavorites).toHaveBeenCalledWith([sales])
+    expect(result.current.favorites.selectedName).toBe('営業')
+  })
+
+  it('現在の選択が空のときはお気に入りに追加せずエラーを表示する', async () => {
+    const { result } = await setup()
+
+    await act(() => result.current.favorites.addFromSelection([], []))
+
+    expect(addFavorite).not.toHaveBeenCalled()
+    expect(result.current.operation.error).toBe('現在選択されている宛先またはCCがありません')
+  })
+
+  it('現在の選択をお気に入りに追加するとき、★付きの名前は取り除く', async () => {
+    const { result } = await setup()
+    vi.spyOn(window, 'prompt').mockReturnValue(' 新グループ ')
+    vi.mocked(addFavorite).mockResolvedValue({
+      favorite: { name: '新グループ', addresses: ['山田'], cc_addresses: ['営業'] },
+      favorites: [dev, sales],
+    })
+
+    await act(() => result.current.favorites.addFromSelection(['山田'], ['★ 営業']))
+
+    expect(addFavorite).toHaveBeenCalledWith('新グループ', ['山田'], ['営業'])
+  })
+
+  it('名前入力をキャンセルしたら追加しない', async () => {
+    const { result } = await setup()
+    vi.spyOn(window, 'prompt').mockReturnValue(null)
+
+    await act(() => result.current.favorites.addFromSelection(['山田'], []))
+
+    expect(addFavorite).not.toHaveBeenCalled()
+  })
+
+  it('DB側の削除後の同期では、選択中のお気に入りが残っていれば選択を保つ', async () => {
+    const { result } = await setup()
+    act(() => result.current.favorites.select(sales))
+
+    act(() => result.current.favorites.syncFavorites([sales]))
+    expect(result.current.favorites.selectedName).toBe('営業')
+
+    act(() => result.current.favorites.syncFavorites([dev]))
+    expect(result.current.favorites.selectedName).toBe('開発')
+  })
+
+  it('一覧の右クリックから追加すると、Toの場合は宛先側、CCの場合はCC側に1件だけ登録する', async () => {
+    const { result } = await setup()
+    vi.spyOn(window, 'prompt').mockReturnValue('単発')
+    vi.mocked(addFavorite).mockResolvedValue({
+      favorite: { name: '単発', addresses: ['山田'], cc_addresses: [] },
+      favorites: [dev, sales],
+    })
+
+    await act(() => result.current.favorites.addFromRecipient('★ 山田', false))
+    expect(addFavorite).toHaveBeenLastCalledWith('単発', ['山田'], [])
+    expect(result.current.favorites.selectedName).toBe('単発')
+
+    await act(() => result.current.favorites.addFromRecipient('鈴木', true))
+    expect(addFavorite).toHaveBeenLastCalledWith('単発', [], ['鈴木'])
+  })
+
+  it('一覧の右クリックからの追加は、名前入力をキャンセルしたら何もしない', async () => {
+    const { result } = await setup()
+    vi.spyOn(window, 'prompt').mockReturnValue('')
+
+    await act(() => result.current.favorites.addFromRecipient('山田', false))
+
+    expect(addFavorite).not.toHaveBeenCalled()
+  })
+
+  it('保存に失敗したらエラーを表示し、下書きは保持する', async () => {
+    const { result } = await setup()
+    vi.mocked(saveFavorites).mockRejectedValue(new Error('保存できません'))
+    act(() => result.current.favorites.updateDraft({ toText: '新しい宛先' }))
+
+    await act(() => result.current.favorites.saveDraft())
+
+    expect(result.current.operation.error).toBe('保存できません')
+    expect(result.current.favorites.draft.toText).toBe('新しい宛先')
+  })
+
+  it('新規の下書きを削除しようとすると、確認なしで下書きを空にする', async () => {
+    const { result } = await setup()
+    act(() => result.current.favorites.startNew())
+    const confirm = vi.spyOn(window, 'confirm')
+
+    await act(() => result.current.favorites.deleteSelected())
+
+    expect(confirm).not.toHaveBeenCalled()
+    expect(result.current.favorites.draft).toEqual({ name: '', toText: '', ccText: '' })
+  })
+})
diff --git a/src/hooks/useFavorites.ts b/src/hooks/useFavorites.ts
new file mode 100644
index 0000000000000000000000000000000000000000..65650616ac6b798272ae1afef806b07606d24060
--- /dev/null
+++ b/src/hooks/useFavorites.ts
@@ -0,0 +1,146 @@
+/**
+ * お気に入り（宛先とCCのセット）の一覧と、編集モーダルの下書き状態
+ */
+import { useCallback, useEffect, useState } from 'react'
+import { addFavorite, loadFavorites, saveFavorites, type Favorite } from '../utils/api'
+import { formatFavoriteAddressText, parseFavoriteAddressText, stripFavoritePrefix } from '../utils/favorites'
+import type { Operations } from './useOperation'
+
+type Draft = { name: string; toText: string; ccText: string }
+
+const EMPTY_DRAFT: Draft = { name: '', toText: '', ccText: '' }
+
+const draftOf = (favorite: Favorite | undefined): Draft =>
+  favorite
+    ? {
+        name: favorite.name,
+        toText: formatFavoriteAddressText(favorite.addresses),
+        ccText: formatFavoriteAddressText(favorite.cc_addresses ?? []),
+      }
+    : EMPTY_DRAFT
+
+export function useFavorites({ run, setError, showToast }: Operations) {
+  const [favorites, setFavorites] = useState<Favorite[]>([])
+  const [selectedName, setSelectedName] = useState('')
+  const [draft, setDraft] = useState<Draft>(EMPTY_DRAFT)
+
+  /** 指定したお気に入りを選択して下書きに読み込む（未指定なら空の下書き） */
+  const select = useCallback((favorite: Favorite | undefined) => {
+    setSelectedName(favorite?.name ?? '')
+    setDraft(draftOf(favorite))
+  }, [])
+
+  useEffect(() => {
+    void run(null, 'お気に入りの読み込みに失敗しました', async () => {
+      const result = await loadFavorites()
+      setFavorites(result.favorites)
+      select(result.favorites[0])
+    })
+  }, [run, select])
+
+  /** DB削除など外部要因で一覧が変わったときに、選択中のお気に入りを保ったまま同期する */
+  const syncFavorites = useCallback((next: Favorite[]) => {
+    setFavorites(next)
+    select(next.find(favorite => favorite.name === selectedName) ?? next[0])
+  }, [select, selectedName])
+
+  const updateDraft = useCallback((updates: Partial<Draft>) => {
+    setDraft(prev => ({ ...prev, ...updates }))
+  }, [])
+
+  const startNew = useCallback(() => {
+    let index = favorites.length + 1
+    while (favorites.some(favorite => favorite.name === `新しいお気に入り${index}`)) {
+      index += 1
+    }
+    setSelectedName('')
+    setDraft({ ...EMPTY_DRAFT, name: `新しいお気に入り${index}` })
+  }, [favorites])
+
+  const saveDraft = useCallback(async () => {
+    const name = draft.name.trim()
+    const addresses = parseFavoriteAddressText(draft.toText)
+    const cc_addresses = parseFavoriteAddressText(draft.ccText)
+    if (!name) {
+      setError('お気に入り名を入力してください')
+      return
+    }
+    if (addresses.length === 0 && cc_addresses.length === 0) {
+      setError('お気に入りの内容（宛先またはCC）を入力してください')
+      return
+    }
+    await run(null, 'お気に入りの保存に失敗しました', async () => {
+      const result = await saveFavorites([
+        ...favorites.filter(favorite => favorite.name !== selectedName && favorite.name !== name),
+        { name, addresses, cc_addresses },
+      ])
+      setFavorites(result.favorites)
+      select(result.favorites.find(favorite => favorite.name === name) ?? { name, addresses, cc_addresses })
+      showToast('お気に入りを保存しました')
+    })
+  }, [draft, favorites, run, select, selectedName, setError, showToast])
+
+  const deleteSelected = useCallback(async () => {
+    if (!selectedName) {
+      setDraft(EMPTY_DRAFT)
+      return
+    }
+    if (!window.confirm(`${selectedName} を削除します。よろしいですか？`)) {
+      return
+    }
+    await run(null, 'お気に入りの削除に失敗しました', async () => {
+      const result = await saveFavorites(favorites.filter(favorite => favorite.name !== selectedName))
+      setFavorites(result.favorites)
+      select(result.favorites[0])
+      showToast('お気に入りを削除しました')
+    })
+  }, [favorites, run, select, selectedName, showToast])
+
+  /** 一覧の右クリックから、1件をお気に入りに追加する */
+  const addFromRecipient = useCallback(async (recipientName: string, isCc: boolean) => {
+    const cleanName = stripFavoritePrefix(recipientName)
+    const favoriteName = window.prompt('お気に入り名', cleanName)
+    if (!favoriteName) {
+      return
+    }
+    await run(null, 'お気に入り追加に失敗しました', async () => {
+      const result = await addFavorite(favoriteName, isCc ? [] : [cleanName], isCc ? [cleanName] : [])
+      setFavorites(result.favorites)
+      select(result.favorite)
+      showToast(`${result.favorite.name} をお気に入りに追加しました`)
+    })
+  }, [run, select, showToast])
+
+  /** 現在の宛先・CCの選択状態を、名前を付けてお気に入りに追加する */
+  const addFromSelection = useCallback(async (toNames: string[], ccNames: string[]) => {
+    if (toNames.length === 0 && ccNames.length === 0) {
+      setError('現在選択されている宛先またはCCがありません')
+      return
+    }
+    const name = window.prompt('新しいお気に入りグループ名を入力してください')?.trim()
+    if (!name) {
+      return
+    }
+    await run(null, 'お気に入り追加に失敗しました', async () => {
+      const result = await addFavorite(name, toNames.map(stripFavoritePrefix), ccNames.map(stripFavoritePrefix))
+      setFavorites(result.favorites)
+      showToast(`現在の宛先とCCを「${result.favorite.name}」として登録しました`)
+    })
+  }, [run, setError, showToast])
+
+  return {
+    favorites,
+    selectedName,
+    draft,
+    select,
+    syncFavorites,
+    updateDraft,
+    startNew,
+    saveDraft,
+    deleteSelected,
+    addFromRecipient,
+    addFromSelection,
+  }
+}
+
+export type FavoritesController = ReturnType<typeof useFavorites>
diff --git a/src/hooks/useKeywordMatches.test.ts b/src/hooks/useKeywordMatches.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..57e32ae7ad3aad9854bd616193ba809e06c2bd32
--- /dev/null
+++ b/src/hooks/useKeywordMatches.test.ts
@@ -0,0 +1,122 @@
+/**
+ * useKeywordMatchesフックのテスト
+ * 起動時の未確認通知の復元、チェック実行、確認ボタンの動作を確認する
+ */
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+import { renderHook, act, waitFor } from '@testing-library/react'
+import { useKeywordMatches } from './useKeywordMatches'
+import { useTestOperations } from '../test/operations'
+import { checkKeywords, confirmMatches, loadUnconfirmedMatches, type KeywordMatch } from '../utils/api'
+
+vi.mock('../utils/api', async importOriginal => ({
+  ...(await importOriginal<typeof import('../utils/api')>()),
+  checkKeywords: vi.fn(),
+  confirmMatches: vi.fn(),
+  loadUnconfirmedMatches: vi.fn(),
+}))
+
+const match = (id: number | undefined, line = '棚卸の通知'): KeywordMatch => ({
+  id,
+  received_time: '2026-05-18T10:00:00',
+  subject: '職アドからのお知らせ',
+  line,
+  keyword: '棚卸',
+  is_new: true,
+})
+
+function setup() {
+  return renderHook(() => {
+    const ops = useTestOperations()
+    return { ...ops, keywords: useKeywordMatches(ops.operations) }
+  })
+}
+
+describe('useKeywordMatches', () => {
+  beforeEach(() => {
+    vi.mocked(checkKeywords).mockReset()
+    vi.mocked(confirmMatches).mockReset()
+    vi.mocked(loadUnconfirmedMatches).mockReset().mockResolvedValue({ matches: [] })
+  })
+
+  it('起動時に未確認の通知を復元する', async () => {
+    vi.mocked(loadUnconfirmedMatches).mockResolvedValue({ matches: [match(1)] })
+
+    const { result } = setup()
+
+    await waitFor(() => expect(result.current.keywords.matches).toHaveLength(1))
+  })
+
+  it('起動時の読み込みに失敗しても、エラーは表示しない', async () => {
+    vi.mocked(loadUnconfirmedMatches).mockRejectedValue(new Error('backend down'))
+
+    const { result } = setup()
+    await act(async () => {})
+
+    expect(result.current.keywords.matches).toEqual([])
+    expect(result.current.operation.error).toBeNull()
+  })
+
+  it('チェックで新規一致があれば件数付きで通知し、一覧を差し替える', async () => {
+    vi.mocked(checkKeywords).mockResolvedValue({ matches: [], new_matches: [match(2), match(3)], keywords: ['棚卸'] })
+    const { result } = setup()
+
+    await act(() => result.current.keywords.check())
+
+    expect(result.current.keywords.matches).toHaveLength(2)
+    expect(result.current.showToast).toHaveBeenCalledWith('新しい職アド通知が 2件あります')
+  })
+
+  it('新規一致が無ければ、その旨を通知する', async () => {
+    vi.mocked(checkKeywords).mockResolvedValue({ matches: [], new_matches: [], keywords: ['棚卸'] })
+    const { result } = setup()
+
+    await act(() => result.current.keywords.check())
+
+    expect(result.current.showToast).toHaveBeenCalledWith('新しい職アド通知はありません')
+  })
+
+  it('チェックに失敗するとエラーを表示し、実行中の状態を戻す', async () => {
+    vi.mocked(checkKeywords).mockRejectedValue(new Error('Outlookに接続できません'))
+    const { result } = setup()
+
+    await act(() => result.current.keywords.check())
+
+    expect(result.current.operation.error).toBe('Outlookに接続できません')
+    expect(result.current.operation.runningAction).toBeNull()
+  })
+
+  it('確認ボタンはIDのある通知だけを確認済みにして、一覧を空にする', async () => {
+    vi.mocked(loadUnconfirmedMatches).mockResolvedValue({ matches: [match(1), match(undefined), match(3)] })
+    vi.mocked(confirmMatches).mockResolvedValue({ updated: 2 })
+    const { result } = setup()
+    await waitFor(() => expect(result.current.keywords.matches).toHaveLength(3))
+
+    await act(() => result.current.keywords.confirm())
+
+    expect(confirmMatches).toHaveBeenCalledWith([1, 3])
+    expect(result.current.keywords.matches).toEqual([])
+  })
+
+  it('IDが1つも無い通知は、APIを呼ばずに一覧だけ空にする', async () => {
+    vi.mocked(loadUnconfirmedMatches).mockResolvedValue({ matches: [match(undefined)] })
+    const { result } = setup()
+    await waitFor(() => expect(result.current.keywords.matches).toHaveLength(1))
+
+    await act(() => result.current.keywords.confirm())
+
+    expect(confirmMatches).not.toHaveBeenCalled()
+    expect(result.current.keywords.matches).toEqual([])
+  })
+
+  it('確認に失敗した場合は通知を残し、エラーを表示する', async () => {
+    vi.mocked(loadUnconfirmedMatches).mockResolvedValue({ matches: [match(1)] })
+    vi.mocked(confirmMatches).mockRejectedValue(new Error('保存できません'))
+    const { result } = setup()
+    await waitFor(() => expect(result.current.keywords.matches).toHaveLength(1))
+
+    await act(() => result.current.keywords.confirm())
+
+    expect(result.current.keywords.matches).toHaveLength(1)
+    expect(result.current.operation.error).toBe('保存できません')
+  })
+})
diff --git a/src/hooks/useKeywordMatches.ts b/src/hooks/useKeywordMatches.ts
new file mode 100644
index 0000000000000000000000000000000000000000..322cb196065fdd3bdd38a784e01d9109c6c80225
--- /dev/null
+++ b/src/hooks/useKeywordMatches.ts
@@ -0,0 +1,44 @@
+/**
+ * 職アドキーワード通知の取得・確認
+ * 起動時に未確認の通知を復元し、「確認」を押すまで表示し続ける
+ */
+import { useCallback, useEffect, useState } from 'react'
+import { checkKeywords, confirmMatches, loadUnconfirmedMatches, type KeywordMatch } from '../utils/api'
+import type { Operations } from './useOperation'
+
+export function useKeywordMatches({ run, showToast }: Operations) {
+  const [matches, setMatches] = useState<KeywordMatch[]>([])
+
+  useEffect(() => {
+    loadUnconfirmedMatches()
+      .then(result => {
+        if (result.matches.length > 0) {
+          setMatches(result.matches)
+        }
+      })
+      .catch(() => {
+        // バックエンド未起動などで読み込めなくても、画面の他の機能は使えるようにする
+      })
+  }, [])
+
+  const check = useCallback(() => run('keywords', '職アドキーワードチェックに失敗しました', async () => {
+    const result = await checkKeywords()
+    setMatches(result.new_matches)
+    showToast(
+      result.new_matches.length > 0
+        ? `新しい職アド通知が ${result.new_matches.length}件あります`
+        : '新しい職アド通知はありません',
+    )
+  }), [run, showToast])
+
+  const confirm = useCallback(() => run(null, '職アド通知の確認に失敗しました', async () => {
+    const ids = matches.map(match => match.id).filter((id): id is number => id !== undefined)
+    if (ids.length > 0) {
+      await confirmMatches(ids)
+      showToast('職アド通知を確認済みにしました')
+    }
+    setMatches([])
+  }), [matches, run, showToast])
+
+  return { matches, check, confirm }
+}
diff --git a/src/hooks/useOperation.ts b/src/hooks/useOperation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8c4ca6e81d3cbb0925f406da145c1fd6f2d0cb61
--- /dev/null
+++ b/src/hooks/useOperation.ts
@@ -0,0 +1,47 @@
+/**
+ * 画面操作の実行状態とエラー表示を管理するカスタムフック
+ * 「実行中フラグを立てる → エラーを消す → 実行 → 失敗ならメッセージ表示 → 実行中フラグを戻す」を共通化する
+ */
+import { useCallback, useState } from 'react'
+
+export type RunningAction = 'addresses' | 'keywords' | 'database' | 'dummy' | 'schedule'
+
+export type RunOperation = (
+  action: RunningAction | null,
+  fallbackMessage: string,
+  task: () => Promise<void>,
+) => Promise<void>
+
+export function useOperation() {
+  const [error, setError] = useState<string | null>(null)
+  const [runningAction, setRunningAction] = useState<RunningAction | null>(null)
+
+  /**
+   * @param action 実行中として扱う操作名。ボタン無効化が不要な操作は null
+   * @param fallbackMessage Errorインスタンス以外が投げられたときに表示するメッセージ
+   */
+  const run = useCallback<RunOperation>(async (action, fallbackMessage, task) => {
+    if (action) {
+      setRunningAction(action)
+    }
+    setError(null)
+    try {
+      await task()
+    } catch (err) {
+      setError(err instanceof Error ? err.message : fallbackMessage)
+    } finally {
+      if (action) {
+        setRunningAction(null)
+      }
+    }
+  }, [])
+
+  return { error, setError, runningAction, run }
+}
+
+/** 各機能フックが共通で受け取る操作用の依存 */
+export type Operations = {
+  run: RunOperation
+  setError: (message: string | null) => void
+  showToast: (message: string) => void
+}
diff --git a/src/hooks/useRecipients.test.ts b/src/hooks/useRecipients.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e7becad42475e0ccdc7acbef20fcbd782b8b3efe
--- /dev/null
+++ b/src/hooks/useRecipients.test.ts
@@ -0,0 +1,87 @@
+/**
+ * useRecipientsフックのテスト
+ * 初回読み込みと再読み込み時の状態遷移を確認する
+ **/
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+import { renderHook, act, waitFor } from '@testing-library/react'
+import { useRecipients } from './useRecipients'
+import { loadRecipients } from '../utils/csvParser'
+
+vi.mock('../utils/csvParser', () => ({
+  loadRecipients: vi.fn(),
+}))
+
+const first = [{ name: '山田 太郎', count: 3 }]
+const second = [{ name: '山田 太郎', count: 3 }, { name: '佐藤 一郎', count: 1 }]
+
+describe('useRecipients', () => {
+  beforeEach(() => {
+    vi.mocked(loadRecipients).mockReset()
+  })
+
+  it('初回読み込み中はloadingがtrueで、完了後にデータが入る', async () => {
+    vi.mocked(loadRecipients).mockResolvedValue(first)
+
+    const { result } = renderHook(() => useRecipients())
+    expect(result.current.loading).toBe(true)
+
+    await waitFor(() => expect(result.current.loading).toBe(false))
+    expect(result.current.recipients).toEqual(first)
+    expect(result.current.error).toBeNull()
+  })
+
+  it('初回読み込みに失敗するとerrorにメッセージが入る', async () => {
+    vi.mocked(loadRecipients).mockRejectedValue(new Error('CSVの読み込みに失敗しました (404)'))
+
+    const { result } = renderHook(() => useRecipients())
+
+    await waitFor(() => expect(result.current.loading).toBe(false))
+    expect(result.current.error).toBe('CSVの読み込みに失敗しました (404)')
+  })
+
+  it('再読み込み中もloadingはfalseのままで、既存データを保持し、完了後に更新される', async () => {
+    vi.mocked(loadRecipients).mockResolvedValueOnce(first)
+    const { result } = renderHook(() => useRecipients())
+    await waitFor(() => expect(result.current.loading).toBe(false))
+
+    let resolveReload: (value: typeof second) => void = () => {}
+    vi.mocked(loadRecipients).mockReturnValueOnce(new Promise(resolve => { resolveReload = resolve }))
+
+    let reloadPromise: Promise<void> = Promise.resolve()
+    act(() => { reloadPromise = result.current.reload() })
+
+    expect(result.current.loading).toBe(false)
+    expect(result.current.recipients).toEqual(first)
+
+    await act(async () => {
+      resolveReload(second)
+      await reloadPromise
+    })
+    expect(result.current.recipients).toEqual(second)
+  })
+
+  it('再読み込みに失敗しても既存データと画面を維持し、呼び出し元へエラーを伝える', async () => {
+    vi.mocked(loadRecipients).mockResolvedValueOnce(first)
+    const { result } = renderHook(() => useRecipients())
+    await waitFor(() => expect(result.current.loading).toBe(false))
+
+    vi.mocked(loadRecipients).mockRejectedValueOnce(new Error('network'))
+    await act(async () => {
+      await expect(result.current.reload()).rejects.toThrow('network')
+    })
+
+    expect(result.current.recipients).toEqual(first)
+    expect(result.current.error).toBeNull()
+  })
+
+  it('reloadの関数参照は再レンダリングで変わらない', async () => {
+    vi.mocked(loadRecipients).mockResolvedValue(first)
+    const { result, rerender } = renderHook(() => useRecipients())
+    await waitFor(() => expect(result.current.loading).toBe(false))
+    const reload = result.current.reload
+
+    rerender()
+
+    expect(result.current.reload).toBe(reload)
+  })
+})
diff --git a/src/hooks/useRecipients.ts b/src/hooks/useRecipients.ts
index 57eabe37a613ea4cc5e707788ecd59e9f8417a6c..9d33f3bea7fa813931e0af7220fc7f8cb40d4191 100644
--- a/src/hooks/useRecipients.ts
+++ b/src/hooks/useRecipients.ts
@@ -1,7 +1,7 @@
 /**
  * CSVデータを読み込むカスタムフック
  */
-import { useState, useEffect } from 'react'
+import { useState, useEffect, useCallback, useRef } from 'react'
 import type { Recipient } from '../types'
 import { loadRecipients } from '../utils/csvParser'
 
@@ -14,30 +14,36 @@ type UseRecipientsReturn = {
 
 /**
  * CSVファイルから送信先データを読み込む
- * @returns recipients: 送信先データ, loading: 読み込み中フラグ, error: エラーメッセージ
+ *
+ * 初回読み込み中のみloadingがtrueになる。再読み込み（reload）では既存データと画面を維持し、
+ * 失敗時はerrorを立てずに呼び出し元へ例外を伝える（検索結果やチェック状態を失わないため）。
+ * @returns recipients: 送信先データ, loading: 初回読み込み中フラグ, error: 初回読み込みのエラーメッセージ
  */
 export function useRecipients(): UseRecipientsReturn {
   const [recipients, setRecipients] = useState<Recipient[]>([])
   const [loading, setLoading] = useState(true)
   const [error, setError] = useState<string | null>(null)
+  const loadedRef = useRef(false)
 
-  const reload = async () => {
-    setLoading(true)
-    setError(null)
-    await loadRecipients()
-      .then(data => {
-        setRecipients(data)
-        setLoading(false)
-      })
-      .catch(err => {
-        setError(err instanceof Error ? err.message : 'データの読み込みに失敗しました')
-        setLoading(false)
-      })
-  }
+  const reload = useCallback(async () => {
+    try {
+      const data = await loadRecipients()
+      setRecipients(data)
+      setError(null)
+      loadedRef.current = true
+    } catch (err) {
+      if (loadedRef.current) {
+        throw err
+      }
+      setError(err instanceof Error ? err.message : 'データの読み込みに失敗しました')
+    } finally {
+      setLoading(false)
+    }
+  }, [])
 
   useEffect(() => {
-    reload()
-  }, [])
+    void reload()
+  }, [reload])
 
   return { recipients, loading, error, reload }
 }
diff --git a/src/hooks/useScheduleDraft.test.ts b/src/hooks/useScheduleDraft.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..233273da687fb2c40917d637b63ef0e4335b61d8
--- /dev/null
+++ b/src/hooks/useScheduleDraft.test.ts
@@ -0,0 +1,132 @@
+/**
+ * useScheduleDraftフックのテスト
+ * 解析・編集・Outlook追加の流れと、入力不備時のエラー表示を確認する
+ */
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+import { renderHook, act } from '@testing-library/react'
+import type { WheelEvent } from 'react'
+import { useScheduleDraft } from './useScheduleDraft'
+import { useTestOperations } from '../test/operations'
+import { addSchedule, parseSchedule, type ParsedScheduleEvent } from '../utils/api'
+
+vi.mock('../utils/api', async importOriginal => ({
+  ...(await importOriginal<typeof import('../utils/api')>()),
+  parseSchedule: vi.fn(),
+  addSchedule: vi.fn(),
+}))
+
+const event: ParsedScheduleEvent = {
+  start: '2026-05-20T06:00:00.000Z',
+  end: '2026-05-20T07:00:00.000Z',
+  subject: '会議',
+  location: '',
+  body: '',
+  all_day: false,
+  duration_minutes: 60,
+  normalized_text: '会議',
+}
+
+function setup() {
+  return renderHook(() => {
+    const ops = useTestOperations()
+    return { ...ops, schedule: useScheduleDraft(ops.operations) }
+  })
+}
+
+const wheelEvent = (deltaY: number) =>
+  ({ deltaY, preventDefault: vi.fn() }) as unknown as WheelEvent<HTMLInputElement>
+
+describe('useScheduleDraft', () => {
+  beforeEach(() => {
+    vi.mocked(parseSchedule).mockReset()
+    vi.mocked(addSchedule).mockReset()
+  })
+
+  it('入力が空のまま解析するとAPIを呼ばずにエラーを表示する', async () => {
+    const { result } = setup()
+
+    await act(() => result.current.schedule.parse())
+
+    expect(parseSchedule).not.toHaveBeenCalled()
+    expect(result.current.operation.error).toBe('予定入力を入力してください')
+  })
+
+  it('解析に成功すると結果を保持し、入力文を変えると破棄する', async () => {
+    vi.mocked(parseSchedule).mockResolvedValue({ event })
+    const { result } = setup()
+    act(() => result.current.schedule.changeText(' 明日 15:00 会議 '))
+
+    await act(() => result.current.schedule.parse())
+    expect(parseSchedule).toHaveBeenCalledWith('明日 15:00 会議')
+    expect(result.current.schedule.event).toEqual(event)
+
+    act(() => result.current.schedule.changeText('明日 16:00 会議'))
+    expect(result.current.schedule.event).toBeNull()
+  })
+
+  it('解析に失敗すると以前の結果を消してエラーを表示する', async () => {
+    vi.mocked(parseSchedule).mockResolvedValueOnce({ event }).mockRejectedValueOnce(new Error('予定名を読み取れませんでした'))
+    const { result } = setup()
+    act(() => result.current.schedule.changeText('会議'))
+    await act(() => result.current.schedule.parse())
+
+    await act(() => result.current.schedule.parse())
+
+    expect(result.current.schedule.event).toBeNull()
+    expect(result.current.operation.error).toBe('予定名を読み取れませんでした')
+  })
+
+  it('解析前に追加しようとすると案内のエラーを表示する', async () => {
+    const { result } = setup()
+    act(() => result.current.schedule.changeText('会議'))
+
+    await act(() => result.current.schedule.add())
+
+    expect(addSchedule).not.toHaveBeenCalled()
+    expect(result.current.operation.error).toBe('先に予定解析を実行してください')
+  })
+
+  it('件名が空のままでは追加できない', async () => {
+    vi.mocked(parseSchedule).mockResolvedValue({ event })
+    const { result } = setup()
+    act(() => result.current.schedule.changeText('会議'))
+    await act(() => result.current.schedule.parse())
+    act(() => result.current.schedule.update({ subject: '  ' }))
+
+    await act(() => result.current.schedule.add())
+
+    expect(addSchedule).not.toHaveBeenCalled()
+    expect(result.current.operation.error).toBe('件名を入力してください')
+  })
+
+  it('追加に成功すると結果を反映してトーストを出す', async () => {
+    vi.mocked(parseSchedule).mockResolvedValue({ event })
+    vi.mocked(addSchedule).mockResolvedValue({ event: { ...event, subject: '会議(登録済)' }, saved: true })
+    const { result } = setup()
+    act(() => result.current.schedule.changeText('会議'))
+    await act(() => result.current.schedule.parse())
+
+    await act(() => result.current.schedule.add())
+
+    expect(addSchedule).toHaveBeenCalledWith('会議', event)
+    expect(result.current.showToast).toHaveBeenCalledWith('会議(登録済) をOutlook予定表に追加しました')
+  })
+
+  it('ホイールで5分単位で開始時刻を動かし、終日のときは終了時刻を動かさない', async () => {
+    vi.mocked(parseSchedule).mockResolvedValue({ event })
+    const { result } = setup()
+    act(() => result.current.schedule.changeText('会議'))
+    await act(() => result.current.schedule.parse())
+
+    const up = wheelEvent(-100)
+    act(() => result.current.schedule.wheel(up, 'start'))
+    expect(up.preventDefault).toHaveBeenCalled()
+    expect(result.current.schedule.event?.start).toBe('2026-05-20T06:05:00.000Z')
+    expect(result.current.schedule.event?.duration_minutes).toBe(55)
+
+    act(() => result.current.schedule.update({ all_day: true }))
+    const down = wheelEvent(100)
+    act(() => result.current.schedule.wheel(down, 'end'))
+    expect(down.preventDefault).not.toHaveBeenCalled()
+  })
+})
diff --git a/src/hooks/useScheduleDraft.ts b/src/hooks/useScheduleDraft.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1e5b13bdddd92abea8457cda83d67460d3564736
--- /dev/null
+++ b/src/hooks/useScheduleDraft.ts
@@ -0,0 +1,70 @@
+/**
+ * 自然文の予定入力、解析結果の編集、Outlook予定表への追加
+ */
+import { useCallback, useState, type WheelEvent } from 'react'
+import { addSchedule, parseSchedule, type ParsedScheduleEvent } from '../utils/api'
+import { adjustIsoMinutes, applyScheduleUpdate } from '../utils/dateTime'
+import type { Operations } from './useOperation'
+
+/** マウスホイール1ノッチあたりに動かす分数 */
+const WHEEL_STEP_MINUTES = 5
+
+export function useScheduleDraft({ run, setError, showToast }: Operations) {
+  const [text, setText] = useState('')
+  const [event, setEvent] = useState<ParsedScheduleEvent | null>(null)
+
+  /** 入力文が変わったら、古い解析結果は破棄する */
+  const changeText = useCallback((next: string) => {
+    setText(next)
+    setEvent(null)
+  }, [])
+
+  const parse = useCallback(async () => {
+    const trimmed = text.trim()
+    if (!trimmed) {
+      setError('予定入力を入力してください')
+      return
+    }
+    await run('schedule', '予定の解析に失敗しました', async () => {
+      try {
+        setEvent((await parseSchedule(trimmed)).event)
+        showToast('予定を解析しました')
+      } catch (err) {
+        setEvent(null)
+        throw err
+      }
+    })
+  }, [run, setError, showToast, text])
+
+  const update = useCallback((updates: Partial<ParsedScheduleEvent>) => {
+    setEvent(prev => (prev ? applyScheduleUpdate(prev, updates) : prev))
+  }, [])
+
+  const wheel = useCallback((wheelEvent: WheelEvent<HTMLInputElement>, field: 'start' | 'end') => {
+    if (!event || (field === 'end' && event.all_day)) {
+      return
+    }
+    wheelEvent.preventDefault()
+    update({ [field]: adjustIsoMinutes(event[field], wheelEvent.deltaY < 0 ? WHEEL_STEP_MINUTES : -WHEEL_STEP_MINUTES) })
+  }, [event, update])
+
+  const add = useCallback(async () => {
+    if (!event) {
+      setError(text.trim() ? '先に予定解析を実行してください' : '予定入力を入力してください')
+      return
+    }
+    if (!event.subject.trim()) {
+      setError('件名を入力してください')
+      return
+    }
+    await run('schedule', 'Outlook予定表への追加に失敗しました', async () => {
+      const result = await addSchedule(text.trim(), event)
+      setEvent(result.event)
+      showToast(`${result.event.subject} をOutlook予定表に追加しました`)
+    })
+  }, [event, run, setError, showToast, text])
+
+  return { text, changeText, event, parse, update, wheel, add }
+}
+
+export type ScheduleController = ReturnType<typeof useScheduleDraft>
diff --git a/src/hooks/useSearch.test.ts b/src/hooks/useSearch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b64d04bda4274fa6bf50fdc9e27f58b83c0d4b47
--- /dev/null
+++ b/src/hooks/useSearch.test.ts
@@ -0,0 +1,155 @@
+/**
+ * useSearchフックのテスト
+ * 検索実行、チェック状態のマージ、お気に入り適用中の表示ルールを確認する
+ */
+import { describe, it, expect } from 'vitest'
+import { renderHook, act } from '@testing-library/react'
+import { useSearch } from './useSearch'
+import type { Recipient } from '../types'
+
+const recipients: Recipient[] = [
+  { name: '山田 太郎', count: 10 },
+  { name: '山田 花子', count: 8 },
+  { name: '佐藤 一郎', count: 5 },
+  { name: '鈴木 恒一', count: 1 },
+]
+
+const names = (rows: Array<{ name: string }>) => rows.map(row => row.name)
+
+function setup() {
+  return renderHook(() => useSearch(recipients))
+}
+
+describe('useSearch 通常時', () => {
+  it('検索前は全件が未チェックで並ぶ', () => {
+    const { result } = setup()
+
+    expect(names(result.current.results)).toEqual(names(recipients))
+    expect(result.current.results.every(row => !row.checked)).toBe(true)
+    expect(result.current.getCheckedNames()).toEqual([])
+  })
+
+  it('入力しただけでは絞り込まれず、executeSearch で絞り込みとチェックが行われる', () => {
+    const { result } = setup()
+
+    act(() => result.current.setQuery('山田'))
+    expect(result.current.results).toHaveLength(4)
+
+    act(() => result.current.executeSearch())
+    expect(names(result.current.results)).toEqual(['山田 太郎', '山田 花子'])
+    expect(result.current.getCheckedNames()).toEqual(['山田 太郎', '山田 花子'])
+  })
+
+  it('別のキーワードで再検索しても、以前のチェックは維持されたまま追加される', () => {
+    const { result } = setup()
+    act(() => result.current.setQuery('山田'))
+    act(() => result.current.executeSearch())
+    act(() => result.current.setQuery('佐藤'))
+    act(() => result.current.executeSearch())
+
+    expect(names(result.current.results)).toEqual(['佐藤 一郎'])
+    act(() => result.current.setQuery(''))
+    act(() => result.current.executeSearch())
+    const checked = result.current.results.filter(row => row.checked).map(row => row.name)
+    expect(checked).toEqual(names(recipients))
+  })
+
+  it('toggleCheck でチェックを付け外しできる', () => {
+    const { result } = setup()
+
+    act(() => result.current.toggleCheck('佐藤 一郎'))
+    expect(result.current.getCheckedNames()).toEqual(['佐藤 一郎'])
+
+    act(() => result.current.toggleCheck('佐藤 一郎'))
+    expect(result.current.getCheckedNames()).toEqual([])
+  })
+
+  it('getCheckedNames は画面に表示中の結果だけを返す', () => {
+    const { result } = setup()
+    act(() => result.current.toggleCheck('鈴木 恒一'))
+    act(() => result.current.setQuery('山田'))
+    act(() => result.current.executeSearch())
+
+    expect(result.current.getCheckedNames()).toEqual(['山田 太郎', '山田 花子'])
+  })
+
+  it('どの宛先にも一致しなかったキーワードを unmatchedKeywords で返す', () => {
+    const { result } = setup()
+
+    act(() => result.current.setQuery('山田, 存在しない 、John'))
+    act(() => result.current.executeSearch())
+
+    expect(result.current.unmatchedKeywords).toEqual(['存在しない', 'John'])
+  })
+
+  it('検索を実行するまで unmatchedKeywords は空', () => {
+    const { result } = setup()
+
+    act(() => result.current.setQuery('存在しない'))
+
+    expect(result.current.unmatchedKeywords).toEqual([])
+  })
+})
+
+describe('useSearch お気に入り適用中', () => {
+  it('検索せずに適用すると、チェック済みの宛先だけが表示される', () => {
+    const { result } = setup()
+
+    act(() => result.current.setQueryAndChecked('', ['鈴木 恒一', '山田 太郎'], '開発'))
+
+    expect(result.current.appliedFavoriteName).toBe('開発')
+    expect(names(result.current.results)).toEqual(['山田 太郎', '鈴木 恒一'])
+    expect(result.current.results.every(row => row.checked)).toBe(true)
+  })
+
+  it('履歴に無い宛先（アドレス直書き）も回数0で表示される', () => {
+    const { result } = setup()
+
+    act(() => result.current.setQueryAndChecked('', ['山田 太郎', 'new@example.com'], '開発'))
+
+    expect(result.current.results).toEqual([
+      { name: '山田 太郎', count: 10, checked: true },
+      { name: 'new@example.com', count: 0, checked: true },
+    ])
+  })
+
+  it('適用後にさらに検索すると、検索結果の後ろにお気に入りのチェック済みメンバーが続く', () => {
+    const { result } = setup()
+    act(() => result.current.setQueryAndChecked('', ['鈴木 恒一', 'new@example.com'], '開発'))
+
+    act(() => result.current.setQuery('佐藤'))
+    act(() => result.current.executeSearch())
+
+    expect(names(result.current.results)).toEqual(['佐藤 一郎', '鈴木 恒一', 'new@example.com'])
+    expect(result.current.results.map(row => row.checked)).toEqual([true, true, true])
+  })
+
+  it('検索結果に含まれるお気に入りメンバーは重複して表示されない', () => {
+    const { result } = setup()
+    act(() => result.current.setQueryAndChecked('', ['山田 太郎'], '開発'))
+
+    act(() => result.current.setQuery('山田'))
+    act(() => result.current.executeSearch())
+
+    expect(names(result.current.results)).toEqual(['山田 太郎', '山田 花子'])
+  })
+
+  it('適用を解除すると通常の全件表示に戻り、チェック状態は残る', () => {
+    const { result } = setup()
+    act(() => result.current.setQueryAndChecked('', ['山田 太郎'], '開発'))
+
+    act(() => result.current.setAppliedFavoriteName(null))
+
+    expect(names(result.current.results)).toEqual(names(recipients))
+    expect(result.current.getCheckedNames()).toEqual(['山田 太郎'])
+  })
+
+  it('setQueryAndChecked は以前のチェックを置き換える', () => {
+    const { result } = setup()
+    act(() => result.current.toggleCheck('佐藤 一郎'))
+
+    act(() => result.current.setQueryAndChecked('', ['山田 花子'], '開発'))
+
+    expect(result.current.getCheckedNames()).toEqual(['山田 花子'])
+  })
+})
