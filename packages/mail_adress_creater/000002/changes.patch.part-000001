diff --git a/public/sw.js b/public/sw.js
index 1be4bb543b0c5d75f6e86720897c0540817f2240..a3a75d40c31843fa920c46af18fe66864a9416fd 100644
--- a/public/sw.js
+++ b/public/sw.js
@@ -1,5 +1,12 @@
-const CACHE_NAME = 'outlook-address-maker-v1'
+// Service Worker: アプリ本体をキャッシュしてオフラインでも起動できるようにする。
+//  - 画面遷移(HTML): ネットワーク優先。成功したら最新を /index.html として保存し、失敗時はそれを返す
+//  - /assets/*（ファイル名にハッシュが付く）: キャッシュ優先。古いハッシュのファイルが溜まらないよう件数を制限する
+//  - その他（manifest、アイコンなど）: ネットワーク優先、失敗時にキャッシュ
+//  - /api と CSV はキャッシュしない
+// 動作を変えたら CACHE_NAME を上げる（古いキャッシュは activate 時に削除される）。
+const CACHE_NAME = 'outlook-address-maker-v2'
 const APP_SHELL = ['/', '/index.html', '/manifest.webmanifest', '/icons/icon.svg']
+const MAX_ASSET_ENTRIES = 40
 
 const shouldHandleRequest = request => {
   const url = new URL(request.url)
@@ -12,6 +19,38 @@ const shouldHandleRequest = request => {
   )
 }
 
+const isAsset = request => new URL(request.url).pathname.startsWith('/assets/')
+
+const putInCache = (request, response) =>
+  caches.open(CACHE_NAME).then(cache => cache.put(request, response)).catch(() => undefined)
+
+// 新しいものを残し、古い /assets/ のキャッシュから削除する
+const trimAssetCache = async () => {
+  const cache = await caches.open(CACHE_NAME)
+  const keys = (await cache.keys()).filter(isAsset)
+  await Promise.all(keys.slice(0, Math.max(0, keys.length - MAX_ASSET_ENTRIES)).map(key => cache.delete(key)))
+}
+
+const networkFirst = (request, cacheKey) =>
+  fetch(request)
+    .then(response => {
+      if (response.ok) {
+        putInCache(cacheKey, response.clone())
+      }
+      return response
+    })
+    .catch(() => caches.match(cacheKey))
+
+const cacheFirst = request =>
+  caches.match(request).then(cached => (
+    cached || fetch(request).then(response => {
+      if (response.ok) {
+        putInCache(request, response.clone()).then(trimAssetCache)
+      }
+      return response
+    })
+  ))
+
 self.addEventListener('install', event => {
   event.waitUntil(
     caches.open(CACHE_NAME).then(cache => cache.addAll(APP_SHELL)),
@@ -29,32 +68,16 @@ self.addEventListener('activate', event => {
 })
 
 self.addEventListener('fetch', event => {
-  if (!shouldHandleRequest(event.request)) {
+  const { request } = event
+  if (!shouldHandleRequest(request)) {
     return
   }
 
-  if (event.request.mode === 'navigate') {
-    event.respondWith(
-      fetch(event.request)
-        .then(response => {
-          const copy = response.clone()
-          caches.open(CACHE_NAME).then(cache => cache.put('/index.html', copy)).catch(() => undefined)
-          return response
-        })
-        .catch(() => caches.match('/index.html')),
-    )
-    return
+  if (request.mode === 'navigate') {
+    event.respondWith(networkFirst(request, '/index.html'))
+  } else if (isAsset(request)) {
+    event.respondWith(cacheFirst(request))
+  } else {
+    event.respondWith(networkFirst(request, request))
   }
-
-  event.respondWith(
-    caches.match(event.request).then(cached => (
-      cached || fetch(event.request).then(response => {
-        if (response.ok) {
-          const copy = response.clone()
-          caches.open(CACHE_NAME).then(cache => cache.put(event.request, copy)).catch(() => undefined)
-        }
-        return response
-      })
-    )),
-  )
 })
diff --git a/pyproject.toml b/pyproject.toml
new file mode 100644
index 0000000000000000000000000000000000000000..1619871a65a1d74c55faf30f5cdc0f60b763ae10
--- /dev/null
+++ b/pyproject.toml
@@ -0,0 +1,11 @@
+# Pythonバックエンドの静的解析設定（実行には不要。開発時に ruff / mypy で使う）
+[tool.ruff]
+line-length = 120
+target-version = "py312"
+
+[tool.ruff.lint]
+select = ["E", "F", "W", "B", "UP", "SIM"]
+
+[tool.mypy]
+python_version = "3.12"
+ignore_missing_imports = true
diff --git a/spec.md b/spec.md
index 5e0b98d9e6480a907420735b033c9eb16c126589..be9d95c78c2c374715aa595324ea7e598ff5d775 100644
--- a/spec.md
+++ b/spec.md
@@ -20,12 +20,23 @@ Outlookの送信履歴から抽出した「送信先名 × 送信回数」のデ
 
 ### 2.2 バックエンド
 
-- Python 3.12
-- `backend/server.py`
+- Python 3.12（標準ライブラリのみ。Windowsでのみ pywin32）
 - 標準ライブラリの`http.server`でAPIと`dist`を配信
-- SQLiteでお気に入り、宛先、設定、キーワード一致、ジョブ実行結果を保存
+- SQLiteでお気に入り、宛先、設定、キーワード一致、ジョブ実行結果を保存（`backend/data/app.sqlite3`）
 - Windows + Outlook + pywin32 がある環境でOutlook COM連携を実行
 
+モジュール構成:
+
+| ファイル | 役割 |
+| --- | --- |
+| `backend/server.py` | HTTPハンドラ、ルーティング表、Origin/Host検証、エラーコード、キャッシュヘッダー、起動 |
+| `backend/services.py` | アドレス再取得、キーワードチェック、予定解析・追加、ダミーデータ投入 |
+| `backend/db.py` | SQLite（スキーマ作成・移行、設定、お気に入り、宛先、キーワード一致、ジョブ履歴）とCSV入出力 |
+| `backend/outlook.py` | Outlook COM接続と復旧、送信済み取得、予定登録、職アド受信メール検索 |
+| `backend/scheduler.py` | 自動実行の判定・再試行・多重起動防止 |
+| `backend/event_parser.py` | 自然文の予定解析 |
+| `backend/config.py` | パス、既定設定、ログ |
+
 ## 3. 入力データ仕様
 
 ### 3.1 CSVファイル
@@ -35,7 +46,10 @@ Outlookの送信履歴から抽出した「送信先名 × 送信回数」のデ
 - 配信データ配置: `dist/send_mail-ranking_tabulator.csv`
 - 読み込み方法: フロントエンドから`fetch('/send_mail-ranking_tabulator.csv')`
 - 更新方法: バックエンドの`POST /api/refresh-addresses`
-- フロントエンドはCSVをキャッシュせず取得し、HTTPエラー時は読み込みエラーとして扱う
+- フロントエンドはCSVをキャッシュせず（`no-store`）取得し、HTTPエラー時は読み込みエラーとして扱う
+- フロントエンドは読み込み後、同じ名前の行は回数を合計して1件にまとめ、回数の降順に並べる
+- バックエンドはCSVを一時ファイル経由で置き換えるため、書き込みに失敗しても元のCSVは壊れない
+- 再読み込み（アドレス再取得・DB削除後）でも、画面の検索語・チェック状態は維持する
 
 ### 3.2 CSVフォーマット
 
@@ -57,25 +71,26 @@ Outlookの送信履歴から抽出した「送信先名 × 送信回数」のデ
 
 ### 4.1 上部メニュー
 
