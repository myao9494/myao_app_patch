+                "start": "2026-05-28T15:30+09:00",
+                "end": "2026-05-28T16:30+09:00",
+                "duration": 60,
+                "subject": "会議",
+                "location": "",
+                "all_day": False,
+            },
+            {
+                "input": "5/28 15時30分 会議",
+                "start": "2026-05-28T15:30+09:00",
+                "end": "2026-05-28T16:30+09:00",
+                "duration": 60,
+                "subject": "会議",
+                "location": "",
+                "all_day": False,
+            },
+            {
+                "input": "5/28 15時半 会議",
+                "start": "2026-05-28T15:30+09:00",
+                "end": "2026-05-28T16:30+09:00",
+                "duration": 60,
+                "subject": "会議",
+                "location": "",
+                "all_day": False,
+            },
+            {
+                "input": "5/28 15 時 30 分 会議",
+                "start": "2026-05-28T15:30+09:00",
+                "end": "2026-05-28T16:30+09:00",
+                "duration": 60,
+                "subject": "会議",
+                "location": "",
+                "all_day": False,
+            },
+            {
+                "input": "5/28 午後 3:00 会議",
+                "start": "2026-05-28T15:00+09:00",
+                "end": "2026-05-28T16:00+09:00",
+                "duration": 60,
+                "subject": "会議",
+                "location": "",
+                "all_day": False,
+            },
+            {
+                "input": "5/28 夕方 5 時 会議",
+                "start": "2026-05-28T17:00+09:00",
+                "end": "2026-05-28T18:00+09:00",
+                "duration": 60,
+                "subject": "会議",
+                "location": "",
+                "all_day": False,
+            },
+            {
+                "input": "5/28 夜 8:30 会議",
+                "start": "2026-05-28T20:30+09:00",
+                "end": "2026-05-28T21:30+09:00",
+                "duration": 60,
+                "subject": "会議",
+                "location": "",
+                "all_day": False,
+            },
+            {
+                "input": "5/28 正午 会議",
+                "start": "2026-05-28T12:00+09:00",
+                "end": "2026-05-28T13:00+09:00",
+                "duration": 60,
+                "subject": "会議",
+                "location": "",
+                "all_day": False,
+            },
+            {
+                "input": "5/28 15:00 会議 @ 会議室A",
+                "start": "2026-05-28T15:00+09:00",
+                "end": "2026-05-28T16:00+09:00",
+                "duration": 60,
+                "subject": "会議",
+                "location": "会議室A",
+                "all_day": False,
+            },
+            {
+                "input": "5/28 15:00 於 会議室B 会議",
+                "start": "2026-05-28T15:00+09:00",
+                "end": "2026-05-28T16:00+09:00",
+                "duration": 60,
+                "subject": "会議",
+                "location": "会議室B",
+                "all_day": False,
+            },
+            {
+                "input": "5/28 15:00 会議 会場： オンライン",
+                "start": "2026-05-28T15:00+09:00",
+                "end": "2026-05-28T16:00+09:00",
+                "duration": 60,
+                "subject": "会議",
+                "location": "オンライン",
+                "all_day": False,
+            },
+            {
+                "input": "5/28 15:00 【定例】進捗確認会議 @ 会議室1",
+                "start": "2026-05-28T15:00+09:00",
+                "end": "2026-05-28T16:00+09:00",
+                "duration": 60,
+                "subject": "【定例】進捗確認会議",
+                "location": "会議室1",
+                "all_day": False,
+            },
+        ]
+
+        for i, c in enumerate(cases):
+            with self.subTest(i=i, text=c["input"]):
+                event = parse_event_text(c["input"], base)
+                self.assertEqual(event.start.isoformat(timespec="minutes"), c["start"])
+                self.assertEqual(event.end.isoformat(timespec="minutes"), c["end"])
+                self.assertEqual(event.duration_minutes, c["duration"])
+                self.assertEqual(event.subject, c["subject"])
+                self.assertEqual(event.location, c["location"])
+                self.assertEqual(event.all_day, c["all_day"])
+
+    def test_extracts_slash_date_hyphen_time_range(self) -> None:
+        base = datetime(2026, 5, 18, 9, 0, tzinfo=ZoneInfo("Asia/Tokyo"))
+
+        event = parse_event_text("5/20 14:00ー15:00 会議", base)
+
+        self.assertEqual(event.start.isoformat(timespec="minutes"), "2026-05-20T14:00+09:00")
+        self.assertEqual(event.end.isoformat(timespec="minutes"), "2026-05-20T15:00+09:00")
+        self.assertEqual(event.duration_minutes, 60)
+        self.assertEqual(event.subject, "会議")
+        self.assertFalse(event.all_day)
+
+    def test_supports_various_time_range_delimiters(self) -> None:
+        base = datetime(2026, 5, 18, 9, 0, tzinfo=ZoneInfo("Asia/Tokyo"))
+
+        patterns = [
+            "13:00-15:00 会議",
+            "13:00 - 15:00 会議",
+            "13:00ー15:00 会議",
+            "13:00 ー 15:00 会議",
+            "13:00―15:00 会議",
+            "13:00 ― 15:00 会議",
+            "13:00to15:00 会議",
+            "13:00 to 15:00 会議",
+            "13:00TO15:00 会議",
+            "13:00 TO 15:00 会議",
+            "13:00To15:00 会議",
+            "13:00 To 15:00 会議",
+            "13:00～15:00 会議",
+            "13:00 ～ 15:00 会議",
+            "13:00〜15:00 会議",
+            "13:00 〜 15:00 会議",
+            "１３：００－１５：００ 会議",
+            "１３：００ー１５：００ 会議",
+            "１３：００―１５：００ 会議",
+            "１３：００ｔｏ１５：００ 会議",
+            "１３：００ ＴＯ １５：００ 会議",
+            "１３：００～１５：００ 会議",
+            "13時ー15時 会議",
+            "13時―15時 会議",
+            "13時to15時 会議",
+            "13時 TO 15時 会議",
+            "13時～15時 会議",
+            "13時-15時 会議",
+            "13:00　to　15:00 会議",
+            "13:00　ー　15:00 会議",
+            "13:00　～　15:00 会議",
+            "午後1:00-午後3:00 会議",
+            "午後1:00to午後3:00 会議",
+            "午後1:00ー午後3:00 会議",
+            "午後1:00～午後3:00 会議",
+            "午後1:00 - 3:00 会議",
+            "午後1:00 to 3:00 会議",
+            "午後1:00 ー 3:00 会議",
+            "午後1:00 ～ 3:00 会議",
+        ]
+
+        for text in patterns:
+            with self.subTest(text=text):
+                event = parse_event_text(text, base)
+                self.assertEqual(event.start.isoformat(timespec="minutes"), "2026-05-18T13:00+09:00")
+                self.assertEqual(event.end.isoformat(timespec="minutes"), "2026-05-18T15:00+09:00")
+                self.assertEqual(event.duration_minutes, 120)
+                self.assertEqual(event.subject, "会議")
+                self.assertFalse(event.all_day)
+
+        date_patterns = [
+            "5/20 13:00-15:00 会議",
+            "5/20 13:00ー15:00 会議",
+            "5/20 13:00―15:00 会議",
+            "5/20 13:00to15:00 会議",
+            "5/20 13:00 TO 15:00 会議",
+            "5/20 13:00～15:00 会議",
+            "5/20 13:00〜15:00 会議",
+        ]
+        for text in date_patterns:
+            with self.subTest(text=text):
+                event = parse_event_text(text, base)
+                self.assertEqual(event.start.isoformat(timespec="minutes"), "2026-05-20T13:00+09:00")
+                self.assertEqual(event.end.isoformat(timespec="minutes"), "2026-05-20T15:00+09:00")
+                self.assertEqual(event.duration_minutes, 120)
+                self.assertEqual(event.subject, "会議")
+                self.assertFalse(event.all_day)
+
+    def test_preserves_katakana_chouon_in_subject(self) -> None:
+        base = datetime(2026, 5, 18, 9, 0, tzinfo=ZoneInfo("Asia/Tokyo"))
+        cases = [
+            ("13:00-15:00 セミナー", "セミナー"),
+            ("13:00to15:00 ユーザーミーティング", "ユーザーミーティング"),
+            ("13:00ー15:00 リーダー会議", "リーダー会議"),
+        ]
+        for text, expected_subject in cases:
+            with self.subTest(text=text):
+                event = parse_event_text(text, base)
+                self.assertEqual(event.subject, expected_subject)
+                self.assertEqual(event.start.isoformat(timespec="minutes"), "2026-05-18T13:00+09:00")
+                self.assertEqual(event.end.isoformat(timespec="minutes"), "2026-05-18T15:00+09:00")
+
+    def test_uses_one_hour_for_start_time_only(self) -> None:
+        base = datetime(2026, 5, 18, 9, 0, tzinfo=ZoneInfo("Asia/Tokyo"))
+
+        event = parse_event_text("5/20 14:00 会議", base)
+
+        self.assertEqual(event.start.isoformat(timespec="minutes"), "2026-05-20T14:00+09:00")
+        self.assertEqual(event.end.isoformat(timespec="minutes"), "2026-05-20T15:00+09:00")
+        self.assertEqual(event.duration_minutes, 60)
+        self.assertFalse(event.all_day)
+
+    def test_treats_date_only_input_as_all_day(self) -> None:
+        base = datetime(2026, 5, 18, 9, 0, tzinfo=ZoneInfo("Asia/Tokyo"))
+
+        event = parse_event_text("明日、東京出張", base)
+
+        self.assertEqual(event.start.isoformat(timespec="minutes"), "2026-05-19T00:00+09:00")
+        self.assertEqual(event.duration_minutes, 1440)
+        self.assertEqual(event.subject, "東京出張")
+        self.assertEqual(event.location, "東京")
+        self.assertTrue(event.all_day)
+
+    def test_does_not_treat_room_number_as_time(self) -> None:
+        base = datetime(2026, 5, 18, 9, 0, tzinfo=ZoneInfo("Asia/Tokyo"))
+
+        event = parse_event_text("明日 第2会議室で定例", base)
+
+        self.assertEqual(event.start.isoformat(timespec="minutes"), "2026-05-19T00:00+09:00")
+        self.assertEqual(event.subject, "第2会議室で定例")
+        self.assertTrue(event.all_day)
+
+    def test_impossible_calendar_date_is_rejected_with_a_clear_message(self) -> None:
+        base = datetime(2026, 5, 18, 9, 0, tzinfo=ZoneInfo("Asia/Tokyo"))
+
+        for text in ("2026/2/30 15:00 会議", "4/31 会議", "2027/2/29 会議"):
+            with self.subTest(text=text), self.assertRaises(ValueError) as context:
+                parse_event_text(text, base)
+            self.assertIn("日付が正しくありません", str(context.exception))
+
+    def test_end_time_before_start_time_means_next_day(self) -> None:
+        base = datetime(2026, 5, 18, 9, 0, tzinfo=ZoneInfo("Asia/Tokyo"))
+
+        event = parse_event_text("2026/5/20 23:00〜1:00 夜間作業", base)
+
+        self.assertEqual(event.start.isoformat(timespec="minutes"), "2026-05-20T23:00+09:00")
+        self.assertEqual(event.end.isoformat(timespec="minutes"), "2026-05-21T01:00+09:00")
+        self.assertEqual(event.duration_minutes, 120)
+
+    def test_past_month_day_without_year_rolls_to_next_year(self) -> None:
+        base = datetime(2026, 5, 18, 9, 0, tzinfo=ZoneInfo("Asia/Tokyo"))
+
+        event = parse_event_text("3/1 15:00 会議", base)
+
+        self.assertEqual(event.start.date().isoformat(), "2027-03-01")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/backend/test_http_api.py b/backend/test_http_api.py
new file mode 100644
index 0000000000000000000000000000000000000000..b6dabed06c8c11ee8d0a2c0e052f9a26b5121bbc
--- /dev/null
+++ b/backend/test_http_api.py
@@ -0,0 +1,232 @@
+"""HTTP層（ルーティング・エラーコード・Origin/Host検証・キャッシュヘッダー）のテスト。
+
+実際に ThreadingHTTPServer を空きポートで起動して検証する。DB・CSV・配信ディレクトリは一時領域を使う。
+"""
+from __future__ import annotations
+
+import http.client
+import json
+import tempfile
+import threading
+import unittest
+from typing import Any
+from http.server import ThreadingHTTPServer
+from pathlib import Path
+from unittest.mock import patch
+
+from backend import config, server, services
+
+
+class HttpApiTestCase(unittest.TestCase):
+    def setUp(self) -> None:
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        base = Path(tmp.name)
+        (base / "dist" / "assets").mkdir(parents=True)
+        (base / "dist" / "index.html").write_text("<!doctype html><title>app</title>", encoding="utf-8")
+        (base / "dist" / "sw.js").write_text("// sw", encoding="utf-8")
+        (base / "dist" / "assets" / "index-abc123.js").write_text("console.log(1)", encoding="utf-8")
+        patches: list[Any] = [
+            patch.object(config, "BASE_DIR", base),
+            patch.object(config, "DB_PATH", base / "data" / "app.sqlite3"),
+            patch.object(config, "PUBLIC_CSV_PATH", base / "public" / "r.csv"),
+            patch.object(config, "DIST_CSV_PATH", base / "dist" / "r.csv"),
+            patch.object(server, "BIND_HOST", "127.0.0.1"),
+        ]
+        for p in patches:
+            p.start()
+            self.addCleanup(p.stop)
+
+        self.httpd = ThreadingHTTPServer(("127.0.0.1", 0), server.AppHandler)
+        self.port = self.httpd.server_address[1]
+        thread = threading.Thread(target=self.httpd.serve_forever, kwargs={"poll_interval": 0.01}, daemon=True)
+        thread.start()
+        self.addCleanup(self.httpd.server_close)
+        self.addCleanup(self.httpd.shutdown)
+
+    def request(
+        self,
+        method: str,
+        path: str,
+        body: object | bytes | None = None,
+        headers: dict[str, str] | None = None,
+    ) -> tuple[int, dict[str, str], bytes]:
+        conn = http.client.HTTPConnection("127.0.0.1", self.port, timeout=5)
+        try:
+            payload = body if isinstance(body, bytes) else (json.dumps(body).encode() if body is not None else None)
+            conn.request(method, path, body=payload, headers=headers or {})
+            response = conn.getresponse()
+            return response.status, {k.lower(): v for k, v in response.getheaders()}, response.read()
+        finally:
+            conn.close()
+
+    def request_json(self, method: str, path: str, body: object | None = None, headers: dict[str, str] | None = None):
+        status, response_headers, data = self.request(method, path, body, headers)
+        return status, json.loads(data.decode("utf-8")), response_headers
+
+
+class RoutingAndErrorCodesTest(HttpApiTestCase):
+    def test_health_returns_settings_and_jobs(self) -> None:
+        status, payload, _ = self.request_json("GET", "/api/health")
+
+        self.assertEqual(status, 200)
+        self.assertTrue(payload["ok"])
+        self.assertIn("keywords", payload["settings"])
+
+    def test_unknown_api_route_is_404_for_every_method(self) -> None:
+        self.assertEqual(self.request_json("GET", "/api/nope")[0], 404)
+        self.assertEqual(self.request_json("POST", "/api/nope", {})[0], 404)
+        self.assertEqual(self.request_json("PUT", "/api/nope", {})[0], 404)
+
+    def test_validation_errors_are_400_with_message(self) -> None:
+        status, payload, _ = self.request_json("POST", "/api/parse-schedule", {"text": ""})
+        self.assertEqual(status, 400)
+        self.assertIn("予定内容", payload["error"])
+
+        status, payload, _ = self.request_json("PUT", "/api/settings", {"keywords": "not-a-list"})
+        self.assertEqual(status, 400)
+        self.assertIn("keywords", payload["error"])
+
+    def test_invalid_json_body_is_400(self) -> None:
+        status, payload, _ = self.request_json(
+            "POST", "/api/parse-schedule", b"{broken", {"Content-Type": "application/json"}
+        )
+
+        self.assertEqual(status, 400)
+        self.assertIn("JSON", payload["error"])
+
+    def test_non_object_json_body_is_400(self) -> None:
+        status, _, _ = self.request_json("POST", "/api/parse-schedule", [1, 2, 3])
+
+        self.assertEqual(status, 400)
+
+    def test_invalid_ids_for_confirm_are_400(self) -> None:
+        status, _, _ = self.request_json("POST", "/api/keyword-matches/confirm", {"ids": ["abc"]})
+
+        self.assertEqual(status, 400)
+
+    def test_oversized_body_is_413(self) -> None:
+        conn = http.client.HTTPConnection("127.0.0.1", self.port, timeout=5)
+        try:
+            conn.putrequest("POST", "/api/parse-schedule")
+            conn.putheader("Content-Length", str(server.MAX_BODY_BYTES + 1))
+            conn.endheaders()
+            response = conn.getresponse()
+            self.assertEqual(response.status, 413)
+        finally:
+            conn.close()
+
+    def test_malformed_content_length_is_400(self) -> None:
+        conn = http.client.HTTPConnection("127.0.0.1", self.port, timeout=5)
+        try:
+            conn.putrequest("POST", "/api/parse-schedule")
+            conn.putheader("Content-Length", "abc")
+            conn.endheaders()
+            response = conn.getresponse()
+            self.assertEqual(response.status, 400)
+        finally:
+            conn.close()
+
+    def test_unexpected_errors_are_500_and_logged(self) -> None:
+        with (
+            patch.object(services, "refresh_addresses", side_effect=RuntimeError("Outlookに接続できません")),
+            self.assertLogs(config.LOGGER, level="ERROR"),
+        ):
+            status, payload, _ = self.request_json("POST", "/api/refresh-addresses", {})
+
+        self.assertEqual(status, 500)
+        self.assertEqual(payload["error"], "Outlookに接続できません")
+
+    def test_settings_roundtrip(self) -> None:
+        body = {"keywords": ["棚卸", "-除外"], "my_email": "a@example.com"}
+        status, saved, _ = self.request_json("PUT", "/api/settings", body)
+        self.assertEqual(status, 200)
+        self.assertEqual(saved["keywords"], ["棚卸", "-除外"])
+
+        status, loaded, _ = self.request_json("GET", "/api/settings")
+        self.assertEqual(status, 200)
+        self.assertEqual(loaded["my_email"], "a@example.com")
+
+
+class OriginAndHostTest(HttpApiTestCase):
+    def test_cross_origin_requests_are_rejected_without_cors_headers(self) -> None:
+        headers = {"Origin": "https://evil.example"}
+        requests = (
+            ("GET", "/api/settings"),
+            ("POST", "/api/parse-schedule"),
+            ("PUT", "/api/settings"),
+            ("OPTIONS", "/api/settings"),
+        )
+        for method, path in requests:
+            with self.subTest(method=method):
+                body: dict[str, Any] | None = {} if method in ("POST", "PUT") else None
+                status, _, response_headers = self.request_json(method, path, body, headers)
+                self.assertEqual(status, 403)
+                self.assertNotIn("access-control-allow-origin", response_headers)
+
+    def test_same_origin_request_gets_matching_cors_header(self) -> None:
+        origin = f"http://127.0.0.1:{self.port}"
+
+        status, _, response_headers = self.request_json("GET", "/api/settings", headers={"Origin": origin})
+
+        self.assertEqual(status, 200)
+        self.assertEqual(response_headers["access-control-allow-origin"], origin)
+
+    def test_unexpected_host_header_is_rejected_on_loopback_binding(self) -> None:
+        status, _, _ = self.request("GET", "/api/settings", headers={"Host": "attacker.example"})
+        self.assertEqual(status, 403)
+
+        status, _, _ = self.request("GET", "/", headers={"Host": "attacker.example:8765"})
+        self.assertEqual(status, 403)
+
+    def test_localhost_host_header_is_accepted(self) -> None:
+        status, _, _ = self.request("GET", "/api/settings", headers={"Host": f"localhost:{self.port}"})
+
+        self.assertEqual(status, 200)
+
+
+class OriginValidationTest(unittest.TestCase):
+    def test_browser_origin_must_match_request_host(self) -> None:
+        self.assertTrue(server.is_allowed_browser_origin(None, "127.0.0.1:8765"))
+        self.assertTrue(server.is_allowed_browser_origin("http://127.0.0.1:8765", "127.0.0.1:8765"))
+        self.assertFalse(server.is_allowed_browser_origin("https://example.com", "127.0.0.1:8765"))
+        self.assertFalse(server.is_allowed_browser_origin("null", "127.0.0.1:8765"))
+        self.assertFalse(server.is_allowed_browser_origin("http://[::1", "127.0.0.1:8765"))
+
+
+class HostValidationTest(unittest.TestCase):
+    def test_loopback_binding_only_accepts_loopback_names(self) -> None:
+        for host in ("127.0.0.1", "127.0.0.1:8765", "localhost:3000", "LOCALHOST", "[::1]", "[::1]:8765"):
+            with self.subTest(host=host):
+                self.assertTrue(server.is_allowed_host(host, "127.0.0.1"))
+        rejected: list[str | None] = [None, "", "evil.example", "evil.example:8765", "127.0.0.1.evil.example"]
+        for bad_host in rejected:
+            with self.subTest(host=bad_host):
+                self.assertFalse(server.is_allowed_host(bad_host, "127.0.0.1"))
+
+    def test_non_loopback_binding_skips_host_validation(self) -> None:
+        self.assertTrue(server.is_allowed_host("192.168.0.10:8765", "0.0.0.0"))
+
+
+class CacheHeaderTest(HttpApiTestCase):
+    def test_api_responses_are_not_cacheable(self) -> None:
+        _, _, headers = self.request_json("GET", "/api/health")
+
+        self.assertEqual(headers["cache-control"], "no-store")
+
+    def test_hashed_assets_are_immutable(self) -> None:
+        status, headers, _ = self.request("GET", "/assets/index-abc123.js")
+
+        self.assertEqual(status, 200)
+        self.assertIn("immutable", headers["cache-control"])
+
+    def test_html_and_service_worker_are_revalidated(self) -> None:
+        for path in ("/", "/index.html", "/sw.js"):
+            with self.subTest(path=path):
+                status, headers, _ = self.request("GET", path)
+                self.assertEqual(status, 200)
+                self.assertEqual(headers["cache-control"], "no-cache")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/backend/test_outlook.py b/backend/test_outlook.py
new file mode 100644
index 0000000000000000000000000000000000000000..f6f3e205a1f520ef21cc53a1a6b5d91fb77633f8
--- /dev/null
+++ b/backend/test_outlook.py
@@ -0,0 +1,346 @@
+"""Outlook COM接続まわりのテスト（pywin32はモックする）。"""
+from __future__ import annotations
+
+import sys
+import tempfile
+import types
+import unittest
+from typing import Any
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+from backend import config, db, outlook, services
+from backend.testing import FakeAppointment, FakeOutlook
+
+
+def fake_client(ensure_dispatch: MagicMock, dispatch: MagicMock) -> SimpleNamespace:
+    return SimpleNamespace(gencache=SimpleNamespace(EnsureDispatch=ensure_dispatch), Dispatch=dispatch)
+
+
+class OutlookApplicationTest(unittest.TestCase):
+    def test_returns_early_when_ensure_dispatch_works(self) -> None:
+        app = object()
+        ensure, dispatch = MagicMock(return_value=app), MagicMock()
+
+        with patch.object(outlook, "_import_win32com_client", return_value=fake_client(ensure, dispatch)):
+            self.assertIs(outlook.outlook_application(), app)
+
+        ensure.assert_called_once_with("Outlook.Application")
+        dispatch.assert_not_called()
+
+    def test_clears_cache_and_retries_when_first_attempt_fails(self) -> None:
+        app = object()
+        ensure = MagicMock(side_effect=[RuntimeError("stale gen_py"), app])
+
+        with (
+            patch.object(outlook, "_import_win32com_client", return_value=fake_client(ensure, MagicMock())),
+            patch.object(outlook, "clear_outlook_gen_py_cache") as clear,
+            self.assertLogs(config.LOGGER, level="WARNING"),
+        ):
+            self.assertIs(outlook.outlook_application(), app)
+
+        clear.assert_called_once()
+        self.assertEqual(ensure.call_count, 2)
+
+    def test_falls_back_to_plain_dispatch_after_two_failures(self) -> None:
+        app = object()
+        ensure = MagicMock(side_effect=RuntimeError("broken"))
+        dispatch = MagicMock(return_value=app)
+
+        with (
+            patch.object(outlook, "_import_win32com_client", return_value=fake_client(ensure, dispatch)),
+            patch.object(outlook, "clear_outlook_gen_py_cache"),
+            self.assertLogs(config.LOGGER, level="WARNING"),
+        ):
+            self.assertIs(outlook.outlook_application(), app)
+
+    def test_reports_actionable_error_when_every_strategy_fails(self) -> None:
+        ensure = MagicMock(side_effect=RuntimeError("broken"))
+        dispatch = MagicMock(side_effect=RuntimeError("not registered"))
+
+        with (
+            patch.object(outlook, "_import_win32com_client", return_value=fake_client(ensure, dispatch)),
+            patch.object(outlook, "clear_outlook_gen_py_cache"),
+            self.assertLogs(config.LOGGER, level="WARNING"),self.assertRaises(RuntimeError) as context
+        ):
+            outlook.outlook_application()
+
+        self.assertIn("クラシック版Outlook", str(context.exception))
+
+    def test_missing_pywin32_is_reported_without_traceback_noise(self) -> None:
+        with (
+            patch.dict("sys.modules", {"win32com": None, "win32com.client": None}),
+            self.assertLogs(config.LOGGER, level="WARNING") as logs,
+            self.assertRaises(RuntimeError) as context,
+        ):
+            outlook.outlook_application()
+
+        self.assertIn("pywin32", str(context.exception))
+        self.assertFalse(any(record.exc_info for record in logs.records))
+
+
+class GenPyCacheDirTest(unittest.TestCase):
+    def test_is_none_when_temp_is_not_set(self) -> None:
+        with patch.dict("os.environ", {}, clear=True):
+            self.assertIsNone(outlook.gen_py_cache_dir())
+
+
+def add_schedule_with_body(body: str, appointment: FakeAppointment) -> None:
+    with (
+        patch.object(outlook, "outlook_com_context"),
+        patch.object(outlook, "outlook_application", return_value=FakeOutlook(appointment)),
+        patch.object(db, "record_job_run"),
+    ):
+        services.add_schedule({
+            "event": {
+                "start": "2026-05-21T10:15",
+                "end": "2026-05-21T11:45",
+                "subject": "会議",
+                "location": "",
+                "body": body,
+                "all_day": False,
+            },
+        })
+
+
+class LooksLikeHtmlTest(unittest.TestCase):
+    def test_detects_any_html_tag(self) -> None:
+        for body in ("<p>x</p>", "foo<br>bar", "foo <b>bar</b> baz", "<br/>", "a<A HREF='x'>b</A>"):
+            with self.subTest(body=body):
+                self.assertTrue(outlook.looks_like_html(body))
+
+    def test_plain_text_and_escaped_entities_are_not_html(self) -> None:
+        for body in ("", "plain", "A &amp; B", "1 &lt; 2 &gt; 0", "a < b and c > d", "3<4"):
+            with self.subTest(body=body):
+                self.assertFalse(outlook.looks_like_html(body))
+
+
+class HtmlToTextTest(unittest.TestCase):
+    def test_converts_block_tags_and_br_to_newlines(self) -> None:
+        text = outlook.html_to_text("<div>一行目</div><div>二行目<br>三行目</div><p>四 &amp; 五</p>")
+        self.assertEqual(text, "一行目\n二行目\n三行目\n四 & 五")
+
+    def test_drops_script_and_style_content(self) -> None:
+        self.assertEqual(outlook.html_to_text("<style>p{}</style><p>本文</p><script>x()</script>"), "本文")
+
+
+class AddScheduleBodyTest(unittest.TestCase):
+    def test_inline_br_body_is_imported_as_html(self) -> None:
+        appointment = FakeAppointment()
+
+        add_schedule_with_body("1行目<br>2行目", appointment)
+
+        self.assertEqual(appointment.GetInspector.WordEditor.Range().inserted_content, "1行目<br>2行目")
+
+    def test_html_body_with_link_is_imported_as_is_and_saved(self) -> None:
+        appointment = FakeAppointment()
+        html_body = "<p>議題を確認する <a href='http://example.com'>リンク</a></p>"
+
+        add_schedule_with_body(html_body, appointment)
+
+        self.assertEqual(appointment.GetInspector.WordEditor.Range().inserted_content, html_body)
+        self.assertTrue(appointment.saved)
+
+    def test_plain_body_with_entities_is_unescaped(self) -> None:
+        appointment = FakeAppointment()
+
+        add_schedule_with_body("A &amp; B &lt;C&gt;", appointment)
+
+        self.assertEqual(appointment.Body, "A & B <C>")
+        self.assertIsNone(appointment.GetInspector.WordEditor.Range().inserted_content)
+
+    def test_html_import_failure_falls_back_to_readable_text(self) -> None:
+        appointment = FakeAppointment()
+        appointment.GetInspector = None  # type: ignore[assignment]
+
+        with self.assertLogs(config.LOGGER, level="WARNING"):
+            add_schedule_with_body("<div>議題</div><div>確認 &amp; 共有</div>", appointment)
+
+        self.assertEqual(appointment.Body, "議題\n確認 & 共有")
+        self.assertTrue(appointment.saved)
+
+
+class OutlookIntegrationTest(unittest.TestCase):
+    def add_schedule(self, payload: dict[str, Any]) -> tuple[dict[str, Any], FakeAppointment, FakeOutlook]:
+        appointment = FakeAppointment()
+        fake_outlook = FakeOutlook(appointment)
+        with (
+            patch.object(outlook, "outlook_com_context"),
+            patch.object(outlook, "outlook_application", return_value=fake_outlook),
+            patch.object(db, "record_job_run"),
+        ):
+            return services.add_schedule(payload), appointment, fake_outlook
+
+    def test_add_schedule_saves_outlook_appointment(self) -> None:
+        result, appointment, fake_outlook = self.add_schedule({"text": "2026/5/20 15:00から16:30 調整会議"})
+
+        self.assertTrue(result["saved"])
+        self.assertTrue(appointment.saved)
+        self.assertEqual(fake_outlook.item_type, 1)
+        self.assertEqual(appointment.Subject, "調整会議")
+        self.assertEqual(appointment.Start, "2026/05/20 15:00:00")
+        self.assertEqual(appointment.Duration, 90)
+
+    def test_add_schedule_sets_reminder_and_busy_status(self) -> None:
+        _, appointment, _ = self.add_schedule({"text": "2026/5/20 15:00から16:30 調整会議"})
+
+        self.assertTrue(appointment.ReminderSet)
+        self.assertEqual(appointment.ReminderMinutesBeforeStart, 5)
+        self.assertEqual(appointment.BusyStatus, 2)
+        self.assertFalse(appointment.AllDayEvent)
+
+    def test_add_schedule_marks_all_day_events(self) -> None:
+        _, appointment, _ = self.add_schedule({"text": "2026/5/20 研修"})
+
+        self.assertTrue(appointment.AllDayEvent)
+
+    def test_add_schedule_uses_edited_event_payload(self) -> None:
+        result, appointment, _ = self.add_schedule({
+            "text": "今週の水曜日 調整会議",
+            "event": {
+                "start": "2026-05-21T10:15",
+                "end": "2026-05-21T11:45",
+                "subject": "編集後会議",
+                "location": "第1会議室",
+                "body": "議題を確認する",
+                "all_day": False,
+                "normalized_text": "今週の水曜日 調整会議",
+            },
+        })
+
+        self.assertEqual(result["event"]["subject"], "編集後会議")
+        self.assertEqual(appointment.Subject, "編集後会議")
+        self.assertEqual(appointment.Location, "第1会議室")
+        self.assertEqual(appointment.Body, "議題を確認する")
+        self.assertEqual(appointment.Start, "2026/05/21 10:15:00")
+        self.assertEqual(appointment.Duration, 90)
+
+    def test_outlook_com_context_initializes_and_uninitializes_com(self) -> None:
+        calls: list[str] = []
+        fake_pythoncom = types.SimpleNamespace(
+            CoInitialize=lambda: calls.append("init"),
+            CoUninitialize=lambda: calls.append("uninit"),
+        )
+
+        with patch.dict(sys.modules, {"pythoncom": fake_pythoncom}), outlook.outlook_com_context():
+            calls.append("body")
+
+        self.assertEqual(calls, ["init", "body", "uninit"])
+
+
+    def test_find_keyword_matches_exclude_logic(self) -> None:
+        """
+        職アドのキーワード除外機能（マイナスキーワード指定）の判定ロジックをテストする。
+        - 肯定キーワードが本文行に含まれ、かつ件名・該当行に除外キーワードが無い場合にヒットすること。
+        - 件名に除外キーワードが含まれている場合、本文の該当行に肯定キーワードが含まれていても除外されること。
+        - 本文の該当行に除外キーワードが含まれている場合、肯定キーワードが含まれていても除外されること。
+        """
+        class FakeMessage:
+            def __init__(self, subject: str, body: str, received_time: str) -> None:
+                self.Subject = subject
+                self.Body = body
+                self.ReceivedTime = received_time
+
+        class FakeItems:
+            def __init__(self, messages: list[FakeMessage]) -> None:
+                self.messages = messages
+
+            def Sort(self, key: str, descending: bool) -> None:
+                pass
+
+            def __iter__(self):
+                return iter(self.messages)
+
+        class FakeFolder:
+            def __init__(self, items: FakeItems) -> None:
+                self.Items = items
+
+        class FakeNamespace:
+            def __init__(self, folder: FakeFolder) -> None:
+                self.folder = folder
+
+            def GetDefaultFolder(self, index: int) -> FakeFolder:
+                return self.folder
+
+        # モックメッセージの準備
+        msg1 = FakeMessage(
+            subject="職アドからのお知らせ: RPA通知",
+            body="RPAの実行結果を報告します。\nRPAG受付の準備が完了しました。",
+            received_time="2026-05-26T10:00:00+09:00"
+        )
+        msg2 = FakeMessage(
+            subject="職アドからのお知らせ: RPAG受付開始",
+            body="RPAの処理を開始します。",
+            received_time="2026-05-26T11:00:00+09:00"
+        )
+        msg3 = FakeMessage(
+            subject="職アドからのお知らせ: 通常処理",
+            body="RPAの処理が完了しました。\n別の処理も問題ありませんでした。",
+            received_time="2026-05-26T12:00:00+09:00"
+        )
+
+        fake_namespace = FakeNamespace(FakeFolder(FakeItems([msg1, msg2, msg3])))
+
+        with (
+            patch.object(outlook, "outlook_com_context"),
+            patch.object(outlook, "outlook_namespace", return_value=fake_namespace),
+            patch.object(outlook, "message_received_time", side_effect=lambda m: m.ReceivedTime),
+        ):
+            # 1. 半角マイナス "-" での検証
+            matches = outlook.find_keyword_matches(["RPA", "-RPAG受付"])
+            lines = [m.line for m in matches]
+            self.assertEqual(len(matches), 2)
+            self.assertIn("RPAの実行結果を報告します。", lines)
+            self.assertIn("RPAの処理が完了しました。", lines)
+            self.assertNotIn("RPAG受付の準備が完了しました。", lines)
+            self.assertNotIn("RPAの処理を開始します。", lines)
+
+            # 2. 表記ゆれ（全角マイナス「－」）での検証
+            matches_zen = outlook.find_keyword_matches(["RPA", "－RPAG受付"])
+            lines_zen = [m.line for m in matches_zen]
+            self.assertEqual(len(matches_zen), 2)
+            self.assertIn("RPAの実行結果を報告します。", lines_zen)
+            self.assertNotIn("RPAG受付の準備が完了しました。", lines_zen)
+
+            # 3. 表記ゆれ（全角ハイフン/長音「ー」）での検証
+            matches_cho = outlook.find_keyword_matches(["RPA", "ーRPAG受付"])
+            lines_cho = [m.line for m in matches_cho]
+            self.assertEqual(len(matches_cho), 2)
+            self.assertIn("RPAの実行結果を報告します。", lines_cho)
+            self.assertNotIn("RPAG受付の準備が完了しました。", lines_cho)
+
+
+    def test_clear_outlook_gen_py_cache_removes_disk_and_sys_modules(self) -> None:
+        """clear_outlook_gen_py_cache が、ディスクと sys.modules の両方のキャッシュを消去することを確認する"""
+        import sys
+
+        # 1. sys.modules のモック登録
+        sys.modules["win32com.dummy_module"] = types.ModuleType("dummy")
+        sys.modules["win32com.gen_py.dummy_sub"] = types.ModuleType("dummy_sub")
+
+        # 2. ディスク上のキャッシュディレクトリのシミュレーション
+        with tempfile.TemporaryDirectory() as tmp_temp_dir:
+            temp_path = Path(tmp_temp_dir)
+            gen_py_dir = temp_path / "gen_py" / f"{sys.version_info.major}.{sys.version_info.minor}"
+            cache_folder = gen_py_dir / "000000000046_dummy"
+            cache_folder.mkdir(parents=True)
+
+            # ダミーファイルの作成
+            dummy_file = cache_folder / "test.txt"
+            dummy_file.write_text("dummy", encoding="utf-8")
+
+            # 環境変数 TEMP をモックディレクトリに向ける
+            with patch.dict("os.environ", {"TEMP": str(tmp_temp_dir)}):
+                outlook.clear_outlook_gen_py_cache()
+
+            # フォルダが削除されたことを検証
+            self.assertFalse(cache_folder.exists())
+
+        # 3. sys.modules から削除されたことを検証
+        self.assertNotIn("win32com.dummy_module", sys.modules)
+        self.assertNotIn("win32com.gen_py.dummy_sub", sys.modules)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/backend/test_scheduler.py b/backend/test_scheduler.py
new file mode 100644
index 0000000000000000000000000000000000000000..b0674198505d41e63386c028ff16ee1b7afbbed5
--- /dev/null
+++ b/backend/test_scheduler.py
@@ -0,0 +1,119 @@
+"""自動実行スケジューラのテスト。"""
+from __future__ import annotations
+
+import threading
+import unittest
+from datetime import datetime, timedelta, UTC
+from unittest.mock import patch
+
+from backend import config, db, scheduler
+
+NOW = datetime(2026, 5, 20, 12, 0, tzinfo=UTC)
+
+
+def run_record(minutes_ago: int, status: str = "success") -> dict[str, str]:
+    return {
+        "last_run_at": (NOW - timedelta(minutes=minutes_ago)).isoformat(timespec="seconds"),
+        "status": status,
+        "message": "",
+    }
+
+
+class IsJobDueTest(unittest.TestCase):
+    def test_never_run_job_is_due(self) -> None:
+        self.assertTrue(scheduler.is_job_due(None, 60, NOW.timestamp()))
+
+    def test_unparsable_last_run_is_due(self) -> None:
+        run = {"last_run_at": "broken", "status": "success", "message": ""}
+        self.assertTrue(scheduler.is_job_due(run, 60, NOW.timestamp()))
+
+    def test_success_waits_for_full_interval(self) -> None:
+        self.assertFalse(scheduler.is_job_due(run_record(59), 60, NOW.timestamp()))
+        self.assertTrue(scheduler.is_job_due(run_record(60), 60, NOW.timestamp()))
+
+    def test_failed_job_is_retried_before_long_interval_elapses(self) -> None:
+        month = 43200
+        self.assertFalse(scheduler.is_job_due(run_record(10, "error"), month, NOW.timestamp()))
+        retry_run = run_record(scheduler.RETRY_AFTER_ERROR_MINUTES, "error")
+        self.assertTrue(scheduler.is_job_due(retry_run, month, NOW.timestamp()))
+
+    def test_failed_job_does_not_retry_faster_than_short_interval(self) -> None:
+        self.assertFalse(scheduler.is_job_due(run_record(5, "error"), 10, NOW.timestamp()))
+
+
+class SchedulerTickTest(unittest.TestCase):
+    def test_tick_starts_only_due_jobs(self) -> None:
+        settings = {"address_interval_minutes": 43200, "keyword_interval_minutes": 60}
+        runs = {
+            "refresh_addresses": run_record(100),
+            "check_keywords": run_record(120),
+        }
+        started: list[str] = []
+
+        class ImmediateThread:
+            def __init__(self, target, args=(), daemon=None) -> None:
+                self.target, self.args = target, args
+
+            def start(self) -> None:
+                self.target(*self.args)
+
+        with (
+            patch.object(db, "get_settings", return_value=settings),
+            patch.object(db, "list_job_runs", return_value=runs),
+            patch.object(scheduler, "run_job_safely", side_effect=lambda name, callback: started.append(name)),
+            patch.object(scheduler.threading, "Thread", ImmediateThread),
+        ):
+            scheduler.scheduler_tick(NOW.timestamp())
+
+        self.assertEqual(started, ["check_keywords"])
+
+
+class SchedulerLoopTest(unittest.TestCase):
+    def test_loop_survives_tick_errors_and_stops_on_event(self) -> None:
+        stop = threading.Event()
+        calls: list[int] = []
+
+        def failing_tick(_now: float) -> None:
+            calls.append(1)
+            if len(calls) >= 2:
+                stop.set()
+            raise RuntimeError("database is locked")
+
+        with (
+            patch.object(scheduler, "scheduler_tick", side_effect=failing_tick),
+            self.assertLogs(config.LOGGER, level="ERROR"),
+        ):
+            scheduler.scheduler_loop(stop_event=stop, interval_seconds=0)
+
+        self.assertEqual(len(calls), 2)
+
+
+class RunJobSafelyTest(unittest.TestCase):
+    def test_run_job_safely_skips_when_same_job_is_running(self) -> None:
+        job_name = "refresh_addresses"
+        calls: list[str] = []
+        lock = scheduler.job_lock(job_name)
+
+        self.assertTrue(lock.acquire(blocking=False))
+        try:
+            scheduler.run_job_safely(job_name, lambda: calls.append("called"))
+        finally:
+            lock.release()
+
+        self.assertEqual(calls, [])
+
+    def test_run_job_safely_allows_different_jobs_to_run(self) -> None:
+        calls: list[str] = []
+        lock = scheduler.job_lock("refresh_addresses")
+
+        self.assertTrue(lock.acquire(blocking=False))
+        try:
+            scheduler.run_job_safely("check_keywords", lambda: calls.append("called"))
+        finally:
+            lock.release()
+
+        self.assertEqual(calls, ["called"])
+
+
+if __name__ == "__main__":
+    unittest.main()
