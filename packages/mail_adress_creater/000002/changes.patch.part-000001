-function DatabaseTable({
-  snapshot,
-  table,
-  selectedKeys,
-  onSelectedKeysChange,
-}: {
-  snapshot: DatabaseSnapshot
-  table: DatabaseTableName
-  selectedKeys: string[]
-  onSelectedKeysChange: (keys: string[]) => void
-}) {
-  const rows = snapshot[table]
-  const columns = rows.length > 0 ? Object.keys(rows[0]) : []
-  const canDelete = table !== 'settings'
-  const rowKeys = rows.map(row => getDatabaseRowKey(table, row))
-  const selectedKeySet = new Set(selectedKeys)
-  const allSelected = canDelete && rowKeys.length > 0 && rowKeys.every(key => selectedKeySet.has(key))
-
-  const toggleAllRows = (checked: boolean) => {
-    onSelectedKeysChange(checked ? rowKeys : [])
-  }
-
-  const toggleRow = (key: string, checked: boolean) => {
-    if (checked) {
-      onSelectedKeysChange([...selectedKeys, key])
-      return
-    }
-    onSelectedKeysChange(selectedKeys.filter(selectedKey => selectedKey !== key))
-  }
-
-  return (
-    <div className="min-h-0 flex-1 overflow-auto overscroll-contain bg-gray-950">
-      {rows.length === 0 ? (
-        <div className="px-3 py-6 text-center text-xs text-gray-400">データがありません</div>
-      ) : (
-        <table className="w-full min-w-max text-left text-xs">
-          <thead className="sticky top-0 bg-gray-900 text-gray-300">
-            <tr>
-              <th className="w-10 px-3 py-2 border-b border-gray-800">
-                {canDelete && (
-                  <input
-                    type="checkbox"
-                    checked={allSelected}
-                    onChange={event => toggleAllRows(event.target.checked)}
-                    className="h-4 w-4 accent-red-500"
-                    aria-label="全レコードを選択"
-                  />
-                )}
-              </th>
-              {columns.map(column => (
-                <th key={column} className="px-3 py-2 font-semibold whitespace-nowrap border-b border-gray-800">
-                  {column}
-                </th>
-              ))}
-            </tr>
-          </thead>
-          <tbody className="divide-y divide-gray-800 text-gray-200">
-            {rows.map((row, rowIndex) => (
-              <tr key={rowIndex} className="hover:bg-gray-900/80">
-                <td className="px-3 py-2 align-top">
-                  {canDelete && (
-                    <input
-                      type="checkbox"
-                      checked={selectedKeySet.has(rowKeys[rowIndex])}
-                      onChange={event => toggleRow(rowKeys[rowIndex], event.target.checked)}
-                      className="h-4 w-4 accent-red-500"
-                      aria-label={`${rowKeys[rowIndex]}を選択`}
-                    />
-                  )}
-                </td>
-                {columns.map(column => (
-                  <td key={column} className="px-3 py-2 align-top max-w-[720px]">
-                    <span className="block whitespace-pre-wrap break-words" title={String(row[column as keyof typeof row])}>
-                      {String(row[column as keyof typeof row])}
-                    </span>
-                  </td>
-                ))}
-              </tr>
-            ))}
-          </tbody>
-        </table>
-      )}
-    </div>
-  )
-}
-
-function getDatabaseRowKey(table: DatabaseTableName, row: DatabaseSnapshot[DatabaseTableName][number]) {
-  if (table === 'keyword_matches' && 'id' in row) {
-    return String(row.id)
-  }
-  if (table === 'recipients' && 'name' in row) {
-    return row.name
-  }
-  if (table === 'favorites' && 'name' in row) {
-    return row.name
-  }
-  if (table === 'job_runs' && 'job_name' in row) {
-    return row.job_name
-  }
-  if (table === 'settings' && 'key' in row) {
-    return row.key
-  }
-  return JSON.stringify(row)
-}
-
 export default App
diff --git a/src/components/AppHeader.tsx b/src/components/AppHeader.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..d414270568eab7c10642181a3acf7ef113da370a
--- /dev/null
+++ b/src/components/AppHeader.tsx
@@ -0,0 +1,75 @@
+/**
+ * 画面上部のヘッダー
+ * 設定メニューの開閉、アドレス再取得、職アドチェック、DB表示、お気に入り、プロフィールコピーの入口
+ */
+import type { ReactNode } from 'react'
+import type { BackendSettings } from '../utils/api'
+import type { RunningAction } from '../hooks/useOperation'
+import { ProfileCopyButtons } from './ProfileCopyButtons'
+import { headerButtonClass } from './styles'
+
+type AppHeaderProps = {
+  menuOpen: boolean
+  runningAction: RunningAction | null
+  settings: BackendSettings
+  onToggleMenu: () => void
+  onRefreshAddresses: () => void
+  onCheckKeywords: () => void
+  onLoadDatabase: () => void
+  onOpenFavorites: () => void
+  onCopyProfile: (value: string | undefined, label: string) => void
+  /** メニューが開いているときにヘッダー下部へ表示する設定パネル */
+  children?: ReactNode
+}
+
+export function AppHeader({
+  menuOpen,
+  runningAction,
+  settings,
+  onToggleMenu,
+  onRefreshAddresses,
+  onCheckKeywords,
+  onLoadDatabase,
+  onOpenFavorites,
+  onCopyProfile,
+  children,
+}: AppHeaderProps) {
+  const busy = runningAction !== null
+  return (
+    <header className="shrink-0 bg-gray-950/70 border border-gray-700/60 rounded-lg px-2 py-2 shadow-lg">
+      <div className="flex items-center gap-2">
+        <button
+          type="button"
+          onClick={onToggleMenu}
+          className="w-9 h-9 grid place-items-center rounded border border-gray-600/70 bg-gray-900/80 text-gray-200 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-500/60"
+          aria-label="設定メニュー"
+          aria-expanded={menuOpen}
+        >
+          <span className="flex flex-col gap-1" aria-hidden="true">
+            <span className="block w-4 h-0.5 bg-current rounded" />
+            <span className="block w-4 h-0.5 bg-current rounded" />
+            <span className="block w-4 h-0.5 bg-current rounded" />
+          </span>
+        </button>
+        <div className="min-w-0 mr-auto">
+          <h1 className="text-sm font-semibold text-gray-100">Outlook宛先作成</h1>
+          <p className="text-[10px] text-gray-400">送信履歴と職アド通知を管理</p>
+        </div>
+        <button type="button" onClick={onRefreshAddresses} disabled={busy} className={headerButtonClass.blue}>
+          {runningAction === 'addresses' ? '取得中...' : 'アドレス再取得'}
+        </button>
+        <button type="button" onClick={onCheckKeywords} disabled={busy} className={headerButtonClass.emerald}>
+          {runningAction === 'keywords' ? '確認中...' : '職アドキーワードチェック'}
+        </button>
+        <button type="button" onClick={onLoadDatabase} disabled={busy} className={headerButtonClass.slate}>
+          {runningAction === 'database' ? '読込中...' : 'DB表示'}
+        </button>
+        <button type="button" onClick={onOpenFavorites} className={headerButtonClass.cyan}>
+          お気に入り
+        </button>
+        <ProfileCopyButtons settings={settings} onCopy={onCopyProfile} />
+      </div>
+      {menuOpen && children}
+    </header>
+  )
+}
diff --git a/src/components/DatabaseModal.test.tsx b/src/components/DatabaseModal.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..3961615abca5d12b3c5c6787d459b0443c96eef5
--- /dev/null
+++ b/src/components/DatabaseModal.test.tsx
@@ -0,0 +1,93 @@
+/**
+ * DatabaseModalコンポーネントのテスト
+ * テーブル切替、行の選択、settingsが削除不可であることを確認する
+ */
+import { describe, it, expect, vi } from 'vitest'
+import { render, screen, fireEvent } from '@testing-library/react'
+import { DatabaseModal } from './DatabaseModal'
+import type { DatabaseViewerController } from '../hooks/useDatabaseViewer'
+import type { DatabaseSnapshot } from '../utils/api'
+
+const snapshot: DatabaseSnapshot = {
+  settings: [{ key: 'keywords', value: '["棚卸"]' }],
+  recipients: [
+    { name: '山田 太郎', count: 3, updated_at: '2026-05-14' },
+    { name: '佐藤 一郎', count: 1, updated_at: '2026-05-13' },
+  ],
+  favorites: [],
+  keyword_matches: [],
+  job_runs: [],
+}
+
+function viewer(overrides: Partial<DatabaseViewerController> = {}): DatabaseViewerController {
+  return {
+    open: true,
+    snapshot,
+    table: 'recipients',
+    selectedKeys: [],
+    setSelectedKeys: vi.fn(),
+    selectTable: vi.fn(),
+    load: vi.fn(),
+    close: vi.fn(),
+    deleteSelected: vi.fn(),
+    seedDummy: vi.fn(),
+    ...overrides,
+  } as DatabaseViewerController
+}
+
+describe('DatabaseModal', () => {
+  it('閉じているとき、またはスナップショットが無いときは何も表示しない', () => {
+    const { container, rerender } = render(<DatabaseModal viewer={viewer({ open: false })} runningAction={null} />)
+    expect(container).toBeEmptyDOMElement()
+
+    rerender(<DatabaseModal viewer={viewer({ snapshot: null })} runningAction={null} />)
+    expect(container).toBeEmptyDOMElement()
+  })
+
+  it('選択中テーブルの行を表示し、各テーブルの件数をボタンに出す', () => {
+    render(<DatabaseModal viewer={viewer()} runningAction={null} />)
+
+    expect(screen.getByText('山田 太郎')).toBeInTheDocument()
+    expect(screen.getByRole('button', { name: 'recipients (2)' })).toBeInTheDocument()
+    expect(screen.getByRole('button', { name: 'settings (1)' })).toBeInTheDocument()
+  })
+
+  it('行のチェックと全選択で、主キー(name)の配列を通知する', () => {
+    const setSelectedKeys = vi.fn()
+    render(<DatabaseModal viewer={viewer({ setSelectedKeys })} runningAction={null} />)
+
+    fireEvent.click(screen.getByLabelText('山田 太郎を選択'))
+    expect(setSelectedKeys).toHaveBeenLastCalledWith(['山田 太郎'])
+
+    fireEvent.click(screen.getByLabelText('全レコードを選択'))
+    expect(setSelectedKeys).toHaveBeenLastCalledWith(['山田 太郎', '佐藤 一郎'])
+  })
+
+  it('選択削除は、選択があるときだけ押せる', () => {
+    const { rerender } = render(<DatabaseModal viewer={viewer()} runningAction={null} />)
+    expect(screen.getByRole('button', { name: /選択削除/ })).toBeDisabled()
+
+    rerender(<DatabaseModal viewer={viewer({ selectedKeys: ['山田 太郎'] })} runningAction={null} />)
+    expect(screen.getByRole('button', { name: '選択削除 (1)' })).toBeEnabled()
+  })
+
+  it('settingsテーブルはチェックボックスを出さず、削除もできない', () => {
+    render(<DatabaseModal viewer={viewer({ table: 'settings', selectedKeys: ['keywords'] })} runningAction={null} />)
+
+    expect(screen.queryByLabelText('全レコードを選択')).not.toBeInTheDocument()
+    expect(screen.getByRole('button', { name: /選択削除/ })).toBeDisabled()
+  })
+
+  it('テーブル切替・更新・閉じるのボタンが対応する操作を呼ぶ', () => {
+    const v = viewer()
+    render(<DatabaseModal viewer={v} runningAction={null} />)
+
+    fireEvent.click(screen.getByRole('button', { name: 'settings (1)' }))
+    fireEvent.click(screen.getByRole('button', { name: '更新' }))
+    fireEvent.click(screen.getByRole('button', { name: '閉じる' }))
+
+    expect(v.selectTable).toHaveBeenCalledWith('settings')
+    expect(v.load).toHaveBeenCalled()
+    expect(v.close).toHaveBeenCalled()
+  })
+})
diff --git a/src/components/DatabaseModal.tsx b/src/components/DatabaseModal.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..bb269db523b48afd2fe3bcd0d63cff748318768a
--- /dev/null
+++ b/src/components/DatabaseModal.tsx
@@ -0,0 +1,153 @@
+/**
+ * DB閲覧モーダル
+ * SQLiteの主要テーブルを閲覧し、settings以外は選択削除できる（最新データを上に表示）
+ */
+import type { DatabaseSnapshot } from '../utils/api'
+import type { DatabaseTableName, DatabaseViewerController } from '../hooks/useDatabaseViewer'
+import type { RunningAction } from '../hooks/useOperation'
+import { getDatabaseRowKey } from '../utils/databaseRows'
+
+const TABLES: DatabaseTableName[] = ['keyword_matches', 'recipients', 'favorites', 'job_runs', 'settings']
+
+type DatabaseModalProps = {
+  viewer: DatabaseViewerController
+  runningAction: RunningAction | null
+}
+
+export function DatabaseModal({ viewer, runningAction }: DatabaseModalProps) {
+  const { snapshot, table } = viewer
+  if (!viewer.open || !snapshot) {
+    return null
+  }
+  const busy = runningAction !== null
+  return (
+    <div className="fixed inset-0 z-40 bg-black/70 p-3 md:p-5">
+      <section className="h-full min-h-0 flex flex-col bg-gray-950 border border-gray-700/80 rounded-lg shadow-2xl">
+        <div className="shrink-0 flex flex-wrap items-center gap-2 border-b border-gray-800 px-3 py-3">
+          <div className="mr-auto">
+            <h2 className="text-base font-semibold text-gray-100">DB閲覧</h2>
+            <p className="text-[11px] text-gray-400">最新データを上に表示しています</p>
+          </div>
+          {TABLES.map(name => (
+            <button
+              key={name}
+              type="button"
+              onClick={() => viewer.selectTable(name)}
+              className={`px-3 py-2 rounded border text-xs ${
+                table === name
+                  ? 'bg-blue-600 border-blue-500 text-white'
+                  : 'bg-gray-900 border-gray-700 text-gray-300 hover:bg-gray-800'
+              }`}
+            >
+              {name} ({snapshot[name].length})
+            </button>
+          ))}
+          <button
+            type="button"
+            onClick={() => void viewer.load()}
+            disabled={busy}
+            className="px-3 py-2 rounded bg-gray-800 text-xs text-gray-100 hover:bg-gray-700 disabled:cursor-wait"
+          >
+            更新
+          </button>
+          <button
+            type="button"
+            onClick={() => void viewer.deleteSelected()}
+            disabled={table === 'settings' || viewer.selectedKeys.length === 0 || busy}
+            className="px-3 py-2 rounded bg-red-600 text-xs font-semibold text-white hover:bg-red-500 disabled:bg-gray-700 disabled:text-gray-400 disabled:cursor-not-allowed"
+          >
+            選択削除 ({viewer.selectedKeys.length})
+          </button>
+          <button
+            type="button"
+            onClick={viewer.close}
+            className="px-3 py-2 rounded bg-gray-100 text-xs font-semibold text-gray-950 hover:bg-white"
+          >
+            閉じる
+          </button>
+        </div>
+        <DatabaseTable
+          snapshot={snapshot}
+          table={table}
+          selectedKeys={viewer.selectedKeys}
+          onSelectedKeysChange={viewer.setSelectedKeys}
+        />
+      </section>
+    </div>
+  )
+}
+
+type DatabaseTableProps = {
+  snapshot: DatabaseSnapshot
+  table: DatabaseTableName
+  selectedKeys: string[]
+  onSelectedKeysChange: (keys: string[]) => void
+}
+
+function DatabaseTable({ snapshot, table, selectedKeys, onSelectedKeysChange }: DatabaseTableProps) {
+  const rows: Array<Record<string, unknown>> = snapshot[table]
+  const columns = rows.length > 0 ? Object.keys(rows[0]) : []
+  const canDelete = table !== 'settings'
+  const rowKeys = rows.map(row => getDatabaseRowKey(table, row))
+  const selectedKeySet = new Set(selectedKeys)
+  const allSelected = canDelete && rowKeys.length > 0 && rowKeys.every(key => selectedKeySet.has(key))
+
+  const toggleRow = (key: string, checked: boolean) => {
+    onSelectedKeysChange(checked ? [...selectedKeys, key] : selectedKeys.filter(selectedKey => selectedKey !== key))
+  }
+
+  return (
+    <div className="min-h-0 flex-1 overflow-auto overscroll-contain bg-gray-950">
+      {rows.length === 0 ? (
+        <div className="px-3 py-6 text-center text-xs text-gray-400">データがありません</div>
+      ) : (
+        <table className="w-full min-w-max text-left text-xs">
+          <thead className="sticky top-0 bg-gray-900 text-gray-300">
+            <tr>
+              <th className="w-10 px-3 py-2 border-b border-gray-800">
+                {canDelete && (
+                  <input
+                    type="checkbox"
+                    checked={allSelected}
+                    onChange={event => onSelectedKeysChange(event.target.checked ? rowKeys : [])}
+                    className="h-4 w-4 accent-red-500"
+                    aria-label="全レコードを選択"
+                  />
+                )}
+              </th>
+              {columns.map(column => (
+                <th key={column} className="px-3 py-2 font-semibold whitespace-nowrap border-b border-gray-800">
+                  {column}
+                </th>
+              ))}
+            </tr>
+          </thead>
+          <tbody className="divide-y divide-gray-800 text-gray-200">
+            {rows.map((row, rowIndex) => (
+              <tr key={rowKeys[rowIndex]} className="hover:bg-gray-900/80">
+                <td className="px-3 py-2 align-top">
+                  {canDelete && (
+                    <input
+                      type="checkbox"
+                      checked={selectedKeySet.has(rowKeys[rowIndex])}
+                      onChange={event => toggleRow(rowKeys[rowIndex], event.target.checked)}
+                      className="h-4 w-4 accent-red-500"
+                      aria-label={`${rowKeys[rowIndex]}を選択`}
+                    />
+                  )}
+                </td>
+                {columns.map(column => (
+                  <td key={column} className="px-3 py-2 align-top max-w-[720px]">
+                    <span className="block whitespace-pre-wrap break-words" title={String(row[column])}>
+                      {String(row[column])}
+                    </span>
+                  </td>
+                ))}
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      )}
+    </div>
+  )
+}
diff --git a/src/components/FavoriteModal.tsx b/src/components/FavoriteModal.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..3ab3aee4d2eeac0a2635f019c1112eaf38ea43d0
--- /dev/null
+++ b/src/components/FavoriteModal.tsx
@@ -0,0 +1,151 @@
+/**
+ * お気に入り編集モーダル
+ * 常に2カラム（左: 名前の一覧、右: 編集）。右は上下に分割し、宛先(To)とCCを個別に改行区切りで編集する
+ * Escapeキーまたは背景クリックで閉じる
+ */
+import { useEffect } from 'react'
+import type { FavoritesController } from '../hooks/useFavorites'
+import { parseFavoriteAddressText } from '../utils/favorites'
+
+type FavoriteModalProps = {
+  favorites: FavoritesController
+  onClose: () => void
+}
+
+const TEXTAREA_CLASS =
+  'flex-1 min-h-[120px] w-full resize-none bg-transparent p-3 font-mono text-sm leading-6 text-gray-100 outline-none placeholder:text-gray-600 overflow-y-auto'
+const AREA_TITLE_CLASS =
+  'bg-gray-950/40 px-3 py-1 text-[11px] font-semibold text-gray-400 border-b border-gray-800/50 flex justify-between items-center shrink-0'
+
+export function FavoriteModal({ favorites, onClose }: FavoriteModalProps) {
+  const { draft, selectedName } = favorites
+  const selected = favorites.favorites.find(favorite => favorite.name === selectedName)
+
+  useEffect(() => {
+    const handleEscape = (e: KeyboardEvent) => {
+      if (e.key === 'Escape') {
+        onClose()
+      }
+    }
+    window.addEventListener('keydown', handleEscape)
+    return () => window.removeEventListener('keydown', handleEscape)
+  }, [onClose])
+
+  return (
+    <div className="fixed inset-0 z-50 bg-black/70 p-3 md:p-5" onMouseDown={onClose}>
+      <section
+        className="mx-auto flex h-full max-w-6xl flex-col border border-gray-700/80 bg-gray-950 text-gray-100 shadow-2xl"
+        onMouseDown={event => event.stopPropagation()}
+      >
+        <header className="shrink-0 border-b border-gray-800 bg-gray-950 px-4 py-3">
+          <div className="flex items-center gap-3">
+            <div className="min-w-0 mr-auto">
+              <h1 className="text-lg font-semibold text-gray-50">お気に入り</h1>
+              <p className="text-xs text-gray-400">左で名前を選択し、右で内容を編集</p>
+            </div>
+            <button
+              type="button"
+              onClick={favorites.startNew}
+              className="h-9 px-4 rounded border border-gray-700 bg-gray-900 text-xs font-bold text-gray-100 hover:bg-gray-800"
+            >
+              新規
+            </button>
+            <button
+              type="button"
+              onClick={() => void favorites.saveDraft()}
+              className="h-9 px-4 rounded bg-cyan-500 text-xs font-bold text-gray-950 hover:bg-cyan-400"
+            >
+              保存
+            </button>
+            <button
+              type="button"
+              onClick={onClose}
+              className="h-9 px-3 rounded bg-gray-100 text-xs font-bold text-gray-950 hover:bg-white"
+            >
+              閉じる
+            </button>
+          </div>
+        </header>
+
+        <div className="grid min-h-0 flex-1 gap-3 p-3 grid-cols-[minmax(130px,240px)_minmax(0,1fr)] sm:grid-cols-[240px_minmax(0,1fr)]">
+          <aside className="min-h-0 flex flex-col border border-gray-800 bg-gray-900">
+            <div className="flex items-center justify-between border-b border-gray-800 px-3 py-3 shrink-0">
+              <h2 className="text-sm font-semibold text-gray-100">お気に入り名</h2>
+              <span className="rounded bg-gray-800 px-2 py-1 text-xs text-gray-300">{favorites.favorites.length}件</span>
+            </div>
+            <div className="flex-1 min-h-0 overflow-y-auto">
+              {favorites.favorites.length === 0 ? (
+                <p className="px-3 py-8 text-center text-xs text-gray-500">お気に入りがありません</p>
+              ) : favorites.favorites.map(favorite => (
+                <button
+                  key={favorite.name}
+                  type="button"
+                  onClick={() => favorites.select(favorite)}
+                  className={`block w-full border-b border-gray-800 px-3 py-3 text-left hover:bg-gray-800 ${
+                    selectedName === favorite.name ? 'bg-cyan-500/15 text-cyan-100' : 'text-gray-200'
+                  }`}
+                >
+                  <span className="block truncate text-sm font-semibold" title={favorite.name}>{favorite.name}</span>
+                  <span className="mt-1 block text-xs text-gray-400">{favorite.addresses.length}宛先</span>
+                </button>
+              ))}
+            </div>
+          </aside>
+
+          <section className="min-h-0 flex flex-col border border-gray-800 bg-gray-900">
+            <div className="grid gap-3 border-b border-gray-800 p-3 grid-cols-[minmax(0,1fr)_auto]">
+              <label className="flex min-w-0 flex-col gap-1 text-xs text-gray-300">
+                お気に入り名
+                <input
+                  type="text"
+                  value={draft.name}
+                  onChange={event => favorites.updateDraft({ name: event.target.value })}
+                  className="h-10 rounded border border-gray-700 bg-gray-950 px-3 text-sm text-gray-100 outline-none focus:border-cyan-400"
+                  placeholder="例: 開発チーム"
+                />
+              </label>
+              <div className="flex items-end gap-2">
+                <button
+                  type="button"
+                  onClick={() => void favorites.deleteSelected()}
+                  className="h-10 px-3 rounded bg-red-600 text-xs font-semibold text-white hover:bg-red-500"
+                >
+                  削除
+                </button>
+              </div>
+            </div>
+            <div className="border-b border-gray-800 px-3 py-2 text-xs text-gray-400 shrink-0">
+              {selected ? `${selected.name} を編集中` : '新しいお気に入りを編集中'} / To {parseFavoriteAddressText(draft.toText).length}宛先 / CC {parseFavoriteAddressText(draft.ccText).length}宛先
+            </div>
+            <div className="flex-1 flex flex-col min-h-0 divide-y divide-gray-800">
+              <div className="flex-1 flex flex-col min-h-0">
+                <div className={AREA_TITLE_CLASS}>
+                  <span>宛先（To）のリスト（改行区切り）</span>
+                </div>
+                <textarea
+                  value={draft.toText}
+                  onChange={event => favorites.updateDraft({ toText: event.target.value })}
+                  spellCheck={false}
+                  className={TEXTAREA_CLASS}
+                  placeholder={'山田 太郎\n佐藤 一郎'}
+                />
+              </div>
+              <div className="flex-1 flex flex-col min-h-0">
+                <div className={AREA_TITLE_CLASS}>
+                  <span>CC のリスト（改行区切り）</span>
+                </div>
+                <textarea
+                  value={draft.ccText}
+                  onChange={event => favorites.updateDraft({ ccText: event.target.value })}
+                  spellCheck={false}
+                  className={TEXTAREA_CLASS}
+                  placeholder={'keiri@example.com\n鈴木 二郎'}
+                />
+              </div>
+            </div>
+          </section>
+        </div>
+      </section>
+    </div>
+  )
+}
diff --git a/src/components/GlobalContextMenu.tsx b/src/components/GlobalContextMenu.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..17772a1239f29116f3f3ae61b9893ce49bd9f750
--- /dev/null
+++ b/src/components/GlobalContextMenu.tsx
@@ -0,0 +1,70 @@
+/**
+ * 画面全体の右クリックメニュー
+ * 現在の宛先・CCの選択状態をお気に入りへ追加する／お気に入りを宛先・CCへ一括適用する
+ * クリックまたはキー操作で閉じる
+ */
+import { useEffect } from 'react'
+import type { Favorite } from '../utils/api'
+import { contextMenuItemClass } from './styles'
+
+type GlobalContextMenuProps = {
+  position: { x: number; y: number }
+  favorites: Favorite[]
+  onSaveCurrent: () => void
+  onApply: (favorite: Favorite) => void
+  onClose: () => void
+}
+
+export function GlobalContextMenu({ position, favorites, onSaveCurrent, onApply, onClose }: GlobalContextMenuProps) {
+  useEffect(() => {
+    window.addEventListener('click', onClose)
+    window.addEventListener('keydown', onClose)
+    return () => {
+      window.removeEventListener('click', onClose)
+      window.removeEventListener('keydown', onClose)
+    }
+  }, [onClose])
+
+  return (
+    <div
+      className="fixed z-50 min-w-48 rounded-lg border border-gray-700/80 bg-gray-950/95 py-1 text-xs text-gray-100 shadow-2xl backdrop-blur-md"
+      style={{ left: position.x, top: position.y }}
+      onClick={e => e.stopPropagation()}
+    >
+      <button
+        type="button"
+        className={`${contextMenuItemClass} flex items-center gap-1.5`}
+        onClick={() => {
+          onSaveCurrent()
+          onClose()
+        }}
+      >
+        <span>📁</span> 現在の宛先・CCをお気に入りに追加
+      </button>
+      <div className="border-t border-gray-800 my-1" />
+      <div className="px-4 py-1 text-[10px] font-semibold text-gray-500 uppercase tracking-wider">お気に入りを適用...</div>
+      {favorites.length === 0 ? (
+        <div className="px-4 py-2 text-gray-500 italic">お気に入りがありません</div>
+      ) : (
+        <div className="max-h-48 overflow-y-auto">
+          {favorites.map(favorite => (
+            <button
+              key={favorite.name}
+              type="button"
+              className={`${contextMenuItemClass} pl-6 flex items-center justify-between`}
+              onClick={() => {
+                onApply(favorite)
+                onClose()
+              }}
+            >
+              <span className="truncate">{favorite.name}</span>
+              <span className="text-[10px] text-gray-500 ml-2">
+                To:{favorite.addresses.length} CC:{(favorite.cc_addresses ?? []).length}
+              </span>
+            </button>
+          ))}
+        </div>
+      )}
+    </div>
+  )
+}
diff --git a/src/components/HtmlEditor.test.tsx b/src/components/HtmlEditor.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a219254617a56226c1cef84ae72f489b3dc61b27
--- /dev/null
+++ b/src/components/HtmlEditor.test.tsx
@@ -0,0 +1,61 @@
+/**
+ * HtmlEditorコンポーネントのテスト
+ * 外部からの値の反映、編集内容の通知、Office HTML貼り付け時のサニタイズを確認する
+ */
+import { describe, it, expect, vi } from 'vitest'
+import { render, fireEvent } from '@testing-library/react'
+import { HtmlEditor } from './HtmlEditor'
+
+const getEditor = (container: HTMLElement) => container.querySelector('[contenteditable="true"]') as HTMLElement
+
+describe('HtmlEditor', () => {
+  it('valueをエディタに反映し、外部から変わったら更新する', () => {
+    const { container, rerender } = render(<HtmlEditor value="<p>最初</p>" onChange={() => {}} />)
+    expect(getEditor(container).innerHTML).toBe('<p>最初</p>')
+
+    rerender(<HtmlEditor value="<p>更新後</p>" onChange={() => {}} />)
+
+    expect(getEditor(container).innerHTML).toBe('<p>更新後</p>')
+  })
+
+  it('フォーカスが外れたときに編集内容をHTMLとして通知する', () => {
+    const onChange = vi.fn()
+    const { container } = render(<HtmlEditor value="" onChange={onChange} />)
+    const editor = getEditor(container)
+
+    editor.innerHTML = '<b>太字</b>'
+    fireEvent.blur(editor)
+
+    expect(onChange).toHaveBeenCalledWith('<b>太字</b>')
+  })
+
+  it('HTMLの貼り付けはOffice固有の属性やタグを除いて挿入する', () => {
+    const onChange = vi.fn()
+    const { container } = render(<HtmlEditor value="" onChange={onChange} />)
+    const editor = getEditor(container)
+    const range = document.createRange()
+    range.selectNodeContents(editor)
+    const selection = window.getSelection()!
+    selection.removeAllRanges()
+    selection.addRange(range)
+
+    const officeHtml = '<p class="MsoNormal" style="margin:0;color:red"><o:p></o:p><a href="https://example.com" class="x">リンク</a></p>'
+    const notPrevented = fireEvent.paste(editor, {
+      clipboardData: { getData: (type: string) => (type === 'text/html' ? officeHtml : '') },
+    })
+
+    expect(notPrevented).toBe(false)
+    expect(editor.innerHTML).toBe('<p style="color: red"><a href="https://example.com">リンク</a></p>')
+    expect(onChange).toHaveBeenLastCalledWith(editor.innerHTML)
+  })
+
+  it('HTMLを含まない貼り付けはブラウザの標準動作に任せる', () => {
+    const { container } = render(<HtmlEditor value="" onChange={() => {}} />)
+
+    const notPrevented = fireEvent.paste(getEditor(container), {
+      clipboardData: { getData: () => '' },
+    })
+
+    expect(notPrevented).toBe(true)
+  })
+})
diff --git a/src/components/KeywordMatchBanner.tsx b/src/components/KeywordMatchBanner.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c311dc91b1d23436b24a2c09fec6ef8f71952568
--- /dev/null
+++ b/src/components/KeywordMatchBanner.tsx
@@ -0,0 +1,41 @@
+/**
+ * 職アド通知バナー
+ * 未確認のキーワード一致を強調表示し、「確認」を押すまで消えない
+ */
+import type { KeywordMatch } from '../utils/api'
+
+type KeywordMatchBannerProps = {
+  matches: KeywordMatch[]
+  onConfirm: () => void
+}
+
+export function KeywordMatchBanner({ matches, onConfirm }: KeywordMatchBannerProps) {
+  if (matches.length === 0) {
+    return null
+  }
+  return (
+    <section className="shrink-0 bg-amber-300 text-gray-950 border-2 border-amber-100 rounded-lg p-3 shadow-xl">
+      <div className="flex items-start justify-between gap-3">
+        <div>
+          <h2 className="text-sm font-bold">新しい職アド通知があります</h2>
+          <p className="text-xs text-gray-800">{matches.length}件のキーワード一致を検出しました</p>
+        </div>
+        <button
+          type="button"
+          onClick={onConfirm}
+          className="px-2 py-1 rounded bg-gray-950 text-white text-xs hover:bg-gray-800"
+        >
+          確認
+        </button>
+      </div>
+      <ul className="mt-2 max-h-28 overflow-y-auto text-xs divide-y divide-amber-500/40">
+        {matches.map((match, index) => (
+          <li key={`${match.received_time}-${match.keyword}-${index}`} className="py-1">
+            <span className="font-semibold">[{match.keyword}]</span> {match.line}
+            <span className="block text-[10px] text-gray-700">{match.received_time} / {match.subject}</span>
+          </li>
+        ))}
+      </ul>
+    </section>
+  )
+}
diff --git a/src/components/ProfileCopyButtons.tsx b/src/components/ProfileCopyButtons.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..dbc00d47db0d32ab8e45799e7be83ae714ee2335
--- /dev/null
+++ b/src/components/ProfileCopyButtons.tsx
@@ -0,0 +1,38 @@
+/**
+ * プロフィールかんたんコピーボタン
+ * 設定に保存したメール・電話・住所・部署・家アドを、ワンクリックでクリップボードへコピーする
+ */
+import type { BackendSettings } from '../utils/api'
+
+type ProfileCopyField = 'my_email' | 'my_phone' | 'my_address' | 'my_dept' | 'my_home_email'
+
+/** ボタン表示名とトースト用の項目名 */
+const PROFILE_BUTTONS: Array<{ field: ProfileCopyField; button: string; label: string }> = [
+  { field: 'my_email', button: 'メール', label: 'メールアドレス' },
+  { field: 'my_phone', button: '電話', label: '電話番号' },
+  { field: 'my_address', button: '住所', label: '住所' },
+  { field: 'my_dept', button: '部署', label: '部署' },
+  { field: 'my_home_email', button: '家アド', label: '家のメールアドレス' },
+]
+
+type ProfileCopyButtonsProps = {
+  settings: BackendSettings
+  onCopy: (value: string | undefined, label: string) => void
+}
+
+export function ProfileCopyButtons({ settings, onCopy }: ProfileCopyButtonsProps) {
+  return (
+    <div className="flex gap-1 border-l border-gray-700 pl-2">
+      {PROFILE_BUTTONS.map(({ field, button, label }) => (
+        <button
+          key={field}
+          type="button"
+          onClick={() => onCopy(settings[field], label)}
+          className="px-2.5 py-2 rounded bg-gray-800 hover:bg-gray-700 border border-gray-700 text-[10px] text-gray-200 transition-colors font-medium"
+        >
+          {button}
+        </button>
+      ))}
+    </div>
+  )
+}
diff --git a/src/components/RecipientPane.test.tsx b/src/components/RecipientPane.test.tsx
index 9af64976ac3fe2a50b9f14852a0e979dd584aaeb..ab3f0f6395e46a63f66c3f9cd4c6d7a49c6674fb 100644
