diff --git a/backend/test_python_env.py b/backend/test_python_env.py
index 0591a6eef17ec793a3553fcbe317b3f06537f42f..af2d73da07b40341970a15bf8bbe61e72d7492a5 100644
--- a/backend/test_python_env.py
+++ b/backend/test_python_env.py
@@ -84,9 +84,21 @@ class WindowsScriptsTest(unittest.TestCase):
     def test_start_uses_venv_python_and_runs_setup_when_missing(self) -> None:
         script = _batch("start_windows.bat")
         self.assertIn('call "%~dp0setup_windows.bat" /nopause', script)
-        self.assertIn('""%PYTHON_EXE%" backend\\server.py"', script)
         self.assertNotIn('cmd /c "python backend\\server.py"', script)
 
+    def test_start_launches_backend_directly_without_nested_quotes(self) -> None:
+        # cmd /c の入れ子の引用符(""...""）は start 経由で壊れやすいので、venvのPythonを直接起動する
+        script = _batch("start_windows.bat")
+        self.assertIn('start "Outlook Address Maker Backend" /min "%PYTHON_EXE%" backend\\server.py', script)
+        self.assertNotIn('cmd /c ""%PYTHON_EXE%"', script)
+
+    def test_start_shows_the_error_when_backend_fails(self) -> None:
+        # 最小化ウィンドウはPythonが落ちると消えてエラーが残らない。事前にimportを確かめ、失敗時は前面で起動し直して見せる
+        script = _batch("start_windows.bat")
+        self.assertIn('"%PYTHON_EXE%" -c "import backend.server"', script)
+        self.assertLess(script.index('-c "import backend.server"'), script.index('/min "%PYTHON_EXE%"'))
+        self.assertLess(script.index("Backend did not start"), script.rindex('"%PYTHON_EXE%" backend\\server.py'))
+
 
 class MacScriptTest(unittest.TestCase):
     def test_start_mac_uses_python314_venv(self) -> None:
diff --git a/start_windows.bat b/start_windows.bat
index 116e3c32cf911915f00bc6ab70458b44568dd732..0b77238ec057b4cb5c4039f5f9a71e3c5d3fc3f5 100644
--- a/start_windows.bat
+++ b/start_windows.bat
@@ -44,11 +44,20 @@ if not errorlevel 1 (
 )
 
 echo Starting Outlook address maker on http://%OUTLOOK_ADDRESS_HOST%:%OUTLOOK_ADDRESS_PORT% ...
-start "Outlook Address Maker Backend" /min cmd /c ""%PYTHON_EXE%" backend\server.py"
+rem Check that the backend can be imported first, so a broken install shows its error here.
+"%PYTHON_EXE%" -c "import backend.server"
+if errorlevel 1 (
+  echo Backend import failed. See the error above. Run setup_windows.bat again if a module is missing.
+  goto error
+)
+
+start "Outlook Address Maker Backend" /min "%PYTHON_EXE%" backend\server.py
 
 powershell -NoProfile -ExecutionPolicy Bypass -Command "for ($i = 0; $i -lt 20; $i++) { try { $response = Invoke-WebRequest -UseBasicParsing 'http://%OUTLOOK_ADDRESS_HOST%:%OUTLOOK_ADDRESS_PORT%/api/health' -TimeoutSec 1; if ($response.StatusCode -eq 200) { exit 0 } } catch { Start-Sleep -Milliseconds 500 } }; exit 1"
 if errorlevel 1 (
   echo Backend did not start on port %OUTLOOK_ADDRESS_PORT%.
+  echo Running it in this window to show the error. Close this window to stop it.
+  "%PYTHON_EXE%" backend\server.py
   goto error
 )
 echo Backend is ready.
