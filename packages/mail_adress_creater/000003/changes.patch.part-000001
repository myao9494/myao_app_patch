diff --git a/backend/requirements-lock.txt b/backend/requirements-lock.txt
new file mode 100644
index 0000000000000000000000000000000000000000..19c583799d469da77c6449a29f1136bcc1651c09
--- /dev/null
+++ b/backend/requirements-lock.txt
@@ -0,0 +1,12 @@
+# -*- coding: utf-8 -*-
+# 版を固定した依存一覧（backend/requirements.txt から書き出す）
+#
+# Windows の setup_windows.bat と Mac の start_mac.command が、プロジェクト直下の .venv へ pip でこれを入れる。
+# 会社PCには uv が無いので、どの端末でも pip だけで同じ版を再現できるようにしている。
+# Python 3.14 用。pywin32 は Windows だけに入り、Python 3.14 / win_amd64 のビルド済み wheel がある。
+#
+# requirements.txt を変えたら、uv のある端末（Mac）で書き出し直す（冒頭のコメントはそのまま残る）:
+#   cd backend
+#   { grep '^#' requirements-lock.txt; uv pip compile -q --universal --python-version 3.14 --no-header --no-annotate requirements.txt; } > requirements-lock.txt.new && mv requirements-lock.txt.new requirements-lock.txt
+# backend/test_python_env.py が固定漏れを確かめる。
+pywin32==312 ; sys_platform == 'win32'
diff --git a/backend/test_python_env.py b/backend/test_python_env.py
new file mode 100644
index 0000000000000000000000000000000000000000..0591a6eef17ec793a3553fcbe317b3f06537f42f
--- /dev/null
+++ b/backend/test_python_env.py
@@ -0,0 +1,100 @@
+"""Python実行環境（.venv）の用意と起動スクリプトの約束のテスト。
+
+仕様（AGENTS.md「起動とPython実行環境」）:
+- Pythonは3.14（Mac・会社のWindowsとも3.14.9。`.python-version`）。バックエンドは常にプロジェクト直下の
+  `.venv` のPythonで起動する（システムの python は使わない）。
+- 依存は版を固定した `backend/requirements-lock.txt` をpipで入れる（会社PCにuvは無い）。
+- Windowsは `setup_windows.bat` がPython 3.14を `py -3.14` → `python` の順に探して `.venv` を作り（3.14で動かない
+  `.venv` は作り直す）、`requirements-lock.txt`（pywin32を含む）を入れる。`start_windows.bat` は `.venv` が無ければ呼ぶ。
+- Macの `start_mac.command` も3.14で動かない `.venv` を作り直し、`.venv` のPythonで起動する。
+- `.bat` はASCIIのみ・CRLF（日本語コードページのcmd.exeが行を読み違えないように）。
+
+Windows上での実行はこのMacでは確かめられないので、スクリプトの約束だけを確かめる。
+"""
+from __future__ import annotations
+
+import re
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+LOCK = ROOT / "backend" / "requirements-lock.txt"
+
+
+def _normalize(name: str) -> str:
+    return re.sub(r"[-_.]+", "-", name).lower()
+
+
+def _names(path: Path) -> set[str]:
+    names = set()
+    for line in path.read_text(encoding="utf-8").splitlines():
+        line = line.split("#", 1)[0].strip()
+        if line:
+            match = re.match(r"^[A-Za-z0-9._-]+", line)
+            assert match is not None
+            names.add(_normalize(match.group(0)))
+    return names
+
+
+def _batch(name: str) -> str:
+    raw = (ROOT / name).read_bytes()
+    assert b"\n" not in raw.replace(b"\r\n", b""), f"{name} に LF だけの改行があります"
+    return raw.decode("ascii")  # ASCII以外が入っていれば UnicodeDecodeError
+
+
+class RequirementsLockTest(unittest.TestCase):
+    def test_lock_pins_every_requirement_with_exact_versions(self) -> None:
+        lines = [line.split("#", 1)[0].strip() for line in LOCK.read_text(encoding="utf-8").splitlines()]
+        lines = [line for line in lines if line]
+        self.assertTrue(all(re.match(r"^[A-Za-z0-9._-]+==\S+", line) for line in lines), lines)
+        self.assertLessEqual(_names(ROOT / "backend" / "requirements.txt"), _names(LOCK))
+
+    def test_lock_installs_pywin32_only_on_windows(self) -> None:
+        self.assertRegex(LOCK.read_text(encoding="utf-8"), re.compile(r"^pywin32==\S+ ; sys_platform == 'win32'$", re.MULTILINE))
+
+    def test_lock_declares_utf8_first(self) -> None:
+        # 宣言が無いと、pipが日本語版Windowsの既定（cp932）で読み、日本語コメントで失敗することがある
+        self.assertEqual(LOCK.read_bytes().splitlines()[0], b"# -*- coding: utf-8 -*-")
+
+    def test_python_version_is_314(self) -> None:
+        self.assertEqual((ROOT / ".python-version").read_text(encoding="utf-8").strip(), "3.14.9")
+
+    def test_venv_is_not_committed(self) -> None:
+        self.assertIn(".venv/", (ROOT / ".gitignore").read_text(encoding="utf-8").splitlines())
+
+
+class WindowsScriptsTest(unittest.TestCase):
+    def test_setup_finds_python314_with_py_launcher_first(self) -> None:
+        script = _batch("setup_windows.bat")
+        self.assertLess(script.index("py -3.14"), script.index('set "PY_CMD=python"'))
+        self.assertIn("sys.version_info[:2] == (3, 14)", script)
+
+    def test_setup_recreates_venv_and_installs_lock_without_uv(self) -> None:
+        script = _batch("setup_windows.bat")
+        self.assertIn("%PY_CMD% -m venv --clear .venv", script)
+        self.assertIn('"%VENV_PY%" -m pip install -r backend\\requirements-lock.txt', script)
+        self.assertIsNone(re.search(r"^\s*uv\s", script, re.MULTILINE | re.IGNORECASE))
+
+    def test_setup_goto_targets_exist(self) -> None:
+        script = _batch("setup_windows.bat")
+        labels = {line.strip()[1:].lower() for line in script.splitlines() if line.strip().startswith(":")}
+        targets = {m.lower() for m in re.findall(r"goto :?([A-Za-z_]+)", script, re.IGNORECASE)}
+        self.assertLessEqual(targets, labels)
+
+    def test_start_uses_venv_python_and_runs_setup_when_missing(self) -> None:
+        script = _batch("start_windows.bat")
+        self.assertIn('call "%~dp0setup_windows.bat" /nopause', script)
+        self.assertIn('""%PYTHON_EXE%" backend\\server.py"', script)
+        self.assertNotIn('cmd /c "python backend\\server.py"', script)
+
+
+class MacScriptTest(unittest.TestCase):
+    def test_start_mac_uses_python314_venv(self) -> None:
+        script = (ROOT / "start_mac.command").read_text(encoding="utf-8")
+        self.assertIn("sys.version_info[:2] == (3, 14)", script)
+        self.assertIn(".venv/bin/python backend/server.py", script)
+        self.assertNotIn("python3 backend/server.py", script)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/setup_windows.bat b/setup_windows.bat
new file mode 100644
index 0000000000000000000000000000000000000000..d47173608f9e20359708b05303b6e160d171537f
--- /dev/null
+++ b/setup_windows.bat
@@ -0,0 +1,66 @@
+@echo off
+rem ==============================================================================
+rem Outlook Address Maker - Windows setup (setup_windows.bat)
+rem Keep this file ASCII-only: cmd.exe may misparse multi-byte text under the
+rem Japanese code page.
+rem The company PC has no uv, so this uses only Python 3.14 and pip.
+rem 1. Find Python 3.14 (py -3.14 first, then python). Stop if it is missing.
+rem 2. Create .venv. Reuse it when it already runs on Python 3.14; otherwise
+rem    (broken, or made with another Python version) recreate it. Only the
+rem    contents of .venv are replaced. Never install into the system Python.
+rem 3. Install backend\requirements-lock.txt (pywin32, pinned) with pip.
+rem Usage: double-click. Safe to run again.
+rem   start_windows.bat calls it with /nopause when .venv is missing.
+rem   If a proxy is required, configure pip (pip.ini or HTTPS_PROXY) first.
+rem ==============================================================================
+setlocal
+cd /d "%~dp0"
+
+set "VENV_PY=%~dp0.venv\Scripts\python.exe"
+set "NOPAUSE="
+if /i "%~1"=="/nopause" set "NOPAUSE=1"
+
+rem --- Find Python 3.14 ---
+set "PY_CMD="
+py -3.14 -c "import sys" >nul 2>&1 && set "PY_CMD=py -3.14"
+if not defined PY_CMD (
+  python -c "import sys; sys.exit(0 if sys.version_info[:2] == (3, 14) else 1)" >nul 2>&1 && set "PY_CMD=python"
+)
+if not defined PY_CMD (
+  echo [Setup] ERROR: Python 3.14 was not found. Install Python 3.14 and add it to PATH.
+  goto :fail
+)
+for /f "delims=" %%V in ('%PY_CMD% -V 2^>^&1') do echo [Setup] Using %%V [%PY_CMD%]
+
+rem --- Prepare .venv ---
+set "VENV_OK="
+if exist "%VENV_PY%" (
+  "%VENV_PY%" -c "import sys; sys.exit(0 if sys.version_info[:2] == (3, 14) else 1)" >nul 2>&1 && set "VENV_OK=1"
+)
+if defined VENV_OK (
+  echo [Setup] Reusing .venv
+) else (
+  echo [Setup] Creating .venv ...
+  %PY_CMD% -m venv --clear .venv
+  if errorlevel 1 goto :fail
+)
+if not exist "%VENV_PY%" goto :fail
+
+rem --- Install dependencies ---
+echo [Setup] Upgrading pip ...
+"%VENV_PY%" -m pip install --upgrade pip
+echo [Setup] Installing backend\requirements-lock.txt ...
+"%VENV_PY%" -m pip install -r backend\requirements-lock.txt
+if errorlevel 1 goto :fail
+
+"%VENV_PY%" -c "import win32com.client, sys; print('[Setup] Python', sys.version.split()[0], '/ pywin32 OK')"
+if errorlevel 1 goto :fail
+
+echo [Setup] Done. Start the app with start_windows.bat
+if not defined NOPAUSE pause
+exit /b 0
+
+:fail
+echo [Setup] Setup failed. See the messages above.
+if not defined NOPAUSE pause
+exit /b 1
diff --git a/start_mac.command b/start_mac.command
index 3160a1df49b9759e632322f66ceb5b0da5edcd99..d1b7681e7cf0f5b207fde7a92eccae42ba568b2d 100755
--- a/start_mac.command
+++ b/start_mac.command
@@ -41,6 +41,24 @@ if lsof -iTCP:$PORT -sTCP:LISTEN >/dev/null 2>&1; then
   exit 1
 fi
 
+# バックエンドは常に .venv（Python 3.14）で起動する。.venv が無い・壊れている・3.14 でないときは作り直す。
+# backend/requirements-lock.txt が前回入れたときより新しければ入れ直す（Mac では入るものが無くても同じ手順にしておく）。
+IS_314='import sys; sys.exit(0 if sys.version_info[:2] == (3, 14) else 1)'
+MARKER=.venv/.requirements-lock.installed
+if ! .venv/bin/python -c "$IS_314" >/dev/null 2>&1; then
+  if ! python3 -c "$IS_314" >/dev/null 2>&1; then
+    echo "Python 3.14 の python3 が見つかりません（現在: $(python3 -V 2>&1 || echo なし)）。"
+    exit 1
+  fi
+  echo "Python 3.14 で .venv を作成します。"
+  python3 -m venv --clear .venv
+  rm -f "$MARKER"
+fi
+if [ ! -f "$MARKER" ] || [ backend/requirements-lock.txt -nt "$MARKER" ]; then
+  .venv/bin/python -m pip install --quiet -r backend/requirements-lock.txt
+  touch "$MARKER"
+fi
+
 echo "Outlook宛先作成アプリを起動します。"
 echo "ブラウザで http://$HOST:$PORT を開いてください。"
-OUTLOOK_ADDRESS_HOST=$HOST OUTLOOK_ADDRESS_PORT=$PORT python3 backend/server.py
+OUTLOOK_ADDRESS_HOST=$HOST OUTLOOK_ADDRESS_PORT=$PORT .venv/bin/python backend/server.py
diff --git a/start_windows.bat b/start_windows.bat
index f21f6119d7b63e1c206ab5d5d5e80c2cb0c22ad2..116e3c32cf911915f00bc6ab70458b44568dd732 100644
--- a/start_windows.bat
+++ b/start_windows.bat
@@ -2,6 +2,15 @@
 setlocal
 cd /d "%~dp0"
 
+rem The backend always runs with .venv (Python 3.14). When .venv is missing,
+rem create it with setup_windows.bat (pip only; the company PC has no uv).
+set "PYTHON_EXE=%~dp0.venv\Scripts\python.exe"
+if not exist "%PYTHON_EXE%" call "%~dp0setup_windows.bat" /nopause
+if not exist "%PYTHON_EXE%" (
+  echo .venv could not be prepared. Run setup_windows.bat and check the messages.
+  goto error
+)
+
 if "%OUTLOOK_ADDRESS_HOST%"=="" set "OUTLOOK_ADDRESS_HOST=127.0.0.1"
 if "%OUTLOOK_ADDRESS_PORT%"=="" set "OUTLOOK_ADDRESS_PORT=8765"
 if "%OUTLOOK_ADDRESS_OPEN_BROWSER%"=="" set "OUTLOOK_ADDRESS_OPEN_BROWSER=1"
@@ -35,7 +44,7 @@ if not errorlevel 1 (
 )
 
 echo Starting Outlook address maker on http://%OUTLOOK_ADDRESS_HOST%:%OUTLOOK_ADDRESS_PORT% ...
-start "Outlook Address Maker Backend" /min cmd /c "python backend\server.py"
+start "Outlook Address Maker Backend" /min cmd /c ""%PYTHON_EXE%" backend\server.py"
 
 powershell -NoProfile -ExecutionPolicy Bypass -Command "for ($i = 0; $i -lt 20; $i++) { try { $response = Invoke-WebRequest -UseBasicParsing 'http://%OUTLOOK_ADDRESS_HOST%:%OUTLOOK_ADDRESS_PORT%/api/health' -TimeoutSec 1; if ($response.StatusCode -eq 200) { exit 0 } } catch { Start-Sleep -Milliseconds 500 } }; exit 1"
 if errorlevel 1 (
