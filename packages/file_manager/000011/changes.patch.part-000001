index 57305fbd5b67882a7d82bf9ee0377fd519fa9014..27fdac6f5535fd1698d6020d5cdb08a03fdbe742 100644
--- a/frontend/src/api/files.ts
+++ b/frontend/src/api/files.ts
@@ -512,6 +512,17 @@ export function getDownloadUrl(path: string): string {
 /**
  * 全文検索URLを取得
  */
+/**
+ * 差分アプリ（visual-diff-tool、127.0.0.1:8078）の Git差分を、フォルダ・ファイルのパスで開く URL
+ * （HEAD と作業ツリーの比較。Git 管理下が前提。フォルダはその中の変更、ファイルはそのファイルの変更を表示する）
+ */
+export function getGitDiffUrl(path: string): string {
+  const url = new URL("http://127.0.0.1:8078/");
+  const normalizedPath = path.replace(/^\/([A-Za-z]:\/)/, "$1");
+  url.searchParams.set("git_path", normalizedPath);
+  return url.toString();
+}
+
