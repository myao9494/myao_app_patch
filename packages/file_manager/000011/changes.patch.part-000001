diff --git a/frontend/src/utils/menuPosition.test.ts b/frontend/src/utils/menuPosition.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..416a50d131f71b1cc7e906ef7fb3688cfd0ba224
--- /dev/null
+++ b/frontend/src/utils/menuPosition.test.ts
@@ -0,0 +1,21 @@
+/**
+ * 右クリックメニューの位置（画面の端でも、メニュー全体を画面の内側に収める）のテスト
+ */
+import { describe, expect, it } from "vitest";
+import { clampMenuPosition } from "./menuPosition";
+
+describe("clampMenuPosition", () => {
+  const viewport = { width: 1000, height: 800 };
+
+  it("収まるときは、押した位置のまま", () => {
+    expect(clampMenuPosition(100, 200, { width: 220, height: 300 }, viewport)).toEqual({ left: 100, top: 200 });
+  });
+
+  it("下や右にはみ出すときは、実際の大きさの分だけ内側へずらす（余白 8px）", () => {
+    expect(clampMenuPosition(900, 700, { width: 220, height: 300 }, viewport)).toEqual({ left: 772, top: 492 });
+  });
+
+  it("画面より大きいときは、上端・左端に合わせる（項目を上から見られるように）", () => {
+    expect(clampMenuPosition(500, 500, { width: 220, height: 900 }, viewport)).toEqual({ left: 500, top: 8 });
+  });
+});
diff --git a/frontend/src/utils/menuPosition.ts b/frontend/src/utils/menuPosition.ts
new file mode 100644
index 0000000000000000000000000000000000000000..17980f85d33455572e2aba816c5e7ca0fafe7121
--- /dev/null
+++ b/frontend/src/utils/menuPosition.ts
@@ -0,0 +1,34 @@
+/**
+ * 右クリックメニューの位置
+ * - メニューの実際の大きさ（描画後に測る）で、画面の端からはみ出さない位置にする
+ * - 項目を足してメニューが伸びても、決め打ちの高さに頼らずに全項目が見えるようにする
+ * - 画面より高いときは上端に合わせる（上の項目から見られるように）
+ */
+import { useLayoutEffect, useState, type RefObject } from "react";
+
+const MARGIN = 8;
+
+export interface MenuSize {
+  width: number;
+  height: number;
+}
+
+export function clampMenuPosition(x: number, y: number, size: MenuSize, viewport: MenuSize): { left: number; top: number } {
+  const left = Math.max(MARGIN, Math.min(x, viewport.width - size.width - MARGIN));
+  const top = Math.max(MARGIN, Math.min(y, viewport.height - size.height - MARGIN));
+  return { left, top };
+}
+
+/** 押した位置 (x, y) から、メニューを画面の内側に収めた位置を返す（描画後に大きさを測って直す） */
+export function useClampedMenuPosition(ref: RefObject<HTMLElement | null>, x: number, y: number, deps: unknown[] = []) {
+  const [position, setPosition] = useState({ left: x, top: y });
+  useLayoutEffect(() => {
+    const element = ref.current;
+    if (!element) return;
+    const rect = element.getBoundingClientRect();
+    // 描画したメニューの大きさを測ってから位置を決める
+    setPosition(clampMenuPosition(x, y, { width: rect.width, height: rect.height }, { width: window.innerWidth, height: window.innerHeight }));
+    // eslint-disable-next-line react-hooks/exhaustive-deps -- deps は、メニューの中身が変わるとき（リネーム表示など）に測り直すため
+  }, [ref, x, y, ...deps]);
+  return position;
+}
