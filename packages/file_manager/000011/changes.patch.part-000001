+  it("ファイル・フォルダの右クリック「差分を表示」で、差分アプリの Git差分をそのパスで開く", async () => {
+    const open = vi.spyOn(window, "open").mockReturnValue(null);
+    try {
+      const ui = await ready();
+      fireEvent.contextMenu(ui.row("a.txt"));
+      await ui.user.click(await screen.findByText("差分を表示"));
+      expect(open).toHaveBeenLastCalledWith("http://127.0.0.1:8078/?git_path=%2Froot%2Fa.txt", "_blank", "noopener,noreferrer");
+      expect(screen.queryByText("差分を表示")).not.toBeInTheDocument();
+
+      fireEvent.contextMenu(ui.row("docs"));
+      await ui.user.click(await screen.findByText("差分を表示"));
+      expect(open).toHaveBeenLastCalledWith("http://127.0.0.1:8078/?git_path=%2Froot%2Fdocs", "_blank", "noopener,noreferrer");
+    } finally {
+      open.mockRestore();
+    }
+  });
+
+  it("余白の右クリック「このフォルダの差分を表示」で、開いているフォルダの差分を開く", async () => {
+    const open = vi.spyOn(window, "open").mockReturnValue(null);
+    try {
+      const ui = await ready();
+      fireEvent.contextMenu(ui.container.querySelector(".file-table thead")!);
+      await ui.user.click(await screen.findByText("このフォルダの差分を表示"));
+      expect(open).toHaveBeenLastCalledWith("http://127.0.0.1:8078/?git_path=%2Froot", "_blank", "noopener,noreferrer");
+    } finally {
+      open.mockRestore();
+    }
+  });
