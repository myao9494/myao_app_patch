{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    {
      "id": "node-phone",
      "type": "rectangle",
      "x": 100,
      "y": 120,
      "width": 240,
      "height": 180,
      "backgroundColor": "#1e293b",
      "strokeColor": "#38bdf8",
      "strokeWidth": 2,
      "roughness": 1,
      "roundness": { "type": 3 },
      "groupIds": []
    },
    {
      "id": "text-phone-title",
      "type": "text",
      "x": 120,
      "y": 140,
      "text": "スマートフォン (Safari/Chrome)\nTailscale VPN経由アクセス\nURL: http://<host>:8001/quick/",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#f8fafc"
    },
    {
      "id": "node-quick-app",
      "type": "rectangle",
      "x": 120,
      "y": 210,
      "width": 200,
      "height": 70,
      "backgroundColor": "#0f172a",
      "strokeColor": "#3b82f6",
      "strokeWidth": 1,
      "roundness": { "type": 3 },
      "groupIds": []
    },
    {
      "id": "text-quick-app",
      "type": "text",
      "x": 135,
      "y": 225,
      "text": "Quick SPA (frontend-quick)\n- 検索 & スニペット\n- 連絡先発信(tel:) / 編集",
      "fontSize": 12,
      "fontFamily": 1,
      "strokeColor": "#93c5fd"
    },
    {
      "id": "node-backend",
      "type": "rectangle",
      "x": 450,
      "y": 100,
      "width": 320,
      "height": 260,
      "backgroundColor": "#1e293b",
      "strokeColor": "#10b981",
      "strokeWidth": 2,
      "roundness": { "type": 3 },
      "groupIds": []
    },
    {
      "id": "text-backend-title",
      "type": "text",
      "x": 470,
      "y": 120,
      "text": "FastAPI Backend (Port: 8001)\n0.0.0.0 (Tailscale/LAN待受)",
      "fontSize": 16,
      "fontFamily": 1,
      "strokeColor": "#34d399"
    },
    {
      "id": "node-api-routes",
      "type": "rectangle",
      "x": 470,
      "y": 170,
      "width": 280,
      "height": 160,
      "backgroundColor": "#0f172a",
      "strokeColor": "#6ee7b7",
      "strokeWidth": 1,
      "roundness": { "type": 3 },
      "groupIds": []
    },
    {
      "id": "text-api-routes",
      "type": "text",
      "x": 485,
      "y": 185,
      "text": "配信 & APIエンドポイント:\n・GET /quick/ -> frontend-quick配信\n・GET /       -> ファイルマネージャー本体\n・GET /api/fulltext-search (本文検索)\n・GET /api/search (ファイル名検索)\n・GET /api/file-content (ファイル取得)\n・POST /api/update-file (保存・更新)\n・GET /api/view-image (画像・SVG)",
      "fontSize": 12,
      "fontFamily": 1,
      "strokeColor": "#e2e8f0"
    },
    {
      "id": "arrow-phone-to-backend",
      "type": "arrow",
      "x": 340,
      "y": 210,
      "points": [[0, 0], [110, 0]],
      "strokeColor": "#38bdf8",
      "strokeWidth": 2
    },
    {
      "id": "text-arrow-label",
      "type": "text",
      "x": 350,
      "y": 190,
      "text": "HTTP / API",
      "fontSize": 12,
      "fontFamily": 1,
      "strokeColor": "#38bdf8"
    },
    {
      "id": "node-storage",
