diff --git a/frontend-quick/dist/index.html b/frontend-quick/dist/index.html
new file mode 100644
index 0000000000000000000000000000000000000000..c6c6f883d548216087671e219707e39260d59a57
--- /dev/null
+++ b/frontend-quick/dist/index.html
@@ -0,0 +1,24 @@
+<!--
+  quickアプリ（スマホ特化クイック検索・データアクセス・編集）
+  - モバイル最適化viewport（ピンチズーム配慮、セーフエリア対応）
+  - PWA用メタタグ
+-->
+<!doctype html>
+<html lang="ja">
+  <head>
+    <meta charset="UTF-8" />
+    <link rel="icon" type="image/svg+xml" href="/quick/vite.svg" />
+    <link rel="manifest" href="/quick/manifest.json" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
+    <meta name="theme-color" content="#1e293b" />
+    <meta name="apple-mobile-web-app-capable" content="yes" />
+    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
+    <meta name="apple-mobile-web-app-title" content="Quick" />
+    <title>Quick - スマホクイック検索・編集</title>
+    <script type="module" crossorigin src="/quick/assets/index-B7er3ja9.js"></script>
+    <link rel="stylesheet" crossorigin href="/quick/assets/index-BBjkZtIk.css">
+  </head>
+  <body>
+    <div id="root"></div>
+  </body>
+</html>
diff --git a/frontend-quick/dist/manifest.json b/frontend-quick/dist/manifest.json
new file mode 100644
index 0000000000000000000000000000000000000000..93af97f149f7be0ceb66ffa77ca8220210b17c38
--- /dev/null
+++ b/frontend-quick/dist/manifest.json
@@ -0,0 +1,17 @@
+{
+  "name": "Quick - スマホ検索・編集",
+  "short_name": "Quick",
+  "description": "端末内データのクイック検索・連絡先確認・編集アプリ",
+  "start_url": "/quick/",
+  "scope": "/quick/",
+  "display": "standalone",
+  "background_color": "#0f172a",
+  "theme_color": "#0f172a",
+  "icons": [
+    {
+      "src": "/quick/vite.svg",
+      "sizes": "192x192 512x512",
+      "type": "image/svg+xml"
+    }
+  ]
+}
diff --git a/frontend-quick/dist/vite.svg b/frontend-quick/dist/vite.svg
new file mode 100644
index 0000000000000000000000000000000000000000..e7b8dfb1b2a60bd50538bec9f876511b9cac21e3
--- /dev/null
+++ b/frontend-quick/dist/vite.svg
