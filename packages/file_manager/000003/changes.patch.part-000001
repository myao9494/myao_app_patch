+/**
+ * ファイル・フォルダに応じたCatppuccinアイコン画像を表示するコンポーネント
+ */
 import React, { memo } from "react";
 import { extensionToIcon, filenameToIcon, folderToIcon } from "../utils/iconMapping";
 
-interface FileIconProps {
+export interface FileIconProps {
     name: string;
     type: "file" | "directory";
