+/**
+ * quickアプリ エントリーポイント
+ */
+import { StrictMode } from 'react';
+import { createRoot } from 'react-dom/client';
+import App from './App';
+import './index.css';
+
+const rootElement = document.getElementById('root');
+if (rootElement) {
+  createRoot(rootElement).render(
+    <StrictMode>
+      <App />
+    </StrictMode>
+  );
+}
diff --git a/frontend-quick/src/types/index.ts b/frontend-quick/src/types/index.ts
new file mode 100644
