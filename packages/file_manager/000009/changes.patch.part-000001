+def _path_not_found_response(display_path: str, reason: str = "パスが見つかりません") -> HTMLResponse:
+    """
+    存在しないパスをブラウザで開こうとしたときのポップアップ風HTMLを返す。
+
+    URLデコード済み（日本語が読める）のパスを表示し、利用者が OK を押すまで閉じない。
+    「コピー」ボタンでパスをクリップボードへコピーできる。
+    http の非 localhost では navigator.clipboard が使えないため execCommand にフォールバックする。
+    """
+    escaped_path = html.escape(display_path)
+    escaped_reason = html.escape(reason)
+    return HTMLResponse(
+        f"""<!DOCTYPE html>
+<html lang="ja">
+<head>
+    <meta charset="utf-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1">
+    <title>パスが見つかりません</title>
+    <style>
+        body {{ background: #f0f0f0; font-family: sans-serif; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; }}
+        .dialog {{ background: #fff; border-radius: 8px; box-shadow: 0 4px 16px rgba(0,0,0,.2); padding: 24px; width: min(640px, 92vw); box-sizing: border-box; }}
+        h1 {{ font-size: 18px; margin: 0 0 12px; color: #c0392b; }}
+        textarea {{ width: 100%; box-sizing: border-box; height: 96px; padding: 8px; font-family: monospace; font-size: 14px; resize: vertical; }}
+        .buttons {{ display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px; }}
+        button {{ padding: 8px 20px; font-size: 14px; border-radius: 4px; border: 1px solid #888; background: #fff; cursor: pointer; }}
+        button.primary {{ background: #2563eb; border-color: #2563eb; color: #fff; }}
+    </style>
+</head>
+<body>
+    <div class="dialog" role="alertdialog" aria-labelledby="title">
+        <h1 id="title">{escaped_reason}</h1>
+        <textarea id="path-text" readonly>{escaped_path}</textarea>
+        <div class="buttons">
+            <button id="copy-button" type="button">コピー</button>
+            <button id="ok-button" type="button" class="primary">OK</button>
+        </div>
+    </div>
+    <script>
+        var pathText = document.getElementById('path-text');
+        var copyButton = document.getElementById('copy-button');
+        function fallbackCopy() {{
+            pathText.focus();
+            pathText.select();
+            return document.execCommand('copy');
+        }}
+        copyButton.addEventListener('click', function () {{
+            var done = function (ok) {{
+                copyButton.textContent = ok ? 'コピーしました' : 'コピーできませんでした';
+            }};
+            if (navigator.clipboard && window.isSecureContext) {{
+                navigator.clipboard.writeText(pathText.value).then(
+                    function () {{ done(true); }},
+                    function () {{ done(fallbackCopy()); }}
+                );
+            }} else {{
+                done(fallbackCopy());
+            }}
+        }});
+        document.getElementById('ok-button').addEventListener('click', function () {{
+            window.open('', '_self', '');
+            window.close();
+            // スクリプトで開かれていないタブは閉じられないため、残った場合はトップへ戻る
+            window.location.href = '/';
+        }});
+    </script>
+</body>
+</html>""",
+        status_code=404,
+    )
+
