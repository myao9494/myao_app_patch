+describe("Windows ショートカット（.lnk）", () => {
+  const SHORTCUT_TREE = {
+    ...TREE,
+    "/other/target-dir/deep.txt": "deep",
+    "/other/target-file.txt": "target file",
+    "/root/to-folder.lnk": { type: "file", size: 1, shortcutTarget: "/other/target-dir" },
+    "/root/to-file.lnk": { type: "file", size: 1, shortcutTarget: "/other/target-file.txt" },
+    "/root/broken.lnk": { type: "file", size: 1, shortcutTarget: "/other/gone" },
+    "/root/special.lnk": { type: "file", size: 1 },
+  } as const;
+  const openSmartPaths = (ui: Awaited<ReturnType<typeof ready>>) =>
+    ui.backend.callsTo("/api/open/smart").map((c) => (c.body as { path: string }).path);
+
+  it("フォルダへのショートカットをダブルクリックすると、参照先のフォルダへ移動する", async () => {
+    const ui = await ready(SHORTCUT_TREE);
+    await ui.user.dblClick(ui.row("to-folder.lnk"));
+    await waitFor(() => expect(ui.names()).toEqual(["deep.txt"]));
+    expect(ui.backend.callsTo("/api/shortcut-target")[0].query.path).toBe("/root/to-folder.lnk");
+    expect(openSmartPaths(ui)).toEqual([]);
+  });
+
+  it("参照先へ移動したあと、戻るボタンで元のフォルダに戻れる", async () => {
+    const ui = await ready(SHORTCUT_TREE);
+    await ui.user.dblClick(ui.row("to-folder.lnk"));
+    await waitFor(() => expect(ui.names()).toEqual(["deep.txt"]));
+    await ui.user.keyboard("{Control>}{ArrowLeft}{/Control}");
+    await waitFor(() => expect(ui.names()).toContain("to-folder.lnk"));
+  });
+
+  it("ファイルへのショートカットと、参照先を読めないショートカットは今までどおり開く", async () => {
+    const ui = await ready(SHORTCUT_TREE);
+    await ui.user.dblClick(ui.row("to-file.lnk"));
+    await waitFor(() => expect(openSmartPaths(ui)).toEqual(["/root/to-file.lnk"]));
+    await ui.user.dblClick(ui.row("special.lnk"));
+    await waitFor(() => expect(openSmartPaths(ui)).toEqual(["/root/to-file.lnk", "/root/special.lnk"]));
+    expect(ui.names()).toContain("to-folder.lnk");
+  });
+
+  it("参照先が存在しないショートカットはエラーを表示し、移動も起動もしない", async () => {
+    const ui = await ready(SHORTCUT_TREE);
+    await ui.user.dblClick(ui.row("broken.lnk"));
+    await waitFor(() => expect(screen.getByText(/ショートカットの参照先が見つかりません/)).toBeInTheDocument());
+    expect(openSmartPaths(ui)).toEqual([]);
+    expect(ui.names()).toContain("broken.lnk");
+  });
+});
+
