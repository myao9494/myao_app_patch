+class ShortcutTargetResponse(BaseModel):
+    """ショートカットの参照先のレスポンススキーマ"""
+
+    path: str
+    target: Optional[str] = None
+    type: str  # "directory", "file", "not_found", or "unknown"
+
+
+@router.get("/shortcut-target", response_model=ShortcutTargetResponse)
+async def get_shortcut_target(path: str = Query(..., description="ショートカット（.lnk）のパス")) -> ShortcutTargetResponse:
+    """Windows ショートカット（.lnk）の参照先を調べる（読み取りのみ）"""
+    lnk_path = normalize_path(path)
+
+    def _get_shortcut_target_sync(t_path: Path) -> ShortcutTargetResponse:
+        if t_path.suffix.lower() != ".lnk":
+            raise HTTPException(status_code=400, detail="ショートカット（.lnk）ではありません")
+        if not t_path.is_file():
+            raise HTTPException(status_code=404, detail="ショートカットが見つかりません")
+        target, target_type = resolve_shortcut(t_path)
+        return ShortcutTargetResponse(path=t_path.as_posix(), target=target, type=target_type)
+
+    return await run_with_timeout(_get_shortcut_target_sync, lnk_path)
+
+
