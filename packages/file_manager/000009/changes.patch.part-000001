+
+        target_dir = temp_dir / "a_b__c"
+        target_dir.mkdir()
+        monkeypatch.setattr(config.settings, "_base_dir_override", temp_dir)
+
+        encoded = urllib.parse.quote(str(target_dir)).replace("_", "%5F")
+        response = client.get(f"/api/fullpath?path={encoded}", follow_redirects=False)
+
+        assert response.status_code == 307
+        _assert_redirect_path(response.headers["location"], "path", target_dir)
+
