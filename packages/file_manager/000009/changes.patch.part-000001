+    @pytest.mark.parametrize("folder_name", ["a_b__c", "_x_", "100%41_done", "50%25", "a+b c"])
+    def test_fullpath_does_not_decode_path_twice(self, client, temp_dir, monkeypatch, folder_name):
+        """クエリのデコードは1回だけ。_ や % を含む実在のフォルダ名もそのまま開ける"""
