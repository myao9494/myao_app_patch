index 9b7f85608ba080ac01024ded3d655081120f734f..57305fbd5b67882a7d82bf9ee0377fd519fa9014 100644
--- a/frontend/src/api/files.ts
+++ b/frontend/src/api/files.ts
@@ -15,6 +15,7 @@ import type {
   PathInfoResponse,
   SearchParams,
   SearchResponse,
+  ShortcutTargetResponse,
 } from "../types/file";
 import { API_BASE_URL } from "../config";
 import type { EditorLanguage } from "../utils/codeEditorHighlight";
@@ -54,6 +55,23 @@ export async function getPathInfo(path: string): Promise<PathInfoResponse> {
   return response.json();
 }
 
+/**
+ * Windows ショートカット（.lnk）の参照先と種別を取得
+ */
+export async function getShortcutTarget(path: string): Promise<ShortcutTargetResponse> {
+  const url = new URL(`${API_URL}/shortcut-target`, window.location.origin);
+  url.searchParams.set("path", path);
+
+  const response = await fetch(url.toString());
+
+  if (!response.ok) {
+    const error = await response.json();
+    throw new Error(error.detail || "ショートカットの参照先を取得できませんでした");
+  }
+
+  return response.json();
+}
+
