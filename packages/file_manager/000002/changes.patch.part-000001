diff --git a/frontend/dist/assets/FileEditorModal-BK21nmwf.css b/frontend/dist/assets/FileEditorModal-BK21nmwf.css
new file mode 100644
index 0000000000000000000000000000000000000000..3b4871985162968aa29b9527301b3306991d7dad
--- /dev/null
+++ b/frontend/dist/assets/FileEditorModal-BK21nmwf.css
@@ -0,0 +1 @@
+.code-editor-shell{height:100%;display:flex;flex-direction:column;--code-editor-bg: #1e1e1e;--code-editor-bg-soft: #252526;--code-editor-panel: #181818;--code-editor-border: #333333;--code-editor-text: #d4d4d4;--code-editor-text-muted: #858585;--code-editor-accent: #3794ff;--code-editor-selection: rgba(38, 79, 120, .55);--code-editor-gutter: #1e1e1e;--code-editor-keyword: #569cd6;--code-editor-string: #ce9178;--code-editor-comment: #6a9955;--code-editor-number: #b5cea8;--code-editor-property: #9cdcfe;--code-editor-tag: #4ec9b0;--code-editor-decorator: #dcdcaa;--code-editor-function: #dcdcaa;--code-editor-class: #4ec9b0;--code-editor-builtin: #4ec9b0;--code-editor-variable: #9cdcfe}.modal-container:has(.code-editor-shell) .modal-header{padding:8px 14px;background:#181818;border-bottom:1px solid #333333}.modal-container:has(.code-editor-shell) .modal-content{padding:6px 10px;background:#1e1e1e}.fe-modal-header-row{display:flex;align-items:center;gap:12px;width:100%;min-width:0;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif}.fe-modal-title-wrap{display:flex;align-items:center;gap:6px;min-width:0;flex-shrink:0}.fe-modal-title-icon{color:#3794ff;display:flex;align-items:center}.fe-modal-title-text{font-size:13px;font-weight:700;color:#e0e0e0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:200px}.fe-header-search{display:flex;align-items:center;gap:6px;background:#121212;border:1px solid rgba(55,148,255,.4);padding:3px 8px;border-radius:4px;flex:1;max-width:360px;min-width:140px}.fe-header-search .search-icon{color:#858585;flex-shrink:0}.fe-header-search input{flex:1;min-width:60px;background:transparent;border:none;outline:none;color:#f5f5f5;font-size:12px}.fe-header-search input::placeholder{color:#666;font-size:11px}.fe-header-search .search-clear-btn,.fe-header-search .search-nav-btn{border:1px solid transparent;background:transparent;color:#858585;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;padding:2px 4px;border-radius:3px;transition:all .15s ease}.fe-header-search .search-clear-btn:hover,.fe-header-search .search-nav-btn:hover:not(:disabled){color:#3794ff;background:#3794ff26;border-color:#3794ff66}.fe-header-search .search-nav-btn:disabled{opacity:.3;cursor:not-allowed}.fe-header-search .search-count-badge{font-size:10px;font-variant-numeric:tabular-nums;color:#3794ff;background:#3794ff26;padding:1px 6px;border:1px solid rgba(55,148,255,.3);white-space:nowrap;border-radius:2px}.fe-header-search .regex-toggle{font-family:monospace;font-size:11px;font-weight:700;padding:1px 5px;border:1px solid rgba(55,148,255,.4);background:transparent;color:#858585;cursor:pointer;border-radius:2px;line-height:1}.fe-header-search .regex-toggle.active{background:#3794ff33;color:#3794ff;border-color:#3794ff}.fe-header-lang{display:inline-flex;align-items:center;font-size:11px;font-weight:600;color:#9cdcfe;background:#3794ff1f;border:1px solid rgba(55,148,255,.3);padding:2px 8px;border-radius:3px;text-transform:uppercase;letter-spacing:.05em;white-space:nowrap;flex-shrink:0}.fe-header-status{display:flex;align-items:center;gap:8px;font-size:11px;white-space:nowrap;flex-shrink:0}.fe-header-lines{color:#858585}.fe-header-save-state.saved{color:#4ec9b0}.fe-header-save-state.unsaved{color:#ffa726;font-weight:600}.fe-header-actions{display:flex;align-items:center;gap:8px;margin-left:auto;flex-shrink:0}.fe-btn-secondary,.fe-btn-primary{padding:4px 12px;font-size:12px;font-weight:600;border-radius:4px;cursor:pointer;transition:all .15s ease}.fe-btn-secondary{border:1px solid rgba(255,255,255,.15);background:transparent;color:#b0b0b0}.fe-btn-secondary:hover:not(:disabled){background:#ffffff1a;color:#fff}.fe-btn-primary{border:1px solid #3794ff;background:#3794ff;color:#fff;font-weight:700;box-shadow:0 0 8px #3794ff59}.fe-btn-primary:hover:not(:disabled){background:#4da3ff;box-shadow:0 0 12px #3794ff8c}.fe-btn-primary:disabled{opacity:.6;cursor:not-allowed}.code-editor-workspa