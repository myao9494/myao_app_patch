 });
 
+
+describe("renderMarkdownToHtml: ハング防止", () => {
+  it("```の後ろに日本語が続いてもハングせずコードブロックになる", () => {
+    const html = renderMarkdownToHtml("```例文\n改行\nfujiii<>fuji@ddd.co.jp>\n```");
+    expect(html).toContain("<pre");
+    expect(html).toContain("fujiii&lt;&gt;fuji@ddd.co.jp&gt;");
+  });
+
+  it("閉じていない```でもハングしない", () => {
+    expect(renderMarkdownToHtml("```例文\nabc")).toContain("abc");
+  });
+
+  it("どんな行頭の記号でも必ず処理が進む", () => {
+    expect(renderMarkdownToHtml("a\n```\n```x\n#\n-\n>")).toBeTypeOf("string");
+  });
+});
