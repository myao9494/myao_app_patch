diff --git a/frontend/src/api/indexService.test.ts b/frontend/src/api/indexService.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9fc747fe1191132d6f28b31693160bea1951451b
--- /dev/null
+++ b/frontend/src/api/indexService.test.ts
@@ -0,0 +1,57 @@
+/**
+ * インデックスサービス検索のフルパス絞り込みのテスト
+ *
+ * 仕様:
+ * - 空白区切りの複数キーワードは、フルパス（フォルダ名を含む）に全て含まれる項目だけを返す
+ * - 大文字小文字は区別しない
+ * - 外部サービスには語ごとに問い合わせ、結果を統合して重複を除く
+ */
+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { filterByAllTokens, searchIndexService, splitQueryTokens } from "./indexService";
+
+describe("splitQueryTokens", () => {
+  it("半角・全角空白で分割し空要素を除く", () => {
+    expect(splitQueryTokens("  人事　top  ")).toEqual(["人事", "top"]);
+  });
+});
+
+describe("filterByAllTokens", () => {
+  const items = [
+    { name: "top.excalidraw", path: "/work/人事/top.excalidraw" },
+    { name: "top.excalidraw", path: "/work/経理/top.excalidraw" },
+  ];
+
+  it("全ての語をフルパスに含むものだけ残す", () => {
+    expect(filterByAllTokens(items, ["人事", "TOP"])).toEqual([items[0]]);
+  });
+});
+
+describe("searchIndexService（複数語）", () => {
+  beforeEach(() => {
+    vi.stubGlobal("window", { location: { origin: "http://localhost" } });
+    vi.stubGlobal("localStorage", { getItem: () => null });
+  });
+
+  afterEach(() => {
+    vi.unstubAllGlobals();
+  });
+
+  it("語ごとに検索して統合し、フルパスで絞り込む", async () => {
+    const top = [
+      { name: "top.excalidraw", path: "/work/人事/top.excalidraw", type: "file", size: 1, date_modified: 0 },
+      { name: "top.excalidraw", path: "/work/経理/top.excalidraw", type: "file", size: 1, date_modified: 0 },
+    ];
+    const fetchMock = vi.fn(async (input: string) => {
+      const search = new URL(input).searchParams.get("search");
+      const results = search === "top" ? top : [];
+      return { ok: true, json: async () => ({ totalResults: results.length, results }) };
+    });
+    vi.stubGlobal("fetch", fetchMock);
+
+    const res = await searchIndexService({ query: "人事 top" });
+
+    expect(res.results.map((r) => r.path)).toEqual(["/work/人事/top.excalidraw"]);
+    expect(res.totalResults).toBe(1);
+  });
+});
diff --git a/frontend/src/api/indexService.ts b/frontend/src/api/indexService.ts
index b72dbefe8327a3904942484b5674de363e8a3534..327509a690e417965130d614b34ed388eb4131c8 100644
--- a/frontend/src/api/indexService.ts
+++ b/frontend/src/api/indexService.ts
@@ -101,7 +101,48 @@ export interface IndexSearchResponse {
   results: IndexSearchResult[];
 }
 
+/** 検索語を空白（半角・全角）で分割する */
+export function splitQueryTokens(query: string): string[] {
+  return query.split(/\s+/).filter(Boolean);
+}
+
+/** フルパスに全ての語を含む項目だけを残す（大文字小文字は区別しない） */
+export function filterByAllTokens<T extends { path: string }>(items: T[], tokens: string[]): T[] {
+  const lowered = tokens.map((t) => t.toLowerCase());
+  return items.filter((item) => {
+    const path = item.path.toLowerCase();
+    return lowered.every((t) => path.includes(t));
+  });
+}
+
+/**
+ * インデックスサービスで検索する。
+ * 複数語の場合は語ごとに問い合わせて統合し、フルパス（フォルダ名を含む）に
+ * 全語を含むものだけを返す（例:「人事 top」→ 人事/top.excalidraw）。
+ */
 export async function searchIndexService(params: IndexSearchParams): Promise<IndexSearchResponse> {
+  const tokens = splitQueryTokens(params.query);
+  if (tokens.length <= 1) {
+    return searchIndexServiceOnce(params);
+  }
+
+  const responses = await Promise.all(
+    tokens.map((token) => searchIndexServiceOnce({ ...params, query: token }))
+  );
+  const seen = new Set<string>();
+  const merged: IndexSearchResult[] = [];
+  for (const response of responses) {
+    for (const item of response.results) {
+      if (seen.has(item.path)) continue;
+      seen.add(item.path);
+      merged.push(item);
+    }
+  }
+  const results = filterByAllTokens(merged, tokens);
+  return { totalResults: results.length, results };
+}
+
+async function searchIndexServiceOnce(params: IndexSearchParams): Promise<IndexSearchResponse> {
   const baseUrl = getIndexServiceUrl();
   const url = new URL(baseUrl, window.location.origin);
 
