diff --git a/frontend/src/utils/errorLog.test.ts b/frontend/src/utils/errorLog.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6b543fc1397278ff2f720901743e3a7be8cc062c
--- /dev/null
+++ b/frontend/src/utils/errorLog.test.ts
@@ -0,0 +1,31 @@
+/**
+ * errorLog のテスト: エラーがコンソールに出ること
+ */
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { installGlobalErrorLogging, logError } from "./errorLog";
+
+describe("errorLog", () => {
+  afterEach(() => vi.restoreAllMocks());
+
+  it("logError は文脈つきで console.error に出す", () => {
+    const spy = vi.spyOn(console, "error").mockImplementation(() => {});
+    const err = new Error("boom");
+    logError("テスト", err);
+    expect(spy).toHaveBeenCalledWith("[file_manager] テスト", err);
+  });
+
+  it("未処理エラーと Promise 拒否を console.error に出し、解除できる", () => {
+    const spy = vi.spyOn(console, "error").mockImplementation(() => {});
+    const handlers: Record<string, (e: unknown) => void> = {};
+    const fakeWindow = {
+      addEventListener: (type: string, h: (e: unknown) => void) => { handlers[type] = h; },
+      removeEventListener: vi.fn(),
+    } as unknown as Window;
+    const uninstall = installGlobalErrorLogging(fakeWindow);
+    handlers.error({ error: new Error("e1"), message: "e1" });
+    handlers.unhandledrejection({ reason: "r1" });
+    expect(spy).toHaveBeenCalledTimes(2);
+    uninstall();
+    expect(fakeWindow.removeEventListener).toHaveBeenCalledTimes(2);
+  });
+});
diff --git a/frontend/src/utils/errorLog.ts b/frontend/src/utils/errorLog.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d3f8319c469c48ef45c2ca274f98f449f97511f4
--- /dev/null
+++ b/frontend/src/utils/errorLog.ts
@@ -0,0 +1,26 @@
+/**
+ * エラーのコンソール出力
+ * - logError: 握りつぶさず原因（文脈・メッセージ・スタック）をコンソールに残す
+ * - installGlobalErrorLogging: 捕捉されなかった例外・Promise拒否をコンソールに残す
+ */
+
+/** 文脈つきでエラーをコンソールに出力する */
+export function logError(context: string, err: unknown): void {
+  console.error(`[file_manager] ${context}`, err);
+}
+
+/** window 全体の未処理エラーをコンソールに出力する（解除関数を返す） */
+export function installGlobalErrorLogging(target: Window = window): () => void {
+  const onError = (event: ErrorEvent) => {
+    logError("未処理のエラー", event.error ?? event.message);
+  };
+  const onRejection = (event: PromiseRejectionEvent) => {
+    logError("未処理のPromise拒否", event.reason);
+  };
+  target.addEventListener("error", onError);
+  target.addEventListener("unhandledrejection", onRejection);
+  return () => {
+    target.removeEventListener("error", onError);
+    target.removeEventListener("unhandledrejection", onRejection);
+  };
+}
