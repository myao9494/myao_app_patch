# File Manager Backend 環境設定
# このファイルを .env にコピーして、各環境に合わせて編集してください

# ベースディレクトリ（デフォルトのファイル一覧表示パス）
# macOS/Linux の例:
# FILE_MANAGER_BASE_DIR=/Users/username/Documents
# Windows の例:
# FILE_MANAGER_BASE_DIR=C:\Users\username\Documents
# Windowsネットワークフォルダの例:
# FILE_MANAGER_BASE_DIR=\\server\share\folder
FILE_MANAGER_BASE_DIR=

# 初期表示ディレクトリ（省略時はベースディレクトリ）
# FILE_MANAGER_START_DIR=/Users/username/Documents

# ファイルI/O専用ワーカー数（既定16、実行時は4〜64に制限）
# FILE_MANAGER_FILE_IO_WORKERS=16

# サーバー設定（デフォルト値があるため省略可能）
# FILE_MANAGER_HOST=0.0.0.0
# FILE_MANAGER_PORT=8001

# Obsidian の日付フォルダ作成先（省略時は macOS: /Users/mine/000_work/obsidian-dagnetz/01_data）
# FILE_MANAGER_OBSIDIAN_BASE_DIR=/Users/username/obsidian/01_data

# UI設定ファイル（省略時は backend/settings.json。git管理外）
# FILE_MANAGER_PREFERENCES_FILE=/path/to/settings.json

# 全文検索サービス（Local-fulltext-search）のURL
# FILE_MANAGER_FULLTEXT_SERVICE_URL=http://127.0.0.1:8079

# ---- セキュリティ ----
# 別のWebサイトから本アプリを操作されないよう、ブラウザからの書き込み操作とターミナル接続は
# 「同一オリジン」「localhost」「下記で許可したオリジン」からのみ受け付けます。
# 別ホストの画面から本サーバーを呼ぶ場合（例: LAN IP で開いたQuickアプリからTailscale名のサーバーへ）に追加します。
# FILE_MANAGER_ALLOWED_ORIGINS=http://192.168.1.20:8001,http://mypc.tailxxxx.ts.net:8001

# DNSリバインディング対策として、localhost・IPアドレス・*.ts.net・このPCのホスト名以外の
# ホスト名でのアクセスを拒否します。社内DNS名などでアクセスする場合に追加します（"*" で無効化）。
# FILE_MANAGER_ALLOWED_HOSTS=fileserver.corp.example
