+class TestHashedAssetPattern:
+    """Vite のハッシュ（base64url: 英数字と - _）を含むファイル名を長期キャッシュ対象と判定する"""
+
+    @pytest.mark.parametrize(
+        "name",
+        ["index-DX9GQbFA.js", "ServerTerminal-CdAn_Ut-.js", "react-vendor-ZJfGuIjO.js", "index-C6jwI_qG.css"],
+    )
+    def test_vite_hashed_names_are_immutable(self, name):
+        from pathlib import Path
+
+        from app.main import build_static_cache_headers
+
+        assert build_static_cache_headers(Path(name))["Cache-Control"] == "public, max-age=31536000, immutable"
+
+    @pytest.mark.parametrize("name", ["vite.svg", "favicon.svg", "app.js", "obsidian-icon.png"])
+    def test_unhashed_names_are_short_cached(self, name):
+        from pathlib import Path
+
+        from app.main import build_static_cache_headers
+
+        assert build_static_cache_headers(Path(name))["Cache-Control"] == "public, max-age=3600"
