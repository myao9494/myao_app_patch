diff --git a/frontend/src/components/fileList/FileListCreateModals.tsx b/frontend/src/components/fileList/FileListCreateModals.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..53c7e280aa4cc10a013006a914a22c655c5bb3a0
--- /dev/null
+++ b/frontend/src/components/fileList/FileListCreateModals.tsx
@@ -0,0 +1,43 @@
+/**
+ * 新規作成ダイアログ（フォルダ・テキストファイル・Markdown）。状態と処理は useFileCreation が持つ
+ */
+import { InputModal } from "../InputModal";
+import { TextFileCreateModal } from "../TextFileCreateModal";
+import type { FileCreation } from "./useFileCreation";
+
+interface Props {
+  creation: FileCreation;
+  defaultTextFileExtension: string;
+}
+
+export function FileListCreateModals({ creation, defaultTextFileExtension }: Props) {
+  const { folderModal, textFileModal, markdownModal } = creation;
+  return (
+    <>
+      <InputModal
+        isOpen={folderModal.isOpen}
+        onClose={folderModal.onClose}
+        title="フォルダ作成"
+        message="新しいフォルダの名前を入力してください"
+        placeholder="フォルダ名"
+        onConfirm={folderModal.onConfirm}
+        confirmLabel="作成"
+      />
+      <TextFileCreateModal
+        isOpen={textFileModal.isOpen}
+        onClose={textFileModal.onClose}
+        defaultExtension={defaultTextFileExtension}
+        onConfirm={textFileModal.onConfirm}
+      />
+      <InputModal
+        isOpen={markdownModal.isOpen}
+        onClose={markdownModal.onClose}
+        title="Markdownファイル作成"
+        message="Markdownファイル名を入力してください（.md拡張子は自動付与）"
+        placeholder="ファイル名"
+        onConfirm={markdownModal.onConfirm}
+        confirmLabel="エディタを開く"
+      />
+    </>
+  );
+}
diff --git a/frontend/src/components/fileList/FileListEditorModals.tsx b/frontend/src/components/fileList/FileListEditorModals.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..45caf0822ac64504c6cd8d0b4096ad347c105d40
--- /dev/null
+++ b/frontend/src/components/fileList/FileListEditorModals.tsx
@@ -0,0 +1,54 @@
+/**
+ * ファイル一覧の内蔵エディタモーダル（開いたときだけ読み込む）
+ * 状態と保存処理は useFileListEditors が持つ
+ */
+import { lazy, Suspense } from "react";
+import type { FileListEditorsState } from "./useFileListEditors";
+
+const MarkdownEditorModal = lazy(() =>
+  import("../MarkdownEditorModal").then((module) => ({ default: module.MarkdownEditorModal }))
+);
+const FileEditorModal = lazy(() =>
+  import("../FileEditorModal").then((module) => ({ default: module.FileEditorModal }))
+);
+
+interface FileListEditorModalsProps {
+  editors: FileListEditorsState;
+  currentDirectory: string | null;
+}
+
+export function FileListEditorModals({ editors, currentDirectory }: FileListEditorModalsProps) {
+  const { markdown, file } = editors;
+  return (
+    <>
+      {markdown.isOpen && (
+        <Suspense fallback={null}>
+          <MarkdownEditorModal
+            isOpen={markdown.isOpen}
+            onClose={markdown.onClose}
+            onSave={markdown.onSave}
+            fileName={markdown.fileName}
+            filePath={markdown.filePath}
+            currentDirectory={currentDirectory}
+            isSaving={markdown.isSaving}
+            initialContent={markdown.initialContent}
+          />
+        </Suspense>
+      )}
+      {file.isOpen && (
+        <Suspense fallback={null}>
+          <FileEditorModal
+            isOpen={file.isOpen}
+            onClose={file.onClose}
+            onSave={file.onSave}
+            fileName={file.fileName}
+            filePath={file.filePath}
+            isSaving={file.isSaving}
+            initialContent={file.initialContent}
+            initialLanguage={file.language}
+          />
+        </Suspense>
+      )}
+    </>
+  );
+}
diff --git a/frontend/src/components/fileList/FileListHelpModal.tsx b/frontend/src/components/fileList/FileListHelpModal.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..bb2b794dd75c45c25513e1516a31c0db2730a554
--- /dev/null
+++ b/frontend/src/components/fileList/FileListHelpModal.tsx
@@ -0,0 +1,63 @@
+/**
+ * ファイル一覧の「使い方」モーダル（H キーで表示）
+ * - ショートカットキーと主な操作の説明を表示する
+ */
+import { Modal } from "../Modal";
+
+interface FileListHelpModalProps {
+  isOpen: boolean;
+  onClose: () => void;
+}
+
+export function FileListHelpModal({ isOpen, onClose }: FileListHelpModalProps) {
+  return (
+<Modal
+      isOpen={isOpen}
+      onClose={onClose}
+      title="使い方"
+      width="min(760px, 94vw)"
+    >
+      <div className="help-modal-content">
+        <section className="help-section">
+          <h3>ショートカットキー</h3>
+          <dl className="help-list">
+            <div><dt>H</dt><dd>この使い方を表示</dd></div>
+            <div><dt>A</dt><dd>左・真ん中ペインでフォルダ作成</dd></div>
+            <div><dt>T</dt><dd>左・真ん中ペインで空のテキストファイル作成。ファイル名と拡張子を個別に指定</dd></div>
+            <div><dt>O</dt><dd>左・真ん中ペインで現在のフォルダをFinder／Explorerで開く</dd></div>
+            <div><dt>R</dt><dd>左・真ん中ペインのファイル一覧を再読み込み（更新）</dd></div>
+            <div><dt>N</dt><dd>左・真ん中ペインのアクティブカーソル行をリネーム。ファイル名と拡張子を個別に指定</dd></div>
+            <div><dt>L</dt><dd>左・真ん中ペインの表示フィルタを次へ切り替え</dd></div>
+            <div><dt>Shift + L</dt><dd>左・真ん中ペインの表示フィルタを前へ切り替え</dd></div>
+            <div><dt>D</dt><dd>左・真ん中ペインで、選択中またはカーソル位置のフォルダ配下を集計し、Date列に最新更新日を表示</dd></div>
+            <div><dt>G</dt><dd>左・真ん中ペイン内の全フォルダを並列にGit確認。Git列は作業ツリー変更ならG、未PushならPush、未PullならPull、両方ならC、Git管理外または差分なしなら-を表示。GのクリックはVS Codeを開き、Push・Pull・Cのクリックはcd付きGitコマンドをクリップボードへコピー</dd></div>
+            <div><dt>Ctrl/Cmd + P</dt><dd>左・真ん中ペインのフォルダ内 indexed 検索を表示</dd></div>
+            <div><dt>Ctrl/Cmd + R</dt><dd>左・真ん中ペインのフォルダ履歴検索を表示</dd></div>
+            <div><dt>Ctrl/Cmd + H</dt><dd>ホームフォルダへ移動</dd></div>
+            <div><dt>Ctrl/Cmd + ← / ↓ / →</dt><dd>戻る / 戻る / 進む</dd></div>
+            <div><dt>Ctrl/Cmd + ↑</dt><dd>上の階層へ移動</dd></div>
+            <div><dt>Ctrl/Cmd + A</dt><dd>表示中のアイテムを全選択</dd></div>
+            <div><dt>Ctrl/Cmd + Shift + A</dt><dd>選択解除</dd></div>
+          </dl>
+        </section>
+
+        <section className="help-section">
+          <h3>設定</h3>
+          <dl className="help-list">
+            <div><dt>Theme</dt><dd>Light / Dark の表示テーマを切り替え</dd></div>
+            <div><dt>Text File Open</dt><dd>テキスト系ファイルをWebエディタで開くか外部アプリで開くかを選択</dd></div>
+            <div><dt>Markdown Open</dt><dd>Markdownをアプリ内エディタで開くかObsidian連携を優先するかを選択</dd></div>
+            <div><dt>Verify Checksum</dt><dd>移動・コピー時にチェックサム検証を行う安全寄りの設定</dd></div>
+            <div><dt>Debug Mode</dt><dd>ファイル操作時の詳細ログやデバッグ情報を有効化</dd></div>
+            <div><dt>API Timeout</dt><dd>ネットワークドライブなどのAPI待ち時間上限を秒数で設定</dd></div>
+            <div><dt>Folder Date Max Items</dt><dd>Dで最新更新日を集計する際の最大項目数を設定</dd></div>
+            <div><dt>Default Text Extension</dt><dd>Tでテキストファイルを作成する際の既定拡張子を設定</dd></div>
+            <div><dt>リンク置換設定</dt><dd>古いサーバー名やUNCパスを新しいリンクへ置換するルールを編集</dd></div>
+            <div><dt>Reset Storage</dt><dd>保存されたパス、履歴、テーマなどのローカル設定を初期化</dd></div>
+            <div><dt>検索ペイン設定</dt><dd>インデックスサービスURLや監視パスを検索ペインの設定から管理</dd></div>
+          </dl>
+        </section>
+      </div>
+    </Modal>
+  );
+}
diff --git a/frontend/src/components/fileList/FileListHistorySearch.tsx b/frontend/src/components/fileList/FileListHistorySearch.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..6d51b03249729d7aa283c9276d3a9e140364c5ec
--- /dev/null
+++ b/frontend/src/components/fileList/FileListHistorySearch.tsx
@@ -0,0 +1,147 @@
+/**
+ * フォルダ履歴の検索欄（入力するとドロップダウンに候補を最大10件表示）
+ * - 候補は移動回数の多い順、同じ回数なら新しい順。全角・半角スペース区切りで AND 検索
+ * - ドロップダウンが出ていないときの ↑/↓ はフィルタバー/検索バーへ移動、Enter でドロップダウンを開く
+ * - ドロップダウン表示中は ↑↓ で候補を選び、Enter で移動、Escape で閉じる
+ * - 入力欄からフォーカスが外れたら閉じる（候補のクリックを処理し終えてから）
+ */
+import { useEffect, useMemo, useRef, useState, type KeyboardEvent, type RefObject } from "react";
+import { History } from "lucide-react";
+import { useFolderHistory } from "../../contexts/FolderHistoryContext";
+
+const MAX_VISIBLE_ITEMS = 10;
+
+interface FileListHistorySearchProps {
+  inputRef: RefObject<HTMLInputElement | null>;
+  /** 候補を選んだとき（viaKeyboard: Enter で選んだ場合は一覧へフォーカスを戻す） */
+  onSelectPath: (path: string, viaKeyboard: boolean) => void;
+  onFocusFilterBar: () => void;
+  onFocusSearchBar: () => void;
+}
+
+export function FileListHistorySearch({
+  inputRef,
+  onSelectPath,
+  onFocusFilterBar,
+  onFocusSearchBar,
+}: FileListHistorySearchProps) {
+  const { history, searchHistory } = useFolderHistory();
+  const [query, setQuery] = useState("");
+  const [isOpen, setIsOpen] = useState(false);
+  const [selectedIndex, setSelectedIndex] = useState(0);
+  const dropdownRef = useRef<HTMLDivElement>(null);
+
+  const items = useMemo(() => {
+    const matched = query ? searchHistory(query) : history;
+    return [...matched].sort((a, b) => b.count - a.count || b.timestamp - a.timestamp);
+  }, [history, query, searchHistory]);
+
+  // 開いたら（候補のクリック後なども）入力欄にフォーカスを置く
+  useEffect(() => {
+    if (!isOpen) return;
+    requestAnimationFrame(() => inputRef.current?.focus());
+  }, [isOpen, inputRef]);
+
+  const open = () => {
+    setSelectedIndex(0);
+    setIsOpen(true);
+  };
+
+  const select = (path: string, viaKeyboard: boolean) => {
+    setIsOpen(false);
+    onSelectPath(path, viaKeyboard);
+  };
+
+  const moveSelection = (index: number) => {
+    setSelectedIndex(index);
+    requestAnimationFrame(() => {
+      dropdownRef.current
+        ?.querySelector(`.history-item[data-index="${index}"]`)
+        ?.scrollIntoView({ block: "nearest", behavior: "smooth" });
+    });
+  };
+
+  const handleKeyDown = (e: KeyboardEvent<HTMLInputElement>) => {
+    const isDropdownActive = isOpen && items.length > 0;
+    if (e.key === "ArrowUp" && !isDropdownActive) {
+      e.preventDefault();
+      onFocusFilterBar();
+      return;
+    }
+    if (e.key === "ArrowDown" && !isDropdownActive) {
+      e.preventDefault();
+      onFocusSearchBar();
+      return;
+    }
+    if (e.key === "Enter" && !isOpen) {
+      e.preventDefault();
+      open();
+      return;
+    }
+
+    if (e.key === "ArrowDown" || e.key === "ArrowUp" || e.key === "Enter" || e.key === "Escape") {
+      e.preventDefault();
+      e.stopPropagation();
+    }
+    if (e.key === "ArrowDown") {
+      moveSelection(Math.min(selectedIndex + 1, items.length - 1));
+    } else if (e.key === "ArrowUp") {
+      moveSelection(Math.max(selectedIndex - 1, 0));
+    } else if (e.key === "Enter") {
+      const item = items[selectedIndex];
+      if (item) select(item.path, true);
+    } else if (e.key === "Escape") {
+      setIsOpen(false);
+    }
+  };
+
+  return (
+    <div className="history-search-bar">
+      <History size={14} className="history-icon" />
+      <input
+        ref={inputRef}
+        type="text"
+        placeholder="履歴を検索..."
+        value={query}
+        onChange={(e) => {
+          setQuery(e.target.value);
+          setSelectedIndex(0);
+          setIsOpen(true);
+        }}
+        onBlur={() => {
+          // 候補のクリックを処理し終えてから閉じる
+          setTimeout(() => setIsOpen(false), 200);
+        }}
+        onKeyDown={handleKeyDown}
+        onClick={(e) => e.stopPropagation()}
+      />
+      {isOpen && (
+        <div className="history-dropdown" ref={dropdownRef}>
+          {items.length > 0 ? (
+            items.slice(0, MAX_VISIBLE_ITEMS).map((item, index) => (
+              <div
+                key={item.path}
+                data-index={index}
+                className={`history-item ${index === selectedIndex ? "selected" : ""}`}
+                onClick={() => select(item.path, false)}
+                onMouseEnter={() => setSelectedIndex(index)}
+                style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}
+              >
+                <span style={{ overflow: "hidden", whiteSpace: "normal", wordBreak: "break-all", overflowWrap: "anywhere" }}>
+                  {item.path || "/"}
+                </span>
+                {item.count > 1 && (
+                  <span style={{ fontSize: "0.8em", color: "#888", marginLeft: "8px", flexShrink: 0 }}>
+                    {item.count}回
+                  </span>
+                )}
+              </div>
+            ))
+          ) : (
+            <div className="history-empty">履歴がありません</div>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/frontend/src/components/fileList/FileListOperationModals.tsx b/frontend/src/components/fileList/FileListOperationModals.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..52905e5890f1d5fb1b208c5e20ed0b2c56448037
--- /dev/null
+++ b/frontend/src/components/fileList/FileListOperationModals.tsx
@@ -0,0 +1,46 @@
+/**
+ * ファイル一覧の削除確認モーダルと進捗モーダル
+ * - 状態と処理は useBatchFileOperations が持ち、ここでは表示だけを行う
+ * - 削除確認には「ネットワークドライブ上の項目はゴミ箱に入らず完全に削除される」旨を必ず表示する
+ */
+import { ConfirmationModal } from "../ConfirmationModal";
+import { ProgressModal } from "../ProgressModal";
+import type { BatchFileOperations } from "./useBatchFileOperations";
+
+interface Props {
+  operations: BatchFileOperations;
+}
+
+export function FileListProgressModal({ operations }: Props) {
+  const { progress } = operations;
+  return (
+    <ProgressModal
+      isOpen={progress.isOpen}
+      taskId={progress.taskId}
+      operationType={progress.operationType}
+      onClose={progress.onClose}
+      onComplete={progress.onComplete}
+    />
+  );
+}
+
+export function FileListDeleteConfirmModal({ operations }: Props) {
+  const { deleteConfirm } = operations;
+  const { items } = deleteConfirm;
+  return (
+    <ConfirmationModal
+      isOpen={deleteConfirm.isOpen}
+      title="削除の確認"
+      message={
+        (items.size > 1
+          ? `${items.size}件のアイテムを削除しますか？`
+          : `「${Array.from(items)[0]?.split('/').pop()}」を削除しますか？`) +
+        "\nゴミ箱に移動します（ネットワークドライブ上の項目はゴミ箱に入らず完全に削除されます）。"
+      }
+      onConfirm={deleteConfirm.onConfirm}
+      confirmLabel="削除"
+      confirmButtonClass="btn-danger"
+      onClose={deleteConfirm.onClose}
+    />
+  );
+}
diff --git a/frontend/src/components/fileList/FileListPathBar.tsx b/frontend/src/components/fileList/FileListPathBar.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..5e321b5cbea7f1b4b66be6406d777dd316f38698
--- /dev/null
+++ b/frontend/src/components/fileList/FileListPathBar.tsx
@@ -0,0 +1,70 @@
+/**
+ * ファイル一覧のパス入力欄
+ * - フルパス・リンクのコピーボタン
+ * - パス入力（Enter で移動、Shift+Enter で改行。矢印キーはテキスト内の移動を優先し、
+ *   Ctrl/Cmd+↓ でフィルタバー、Ctrl/Cmd+↑ でツールバー、先頭での Ctrl/Cmd+← でコピーボタンへ移る）
+ */
+import type { FormEvent, RefObject } from "react";
+import { Copy, Link } from "lucide-react";
+
+interface FileListPathBarProps {
+  inputRef: RefObject<HTMLTextAreaElement | null>;
+  value: string;
+  onChange: (value: string) => void;
+  onSubmit: (e: FormEvent) => void;
+  onCopyPath: () => void;
+  onCopyLink: () => void;
+  onFocusFilterBar: () => void;
+  onFocusToolbar: () => void;
+  onFocusPathButtons: () => void;
+}
+
+export function FileListPathBar({
+  inputRef,
+  value,
+  onChange,
+  onSubmit,
+  onCopyPath,
+  onCopyLink,
+  onFocusFilterBar,
+  onFocusToolbar,
+  onFocusPathButtons,
+}: FileListPathBarProps) {
+  return (
+    <div className="path-input-container">
+      <button onClick={onCopyPath} title="フルパスをコピー" className="path-button">
+        <Copy size={14} />
+      </button>
+      <button onClick={onCopyLink} title="リンクをコピー" className="path-button">
+        <Link size={14} />
+      </button>
+      <form onSubmit={onSubmit} className="path-form">
+        <textarea
+          ref={inputRef}
+          value={value}
+          onChange={(e) => onChange(e.target.value)}
+          placeholder="フルパスを入力"
+          className="path-input"
+          rows={1}
+          style={{ height: 'auto' }}
+          onKeyDown={(e) => {
+            const withModifier = e.ctrlKey || e.metaKey;
+            if (e.key === 'Enter' && !e.shiftKey) {
+              e.preventDefault();
+              onSubmit(e);
+            } else if (e.key === 'ArrowDown' && withModifier) {
+              e.preventDefault();
+              onFocusFilterBar();
+            } else if (e.key === 'ArrowUp' && withModifier) {
+              e.preventDefault();
+              onFocusToolbar();
+            } else if (e.key === 'ArrowLeft' && withModifier && e.currentTarget.selectionStart === 0) {
+              e.preventDefault();
+              onFocusPathButtons();
+            }
+          }}
+        />
+      </form>
+    </div>
+  );
+}
diff --git a/frontend/src/components/fileList/FileListSearchBar.tsx b/frontend/src/components/fileList/FileListSearchBar.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..20c658ab8430f3a278547fe008673d3d53eeef15
--- /dev/null
+++ b/frontend/src/components/fileList/FileListSearchBar.tsx
@@ -0,0 +1,87 @@
+/**
+ * ペイン内のファイル名検索バー（Ctrl/Cmd+F または / でフォーカス）
+ * - Enter で次のヒット、Shift+Enter で前のヒットへ（親の onEnter が処理）
+ * - Escape で検索語を消して一覧へ戻る、↓ で一覧へ、↑ で履歴検索欄へ
+ * - 件数バッジ（検索中は「現在位置 / ヒット数」、未検索時は「表示件数 / 全件数」）と正規表現トグル
+ */
+import type { RefObject } from "react";
+import { Search, X } from "lucide-react";
+
+interface FileListSearchBarProps {
+  inputRef: RefObject<HTMLInputElement | null>;
+  query: string;
+  onQueryChange: (query: string) => void;
+  isRegex: boolean;
+  onToggleRegex: () => void;
+  badgeText: string;
+  onEscape: () => void;
+  onFocusList: () => void;
+  onFocusHistorySearch: () => void;
+  onEnter: (backwards: boolean) => void;
+}
+
+export function FileListSearchBar({
+  inputRef,
+  query,
+  onQueryChange,
+  isRegex,
+  onToggleRegex,
+  badgeText,
+  onEscape,
+  onFocusList,
+  onFocusHistorySearch,
+  onEnter,
+}: FileListSearchBarProps) {
+  return (
+    <div className="search-bar">
+      <Search size={14} className="search-icon" />
+      <input
+        ref={inputRef}
+        type="text"
+        placeholder={isRegex ? "正規表現で検索... (Ctrl+F / /)" : "検索... (Ctrl+F / /)"}
+        value={query}
+        onChange={(e) => onQueryChange(e.target.value)}
+        onKeyDown={(e) => {
+          if (e.key === 'Escape') {
+            e.preventDefault();
+            onEscape();
+          } else if (e.key === 'ArrowDown') {
+            e.preventDefault();
+            onFocusList();
+          } else if (e.key === 'ArrowUp') {
+            e.preventDefault();
+            onFocusHistorySearch();
+          } else if (e.key === 'Enter') {
+            e.preventDefault();
+            onEnter(e.shiftKey);
+          }
+        }}
+      />
+      {query && (
+        <button
+          className="search-clear-btn"
+          onClick={() => {
+            onQueryChange("");
+            inputRef.current?.focus();
+          }}
+          title="検索をクリア (Esc)"
+        >
+          <X size={12} />
+        </button>
+      )}
+      <span
+        className="search-count-badge"
+        title={query.trim() ? "現在ヒット位置 / 総ヒット件数 (Enter: 次へ / Shift+Enter: 前へ)" : "マッチ件数 / 全件数"}
+      >
+        {badgeText}
+      </span>
+      <button
+        className={`regex-toggle ${isRegex ? "active" : ""}`}
+        onClick={onToggleRegex}
+        title="正規表現 (Regex)"
+      >
+        .*
+      </button>
+    </div>
+  );
+}
diff --git a/frontend/src/components/fileList/FileListSelectionBox.tsx b/frontend/src/components/fileList/FileListSelectionBox.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..4fc275cf34e224d7e159f0b88c713b8bfa92b094
