index ad7e780e6e995c4ebdf1726b2064e103c28cc0dd..d1b139eb20f79d686cdcc5f99c17cb3e4ac75a38 100644
--- a/frontend/dist/sw.js
+++ b/frontend/dist/sw.js
@@ -19,7 +19,8 @@ function isNavigationRequest(request) {
 }
 
 function isHashedAsset(pathname) {
-    return /\/assets\/.+-[0-9A-Za-z]{6,}\.(js|css|mjs)$/.test(pathname);
+    // Vite のファイル名ハッシュは base64url（英数字と - _）
+    return /\/assets\/.+-[0-9A-Za-z_-]{6,}\.(js|css|mjs)$/.test(pathname);
 }
 
 // インストール時: 静的アセットをキャッシュ
diff --git a/frontend/eslint.config.js b/frontend/eslint.config.js
index 5e6b472f583e34a1cca751440d4f241495475723..735dbf7d01ff91dbdf458bbd9f619a2b6fb9af88 100644
--- a/frontend/eslint.config.js
+++ b/frontend/eslint.config.js
@@ -20,4 +20,12 @@ export default defineConfig([
       globals: globals.browser,
     },
   },
+  {
+    // Context ファイルは Provider と useXxx フックを同じファイルで公開する構成のため、
+    // Fast Refresh 用の「コンポーネント以外を export しない」ルールを適用しない
+    files: ['src/contexts/**/*.tsx'],
+    rules: {
+      'react-refresh/only-export-components': 'off',
+    },
+  },
 ])
