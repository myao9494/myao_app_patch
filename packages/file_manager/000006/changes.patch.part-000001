@@ -0,0 +1,9 @@
+/**
+ * 範囲選択（ラバーバンド選択）中の矩形。状態は useDragSelect が持つ
+ */
+import { boxRect, type Box } from "./useDragSelect";
+
+export function SelectionBox({ box }: { box: Box | null }) {
+  if (!box) return null;
+  return <div className="selection-box" style={boxRect(box)} />;
+}
diff --git a/frontend/src/components/fileList/FileListTable.tsx b/frontend/src/components/fileList/FileListTable.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..b1225f58873e79795d771cf8bbba6d5e1c0e4f1f
--- /dev/null
+++ b/frontend/src/components/fileList/FileListTable.tsx
@@ -0,0 +1,244 @@
+/**
+ * ファイル一覧のテーブル（フォルダを先に、続けてファイルを表示）
+ * - 行: 選択・カーソル（focused）・ドラッグ先ハイライト。data-path / data-index は範囲選択や
+ *   キーボード操作のスクロールで使うため変更しないこと
+ * - チェックボックスで Enter: 選択済みなら開く、未選択なら選択
+ * - フォルダ名クリックで移動、ファイル行ダブルクリックで開く
+ * - 見出しクリックで並べ替え、見出しの右クリックはペインのメニュー
+ * - Git 列: G キーで確認した結果（getGitStatusLabel / getGitStatusTitle）
+ */
+import type { DragEvent, MouseEvent } from "react";
+import { ChevronDown, ChevronUp, Copy, Link } from "lucide-react";
+import type { FileItem } from "../../types/file";
+import { formatFileDate } from "../../utils/formatFileDate";
+import { formatFileSize } from "../../utils/formatFileSize";
+import type { FileListSortKey, FileListSortOrder } from "../../utils/fileListFilter";
+import { getGitStatusLabel, getGitStatusTitle, type FolderGitStatus } from "../../utils/gitStatusDisplay";
+import { FileIcon } from "../FileIcon";
+
+interface FileListTableProps {
+  folders: FileItem[];
+  files: FileItem[];
+  selectedItems: Set<string>;
+  focusedIndex: number;
+  dragOverPath: string | null;
+  sortKey: FileListSortKey;
+  sortOrder: FileListSortOrder;
+  folderLatestModified: Record<string, string>;
+  folderLatestModifiedLoading: Set<string>;
+  gitStatuses: Record<string, FolderGitStatus>;
+  isGitStatusLoading: boolean;
+  onSort: (key: FileListSortKey) => void;
+  onHeaderContextMenu: (e: MouseEvent<HTMLElement>) => void;
+  onRowClick: (e: MouseEvent, item: FileItem, index: number) => void;
+  onRowContextMenu: (e: MouseEvent, item: FileItem) => void;
+  onToggleSelect: (path: string) => void;
+  onOpenFolder: (path: string) => void;
+  onOpenFile: (item: FileItem) => void;
+  onCopyFullPath: (item: FileItem) => void;
+  onCopyLink: (path: string, type: "file" | "directory") => void;
+  onGitStatusAction: (item: FileItem) => void;
+  onDragStart: (e: DragEvent, item: FileItem) => void;
+  onDragOver: (e: DragEvent, path: string) => void;
+  onDragLeave: () => void;
+  onDrop: (e: DragEvent, path: string) => void;
+}
+
+export function FileListTable({
+  folders,
+  files,
+  selectedItems,
+  focusedIndex,
+  dragOverPath,
+  sortKey,
+  sortOrder,
+  folderLatestModified,
+  folderLatestModifiedLoading,
+  gitStatuses,
+  isGitStatusLoading,
+  onSort,
+  onHeaderContextMenu,
+  onRowClick,
+  onRowContextMenu,
+  onToggleSelect,
+  onOpenFolder,
+  onOpenFile,
+  onCopyFullPath,
+  onCopyLink,
+  onGitStatusAction,
+  onDragStart,
+  onDragOver,
+  onDragLeave,
+  onDrop,
+}: FileListTableProps) {
+  const sortIcon = (col: FileListSortKey) => {
+    if (sortKey !== col) return null;
+    return sortOrder === "asc" ? <ChevronUp size={12} /> : <ChevronDown size={12} />;
+  };
+
+  const renderCheckbox = (item: FileItem) => (
+    <td className="checkbox-col" onClick={(e) => e.stopPropagation()}>
+      <input
+        type="checkbox"
+        checked={selectedItems.has(item.path)}
+        onChange={() => onToggleSelect(item.path)}
+        onKeyDown={(e) => {
+          if (e.key !== 'Enter') return;
+          e.preventDefault();
+          if (!selectedItems.has(item.path)) {
+            onToggleSelect(item.path);
+          } else if (item.type === "directory") {
+            onOpenFolder(item.path);
+          } else {
+            onOpenFile(item);
+          }
+        }}
+      />
+    </td>
+  );
+
+  const renderCopyButtons = (item: FileItem) => (
+    <>
+      <button
+        className="row-copy-btn"
+        onClick={(e) => {
+          e.stopPropagation();
+          onCopyFullPath(item);
+        }}
+        title="フルパスをコピー"
+      >
+        <Copy size={12} />
+      </button>
+      <button
+        className="row-copy-btn"
+        onClick={(e) => {
+          e.stopPropagation();
+          onCopyLink(item.path, item.type);
+        }}
+        title="リンクをコピー"
+      >
+        <Link size={12} />
+      </button>
+    </>
+  );
+
+  const renderGitCell = (item: FileItem) => {
+    const status = gitStatuses[item.path];
+    if (!status) return null;
+    const label = getGitStatusLabel(status);
+    if (label === "-") {
+      return <span title="Gitリポジトリ外、または変更・リモートとの差分なし">-</span>;
+    }
+    return (
+      <button
+        className="git-status-button"
+        type="button"
+        title={getGitStatusTitle(status)}
+        onClick={(e) => {
+          e.stopPropagation();
+          onGitStatusAction(item);
+        }}
+      >
+        {label}
+      </button>
+    );
+  };
+
+  return (
+    <div className="table-container">
+      <table className="file-table">
+        <thead onContextMenu={onHeaderContextMenu}>
+          <tr>
+            <th className="checkbox-col"></th>
+            <th className="name-col" onClick={() => onSort("name")}>
+              Name {sortIcon("name")}
+            </th>
+            <th className="size-col" onClick={() => onSort("size")}>
+              Size {sortIcon("size")}
+            </th>
+            <th className="date-col" onClick={() => onSort("date")}>
+              Date {sortIcon("date")}
+            </th>
+            <th className="git-col" title="Gキーでペイン内フォルダのGit変更を確認">
+              Git{isGitStatusLoading ? "…" : ""}
+            </th>
+          </tr>
+        </thead>
+        <tbody>
+          {folders.map((item, index) => (
+            <tr
+              key={item.path}
+              data-path={item.path}
+              data-index={index}
+              className={`${selectedItems.has(item.path) ? "selected" : ""} ${dragOverPath === item.path ? "drag-over" : ""} ${focusedIndex === index ? "focused" : ""}`}
+              draggable
+              onDragStart={(e) => onDragStart(e, item)}
+              onDragOver={(e) => onDragOver(e, item.path)}
+              onDragLeave={onDragLeave}
+              onDrop={(e) => onDrop(e, item.path)}
+              onContextMenu={(e) => onRowContextMenu(e, item)}
+              onClick={(e) => onRowClick(e, item, index)}
+            >
+              {renderCheckbox(item)}
+              <td className="name-cell">
+                <div className="name-cell-content">
+                  {renderCopyButtons(item)}
+                  <div className="name-info-wrapper" onClick={() => onOpenFolder(item.path)}>
+                    <FileIcon name={item.name} type="directory" className="icon" />
+                    <span>{item.name}</span>
+                  </div>
+                </div>
+              </td>
+              <td className="size-col">
+                <div className="cell-content">-</div>
+              </td>
+              <td className="date-col">
+                <div className="cell-content">
+                  {folderLatestModifiedLoading.has(item.path)
+                    ? "…"
+                    : formatFileDate(folderLatestModified[item.path] ?? item.modified)}
+                </div>
+              </td>
+              <td className="git-col">{renderGitCell(item)}</td>
+            </tr>
+          ))}
+
+          {files.map((item, fileIndex) => {
+            const index = folders.length + fileIndex;
+            return (
+              <tr
+                key={item.path}
+                data-path={item.path}
+                data-index={index}
+                className={`${selectedItems.has(item.path) ? "selected" : ""} ${focusedIndex === index ? "focused" : ""}`}
+                draggable
+                onDragStart={(e) => onDragStart(e, item)}
+                onContextMenu={(e) => onRowContextMenu(e, item)}
+                onClick={(e) => onRowClick(e, item, index)}
+                onDoubleClick={() => onOpenFile(item)}
+              >
+                {renderCheckbox(item)}
+                <td className="name-cell">
+                  <div className="name-cell-content">
+                    {renderCopyButtons(item)}
+                    <div className="name-info-wrapper">
+                      <FileIcon name={item.name} type="file" className="icon" />
+                      <span>{item.name}</span>
+                    </div>
+                  </div>
+                </td>
+                <td className="size-col">
+                  <div className="cell-content">{formatFileSize(item.size)}</div>
+                </td>
+                <td className="date-col">
+                  <div className="cell-content">{formatFileDate(item.modified)}</div>
+                </td>
+                <td className="git-col" />
+              </tr>
+            );
+          })}
+        </tbody>
+      </table>
+    </div>
+  );
+}
diff --git a/frontend/src/components/fileList/FileListToolbar.tsx b/frontend/src/components/fileList/FileListToolbar.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..384bbd0ee096d017965c9c491b4567184c55b938
--- /dev/null
+++ b/frontend/src/components/fileList/FileListToolbar.tsx
@@ -0,0 +1,156 @@
+/**
+ * ファイル一覧のアイコンツールバー（file_viewer の base.html 準拠のアイコン配置）
+ * - 移動（戻る/進む/上の階層/ホーム/ネットワークドライブ/クリップボードのパス）
+ * - 外部アプリ（VS Code / Antigravity / Obsidian / Finder・Explorer / Jupyter / Excalidraw）
+ * - 作成・削除・更新、テストフォルダ・ゴミ箱を開く
+ * キーボード操作ではボタンの並び順（DOM順）でフォーカス位置を決めるため、ボタンの順番を変えないこと
+ */
+import {
+  ArrowLeft,
+  ArrowRight,
+  ChevronUp,
+  ClipboardPaste,
+  Code,
+  Download,
+  FlaskConical,
+  FolderOpen,
+  FolderPlus,
+  Gem,
+  Home,
+  Network,
+  RefreshCw,
+  Rocket,
+  Search,
+  Trash2,
+} from "lucide-react";
+
+export interface FileListToolbarProps {
+  isSectionFocused: boolean;
+  focusedButtonIndex: number;
+  canGoBack: boolean;
+  canGoForward: boolean;
+  canGoUp: boolean;
+  /** 左・中央ペインだけに表示するボタン（ファイル名検索・全文検索） */
+  showPaneSearchButtons: boolean;
+  /** パスに obsidian を含む場合だけ表示する「Obsidianで開く」 */
+  showObsidianButton: boolean;
+  hasSelection: boolean;
+  onBack: () => void;
+  onForward: () => void;
+  onUp: () => void;
+  onHome: () => void;
+  onNetworkDrive: () => void;
+  onOpenFromClipboard: () => void;
+  onDownload: () => void;
+  onOpenVSCode: () => void;
+  onOpenAntigravity: () => void;
+  onOpenObsidianDaily: () => void;
+  onOpenExplorer: () => void;
+  onFocusSearch: () => void;
+  onOpenFullTextSearch: () => void;
+  onOpenJupyter: () => void;
+  onOpenExcalidraw: () => void;
+  onCreateMarkdown: () => void;
+  onOpenObsidian: () => void;
+  onCreateFolder: () => void;
+  onDeleteSelected: () => void;
+  onRefresh: () => void;
+  onOpenTestFolder: () => void;
+  onOpenTrash: () => void;
+}
+
+export function FileListToolbar(props: FileListToolbarProps) {
+  return (
+    <div
+      className={`icon-toolbar ${props.isSectionFocused ? 'section-focused' : ''}`}
+      data-focused-index={props.isSectionFocused ? props.focusedButtonIndex : undefined}
+    >
+      <button onClick={props.onBack} disabled={!props.canGoBack} title="戻る">
+        <ArrowLeft size={14} />
+      </button>
+      <button onClick={props.onForward} disabled={!props.canGoForward} title="進む">
+        <ArrowRight size={14} />
+      </button>
+      <button onClick={props.onUp} disabled={!props.canGoUp} title="上の階層へ">
+        <ChevronUp size={14} />
+      </button>
+      <button onClick={props.onHome} title="ホームへ">
+        <Home size={14} />
+      </button>
+      <button onClick={props.onNetworkDrive} title="ネットワークドライブへ">
+        <Network size={14} />
+      </button>
+      <button onClick={props.onOpenFromClipboard} title="クリップボードから開く">
+        <ClipboardPaste size={14} />
+      </button>
+      <button onClick={props.onDownload} title="ダウンロード">
+        <Download size={14} />
+      </button>
+      <button onClick={props.onOpenVSCode} title="VSCodeで開く">
+        <Code size={14} />
+      </button>
+      <button onClick={props.onOpenAntigravity} title="Antigravityで開く">
+        <Rocket size={14} />
+      </button>
+      <button onClick={props.onOpenObsidianDaily} title="Obsidian 今日のフォルダ">
+        <img src="/obsidian.svg" alt="Obsidian Daily" width={14} height={14} />
+      </button>
+      <button onClick={props.onOpenExplorer} title="フォルダを開く">
+        <FolderOpen size={14} />
+      </button>
+      {props.showPaneSearchButtons && (
+        <>
+          <button onClick={props.onFocusSearch} title="ファイル名検索 (Ctrl+F / /)">
+            <Search size={14} />
+          </button>
+          <button onClick={props.onOpenFullTextSearch} title="全文検索 (Ctrl+P)">
+            <Search size={14} style={{ opacity: 0.6 }} />
+          </button>
+        </>
+      )}
+      <button onClick={props.onOpenJupyter} title="Jupyterで開く">
+        <img src="/icons/catppuccin/jupyter.svg" alt="Jupyter" width={14} height={14} />
+      </button>
+      <button onClick={props.onOpenExcalidraw} title="Excalidrawで開く">
+        <img src="/icons/catppuccin/excalidraw.svg" alt="Excalidraw" width={14} height={14} />
+      </button>
+      <button onClick={props.onCreateMarkdown} title="Markdownファイル作成">
+        <img src="/icons/catppuccin/markdown.svg" alt="Markdown" width={14} height={14} />
+      </button>
+      {props.showObsidianButton && (
+        <>
+          <div className="toolbar-divider" />
+          <button onClick={props.onOpenObsidian} title="Obsidianで開く">
+            <Gem size={14} />
+          </button>
+        </>
+      )}
+      <div className="toolbar-divider" />
+      <button onClick={props.onCreateFolder} title="フォルダ作成">
+        <FolderPlus size={14} />
+      </button>
+      <button
+        onClick={props.onDeleteSelected}
+        disabled={!props.hasSelection}
+        title="選択項目を削除"
+        className="delete-btn"
+      >
+        <Trash2 size={14} />
+      </button>
+      <button onClick={props.onRefresh} title="更新 (R)">
+        <RefreshCw size={14} />
+      </button>
+
+      <div style={{ flex: 1 }} />
+      <div className="toolbar-divider" />
+
+      {/* テストフォルダ・ゴミ箱（透明/アウトライン表示） */}
+      <button className="toolbar-btn test-folder-btn" onClick={props.onOpenTestFolder} title="テストフォルダを開く">
+        <FlaskConical size={14} />
+      </button>
+      <button className="toolbar-btn trash-open-btn" onClick={props.onOpenTrash} title="ゴミ箱を開く">
+        <Trash2 size={14} />
+      </button>
+    </div>
+  );
+}
diff --git a/frontend/src/components/fileList/sharedState.ts b/frontend/src/components/fileList/sharedState.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1239618760c4cd0a5dbe0af2f4a7ca1e73f7a847
--- /dev/null
+++ b/frontend/src/components/fileList/sharedState.ts
@@ -0,0 +1,32 @@
+/**
+ * 左右のペイン（FileList インスタンス）間で共有する状態
+ * - draggedItems / dragSourcePanelId: アプリ内ドラッグ中の項目とドラッグ元ペイン（同一ペイン移動の確認に使用）
+ * - clipboard: アプリ内のコピー/切り取り（Ctrl+C / Ctrl+X）の内容。別のペインで貼り付けられる
+ * useRef はインスタンスごとのためペイン間で共有できず、画面の再描画も不要なのでモジュール変数で保持する
+ */
+import type { FileItem } from "../../types/file";
+
+export interface FileListClipboard {
+  paths: string[];
+  op: "copy" | "move";
+}
+
+export const fileListShared: {
+  draggedItems: FileItem[];
+  dragSourcePanelId: string | null;
+  clipboard: FileListClipboard | null;
+} = {
+  draggedItems: [],
+  dragSourcePanelId: null,
+  clipboard: null,
+};
+
+// Ctrl+C / Ctrl+X でアプリ内クリップボードに入れる
+export function setFileListClipboard(clipboard: FileListClipboard): void {
+  fileListShared.clipboard = clipboard;
+}
+
+// 切り取った項目を移動し終えたらクリップボードを空にする
+export function clearFileListClipboard(): void {
+  fileListShared.clipboard = null;
+}
diff --git a/frontend/src/components/fileList/useBatchFileOperations.ts b/frontend/src/components/fileList/useBatchFileOperations.ts
new file mode 100644
index 0000000000000000000000000000000000000000..48bd8285bde602a1d3303f22da2e709d1ed3c889
--- /dev/null
+++ b/frontend/src/components/fileList/useBatchFileOperations.ts
@@ -0,0 +1,263 @@
+/**
+ * ファイル一覧の削除・移動・コピー（同期・非同期共通）
+ * - 削除: 確認モーダル → ゴミ箱へ移動。3件以上またはフォルダを含む場合は非同期（進捗モーダル）
+ *   ロック中の項目は、利用者の同意を得てプロセスを終了してから再試行する
+ * - 移動/コピー: 同名衝突は上書き確認を出し、確認した場合だけ overwrite=true で再実行する（常に進捗表示付き）
+ * - Undo 履歴には実際に成功した項目だけを記録する（docs/file_safety.md）
+ * - 非同期タスクの完了時は FileListProgressModal から結果を受け取り、同期と同じ処理で表示する
+ */
+import { useRef, useState } from "react";
+import { useQueryClient } from "@tanstack/react-query";
+import { useCopyItemsBatch, useDeleteItemsBatch, useMoveItemsBatch } from "../../hooks/useFiles";
+import { stampOperation, type OperationHistoryEntry } from "../../hooks/useOperationHistory";
+import type { BatchOperationResult, FileItem } from "../../types/file";
+import {
+  classifyBatchResults,
+  collectLockingProcesses,
+  formatLockingProcesses,
+  getTransferHistoryData,
+  toBatchOperationResult,
+} from "../../utils/batchResult";
+import { errorMessage } from "../../utils/errorMessage";
+import { clearFileListClipboard } from "./sharedState";
+
+export type BatchOperationType = "move" | "copy" | "delete";
+
+interface BatchFileOperationsOptions {
+  selectedItems: Set<string>;
+  setSelectedItems: (items: Set<string>) => void;
+  allSortedItems: FileItem[];
+  showError: (message: string) => void;
+  showSuccess: (message: string) => void;
+  addOperation: (operation: OperationHistoryEntry) => void;
+  restorePaneFocus: () => void;
+}
+
+export function useBatchFileOperations({
+  selectedItems,
+  setSelectedItems,
+  allSortedItems,
+  showError,
+  showSuccess,
+  addOperation,
+  restorePaneFocus,
+}: BatchFileOperationsOptions) {
+  const queryClient = useQueryClient();
+  const deleteItemsBatch = useDeleteItemsBatch();
+  const moveItemsBatch = useMoveItemsBatch();
+  const copyItemsBatch = useCopyItemsBatch();
+
+  const [isDeleteModalOpen, setIsDeleteModalOpen] = useState(false);
+  const [itemsToDelete, setItemsToDelete] = useState<Set<string>>(new Set());
+  const [progressModalOpen, setProgressModalOpen] = useState(false);
+  const [progressTaskId, setProgressTaskId] = useState<string | null>(null);
+  const [progressOperationType, setProgressOperationType] = useState<BatchOperationType>("move");
+  // 非同期の移動/コピー・削除が完了したときに結果を処理するための文脈
+  const pendingTransferRef = useRef<{ operation: "copy" | "move"; destPath: string } | null>(null);
+  const pendingDeleteDebugModeRef = useRef(false);
+
+  // 選択項目を削除（確認モーダルを表示）
+  const handleDeleteSelected = () => {
+    if (selectedItems.size === 0) return;
+    setItemsToDelete(new Set(selectedItems));
+    setIsDeleteModalOpen(true);
+  };
+
+  // メニューからの削除リクエスト
+  const handleRequestDeleteFromMenu = (item: FileItem) => {
+    setItemsToDelete(new Set([item.path]));
+    setIsDeleteModalOpen(true);
+  };
+
+  // 削除結果の表示（同期・非同期共通）。ロック中の項目は利用者の同意を得てプロセス終了→再試行する
+  const handleDeleteResult = async (
+    result: BatchOperationResult,
+    debugMode: boolean,
+    allowKillRetry: boolean = true
+  ) => {
+    const { succeeded, locked, otherErrors, conflicts } = classifyBatchResults(result.results);
+
+    if (succeeded.length > 0) {
+      showSuccess(`${succeeded.length}件削除しました`);
+      addOperation(stampOperation({ type: "DELETE", canUndo: false, data: {} }));
+    }
+
+    if (locked.length > 0 && allowKillRetry) {
+      const processes = collectLockingProcesses(locked);
+      const message =
+        `ファイルが以下のプロセスによって使用されているため、削除できません。\n\n${formatLockingProcesses(processes)}\n\n` +
+        "プロセスを強制終了(Kill)して削除を再試行しますか？\n(※未保存のデータが失われる可能性があります)";
+      if (window.confirm(message)) {
+        try {
+          const retry = await deleteItemsBatch.mutateAsync({
+            paths: locked.map((r) => r.path),
+            asyncMode: false,
+            debugMode,
+            forceKillPids: processes.map((p) => p.pid),
+          });
+          await handleDeleteResult(toBatchOperationResult(retry), debugMode, false);
+        } catch (retryErr) {
+          showError(`プロセスの強制終了または削除に失敗しました: ${errorMessage(retryErr)}`);
+        }
+      }
+    }
+
+    const failures = [...otherErrors, ...conflicts, ...(allowKillRetry ? [] : locked)];
+    if (failures.length > 0) {
+      failures.forEach((r) => console.error(`Failed to delete ${r.path}: ${r.message}`));
+      showError(`${failures.length}件の削除に失敗しました: ${failures[0].message}`);
+    }
+    queryClient.invalidateQueries({ queryKey: ["files"] });
+  };
+
+  // 削除の実行（ゴミ箱へ移動。ゴミ箱に入れられない場合はエラーとして残す）
+  const handleConfirmDelete = async () => {
+    if (itemsToDelete.size === 0) return;
+
+    const debugMode = localStorage.getItem('file_manager_debug_mode') === 'true';
+    const paths = Array.from(itemsToDelete);
+
+    // 3件以上 または フォルダを含む場合は非同期モード（進捗モーダル表示）
+    const hasDirectory = paths.some(path => {
+      const item = allSortedItems.find(i => i.path === path);
+      return item && item.type === 'directory';
+    });
+    const useAsyncMode = paths.length >= 3 || hasDirectory;
+
+    try {
+      const result = await deleteItemsBatch.mutateAsync({ paths, asyncMode: useAsyncMode, debugMode });
+
+      setSelectedItems(new Set());
+      setItemsToDelete(new Set());
+      setIsDeleteModalOpen(false);
+      restorePaneFocus();
+
+      if (result.status === 'async' && result.task_id) {
+        pendingDeleteDebugModeRef.current = debugMode;
+        setProgressOperationType('delete');
+        setProgressTaskId(result.task_id);
+        setProgressModalOpen(true);
+        return;
+      }
+      await handleDeleteResult(toBatchOperationResult(result), debugMode);
+    } catch (err) {
+      console.error("Delete failed:", err);
+      showError(`削除に失敗しました: ${errorMessage(err)}`);
+    }
+  };
+
+  // 移動/コピーを開始する（同期・非同期共通）。結果は handleBatchOperationResult で処理する
+  const startBatchTransfer = (
+    operation: 'copy' | 'move',
+    srcPaths: string[],
+    destPath: string,
+    useAsyncMode: boolean,
+    overwrite: boolean = false
+  ) => {
+    const verifyChecksum = localStorage.getItem('file_manager_verify_checksum') === 'true';
+    const debugMode = localStorage.getItem('file_manager_debug_mode') === 'true';
+    const mutation = operation === 'copy' ? copyItemsBatch : moveItemsBatch;
+    const opName = operation === 'copy' ? 'コピー' : '移動';
+
+    mutation.mutateAsync({ srcPaths, destPath, overwrite, verifyChecksum, asyncMode: useAsyncMode, debugMode })
+      .then((result) => {
+        if (result.status === 'async' && result.task_id) {
+          pendingTransferRef.current = { operation, destPath };
+          setProgressOperationType(operation);
+          setProgressTaskId(result.task_id);
+          setProgressModalOpen(true);
+          return;
+        }
+        void handleBatchOperationResult(operation, toBatchOperationResult(result), destPath);
+      })
+      .catch((err) => {
+        console.error(`Batch ${operation} failed:`, err);
+        showError(`${opName}処理中にエラーが発生しました: ${errorMessage(err)}`);
+      });
+  };
+
+  // 移動/コピー結果の共通ハンドラ（成功分だけ履歴に残し、同名衝突は上書き確認を出す）
+  const handleBatchOperationResult = async (
+    operation: 'copy' | 'move',
+    result: BatchOperationResult,
+    targetPath: string
+  ) => {
+    const opName = operation === 'copy' ? 'コピー' : '移動';
+    const { succeeded, conflicts, locked, otherErrors } = classifyBatchResults(result.results);
+
+    const history = getTransferHistoryData(operation, result.results, targetPath);
+    if (history) {
+      addOperation(stampOperation({ ...history, canUndo: true }));
+    }
+
+    if (succeeded.length > 0) {
+      showSuccess(`${succeeded.length}件${opName}しました`);
+      if (operation === 'move') {
+        clearFileListClipboard();
+        setSelectedItems(new Set());
+      }
+    }
+    queryClient.invalidateQueries({ queryKey: ["files"] });
+
+    const failures = [...locked, ...otherErrors];
+    if (failures.length > 0) {
+      failures.forEach((r) => console.error(`Failed to ${operation} ${r.path}: ${r.message}`));
+      showError(`${failures.length}件の${opName}に失敗しました: ${failures[0].message}`);
+    }
+
+    if (conflicts.length > 0) {
+      const message =
+        `${conflicts.length}件のファイルが既に存在します。上書きしますか？\n` +
+        "（上書きされる既存のファイルはゴミ箱に移動します。フォルダは統合され、移動先にだけあるファイルは残ります）";
+      if (confirm(message)) {
+        // 上書きは件数が少なくても時間がかかることがあるため、常に進捗表示付きで実行する
+        startBatchTransfer(operation, conflicts.map((r) => r.path), targetPath, true, true);
+      }
+    }
+  };
+
+  // 非同期タスクの完了（進捗モーダルから呼ばれる）
+  const handleProgressComplete = (result: BatchOperationResult | undefined) => {
+    const operation = progressOperationType;
+    setProgressModalOpen(false);
+    setProgressTaskId(null);
+    queryClient.invalidateQueries({ queryKey: ["files"] });
+    if (!result) return;
+
+    if (operation === "delete") {
+      void handleDeleteResult(result, pendingDeleteDebugModeRef.current);
+      return;
+    }
+    const context = pendingTransferRef.current;
+    pendingTransferRef.current = null;
+    if (context) {
+      void handleBatchOperationResult(context.operation, result, context.destPath);
+    }
+  };
+
+  const handleProgressClose = () => {
+    setProgressModalOpen(false);
+    setProgressTaskId(null);
+  };
+
+  return {
+    startBatchTransfer,
+    handleDeleteSelected,
+    handleRequestDeleteFromMenu,
+    deleteConfirm: {
+      isOpen: isDeleteModalOpen,
+      items: itemsToDelete,
+      onConfirm: handleConfirmDelete,
+      onClose: () => setIsDeleteModalOpen(false),
+    },
+    progress: {
+      isOpen: progressModalOpen,
+      taskId: progressTaskId,
+      operationType: progressOperationType,
+      onComplete: handleProgressComplete,
+      onClose: handleProgressClose,
+    },
+  };
+}
+
+export type BatchFileOperations = ReturnType<typeof useBatchFileOperations>;
diff --git a/frontend/src/components/fileList/useDragSelect.ts b/frontend/src/components/fileList/useDragSelect.ts
new file mode 100644
index 0000000000000000000000000000000000000000..998d7abf4e1972d69d245f2396298094beb221e5
--- /dev/null
+++ b/frontend/src/components/fileList/useDragSelect.ts
@@ -0,0 +1,116 @@
+/**
+ * ファイル一覧の範囲選択（ラバーバンド選択）
+ * - 余白からドラッグした矩形に重なる行を選択に追加する（行は data-path 属性でパスを持つ）
+ * - Shift を押しながらなら行の上からでも開始できる（ボタン・入力欄・リンクの上は除く）
+ * - 5px 未満の小さなドラッグはクリックとみなして選択を変えない
+ * - ペインの外でマウスを離しても確定する
+ */
+import { useEffect, useEffectEvent, useState, type MouseEvent, type RefObject } from "react";
+
+export interface Box {
+  startX: number;
+  startY: number;
+  endX: number;
+  endY: number;
+}
+
+interface DragSelectOptions {
+  containerRef: RefObject<HTMLDivElement | null>;
+  selectedItems: Set<string>;
+  setSelectedItems: (items: Set<string>) => void;
+}
+
+export function boxRect(box: Box) {
+  return {
+    left: Math.min(box.startX, box.endX),
+    top: Math.min(box.startY, box.endY),
+    width: Math.abs(box.endX - box.startX),
+    height: Math.abs(box.endY - box.startY),
+  };
+}
+
+export function useDragSelect({ containerRef, selectedItems, setSelectedItems }: DragSelectOptions) {
+  const [selectionBox, setSelectionBox] = useState<Box | null>(null);
+  const [isShiftDragSelecting, setIsShiftDragSelecting] = useState(false);
+  const isDragSelecting = selectionBox !== null;
+
+  const pointInContainer = (e: MouseEvent) => {
+    const rect = containerRef.current?.getBoundingClientRect();
+    return rect ? { x: e.clientX - rect.left, y: e.clientY - rect.top } : null;
+  };
+
+  const handleMouseDown = (e: MouseEvent) => {
+    // コンテナにフォーカスを当てる（これによりキーボードイベントを受け取れる）
+    containerRef.current?.focus();
+    if (e.button !== 0) return;
+
+    const target = e.target as HTMLElement;
+    if (e.shiftKey) {
+      if (target.closest("button, input, a")) return;
+      // テキスト選択や行のドラッグを防ぐ
+      e.preventDefault();
+    } else if (target.closest("button, input, a, .file-table tr")) {
+      return;
+    }
+
+    const point = pointInContainer(e);
+    if (!point) return;
+    setIsShiftDragSelecting(e.shiftKey);
+    setSelectionBox({ startX: point.x, startY: point.y, endX: point.x, endY: point.y });
+  };
+
+  const handleMouseMove = (e: MouseEvent) => {
+    if (!selectionBox) return;
+    const point = pointInContainer(e);
+    if (!point) return;
+    setSelectionBox({ ...selectionBox, endX: point.x, endY: point.y });
+  };
+
+  const finishSelection = () => {
+    const container = containerRef.current;
+    const box = selectionBox;
+    setSelectionBox(null);
+    setIsShiftDragSelecting(false);
+    if (!box || !container) return;
+
+    const { left, top, width, height } = boxRect(box);
+    if (width < 5 && height < 5) return;
+
+    // 矩形はコンテナ内の座標なので、行の位置もコンテナ基準（スクロール込み）に直して比べる
+    const containerRect = container.getBoundingClientRect();
+    const newSelected = new Set(selectedItems);
+    container.querySelectorAll(".file-table tbody tr").forEach((row) => {
+      const rowRect = row.getBoundingClientRect();
+      const rowTop = rowRect.top - containerRect.top + container.scrollTop;
+      const rowLeft = rowRect.left - containerRect.left + container.scrollLeft;
+      const intersects =
+        rowLeft < left + width &&
+        rowLeft + rowRect.width > left &&
+        rowTop < top + height &&
+        rowTop + rowRect.height > top;
+      const path = row.getAttribute("data-path");
+      if (intersects && path) {
+        newSelected.add(path);
+      }
+    });
+    setSelectedItems(newSelected);
+  };
+
+  // ペインの外でマウスを離した場合も確定する
+  const onWindowMouseUp = useEffectEvent(() => finishSelection());
+  useEffect(() => {
+    if (!isDragSelecting) return;
+    const listener = () => onWindowMouseUp();
+    window.addEventListener("mouseup", listener);
+    return () => window.removeEventListener("mouseup", listener);
+  }, [isDragSelecting]);
+
+  return {
+    selectionBox,
+    isShiftDragSelecting,
+    handleMouseDown,
+    handleMouseMove,
+    handleMouseUp: finishSelection,
+  };
+}
+
diff --git a/frontend/src/components/fileList/useExternalAppActions.ts b/frontend/src/components/fileList/useExternalAppActions.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1adac74a99ca4ffe3edd668293da6daf76cb2afa
--- /dev/null
+++ b/frontend/src/components/fileList/useExternalAppActions.ts
@@ -0,0 +1,207 @@
+/**
+ * ファイル一覧から外部アプリでフォルダ/ファイルを開く操作
+ * - 現在のフォルダを VS Code / Finder・Explorer / Jupyter / Antigravity / Obsidian で開く（選択状態に関係なく現在のフォルダ）
+ * - プログラムコードを VS Code / 内蔵エディタで開く・実行する（右クリックメニュー）
+ * - HTML プレビュー・全文検索を新しいタブで開く、ゴミ箱を開く
+ * - Markdown をパスに応じて Obsidian / VS Code で開く
+ * 失敗時はトーストでエラーを表示する
+ */
+import {
+  executeProgramCode,
+  getFullTextSearchUrl,
+  getHtmlViewUrl,
+  openInAntigravity,
+  openInEditor,
+  openInExplorer,
+  openInJupyter,
+  openInObsidian,
+  openInVSCode,
+  openTrash,
+} from "../../api/files";
+import type { FileItem } from "../../types/file";
+import { errorMessage } from "../../utils/errorMessage";
+
+interface ExternalAppActionsOptions {
+  currentPath: string | null;
+  showError: (message: string) => void;
+  showSuccess: (message: string) => void;
+  /** 右クリックメニューを閉じる */
+  closeContextMenu: () => void;
+}
+
+export function useExternalAppActions({ currentPath, showError, showSuccess, closeContextMenu }: ExternalAppActionsOptions) {
+  const openMarkdownInExternalApp = async (path: string) => {
+    if (path.toLowerCase().includes("obsidian")) {
+      await openInObsidian(path);
+      showSuccess("Obsidianを開きました");
+      return;
+    }
+
+    await openInVSCode(path);
+    showSuccess("VS Codeで開きました");
+  };
+
+  // VSCodeで開く
+  const handleOpenVSCode = async () => {
+    // 選択状態に関わらず、常にカレントディレクトリを開く
+    const targetPath = currentPath;
+
+    if (!targetPath) {
+      showError("開く対象がありません");
+      return;
+    }
+
+    try {
+      await openInVSCode(targetPath);
+      // VSCodeを開くのは「成功」メッセージを出さない方が一般的かもしれないが、
+      // 既存の挙動に合わせておく（ただし複数件数表示はなくなる）
+      // showSuccess("VSCodeを開きました");
+    } catch (e) {
+      console.error(`Error opening in VSCode: ${targetPath}`, e);
+      showError(`VSCode起動エラー: ${errorMessage(e)}`);
+    }
+  };
+
+  const handleOpenProgramCodeInVSCode = async (item: FileItem) => {
+    try {
+      await openInVSCode(item.path);
+      closeContextMenu();
+    } catch (e) {
+      console.error(`Error opening program code in VSCode: ${item.path}`, e);
+      showError(`コード起動エラー: ${errorMessage(e)}`);
+    }
+  };
+
+  const handleOpenProgramCodeInEditor = async (item: FileItem) => {
+    try {
+      await openInEditor(item.path);
+      closeContextMenu();
+    } catch (e) {
+      console.error(`Error opening program code in editor: ${item.path}`, e);
+      showError(`エディター起動エラー: ${errorMessage(e)}`);
+    }
+  };
+
+  const handleExecuteProgramCode = async (item: FileItem) => {
+    try {
+      await executeProgramCode(item.path);
+      showSuccess(`実行を開始しました: ${item.name}`);
+      closeContextMenu();
+    } catch (e) {
+      console.error(`Error executing program code: ${item.path}`, e);
+      showError(`実行エラー: ${errorMessage(e)}`);
+    }
+  };
+
+  const handleOpenHtmlPreview = (item: FileItem) => {
+    window.open(getHtmlViewUrl(item.path), "_blank", "noopener,noreferrer");
+    closeContextMenu();
+  };
+
+  // エクスプローラー/Finderで開く
+  const handleOpenExplorer = async () => {
+    // 選択状態に関わらず、常にカレントディレクトリを開く
+    const targetPath = currentPath;
+
+    if (!targetPath) {
+      return;
+    }
+
+    try {
+      await openInExplorer(targetPath);
+      showSuccess("フォルダを開きました");
+    } catch (e) {
+      console.error("Failed to open explorer:", e);
+      showError(`フォルダを開けませんでした: ${errorMessage(e)}`);
+    }
+  };
+
+  // ゴミ箱を開く
+  const handleOpenTrashFolder = async () => {
+    const result = await openTrash();
+    if (result.success) {
+      showSuccess(result.message || "ゴミ箱を開きました");
+    } else {
+      showError(result.error || "ゴミ箱を開けませんでした");
+    }
+  };
+
+  // 全文検索を開く
+  const handleOpenFullTextSearch = () => {
+    if (!currentPath) {
+      showError("開く対象がありません");
+      return;
+    }
+
+    window.open(getFullTextSearchUrl(currentPath), "_blank", "noopener,noreferrer");
+  };
+
+  // Jupyterを開く
+  const handleOpenJupyter = async () => {
+    // 選択状態に関わらず、常にカレントディレクトリを開く
+    const targetPath = currentPath;
+
+    if (!targetPath) return;
+
+    try {
+      await openInJupyter(targetPath);
+      showSuccess("Jupyterを開きました");
+    } catch (e) {
+      console.error("Failed to open jupyter:", e);
+      showError(`Jupyterを開けませんでした: ${errorMessage(e)}`);
+    }
+  };
+
+  // Antigravityで開く
+  const handleOpenAntigravity = async () => {
+    // 選択状態に関わらず、常にカレントディレクトリを開く
+    const targetPath = currentPath;
+
+    if (!targetPath) {
+      showError("開く対象がありません");
+      return;
+    }
+
+    try {
+      await openInAntigravity(targetPath);
+      showSuccess("Antigravityを開きました");
+    } catch (e) {
+      console.error(`Error opening in Antigravity: ${targetPath}`, e);
+      showError(`Antigravity起動エラー: ${errorMessage(e)}`);
+    }
+  };
+
+  // Obsidianで開く
+  const handleOpenObsidian = async () => {
+    // 選択状態に関わらず、常にカレントディレクトリを開く
+    const targetPath = currentPath;
+
+    if (!targetPath) {
+      showError("開く対象がありません");
+      return;
+    }
+
+    try {
+      await openInObsidian(targetPath);
+      showSuccess("Obsidianを開きました");
+    } catch (e) {
+      console.error(`Error opening in Obsidian: ${targetPath}`, e);
+      showError(`Obsidian起動エラー: ${errorMessage(e)}`);
+    }
+  };
+
+  return {
+    openMarkdownInExternalApp,
+    handleOpenVSCode,
+    handleOpenProgramCodeInVSCode,
+    handleOpenProgramCodeInEditor,
+    handleExecuteProgramCode,
+    handleOpenHtmlPreview,
+    handleOpenExplorer,
+    handleOpenTrashFolder,
+    handleOpenFullTextSearch,
+    handleOpenJupyter,
+    handleOpenAntigravity,
+    handleOpenObsidian,
+  };
+}
diff --git a/frontend/src/components/fileList/useFileCreation.ts b/frontend/src/components/fileList/useFileCreation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9c47f7eb1fef4d81a5a8501ac346a915c8428cfe
--- /dev/null
+++ b/frontend/src/components/fileList/useFileCreation.ts
@@ -0,0 +1,124 @@
+/**
+ * ファイル一覧からの新規作成（フォルダ・テキストファイル・Markdown・Excalidraw）
+ * - 既存の項目は上書きしない（同名があればバックエンドが 400 を返し、ダイアログを開いたままにする）
+ * - 作成した項目は Undo 履歴に記録する
+ * - Markdown は名前だけ決めてエディタを開き、保存したときに作成する
+ * - Excalidraw は空の図面を作ってから Excalidraw で開く（obsidian 配下では .excalidraw.md）
+ * - 作成後はこのペインにキーボード操作を戻す
+ */
+import { useState } from "react";
+import { createFile, openInExcalidraw } from "../../api/files";
+import { useCreateFolder } from "../../hooks/useFiles";
+import { stampOperation, type OperationHistoryEntry } from "../../hooks/useOperationHistory";
+import { errorMessage } from "../../utils/errorMessage";
+import { buildExcalidrawFileName, buildMarkdownFileName, buildTextFileName } from "../../utils/textFileName";
+
+interface FileCreationOptions {
+  currentPath: string | null;
+  showSuccess: (message: string) => void;
+  showError: (message: string) => void;
+  addOperation: (operation: OperationHistoryEntry) => void;
+  refetch: () => void;
+  /** 新規 Markdown をエディタで開く（path は未保存なので null） */
+  openNewMarkdown: (fileName: string) => void;
+  /** 作成後にこのペインへフォーカスを戻す */
+  onCreated: () => void;
+}
+
+export function useFileCreation({
+  currentPath,
+  showSuccess,
+  showError,
+  addOperation,
+  refetch,
+  openNewMarkdown,
+  onCreated,
+}: FileCreationOptions) {
+  const createFolder = useCreateFolder();
+  const [isFolderModalOpen, setIsFolderModalOpen] = useState(false);
+  const [isTextFileModalOpen, setIsTextFileModalOpen] = useState(false);
+  const [isMarkdownModalOpen, setIsMarkdownModalOpen] = useState(false);
+
+  const recordCreatedFile = (createdPath: string) => {
+    addOperation(stampOperation({ type: "CREATE_FILE", canUndo: true, data: { createdPath, content: "" } }));
+  };
+
+  // 失敗したら例外を投げてダイアログを開いたままにする
+  const confirmCreateFolder = async (name: string) => {
+    const parentPath = currentPath || "";
+    try {
+      await createFolder.mutateAsync({ parentPath, name });
+      showSuccess(`フォルダ作成: ${name}`);
+      addOperation(stampOperation({ type: "CREATE_FOLDER", canUndo: true, data: { createdPath: `${parentPath}/${name}` } }));
+      onCreated();
+    } catch (e) {
+      console.error("Folder creation failed:", e);
+      showError(`フォルダ作成に失敗しました: ${errorMessage(e)}`);
+      throw e;
+    }
+  };
+
+  const confirmCreateTextFile = async (name: string, extension: string) => {
+    if (!name || !name.trim()) return;
+    if (!currentPath) {
+      showError("作成先フォルダが特定できません");
+      return;
+    }
+    const filename = buildTextFileName(name, extension);
+    try {
+      const result = await createFile(currentPath, filename, "");
+      showSuccess(`テキストファイル作成: ${filename}`);
+      recordCreatedFile(result.path);
+      refetch();
+      onCreated();
+    } catch (e) {
+      console.error("Text file creation failed:", e);
+      showError(`テキストファイル作成に失敗しました: ${errorMessage(e)}`);
+      throw e;
+    }
+  };
+
+  const confirmCreateMarkdown = (name: string) => {
+    if (!name || !name.trim()) return;
+    if (!currentPath) {
+      showError("作成先フォルダが特定できません");
+      return;
+    }
+    openNewMarkdown(buildMarkdownFileName(name));
+  };
+
+  const createExcalidraw = async () => {
+    const name = prompt("ファイル名を入力してください");
+    if (!name || !name.trim()) return;
+    if (!currentPath) {
+      showError("作成先フォルダが特定できません");
+      return;
+    }
+    const filename = buildExcalidrawFileName(name, currentPath.toLowerCase().includes("obsidian"));
+    try {
+      const result = await createFile(currentPath, filename, "");
+      showSuccess(`ファイルを作成しました: ${filename}`);
+      recordCreatedFile(result.path);
+      await openInExcalidraw(result.path);
+      showSuccess("Excalidrawを開きました");
+      refetch();
+      // Excalidraw から戻ってきたときのためにフォーカスを戻しておく
+      onCreated();
+    } catch (e) {
+      console.error("Failed to open excalidraw:", e);
+      showError(`処理に失敗しました: ${errorMessage(e)}`);
+    }
+  };
+
+  return {
+    openFolderModal: () => setIsFolderModalOpen(true),
+    openTextFileModal: () => setIsTextFileModalOpen(true),
+    openMarkdownModal: () => setIsMarkdownModalOpen(true),
+    createExcalidraw,
+    folderModal: { isOpen: isFolderModalOpen, onClose: () => setIsFolderModalOpen(false), onConfirm: confirmCreateFolder },
+    textFileModal: { isOpen: isTextFileModalOpen, onClose: () => setIsTextFileModalOpen(false), onConfirm: confirmCreateTextFile },
+    markdownModal: { isOpen: isMarkdownModalOpen, onClose: () => setIsMarkdownModalOpen(false), onConfirm: confirmCreateMarkdown },
+  };
+}
+
+export type FileCreation = ReturnType<typeof useFileCreation>;
diff --git a/frontend/src/components/fileList/useFileListDragDrop.ts b/frontend/src/components/fileList/useFileListDragDrop.ts
new file mode 100644
index 0000000000000000000000000000000000000000..52892932a334bc2408d9b414a2b254b1605d1518
--- /dev/null
+++ b/frontend/src/components/fileList/useFileListDragDrop.ts
@@ -0,0 +1,152 @@
+/**
+ * ファイル一覧のドラッグ&ドロップ
+ * - アプリ内ドラッグ: 選択中の行をドラッグすると選択項目をまとめて移動する（選択外の行はその1件だけ）
+ *   ドラッグ中の項目とドラッグ元ペインは fileListShared に置き、別のペインへのドロップでも受け取れるようにする
+ * - 同じペイン内への移動は誤操作防止のため確認する（キャンセルしたら何もしない）
+ * - 3件以上またはフォルダを含む移動は非同期（進捗モーダル）で依頼する
+ *   （クライアント側での再帰カウントは NAS 等で遅いため行わない）
+ * - OS（Explorer / Finder）からのドロップはアップロード。フォルダは階層を保ち、同名は別名で保存される
+ */
+import { useState, type DragEvent } from "react";
+import { useQueryClient } from "@tanstack/react-query";
+import { uploadFiles } from "../../api/files";
+import type { FileItem } from "../../types/file";
+import { scanDataTransferItems } from "../../utils/dragDropScan";
+import { fileListShared } from "./sharedState";
+
+interface DragDropOptions {
+  panelId: string;
+  currentPath: string | null;
+  visibleItems: FileItem[];
+  selectedItems: Set<string>;
+  startMove: (srcPaths: string[], destPath: string, asyncMode: boolean) => void;
+  showSuccess: (message: string) => void;
+  showError: (message: string) => void;
+}
+
+function clearDraggedItems() {
+  fileListShared.draggedItems = [];
+  fileListShared.dragSourcePanelId = null;
+}
+
+/** dataTransfer の text/plain から項目を読む（別ウィンドウなどからのドラッグ用） */
+function readItemsFromDataTransfer(dataTransfer: DataTransfer): FileItem[] {
+  const data = dataTransfer.getData("text/plain");
+  if (!data) return [];
+  try {
+    const parsed: unknown = JSON.parse(data);
+    return (Array.isArray(parsed) ? parsed : [parsed]) as FileItem[];
+  } catch {
+    console.error("Invalid drag data json");
+    return [];
+  }
+}
+
+export function useFileListDragDrop({
+  panelId,
+  currentPath,
+  visibleItems,
+  selectedItems,
+  startMove,
+  showSuccess,
+  showError,
+}: DragDropOptions) {
+  const queryClient = useQueryClient();
+  const [dragOverPath, setDragOverPath] = useState<string | null>(null);
+
+  const handleDragStart = (e: DragEvent, item: FileItem) => {
+    const dragData = selectedItems.has(item.path)
+      ? visibleItems.filter((i) => selectedItems.has(i.path))
+      : [item];
+    if (!dragData.some((d) => d.path === item.path)) {
+      dragData.push(item);
+    }
+
+    fileListShared.draggedItems = dragData;
+    fileListShared.dragSourcePanelId = panelId;
+
+    // dataTransfer にもセット（互換性のため）
+    e.dataTransfer.setData("text/plain", JSON.stringify(dragData));
+    e.dataTransfer.effectAllowed = "copyMove";
+  };
+
+  const handleDragOver = (e: DragEvent, targetPath: string) => {
+    e.preventDefault();
+    e.dataTransfer.dropEffect = "move";
+    setDragOverPath(targetPath);
+  };
+
+  const handleDragLeave = () => {
+    setDragOverPath(null);
+  };
+
+  const upload = async (targetPath: string, dataTransfer: DataTransfer) => {
+    try {
+      const { files, emptyDirectories } = await scanDataTransferItems(dataTransfer);
+      let result;
+      if (files.length + emptyDirectories.length === 0) {
+        // 何も取得できなかった場合はファイル一覧だけを送る
+        if (!dataTransfer.files || dataTransfer.files.length === 0) return;
+        const fallbackFiles = Array.from(dataTransfer.files);
+        showSuccess(`アップロード開始: ${fallbackFiles.length}件`);
+        result = await uploadFiles(targetPath, fallbackFiles);
+      } else {
+        const details = [
+          files.length > 0 ? `${files.length}件のファイル` : "",
+          emptyDirectories.length > 0 ? `${emptyDirectories.length}件のフォルダ` : "",
+        ].filter(Boolean).join("、");
+        showSuccess(`アップロード開始: ${details}`);
+        result = await uploadFiles(targetPath, files, emptyDirectories);
+      }
+      if (result.status === "success" || result.status === "partial_success") {
+        showSuccess(result.message);
+        queryClient.invalidateQueries({ queryKey: ["files"] });
+      } else {
+        showError(result.message || "アップロードに失敗しました");
+      }
+    } catch (err) {
+      showError(`アップロードエラー: ${String(err)}`);
+    }
+  };
+
+  const handleDrop = async (e: DragEvent, targetPath: string) => {
+    e.preventDefault();
+    e.stopPropagation();
+    setDragOverPath(null);
+
+    const isOsDrop = fileListShared.draggedItems.length === 0 && (
+      (e.dataTransfer.files && e.dataTransfer.files.length > 0) ||
+      (e.dataTransfer.items && Array.from(e.dataTransfer.items).some((item) => item.kind === "file"))
+    );
+    if (isOsDrop) {
+      await upload(targetPath, e.dataTransfer);
+      return;
+    }
+
+    const items = fileListShared.draggedItems.length > 0
+      ? fileListShared.draggedItems
+      : readItemsFromDataTransfer(e.dataTransfer);
+    const srcPaths = items.filter((item) => item.path !== targetPath).map((item) => item.path);
+
+    if (srcPaths.length > 0) {
+      const isSamePane = fileListShared.dragSourcePanelId !== null && fileListShared.dragSourcePanelId === panelId;
+      if (isSamePane && !confirm("同じペイン内での移動です。よろしいですか？")) {
+        clearDraggedItems();
+        return;
+      }
+      const hasDirectory = items.some((item) => item.type === "directory");
+      startMove(srcPaths, targetPath, srcPaths.length >= 3 || hasDirectory);
+    }
+    clearDraggedItems();
+  };
+
+  // ペインの余白へのドロップは現在のフォルダへ
+  const handlePanelDrop = (e: DragEvent) => {
+    e.preventDefault();
+    if (currentPath) {
+      void handleDrop(e, currentPath);
+    }
+  };
+
+  return { dragOverPath, handleDragStart, handleDragOver, handleDragLeave, handleDrop, handlePanelDrop };
+}
diff --git a/frontend/src/components/fileList/useFileListEditors.ts b/frontend/src/components/fileList/useFileListEditors.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8b544cb04a79580b4f1cdf405d5652ff63850b45
--- /dev/null
+++ b/frontend/src/components/fileList/useFileListEditors.ts
@@ -0,0 +1,146 @@
+/**
+ * ファイル一覧の内蔵エディタ（Markdown エディタ・テキスト/コードエディタ）の状態と保存処理
+ * - openMarkdownEditor: 既存ファイル（path あり）または新規作成（path なし）で Markdown エディタを開く
+ * - openFileEditor: テキスト/コードエディタを開く
+ * - 保存: 既存は update-file（アトミック書き込み）、新規は create-file。成功したら一覧を更新して閉じる
+ * - 閉じたときは、開く前のペインへキーボード操作を戻す（restorePaneFocus）
+ * Undo 履歴: 新規作成は取り消し可能、上書き保存は取り消し不可として記録する
+ */
+import { useState } from "react";
+import { createFile, updateFile } from "../../api/files";
+import type { OperationHistoryEntry } from "../../hooks/useOperationHistory";
+import type { EditorLanguage } from "../../utils/codeEditorHighlight";
+import { errorMessage } from "../../utils/errorMessage";
+
+interface FileListEditorsOptions {
+  currentPath: string | null;
+  showError: (message: string) => void;
+  showSuccess: (message: string) => void;
+  addOperation: (operation: OperationHistoryEntry) => void;
+  refetch: () => unknown;
+  restorePaneFocus: () => void;
+}
+
+export function useFileListEditors({
+  currentPath,
+  showError,
+  showSuccess,
+  addOperation,
+  refetch,
+  restorePaneFocus,
+}: FileListEditorsOptions) {
+  const [mdEditorOpen, setMdEditorOpen] = useState(false);
+  const [mdEditorFileName, setMdEditorFileName] = useState("");
+  const [mdEditorFilePath, setMdEditorFilePath] = useState<string | null>(null);
+  const [mdEditorSaving, setMdEditorSaving] = useState(false);
+  const [mdEditorInitialContent, setMdEditorInitialContent] = useState("");
+  const [fileEditorOpen, setFileEditorOpen] = useState(false);
+  const [fileEditorFileName, setFileEditorFileName] = useState("");
+  const [fileEditorFilePath, setFileEditorFilePath] = useState<string | null>(null);
+  const [fileEditorSaving, setFileEditorSaving] = useState(false);
+  const [fileEditorInitialContent, setFileEditorInitialContent] = useState("");
+  const [fileEditorLanguage, setFileEditorLanguage] = useState<EditorLanguage>("plaintext");
+
+  const openMarkdownEditor = (fileName: string, filePath: string | null, content: string) => {
+    setMdEditorFileName(fileName);
+    setMdEditorFilePath(filePath);
+    setMdEditorInitialContent(content);
+    setMdEditorOpen(true);
+  };
+
+  const openFileEditor = (fileName: string, filePath: string, content: string, language: EditorLanguage) => {
+    setFileEditorFileName(fileName);
+    setFileEditorFilePath(filePath);
+    setFileEditorInitialContent(content);
+    setFileEditorLanguage(language);
+    setFileEditorOpen(true);
+  };
+
+  const handleSaveMarkdown = async (content: string) => {
+    if (!currentPath) return;
+
+    setMdEditorSaving(true);
+    try {
+      if (mdEditorFilePath) {
+        await updateFile(mdEditorFilePath, content);
+        showSuccess(`更新しました: ${mdEditorFileName}`);
+        addOperation({ type: "UPDATE_FILE", canUndo: false, timestamp: Date.now(), data: {} });
+      } else {
+        const result = await createFile(currentPath, mdEditorFileName, content);
+        setMdEditorFilePath(result.path);
+        showSuccess(`作成しました: ${mdEditorFileName}`);
+        addOperation({
+          type: "CREATE_FILE",
+          canUndo: true,
+          timestamp: Date.now(),
+          data: { createdPath: result.path, content },
+        });
+      }
+      refetch();
+      setMdEditorOpen(false);
+      restorePaneFocus();
+    } catch (e) {
+      showError(`保存に失敗しました: ${errorMessage(e)}`);
+    } finally {
+      setMdEditorSaving(false);
+    }
+  };
+
+  const handleCloseMdEditor = () => {
+    setMdEditorOpen(false);
+    setMdEditorFileName("");
+    setMdEditorFilePath(null);
+    restorePaneFocus();
+  };
+
+  const handleSaveFileEditor = async (content: string) => {
+    if (!fileEditorFilePath) return;
+
+    setFileEditorSaving(true);
+    try {
+      await updateFile(fileEditorFilePath, content);
+      showSuccess(`更新しました: ${fileEditorFileName}`);
+      addOperation({ type: "UPDATE_FILE", canUndo: false, timestamp: Date.now(), data: {} });
+      refetch();
+      setFileEditorOpen(false);
+      restorePaneFocus();
+    } catch (e) {
+      showError(`保存に失敗しました: ${errorMessage(e)}`);
+    } finally {
+      setFileEditorSaving(false);
+    }
+  };
+
+  const handleCloseFileEditor = () => {
+    setFileEditorOpen(false);
+    setFileEditorFileName("");
+    setFileEditorFilePath(null);
+    restorePaneFocus();
+  };
+
+  return {
+    markdown: {
+      isOpen: mdEditorOpen,
+      fileName: mdEditorFileName,
+      filePath: mdEditorFilePath,
+      isSaving: mdEditorSaving,
+      initialContent: mdEditorInitialContent,
+      onSave: handleSaveMarkdown,
+      onClose: handleCloseMdEditor,
+    },
+    file: {
+      isOpen: fileEditorOpen,
+      fileName: fileEditorFileName,
+      filePath: fileEditorFilePath,
+      isSaving: fileEditorSaving,
+      initialContent: fileEditorInitialContent,
+      language: fileEditorLanguage,
+      onSave: handleSaveFileEditor,
+      onClose: handleCloseFileEditor,
+    },
+    openMarkdownEditor,
+    openFileEditor,
+  };
+}
+
+export type FileListEditorsState = ReturnType<typeof useFileListEditors>;
diff --git a/frontend/src/components/fileList/useFileOpener.ts b/frontend/src/components/fileList/useFileOpener.ts
new file mode 100644
index 0000000000000000000000000000000000000000..08b65ffcfdefefb412a552944ad0b9078b2bb4ce
--- /dev/null
+++ b/frontend/src/components/fileList/useFileOpener.ts
@@ -0,0 +1,136 @@
+/**
+ * ファイルを開く処理と画像プレビューの状態
+ * - PDF: ブラウザの別タブ（await の後だとポップアップブロックされやすいので同期的に開く）
+ * - 画像: 内蔵の画像プレビュー（フォルダ内の他の画像へ前後移動・グリッド表示）
+ * - Markdown: 設定に応じて 外部アプリ / Obsidian（obsidian 配下のみ）/ 内蔵エディタ
+ *   （.excalidraw.md は Markdown として扱わず、バックエンドの判定に任せる）
+ * - テキスト・コード: 「VS Code で開く」設定なら VS Code、それ以外は内蔵エディタ
+ * - その他: バックエンド /api/open/smart の判定（内蔵エディタ・URL・既定のアプリ）
+ */
+import { useState } from "react";
+import { getPdfViewUrl, openInObsidian, openInVSCode, openSmart } from "../../api/files";
+import type { FileItem } from "../../types/file";
+import { isWebFileEditorTarget, type EditorLanguage } from "../../utils/codeEditorHighlight";
+import type { MarkdownOpenMode, TextFileOpenMode } from "../../utils/editorPreferences";
+import { errorMessage } from "../../utils/errorMessage";
+import { isImageFile } from "../../utils/imageUtils";
+
+interface FileOpenerOptions {
+  /** 表示中の項目（画像を開いたときに FileItem を引くため） */
+  visibleItems: FileItem[];
+  /** 画像プレビューで前後移動する、フォルダ内の画像 */
+  folderImages: FileItem[];
+  textFileOpenMode: TextFileOpenMode;
+  markdownOpenMode: MarkdownOpenMode;
+  openMarkdownInExternalApp: (path: string) => Promise<void>;
+  openMarkdownEditor: (fileName: string, path: string, content: string) => void;
+  openFileEditor: (fileName: string, path: string, content: string, language: EditorLanguage) => void;
+  showSuccess: (message: string) => void;
+  showError: (message: string) => void;
+}
+
+function isExcalidrawMarkdownFile(fileName: string): boolean {
+  const lowerFileName = fileName.toLowerCase();
+  return lowerFileName.includes(".excalidraw") && lowerFileName.endsWith(".md");
+}
+
+export function useFileOpener({
+  visibleItems,
+  folderImages,
+  textFileOpenMode,
+  markdownOpenMode,
+  openMarkdownInExternalApp,
+  openMarkdownEditor,
+  openFileEditor,
+  showSuccess,
+  showError,
+}: FileOpenerOptions) {
+  const [previewImage, setPreviewImage] = useState<FileItem | null>(null);
+  const [imagePreviewMode, setImagePreviewMode] = useState<"single" | "grid">("single");
+
+  const openImage = (item: FileItem) => {
+    setPreviewImage(item);
+    setImagePreviewMode("single");
+  };
+
+  // フォルダ内の画像をプレビューする（画像を指定したらその画像、なければグリッド表示）
+  const openFolderImages = (initialTargetItem?: FileItem) => {
+    if (folderImages.length === 0) {
+      showError("このフォルダ内に画像ファイルはありません");
+      return;
+    }
+    if (initialTargetItem && isImageFile(initialTargetItem.name)) {
+      openImage(initialTargetItem);
+    } else {
+      setPreviewImage(folderImages[0]);
+      setImagePreviewMode("grid");
+    }
+  };
+
+  const openPath = async (path: string, fileName: string, options?: { forceWebEditor?: boolean }) => {
+    try {
+      const lowerFileName = fileName.toLowerCase();
+      const forceWebEditor = options?.forceWebEditor === true;
+      const isObsidianPath = path.toLowerCase().includes("obsidian");
+      const isMarkdown = lowerFileName.endsWith(".md") && !isExcalidrawMarkdownFile(fileName);
+
+      if (lowerFileName.endsWith(".pdf")) {
+        window.open(getPdfViewUrl(path), "_blank", "noopener,noreferrer");
+        return;
+      }
+
+      if (isImageFile(fileName)) {
+        openImage(visibleItems.find((it) => it.path === path) ?? { name: fileName, path, type: "file" });
+        return;
+      }
+
+      if (!forceWebEditor && isMarkdown) {
+        if (markdownOpenMode === "external") {
+          await openMarkdownInExternalApp(path);
+          return;
+        }
+        if (markdownOpenMode === "obsidian_or_web" && isObsidianPath) {
+          await openInObsidian(path);
+          showSuccess("Obsidianを開きました");
+          return;
+        }
+      } else if (!forceWebEditor && textFileOpenMode === "vscode" && isWebFileEditorTarget(fileName)) {
+        await openInVSCode(path);
+        showSuccess("VS Codeで開きました");
+        return;
+      }
+
+      const isMarkdownForWebEditor = isMarkdown
+        && (markdownOpenMode === "web" || (markdownOpenMode === "obsidian_or_web" && !isObsidianPath));
+      const result = await openSmart(path, { preferEmbedded: forceWebEditor || isMarkdownForWebEditor });
+
+      if (result.action === "open_modal") {
+        if (result.editor_mode === "markdown") {
+          openMarkdownEditor(fileName, path, result.content || "");
+        } else {
+          openFileEditor(fileName, path, result.content || "", result.language ?? "plaintext");
+        }
+      } else if (result.action === "open_url" && result.url) {
+        window.open(result.url, "_blank", "noopener,noreferrer");
+      } else {
+        // 外部アプリで開いた
+        showSuccess(result.message);
+      }
+    } catch (e) {
+      showError(errorMessage(e) || "ファイルを開けませんでした");
+    }
+  };
+
+  return {
+    openPath,
+    openImage,
+    openFolderImages,
+    imagePreview: {
+      isOpen: previewImage !== null,
+      image: previewImage,
+      mode: imagePreviewMode,
+      navigate: setPreviewImage,
+      close: () => setPreviewImage(null),
+    },
+  };
+}
diff --git a/frontend/src/components/fileList/useFolderInsights.ts b/frontend/src/components/fileList/useFolderInsights.ts
new file mode 100644
index 0000000000000000000000000000000000000000..af484e29c14eb5d0f859500d01316cc1af1646e7
--- /dev/null
+++ b/frontend/src/components/fileList/useFolderInsights.ts
@@ -0,0 +1,136 @@
+/**
+ * フォルダの Git 状態（G キー）と最新更新日（D キー）
+ * - どちらも重い処理のため、利用者がキーを押したときだけ取得する（一覧表示のたびには走査しない）
+ * - Git: ペイン内の全フォルダの変更・ahead / behind を取得する。
+ *   Push / Pull 待ちのボタンは git コマンドをクリップボードにコピーし、それ以外は VS Code で開く
+ * - 最新更新日: 選択中のフォルダ1件、または（未選択なら）カーソル行のフォルダの配下を集計する。
+ *   打ち切られた（項目数上限・タイムアウト）場合は表示を更新しない
+ * - フォルダを移動したら結果を消す
+ */
+import { useEffect, useState } from "react";
+import { getFolderGitStatuses, getFolderLatestModified, openInVSCode } from "../../api/files";
+import type { FileItem } from "../../types/file";
+import { buildGitSyncCommand } from "../../utils/gitCommands";
+import { getGitSyncAction, type FolderGitStatus } from "../../utils/gitStatusDisplay";
+import { errorMessage } from "../../utils/errorMessage";
+
+interface FolderInsightsOptions {
+  currentPath: string | null;
+  /** 絞り込み前のフォルダ内の全項目（Git 状態はフィルタに関係なく全フォルダを調べる） */
+  allItems: FileItem[];
+  selectedItems: Set<string>;
+  showSuccess: (message: string) => void;
+  showError: (message: string) => void;
+}
+
+export function useFolderInsights({
+  currentPath,
+  allItems,
+  selectedItems,
+  showSuccess,
+  showError,
+}: FolderInsightsOptions) {
+  const [folderLatestModified, setFolderLatestModified] = useState<Record<string, string>>({});
+  const [folderLatestModifiedLoading, setFolderLatestModifiedLoading] = useState<Set<string>>(new Set());
+  const [gitStatuses, setGitStatuses] = useState<Record<string, FolderGitStatus>>({});
+  const [isGitStatusLoading, setIsGitStatusLoading] = useState(false);
+
+  useEffect(() => {
+    setFolderLatestModified({});
+    setFolderLatestModifiedLoading(new Set());
+    setGitStatuses({});
+    setIsGitStatusLoading(false);
+  }, [currentPath]);
+
+  /** visibleItems / focusedIndex: 表示中の項目とカーソル位置（集計結果は並べ替えに使うため、呼び出し時に受け取る） */
+  const calculateFolderLatestModified = async (visibleItems: FileItem[], focusedIndex: number) => {
+    const selectedFolders = visibleItems.filter(
+      (item) => item.type === "directory" && selectedItems.has(item.path)
+    );
+    const focusedItem = visibleItems[focusedIndex];
+    const target = selectedFolders.length === 1
+      ? selectedFolders[0]
+      : selectedFolders.length === 0 && selectedItems.size === 0 && focusedItem?.type === "directory"
+        ? focusedItem
+        : null;
+
+    if (!target) {
+      showError("フォルダを1件選択するか、フォルダ行にカーソルを置いてください");
+      return;
+    }
+    if (folderLatestModifiedLoading.has(target.path)) return;
+
+    setFolderLatestModifiedLoading((previous) => new Set(previous).add(target.path));
+    try {
+      const result = await getFolderLatestModified(target.path);
+      if (result.truncated) {
+        showError(`「${target.name}」は項目数上限またはタイムアウトのため、Dateを更新しませんでした`);
+        return;
+      }
+      setFolderLatestModified((previous) => ({ ...previous, [target.path]: result.modified }));
+      showSuccess(`「${target.name}」の最新更新日を取得しました`);
+    } catch (err) {
+      showError(`最新更新日の取得に失敗しました: ${errorMessage(err)}`);
+    } finally {
+      setFolderLatestModifiedLoading((previous) => {
+        const next = new Set(previous);
+        next.delete(target.path);
+        return next;
+      });
+    }
+  };
+
+  const checkGitStatuses = async () => {
+    const folderPaths = allItems.filter((item) => item.type === "directory").map((item) => item.path);
+    if (folderPaths.length === 0 || isGitStatusLoading) return;
+
+    setIsGitStatusLoading(true);
+    try {
+      const statuses = await getFolderGitStatuses(folderPaths);
+      setGitStatuses(Object.fromEntries(
+        statuses.map((item) => [item.path, {
+          changedFiles: item.changed_files,
+          hasMoreChanges: item.has_more_changes,
+          aheadCount: item.ahead_count,
+          behindCount: item.behind_count,
+        }])
+      ));
+    } catch (err) {
+      showError(`Git状態の取得に失敗しました: ${errorMessage(err)}`);
+    } finally {
+      setIsGitStatusLoading(false);
+    }
+  };
+
+  const openGitFolderInVSCode = async (item: FileItem) => {
+    try {
+      await openInVSCode(item.path);
+    } catch (err) {
+      showError(`VS Code起動エラー: ${errorMessage(err)}`);
+    }
+  };
+
+  const handleGitStatusAction = async (item: FileItem) => {
+    const action = getGitSyncAction(gitStatuses[item.path]);
+    if (!action) {
+      await openGitFolderInVSCode(item);
+      return;
+    }
+    try {
+      await navigator.clipboard.writeText(buildGitSyncCommand(item.path, action));
+      showSuccess(`git ${action === "sync" ? "pull --rebase && git push" : action} コマンドをコピーしました`);
+    } catch {
+      showError("Gitコマンドのコピーに失敗しました");
+    }
+  };
+
+  return {
+    folderLatestModified,
+    folderLatestModifiedLoading,
+    gitStatuses,
+    isGitStatusLoading,
+    calculateFolderLatestModified,
+    checkGitStatuses,
+    handleGitStatusAction,
+  };
+}
diff --git a/frontend/src/components/fileList/useSectionFocus.ts b/frontend/src/components/fileList/useSectionFocus.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0a311068fa7a0394260d05f76410545f946ce2da
--- /dev/null
+++ b/frontend/src/components/fileList/useSectionFocus.ts
@@ -0,0 +1,211 @@
+/**
+ * ファイル一覧ペイン内のセクション間キーボード移動
+ * - セクション: ツールバー → パス → フィルタ → 履歴検索 → 検索 → 一覧（↑↓で移動）
+ * - ツールバー・パス・フィルタでは ←→ でボタンを選び、Enter で実行する
+ *   （左端で ← を押したときはペイン切り替えに任せるため何もしない）
+ * - パスのボタンは「フルパスをコピー」「リンクをコピー」「パス入力欄」の順。
+ *   ハイライトしたボタンと Enter で実行する内容を一致させる
+ * - 選んでいるボタンには keyboard-focused クラスを付ける
+ * - 一覧セクションのキー操作は FileList 側で処理する
+ */
+import { useEffect, useState, type KeyboardEvent, type RefObject } from "react";
+
+export type FocusSection = "toolbar" | "path" | "filter" | "history" | "search" | "list";
+
+const TOOLBAR_BUTTONS = ".icon-toolbar button";
+const FILTER_BUTTONS = ".filter-bar .filter-btn";
+// パスセクションの要素（この順に ←→ で移動する）
+const PATH_ELEMENTS = [
+  '.path-input-container button[title="フルパスをコピー"]',
+  '.path-input-container button[title="リンクをコピー"]',
+  ".path-input-container .path-input",
+];
+const PATH_INPUT_INDEX = PATH_ELEMENTS.length - 1;
+
+interface SectionFocusOptions {
+  containerRef: RefObject<HTMLDivElement | null>;
+  pathInputRef: RefObject<HTMLTextAreaElement | null>;
+  historyInputRef: RefObject<HTMLInputElement | null>;
+  searchInputRef: RefObject<HTMLInputElement | null>;
+  onCopyPath: () => void;
+  onCopyLink: () => void;
+  /** 検索から一覧へ移ったとき（カーソルを先頭に戻す） */
+  onEnterList: () => void;
+}
+
+/** 選んでいる要素に keyboard-focused クラスを付ける */
+function useKeyboardFocusClass(
+  containerRef: RefObject<HTMLDivElement | null>,
+  active: boolean,
+  findElements: (container: HTMLElement) => Element[],
+  index: number
+) {
+  useEffect(() => {
+    if (!active || !containerRef.current) return;
+    const elements = findElements(containerRef.current);
+    elements[index]?.classList.add("keyboard-focused");
+    return () => {
+      elements.forEach((el) => el.classList.remove("keyboard-focused"));
+    };
+  }, [containerRef, active, findElements, index]);
+}
+
+const findToolbarButtons = (container: HTMLElement) => Array.from(container.querySelectorAll(TOOLBAR_BUTTONS));
+const findFilterButtons = (container: HTMLElement) => Array.from(container.querySelectorAll(FILTER_BUTTONS));
+const findPathElements = (container: HTMLElement) =>
+  PATH_ELEMENTS.map((selector) => container.querySelector(selector)).filter((el): el is Element => el !== null);
+
+export function useSectionFocus({
+  containerRef,
+  pathInputRef,
+  historyInputRef,
+  searchInputRef,
+  onCopyPath,
+  onCopyLink,
+  onEnterList,
+}: SectionFocusOptions) {
+  const [focusedSection, setFocusedSection] = useState<FocusSection>("list");
+  const [toolbarButtonIndex, setToolbarButtonIndex] = useState(0);
+  const [filterButtonIndex, setFilterButtonIndex] = useState(0);
+  const [pathButtonIndex, setPathButtonIndex] = useState(0);
+
+  useKeyboardFocusClass(containerRef, focusedSection === "toolbar", findToolbarButtons, toolbarButtonIndex);
+  useKeyboardFocusClass(containerRef, focusedSection === "filter", findFilterButtons, filterButtonIndex);
+  useKeyboardFocusClass(containerRef, focusedSection === "path", findPathElements, pathButtonIndex);
+
+  const clickNth = (selector: string, index: number) => {
+    const buttons = containerRef.current?.querySelectorAll<HTMLButtonElement>(selector);
+    buttons?.[index]?.click();
+  };
+  const lastIndexOf = (selector: string) =>
+    Math.max(0, (containerRef.current?.querySelectorAll(selector).length ?? 1) - 1);
+
+  /**
+   * ツールバー・パス・フィルタ・履歴検索・検索セクションでのキー操作
+   * 処理した（以降のショートカット処理を行わない）場合は true を返す
+   */
+  const handleSectionKeyDown = (e: KeyboardEvent): boolean => {
+    const consume = () => {
+      e.preventDefault();
+      e.stopPropagation();
+    };
+
+    // ←→ でセクション内のボタンを選ぶ（左端の ← はペイン切り替えに任せる）
+    const moveWithin = (index: number, lastIndex: number, setIndex: (index: number) => void): boolean => {
+      if (e.key === "ArrowLeft") {
+        if (index === 0) return true;
+        consume();
+        setIndex(index - 1);
+        return true;
+      }
+      if (e.key === "ArrowRight") {
+        consume();
+        if (index < lastIndex) setIndex(index + 1);
+        return true;
+      }
+      return false;
+    };
+
+    switch (focusedSection) {
+      case "toolbar":
+        if (moveWithin(toolbarButtonIndex, lastIndexOf(TOOLBAR_BUTTONS), setToolbarButtonIndex)) return true;
+        if (e.key === "ArrowDown") {
+          consume();
+          setFocusedSection("path");
+          setPathButtonIndex(0);
+          return true;
+        }
+        if (e.key === "Enter") {
+          consume();
+          clickNth(TOOLBAR_BUTTONS, toolbarButtonIndex);
+          return true;
+        }
+        return false;
+
+      case "path":
+        if (moveWithin(pathButtonIndex, PATH_INPUT_INDEX, setPathButtonIndex)) return true;
+        if (e.key === "ArrowUp") {
+          consume();
+          setFocusedSection("toolbar");
+          return true;
+        }
+        if (e.key === "ArrowDown") {
+          consume();
+          setFocusedSection("filter");
+          return true;
+        }
+        if (e.key === "Enter") {
+          consume();
+          if (pathButtonIndex === 0) onCopyPath();
+          else if (pathButtonIndex === 1) onCopyLink();
+          else pathInputRef.current?.focus();
+          return true;
+        }
+        return false;
+
+      case "filter":
+        if (moveWithin(filterButtonIndex, lastIndexOf(FILTER_BUTTONS), setFilterButtonIndex)) return true;
+        if (e.key === "ArrowUp") {
+          consume();
+          setFocusedSection("path");
+          setPathButtonIndex(0);
+          return true;
+        }
+        if (e.key === "ArrowDown") {
+          consume();
+          setFocusedSection("history");
+          historyInputRef.current?.focus();
+          return true;
+        }
+        if (e.key === "Enter") {
+          consume();
+          clickNth(FILTER_BUTTONS, filterButtonIndex);
+          return true;
+        }
+        return false;
+
+      case "history":
+        if (e.key === "ArrowUp") {
+          consume();
+          setFocusedSection("filter");
+          return true;
+        }
+        if (e.key === "ArrowDown") {
+          consume();
+          setFocusedSection("search");
+          searchInputRef.current?.focus();
+          return true;
+        }
+        return false;
+
+      case "search":
+        if (e.key === "ArrowUp") {
+          consume();
+          setFocusedSection("history");
+          historyInputRef.current?.focus();
+          return true;
+        }
+        if (e.key === "ArrowDown") {
+          consume();
+          setFocusedSection("list");
+          onEnterList();
+          return true;
+        }
+        return false;
+
+      case "list":
+        return false;
+    }
+  };
+
+  return {
+    focusedSection,
+    setFocusedSection,
+    toolbarButtonIndex,
+    pathButtonIndex,
+    setToolbarButtonIndex,
+    setFilterButtonIndex,
+    setPathButtonIndex,
+    handleSectionKeyDown,
+  };
+}
diff --git a/frontend/src/components/filterOptions.ts b/frontend/src/components/filterOptions.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a84cd763297aca1bc64a8b9dd68818c1d2a36c3f
