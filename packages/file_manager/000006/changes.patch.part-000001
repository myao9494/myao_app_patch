 from app.config import settings
 
diff --git a/backend/app/routers/viewer.py b/backend/app/routers/viewer.py
new file mode 100644
index 0000000000000000000000000000000000000000..3d30b99308af78bdfed8405e5902f63b69b9741c
--- /dev/null
+++ b/backend/app/routers/viewer.py
@@ -0,0 +1,320 @@
+"""
+ファイル配信・インライン表示 APIルーター
+- GET /api/download: ダウンロード
+- GET /api/view-pdf: PDF のインライン表示
+- GET /api/view-html: HTML のインラインプレビュー
+- GET /api/view-image: 画像のインライン表示（Obsidian Vault 内の画像・Excalidraw プレビューを自動解決）
+- GET /api/folder-images: フォルダ内画像一覧（階層指定、.git / node_modules を除外）
+"""
+import html
+import os
+import urllib.parse
+from datetime import datetime
+from pathlib import Path
+from typing import List, Optional
+
+from fastapi import APIRouter, HTTPException, Query
+from fastapi.responses import FileResponse, Response
+from pydantic import BaseModel
+
+from app.services.obsidian import (
+    find_file_in_vault,
+    find_obsidian_vault_root,
+    resolve_excalidraw_preview_image,
+)
+from app.services.paths import (
+    normalize_path,
+)
+
+router = APIRouter()
+
+
+class FolderImageItem(BaseModel):
+    """フォルダ内画像アイテムのスキーマ"""
+
+    name: str
+    type: str = "file"
+    path: str
+    size: Optional[int] = None
+    modified: Optional[str] = None
+    relativePath: str
+
+
+class FolderImagesResponse(BaseModel):
+    """フォルダ内画像一覧のレスポンススキーマ"""
+
+    path: str
+    depth: int
+    total: int
+    images: List[FolderImageItem]
+
+
+@router.get("/download")
+def download_file(path: str = Query(..., description="ダウンロードするファイルのパス")):
+    """
+    ファイルをダウンロード
+    """
+    target_path = normalize_path(path)
+    
+    if not target_path.exists():
+        raise HTTPException(status_code=404, detail="ファイルが見つかりません")
+    
+    if target_path.is_dir():
+         raise HTTPException(status_code=400, detail="ディレクトリはダウンロードできません（ZIP機能未実装）")
+
+    return FileResponse(
+        path=target_path,
+        filename=target_path.name,
+        media_type='application/octet-stream'
+    )
+
+
+@router.get("/view-pdf")
+def view_pdf(path: str = Query(..., description="表示するPDFファイルのパス")):
+    """
+    PDFファイルをブラウザ内で表示（ダウンロードではなくインライン表示）
+    """
+    target_path = normalize_path(path)
+
+    if not target_path.exists():
+        raise HTTPException(status_code=404, detail="ファイルが見つかりません")
+
+    if target_path.is_dir():
+        raise HTTPException(status_code=400, detail="ディレクトリは表示できません")
+
+    if not target_path.name.lower().endswith('.pdf'):
+        raise HTTPException(status_code=400, detail="PDFファイルではありません")
+
+    # 日本語ファイル名に対応するため、RFC 2231形式でエンコード
+    encoded_filename = urllib.parse.quote(target_path.name)
+
+    return FileResponse(
+        path=target_path,
+        filename=target_path.name,
+        media_type='application/pdf',
+        headers={"Content-Disposition": f"inline; filename*=UTF-8''{encoded_filename}"}
+    )
+
+
+@router.get("/view-html")
+def view_html(path: str = Query(..., description="表示するHTMLファイルのパス")):
+    """
+    HTMLファイルをブラウザ内で表示（ソースコードではなくレンダリングプレビュー表示）
+    """
+    target_path = normalize_path(path)
+
+    if not target_path.exists():
+        raise HTTPException(status_code=404, detail="ファイルが見つかりません")
+
+    if target_path.is_dir():
+        raise HTTPException(status_code=400, detail="ディレクトリは表示できません")
+
+    name_lower = target_path.name.lower()
+    if not (name_lower.endswith('.html') or name_lower.endswith('.htm')):
+        raise HTTPException(status_code=400, detail="HTMLファイルではありません")
+
+    # 日本語ファイル名に対応するため、RFC 2231形式でエンコード
+    encoded_filename = urllib.parse.quote(target_path.name)
+
+    return FileResponse(
+        path=target_path,
+        filename=target_path.name,
+        media_type='text/html; charset=utf-8',
+        headers={"Content-Disposition": f"inline; filename*=UTF-8''{encoded_filename}"}
+    )
+
+
+IMAGE_MEDIA_TYPES = {
+    ".png": "image/png",
+    ".jpg": "image/jpeg",
+    ".jpeg": "image/jpeg",
+    ".gif": "image/gif",
+    ".webp": "image/webp",
+    ".svg": "image/svg+xml",
+    ".bmp": "image/bmp",
+    ".ico": "image/x-icon",
+    ".avif": "image/avif",
+}
+
+
+@router.get("/view-image")
+def view_image(
+    path: str = Query(..., description="表示する画像ファイルのパス"),
+    baseDir: Optional[str] = Query(None, description="基準ディレクトリ（Obsidianノート等の親ディレクトリ）"),
+):
+    """
+    画像ファイルをブラウザ内でインライン表示
+    Obsidian Vault 内の画像パスや Excalidraw プレビューの自動解決に対応
+    """
+    raw_path_str = path.strip()
+    base_dir_path: Optional[Path] = None
+    vault_root: Optional[Path] = None
+
+    if baseDir:
+        try:
+            base_dir_path = normalize_path(baseDir)
+            if base_dir_path.exists():
+                vault_root = find_obsidian_vault_root(base_dir_path)
+        except Exception:
+            pass
+
+    # パスの正規化
+    target_path: Optional[Path] = None
+    try:
+        candidate = normalize_path(raw_path_str)
+        if candidate.exists():
+            target_path = candidate
+    except Exception:
+        pass
+
+    # 存在しない場合、baseDirからの相対パスやVaultルートからの相対パスを試行
+    if not target_path or not target_path.exists():
+        if base_dir_path and base_dir_path.is_dir():
+            candidate = base_dir_path / raw_path_str
+            if candidate.exists():
+                target_path = candidate
+
+        if (not target_path or not target_path.exists()) and vault_root and vault_root.is_dir():
+            candidate = vault_root / raw_path_str
+            if candidate.exists():
+                target_path = candidate
+
+    # .excalidraw ファイルで .excalidraw.md が存在する場合のフォールバック
+    if not target_path or not target_path.exists():
+        if raw_path_str.endswith(".excalidraw"):
+            try:
+                candidate = normalize_path(raw_path_str + ".md")
+                if candidate.exists():
+                    target_path = candidate
+            except Exception:
+                pass
+
+            if not target_path:
+                for base in [base_dir_path, vault_root]:
+                    if base and base.is_dir():
+                        candidate = base / (raw_path_str + ".md")
+                        if candidate.exists():
+                            target_path = candidate
+                            break
+
+    # ファイル名のみの指定で Vault 内を検索（ファイル名索引をキャッシュして高速化）
+    if (not target_path or not target_path.exists()) and vault_root and "/" not in raw_path_str and "\\" not in raw_path_str:
+        target_path = find_file_in_vault(vault_root, raw_path_str)
+        if not target_path and (raw_path_str.endswith(".excalidraw") or "." not in raw_path_str):
+            target_path = find_file_in_vault(vault_root, f"{raw_path_str}.md")
+
+    if not target_path or not target_path.exists():
+        raise HTTPException(status_code=404, detail="ファイルが見つかりません")
+
+    if target_path.is_dir():
+        raise HTTPException(status_code=400, detail="ディレクトリは表示できません")
+
+    # Excalidraw ファイル判定
+    is_excalidraw = (
+        target_path.name.lower().endswith(".excalidraw.md")
+        or target_path.name.lower().endswith(".excalidraw")
+    )
+    if is_excalidraw:
+        preview_image = resolve_excalidraw_preview_image(target_path, vault_root)
+        if preview_image and preview_image.is_file():
+            target_path = preview_image
+        else:
+            # キャッシュ画像がない場合、簡易SVGを動的生成して返す
+            title = html.escape(target_path.stem.replace(".excalidraw", ""))
+            svg_content = f'''<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
+  <rect width="100%" height="100%" fill="#1e1e1e" rx="12" stroke="#333" stroke-width="2"/>
+  <text x="50%" y="45%" fill="#66ff69" font-family="sans-serif" font-size="28" font-weight="bold" text-anchor="middle">🎨 Excalidraw Drawing</text>
+  <text x="50%" y="58%" fill="#d4d4d4" font-family="sans-serif" font-size="20" text-anchor="middle">{title}</text>
+  <text x="50%" y="70%" fill="#888" font-family="sans-serif" font-size="14" text-anchor="middle">（プレビューキャッシュ未生成 - タップしてExcalidrawで開く）</text>
+</svg>'''
+            return Response(content=svg_content, media_type="image/svg+xml")
+
+    ext = target_path.suffix.lower()
+    media_type = IMAGE_MEDIA_TYPES.get(ext)
+    if not media_type:
+        raise HTTPException(status_code=400, detail="画像ファイルではありません")
+
+    encoded_filename = urllib.parse.quote(target_path.name)
+    return FileResponse(
+        path=target_path,
+        filename=target_path.name,
+        media_type=media_type,
+        headers={
+            "Content-Disposition": f"inline; filename*=UTF-8''{encoded_filename}",
+            "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800",
+        }
+    )
+
+
+@router.get("/folder-images", response_model=FolderImagesResponse)
+def get_folder_images(
+    path: str = Query(..., description="画像一覧を取得するディレクトリのパス"),
+    depth: int = Query(0, ge=0, le=10, description="走査階層（0=直下のみ、1=1階層下まで...）"),
+    ignore: str = Query("", description="除外パターン（カンマ区切り）"),
+) -> FolderImagesResponse:
+    """
+    指定ディレクトリ配下の画像ファイル一覧を取得する（階層指定対応）
+    """
+    raw_path_str = path.strip()
+    try:
+        target_path = normalize_path(raw_path_str)
+    except Exception as e:
+        raise HTTPException(status_code=400, detail=str(e))
+
+    if not target_path.exists():
+        raise HTTPException(status_code=404, detail="ディレクトリが見つかりません")
+
+    if not target_path.is_dir():
+        raise HTTPException(status_code=400, detail="ディレクトリを指定してください")
+
+    default_ignores = {".git", ".svn", "__pycache__", ".DS_Store", "node_modules", ".venv", "venv", ".idea", ".vscode"}
+    custom_ignores = {p.strip() for p in ignore.split(",") if p.strip()}
+    ignore_set = default_ignores | custom_ignores
+
+    found_images: List[FolderImageItem] = []
+    base_path_str = str(target_path)
+
+    def scan_dir(current_dir: Path, current_depth: int) -> None:
+        try:
+            with os.scandir(current_dir) as entries:
+                sub_dirs: List[Path] = []
+                for entry in entries:
+                    try:
+                        if entry.name in ignore_set or (entry.name.startswith(".") and entry.is_dir(follow_symlinks=False)):
+                            continue
+
+                        if entry.is_file(follow_symlinks=False):
+                            ext = os.path.splitext(entry.name)[1].lower()
+                            if ext in IMAGE_MEDIA_TYPES:
+                                stat = entry.stat()
+                                mtime_str = datetime.fromtimestamp(stat.st_mtime).strftime("%Y-%m-%d %H:%M:%S")
+                                rel_path = os.path.relpath(entry.path, base_path_str)
+                                found_images.append(
+                                    FolderImageItem(
+                                        name=entry.name,
+                                        type="file",
+                                        path=entry.path,
+                                        size=stat.st_size,
+                                        modified=mtime_str,
+                                        relativePath=rel_path,
+                                    )
+                                )
+                        elif entry.is_dir(follow_symlinks=False) and current_depth < depth:
+                            sub_dirs.append(Path(entry.path))
+                    except (PermissionError, OSError):
+                        continue
+
+                for sd in sorted(sub_dirs, key=lambda p: p.name.lower()):
+                    scan_dir(sd, current_depth + 1)
+        except (PermissionError, OSError):
+            pass
+
+    scan_dir(target_path, 0)
+    found_images.sort(key=lambda img: (img.relativePath.lower(), img.name.lower()))
+
+    return FolderImagesResponse(
+        path=str(target_path),
+        depth=depth,
+        total=len(found_images),
+        images=found_images,
+    )
diff --git a/backend/app/schemas.py b/backend/app/schemas.py
new file mode 100644
index 0000000000000000000000000000000000000000..ab7f095dbce3a3182920f4a5fd1cf1c0b928b2ff
--- /dev/null
+++ b/backend/app/schemas.py
@@ -0,0 +1,21 @@
+"""
+複数のルーターで共有するリクエスト/レスポンスのスキーマ
+"""
+from typing import Optional
+
+from pydantic import BaseModel
+
+
+class FileItem(BaseModel):
+    """ファイル/フォルダアイテムのスキーマ"""
+
+    name: str
+    type: str  # "file" or "directory"
+    path: str
+    size: Optional[int] = None
+    modified: Optional[str] = None
+
+
+class OpenRequest(BaseModel):
+    path: str
+    prefer_embedded: bool = False
diff --git a/backend/app/security.py b/backend/app/security.py
new file mode 100644
index 0000000000000000000000000000000000000000..81e00e80bb5f85dff4f953198654c78147902585
--- /dev/null
+++ b/backend/app/security.py
@@ -0,0 +1,158 @@
+"""
+ブラウザ経由の攻撃を防ぐためのリクエスト検証（ASGIミドルウェア）
+
+本アプリはファイル操作・プログラム実行・ターミナルを提供するため、
+利用者がブラウザで開いた別のWebサイトから操作されないようにする。
+
+1. Origin 検証（CSRF / WebSocket ハイジャック対策）
+   - 書き込み系メソッド（POST/PUT/PATCH/DELETE）とターミナル等の WebSocket が対象
+   - Origin ヘッダーが付いている場合、次のいずれかでなければ 403（WebSocketは1008で切断）
+       - 同一オリジン（Origin のホスト:ポート == Host ヘッダー）
+       - localhost / 127.0.0.1 / [::1]（任意のポート。Vite開発サーバー等）
+       - 環境変数 FILE_MANAGER_ALLOWED_ORIGINS（カンマ区切り）に列挙したオリジン
+   - Origin ヘッダーがないリクエスト（curl・スクリプト等、ブラウザ以外）は従来どおり許可
+
+2. Host 検証（DNSリバインディング対策）
+   - すべてのリクエストが対象。Host ヘッダーが次のいずれかでなければ 403
+       - localhost、IPアドレス（LAN・Tailscale IP を含む）
+       - *.ts.net（Tailscale MagicDNS）
+       - このPCのホスト名（hostname / FQDN / hostname.local）
+       - 環境変数 FILE_MANAGER_ALLOWED_HOSTS（カンマ区切り、"*" で検証無効）
+
+外部ツールからの GET /api/fullpath 等のリンク遷移は Origin 検証の対象外のため影響しない。
+"""
+from __future__ import annotations
+
+import ipaddress
+import json
+import re
+import socket
+from functools import lru_cache
+from urllib.parse import urlsplit
+
+from app import config
+
+UNSAFE_METHODS = frozenset({"POST", "PUT", "PATCH", "DELETE"})
+LOCALHOST_ORIGIN_REGEX = r"^https?://(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$"
+_LOCALHOST_ORIGIN_RE = re.compile(LOCALHOST_ORIGIN_REGEX, re.IGNORECASE)
+_TEST_HOSTS = frozenset({"testserver"})  # Starlette TestClient
+
+
+def _split_csv(value: str) -> list[str]:
+    return [item.strip() for item in (value or "").split(",") if item.strip()]
+
+
+def configured_origins() -> list[str]:
+    """環境変数 FILE_MANAGER_ALLOWED_ORIGINS で許可されたオリジン（末尾スラッシュなし）"""
+    return [origin.rstrip("/") for origin in _split_csv(config.settings.allowed_origins)]
+
+
+@lru_cache(maxsize=1)
+def _machine_host_names() -> set[str]:
+    names: set[str] = set()
+    try:
+        hostname = socket.gethostname()
+        if hostname:
+            names.update({hostname, f"{hostname}.local"})
+        fqdn = socket.getfqdn()
+        if fqdn:
+            names.add(fqdn)
+    except OSError:
+        pass
+    return {name.lower() for name in names}
+
+
+def _strip_port(host: str) -> str:
+    host = host.strip().lower()
+    if host.startswith("["):  # [::1]:8001
+        return host[1:].split("]", 1)[0]
+    if host.count(":") == 1:
+        return host.rsplit(":", 1)[0]
+    return host
+
+
+def is_host_allowed(host_header: str | None) -> bool:
+    """Host ヘッダーが許可されたホスト名か（DNSリバインディング対策）"""
+    allowed = [h.lower() for h in _split_csv(config.settings.allowed_hosts)]
+    if "*" in allowed:
+        return True
+    if not host_header:
+        return True  # HTTP/1.0 等。ブラウザは必ず Host を送るため攻撃経路にならない
+    host = _strip_port(host_header)
+    if host in ("localhost", *_TEST_HOSTS) or host.endswith(".localhost"):
+        return True
+    try:
+        ipaddress.ip_address(host)
+        return True
+    except ValueError:
+        pass
+    if host.endswith(".ts.net"):
+        return True
+    return host in _machine_host_names() or host in allowed
+
+
+def is_origin_allowed(origin: str, host_header: str | None) -> bool:
+    """Origin が同一オリジン・localhost・設定済みのいずれかか"""
+    if not origin or origin == "null":
+        return False
+    if _LOCALHOST_ORIGIN_RE.match(origin):
+        return True
+    if origin.rstrip("/") in configured_origins():
+        return True
+    netloc = urlsplit(origin).netloc.lower()
+    return bool(host_header) and netloc == host_header.strip().lower()
+
+
+def cors_origin_regex() -> str:
+    """CORS で許可するオリジンの正規表現（localhost + 設定済みオリジン）"""
+    patterns = [LOCALHOST_ORIGIN_REGEX[1:-1]] + [re.escape(o) for o in configured_origins()]
+    return "^(" + "|".join(patterns) + ")$"
+
+
+class OriginGuardMiddleware:
+    """Host / Origin を検証する ASGI ミドルウェア"""
+
+    def __init__(self, app):
+        self.app = app
+
+    async def __call__(self, scope, receive, send):
+        if scope["type"] not in ("http", "websocket"):
+            await self.app(scope, receive, send)
+            return
+
+        headers = {k.decode("latin-1").lower(): v.decode("latin-1") for k, v in scope.get("headers", [])}
+        host = headers.get("host")
+
+        if not is_host_allowed(host):
+            await self._reject(
+                scope, receive, send,
+                f"ホスト名 {host} からのアクセスは許可されていません。"
+                "backend/.env の FILE_MANAGER_ALLOWED_HOSTS に追加してください。",
+            )
+            return
+
+        needs_origin_check = scope["type"] == "websocket" or scope.get("method", "GET").upper() in UNSAFE_METHODS
+        origin = headers.get("origin")
+        if needs_origin_check and origin is not None and not is_origin_allowed(origin, host):
+            await self._reject(
+                scope, receive, send,
+                f"オリジン {origin} からの操作は許可されていません。"
+                "必要な場合は backend/.env の FILE_MANAGER_ALLOWED_ORIGINS に追加してください。",
+            )
+            return
+
+        await self.app(scope, receive, send)
+
+    @staticmethod
+    async def _reject(scope, receive, send, detail: str) -> None:
+        if scope["type"] == "websocket":
+            await receive()  # websocket.connect
+            await send({"type": "websocket.close", "code": 1008, "reason": "origin not allowed"})
+            return
+        body = json.dumps({"detail": detail}, ensure_ascii=False).encode("utf-8")
+        await send({
+            "type": "http.response.start",
+            "status": 403,
+            "headers": [(b"content-type", b"application/json; charset=utf-8"), (b"content-length", str(len(body)).encode())],
+        })
+        await send({"type": "http.response.body", "body": body})
diff --git a/backend/app/services/__init__.py b/backend/app/services/__init__.py
new file mode 100644
index 0000000000000000000000000000000000000000..15ee8ec6f1a2f9b2ceea5d6ecd7196bf74079b13
--- /dev/null
+++ b/backend/app/services/__init__.py
@@ -0,0 +1,8 @@
+"""
+バックエンドのドメインロジック（ルーターから呼び出される処理本体）
+- paths: パスの正規化・パス置換・スレッドプール実行
+- trash: ゴミ箱移動・ネットワークドライブ判定・ロック検出
+- deletion: 削除処理（ゴミ箱優先、勝手に完全削除しない）
+- transfer: 移動・コピー処理（検証済みのものだけ移動元を削除）
+- fileio: 安全な書き込み（アトミック書き込み・重複しない名前の生成）
+"""
diff --git a/backend/app/services/deletion.py b/backend/app/services/deletion.py
new file mode 100644
index 0000000000000000000000000000000000000000..f881a49fbfc64ec1fcf4230bce428c3e98696cc0
--- /dev/null
+++ b/backend/app/services/deletion.py
@@ -0,0 +1,133 @@
+"""
+削除処理（同期・非同期共通の実装）
+
+安全のための原則（ファイルが勝手に消えないこと）:
+- ローカルの項目は「ゴミ箱へ移動」のみ。フォルダは中身ごと1回で移動するため、
+  ゴミ箱から階層を保ったまま元に戻せる。
+- ゴミ箱への移動に失敗した場合はエラーを返すだけで、完全削除へは絶対にフォールバックしない。
+  Windowsでロックされている場合はロック中のプロセス一覧（locked_by）を返す。
+- 完全削除するのは、ゴミ箱が使えない本当のネットワークドライブ上で
+  利用者が削除を指示した項目だけ（is_network_path で判定）。
+- force_kill_pids は利用者がダイアログで同意したプロセスのみ終了してから削除する。
+
+結果は項目単位で返す:
+    {"status": "completed", "success_count", "fail_count",
+     "results": [{"path", "status": "success"|"error", "message", "locked_by"?}]}
+"""
+from __future__ import annotations
+
+import os
+import threading
+import time
+from pathlib import Path
+from typing import Optional
+
+from app.config import settings
+from app.services import trash
+from app.services.paths import normalize_path
+from app.task_manager import task_manager
+
+TRASHED_MESSAGE = "ゴミ箱に移動しました"
+NETWORK_DELETED_MESSAGE = "削除しました（ネットワークドライブのためゴミ箱には入りません）"
+
+
+def delete_one(
+    path: Path,
+    force_kill_pids: Optional[list[int]] = None,
+    task_id: Optional[str] = None,
+    debug_mode: bool = False,
+) -> dict:
+    """1項目を削除し、{"status", "message", "locked_by"?} を返す（例外は送出しない）。"""
+    def log(msg: str) -> None:
+        if debug_mode:
+            print(f"[DELETE] {msg}")
+
+    if not os.path.lexists(path):
+        return {"status": "error", "message": "ファイルが見つかりません"}
+
+    try:
+        if trash.is_network_path(path):
+            log(f"ネットワークドライブ上の項目を削除: {path}")
+            trash.delete_permanently(
+                path,
+                on_progress=(lambda name: task_manager.set_current_file(task_id, name)) if task_id else None,
+                is_cancelled=(lambda: task_manager.is_cancelled(task_id)) if task_id else None,
+            )
+            return {"status": "success", "message": NETWORK_DELETED_MESSAGE}
+
+        if force_kill_pids:
+            log(f"同意済みプロセスを終了: {force_kill_pids}")
+            trash.kill_processes(force_kill_pids)
+            time.sleep(0.5)  # プロセス終了を少し待つ
+
+        log(f"ゴミ箱へ移動: {path}")
+        trash.trash_with_retry(path)
+        return {"status": "success", "message": TRASHED_MESSAGE}
+    except InterruptedError as e:
+        return {"status": "error", "message": str(e)}
+    except Exception as e:
+        log(f"削除エラー: {e}")
+        result: dict = {"status": "error", "message": str(e) or e.__class__.__name__}
+        if settings.is_windows and isinstance(e, OSError):
+            locked_by = trash.get_locking_processes(str(path))
+            if locked_by:
+                result["locked_by"] = locked_by
+        return result
+
+
+def delete_items(
+    paths: list[str],
+    force_kill_pids: Optional[list[int]] = None,
+    task_id: Optional[str] = None,
+    debug_mode: bool = False,
+) -> dict:
+    """複数項目を順に削除し、項目ごとの結果を返す。"""
+    results: list[dict] = []
+    if task_id:
+        task_manager.set_total(task_id, len(paths))
+
+    for index, path_str in enumerate(paths):
+        if task_id and task_manager.is_cancelled(task_id):
+            results.append({"path": path_str, "status": "error", "message": "キャンセルされました"})
+            continue
+        try:
+            target = normalize_path(path_str)
+        except Exception as e:
+            results.append({"path": path_str, "status": "error", "message": f"パスの正規化に失敗: {e}"})
+            continue
+        if task_id:
+            task_manager.update_progress(task_id, processed_files=index, current_file=target.name)
+        outcome = delete_one(target, force_kill_pids, task_id, debug_mode)
+        results.append({"path": path_str, **outcome})
+
+    if task_id:
+        task_manager.set_total(task_id, len(paths))
+        task_manager.update_progress(task_id, processed_files=len(paths), current_file="")
+
+    return {
+        "status": "completed",
+        "success_count": sum(1 for r in results if r["status"] == "success"),
+        "fail_count": sum(1 for r in results if r["status"] == "error"),
+        "results": results,
+    }
+
+
+def run_delete_task(task_id: str, paths: list[str], debug_mode: bool) -> None:
+    """バックグラウンドスレッドで delete_items を実行し、結果をタスクへ保存する。"""
+    task_manager.set_running(task_id)
+    try:
+        task_manager.complete_task(task_id, result=delete_items(paths, None, task_id, debug_mode))
+    except Exception as e:  # 想定外の例外でもタスクを「実行中」のまま放置しない
+        task_manager.fail_task(task_id, str(e))
+
+
+def start_delete_task(paths: list[str], debug_mode: bool) -> str:
+    """非同期の削除を開始してタスクIDを返す。"""
+    task = task_manager.create_task(total_files=len(paths))
+    threading.Thread(
+        target=run_delete_task,
+        args=(task.id, paths, debug_mode),
+        daemon=True,
+        name=f"delete-{task.id[:8]}",
+    ).start()
+    return task.id
diff --git a/backend/app/services/fileio.py b/backend/app/services/fileio.py
new file mode 100644
index 0000000000000000000000000000000000000000..96dcdce27f5ce1206c9f4f64f1d7ea499231623b
--- /dev/null
+++ b/backend/app/services/fileio.py
@@ -0,0 +1,96 @@
+"""
+安全なファイル書き込みユーティリティ
+
+- atomic_write_text: 同じフォルダの一時ファイルに書いてから置き換える。
+  書き込み途中で失敗しても元ファイルが空になったり壊れたりしない。
+    - シンボリックリンクはリンク先の実ファイルを更新する（リンク自体は壊さない）
+    - 元ファイルのパーミッションを引き継ぐ
+    - Windowsで他プロセスが開いていて置き換えできない場合のみ、直接上書きにフォールバックする
+- unique_child_path: 既存ファイルを上書きしないよう「name (1).ext」形式の空き名を返す
+- validate_entry_name: 新規作成・リネーム時のファイル名を検証する（区切り文字や `..` を拒否）
+"""
+from __future__ import annotations
+
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+INVALID_NAME_CHARS = ("/", "\\", "\0")
+
+
+def _read_umask() -> int:
+    # 起動時（シングルスレッド）に一度だけ読み取る
+    current = os.umask(0)
+    os.umask(current)
+    return current
+
+
+# 新規ファイルを作るときの既定パーミッション（通常の open() と同じ 0o666 & ~umask）
+DEFAULT_NEW_FILE_MODE = 0o666 & ~_read_umask()
+
+
+class InvalidNameError(ValueError):
+    """ファイル名として使えない文字列"""
+
+
+def validate_entry_name(name: str) -> str:
+    """ファイル/フォルダ名を検証し、そのまま返す。不正なら InvalidNameError。"""
+    if not name or not name.strip():
+        raise InvalidNameError("名前が空です")
+    if name in (".", ".."):
+        raise InvalidNameError("この名前は使用できません")
+    if any(ch in name for ch in INVALID_NAME_CHARS):
+        raise InvalidNameError("名前に / や \\ は使用できません")
+    return name
+
+
+def atomic_write_text(path: Path, content: str, encoding: str = "utf-8") -> None:
+    """テキストを安全に書き込む（途中失敗で元ファイルを壊さない）。"""
+    target = Path(os.path.realpath(path)) if path.is_symlink() else path
+    directory = target.parent
+
+    original_mode = None
+    try:
+        original_mode = target.stat().st_mode
+    except FileNotFoundError:
+        pass
+
+    fd, tmp_name = tempfile.mkstemp(prefix=f".{target.name}.", suffix=".tmp", dir=directory)
+    tmp_path = Path(tmp_name)
+    try:
+        # newline=None（既定）でOS標準の改行に変換する従来の挙動を維持する
+        with os.fdopen(fd, "w", encoding=encoding) as f:
+            f.write(content)
+            f.flush()
+            os.fsync(f.fileno())
+        try:
+            os.chmod(tmp_path, (original_mode & 0o7777) if original_mode is not None else DEFAULT_NEW_FILE_MODE)
+        except OSError:
+            pass
+        try:
+            os.replace(tmp_path, target)
+        except PermissionError:
+            # Windows: 他アプリが開いていると置き換えできないため、内容を直接書き戻す。
+            # 一時ファイルに完全な内容があるので、コピー成功後に削除する。
+            shutil.copyfile(tmp_path, target)
+            tmp_path.unlink(missing_ok=True)
+    except BaseException:
+        tmp_path.unlink(missing_ok=True)
+        raise
+
+
+def unique_child_path(directory: Path, name: str) -> Path:
+    """directory/name が既に存在する場合、「stem (1).ext」「stem (2).ext」… の空き名を返す。"""
+    candidate = directory / name
+    if not os.path.lexists(candidate):
+        return candidate
+    stem, suffix = os.path.splitext(name)
+    if not stem:  # ".env" のような名前
+        stem, suffix = name, ""
+    counter = 1
+    while True:
+        candidate = directory / f"{stem} ({counter}){suffix}"
+        if not os.path.lexists(candidate):
+            return candidate
+        counter += 1
diff --git a/backend/app/services/obsidian.py b/backend/app/services/obsidian.py
new file mode 100644
index 0000000000000000000000000000000000000000..c212381f519eb9cf24d4293b35f2fae1af4b8222
--- /dev/null
+++ b/backend/app/services/obsidian.py
@@ -0,0 +1,178 @@
+"""
+Obsidian Vault 関連の処理
+
+- find_obsidian_vault_root: パスから上位を遡り `.obsidian` を持つ Vault ルートを探す
+  （見つからなければ設定の Obsidian ベースディレクトリから探す）
+- find_file_in_vault: ファイル名だけの指定（`![[image.png]]`）から Vault 内のファイルを探す
+    - Vault ごとにファイル名索引をキャッシュし、画像ごとに Vault 全体を走査しない
+    - 見つからない場合や索引のファイルが消えている場合は、索引を作り直して再検索する
+    - ファイル名はそのまま比較する（`[` や `*` を glob として解釈しない）
+- get_string_hash: Obsidian Excalidraw Cards プラグイン互換の FNV-1a ハッシュ
+- resolve_excalidraw_preview_image: Excalidraw 図面のプレビュー画像（.excalidraw-cache 等）を探す
+"""
+from __future__ import annotations
+
+import json
+import os
+import threading
+import time
+from pathlib import Path
+from typing import Optional
+
+from app.config import settings
+
+# 索引を作るときに辿らないフォルダ
+VAULT_INDEX_SKIP_DIRS = frozenset({".git", "node_modules"})
+# 見つからなかったときに索引を作り直すまでの最短間隔（貼り付け直後の画像に対応しつつ連続走査を防ぐ）
+VAULT_INDEX_MIN_REBUILD_SECONDS = 5.0
+# この時間が経った索引は使う前に作り直す
+VAULT_INDEX_MAX_AGE_SECONDS = 300.0
+
+
+class _VaultIndex:
+    def __init__(self, root: Path):
+        self.root = root
+        self.built_at = 0.0
+        self.by_name: dict[str, list[Path]] = {}
+        self.lock = threading.Lock()
+
+    def _build(self) -> None:
+        by_name: dict[str, list[Path]] = {}
+        for current, dirs, files in os.walk(self.root):
+            dirs[:] = [d for d in dirs if d not in VAULT_INDEX_SKIP_DIRS]
+            for name in files:
+                by_name.setdefault(name, []).append(Path(current) / name)
+        self.by_name = by_name
+        self.built_at = time.monotonic()
+
+    def find(self, name: str) -> Optional[Path]:
+        with self.lock:
+            now = time.monotonic()
+            if not self.built_at or now - self.built_at > VAULT_INDEX_MAX_AGE_SECONDS:
+                self._build()
+            found = self._lookup(name)
+            if found is None and now - self.built_at >= VAULT_INDEX_MIN_REBUILD_SECONDS:
+                self._build()
+                found = self._lookup(name)
+            return found
+
+    def _lookup(self, name: str) -> Optional[Path]:
+        candidates = self.by_name.get(name, [])
+        existing = [p for p in candidates if p.is_file()]
+        if len(existing) != len(candidates):
+            # 削除・移動されたファイルが索引に残っている
+            self.by_name[name] = existing
+        if not existing:
+            return None
+        # 同名ファイルが複数ある場合は Vault ルートに近いものを優先する
+        return min(existing, key=lambda p: (len(p.parts), str(p)))
+
+
+_indexes_lock = threading.Lock()
+_indexes: dict[str, _VaultIndex] = {}
+
+
+def find_file_in_vault(vault_root: Path, name: str) -> Optional[Path]:
+    """Vault 内でファイル名が一致するファイルを探す（キャッシュ付き）"""
+    key = os.path.normcase(str(vault_root))
+    with _indexes_lock:
+        index = _indexes.get(key)
+        if index is None:
+            index = _indexes[key] = _VaultIndex(vault_root)
+    return index.find(name)
+
+
+def clear_vault_indexes() -> None:
+    """ファイル名索引のキャッシュを破棄する（テスト用）"""
+    with _indexes_lock:
+        _indexes.clear()
+
+
+def get_string_hash(s: str) -> str:
+    """Obsidian Excalidraw Cards プラグイン互換の FNV-1a ハッシュ (32-bit unsigned hex)"""
+    h = 2166136261
+    for ch in s:
+        h ^= ord(ch)
+        h = (h * 16777619) & 0xFFFFFFFF
+    return hex(h)[2:]
+
+
+def find_obsidian_vault_root(start_path: Path) -> Optional[Path]:
+    """与えられたパスから上位を遡り、.obsidian フォルダを持つ Obsidian Vault ルートを検索する"""
+    curr = start_path if start_path.is_dir() else start_path.parent
+    for _ in range(8):
+        if (curr / ".obsidian").is_dir():
+            return curr
+        if curr.parent == curr:
+            break
+        curr = curr.parent
+
+    try:
+        obsidian_base = Path(settings.obsidian_base_dir)
+        curr = obsidian_base if obsidian_base.is_dir() else obsidian_base.parent
+        for _ in range(5):
+            if (curr / ".obsidian").is_dir():
+                return curr
+            if curr.parent == curr:
+                break
+            curr = curr.parent
+    except OSError:
+        pass
+
+    return None
+
+
+def resolve_excalidraw_preview_image(excal_path: Path, vault_root: Optional[Path]) -> Optional[Path]:
+    """
+    .excalidraw.md または .excalidraw ファイルに対応するプレビュー画像を探す
+    1. 同一ディレクトリの .png / .svg / .excalidraw.png / .excalidraw.svg
+    2. .excalidraw-cache/index.json による探索
+    3. .excalidraw-cache/[hash]_*_preview.png 探索
+    """
+    stem = excal_path.stem
+    base_stem = stem[:-11] if stem.endswith(".excalidraw") else stem
+
+    parent = excal_path.parent
+    for ext in [".excalidraw.png", ".excalidraw.svg", ".png", ".svg"]:
+        candidate = parent / f"{base_stem}{ext}"
+        if candidate.is_file():
+            return candidate
+
+    if not vault_root:
+        vault_root = find_obsidian_vault_root(excal_path)
+    if not vault_root or not vault_root.is_dir():
+        return None
+
+    v_res = vault_root.resolve()
+    cache_dir = v_res / ".excalidraw-cache"
+    if not cache_dir.is_dir():
+        return None
+    try:
+        rel_path = excal_path.resolve().relative_to(v_res).as_posix()
+    except ValueError:
+        rel_path = excal_path.name
+
+    index_file = cache_dir / "index.json"
+    if index_file.is_file():
+        try:
+            data = json.loads(index_file.read_text(encoding="utf-8", errors="ignore"))
+            entry = data.get(rel_path)
+            if isinstance(entry, dict) and "cachefile" in entry:
+                cache_file = cache_dir / entry["cachefile"]
+                if cache_file.is_file():
+                    return cache_file
+            target_name = excal_path.name
+            for key, value in data.items():
+                if (key.endswith(target_name) or key.endswith(f"{base_stem}.excalidraw.md")) and isinstance(value, dict):
+                    if "cachefile" in value:
+                        cache_file = cache_dir / value["cachefile"]
+                        if cache_file.is_file():
+                            return cache_file
+        except (OSError, ValueError, AttributeError):
+            pass
+
+    hash_str = get_string_hash(rel_path)
+    matching_files = sorted(
+        cache_dir.glob(f"{hash_str}_*_preview.*"), key=lambda p: p.stat().st_mtime, reverse=True
+    )
+    return matching_files[0] if matching_files else None
diff --git a/backend/app/services/paths.py b/backend/app/services/paths.py
new file mode 100644
index 0000000000000000000000000000000000000000..2008967e7367cdebdc9b3410eaf737d0c2c9d1c8
--- /dev/null
+++ b/backend/app/services/paths.py
@@ -0,0 +1,183 @@
+"""
+パス処理とI/Oスレッド実行の共通モジュール
+
+- convert_storage_path: リンク置換設定（pathMappings）に従い旧サーバーのパス/URLを新サーバーへ変換
+- normalize_path: API入力パスを正規化する
+    - 絶対パス（Windows UNC `\\\\server\\share` を含む）はそのまま使用する
+    - 相対パスはベースディレクトリ基準で解決し、`..` でベース外へ出るものは 403 で拒否する
+    - ネットワークI/Oを避けるため、ファイルシステムには触れず文字列だけで正規化する
+- run_with_timeout: 同期処理を専用スレッドプールで実行し、設定値（apiTimeout）秒で 504 を返す
+- run_in_io_thread: 同期処理を専用スレッドプールで実行する（タイムアウトなし。書き込み系で使用）
+- is_within: パスが指定ディレクトリ配下かどうかを文字列前方一致ではなく要素単位で判定する
+"""
+from __future__ import annotations
+
+import asyncio
+import functools
+import os
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+from typing import Any, Callable, TypeVar
+
+from fastapi import HTTPException
+
+from app import config
+from app.config import settings
+
+T = TypeVar("T")
+
+# ターミナルの長時間待機処理と分離し、PTY接続が増えてもファイルAPIを応答可能に保つ。
+FILE_IO_EXECUTOR = ThreadPoolExecutor(
+    max_workers=max(4, min(settings.file_io_workers, 64)),
+    thread_name_prefix="file-manager-io",
+)
+
+
+def get_api_timeout_seconds() -> float:
+    """設定ファイルの apiTimeout を秒数（float）で返す。不正値は10秒。"""
+    try:
+        timeout_sec = float(config.get_editor_preferences().get("apiTimeout", 10))
+    except (ValueError, TypeError):
+        return 10.0
+    return timeout_sec if timeout_sec > 0 else 10.0
+
+
+async def run_with_timeout(func: Callable[..., T], *args: Any, **kwargs: Any) -> T:
+    """
+    同期関数をスレッドプールで実行し、設定されたタイムアウト秒数で制限する。
+    タイムアウト時は 504 Gateway Timeout を返す。
+    （読み取り系API向け。書き込み系は途中で応答だけ切れると状態が分かりにくいため run_in_io_thread を使う）
+    """
+    timeout_sec = get_api_timeout_seconds()
+    loop = asyncio.get_running_loop()
+    try:
+        return await asyncio.wait_for(
+            loop.run_in_executor(FILE_IO_EXECUTOR, functools.partial(func, *args, **kwargs)),
+            timeout=timeout_sec,
+        )
+    except asyncio.TimeoutError:
+        raise HTTPException(
+            status_code=504,
+            detail=f"処理がタイムアウトしました（設定値: {timeout_sec}秒）。ネットワークが遅い可能性があります。",
+        )
+
+
+async def run_in_io_thread(func: Callable[..., T], *args: Any, **kwargs: Any) -> T:
+    """同期関数をスレッドプールで実行する（イベントループをブロックしない）。"""
+    loop = asyncio.get_running_loop()
+    return await loop.run_in_executor(FILE_IO_EXECUTOR, functools.partial(func, *args, **kwargs))
+
+
+def is_within(path: Path | str, root: Path | str) -> bool:
+    """
+    path が root 自身またはその配下かを判定する。
+    `/a/foo` と `/a/foobar` のような前方一致の誤判定を避けるため commonpath で比較する。
+    """
+    path_str = os.path.normcase(os.path.abspath(str(path)))
+    root_str = os.path.normcase(os.path.abspath(str(root)))
+    try:
+        return os.path.commonpath([path_str, root_str]) == root_str
+    except ValueError:
+        # Windowsで異なるドライブ同士を比較した場合
+        return False
+
+
+def _expand_path_mappings(raw_mappings: dict[str, str]) -> dict[str, str]:
+    """{新: "旧1,旧2"} 形式の設定を {旧: 新} に展開する。"""
+    path_mappings: dict[str, str] = {}
+    for new_path, old_paths_str in raw_mappings.items():
+        if not new_path or not old_paths_str:
+            continue
+        for old_path in (p.strip() for p in str(old_paths_str).split(",")):
+            if old_path:
+                path_mappings[old_path] = new_path
+    return path_mappings
+
+
+def convert_storage_path(path: str) -> str:
+    """
+    ストレージパスやURLの変更に対応するための変換関数。
+    normalize_path の冒頭で呼び出され、アプリ全体に適用される。
+
+    引数:
+        path: 入力パスまたはURL
+    戻り値:
+        変換後のパスまたはURL（該当する設定がなければそのまま）
+    """
+    if not path:
+        return path
+
+    raw_mappings = config.get_editor_preferences().get("pathMappings", {})
+    if not raw_mappings or not isinstance(raw_mappings, dict):
+        return path
+
+    path_mappings = _expand_path_mappings(raw_mappings)
+    is_url = path.startswith(("http://", "https://", "obsidian://"))
+
+    for old_path, new_path in path_mappings.items():
+        if is_url:
+            # URLの場合は大文字小文字を無視して前方一致比較
+            if path.lower().startswith(old_path.lower()):
+                return new_path + path[len(old_path):]
+            continue
+
+        # ファイルパス・UNCパスの場合: Windowsの「¥」を「\」に統一し、比較はスラッシュで行う
+        normalized_path = path.replace("¥", "\\")
+        normalized_old = old_path.replace("¥", "\\")
+        normalized_new = new_path.replace("¥", "\\")
+        comp_path = normalized_path.replace("\\", "/")
+        comp_old = normalized_old.replace("\\", "/")
+
+        if not comp_path.lower().startswith(comp_old.lower()):
+            continue
+
+        remainder = comp_path[len(comp_old):]
+        # 区切り文字スタイルは元の入力に合わせる（\ が含まれていれば \）
+        sep = "\\" if "\\" in normalized_path else "/"
+        combined = normalized_new.replace("\\", "/").rstrip("/") + "/" + remainder.lstrip("/")
+        result = combined.replace("/", sep)
+
+        # UNCパスの先頭プレフィックスが壊れないように調整
+        if normalized_path.startswith("\\\\") and not result.startswith("\\\\"):
+            result = "\\" + result.lstrip("\\")
+        elif normalized_path.startswith("//") and not result.startswith("//"):
+            result = "/" + result.lstrip("/")
+        return result
+
+    return path
+
+
+def normalize_path(path: str) -> Path:
+    """
+    パスを正規化する。
+    - 絶対パス: そのまま使用（Windows UNCパス `\\\\server\\share\\folder` を含む）
+    - 相対パス: ベースディレクトリからの相対パスとして扱い、ベース外へ出るものは拒否する
+    """
+    path = convert_storage_path(path)
+
+    if not path:
+        return settings.base_dir
+
+    if settings.is_windows:
+        # /C:/... のようなパスの先頭のスラッシュを削除
+        if path.startswith("/") and len(path) > 2 and path[2] == ":":
+            path = path[1:]
+        # UNCパス対応: //server/share -> \\server\share
+        elif path.startswith("//"):
+            path = path.replace("/", "\\")
+
+    # 環境変数の展開 (%USERPROFILE%, $HOME 等)
+    expanded_path = os.path.expandvars(os.path.expanduser(path))
+    normalized = Path(os.path.normpath(expanded_path))
+
+    if normalized.is_absolute():
+        return normalized
+
+    try:
+        base_path = os.path.abspath(os.path.normpath(str(settings.base_dir)))
+        candidate_path = os.path.abspath(os.path.join(base_path, str(normalized)))
+        if not is_within(candidate_path, base_path):
+            raise HTTPException(status_code=403, detail="アクセスが拒否されました")
+        return Path(candidate_path)
+    except (ValueError, RuntimeError) as e:
+        raise HTTPException(status_code=400, detail=f"無効なパスです: {str(e)}")
diff --git a/backend/app/services/transfer.py b/backend/app/services/transfer.py
new file mode 100644
index 0000000000000000000000000000000000000000..a57b61c7c42cd5b64f790305cec22288b2a4c7cb
--- /dev/null
+++ b/backend/app/services/transfer.py
@@ -0,0 +1,510 @@
+"""
+ファイル/フォルダの移動・コピー処理（同期・非同期共通の実装）
+
+安全のための原則（ファイルが勝手に消えないこと）:
+1. 移動先に同名の項目があり上書き指定がない場合は、何も変更せず
+   「同名のファイルが存在します」エラーを返す（フロントエンドが上書き確認を出す）。
+2. 同一ボリューム内で移動先が空いている場合は os.rename で一瞬で移動する（データのコピーなし）。
+3. それ以外の移動は「全ファイルをコピー → 1件ずつサイズ（指定時はSHA256）検証 →
+   移動元の全ファイルがコピー済みであることを再確認 → 移動元を削除」の順で行う。
+   途中で1件でも失敗・キャンセルした場合、移動元は一切削除しない。
+4. 上書きを指示された場合、置き換えられる既存ファイルはゴミ箱へ退避する
+   （ゴミ箱のないネットワークドライブ上のみ完全削除）。フォルダ同士は統合（マージ）し、
+   移動先にしかないファイルは残す。
+5. 移動元と移動先が同じ場合は何もしない（移動: skipped / コピー: エラー）。
+
+結果は項目（ルート）単位で返す:
+    {"status": "completed", "success_count", "fail_count",
+     "results": [{"path": 元パス, "dest": 移動先パス, "status": "success"|"error"|"skipped", "message"}]}
+"""
+from __future__ import annotations
+
+import ctypes
+import hashlib
+import os
+import platform
+import shutil
+import threading
+from concurrent.futures import FIRST_COMPLETED, Future, ThreadPoolExecutor, wait
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Literal, Optional
+
+from app.services.paths import is_within, normalize_path
+from app.services.trash import (
+    clear_windows_readonly,
+    is_network_path,
+    remove_tree_quietly,
+    rmtree,
+    trash_with_retry,
+)
+from app.task_manager import task_manager
+
+TransferMode = Literal["move", "copy"]
+
+# 並列コピーのワーカー数（I/O待ちを埋めるためCPUコア数の8倍、最大64）
+MAX_WORKERS = min(64, (os.cpu_count() or 4) * 8)
+# 同時に投入するコピー数の上限（巨大フォルダでもメモリを使いすぎない）
+MAX_PENDING_COPIES = MAX_WORKERS * 4
+
+CONFLICT_MESSAGE = "同名のファイルが存在します"
+CANCELLED_MESSAGE = "キャンセルされました"
+
+
+class TransferError(Exception):
+    """利用者に表示するメッセージ付きの移動/コピー失敗"""
+
+
+# ---------------------------------------------------------
+# 高速コピー
+# ---------------------------------------------------------
+def fast_copy_file(src: Path, dest: Path) -> bool:
+    """
+    プラットフォーム固有の最適化を使用した高速ファイルコピー（既存の dest は上書き）
+
+    - macOS (APFS): clonefile システムコール（Copy-on-Write、瞬時）
+    - Windows: CopyFileW Win32 API（ネイティブコピー）
+    - Linux: sendfile システムコール（ゼロコピー）
+
+    エラー時は shutil.copy2 にフォールバックする。
+
+    Raises:
+        FileNotFoundError: ソースファイルが存在しない場合
+    """
+    if not src.exists():
+        raise FileNotFoundError(f"Source file not found: {src}")
+
+    system = platform.system()
+    try:
+        if system == "Darwin":
+            return _fast_copy_macos(src, dest)
+        if system == "Windows":
+            return _fast_copy_windows(src, dest)
+        if system == "Linux":
+            return _fast_copy_linux(src, dest)
+    except Exception:
+        pass
+    shutil.copy2(str(src), str(dest))
+    return True
+
+
+def _fast_copy_macos(src: Path, dest: Path) -> bool:
+    """macOS専用: clonefile（APFSのCopy-on-Write）でコピーする"""
+    libc = ctypes.CDLL("/usr/lib/libc.dylib", use_errno=True)
+    if os.path.lexists(dest):
+        # clonefile は既存ファイルへ上書きできないため、従来の上書き挙動に合わせてコピーで処理する
+        shutil.copy2(str(src), str(dest))
+        return True
+    result = libc.clonefile(str(src).encode("utf-8"), str(dest).encode("utf-8"), 0)
+    if result == 0:
+        src_stat = src.stat()
+        os.utime(dest, (src_stat.st_atime, src_stat.st_mtime))
+        return True
+    err = ctypes.get_errno()
+    # ENOTSUP (45): 非対応FS（HFS+等） / EXDEV (18): 異なるボリューム間
+    if err in (45, 18):
+        shutil.copy2(str(src), str(dest))
+        return True
+    raise OSError(err, f"clonefile failed: {os.strerror(err)}")
+
+
+def _fast_copy_windows(src: Path, dest: Path) -> bool:
+    """Windows専用: CopyFileW でコピーする"""
+    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)  # type: ignore[attr-defined]
+    kernel32.CopyFileW.argtypes = [ctypes.c_wchar_p, ctypes.c_wchar_p, ctypes.c_bool]
+    kernel32.CopyFileW.restype = ctypes.c_bool
+    if not kernel32.CopyFileW(str(src), str(dest), False):
+        raise OSError(f"CopyFileW failed with error code: {ctypes.get_last_error()}")  # type: ignore[attr-defined]
+    return True
+
+
+def _fast_copy_linux(src: Path, dest: Path) -> bool:
+    """Linux専用: sendfile でカーネル内コピーする"""
+    if not hasattr(os, "sendfile"):
+        shutil.copy2(str(src), str(dest))
+        return True
+
+    src_fd = os.open(str(src), os.O_RDONLY)
+    try:
+        src_stat = os.fstat(src_fd)
+        dest_fd = os.open(str(dest), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, src_stat.st_mode)
+        try:
+            offset = 0
+            while offset < src_stat.st_size:
+                sent = os.sendfile(dest_fd, src_fd, offset, src_stat.st_size - offset)
+                if sent == 0:
+                    break
+                offset += sent
+        finally:
+            os.close(dest_fd)
+        os.utime(dest, (src_stat.st_atime, src_stat.st_mtime))
+    finally:
+        os.close(src_fd)
+    return True
+
+
+def calculate_file_checksum(file_path: Path, chunk_size: int = 1024 * 1024) -> str:
+    """ファイルのSHA256チェックサムを計算する"""
+    sha256_hash = hashlib.sha256()
+    with open(file_path, "rb") as f:
+        for chunk in iter(lambda: f.read(chunk_size), b""):
+            sha256_hash.update(chunk)
+    return sha256_hash.hexdigest()
+
+
+# ---------------------------------------------------------
+# 進捗管理
+# ---------------------------------------------------------
+@dataclass
+class _Progress:
+    """タスクの進捗（総数はスキャンしながら増える）"""
+
+    task_id: Optional[str]
+    total: int = 0
+    done: int = 0
+    lock: threading.Lock = field(default_factory=threading.Lock)
+
+    def add_total(self, count: int) -> None:
+        with self.lock:
+            self.total += count
+            total = self.total
+        if self.task_id:
+            task_manager.set_total(self.task_id, total)
+
+    def advance(self, name: str) -> None:
+        with self.lock:
+            self.done += 1
+            done = self.done
+        if self.task_id:
+            task_manager.update_progress(self.task_id, processed_files=done, current_file=name)
+
+    def message(self, text: str) -> None:
+        if self.task_id:
+            with self.lock:
+                done = self.done
+            task_manager.update_progress(self.task_id, processed_files=done, current_file=text)
+
+    def cancelled(self) -> bool:
+        return bool(self.task_id) and task_manager.is_cancelled(self.task_id)  # type: ignore[arg-type]
+
+
+# ---------------------------------------------------------
+# 内部ヘルパー
+# ---------------------------------------------------------
+def _same_location(src: Path, dest: Path) -> bool:
+    """同じ場所（大文字小文字違い・ハードリンクを含む）を指しているか"""
+    try:
+        if os.path.lexists(dest):
+            return os.path.samefile(src, dest) if not src.is_symlink() else (
+                os.path.normcase(os.path.abspath(src)) == os.path.normcase(os.path.abspath(dest))
+            )
+    except OSError:
+        pass
+    return os.path.normcase(os.path.abspath(src)) == os.path.normcase(os.path.abspath(dest))
+
+
+def _is_real_dir(path: Path) -> bool:
+    return path.is_dir() and not path.is_symlink()
+
+
+def discard_existing(path: Path) -> None:
+    """
+    上書きで置き換えられる既存項目を退避する。
+    ローカル: ゴミ箱へ移動（失敗したら例外。勝手に完全削除しない）
+    ネットワークドライブ: ゴミ箱が使えないため完全削除（利用者が上書きを確認済み）
+    """
+    if is_network_path(path):
+        if _is_real_dir(path):
+            rmtree(path)
+        else:
+            clear_windows_readonly(path)
+            path.unlink()
+        return
+    trash_with_retry(path)
+
+
+def _try_rename(src: Path, dest: Path) -> bool:
+    """同一ボリュームなら os.rename で移動する。できなければ False（コピー方式へ）。"""
+    try:
+        if os.stat(src, follow_symlinks=False).st_dev != os.stat(dest.parent).st_dev:
+            return False
+        if os.path.lexists(dest):
+            return False
+        os.rename(src, dest)
+        return True
+    except OSError:
+        return False
+
+
+def _copy_entry(src_file: Path, dest_file: Path, verify_checksum: bool) -> None:
+    """1件コピーして検証する。失敗時は作りかけのコピー先を片付けて例外を送出する。"""
+    if os.path.lexists(dest_file):
+        # 統合（マージ）時に限り到達する。上書き確認済みなので既存項目を退避してから置き換える
+        discard_existing(dest_file)
+
+    try:
+        if src_file.is_symlink() and not src_file.is_file():
+            # フォルダへのリンクやリンク切れはリンクとして再作成する（中身を辿らない）
+            os.symlink(os.readlink(src_file), dest_file, target_is_directory=src_file.is_dir())
+            return
+
+        fast_copy_file(src_file, dest_file)
+        src_size = src_file.stat().st_size
+        dest_size = dest_file.stat().st_size
+        if src_size != dest_size:
+            raise TransferError(f"サイズが一致しません (元: {src_size}, 先: {dest_size})")
+        if verify_checksum and calculate_file_checksum(src_file) != calculate_file_checksum(dest_file):
+            raise TransferError("チェックサムが一致しません")
+    except BaseException:
+        if os.path.lexists(dest_file):
+            remove_tree_quietly(dest_file)
+        raise
+
+
+def _prepare_dest_dir(dest_dir: Path) -> None:
+    """コピー先フォルダを用意する（同名のファイルがあれば上書き確認済みとして退避）"""
+    if os.path.lexists(dest_dir) and not _is_real_dir(dest_dir):
+        discard_existing(dest_dir)
+    dest_dir.mkdir(exist_ok=True)
+
+
+def _copy_tree(src: Path, dest: Path, verify_checksum: bool, progress: _Progress, label: str) -> None:
+    """
+    フォルダを並列コピーする（スキャンしながらコピーを開始して待ち時間を短縮）。
+    失敗が1件でもあれば TransferError、キャンセル時は CANCELLED_MESSAGE の TransferError。
+    """
+    errors: list[str] = []
+    errors_lock = threading.Lock()
+
+    def worker(src_file: Path, dest_file: Path) -> None:
+        if progress.cancelled():
+            return
+        try:
+            _copy_entry(src_file, dest_file, verify_checksum)
+        except Exception as e:
+            with errors_lock:
+                errors.append(f"{src_file.relative_to(src)}: {e}")
+        finally:
+            progress.advance(f"{label}: {src_file.name}")
+
+    _prepare_dest_dir(dest)
+    pending: set[Future] = set()
+    with ThreadPoolExecutor(max_workers=MAX_WORKERS, thread_name_prefix="file-transfer") as executor:
+        for root, dirs, files in os.walk(src):
+            if progress.cancelled():
+                break
+            root_path = Path(root)
+            dest_root = dest / root_path.relative_to(src)
+
+            entries: list[Path] = []
+            for name in list(dirs):
+                dir_path = root_path / name
+                if dir_path.is_symlink():
+                    entries.append(dir_path)  # リンクとして再作成する
+                    continue
+                try:
+                    _prepare_dest_dir(dest_root / name)
+                except Exception as e:
+                    with errors_lock:
+                        errors.append(f"{dir_path.relative_to(src)}: {e}")
+                    dirs.remove(name)  # 作れなかったフォルダの中身はコピーしない
+            entries.extend(root_path / name for name in files)
+
+            progress.add_total(len(entries))
+            for entry in entries:
+                if len(pending) >= MAX_PENDING_COPIES:
+                    _, pending = wait(pending, return_when=FIRST_COMPLETED)
+                pending.add(executor.submit(worker, entry, dest_root / entry.name))
+        wait(pending)
+
+    if progress.cancelled():
+        raise TransferError(CANCELLED_MESSAGE)
+    if errors:
+        raise TransferError(f"一部のファイルで{label}に失敗しました（{len(errors)}件）: " + " / ".join(errors[:3]))
+
+
+def _find_uncopied_source_entry(src: Path, dest: Path) -> Optional[str]:
+    """移動元の全項目がコピー先に揃っているかを再確認し、欠けている項目の相対パスを返す。"""
+    if not _is_real_dir(src):
+        if not os.path.lexists(dest):
+            return src.name
+        if src.is_file() and not src.is_symlink() and src.stat().st_size != dest.stat().st_size:
+            return src.name
+        return None
+
+    for root, dirs, files in os.walk(src):
+        root_path = Path(root)
+        dest_root = dest / root_path.relative_to(src)
+        for name in files + [d for d in dirs if (root_path / d).is_symlink()]:
+            src_entry = root_path / name
+            dest_entry = dest_root / name
+            if not os.path.lexists(dest_entry):
+                return str(src_entry.relative_to(src))
+            if src_entry.is_file() and not src_entry.is_symlink():
+                if src_entry.stat().st_size != dest_entry.stat().st_size:
+                    return str(src_entry.relative_to(src))
+        for name in dirs:
+            if not os.path.lexists(dest_root / name):
+                return str((root_path / name).relative_to(src))
+    return None
+
+
+def _remove_moved_source(src: Path) -> None:
+    """コピーと検証が済んだ移動元を削除する"""
+    if _is_real_dir(src):
+        rmtree(src)
+    else:
+        clear_windows_readonly(src)
+        src.unlink()
+
+
+# ---------------------------------------------------------
+# 公開API
+# ---------------------------------------------------------
+def transfer_one(
+    src: Path,
+    final_dest: Path,
+    mode: TransferMode,
+    overwrite: bool = False,
+    verify_checksum: bool = False,
+    progress: Optional[_Progress] = None,
+) -> tuple[str, str]:
+    """
+    1項目を移動/コピーする。戻り値は (status, message)。
+    失敗時は TransferError（またはOSError）を送出し、移動元は必ず残る。
+    """
+    progress = progress or _Progress(task_id=None)
+    is_move = mode == "move"
+    label = "移動" if is_move else "コピー"
+
+    if not os.path.lexists(src):
+        raise TransferError("ファイルが見つかりません")
+
+    if _same_location(src, final_dest):
+        if is_move:
+            return "skipped", "移動元と移動先が同じです"
+        raise TransferError("同一ファイルへのコピーはできません")
+
+    src_is_dir = _is_real_dir(src)
+    if src_is_dir and is_within(os.path.realpath(final_dest), os.path.realpath(src)):
+        raise TransferError(f"自分自身のサブディレクトリには{label}できません")
+
+    dest_exists = os.path.lexists(final_dest)
+    if dest_exists and not overwrite:
+        raise TransferError(CONFLICT_MESSAGE)
+
+    # 同一ボリュームで移動先が空いていればリネームで一瞬で終わらせる
+    if is_move and not dest_exists and _try_rename(src, final_dest):
+        progress.add_total(1)
+        progress.advance(f"{label}: {src.name}")
+        return "success", "移動完了"
+
+    merge = dest_exists and src_is_dir and _is_real_dir(final_dest)
+    if dest_exists and not merge:
+        progress.message(f"上書き準備: {final_dest.name}")
+        discard_existing(final_dest)
+    created_dest = not merge
+
+    try:
+        if src_is_dir:
+            _copy_tree(src, final_dest, verify_checksum, progress, label)
+        else:
+            progress.add_total(1)
+            _copy_entry(src, final_dest, verify_checksum)
+            progress.advance(f"{label}: {src.name}")
+    except BaseException:
+        # 移動の失敗・キャンセル時は、今回新規に作ったコピー先だけを片付ける（移動元は残す）
+        if is_move and created_dest:
+            remove_tree_quietly(final_dest)
+        raise
+
+    if not is_move:
+        return "success", "コピー完了"
+
+    missing = _find_uncopied_source_entry(src, final_dest)
+    if missing is not None:
+        raise TransferError(f"移動中に移動元が変更されたため、移動元を残しました: {missing}")
+
+    progress.message(f"移動元を削除: {src.name}")
+    try:
+        _remove_moved_source(src)
+    except OSError as e:
+        raise TransferError(f"コピーは完了しましたが、移動元の削除に失敗しました: {e}")
+    return "success", "移動完了"
+
+
+def transfer_items(
+    src_paths: list[str],
+    dest_dir: Path,
+    mode: TransferMode,
+    overwrite: bool = False,
+    verify_checksum: bool = False,
+    task_id: Optional[str] = None,
+    debug_mode: bool = False,
+) -> dict:
+    """複数項目を dest_dir 配下へ移動/コピーし、項目ごとの結果を返す。"""
+    progress = _Progress(task_id=task_id)
+    results: list[dict] = []
+
+    for src_str in src_paths:
+        entry: dict = {"path": src_str}
+        try:
+            if progress.cancelled():
+                raise TransferError(CANCELLED_MESSAGE)
+            src = normalize_path(src_str)
+            final_dest = dest_dir / src.name
+            entry["dest"] = final_dest.as_posix()
+            status, message = transfer_one(src, final_dest, mode, overwrite, verify_checksum, progress)
+            entry.update(status=status, message=message)
+        except Exception as e:
+            entry.update(status="error", message=str(e) or e.__class__.__name__)
+        if debug_mode:
+            print(f"[TRANSFER:{mode}] {entry}")
+        results.append(entry)
+
+    return {
+        "status": "completed",
+        "success_count": sum(1 for r in results if r["status"] == "success"),
+        "fail_count": sum(1 for r in results if r["status"] == "error"),
+        "results": results,
+    }
+
+
+def run_transfer_task(
+    task_id: str,
+    src_paths: list[str],
+    dest_dir: Path,
+    mode: TransferMode,
+    overwrite: bool,
+    verify_checksum: bool,
+    debug_mode: bool,
+) -> None:
+    """バックグラウンドスレッドで transfer_items を実行し、結果をタスクへ保存する。"""
+    task_manager.set_running(task_id)
+    task_manager.set_total(task_id, 0)
+    task_manager.update_progress(task_id, processed_files=0, current_file="準備中...")
+    try:
+        result = transfer_items(src_paths, dest_dir, mode, overwrite, verify_checksum, task_id, debug_mode)
+        task_manager.complete_task(task_id, result=result)
+    except Exception as e:  # 想定外の例外でもタスクを「実行中」のまま放置しない
+        task_manager.fail_task(task_id, str(e))
+
+
+def start_transfer_task(
+    src_paths: list[str],
+    dest_dir: Path,
+    mode: TransferMode,
+    overwrite: bool,
+    verify_checksum: bool,
+    debug_mode: bool,
+) -> str:
+    """非同期の移動/コピーを開始してタスクIDを返す。"""
+    task = task_manager.create_task(total_files=len(src_paths))
+    threading.Thread(
+        target=run_transfer_task,
+        args=(task.id, src_paths, dest_dir, mode, overwrite, verify_checksum, debug_mode),
+        daemon=True,
+        name=f"transfer-{task.id[:8]}",
+    ).start()
+    return task.id
+
diff --git a/backend/app/services/trash.py b/backend/app/services/trash.py
new file mode 100644
index 0000000000000000000000000000000000000000..e099a4fb114fbb6ed62c479d75415e9ede489123
--- /dev/null
+++ b/backend/app/services/trash.py
@@ -0,0 +1,366 @@
+"""
+ゴミ箱移動・ネットワークドライブ判定・ファイルロック検出
+
+- move_to_trash: Windowsは SHFileOperationW（Explorerと同じゴミ箱移動）、それ以外は send2trash を使う
+- trash_with_retry: Windowsで一時的なロック（Excel等）が残るケースを短いリトライで吸収する
+- is_network_path: 本当にネットワーク上にあるパスだけを True にする
+    - Windows: UNCパス、または GetDriveTypeW が DRIVE_REMOTE のドライブ（ローカルの D: 等は False）
+    - macOS/Linux: マウントテーブルのファイルシステム種別が smbfs/afpfs/nfs/cifs 等のもの
+      （USBメモリ等の外付けローカルディスクは False）
+    - 判定できない場合は False（＝ゴミ箱へ移動する安全側）
+- get_locking_processes: Restart Manager API でファイルをロックしているプロセスを取得（Windows専用）
+- kill_processes: ユーザーが同意したプロセスを終了する
+- delete_permanently: ネットワークドライブ上でユーザーが削除を指示した場合のみ使う完全削除
+"""
+from __future__ import annotations
+
+import os
+import platform
+import re
+import shutil
+import signal
+import stat
+import subprocess
+import threading
+import time
+from pathlib import Path
+from typing import Callable, Optional
+
+from app.config import settings
+
+WINDOWS_DELETE_RETRY_COUNT = 10
+WINDOWS_DELETE_RETRY_BASE_SECONDS = 0.2
+WINDOWS_DELETE_RETRY_MAX_SECONDS = 1.0
+
+# ネットワークファイルシステムとして扱うマウント種別
+NETWORK_FS_TYPES = frozenset({
+    "smbfs", "afpfs", "nfs", "nfs4", "cifs", "smb3", "smb2", "webdav", "davfs",
+    "fuse.sshfs", "sshfs", "osxfuse", "macfuse", "fuse.rclone", "ncpfs", "9p",
+})
+
+MOUNT_TABLE_TTL_SECONDS = 30.0
+_mount_table_lock = threading.Lock()
+_mount_table_cache: tuple[float, list[tuple[str, str]]] | None = None
+
+DRIVE_REMOTE = 4
+
+
+# ---------------------------------------------------------
+# ネットワークドライブ判定
+# ---------------------------------------------------------
+def _unescape_proc_mount_field(value: str) -> str:
+    """/proc/mounts の8進エスケープ（\\040 = 空白など）を戻す。"""
+    return re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), value)
+
+
+def parse_proc_mounts(text: str) -> list[tuple[str, str]]:
+    """Linux の /proc/self/mounts を (マウントポイント, 種別) のリストにする。"""
+    mounts: list[tuple[str, str]] = []
+    for line in text.splitlines():
+        parts = line.split()
+        if len(parts) >= 3:
+            mounts.append((_unescape_proc_mount_field(parts[1]), parts[2].lower()))
+    return mounts
+
+
+_MACOS_MOUNT_LINE = re.compile(r"^.+? on (?P<mount>.+) \((?P<fstype>[^,)]+)")
+
+
+def parse_macos_mount_output(text: str) -> list[tuple[str, str]]:
+    """macOS の `mount` コマンド出力を (マウントポイント, 種別) のリストにする。"""
+    mounts: list[tuple[str, str]] = []
+    for line in text.splitlines():
+        match = _MACOS_MOUNT_LINE.match(line.strip())
+        if match:
+            mounts.append((match.group("mount"), match.group("fstype").strip().lower()))
+    return mounts
+
+
+def _read_mount_table() -> list[tuple[str, str]]:
+    """OSのマウントテーブルを読む。失敗時は空リスト（＝すべてローカル扱い）。"""
+    try:
+        if platform.system() == "Linux":
+            with open("/proc/self/mounts", encoding="utf-8", errors="replace") as f:
+                return parse_proc_mounts(f.read())
+        if platform.system() == "Darwin":
+            result = subprocess.run(
+                ["/sbin/mount"], capture_output=True, text=True, timeout=3, check=False
+            )
+            return parse_macos_mount_output(result.stdout)
+    except (OSError, subprocess.SubprocessError):
+        pass
+    return []
+
+
+def _get_mount_table() -> list[tuple[str, str]]:
+    """マウントテーブルを短時間キャッシュして返す。"""
+    global _mount_table_cache
+    now = time.monotonic()
+    with _mount_table_lock:
+        if _mount_table_cache and now - _mount_table_cache[0] < MOUNT_TABLE_TTL_SECONDS:
+            return _mount_table_cache[1]
+    table = _read_mount_table()
+    with _mount_table_lock:
+        _mount_table_cache = (now, table)
+    return table
+
+
+def find_mount_fstype(path_str: str, mounts: list[tuple[str, str]]) -> Optional[str]:
+    """パスを含む最も深いマウントポイントの種別を返す。"""
+    best: tuple[int, str] | None = None
+    for mount_point, fstype in mounts:
+        mp = mount_point.rstrip("/") or "/"
+        if path_str == mp or path_str.startswith(mp if mp == "/" else mp + "/"):
+            if best is None or len(mp) > best[0]:
+                best = (len(mp), fstype)
+    return best[1] if best else None
+
+
+def _windows_drive_type(drive_root: str) -> int:
+    import ctypes
+
+    try:
+        return int(ctypes.windll.kernel32.GetDriveTypeW(drive_root))
+    except Exception:
+        return 0
+
+
+def is_network_path(path: Path | str) -> bool:
+    """パスがネットワーク上のファイルシステムにあるかを判定する（不明時は False）。"""
+    path_str = str(path)
+
+    if settings.is_windows:
+        if path_str.startswith(("\\\\", "//")):
+            return True
+        if len(path_str) >= 2 and path_str[1] == ":" and path_str[0].isalpha():
+            return _windows_drive_type(f"{path_str[0].upper()}:\\") == DRIVE_REMOTE
+        return False
+
+    try:
+        real = os.path.realpath(path_str)
+    except (OSError, ValueError):
+        real = os.path.abspath(path_str)
+    fstype = find_mount_fstype(real, _get_mount_table())
+    return fstype in NETWORK_FS_TYPES if fstype else False
+
+
+# ---------------------------------------------------------
+# ゴミ箱移動
+# ---------------------------------------------------------
+def _move_to_trash_windows(path_str: str) -> None:
+    import ctypes
+    from ctypes import wintypes
+
+    class SHFILEOPSTRUCTW(ctypes.Structure):
+        _fields_ = [
+            ("hwnd", wintypes.HWND),
+            ("wFunc", wintypes.UINT),
+            ("pFrom", wintypes.LPCWSTR),
+            ("pTo", wintypes.LPCWSTR),
+            ("fFlags", wintypes.WORD),
+            ("fAnyOperationsAborted", wintypes.BOOL),
+            ("hNameMappings", wintypes.LPVOID),
+            ("lpszProgressTitle", wintypes.LPCWSTR),
+        ]
+
+    FO_DELETE = 3
+    FOF_ALLOWUNDO = 0x0040       # ゴミ箱に移動
+    FOF_NOCONFIRMATION = 0x0010  # 確認ダイアログ非表示
+    FOF_NOERRORUI = 0x0400       # エラーUI非表示
+    FOF_SILENT = 0x0004          # 進捗UI非表示
+
+    op = SHFILEOPSTRUCTW()
+    op.hwnd = None
+    op.wFunc = FO_DELETE
+    op.pFrom = str(Path(path_str).resolve()) + "\0\0"
+    op.pTo = None
+    op.fFlags = FOF_ALLOWUNDO | FOF_NOCONFIRMATION | FOF_NOERRORUI | FOF_SILENT
+    op.fAnyOperationsAborted = False
+    op.hNameMappings = None
+    op.lpszProgressTitle = None
+
+    result = ctypes.windll.shell32.SHFileOperationW(ctypes.byref(op))
+    if result != 0:
+        raise OSError(f"SHFileOperationW failed with error code {result}")
+    if op.fAnyOperationsAborted:
+        raise OSError("File deletion was aborted by user or system")
+
+
+def move_to_trash(path_str: str) -> None:
+    """ファイル/フォルダをゴミ箱へ移動する（フォルダは階層を保ったまま丸ごと）。"""
+    if settings.is_windows:
+        _move_to_trash_windows(path_str)
+        return
+    from send2trash import send2trash
+
+    send2trash(path_str)
+
+
+def clear_windows_readonly(path: Path) -> None:
+    """Windowsの読み取り専用属性を外す（削除・置換の失敗を防ぐ）。"""
+    if not settings.is_windows:
+        return
+    try:
+        path.chmod(path.stat().st_mode | stat.S_IWRITE)
+    except OSError:
+        pass
+
+
+def trash_with_retry(path: Path) -> None:
+    """
+    ゴミ箱への移動を行う。Windowsでは一時的なロックを想定して最大約8秒リトライする。
+    失敗した場合は例外を送出する（完全削除へのフォールバックは絶対にしない）。
+    """
+    retry_count = WINDOWS_DELETE_RETRY_COUNT if settings.is_windows else 1
+    for attempt in range(retry_count):
+        try:
+            clear_windows_readonly(path)
+            move_to_trash(str(path))
+            return
+        except OSError:
+            if attempt == retry_count - 1:
+                raise
+            time.sleep(min(
+                WINDOWS_DELETE_RETRY_BASE_SECONDS * (attempt + 1),
+                WINDOWS_DELETE_RETRY_MAX_SECONDS,
+            ))
+
+
+# ---------------------------------------------------------
+# 完全削除（ネットワークドライブ上でユーザーが削除を指示した場合のみ）
+# ---------------------------------------------------------
+def _rmtree_retry_readonly(func, path_str, exc):
+    """Windowsでreadonlyが原因のrmtree失敗を再試行する（shutil.rmtree の onexc 用）"""
+    if isinstance(exc, tuple):  # onerror 互換（exc_info）
+        exc = exc[1]
+    if not settings.is_windows or not isinstance(exc, PermissionError):
+        raise exc
+    clear_windows_readonly(Path(path_str))
+    func(path_str)
+
+
+def rmtree(path: Path) -> None:
+    """読み取り専用属性にも対応したフォルダの完全削除（移動元の後片付けなどで使用）"""
+    shutil.rmtree(path, onexc=_rmtree_retry_readonly)
+
+
+def delete_permanently(
+    path: Path,
+    on_progress: Optional[Callable[[str], None]] = None,
+    is_cancelled: Optional[Callable[[], bool]] = None,
+) -> None:
+    """
+    ゴミ箱を使えないネットワークドライブ上の項目を完全削除する。
+    フォルダは深い階層から1件ずつ削除し、進捗通知とキャンセルに対応する。
+    """
+    if path.is_symlink() or not path.is_dir():
+        clear_windows_readonly(path)
+        path.unlink()
+        if on_progress:
+            on_progress(path.name)
+        return
+
+    for root, dirs, files in os.walk(path, topdown=False):
+        if is_cancelled and is_cancelled():
+            raise InterruptedError("キャンセルされました")
+        root_path = Path(root)
+        for name in files:
+            file_path = root_path / name
+            clear_windows_readonly(file_path)
+            file_path.unlink()
+            if on_progress:
+                on_progress(name)
+        for name in dirs:
+            dir_path = root_path / name
+            if dir_path.is_symlink():
+                dir_path.unlink()
+            else:
+                dir_path.rmdir()
+    path.rmdir()
+
+
+# ---------------------------------------------------------
+# ロック検出・プロセス終了（Windows）
+# ---------------------------------------------------------
+def get_locking_processes(path_str: str) -> list[dict]:
+    """Restart Manager API を使用して、ファイルをロックしているプロセスのリストを取得する(Windows専用)"""
+    if not settings.is_windows:
+        return []
+
+    import ctypes
+    from ctypes import wintypes
+
+    try:
+        rstrtmgr = ctypes.windll.rstrtmgr
+    except AttributeError:
+        return []
+
+    class RM_UNIQUE_PROCESS(ctypes.Structure):
+        _fields_ = [
+            ("dwProcessId", wintypes.DWORD),
+            ("ProcessStartTime", wintypes.FILETIME),
+        ]
+
+    class RM_PROCESS_INFO(ctypes.Structure):
+        _fields_ = [
+            ("Process", RM_UNIQUE_PROCESS),
+            ("strAppName", wintypes.WCHAR * 256),
+            ("strServiceShortName", wintypes.WCHAR * 63),
+            ("ApplicationType", wintypes.DWORD),
+            ("AppStatus", wintypes.ULONG),
+            ("TSSessionId", wintypes.DWORD),
+            ("bRestartable", wintypes.BOOL),
+        ]
+
+    session_handle = wintypes.DWORD()
+    session_key = (wintypes.WCHAR * 256)()
+    if rstrtmgr.RmStartSession(ctypes.byref(session_handle), 0, session_key) != 0:
+        return []
+
+    locking_processes: list[dict] = []
+    try:
+        paths = (wintypes.LPCWSTR * 1)(path_str)
+        if rstrtmgr.RmRegisterResources(session_handle, 1, paths, 0, None, 0, None) != 0:
+            return []
+        needed = wintypes.DWORD(0)
+        count = wintypes.DWORD(0)
+        reboot_reasons = wintypes.DWORD(0)
+        res = rstrtmgr.RmGetList(
+            session_handle, ctypes.byref(needed), ctypes.byref(count), None, ctypes.byref(reboot_reasons)
+        )
+        if res == 234:  # ERROR_MORE_DATA
+            count = needed
+            infos = (RM_PROCESS_INFO * needed.value)()
+            res = rstrtmgr.RmGetList(
+                session_handle, ctypes.byref(needed), ctypes.byref(count), infos, ctypes.byref(reboot_reasons)
+            )
+            if res == 0:
+                for i in range(count.value):
+                    locking_processes.append({
+                        "pid": infos[i].Process.dwProcessId,
+                        "name": infos[i].strAppName,
+                    })
+    finally:
+        rstrtmgr.RmEndSession(session_handle)
+
+    return locking_processes
+
+
+def kill_processes(pids: list[int]) -> None:
+    """ユーザーが同意したPIDのプロセスを終了させる（Windows: TerminateProcess / POSIX: SIGKILL）"""
+    for pid in pids:
+        try:
+            os.kill(pid, signal.SIGTERM if settings.is_windows else signal.SIGKILL)
+        except OSError:
+            pass
+
+
+def remove_tree_quietly(path: Path) -> None:
+    """自分で作成した一時的なコピー先などを片付ける（失敗は無視）。"""
+    try:
+        if path.is_symlink() or path.is_file():
+            path.unlink()
+        elif path.is_dir():
+            rmtree(path)
+    except OSError:
+        pass
