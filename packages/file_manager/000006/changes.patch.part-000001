diff --git a/frontend/src/test/fakeBackend.ts b/frontend/src/test/fakeBackend.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7ed729043fa293b0569b24f3630d1e991fb26ba2
--- /dev/null
+++ b/frontend/src/test/fakeBackend.ts
@@ -0,0 +1,234 @@
+/**
+ * 画面操作テスト用の偽バックエンド
+ * - メモリ上のファイルツリーを持ち、globalThis.fetch を差し替えて /api/* に応答する
+ * - 一覧・パス判定・削除・移動・コピー・作成・リネーム・件数・履歴・設定に対応
+ * - 実際のバックエンドと同じく、同名衝突は「同名のファイルが存在します」エラーにし、何も変更しない
+ * - calls に受け取ったリクエストを記録し、テストから検証できる
+ */
+import type { BatchItemResult, FileItem } from "../types/file";
+
+export interface FakeEntry {
+  type: "file" | "directory";
+  size?: number;
+  modified?: string;
+}
+
+export interface RecordedCall {
+  method: string;
+  path: string;
+  query: Record<string, string>;
+  body: unknown;
+}
+
+const CONFLICT = "同名のファイルが存在します";
+
+function parent(path: string): string {
+  const index = path.lastIndexOf("/");
+  return index <= 0 ? "/" : path.slice(0, index);
+}
+
+function baseName(path: string): string {
+  return path.slice(path.lastIndexOf("/") + 1);
+}
+
+function json(data: unknown, status = 200): Response {
+  return new Response(JSON.stringify(data), {
+    status,
+    headers: { "Content-Type": "application/json" },
+  });
+}
+
+export class FakeBackend {
+  entries = new Map<string, FakeEntry>();
+  calls: RecordedCall[] = [];
+  /** /api/git-folder-statuses が返す各フォルダの状態（パス → ahead / behind / 変更ファイル） */
+  gitStatuses: Record<string, { ahead: number; behind: number; changed: string[] }> = {};
+  /** /api/folder-latest-modified が返す最新更新日時（パス → ISO 文字列） */
+  latestModified: Record<string, string> = {};
+
+  constructor(tree: Record<string, FakeEntry | "dir" | string>) {
+    this.entries.set("/", { type: "directory" });
+    for (const [path, value] of Object.entries(tree)) {
+      this.add(path, value === "dir" ? { type: "directory" } : typeof value === "string"
+        ? { type: "file", size: value.length, modified: "2026-01-02T03:04:05" }
+        : value);
+    }
+  }
+
+  add(path: string, entry: FakeEntry): void {
+    let current = parent(path);
+    while (!this.entries.has(current)) {
+      this.entries.set(current, { type: "directory" });
+      current = parent(current);
+    }
+    this.entries.set(path, entry);
+  }
+
+  exists(path: string): boolean {
+    return this.entries.has(path);
+  }
+
+  children(dir: string): FileItem[] {
+    const prefix = dir === "/" ? "/" : `${dir}/`;
+    return [...this.entries.entries()]
+      .filter(([p]) => p !== dir && p.startsWith(prefix) && !p.slice(prefix.length).includes("/"))
+      .map(([p, e]) => ({ name: baseName(p), path: p, type: e.type, size: e.size, modified: e.modified }));
+  }
+
+  callsTo(path: string): RecordedCall[] {
+    return this.calls.filter((c) => c.path === path);
+  }
+
+  private removeTree(path: string): void {
+    for (const p of [...this.entries.keys()]) {
+      if (p === path || p.startsWith(`${path}/`)) this.entries.delete(p);
+    }
+  }
+
+  private copyTree(src: string, dest: string): void {
+    for (const [p, e] of [...this.entries.entries()]) {
+      if (p === src || p.startsWith(`${src}/`)) this.entries.set(dest + p.slice(src.length), { ...e });
+    }
+  }
+
+  private transfer(body: { src_paths: string[]; dest_path: string; overwrite?: boolean }, mode: "move" | "copy") {
+    const results: BatchItemResult[] = body.src_paths.map((src) => {
+      const dest = `${body.dest_path === "/" ? "" : body.dest_path}/${baseName(src)}`;
+      if (!this.exists(src)) return { path: src, dest, status: "error", message: "ファイルが見つかりません" };
+      if (src === dest) {
+        return mode === "move"
+          ? { path: src, dest, status: "skipped", message: "移動元と移動先が同じです" }
+          : { path: src, dest, status: "error", message: "同一ファイルへのコピーはできません" };
+      }
+      if (this.exists(dest) && !body.overwrite) return { path: src, dest, status: "error", message: CONFLICT };
+      if (this.exists(dest)) this.removeTree(dest);
+      this.copyTree(src, dest);
+      if (mode === "move") this.removeTree(src);
+      return { path: src, dest, status: "success", message: mode === "move" ? "移動完了" : "コピー完了" };
+    });
+    return {
+      status: "completed",
+      success_count: results.filter((r) => r.status === "success").length,
+      fail_count: results.filter((r) => r.status === "error").length,
+      results,
+    };
+  }
+
+  /** globalThis.fetch の代わりに使う */
+  fetch = async (input: RequestInfo | URL, init?: RequestInit): Promise<Response> => {
+    const url = new URL(typeof input === "string" ? input : input instanceof URL ? input.href : input.url, "http://localhost");
+    const method = (init?.method ?? "GET").toUpperCase();
+    const query = Object.fromEntries(url.searchParams.entries());
+    let body: unknown = undefined;
+    if (typeof init?.body === "string") {
+      try { body = JSON.parse(init.body); } catch { body = init.body; }
+    } else if (init?.body instanceof FormData) {
+      const form = init.body;
+      body = {
+        files: form.getAll("files").map((f) => (f as File).name),
+        relative_paths: form.getAll("relative_paths"),
+        empty_directories: form.getAll("empty_directories"),
+      };
+    }
+    this.calls.push({ method, path: url.pathname, query, body });
+    const b = body as Record<string, unknown>;
+
+    switch (`${method} ${url.pathname}`) {
+      case "GET /api/config":
+        return json({ defaultBasePath: "/root", isWindows: false, textFileOpenMode: "web", markdownOpenMode: "web", apiTimeout: 10, pathMappings: {} });
+      case "GET /api/history":
+        return json([]);
+      case "POST /api/history":
+        return json({ status: "success" });
+      case "GET /api/path-info": {
+        const p = query.path;
+        const entry = this.entries.get(p);
+        if (!entry) return json({ path: p, type: "not_found" });
+        return json(entry.type === "directory" ? { path: p, type: "directory" } : { path: p, type: "file", parent: parent(p) });
+      }
+      case "GET /api/files": {
+        const p = query.path;
+        const entry = this.entries.get(p);
+        if (!entry) return json({ detail: "パスが見つかりません" }, 404);
+        const dir = entry.type === "file" ? parent(p) : p;
+        return json({ type: "directory", path: dir, items: this.children(dir) });
+      }
+      case "POST /api/delete/batch": {
+        const results = (b.paths as string[]).map((p) => {
+          if (!this.exists(p)) return { path: p, status: "error", message: "ファイルが見つかりません" };
+          this.removeTree(p);
+          return { path: p, status: "success", message: "ゴミ箱に移動しました" };
+        });
+        return json({
+          status: "completed",
+          success_count: results.filter((r) => r.status === "success").length,
+          fail_count: results.filter((r) => r.status === "error").length,
+          results,
+        });
+      }
+      case "POST /api/move/batch":
+        return json(this.transfer(b as never, "move"));
+      case "POST /api/copy/batch":
+        return json(this.transfer(b as never, "copy"));
+      case "POST /api/count-files":
+        return json({ total_count: (b.paths as string[]).length, details: [] });
+      case "POST /api/create-folder": {
+        const p = `${b.path}/${b.name}`;
+        if (this.exists(p)) return json({ detail: "同名のファイル/フォルダが既に存在します" }, 400);
+        this.add(p, { type: "directory" });
+        return json({ status: "success" });
+      }
+      case "POST /api/create-file": {
+        const p = `${b.path}/${b.name}`;
+        if (this.exists(p)) return json({ detail: "同名のファイル/フォルダが既に存在します" }, 400);
+        this.add(p, { type: "file", size: String(b.content ?? "").length, modified: "2026-01-02T03:04:05" });
+        return json({ status: "success", message: "作成しました", path: p });
+      }
+      case "POST /api/rename": {
+        const oldPath = b.old_path as string;
+        const newPath = `${parent(oldPath)}/${b.new_name}`;
+        if (this.exists(newPath)) return json({ detail: "同名のファイル/フォルダが既に存在します" }, 400);
+        this.copyTree(oldPath, newPath);
+        this.removeTree(oldPath);
+        return json({ status: "success" });
+      }
+      case "POST /api/git-folder-statuses":
+        return json({
+          items: (b.paths as string[])
+            .filter((p) => this.gitStatuses[p])
+            .map((p) => ({
+              path: p,
+              changed_files: this.gitStatuses[p].changed,
+              has_more_changes: false,
+              ahead_count: this.gitStatuses[p].ahead,
+              behind_count: this.gitStatuses[p].behind,
+            })),
+        });
+      case "POST /api/folder-latest-modified":
+        return json({ modified: this.latestModified[b.path as string] ?? null, truncated: false });
+      case "POST /api/open/smart": {
+        // 実際の判定（routers/launcher.py）を簡略化したもの
+        const target = b.path as string;
+        const name = baseName(target);
+        if (/\.(md|txt|py)$/.test(name)) {
+          return json({
+            action: "open_modal",
+            editor_mode: name.endsWith(".md") ? "markdown" : "code",
+            content: `content of ${name}`,
+            language: name.endsWith(".py") ? "python" : "plaintext",
+          });
+        }
+        if (name.endsWith(".ipynb")) return json({ action: "open_url", url: `http://localhost:8888/lab/tree${target}` });
+        return json({ action: "open_external", message: "既定のアプリで開きました" });
+      }
+      case "POST /api/upload": {
+        const upload = b as { files: string[]; relative_paths: string[] };
+        const names = upload.relative_paths.length > 0 ? upload.relative_paths : upload.files;
+        names.forEach((name) => this.add(`${query.path}/${name}`, { type: "file", size: 0, modified: "2026-01-02T03:04:05" }));
+        return json({ status: "success", message: `${names.length}件アップロードしました`, uploaded: names });
+      }
+      default:
+        return json({ status: "success" });
+    }
+  };
+}
diff --git a/frontend/src/test/renderFileList.tsx b/frontend/src/test/renderFileList.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..85b6e0b00a4e1a9d7c0e0e61997a859d47930d35
--- /dev/null
+++ b/frontend/src/test/renderFileList.tsx
@@ -0,0 +1,111 @@
+/**
+ * FileList の画面操作テスト用ヘルパー
+ * - 実際のアプリと同じ Provider（Query / 操作履歴 / フォルダ履歴 / トースト）で FileList を描画する
+ * - fetch を偽バックエンドに差し替え、jsdom にない API（scrollIntoView・clipboard）を補う
+ * - window.confirm の応答をテストごとに指定できる
+ */
+import "@testing-library/jest-dom/vitest";
+import { cleanup, render, screen, waitFor, within } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { afterEach, expect, vi } from "vitest";
+import { FileList } from "../components/FileList";
+import { FolderHistoryProvider } from "../contexts/FolderHistoryContext";
+import { OperationHistoryProvider } from "../contexts/OperationHistoryContext";
+import { ToastProvider } from "../contexts/ToastContext";
+import { FakeBackend, type FakeEntry } from "./fakeBackend";
+import type { MarkdownOpenMode, TextFileOpenMode } from "../utils/editorPreferences";
+
+afterEach(() => {
+  cleanup();
+  vi.restoreAllMocks();
+  localStorage.clear();
+});
+
+export interface RenderFileListOptions {
+  path?: string;
+  panelId?: string;
+  confirm?: boolean;
+  textFileOpenMode?: TextFileOpenMode;
+  markdownOpenMode?: MarkdownOpenMode;
+}
+
+export async function renderFileList(
+  tree: Record<string, FakeEntry | "dir" | string>,
+  options: RenderFileListOptions = {},
+) {
+  const backend = new FakeBackend(tree);
+  vi.stubGlobal("fetch", vi.fn(backend.fetch));
+  Element.prototype.scrollIntoView = vi.fn();
+  const confirmSpy = vi.spyOn(window, "confirm").mockReturnValue(options.confirm ?? true);
+
+  const queryClient = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  // userEvent.setup() は navigator.clipboard を差し替えるため、その後でクリップボードの代役を設定する
+  const user = userEvent.setup();
+  const clipboardText = { value: "" };
+  Object.defineProperty(navigator, "clipboard", {
+    configurable: true,
+    value: {
+      writeText: vi.fn(async (text: string) => { clipboardText.value = text; }),
+      readText: vi.fn(async () => clipboardText.value),
+    },
+  });
+  const onPathChange = vi.fn();
+  const startPath = options.path ?? "/root";
+
+  const utils = render(
+    <QueryClientProvider client={queryClient}>
+      <OperationHistoryProvider>
+        <FolderHistoryProvider>
+          <ToastProvider>
+            <FileList
+              panelId={options.panelId ?? "left"}
+              initialPath={startPath}
+              isFocused
+              onPathChange={onPathChange}
+              textFileOpenMode={options.textFileOpenMode}
+              markdownOpenMode={options.markdownOpenMode}
+            />
+          </ToastProvider>
+        </FolderHistoryProvider>
+      </OperationHistoryProvider>
+    </QueryClientProvider>,
+  );
+
+  // 初期パスの検証と一覧の取得が終わるまで待つ
+  await screen.findByRole("table");
+  // 読み込み完了の1フレーム後に、フォーカス中のペインは一覧コンテナへフォーカスを移す。
+  // それより前に入力を始めると途中でフォーカスが移ってしまうため、実際の利用時と同じ状態になるまで待つ
+  await waitFor(() => expect(document.activeElement).toBe(utils.container.querySelector(".file-list")));
+
+  /** 一覧の行（tbody tr）をフォルダ→ファイルの順で返す */
+  const rows = () => [...utils.container.querySelectorAll<HTMLTableRowElement>(".file-table tbody tr")];
+  /** 表示されている名前の一覧 */
+  const names = () => rows().map((row) => row.querySelector(".name-info-wrapper span")?.textContent ?? "");
+  /** 名前で行を探す */
+  const row = (name: string) => {
+    const found = rows().find((r) => r.querySelector(".name-info-wrapper span")?.textContent === name);
+    if (!found) throw new Error(`row not found: ${name} (rows: ${names().join(", ")})`);
+    return found;
+  };
+  /** 一覧のコンテナにフォーカスしてキーを押す */
+  const press = async (keys: string) => {
+    utils.container.querySelector<HTMLElement>(".file-list")?.focus();
+    await user.keyboard(keys);
+  };
+
+  return {
+    ...utils,
+    backend,
+    user,
+    queryClient,
+    confirmSpy,
+    clipboardText,
+    onPathChange,
+    rows,
+    names,
+    row,
+    press,
+    within,
+  };
+}
diff --git a/frontend/src/types/file.ts b/frontend/src/types/file.ts
index 781f4ab17b1533c0dbf04381d81bcc4442de160f..feba82224a38e633ad60930f4c2a897fc8b779b9 100644
--- a/frontend/src/types/file.ts
+++ b/frontend/src/types/file.ts
@@ -74,3 +74,47 @@ export type ContextMenuAction =
   | "copy"
   | "cut"
   | "paste";
+
+/**
+ * ファイルをロックしているプロセス（Windows Restart Manager で取得）
+ */
+export interface LockingProcess {
+  pid: number;
+  name: string;
+}
+
+/**
+ * 一括操作（移動・コピー・削除）の項目ごとの結果
+ * - status: success=成功 / error=失敗 / skipped=何もしなかった（移動元と移動先が同じ等）
+ * - dest: 移動/コピー先のパス（移動・コピーのみ）
+ */
+export interface BatchItemResult {
+  path: string;
+  dest?: string;
+  status: "success" | "error" | "skipped";
+  message: string;
+  locked_by?: LockingProcess[];
+}
+
+/**
+ * 一括操作APIのレスポンス
+ * - 同期モード: status="completed" と結果
+ * - 非同期モード: status="async" と task_id（結果は /api/tasks/{id}/progress の result）
+ */
+export interface BatchOperationResponse {
+  status: string;
+  success_count?: number;
+  fail_count?: number;
+  results?: BatchItemResult[];
+  task_id?: string;
+  message?: string;
+}
+
+/**
+ * 一括操作の完了結果
+ */
+export interface BatchOperationResult {
+  success_count: number;
+  fail_count: number;
+  results: BatchItemResult[];
+}
diff --git a/frontend/src/utils/batchResult.test.ts b/frontend/src/utils/batchResult.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8a61ec6228a3ecc02924abd2df16d197ba13ee9a
--- /dev/null
+++ b/frontend/src/utils/batchResult.test.ts
@@ -0,0 +1,70 @@
+import { describe, expect, it } from "vitest";
+import type { BatchItemResult } from "../types/file";
+import {
+  classifyBatchResults,
+  collectLockingProcesses,
+  formatLockingProcesses,
+  getTransferHistoryData,
+} from "./batchResult";
+
+const results: BatchItemResult[] = [
+  { path: "/a/ok.txt", dest: "/b/ok.txt", status: "success", message: "移動完了" },
+  { path: "/a/same.txt", dest: "/b/same.txt", status: "error", message: "同名のファイルが存在します" },
+  { path: "/a/locked.xlsx", status: "error", message: "WinError 32", locked_by: [{ pid: 10, name: "EXCEL.EXE" }] },
+  { path: "/a/locked2.xlsx", status: "error", message: "WinError 32", locked_by: [{ pid: 10, name: "EXCEL.EXE" }, { pid: 11, name: "WORD.EXE" }] },
+  { path: "/a/broken", status: "error", message: "disk error" },
+  { path: "/b/noop", dest: "/b/noop", status: "skipped", message: "移動元と移動先が同じです" },
+];
+
+describe("classifyBatchResults", () => {
+  it("splits results into success, conflicts, locked and other errors", () => {
+    const classified = classifyBatchResults(results);
+
+    expect(classified.succeeded.map((r) => r.path)).toEqual(["/a/ok.txt"]);
+    expect(classified.conflicts.map((r) => r.path)).toEqual(["/a/same.txt"]);
+    expect(classified.locked.map((r) => r.path)).toEqual(["/a/locked.xlsx", "/a/locked2.xlsx"]);
+    expect(classified.otherErrors.map((r) => r.path)).toEqual(["/a/broken"]);
+  });
+
+  it("handles missing results", () => {
+    expect(classifyBatchResults(undefined).succeeded).toEqual([]);
+  });
+});
+
+describe("collectLockingProcesses", () => {
+  it("returns unique processes", () => {
+    const processes = collectLockingProcesses(classifyBatchResults(results).locked);
+
+    expect(processes).toEqual([
+      { pid: 10, name: "EXCEL.EXE" },
+      { pid: 11, name: "WORD.EXE" },
+    ]);
+    expect(formatLockingProcesses(processes)).toBe("・EXCEL.EXE (PID: 10)\n・WORD.EXE (PID: 11)");
+  });
+});
+
+describe("getTransferHistoryData", () => {
+  it("records only moved items so undo never touches files that were not moved", () => {
+    expect(getTransferHistoryData("move", results, "/b")).toEqual({
+      type: "MOVE",
+      data: { srcPaths: ["/a/ok.txt"], destParentPath: "/b" },
+    });
+  });
+
+  it("records only copied destinations so undo never deletes pre-existing files", () => {
+    expect(getTransferHistoryData("copy", results, "/b")).toEqual({
+      type: "COPY",
+      data: { copiedPaths: ["/b/ok.txt"], originalPaths: ["/a/ok.txt"] },
+    });
+  });
+
+  it("falls back to destPath + name when dest is missing", () => {
+    expect(
+      getTransferHistoryData("copy", [{ path: "C:\\data\\x.txt", status: "success", message: "" }], "D:/out"),
+    ).toEqual({ type: "COPY", data: { copiedPaths: ["D:/out/x.txt"], originalPaths: ["C:\\data\\x.txt"] } });
+  });
+
+  it("returns null when nothing succeeded", () => {
+    expect(getTransferHistoryData("move", results.filter((r) => r.status !== "success"), "/b")).toBeNull();
+  });
+});
diff --git a/frontend/src/utils/batchResult.ts b/frontend/src/utils/batchResult.ts
new file mode 100644
index 0000000000000000000000000000000000000000..128944627cca1bcd6e04f3b065bd7feb74625742
--- /dev/null
+++ b/frontend/src/utils/batchResult.ts
@@ -0,0 +1,108 @@
+/**
+ * 一括操作（移動・コピー・削除）の結果を画面表示用に分類するユーティリティ
+ *
+ * - classifyBatchResults: 成功 / 同名衝突（上書き確認の対象） / ロック中 / その他のエラー に分ける
+ * - collectLockingProcesses: ロック中の項目からプロセス一覧を重複なく集める
+ * - formatLockingProcesses: 確認ダイアログ用に「・名前 (PID: n)」形式の文字列にする
+ * - getTransferHistoryData: Undo履歴に記録する、実際に成功した項目だけのデータを作る
+ * - toBatchOperationResult: 同期APIレスポンスを完了結果の形にそろえる
+ */
+import type { BatchItemResult, BatchOperationResponse, BatchOperationResult, LockingProcess } from "../types/file";
+
+/** バックエンドが同名衝突時に返すメッセージ */
+export const CONFLICT_MESSAGE = "同名のファイルが存在します";
+
+export interface ClassifiedBatchResults {
+  succeeded: BatchItemResult[];
+  conflicts: BatchItemResult[];
+  locked: BatchItemResult[];
+  otherErrors: BatchItemResult[];
+}
+
+export function isConflictResult(item: BatchItemResult): boolean {
+  return item.status === "error" && (item.message ?? "").includes("存在します");
+}
+
+export function classifyBatchResults(results: BatchItemResult[] = []): ClassifiedBatchResults {
+  const succeeded: BatchItemResult[] = [];
+  const conflicts: BatchItemResult[] = [];
+  const locked: BatchItemResult[] = [];
+  const otherErrors: BatchItemResult[] = [];
+
+  for (const item of results) {
+    if (item.status === "success") {
+      succeeded.push(item);
+    } else if (item.status === "error") {
+      if (isConflictResult(item)) {
+        conflicts.push(item);
+      } else if (item.locked_by && item.locked_by.length > 0) {
+        locked.push(item);
+      } else {
+        otherErrors.push(item);
+      }
+    }
+  }
+  return { succeeded, conflicts, locked, otherErrors };
+}
+
+export function collectLockingProcesses(items: BatchItemResult[]): LockingProcess[] {
+  const byPid = new Map<number, LockingProcess>();
+  for (const item of items) {
+    for (const process of item.locked_by ?? []) {
+      if (!byPid.has(process.pid)) {
+        byPid.set(process.pid, process);
+      }
+    }
+  }
+  return Array.from(byPid.values());
+}
+
+export function formatLockingProcesses(processes: LockingProcess[]): string {
+  return processes.map((p) => `・${p.name} (PID: ${p.pid})`).join("\n");
+}
+
+function baseName(path: string): string {
+  const parts = path.split(/[\\/]/).filter(Boolean);
+  return parts[parts.length - 1] ?? "";
+}
+
+export type TransferHistoryData =
+  | { type: "MOVE"; data: { srcPaths: string[]; destParentPath: string } }
+  | { type: "COPY"; data: { copiedPaths: string[]; originalPaths: string[] } };
+
+/**
+ * Undo履歴に残すデータを作る。失敗・スキップした項目は含めない
+ * （失敗した項目を含めると、Undoで移動先に元からあった別のファイルを動かしたり削除してしまうため）。
+ */
+export function getTransferHistoryData(
+  op: "move" | "copy",
+  results: BatchItemResult[],
+  destPath: string,
+): TransferHistoryData | null {
+  const succeeded = results.filter((r) => r.status === "success");
+  if (succeeded.length === 0) {
+    return null;
+  }
+  if (op === "move") {
+    return {
+      type: "MOVE",
+      data: { srcPaths: succeeded.map((r) => r.path), destParentPath: destPath },
+    };
+  }
+  return {
+    type: "COPY",
+    data: {
+      copiedPaths: succeeded.map((r) => r.dest ?? `${destPath}/${baseName(r.path)}`),
+      originalPaths: succeeded.map((r) => r.path),
+    },
+  };
+}
+
+/** API レスポンス（同期モード）を完了結果の形にそろえる */
+export function toBatchOperationResult(response: BatchOperationResponse): BatchOperationResult {
+  return {
+    success_count: response.success_count ?? 0,
+    fail_count: response.fail_count ?? 0,
+    results: response.results ?? [],
+  };
+}
