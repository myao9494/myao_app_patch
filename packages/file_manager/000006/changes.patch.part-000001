diff --git a/frontend/src/utils/fileListFilter.test.ts b/frontend/src/utils/fileListFilter.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..56ed878b2bdf14c647795354163d3a16bf5f0c54
--- /dev/null
+++ b/frontend/src/utils/fileListFilter.test.ts
@@ -0,0 +1,65 @@
+import { describe, expect, it } from "vitest";
+import type { FileItem } from "../types/file";
+import { filterAndSortItems, getFileExtension, type FileListFilterOptions } from "./fileListFilter";
+
+const items: FileItem[] = [
+  { name: "b.md", type: "file", path: "/r/b.md", size: 30, modified: "2026-01-03T00:00:00" },
+  { name: "docs", type: "directory", path: "/r/docs", modified: "2026-01-01T00:00:00" },
+  { name: "A.txt", type: "file", path: "/r/A.txt", size: 10, modified: "2026-01-05T00:00:00" },
+  { name: "archive", type: "directory", path: "/r/archive", modified: "2026-01-09T00:00:00" },
+  { name: "c.MD", type: "file", path: "/r/c.MD", size: 20 },
+];
+
+const base: FileListFilterOptions = {
+  searchQuery: "",
+  isRegex: false,
+  typeFilter: "all",
+  extFilter: "all",
+  sortKey: "name",
+  sortOrder: "asc",
+};
+
+const names = (r: { folders: FileItem[]; files: FileItem[] }) => [...r.folders, ...r.files].map((i) => i.name);
+
+describe("filterAndSortItems", () => {
+  it("separates folders and files and sorts by name", () => {
+    expect(names(filterAndSortItems(items, base))).toEqual(["archive", "docs", "A.txt", "b.md", "c.MD"]);
+    expect(names(filterAndSortItems(items, { ...base, sortOrder: "desc" }))).toEqual(["docs", "archive", "c.MD", "b.md", "A.txt"]);
+  });
+
+  it("filters by case-insensitive substring or regex, falling back to substring for an invalid regex", () => {
+    expect(names(filterAndSortItems(items, { ...base, searchQuery: "MD" }))).toEqual(["b.md", "c.MD"]);
+    expect(names(filterAndSortItems(items, { ...base, isRegex: true, searchQuery: "^a" }))).toEqual(["archive", "A.txt"]);
+    expect(names(filterAndSortItems(items, { ...base, isRegex: true, searchQuery: "b.md(" }))).toEqual([]);
+    expect(names(filterAndSortItems(items, { ...base, isRegex: true, searchQuery: "[" }))).toEqual([]);
+  });
+
+  it("filters by type and by extension (extensions do not hide folders)", () => {
+    expect(names(filterAndSortItems(items, { ...base, typeFilter: "files" }))).toEqual(["A.txt", "b.md", "c.MD"]);
+    expect(names(filterAndSortItems(items, { ...base, typeFilter: "folders" }))).toEqual(["archive", "docs"]);
+    expect(names(filterAndSortItems(items, { ...base, extFilter: "md" }))).toEqual(["archive", "docs", "b.md", "c.MD"]);
+  });
+
+  it("sorts by size and by date, preferring aggregated folder dates", () => {
+    expect(names(filterAndSortItems(items, { ...base, sortKey: "size" }))).toEqual(["docs", "archive", "A.txt", "c.MD", "b.md"]);
+    expect(names(filterAndSortItems(items, { ...base, sortKey: "date" }))).toEqual(["docs", "archive", "c.MD", "b.md", "A.txt"]);
+    expect(
+      names(filterAndSortItems(items, { ...base, sortKey: "date", folderLatestModified: { "/r/docs": "2026-02-01T00:00:00" } })),
+    ).toEqual(["archive", "docs", "c.MD", "b.md", "A.txt"]);
+  });
+
+  it("does not mutate the source array", () => {
+    const copy = [...items];
+    filterAndSortItems(items, { ...base, sortKey: "size", sortOrder: "desc" });
+    expect(items).toEqual(copy);
+  });
+});
+
+describe("getFileExtension", () => {
+  it("returns the lowercase extension or an empty string", () => {
+    expect(getFileExtension("a.TXT")).toBe("txt");
+    expect(getFileExtension("archive.tar.gz")).toBe("gz");
+    expect(getFileExtension("README")).toBe("");
+    expect(getFileExtension("trailing.")).toBe("");
+  });
+});
diff --git a/frontend/src/utils/fileListFilter.ts b/frontend/src/utils/fileListFilter.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d2577f2c73f4c5d1977c66ec6d6377da36c1f06b
--- /dev/null
+++ b/frontend/src/utils/fileListFilter.ts
@@ -0,0 +1,99 @@
+/**
+ * ファイル一覧の絞り込み・並べ替え（FileList で使用する純粋関数）
+ * - 検索語: 正規表現モードでは大文字小文字を区別しない正規表現、無効な正規表現や通常モードでは部分一致
+ * - 種類: all / files / folders
+ * - 拡張子: "md+txt" のような + 区切りのリスト（"all" は無制限）。フォルダには適用しない
+ * - 並べ替え: name / size / date（date はフォルダ最新日時の集計結果があればそれを優先）
+ * - 結果はフォルダとファイルに分けて返す（画面ではフォルダを先に表示する）
+ */
+import type { FileItem } from "../types/file";
+
+export type FileListSortKey = "name" | "size" | "date";
+export type FileListSortOrder = "asc" | "desc";
+
+export interface FileListFilterOptions {
+  searchQuery: string;
+  isRegex: boolean;
+  typeFilter: string;
+  extFilter: string;
+  sortKey: FileListSortKey;
+  sortOrder: FileListSortOrder;
+  /** フォルダ最新日時（d キーで集計した値）。date 並べ替えで item.modified より優先する */
+  folderLatestModified?: Record<string, string>;
+}
+
+export function getFileExtension(name: string): string {
+  const lastDotIndex = name.lastIndexOf(".");
+  if (lastDotIndex < 0 || lastDotIndex === name.length - 1) {
+    return "";
+  }
+  return name.slice(lastDotIndex + 1).toLowerCase();
+}
+
+function compileSearchRegex(searchQuery: string, isRegex: boolean): RegExp | null {
+  if (!searchQuery || !isRegex) return null;
+  try {
+    return new RegExp(searchQuery, "i");
+  } catch {
+    return null;
+  }
+}
+
+function sortItems(items: FileItem[], options: FileListFilterOptions): void {
+  const { sortKey, sortOrder, folderLatestModified = {} } = options;
+  if (sortKey === "name") {
+    items.sort((a, b) => {
+      const res = a.name.localeCompare(b.name);
+      return sortOrder === "asc" ? res : -res;
+    });
+    return;
+  }
+
+  const decorated = items.map((item) => {
+    const modified = folderLatestModified[item.path] ?? item.modified;
+    return {
+      item,
+      sortValue: sortKey === "size" ? (item.size || 0) : (modified ? Date.parse(modified) || 0 : 0),
+    };
+  });
+  decorated.sort((a, b) => {
+    const res = a.sortValue - b.sortValue;
+    return sortOrder === "asc" ? res : -res;
+  });
+  items.splice(0, items.length, ...decorated.map(({ item }) => item));
+}
+
+export function filterAndSortItems(
+  sourceItems: readonly FileItem[],
+  options: FileListFilterOptions,
+): { folders: FileItem[]; files: FileItem[] } {
+  const { searchQuery, isRegex, typeFilter, extFilter } = options;
+  const compiledSearchRegex = compileSearchRegex(searchQuery, isRegex);
+  const normalizedSearchQuery = searchQuery.toLowerCase();
+  const allowedExtensions = extFilter === "all" ? null : new Set(extFilter.split("+").filter(Boolean));
+
+  const folders: FileItem[] = [];
+  const files: FileItem[] = [];
+
+  for (const item of sourceItems) {
+    if (searchQuery) {
+      const matches = compiledSearchRegex
+        ? compiledSearchRegex.test(item.name)
+        : item.name.toLowerCase().includes(normalizedSearchQuery);
+      if (!matches) continue;
+    }
+
+    if (typeFilter === "folders" && item.type !== "directory") continue;
+    if (typeFilter === "files" && item.type !== "file") continue;
+
+    if (allowedExtensions && item.type === "file" && !allowedExtensions.has(getFileExtension(item.name))) {
+      continue;
+    }
+
+    (item.type === "directory" ? folders : files).push(item);
+  }
+
+  sortItems(folders, options);
+  sortItems(files, options);
+  return { folders, files };
+}
