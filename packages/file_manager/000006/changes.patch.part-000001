+    if (!isMarkdownDoc || viewMode !== 'rendered' || !previewContainerRef.current) return;
+    const mermaidElements = previewContainerRef.current.querySelectorAll<HTMLElement>('.mermaid');
+    if (mermaidElements.length === 0) return;
+
+    let cancelled = false;
+    import('mermaid')
+      .then(({ default: mermaid }) => {
+        if (cancelled) return;
+        mermaid.initialize({
+          startOnLoad: false,
+          theme: settings.theme === 'dark' ? 'dark' : 'default',
+          securityLevel: 'loose',
+          fontFamily: 'inherit',
+        });
+        return mermaid.run({ nodes: Array.from(mermaidElements) });
+      })
+      .catch((err) => {
+        console.warn('Mermaid rendering error:', err);
+      });
+    return () => {
+      cancelled = true;
+    };
   }, [renderedHtml, isMarkdownDoc, viewMode, settings.theme]);
 
   return (
