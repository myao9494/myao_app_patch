-def get_string_hash(s: str) -> str:
-    """Obsidian Excalidraw Cards プラグイン互換の FNV-1a ハッシュ (32-bit unsigned hex)"""
-    h = 2166136261
-    for ch in s:
-        code = ord(ch)
-        h ^= code
-        h = (h * 16777619) & 0xFFFFFFFF
-    return hex(h)[2:]
-
-
-def find_obsidian_vault_root(start_path: Path) -> Optional[Path]:
-    """与えられたパスから上位を遡り、.obsidian フォルダを持つ Obsidian Vault ルートを検索する"""
-    curr = start_path if start_path.is_dir() else start_path.parent
-    for _ in range(8):
-        if (curr / ".obsidian").is_dir():
-            return curr
-        if curr.parent == curr:
-            break
-        curr = curr.parent
-
-    try:
-        obsidian_base = Path(settings.obsidian_base_dir)
-        curr = obsidian_base if obsidian_base.is_dir() else obsidian_base.parent
-        for _ in range(5):
-            if (curr / ".obsidian").is_dir():
-                return curr
-            if curr.parent == curr:
-                break
-            curr = curr.parent
-    except Exception:
-        pass
-
-    return None
-
-
-def resolve_excalidraw_preview_image(excal_path: Path, vault_root: Optional[Path]) -> Optional[Path]:
-    """
-    .excalidraw.md または .excalidraw ファイルに対応するプレビュー画像を探す
-    1. 同一ディレクトリの .png / .svg / .excalidraw.png / .excalidraw.svg
-    2. .excalidraw-cache/index.json による探索
-    3. .excalidraw-cache/[hash]_*_preview.png 探索
-    """
-    stem = excal_path.stem
-    if stem.endswith(".excalidraw"):
-        base_stem = stem[:-11]
-    else:
-        base_stem = stem
-
-    parent = excal_path.parent
-    # 1. 同一ディレクトリ内の同名画像
-    for ext in [".excalidraw.png", ".excalidraw.svg", ".png", ".svg"]:
-        candidate = parent / f"{base_stem}{ext}"
-        if candidate.is_file():
-            return candidate
-
-    if not vault_root:
-        vault_root = find_obsidian_vault_root(excal_path)
-
-    if vault_root and vault_root.is_dir():
-        v_res = vault_root.resolve()
-        e_res = excal_path.resolve()
-        cache_dir = v_res / ".excalidraw-cache"
-        if cache_dir.is_dir():
-            try:
-                rel_path = e_res.relative_to(v_res).as_posix()
-            except ValueError:
-                rel_path = excal_path.name
-
-            # 2. index.json
-            index_file = cache_dir / "index.json"
-            if index_file.is_file():
-                try:
-                    data = json.loads(index_file.read_text(encoding="utf-8", errors="ignore"))
-                    if rel_path in data and "cachefile" in data[rel_path]:
-                        cache_file = cache_dir / data[rel_path]["cachefile"]
-                        if cache_file.is_file():
-                            return cache_file
-                    target_name = excal_path.name
-                    for k, v in data.items():
-                        if k.endswith(target_name) or k.endswith(f"{base_stem}.excalidraw.md"):
-                            if "cachefile" in v:
-                                cache_file = cache_dir / v["cachefile"]
-                                if cache_file.is_file():
-                                    return cache_file
-                except Exception:
-                    pass
-
-            # 3. FNV-1a ハッシュで直接探索
-            hash_str = get_string_hash(rel_path)
-            matching_files = list(cache_dir.glob(f"{hash_str}_*_preview.*"))
-            if matching_files:
-                matching_files.sort(key=lambda p: p.stat().st_mtime, reverse=True)
-                return matching_files[0]
-
-    return None
-
-
-@router.get("/view-image")
-async def view_image(
-    path: str = Query(..., description="表示する画像ファイルのパス"),
-    baseDir: Optional[str] = Query(None, description="基準ディレクトリ（Obsidianノート等の親ディレクトリ）"),
-):
-    """
-    画像ファイルをブラウザ内でインライン表示
-    Obsidian Vault 内の画像パスや Excalidraw プレビューの自動解決に対応
-    """
-    raw_path_str = path.strip()
-    base_dir_path: Optional[Path] = None
-    vault_root: Optional[Path] = None
-
-    if baseDir:
-        try:
-            base_dir_path = normalize_path(baseDir)
-            if base_dir_path.exists():
-                vault_root = find_obsidian_vault_root(base_dir_path)
-        except Exception:
-            pass
-
-    # パスの正規化
-    target_path: Optional[Path] = None
-    try:
-        candidate = normalize_path(raw_path_str)
-        if candidate.exists():
-            target_path = candidate
-    except Exception:
-        pass
-
-    # 存在しない場合、baseDirからの相対パスやVaultルートからの相対パスを試行
-    if not target_path or not target_path.exists():
-        if base_dir_path and base_dir_path.is_dir():
-            candidate = base_dir_path / raw_path_str
-            if candidate.exists():
-                target_path = candidate
-
-        if (not target_path or not target_path.exists()) and vault_root and vault_root.is_dir():
-            candidate = vault_root / raw_path_str
-            if candidate.exists():
-                target_path = candidate
-
-    # .excalidraw ファイルで .excalidraw.md が存在する場合のフォールバック
-    if not target_path or not target_path.exists():
-        if raw_path_str.endswith(".excalidraw"):
-            try:
-                candidate = normalize_path(raw_path_str + ".md")
-                if candidate.exists():
-                    target_path = candidate
-            except Exception:
-                pass
-
-            if not target_path:
-                for base in [base_dir_path, vault_root]:
-                    if base and base.is_dir():
-                        candidate = base / (raw_path_str + ".md")
-                        if candidate.exists():
-                            target_path = candidate
-                            break
-
-    # ファイル名のみの指定で Vault 内を検索
-    if (not target_path or not target_path.exists()) and vault_root and "/" not in raw_path_str and "\\" not in raw_path_str:
-        for found in vault_root.rglob(raw_path_str):
-            if found.is_file():
-                target_path = found
-                break
-        if not target_path and (raw_path_str.endswith(".excalidraw") or "." not in raw_path_str):
-            for found in vault_root.rglob(f"{raw_path_str}.md"):
-                if found.is_file():
-                    target_path = found
-                    break
-
-    if not target_path or not target_path.exists():
-        raise HTTPException(status_code=404, detail="ファイルが見つかりません")
-
-    if target_path.is_dir():
-        raise HTTPException(status_code=400, detail="ディレクトリは表示できません")
-
-    # Excalidraw ファイル判定
-    is_excalidraw = (
-        target_path.name.lower().endswith(".excalidraw.md")
-        or target_path.name.lower().endswith(".excalidraw")
-    )
-    if is_excalidraw:
-        preview_image = resolve_excalidraw_preview_image(target_path, vault_root)
-        if preview_image and preview_image.is_file():
-            target_path = preview_image
-        else:
-            # キャッシュ画像がない場合、簡易SVGを動的生成して返す
-            title = target_path.stem.replace(".excalidraw", "")
-            svg_content = f'''<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
-  <rect width="100%" height="100%" fill="#1e1e1e" rx="12" stroke="#333" stroke-width="2"/>
-  <text x="50%" y="45%" fill="#66ff69" font-family="sans-serif" font-size="28" font-weight="bold" text-anchor="middle">🎨 Excalidraw Drawing</text>
-  <text x="50%" y="58%" fill="#d4d4d4" font-family="sans-serif" font-size="20" text-anchor="middle">{title}</text>
-  <text x="50%" y="70%" fill="#888" font-family="sans-serif" font-size="14" text-anchor="middle">（プレビューキャッシュ未生成 - タップしてExcalidrawで開く）</text>
-</svg>'''
-            return Response(content=svg_content, media_type="image/svg+xml")
-
-    ext = target_path.suffix.lower()
-    media_type = IMAGE_MEDIA_TYPES.get(ext)
-    if not media_type:
-        raise HTTPException(status_code=400, detail="画像ファイルではありません")
-
-    encoded_filename = urllib.parse.quote(target_path.name)
-    return FileResponse(
-        path=target_path,
-        filename=target_path.name,
-        media_type=media_type,
-        headers={
-            "Content-Disposition": f"inline; filename*=UTF-8''{encoded_filename}",
-            "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800",
-        }
-    )
-
