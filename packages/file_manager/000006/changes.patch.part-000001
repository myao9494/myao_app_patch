+import { describe, expect, it } from "vitest";
+import { formatFileSize } from "./formatFileSize";
+
+describe("formatFileSize", () => {
+  it("formats bytes, kilobytes and megabytes", () => {
+    expect(formatFileSize(undefined)).toBe("-");
+    expect(formatFileSize(0)).toBe("0 B");
+    expect(formatFileSize(1023)).toBe("1023 B");
+    expect(formatFileSize(1536)).toBe("1.5 KB");
+    expect(formatFileSize(5 * 1024 * 1024)).toBe("5.0 MB");
+  });
+});
diff --git a/frontend/src/utils/formatFileSize.ts b/frontend/src/utils/formatFileSize.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2cf4f08e278e494381953d2c3b770abd9a15a599
--- /dev/null
+++ b/frontend/src/utils/formatFileSize.ts
@@ -0,0 +1,9 @@
+/**
+ * ファイルサイズを B / KB / MB で表示用に整形する（未取得は "-"）
+ */
+export function formatFileSize(bytes?: number): string {
+  if (bytes === undefined) return "-";
+  if (bytes < 1024) return `${bytes} B`;
+  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
+  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
+}
diff --git a/frontend/src/utils/gitStatusDisplay.test.ts b/frontend/src/utils/gitStatusDisplay.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..adcb686367460afbe0e0861d9f4f73325d78230b
--- /dev/null
+++ b/frontend/src/utils/gitStatusDisplay.test.ts
@@ -0,0 +1,41 @@
+import { describe, expect, it } from "vitest";
+import { getGitStatusLabel, getGitStatusTitle, getGitSyncAction, type FolderGitStatus } from "./gitStatusDisplay";
+
+const status = (overrides: Partial<FolderGitStatus> = {}): FolderGitStatus => ({
+  changedFiles: [],
+  hasMoreChanges: false,
+  aheadCount: 0,
+  behindCount: 0,
+  ...overrides,
+});
+
+describe("getGitStatusLabel", () => {
+  it("labels clean, changed, ahead, behind and diverged folders", () => {
+    expect(getGitStatusLabel(undefined)).toBe("-");
+    expect(getGitStatusLabel(status())).toBe("-");
+    expect(getGitStatusLabel(status({ changedFiles: ["a.ts"] }))).toBe("G");
+    expect(getGitStatusLabel(status({ hasMoreChanges: true }))).toBe("G");
+    expect(getGitStatusLabel(status({ aheadCount: 1 }))).toBe("Push");
+    expect(getGitStatusLabel(status({ behindCount: 2 }))).toBe("Pull");
+    expect(getGitStatusLabel(status({ aheadCount: 1, behindCount: 2, changedFiles: ["x"] }))).toBe("C");
+  });
+});
+
+describe("getGitSyncAction", () => {
+  it("returns push / pull / sync, or null to open VS Code", () => {
+    expect(getGitSyncAction(status({ changedFiles: ["a"] }))).toBeNull();
+    expect(getGitSyncAction(status({ aheadCount: 1 }))).toBe("push");
+    expect(getGitSyncAction(status({ behindCount: 1 }))).toBe("pull");
+    expect(getGitSyncAction(status({ aheadCount: 1, behindCount: 1 }))).toBe("sync");
+  });
+});
+
+describe("getGitStatusTitle", () => {
+  it("lists counts, changed files and the click action", () => {
+    expect(getGitStatusTitle(status({ aheadCount: 2, changedFiles: ["a.ts", "b.ts"], hasMoreChanges: true }))).toBe(
+      "未Push: 2件\n\n変更ファイル:\na.ts\nb.ts\n…\n\nクリックしてターミナル用Gitコマンドをコピー",
+    );
+    expect(getGitStatusTitle(status({ changedFiles: ["a.ts"] }))).toBe("変更ファイル:\na.ts\n\nクリックしてVS Codeで開く");
+    expect(getGitStatusTitle(undefined)).toBe("");
+  });
+});
diff --git a/frontend/src/utils/gitStatusDisplay.ts b/frontend/src/utils/gitStatusDisplay.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1f64d07d764b68cadcb1a73a13bcc990104e6fd6
--- /dev/null
+++ b/frontend/src/utils/gitStatusDisplay.ts
@@ -0,0 +1,49 @@
+/**
+ * ファイル一覧の Git 列の表示（G キーで確認したフォルダの状態）
+ * - ラベル: "-"（Git管理外・差分なし）/ "G"（作業ツリーに変更）/ "Push"（未Push）/ "Pull"（未Pull）/ "C"（両方）
+ * - ツールチップ: 未Push/未Pull件数・変更ファイル一覧・クリック時の動作
+ * - クリック時の動作: 未Push/未Pullがあればターミナル用 Git コマンドのコピー、なければ VS Code で開く
+ */
+import type { GitSyncAction } from "./gitCommands";
+
+export interface FolderGitStatus {
+  changedFiles: string[];
+  hasMoreChanges: boolean;
+  aheadCount: number;
+  behindCount: number;
+}
+
+export type GitStatusLabel = "-" | "G" | "Push" | "Pull" | "C";
+
+export function getGitStatusLabel(status: FolderGitStatus | undefined): GitStatusLabel {
+  if (!status || (!status.hasMoreChanges && status.changedFiles.length === 0 && status.aheadCount === 0 && status.behindCount === 0)) {
+    return "-";
+  }
+  if (status.aheadCount > 0 && status.behindCount > 0) return "C";
+  if (status.aheadCount > 0) return "Push";
+  if (status.behindCount > 0) return "Pull";
+  return "G";
+}
+
+/** クリック時に実行する Git 同期操作（なければ null = VS Code で開く） */
+export function getGitSyncAction(status: FolderGitStatus | undefined): GitSyncAction | null {
+  if (!status || (status.aheadCount === 0 && status.behindCount === 0)) return null;
+  if (status.aheadCount > 0 && status.behindCount > 0) return "sync";
+  return status.aheadCount > 0 ? "push" : "pull";
+}
+
+export function getGitStatusTitle(status: FolderGitStatus | undefined): string {
+  if (!status) return "";
+  const lines: string[] = [];
+  if (status.aheadCount > 0) lines.push(`未Push: ${status.aheadCount}件`);
+  if (status.behindCount > 0) lines.push(`未Pull: ${status.behindCount}件`);
+  if (status.changedFiles.length > 0) {
+    if (lines.length > 0) lines.push("");
+    lines.push("変更ファイル:", ...status.changedFiles);
+    if (status.hasMoreChanges) lines.push("…");
+  }
+  const clickHint = getGitSyncAction(status)
+    ? "クリックしてターミナル用Gitコマンドをコピー"
+    : "クリックしてVS Codeで開く";
+  return [...lines, "", clickHint].join("\n");
+}
