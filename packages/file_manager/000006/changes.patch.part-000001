+
+    it('converts Windows UNC path to file URI', () => {
+        expect(formatPathAsFileUri('\\\\server\\share\\note.md')).toBe('file://server/share/note.md');
+        expect(formatPathAsFileUri('//server/share/note.md')).toBe('file://server/share/note.md');
