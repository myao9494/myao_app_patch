@@ -89,3 +89,21 @@ describe('setupFetchTimeout', () => {
     expect(isPending).toBe(true);
   });
 });
+
+describe('isTimeoutExempt', () => {
+  it('exempts long-running write operations so the UI never reports a false failure', () => {
+    expect(isTimeoutExempt('/api/upload?path=/x')).toBe(true);
+    expect(isTimeoutExempt('/api/move/batch')).toBe(true);
+    expect(isTimeoutExempt('/api/move')).toBe(true);
+    expect(isTimeoutExempt('/api/copy/batch')).toBe(true);
+    expect(isTimeoutExempt('/api/delete/batch')).toBe(true);
+    expect(isTimeoutExempt('http://host:8001/api/update-file')).toBe(true);
+    expect(isTimeoutExempt('/api/unzip')).toBe(true);
+  });
+
+  it('keeps the timeout for listing and lookups', () => {
+    expect(isTimeoutExempt('/api/files?path=/api/move')).toBe(false);
+    expect(isTimeoutExempt('/api/path-info?path=/x')).toBe(false);
+    expect(isTimeoutExempt('/api/movement')).toBe(false);
+  });
+});
diff --git a/frontend/src/utils/fetchTimeout.ts b/frontend/src/utils/fetchTimeout.ts
index a35eee22093813505c0db594e4841c042286be1e..b897b9334b13dbb6cca9657c55a5442b60a7c71c 100644
--- a/frontend/src/utils/fetchTimeout.ts
+++ b/frontend/src/utils/fetchTimeout.ts
@@ -2,13 +2,36 @@
  * APIリクエストのタイムアウト処理
  * - globalThis.fetch をラップし、一定時間応答がない場合に AbortController によりリクエストを中断する
  * - タイムアウト時間は設定ファイル（settings.json）から動的に読み込む
- * - アップロード処理（/api/upload）など、一部の重いAPIは除外する
+ * - 次のAPIはタイムアウトを適用しない（isTimeoutExempt）
+ *   - アップロード（/api/upload）: 大容量で時間がかかる
+ *   - 移動・コピー・削除・ファイル保存・解凍: 途中で通信だけ切るとサーバー側では処理が続き、
+ *     「失敗」と表示されたのに実際は完了している、という食い違いが起きるため
  */
 
 import { getApiTimeout } from '../config';
 
 let isPatched = false;
 
+/** タイムアウトを適用しないAPIのパス */
+const TIMEOUT_EXEMPT_PATHS = [
+  '/api/upload',
+  '/api/move',
+  '/api/copy/batch',
+  '/api/delete',
+  '/api/update-file',
