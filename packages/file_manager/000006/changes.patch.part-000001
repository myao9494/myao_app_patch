diff --git a/backend/tests/test_history.py b/backend/tests/test_history.py
new file mode 100644
index 0000000000000000000000000000000000000000..8c33108d4cbe1b821cc1e683c16839068221697a
--- /dev/null
+++ b/backend/tests/test_history.py
@@ -0,0 +1,47 @@
+"""
+フォルダ履歴APIのテスト
+- 保存・読み込みの往復、旧形式（文字列リスト）の変換、壊れたデータへの耐性
+- 保存先が起動時のカレントディレクトリに依存しないこと
+"""
+import json
+
+import pytest
+
+from app.routers import history
+
+
+@pytest.fixture
+def history_file(tmp_path, monkeypatch):
+    path = tmp_path / "folder_history.json"
+    monkeypatch.setattr(history, "HISTORY_FILE", path)
+    return path
+
+
+def test_save_and_load_roundtrip(client, history_file):
+    payload = {"history": [{"path": "/a", "count": 3, "timestamp": 1.5}]}
+
+    assert client.post("/api/history", json=payload).json() == {"status": "success"}
+
+    assert client.get("/api/history").json() == [{"path": "/a", "count": 3, "timestamp": 1.5}]
+    assert sorted(p.name for p in history_file.parent.iterdir()) == ["folder_history.json"]
+
+
+def test_converts_legacy_string_list(client, history_file):
+    history_file.write_text(json.dumps(["/a", "/b"]), encoding="utf-8")
+
+    data = client.get("/api/history").json()
+
+    assert [item["path"] for item in data] == ["/a", "/b"]
+    assert all(item["count"] == 1 for item in data)
+
+
+def test_skips_broken_entries_and_files(client, history_file):
+    history_file.write_text(json.dumps([{"path": "/ok"}, {"count": "x"}, 5]), encoding="utf-8")
+    assert [item["path"] for item in client.get("/api/history").json()] == ["/ok"]
+
+    history_file.write_text("{broken", encoding="utf-8")
+    assert client.get("/api/history").json() == []
+
+
+def test_history_file_is_next_to_backend_package():
+    assert history.HISTORY_FILE.parent.name == "backend"
diff --git a/backend/tests/test_obsidian_index.py b/backend/tests/test_obsidian_index.py
new file mode 100644
index 0000000000000000000000000000000000000000..d646a14540d6483444d82efc00f94057a9163d42
--- /dev/null
+++ b/backend/tests/test_obsidian_index.py
@@ -0,0 +1,80 @@
+"""
+Obsidian Vault のファイル名索引（画像埋め込みの高速解決）のテスト
+- 2回目以降は Vault を再走査しない
+- `[` などを含むファイル名もそのまま検索できる（globとして解釈しない）
+- 新しく追加されたファイル・削除されたファイルに追従する
+- プレビュー未生成時の代替SVGでファイル名をエスケープする
+"""
+import pytest
+
+from app.services import obsidian
+
+
+@pytest.fixture(autouse=True)
+def fresh_index(monkeypatch):
+    obsidian.clear_vault_indexes()
+    monkeypatch.setattr(obsidian, "VAULT_INDEX_MIN_REBUILD_SECONDS", 0.0)
+    yield
+    obsidian.clear_vault_indexes()
+
+
+@pytest.fixture
+def vault(tmp_path):
+    (tmp_path / ".obsidian").mkdir()
+    (tmp_path / "notes" / "assets").mkdir(parents=True)
+    (tmp_path / "notes" / "assets" / "Pasted image [1].png").write_bytes(b"png")
+    return tmp_path
+
+
+def test_finds_names_with_glob_characters(vault):
+    found = obsidian.find_file_in_vault(vault, "Pasted image [1].png")
+
+    assert found == vault / "notes" / "assets" / "Pasted image [1].png"
+
+
+def test_does_not_rescan_vault_for_cached_names(vault, monkeypatch):
+    walks = []
+    original_walk = obsidian.os.walk
+    monkeypatch.setattr(obsidian.os, "walk", lambda *a, **k: walks.append(a) or original_walk(*a, **k))
+
+    obsidian.find_file_in_vault(vault, "Pasted image [1].png")
+    obsidian.find_file_in_vault(vault, "Pasted image [1].png")
+
+    assert len(walks) == 1
+
+
+def test_picks_up_new_and_removed_files(vault):
+    assert obsidian.find_file_in_vault(vault, "new.png") is None
+
+    (vault / "new.png").write_bytes(b"png")
+    assert obsidian.find_file_in_vault(vault, "new.png") == vault / "new.png"
+
+    (vault / "new.png").unlink()
+    assert obsidian.find_file_in_vault(vault, "new.png") is None
+
+
+def test_prefers_file_closest_to_vault_root(vault):
+    (vault / "dup.png").write_bytes(b"root")
+    (vault / "notes" / "dup.png").write_bytes(b"deep")
+
+    assert obsidian.find_file_in_vault(vault, "dup.png") == vault / "dup.png"
+
+
+def test_view_image_resolves_name_only_embed(client, vault):
+    response = client.get(
+        "/api/view-image", params={"path": "Pasted image [1].png", "baseDir": str(vault / "notes")}
+    )
+
+    assert response.status_code == 200
+    assert response.content == b"png"
+
+
+def test_placeholder_svg_escapes_file_name(client, tmp_path):
+    drawing = tmp_path / "<script>alert(1)<script>.excalidraw.md"
+    drawing.write_text("{}", encoding="utf-8")
+
+    response = client.get("/api/view-image", params={"path": str(drawing)})
+
+    assert response.status_code == 200
+    assert "<script>" not in response.text
+    assert "&lt;script&gt;" in response.text
