+ * ファイル/フォルダ一覧をMarkdown形式（チェックボックス／箇条書き／リンク付き）へ変換するユーティリティ
  */
 import type { FileItem } from "../types/file";
+import { formatPathAsFileUri } from "./pathUtils";
 
 /**
  * ファイル/フォルダ一覧をMarkdownチェックボックス形式（- [ ] {name}）へ変換
@@ -20,3 +21,21 @@ export function formatItemsAsMarkdownBulletList(items: Pick<FileItem, "name" | "
     .map((item) => `- ${item.name}`)
     .join("\n");
 }
+
+/**
+ * ファイル/フォルダ一覧をフルパス付きMarkdownリンク形式（- [{name}]({fileUri})）へ変換
+ * - Obsidian貼り付け用に file:/// URI 形式のリンクを生成
+ * - パスにスペースや丸括弧を含む場合は CommonMark 準拠の <file:///...> で囲む
+ * - ファイル名に含まれる角括弧（[ ]）は Markdown 構文破壊を防ぐためエスケープ
+ */
+export function formatItemsAsMarkdownLinkList(items: Pick<FileItem, "name" | "path">[]): string {
+  return items
+    .map((item) => {
+      const uri = formatPathAsFileUri(item.path);
+      const target = uri.includes(" ") || uri.includes("(") || uri.includes(")") ? `<${uri}>` : uri;
+      const safeName = item.name.replace(/([[\]])/g, "\\$1");
+      return `- [${safeName}](${target})`;
+    })
+    .join("\n");
+}
+
diff --git a/frontend/src/utils/navigationHistory.test.ts b/frontend/src/utils/navigationHistory.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8382eeec14d9cbb9363fe509e287f1eef1442164
--- /dev/null
+++ b/frontend/src/utils/navigationHistory.test.ts
@@ -0,0 +1,65 @@
+import { describe, expect, it } from "vitest";
+import {
+  MAX_NAVIGATION_ENTRIES,
+  canGoBack,
+  canGoForward,
+  createNavigation,
+  pushNavigation,
+  stepNavigation,
+} from "./navigationHistory";
+
+const none = { focusedIndex: 0, selectedItems: [] };
+
+describe("navigationHistory", () => {
+  it("移動するとエントリが増え、離れたフォルダのカーソルと選択を保存する", () => {
+    let state = createNavigation("/a");
+    state = pushNavigation(state, { focusedIndex: 3, selectedItems: new Set(["/a/x"]) }, "/a/b");
+    expect(state.index).toBe(1);
+    expect(state.entries).toEqual([
+      { path: "/a", focusedIndex: 3, selectedItems: ["/a/x"] },
+      { path: "/a/b", focusedIndex: 0, selectedItems: [] },
+    ]);
+    expect(canGoBack(state)).toBe(true);
+    expect(canGoForward(state)).toBe(false);
+  });
+
+  it("戻る/進むで移動先のエントリを返し、今のフォルダの状態を保存する", () => {
+    let state = pushNavigation(createNavigation("/a"), { focusedIndex: 2, selectedItems: [] }, "/b");
+    const back = stepNavigation(state, { focusedIndex: 5, selectedItems: ["/b/y"] }, -1);
+    expect(back?.target).toEqual({ path: "/a", focusedIndex: 2, selectedItems: [] });
+    state = back!.state;
+    expect(state.index).toBe(0);
+    expect(state.entries[1]).toEqual({ path: "/b", focusedIndex: 5, selectedItems: ["/b/y"] });
+
+    const forward = stepNavigation(state, none, 1);
+    expect(forward?.target.path).toBe("/b");
+    expect(forward?.target.selectedItems).toEqual(["/b/y"]);
+  });
+
+  it("端ではそれ以上戻れない/進めない", () => {
+    const state = createNavigation("/a");
+    expect(stepNavigation(state, none, -1)).toBeNull();
+    expect(stepNavigation(state, none, 1)).toBeNull();
+  });
+
+  it("戻った位置から別のフォルダへ移動すると、進む側の履歴を捨てる", () => {
+    let state = createNavigation("/a");
+    state = pushNavigation(state, none, "/b");
+    state = pushNavigation(state, none, "/c");
+    state = stepNavigation(state, none, -1)!.state;
+    state = stepNavigation(state, none, -1)!.state;
+    state = pushNavigation(state, none, "/d");
+    expect(state.entries.map((e) => e.path)).toEqual(["/a", "/d"]);
+    expect(state.index).toBe(1);
+  });
+
+  it(`最大 ${MAX_NAVIGATION_ENTRIES} 件まで保持し、古いものから捨てる`, () => {
+    let state = createNavigation("/0");
+    for (let i = 1; i <= MAX_NAVIGATION_ENTRIES + 5; i++) {
+      state = pushNavigation(state, none, `/${i}`);
+    }
+    expect(state.entries).toHaveLength(MAX_NAVIGATION_ENTRIES);
+    expect(state.entries[0].path).toBe("/6");
+    expect(state.index).toBe(MAX_NAVIGATION_ENTRIES - 1);
+  });
+});
diff --git a/frontend/src/utils/navigationHistory.ts b/frontend/src/utils/navigationHistory.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9a65ea90ddc7876c3cca66cc2320574b3f7a5980
--- /dev/null
+++ b/frontend/src/utils/navigationHistory.ts
@@ -0,0 +1,67 @@
+/**
+ * フォルダ移動の戻る/進む履歴（ペインごと）
+ * - 各エントリはパスに加えて、そのフォルダを離れたときのカーソル位置と選択項目を持つ
+ *   （戻る/進むで戻ってきたときに復元する）
+ * - 新しいフォルダへ移動すると、現在位置より先（進む側）の履歴は捨てる
+ * - 最大 100 件。超えたら古いものから捨てる
+ */
+
+export interface NavigationEntry {
+  path: string;
+  focusedIndex: number;
+  selectedItems: string[];
+}
+
+export interface NavigationState {
+  entries: NavigationEntry[];
+  index: number;
+}
+
+/** フォルダを離れるときに保存する状態 */
+export interface NavigationSnapshot {
+  focusedIndex: number;
+  selectedItems: Iterable<string>;
+}
+
+export const MAX_NAVIGATION_ENTRIES = 100;
+
+export function createNavigation(path: string): NavigationState {
+  return { entries: [{ path, focusedIndex: 0, selectedItems: [] }], index: 0 };
+}
+
+function saveCurrent(state: NavigationState, snapshot: NavigationSnapshot): NavigationEntry[] {
+  return state.entries.map((entry, i) =>
+    i === state.index
+      ? { ...entry, focusedIndex: snapshot.focusedIndex, selectedItems: Array.from(snapshot.selectedItems) }
+      : entry
+  );
+}
+
+/** 新しいフォルダへ移動する */
+export function pushNavigation(state: NavigationState, snapshot: NavigationSnapshot, path: string): NavigationState {
+  const entries = [
+    ...saveCurrent(state, snapshot).slice(0, state.index + 1),
+    { path, focusedIndex: 0, selectedItems: [] },
+  ].slice(-MAX_NAVIGATION_ENTRIES);
+  return { entries, index: entries.length - 1 };
+}
+
+/** 戻る（delta = -1）/ 進む（delta = 1）。移動できなければ null */
+export function stepNavigation(
+  state: NavigationState,
+  snapshot: NavigationSnapshot,
+  delta: -1 | 1
+): { state: NavigationState; target: NavigationEntry } | null {
+  const index = state.index + delta;
+  const target = state.entries[index];
+  if (!target) return null;
+  return { state: { entries: saveCurrent(state, snapshot), index }, target };
+}
+
+export function canGoBack(state: NavigationState): boolean {
+  return state.index > 0;
+}
+
+export function canGoForward(state: NavigationState): boolean {
+  return state.index < state.entries.length - 1;
+}
