diff --git a/backend/ensure_venv.sh b/backend/ensure_venv.sh
new file mode 100755
index 0000000000000000000000000000000000000000..f13b4a20c18d4314f7bfcee27c388bda083f9e4b
--- /dev/null
+++ b/backend/ensure_venv.sh
@@ -0,0 +1,46 @@
+#!/bin/bash
+# backend/.venv を用意する（macOS/Linux 用）。
+#
+# start.sh / start_dev.sh から source して ensure_backend_venv を呼ぶ。単独で実行してもよい。
+# 呼んだあとは BACKEND_PYTHON に backend/.venv/bin/python が入り、サーバーはこの Python で起動する
+# （uv run やシステムの python には頼らない）。
+#
+# 仕様:
+# - uv がある場合: 毎回 `uv sync --frozen --inexact` で uv.lock どおりに揃える。
+#   Python は backend/.python-version（3.14.9）を使う。venv が壊れている・バージョンが違う場合は uv が作り直す。
+#   --inexact なので、手で追加したパッケージは消さない。
+# - uv がない場合: .venv の Python が動かなければ `python3 -m venv --clear` で作り直し、
+#   fastapi / uvicorn が import できなければ requirements.txt を pip で入れる。
+
+ensure_backend_venv() {
+    local backend_dir
+    backend_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+    local venv_python="$backend_dir/.venv/bin/python"
+
+    if command -v uv >/dev/null 2>&1; then
+        echo "Syncing backend/.venv with uv.lock..."
+        (cd "$backend_dir" && uv sync --frozen --inexact --quiet)
+    else
+        if ! "$venv_python" -c "" >/dev/null 2>&1; then
+            echo "Creating backend/.venv with $(python3 -V 2>&1)..."
+            python3 -m venv --clear "$backend_dir/.venv"
+        fi
+        if ! "$venv_python" -c "import fastapi, uvicorn" >/dev/null 2>&1; then
+            echo "Installing backend requirements into backend/.venv..."
+            "$venv_python" -m pip install -r "$backend_dir/requirements.txt"
+        fi
+    fi
+
+    if ! "$venv_python" -c "import fastapi, uvicorn" >/dev/null 2>&1; then
+        echo "backend/.venv の準備に失敗しました: $venv_python" >&2
+        return 1
+    fi
+    BACKEND_PYTHON="$venv_python"
+    echo "Backend Python: $("$BACKEND_PYTHON" -V 2>&1) ($BACKEND_PYTHON)"
+}
+
+# 単独で実行されたときは venv を用意するだけ
+if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
+    set -Eeuo pipefail
+    ensure_backend_venv
+fi
diff --git a/backend/requirements-lock.txt b/backend/requirements-lock.txt
new file mode 100644
index 0000000000000000000000000000000000000000..2781f634488df3ee89d2f4039d6a868f57256f41
--- /dev/null
+++ b/backend/requirements-lock.txt
@@ -0,0 +1,44 @@
+# uv.lock から書き出した版固定の依存一覧（Windows の setup_windows.bat が pip で入れる）
+#
+# 会社の Windows 端末には uv が無いため、uv.lock と同じ版をこのファイルで再現する。
+# requirements.txt は下限だけなので、そちらを pip で入れると新しすぎる版（pydantic 2.14 など）が入りテストが通らない。
+# 全パッケージに Python 3.14 / Windows (win_amd64) 用のビルド済み wheel がある版を使っている。
+#
+# uv.lock を更新したら、uv のある端末（Mac）で書き出し直す:
+#   cd backend
+#   { grep '^#' requirements-lock.txt; uv export --frozen --no-hashes --no-emit-project --no-header --no-annotate; } > requirements-lock.txt.new && mv requirements-lock.txt.new requirements-lock.txt
+#   （冒頭のコメントはそのまま残る。tests/test_requirements_lock.py が uv.lock との一致を確かめる）
