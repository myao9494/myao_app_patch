+# backend/.venv を用意し、その Python で起動する（詳細は backend/ensure_venv.sh）
+source "$PROJECT_DIR/backend/ensure_venv.sh"
+ensure_backend_venv
+PYTHONPATH=. "$BACKEND_PYTHON" -m uvicorn app.main:app --reload --host 127.0.0.1 --port $BACKEND_PORT &
 BACKEND_PID=$!
 cd "$PROJECT_DIR"
 
