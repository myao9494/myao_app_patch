+        location: { origin: "http://localhost:5173" },
+      });
+
+      const mockResponse = {
+        folder: "/test/dir",
+        depth: 1,
+        total: 1,
+        images: [{ name: "photo.jpg", path: "/test/dir/photo.jpg", type: "file" }],
+      };
+
+      const fetchMock = vi.fn().mockResolvedValue({
+        ok: true,
+        headers: new Headers({ "content-type": "application/json" }),
+        json: async () => mockResponse,
+      });
+      vi.stubGlobal("fetch", fetchMock);
+
+      const { getFolderImages } = await import("./files");
+      const result = await getFolderImages("/test/dir", 1);
+
+      expect(fetchMock).toHaveBeenCalledWith(
+        expect.stringContaining("/api/folder-images?path=%2Ftest%2Fdir&depth=1")
+      );
+      expect(result).toEqual(mockResponse);
+    });
+
+    it("throws a clear error when response is not JSON (e.g. HTML)", async () => {
+      vi.stubGlobal("window", {
+        location: { origin: "http://localhost:5173" },
+      });
+
+      const fetchMock = vi.fn().mockResolvedValue({
+        ok: true,
+        status: 200,
+        headers: new Headers({ "content-type": "text/html; charset=utf-8" }),
+        text: async () => "<!doctype html><html></html>",
+      });
+      vi.stubGlobal("fetch", fetchMock);
+
+      const { getFolderImages } = await import("./files");
+      await expect(getFolderImages("/test/dir", 0)).rejects.toThrow(
+        /不正な応答|画像一覧APIにアクセスできません/
+      );
+    });
+  });
 });
