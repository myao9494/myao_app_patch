diff --git a/frontend/src/api/files.ts b/frontend/src/api/files.ts
index 617fffac44b93775f2a1f8b576d46c2b1048c5d7..7d214c9cda313037529718a8a34eb8f2b082ab2c 100644
--- a/frontend/src/api/files.ts
+++ b/frontend/src/api/files.ts
@@ -6,7 +6,7 @@
  *     → indexService.ts を参照
  * PWA配信時は同一オリジンのため相対パスを使用
  */
-import type { DirectoryResponse, SearchResponse, SearchParams, PathInfoResponse } from "../types/file";
+import type { DirectoryResponse, SearchResponse, SearchParams, PathInfoResponse, FolderImagesResponse } from "../types/file";
 import { API_BASE_URL } from "../config";
 import type { EditorLanguage } from "../utils/codeEditorHighlight";
 import type { MarkdownOpenMode, TextFileOpenMode } from "../utils/editorPreferences";
@@ -780,3 +780,29 @@ export async function getObsidianDailyPath(): Promise<{ path: string }> {
 
   return response.json();
 }
+
+/**
+ * 指定ディレクトリ配下の画像一覧を取得（階層depth指定対応）
+ */
+export async function getFolderImages(path: string, depth: number = 0): Promise<FolderImagesResponse> {
+  const url = new URL(`${API_URL}/folder-images`, window.location.origin);
+  url.searchParams.set("path", path);
+  url.searchParams.set("depth", String(depth));
+
+  const response = await fetch(url.toString());
+  const contentType = response.headers?.get?.("content-type") || "";
+
+  if (!contentType.includes("application/json")) {
+    if (!response.ok) {
+      throw new Error(`画像一覧APIにアクセスできません (${response.status})`);
+    }
+    throw new Error("サーバーから不正な応答（HTML）が返されました。バックエンドの再起動が必要です。");
+  }
+
+  const data = await response.json();
+  if (!response.ok) {
+    throw new Error(data.detail || "フォルダ内画像の取得に失敗しました");
+  }
+
+  return data;
+}
