diff --git a/utils/checkMarkUtils.test.ts b/utils/checkMarkUtils.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c8d1ff00ff5e907b610126dafbcffea85e3f4c75
--- /dev/null
+++ b/utils/checkMarkUtils.test.ts
@@ -0,0 +1,58 @@
+/**
+ * チェックマーク（✓）ユーティリティのテスト
+ *
+ * 仕様:
+ * - createCheckMarkElement: クリック位置を中心に、3 点の折れ線（✓）の line 要素を作る。
+ *   色は赤（#e03131）、太さ 3px、矢じりなし。customData.checkMark = true で識別できる。
+ * - isCheckMarkElement: 上記の要素かを判定する。
+ */
+import { describe, expect, it } from 'vitest';
+import {
+  CHECK_MARK_COLOR,
+  CHECK_MARK_SIZE,
+  createCheckMarkElement,
+  isCheckMarkElement,
+} from './checkMarkUtils';
+
+describe('checkMarkUtils', () => {
+  it('クリック位置を中心にした 3 点の line 要素を作る', () => {
+    const element = createCheckMarkElement(100, 200) as any;
+
+    expect(element.type).toBe('line');
+    expect(element.points).toHaveLength(3);
+    expect(element.x + element.width / 2).toBeCloseTo(100);
+    expect(element.y + element.height / 2).toBeCloseTo(200);
+    expect(element.width).toBeCloseTo(CHECK_MARK_SIZE);
+    expect(element.height).toBeCloseTo(CHECK_MARK_SIZE);
+  });
+
+  it('✓ の形（左上から谷へ下り、右上へ上がる）になる', () => {
+    const { points } = createCheckMarkElement(0, 0) as any;
+    const [start, valley, end] = points;
+
+    expect(valley[1]).toBeGreaterThan(start[1]);
+    expect(valley[1]).toBeGreaterThan(end[1]);
+    expect(start[0]).toBeLessThan(valley[0]);
+    expect(valley[0]).toBeLessThan(end[0]);
+  });
+
+  it('既定は赤・矢じりなしで、色と太さを指定できる', () => {
+    const base = createCheckMarkElement(0, 0) as any;
+    expect(base.strokeColor).toBe(CHECK_MARK_COLOR);
+    expect(base.startArrowhead).toBeNull();
+    expect(base.endArrowhead).toBeNull();
+
+    const custom = createCheckMarkElement(0, 0, { color: '#2f9e44', strokeWidth: 5 }) as any;
+    expect(custom.strokeColor).toBe('#2f9e44');
+    expect(custom.strokeWidth).toBe(5);
+  });
+
+  it('呼ぶたびに別の id になり、isCheckMarkElement で判定できる', () => {
+    const a = createCheckMarkElement(0, 0);
+    const b = createCheckMarkElement(0, 0);
+
+    expect(a.id).not.toBe(b.id);
+    expect(isCheckMarkElement(a)).toBe(true);
+    expect(isCheckMarkElement({ ...a, customData: null } as any)).toBe(false);
+  });
+});
diff --git a/utils/checkMarkUtils.ts b/utils/checkMarkUtils.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e084f9979d51c59607545986ed2089e61fcdb323
--- /dev/null
+++ b/utils/checkMarkUtils.ts
@@ -0,0 +1,82 @@
+/**
+ * チェックマーク（✓）ユーティリティ
+ *
+ * チェックモードで C を押したあと、図面をクリックした位置に置く ✓ を作る。
+ * フォントに依存しないよう、テキストではなく 3 点の折れ線（line 要素）で描く。
+ */
+import { nanoid } from 'nanoid';
+import type { NonDeletedExcalidrawElement } from '@excalidraw/excalidraw/element/types';
+
+/** チェックマークの既定色（Excalidraw の赤） */
+export const CHECK_MARK_COLOR = '#e03131';
+
+/** チェックマークの既定の線の太さ */
+export const CHECK_MARK_STROKE_WIDTH = 3;
+
+/** チェックマークの縦横の大きさ（px） */
+export const CHECK_MARK_SIZE = 28;
+
+export interface CheckMarkOptions {
+  color?: string;
+  strokeWidth?: number;
+}
+
+/** 要素がチェックマークかどうか */
+export const isCheckMarkElement = (element: NonDeletedExcalidrawElement): boolean =>
+  element.type === 'line' && (element.customData as Record<string, unknown> | null)?.checkMark === true;
+
+/**
+ * 指定位置を中心にしたチェックマークを作る
+ *
+ * @param centerX - 中心の X（シーン座標）
+ * @param centerY - 中心の Y（シーン座標）
+ */
+export const createCheckMarkElement = (
+  centerX: number,
+  centerY: number,
+  options?: CheckMarkOptions,
+): NonDeletedExcalidrawElement => {
+  const size = CHECK_MARK_SIZE;
+  // 左上 → 谷（左寄りの下）→ 右上
+  const points = [
+    [0, size * 0.55],
+    [size * 0.35, size],
+    [size, 0],
+  ];
+
+  return {
+    id: nanoid(),
+    type: 'line',
+    x: centerX - size / 2,
+    y: centerY - size / 2,
+    width: size,
+    height: size,
+    angle: 0,
+    strokeColor: options?.color ?? CHECK_MARK_COLOR,
+    backgroundColor: 'transparent',
+    fillStyle: 'solid',
+    strokeWidth: options?.strokeWidth ?? CHECK_MARK_STROKE_WIDTH,
+    strokeStyle: 'solid',
+    roughness: 1,
+    opacity: 100,
+    groupIds: [],
+    frameId: null,
+    roundness: { type: 2 },
+    seed: Math.floor(Math.random() * 100000),
+    version: 1,
+    versionNonce: Math.floor(Math.random() * 100000),
+    isDeleted: false,
+    boundElements: null,
+    updated: Date.now(),
+    link: null,
+    locked: false,
+    customData: { checkMark: true },
+    points,
+    startBinding: null,
+    endBinding: null,
+    lastCommittedPoint: null,
+    startArrowhead: null,
+    endArrowhead: null,
+    index: null,
+  } as unknown as NonDeletedExcalidrawElement;
+};
