 }
 
+/* ショートカット一覧モーダル */
+.shortcut-help-overlay {
+  position: fixed;
+  inset: 0;
+  z-index: 10000;
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  background: rgba(0, 0, 0, 0.45);
+  backdrop-filter: blur(3px);
+}
+
+.shortcut-help-window {
+  width: min(720px, 94vw);
+  max-height: 86vh;
+  display: flex;
+  flex-direction: column;
+  background: var(--island-bg-color, #ffffff);
+  color: var(--color-on-surface, #1e1e1e);
+  border-radius: 12px;
+  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
+  border: 1px solid var(--default-border-color, #e5e7eb);
+  overflow: hidden;
+  animation: fadeInModal 0.2s ease-out;
+
+  .shortcut-help-header {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    padding: 14px 20px;
+    border-bottom: 1px solid var(--default-border-color, #f3f4f6);
+    flex-shrink: 0;
+
+    .title-area {
+      display: flex;
+      align-items: center;
+      gap: 10px;
+      font-size: 16px;
+      font-weight: 600;
+      color: var(--color-on-surface, #111827);
+
+      h3 {
+        margin: 0;
+        font-size: 16px;
+        font-weight: 600;
+      }
+
+      .shortcut-key-badge {
+        font-size: 11px;
+        font-weight: 700;
+        background: #e0e7ff;
+        color: #4338ca;
+        padding: 2px 7px;
+        border-radius: 4px;
+        border: 1px solid #c7d2fe;
+      }
+    }
+
+    .close-btn {
+      background: none;
+      border: none;
+      cursor: pointer;
+      color: var(--color-text, #6b7280);
+      padding: 6px;
+      border-radius: 6px;
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      transition: background 0.15s ease, color 0.15s ease;
+
+      &:hover {
+        background: var(--color-surface-low, #f3f4f6);
+        color: #111827;
+      }
+    }
+  }
+
+  .shortcut-help-toolbar {
+    padding: 12px 20px;
+    display: flex;
+    flex-direction: column;
+    gap: 10px;
+    background: var(--color-surface-low, #f9fafb);
+    border-bottom: 1px solid var(--default-border-color, #f3f4f6);
+    flex-shrink: 0;
+
+    .search-box {
+      position: relative;
+      display: flex;
+      align-items: center;
+
+      .search-icon {
+        position: absolute;
+        left: 12px;
+        color: #9ca3af;
+        pointer-events: none;
+      }
+
+      .search-input {
+        width: 100%;
+        padding: 8px 32px 8px 36px;
+        border-radius: 8px;
+        border: 1px solid var(--default-border-color, #d1d5db);
+        background: var(--island-bg-color, #ffffff);
+        color: var(--color-on-surface, #1e1e1e);
+        font-size: 13px;
+        outline: none;
+        transition: border-color 0.15s ease, box-shadow 0.15s ease;
+
+        &:focus {
+          border-color: #6366f1;
+          box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
+        }
+
+        &::placeholder {
+          color: #9ca3af;
+        }
+      }
+
+      .search-clear-btn {
+        position: absolute;
+        right: 10px;
+        background: none;
+        border: none;
+        font-size: 16px;
+        color: #9ca3af;
+        cursor: pointer;
+        padding: 2px 6px;
+        line-height: 1;
+
+        &:hover {
+          color: #4b5563;
+        }
+      }
+    }
+
+    .category-tabs {
+      display: flex;
+      gap: 6px;
+      overflow-x: auto;
+      padding-bottom: 2px;
+
+      .category-tab {
+        padding: 5px 12px;
+        border-radius: 6px;
+        border: 1px solid transparent;
+        background: transparent;
+        color: #6b7280;
+        font-size: 12px;
+        font-weight: 500;
+        cursor: pointer;
+        white-space: nowrap;
+        transition: all 0.15s ease;
+
+        &:hover {
+          background: rgba(0, 0, 0, 0.04);
+          color: #1f2937;
+        }
+
+        &.active {
+          background: #4f46e5;
+          color: #ffffff;
+          font-weight: 600;
+          box-shadow: 0 1px 3px rgba(79, 70, 229, 0.3);
+        }
+      }
+    }
+  }
+
+  .shortcut-help-body {
+    flex: 1;
+    overflow-y: auto;
+    padding: 16px 20px;
+
+    .shortcut-empty {
+      text-align: center;
+      padding: 40px 20px;
+      color: #6b7280;
+      font-size: 14px;
+    }
+
+    .shortcut-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
+      gap: 10px;
+    }
+
+    .shortcut-card {
+      display: flex;
+      flex-direction: column;
+      gap: 6px;
+      padding: 10px 14px;
+      border-radius: 8px;
+      background: var(--color-surface-lowest, #ffffff);
+      border: 1px solid var(--default-border-color, #e5e7eb);
+      transition: background 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
+
+      &:hover {
+        background: var(--color-surface-low, #f8fafc);
+        border-color: #cbd5e1;
+        transform: translateY(-1px);
+      }
+
+      .shortcut-keys {
+        display: flex;
+        align-items: center;
+        justify-content: space-between;
+        gap: 8px;
+
+        .kbd-wrapper {
+          display: inline-flex;
+          align-items: center;
+          gap: 4px;
+          flex-wrap: wrap;
+
+          .kbd-sep {
+            color: #9ca3af;
+            font-size: 11px;
+            font-weight: 600;
+          }
+        }
+
+        .shortcut-kbd {
+          display: inline-block;
+          padding: 2px 7px;
+          font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
+          font-size: 12px;
+          font-weight: 600;
+          line-height: 1.4;
+          color: #1f2937;
+          background-color: #f3f4f6;
+          border: 1px solid #d1d5db;
+          border-bottom-width: 2px;
+          border-radius: 5px;
+          box-shadow: inset 0 -1px 0 #d1d5db;
+          white-space: nowrap;
+        }
+
+        .shortcut-item-badge {
+          font-size: 10px;
+          font-weight: 700;
+          padding: 1px 6px;
+          border-radius: 10px;
+          background: #eff6ff;
+          color: #2563eb;
+          border: 1px solid #bfdbfe;
+          white-space: nowrap;
+        }
+      }
+
+      .shortcut-info {
+        display: flex;
+        flex-direction: column;
+        gap: 2px;
+
+        .shortcut-desc {
+          font-size: 13px;
+          font-weight: 600;
+          color: var(--color-on-surface, #1f2937);
+          line-height: 1.35;
+        }
+
+        .shortcut-detail {
+          font-size: 11px;
+          color: #6b7280;
+          line-height: 1.35;
+        }
+      }
+    }
+  }
+
+  .shortcut-help-footer {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    padding: 12px 20px;
+    border-top: 1px solid var(--default-border-color, #f3f4f6);
+    background: var(--color-surface-low, #fafafa);
+    flex-shrink: 0;
+
+    .footer-hint {
+      font-size: 12px;
+      color: #6b7280;
+
+      kbd {
+        padding: 1px 5px;
+        background: #e5e7eb;
+        border-radius: 4px;
+        font-family: monospace;
+        font-weight: bold;
+        font-size: 11px;
+      }
+    }
+
+    .confirm-btn {
+      padding: 6px 18px;
+      background: #4f46e5;
+      color: #ffffff;
+      border: none;
+      border-radius: 6px;
+      font-size: 13px;
+      font-weight: 500;
+      cursor: pointer;
+      transition: background 0.15s ease;
+
+      &:hover {
+        background: #4338ca;
+      }
+    }
+  }
+}
+
+/* ヘッダーのショートカットヘルプボタン */
+.shortcut-help-btn {
+  /* header-btn の共通スタイルを継承 */
+  svg {
+    stroke-width: 1.8;
+  }
+}
+
+
