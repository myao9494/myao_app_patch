+  call "%ROOT_DIR%\setup_windows.bat" /nopause
+)
 
 REM Pythonと必須モジュールを起動前に確認する
 "%PYTHON_EXE%" -c "import fastapi, uvicorn, lzstring, multipart" > nul 2>&1
 if errorlevel 1 (
-  echo エラー: 利用可能なPythonまたは必須Pythonモジュールを確認できませんでした。
