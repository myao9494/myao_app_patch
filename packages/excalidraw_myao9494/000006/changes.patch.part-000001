diff --git a/backend/ensure_venv.sh b/backend/ensure_venv.sh
new file mode 100755
index 0000000000000000000000000000000000000000..fee9e583bdc7a5c92cc9ae04e65ffe3590c64050
--- /dev/null
+++ b/backend/ensure_venv.sh
@@ -0,0 +1,44 @@
+#!/bin/bash
+# backend/.venv を用意する（macOS / Linux 用）。
+#
+# start_servers.sh・start_dev.sh・backend/start_server.sh が起動前に実行する。単独で実行してもよい。
+# 終わったら backend/.venv/bin/python で fastapi / uvicorn が動く状態になっている（失敗したら終了コード 1）。
+#
+# 仕様:
+# - .venv の Python が動かない・3.14 でない（3.12 で作った古い venv など）ときは
+#   python3（3.14）で `python3 -m venv --clear` して作り直す。消すのは .venv の中身だけ
+# - requirements-lock.txt（版固定）を pip で入れる。入れたあと .venv/.requirements-lock.installed を置き、
+#   requirements-lock.txt がそれより新しくなったときだけ入れ直す（毎回の起動では pip を呼ばない）
+# - uv は使わない（Windows の setup_windows.bat と同じ手順・同じ版にそろえるため）
+
+set -Eeuo pipefail
+
+BACKEND_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+VENV_DIR="$BACKEND_DIR/.venv"
+VENV_PY="$VENV_DIR/bin/python"
+LOCK_FILE="$BACKEND_DIR/requirements-lock.txt"
+MARKER="$VENV_DIR/.requirements-lock.installed"
+IS_314='import sys; sys.exit(0 if sys.version_info[:2] == (3, 14) else 1)'
+
+if ! "$VENV_PY" -c "$IS_314" >/dev/null 2>&1; then
+    if ! python3 -c "$IS_314" >/dev/null 2>&1; then
+        echo "エラー: Python 3.14 の python3 が見つかりません（現在: $(python3 -V 2>&1 || echo なし)）。" >&2
+        exit 1
+    fi
+    echo "backend/.venv を $(python3 -V 2>&1) で作成します..."
+    python3 -m venv --clear "$VENV_DIR"
+    rm -f "$MARKER"
+fi
+
+if [ ! -f "$MARKER" ] || [ "$LOCK_FILE" -nt "$MARKER" ]; then
+    echo "backend/.venv に requirements-lock.txt を入れます..."
+    "$VENV_PY" -m pip install --quiet --upgrade pip
+    "$VENV_PY" -m pip install --quiet -r "$LOCK_FILE"
+    touch "$MARKER"
+fi
+
+if ! "$VENV_PY" -c "import fastapi, uvicorn, lzstring, multipart" >/dev/null 2>&1; then
+    echo "エラー: backend/.venv に必要なパッケージが入っていません。backend/.venv を消してやり直してください。" >&2
+    exit 1
+fi
+echo "Python: $("$VENV_PY" -V 2>&1) ($VENV_PY)"
diff --git a/backend/requirements-lock.txt b/backend/requirements-lock.txt
new file mode 100644
index 0000000000000000000000000000000000000000..25dbfdcb4275213837f1d6a74ca517f1ad10deca
--- /dev/null
+++ b/backend/requirements-lock.txt
@@ -0,0 +1,37 @@
+# 版を固定した依存一覧（requirements.txt + requirements-dev.txt）
+#
+# Mac の backend/ensure_venv.sh と Windows の setup_windows.bat が、backend/.venv へ pip でこれを入れる。
+# 会社の Windows 端末には uv が無いので、どの端末でも pip だけで同じ版を再現できるようにしている。
+# Python 3.14 用。lzstring 以外は Windows (win_amd64) のビルド済み wheel があり、lzstring は純 Python なので pip がそのまま入れる。
+#
+# requirements.txt / requirements-dev.txt を変えたら、uv のある端末（Mac）で書き出し直す:
+#   cd backend
+#   { grep '^#' requirements-lock.txt; uv pip compile -q --universal --python-version 3.14 --no-header --no-annotate requirements.txt requirements-dev.txt; } > requirements-lock.txt.new && mv requirements-lock.txt.new requirements-lock.txt
+#   （冒頭のコメントはそのまま残る。tests/test_python_env.py が固定漏れを確かめる）
+annotated-doc==0.0.7
+annotated-types==0.8.0
+anyio==4.16.0
+certifi==2026.11.20
+click==8.5.1
+colorama==0.4.6 ; sys_platform == 'win32'
+fastapi==0.165.0
+future==1.0.0
+h11==0.16.0
+httpcore==1.0.9
+httpx==0.28.1
+idna==3.20
+iniconfig==2.3.1
+lzstring==1.0.4
+opentelemetry-api==1.45.2
+packaging==26.4
+pillow==13.0.0
+pluggy==1.7.0
+pydantic==2.14.4
+pydantic-core==2.50.5
+pygments==2.21.0
+pytest==9.2.0
+python-multipart==0.0.34
+starlette==1.10.0
+typing-extensions==4.16.0
+typing-inspection==0.4.5
+uvicorn==0.54.0
