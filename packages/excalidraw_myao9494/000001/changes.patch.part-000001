diff --git a/start_dev.sh b/start_dev.sh
index ca8881fedfcf38be3dc9eb0aa15b689b5942d1d0..70c0c6d8ecee0e8dd7a1400f87e319d63e36a5a8 100755
--- a/start_dev.sh
+++ b/start_dev.sh
@@ -1,7 +1,8 @@
 #!/bin/zsh
 
 # 開発用サーバー一括起動スクリプト
-# Vite開発サーバー(HMR)とバックエンドサーバーを同時に起動
+# Vite開発サーバー(HMR, port 3001)とバックエンドAPIサーバー(FastAPI, port 8008)を同時に起動
