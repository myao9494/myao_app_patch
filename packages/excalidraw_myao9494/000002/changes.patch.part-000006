-    const dex = dx - ex;
-    const aey = ay - ey;
-    const bey = by - ey;
-    const cey = cy - ey;
-    const dey = dy - ey;
-    const aez = az - ez;
-    const bez = bz - ez;
-    const cez = cz - ez;
-    const dez = dz - ez;
-
