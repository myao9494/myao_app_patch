-    uint16_t* out = (uint16_t*)(memory + offset_out);
-    uint16_t* tmp_out = (uint16_t*)(memory + offset_tmp_out);
-    float* tmp_line = (float*)(memory + offset_line);
-    float* coefs = (float*)(memory + offset_coefs);
