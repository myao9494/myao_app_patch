-const HIGHLIGHT_THEME = {
-  ';': pico.yellow,
-  ':': pico.yellow,
-  '(': pico.cyan,
-  ')': pico.cyan,
-  '[': pico.yellow,
-  ']': pico.yellow,
-  '{': pico.yellow,
-  '}': pico.yellow,
