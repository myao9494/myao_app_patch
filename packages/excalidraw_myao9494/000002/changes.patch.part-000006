-                    cx1 = cx;
-                    cy1 = cy;
-                }
-                out.push({ key: 'C', data: [cx1, cy1, ...data] });
-                lcx = data[0];
-                lcy = data[1];
-                cx = data[2];
-                cy = data[3];
-                break;
-            }
-            case 'T': {
-                const [x, y] = data;
-                let x1 = 0, y1 = 0;
-                if (lastType === 'Q' || lastType === 'T') {
-                    x1 = cx + (cx - lcx);
-                    y1 = cy + (cy - lcy);
