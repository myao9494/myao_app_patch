-let terminalHighlight = require('./terminal-highlight')
-
-class CssSyntaxError extends Error {
-  constructor(message, line, column, source, file, plugin) {
-    super(message)
-    this.name = 'CssSyntaxError'
-    this.reason = message
-
-    if (file) {
-      this.file = file
-    }
-    if (source) {
-      this.source = source
-    }
