-        prev_prev_out = prev_out;
-        prev_out = curr_out;
-
-        prev_src = curr_src;
-        curr_src = (double)(*src--);
-
-        *out = (*line--) + prev_out;
-        out -= height;
-    }
-}
-
-
-void blurMono16(uint32_t offset_src, uint32_t offset_out, uint32_t offset_tmp_out, uint32_t offset_line,
