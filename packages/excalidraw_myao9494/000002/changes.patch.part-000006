-
-    // right to left
-    prev_src = (double)(*src);
-    prev_prev_out = prev_src * ACCESS_RIGHT_CORNER(coefs);
-    prev_out = prev_prev_out;
-    curr_src = prev_src;
-
-    for (int32_t i = width - 1; i >= 0; i--) {
