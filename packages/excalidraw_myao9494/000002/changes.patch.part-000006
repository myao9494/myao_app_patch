-      srcPtr = (srcOffset + (filterShift * 4))|0;
-
-      r = g = b = a = 0;
-
-      // Apply the filter to the row to get the destination pixel r, g, b, a
-      for (; filterSize > 0; filterSize--) {
-        filterVal = filters[filterPtr++];
