-// Normalize path to include only M, L, C, and Z commands
-export function normalize(segments) {
-    const out = [];
-    let lastType = '';
-    let cx = 0, cy = 0;
-    let subx = 0, suby = 0;
-    let lcx = 0, lcy = 0;
-    for (const { key, data } of segments) {
-        switch (key) {
-            case 'M':
-                out.push({ key: 'M', data: [...data] });
-                [cx, cy] = data;
-                [subx, suby] = data;
-                break;
-            case 'C':
-                out.push({ key: 'C', data: [...data] });
-                cx = data[4];
-                cy = data[5];
-                lcx = data[2];
-                lcy = data[3];
-                break;
-            case 'L':
-                out.push({ key: 'L', data: [...data] });
-                [cx, cy] = data;
-                break;
-            case 'H':
-                cx = data[0];
-                out.push({ key: 'L', data: [cx, cy] });
-                break;
-            case 'V':
-                cy = data[0];
-                out.push({ key: 'L', data: [cx, cy] });
-                break;
-            case 'S': {
-                let cx1 = 0, cy1 = 0;
