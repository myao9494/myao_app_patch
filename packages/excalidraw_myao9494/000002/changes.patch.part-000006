-
-
-const DEFAULT_PICA_OPTS = {
-  tile: 1024,
-  concurrency,
-  features: [ 'js', 'wasm', 'ww' ],
-  idle: 2000,
-  createCanvas:  function (width, height) {
-    let tmpCanvas = document.createElement('canvas');
-    tmpCanvas.width  = width;
-    tmpCanvas.height = height;
-    return tmpCanvas;
-  }
-};
-
-
-const DEFAULT_RESIZE_OPTS = {
-  quality:          3,
-  alpha:            false,
-  unsharpAmount:    0,
-  unsharpRadius:    0.0,
-  unsharpThreshold: 0
