-#define G(x) ((uint8_t)((x) >> 8))
-#define B(x) ((uint8_t)((x) >> 16))
-#define A(x) ((uint8_t)((x) >> 24))
-
-#define RGBA(r, g, b, a) ((r) | ((g) << 8) | ((b) << 16) | ((a) << 24))
-
