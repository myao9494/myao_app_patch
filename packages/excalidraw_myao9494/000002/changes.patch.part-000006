-    this._processor = processor
-    this._css = css
-    this._opts = opts
-    this._map = undefined
-
-    let str = stringify
-    this.result = new Result(this._processor, undefined, this._opts)
-    this.result.css = css
-
-    let self = this
-    Object.defineProperty(this.result, 'root', {
-      get() {
-        return self.root
-      }
-    })
