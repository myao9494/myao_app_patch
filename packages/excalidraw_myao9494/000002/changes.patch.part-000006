-    stroke: none;
-  }
-
-  .loopText, .loopText > tspan {
-    fill: ${e.loopTextColor};
-    stroke: none;
-  }
-
-  .sectionTitle, .sectionTitle > tspan {
-    fill: ${e.loopTextColor};
-    stroke: none;
-  }
-
-  .loopLine {
-    stroke-width: 2px;
-    stroke-dasharray: 2, 2;
-    stroke: ${e.labelBoxBorderColor};
-    fill: ${e.labelBoxBorderColor};
-  }
-
