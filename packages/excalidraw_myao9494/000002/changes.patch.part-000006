-  fill: ${e.textColor};
-  stroke: none;
-  font-size: 10px;
-
-}
-g.stateGroup .state-title {
-  font-weight: bolder;
-  fill: ${e.stateLabelColor};
-}
-
-g.stateGroup rect {
-  fill: ${e.mainBkg};
-  stroke: ${e.nodeBorder};
-}
-
-g.stateGroup line {
-  stroke: ${e.lineColor};
-  stroke-width: ${e.strokeWidth||1};
-}
-
-.transition {
-  stroke: ${e.transitionColor};
-  stroke-width: ${e.strokeWidth||1};
-  fill: none;
-}
-
-.stateGroup .composit {
-  fill: ${e.background};
-  border-bottom: 1px
-}
-
-.stateGroup .alt-composit {
-  fill: #e0e0e0;
-  border-bottom: 1px
-}
-
-.state-note {
-  stroke: ${e.noteBorderColor};
