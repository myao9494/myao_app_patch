-
-#define R(x) ((uint8_t)(x))
-#define G(x) ((uint8_t)((x) >> 8))
-#define B(x) ((uint8_t)((x) >> 16))
-#define MinPlusMax(r, g, b) (uint16_t)((( \
-            ((r >= g && r >= b) ? r : (g >= b && g >= r) ? g : b) + \
-                ((r <= g && r <= b) ? r : (g <= b && g <= r) ? g : b)) * 257) >> 1);
-
