-    return this.async().then(onFulfilled, onRejected)
-  }
-
-  toString() {
-    return this._css
-  }
-
-  warnings() {
-    return []
-  }
-}
-
-module.exports = NoWorkResult
-NoWorkResult.default = NoWorkResult
