-def _normalize_command_for_platform(command: str) -> str:
-    if not command:
-        return ""
-
-    normalized = command.replace("\uFF02", '"')  # Full-width double quote to ASCII
-
-    if sys.platform.startswith("win"):
-        normalized = normalized.replace("¥", "\\").replace("￥", "\\")
-
-    return normalized
-
