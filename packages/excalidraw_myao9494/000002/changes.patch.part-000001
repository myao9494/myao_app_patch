-                                                angle: 0,
-                                                strokeColor: '#1976d2',
-                                                backgroundColor: 'transparent',
-                                                fillStyle: 'solid',
-                                                strokeWidth: 1,
-                                                strokeStyle: 'solid',
-                                                roughness: 0,
-                                                opacity: 100,
-                                                groupIds: [],
-                                                seed: Math.random(),
-                                                version: 1,
-                                                versionNonce: 0,
-                                                isDeleted: false,
-                                                text: subject.length > 25 ? subject.substring(0, 22) + '...' : subject,
-                                                fontSize: 14,
-                                                fontFamily: 1,
-                                                textAlign: "left",
