-<style>
-    .excalidraw-wrapper {
-        height: calc(100vh - 50px);
-        margin-top: 10px;
-    }
-    #excalidraw-container {
-        height: 100%;
-    }
-    /* フォントは自動的にCDNから読み込まれます */
-</style>
-{% endblock %}
