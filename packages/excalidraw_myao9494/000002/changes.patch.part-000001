-                    document.removeEventListener('keydown', handleKeyPress);
-                };
-            }, [excalidrawAPI]);
-
-            // データの読み込み
-            React.useEffect(() => {
-                const loadData = async () => {
-                    try {
-                        console.log("Loading data...");
-                        const response = await fetch("{{ url_for('load_excalidraw_data', file_path=file_path) }}", {
-                            cache: 'no-store',
-                            headers: {
-                                'Cache-Control': 'no-cache',
