-                                        <div style="margin: 10px 0; padding: 10px; border: 1px solid #ddd; cursor: pointer;"
-                                            data-backup-path="${backup.path}">
-                                            ${backup.time} - ${backup.name}
-                                        </div>
-                                    `).join('')}
-                                </div>
-                                <button id="cancel-restore" style="margin-top: 10px;">キャンセル</button>
-                            `;
