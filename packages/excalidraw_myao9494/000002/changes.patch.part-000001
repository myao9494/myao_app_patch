-                        </button>
-                      );
-                    })
-                  )}
-                </div>
-              </div>
-            </div>
-            <div className="file-browser-footer">
-              <div className="file-browser-field">
-                <label htmlFor="file-browser-file-name">ファイル名(N):</label>
-                <input
