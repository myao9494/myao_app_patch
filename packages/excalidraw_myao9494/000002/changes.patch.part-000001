-def _strip_cmd_prefix(raw_command: str) -> str:
-    if raw_command is None:
-        return ""
-
-    trimmed = raw_command.strip()
-    if not trimmed:
-        return ""
-
-    lower = trimmed.lower()
-    if lower == "cmd":
-        return ""
-
-    if lower.startswith("cmd"):
-        remainder = trimmed[3:]
-        if not remainder:
-            return ""
-        if remainder[0].isspace():
-            return remainder.lstrip()
-
-    return trimmed
-
