-def sanitize_filename(filename: str) -> str:
-    """ファイル名をサニタイズ"""
-    # 危険な文字を除去
-    import re
-    filename = re.sub(r'[<>:"/\\|?*]', '_', filename)
-    # 先頭末尾の空白とドットを除去
-    filename = filename.strip(' .')
-    # 空文字の場合はデフォルト名
-    if not filename:
-        filename = "untitled"
-    return filename
