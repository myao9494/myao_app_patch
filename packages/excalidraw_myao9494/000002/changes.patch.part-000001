-IMAGE_MIME_TYPE_MAP = {
-    "png": "image/png",
-    "jpg": "image/jpeg",
-    "jpeg": "image/jpeg",
-    "gif": "image/gif",
-    "svg": "image/svg+xml",
-    "webp": "image/webp",
-}
-
-
-SUPPORTED_IMAGE_EXTENSIONS = (
-    ".png", ".jpg", ".jpeg", ".gif", ".svg", ".webp", ".bmp", ".ico", ".md"
-)
-COMMON_ATTACHMENT_DIRS = (
-    "attachments", "assets", "images", "img", "files", "resources", "_resources", ".attachments"
-)
