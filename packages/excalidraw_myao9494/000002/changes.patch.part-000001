-                                linkText = `cmd ${clipboardText}`;
-                            }
-                            
-                            try {
-                                // 付箋（rectangle）を作成
-                                const rectangleElement = {
-                                    id: Math.random().toString(36).substr(2, 9),
-                                    type: 'rectangle',
-                                    x: viewportPosition.x - 100,
-                                    y: viewportPosition.y - 80,
-                                    width: 200,
-                                    height: 50,
-                                    angle: 0,
-                                    strokeColor: '#000000',
-                                    backgroundColor: '#fef3bd',
-                                    fillStyle: 'solid',
-                                    strokeWidth: 1,
-                                    strokeStyle: 'solid',
-                                    roughness: 0,
-                                    opacity: 100,
