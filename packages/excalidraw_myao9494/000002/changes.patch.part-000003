-var hints = {
-  canvasPanning: "\u0628\u0631\u0627\u06CC \u062D\u0631\u06A9\u062A \u062F\u0627\u062F\u0646 \u0628\u0648\u0645\u060C \u0686\u0631\u062E \u0645\u0627\u0648\u0633 \u06CC\u0627 \u0641\u0627\u0635\u0644\u0647 \u0631\u0627 \u062F\u0631 \u062D\u06CC\u0646 \u06A9\u0634\u06CC\u062F\u0646 \u0646\u06AF\u0647 \u062F\u0627\u0631\u06CC\u062F \u06CC\u0627 \u0627\u0632 \u0627\u0628\u0632\u0627\u0631 \u062F\u0633\u062A\u06CC \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u06A9\u0646\u06CC\u062F",
