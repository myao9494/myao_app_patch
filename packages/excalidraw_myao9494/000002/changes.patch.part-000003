-  invalidEncryptionKey: "\u06A9\u0644\u06CC\u0644\u06CC \u0631\u06D5\u0645\u0632\u0627\u0646\u062F\u0646 \u062F\u06D5\u0628\u06CE\u062A \u0644\u06D5 22 \u067E\u06CC\u062A \u0628\u06CE\u062A. \u0647\u0627\u0648\u06A9\u0627\u0631\u06CC \u0695\u0627\u0633\u062A\u06D5\u0648\u062E\u06C6 \u0644\u06D5 \u06A9\u0627\u0631\u062E\u0631\u0627\u0648\u06D5.",
-  collabOfflineWarning: "\u0647\u06CE\u06B5\u06CC \u0626\u06CC\u0646\u062A\u06D5\u0631\u0646\u06CE\u062A \u0628\u06D5\u0631\u062F\u06D5\u0633\u062A \u0646\u06CC\u06CC\u06D5.\n \u06AF\u06C6\u0695\u0627\u0646\u06A9\u0627\u0631\u06CC\u06CC\u06D5\u06A9\u0627\u0646\u062A \u0633\u06D5\u06CC\u06A4 \u0646\u0627\u06A9\u0631\u06CE\u0646!"
