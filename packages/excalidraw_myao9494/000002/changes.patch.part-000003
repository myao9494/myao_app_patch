-    exportBackground,
-    viewBackgroundColor,
-    exportPadding,
-    exportingFrame
-  });
-  if (type === "png") {
-    let blob = canvasToBlob(tempCanvas);
-    if (appState.exportEmbedScene) {
-      blob = blob.then(
-        (blob2) => import("./data/image-YKVTEDFW.js").then(
