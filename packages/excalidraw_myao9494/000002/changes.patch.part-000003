-var hints = {
-  canvasPanning: "\u0915\u0945\u0928\u0935\u094D\u0939\u093E\u0938 \u0938\u0930\u0915\u0935\u0923\u094D\u092F\u093E \u0938\u093E\u0920\u0940, \u0921\u094D\u0930\u0945\u0917 \u0915\u0930\u0924\u093E\u0928\u093E \u092E\u093E\u0909\u0938 \u0935\u094D\u0939\u0940\u0932 \u0927\u0930\u093E \u0915\u093F\u0902\u0935\u093E \u0938\u094D\u092A\u0947\u0938\u092C\u093E\u0930 \u0926\u093E\u092C\u0942\u0928 \u0920\u0947\u0935\u093E \u0905\u0925\u0935\u093E \u0939\u093E\u0924 \u0935\u093E\u0932\u0902 \u0909\u092A\u0915\u0930\u0923 \u0935\u093E\u092A\u0930\u093E",
-  linearElement: "\u0905\u0928\u0947\u0915 \u092C\u093F\u0902\u0926\u0941 \u0938\u093E\u0920\u0940 \u0915\u094D\u0932\u093F\u0915 \u0915\u0930\u093E, \u0930\u0947\u0918\u0947 \u0938\u093E\u0920\u0940 \u0921\u094D\u0930\u0948\u0917 \u0915\u0930\u093E",
