-var encrypted = {
-  tooltip: "\u0412\u0430\u0448\u0456 \u043A\u0440\u0435\u0441\u043B\u0435\u043D\u043D\u044F \u0437\u0430\u0445\u0438\u0449\u0435\u043D\u0456 \u043D\u0430\u0441\u043A\u0440\u0456\u0437\u043D\u0438\u043C \u0448\u0438\u0444\u0440\u0443\u0432\u0430\u043D\u043D\u044F\u043C \u2014 \u0441\u0435\u0440\u0432\u0435\u0440\u0438 Excalidraw \u043D\u0456\u043A\u043E\u043B\u0438 \u0457\u0445 \u043D\u0435 \u043F\u043E\u0431\u0430\u0447\u0430\u0442\u044C.",
