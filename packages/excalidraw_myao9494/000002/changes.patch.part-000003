-  tooltip: "\u0648\u06CE\u0646\u06D5\u06A9\u06CE\u0634\u0627\u0646\u06D5\u06A9\u0627\u0646\u062A \u0644\u06D5 \u06A9\u06C6\u062A\u0627\u06CC\u06CC\u06D5\u0648\u06D5 \u0628\u06C6 \u06A9\u06C6\u062A\u0627\u06CC\u06CC \u06A9\u06C6\u062F \u06A9\u0631\u0627\u0648\u0646 \u0628\u06C6\u06CC\u06D5 \u0633\u06CE\u0631\u06A4\u06D5\u0631\u06D5\u06A9\u0627\u0646\u06CC \u0626\u06CE\u06A9\u0633\u06A9\u0627\u0644\u06CC\u062F\u0631\u0627 \u0647\u06D5\u0631\u06AF\u06CC\u0632 \u0646\u0627\u06CC\u0627\u0646\u0628\u06CC\u0646\u0646.",
