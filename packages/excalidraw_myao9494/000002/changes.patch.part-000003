-var hints = {
-  canvasPanning: "\u05DB\u05D3\u05D9 \u05DC\u05D4\u05D6\u05D9\u05D6 \u05D0\u05EA \u05D4\u05E7\u05E0\u05D1\u05E1, \u05D4\u05D7\u05D6\u05E7 \u05D0\u05EA \u05D2\u05DC\u05D2\u05DC \u05D4\u05E2\u05DB\u05D1\u05E8 \u05DC\u05D7\u05D5\u05E5 \u05D0\u05D5 \u05D0\u05EA \u05DE\u05E7\u05E9 \u05D4\u05E8\u05D5\u05D5\u05D7 \u05DC\u05D7\u05D5\u05E5 \u05EA\u05D5\u05DA \u05DB\u05D3\u05D9 \u05D2\u05E8\u05D9\u05E8\u05D4, \u05D0\u05D5 \u05D4\u05E9\u05EA\u05DE\u05E9 \u05D1\u05DB\u05DC\u05D9 \u05D4\u05D9\u05D3",
