-  republishWarning: "\u062A\u0648\u062C\u0647: \u0628\u0631\u062E\u06CC \u0627\u0632 \u0645\u0648\u0627\u0631\u062F \u0627\u0646\u062A\u062E\u0627\u0628 \u0634\u062F\u0647 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u0642\u0628\u0644\u0627\u064B \u0645\u0646\u062A\u0634\u0631 \u0634\u062F\u0647/\u0627\u0631\u0633\u0627\u0644 \u0634\u062F\u0647 \u0639\u0644\u0627\u0645\u062A \u06AF\u0630\u0627\u0631\u06CC \u0634\u062F\u0647 \u0627\u0646\u062F. \u0634\u0645\u0627 \u0641\u0642\u0637 \u0628\u0627\u06CC\u062F \u0647\u0646\u06AF\u0627\u0645 \u0628\u0647\u200C\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06CC \u06CC\u06A9 \u06A9\u062A\u0627\u0628\u062E\u0627\u0646\u0647 \u0645\u0648\u062C\u0648\u062F \u06CC\u0627 \u0627\u0631\u0633\u0627\u0644\u060C \u0645\u0648\u0627\u0631\u062F \u0631\u0627 \u062F\u0648\u0628\u0627\u0631\u0647 \u0627\u0631\u0633\u0627\u0644 \u06A9\u0646\u06CC\u062F."
