-var roomDialog = {
-  desc_intro: "\u0A24\u0A41\u0A38\u0A40\u0A02 \u0A32\u0A4B\u0A15\u0A3E\u0A02 \u0A28\u0A42\u0A70 \u0A06\u0A2A\u0A23\u0A47 \u0A28\u0A3E\u0A32 \u0A2E\u0A4C\u0A1C\u0A42\u0A26\u0A3E \u0A26\u0A4D\u0A30\u0A3F\u0A36 '\u0A24\u0A47 \u0A38\u0A39\u0A3F\u0A2F\u0A4B\u0A17 \u0A15\u0A30\u0A28 \u0A32\u0A08 \u0A38\u0A71\u0A26\u0A3E \u0A2D\u0A47\u0A1C \u0A38\u0A15\u0A26\u0A47 \u0A39\u0A4B\u0964",
-  desc_privacy: "\u0A2B\u0A3F\u0A15\u0A30 \u0A28\u0A3E \u0A15\u0A30\u0A4B, \u0A07\u0A1C\u0A32\u0A3E\u0A38 \u0A38\u0A3F\u0A30\u0A47-\u0A24\u0A4B\u0A02-\u0A38\u0A3F\u0A30\u0A47 \u0A24\u0A71\u0A15 \u0A07\u0A28\u0A15\u0A30\u0A3F\u0A2A\u0A36\u0A28 \u0A35\u0A30\u0A24\u0A26\u0A3E \u0A39\u0A48, \u0A38\u0A4B \u0A1C\u0A4B \u0A15\u0A41\u0A1D \u0A35\u0A40 \u0A24\u0A41\u0A38\u0A40\u0A02 \u0A35\u0A3E\u0A39\u0A41\u0A70\u0A26\u0A47 \u0A39\u0A4B \u0A09\u0A39 \u0A28\u0A3F\u0A71\u0A1C\u0A40 \u0A39\u0A40 \u0A30\u0A39\u0A3F\u0A70\u0A26\u0A3E \u0A39\u0A48\u0964 \u0A07\u0A71\u0A25\u0A4B\u0A02 \u0A24\u0A71\u0A15 \u0A15\u0A3F \u0A38\u0A3E\u0A21\u0A47 \u0A38\u0A30\u0A35\u0A30 \u0A35\u0A40 \u0A28\u0A39\u0A40\u0A02 \u0A1C\u0A3E\u0A23 \u0A38\u0A15\u0A23\u0A17\u0A47 \u0A15\u0A3F \u0A24\u0A41\u0A38\u0A40\u0A02 \u0A15\u0A40 \u0A2C\u0A23\u0A3E\u0A07\u0A06 \u0A39\u0A48\u0964",
