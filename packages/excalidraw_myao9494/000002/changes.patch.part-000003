-var errorSplash = {
-  headingMain: "\u0924\u094D\u0930\u0941\u091F\u093F \u0906\u0932\u0940. \u092A\u0930\u0924 \u092A\u094D\u0930\u092F\u0924\u094D\u0928 \u0915\u0930\u093E <button>\u0939\u094D\u092F\u093E \u092A\u093E\u0928\u093E\u0932\u093E \u092A\u0941\u0928\u0903 \u0932\u094B\u0921 \u0915\u0930\u093E.</button>",
-  clearCanvasMessage: "\u0930\u0940\u0932\u094B\u0921\u093F\u0902\u0917 \u0939\u094B\u0924 \u0928\u0938\u0932\u094D\u092F\u093E\u0938, \u092A\u0930\u0924 \u092A\u094D\u0930\u092F\u0924\u094D\u0928 \u0915\u0930\u093E <button>\u092A\u091F\u0932 \u0938\u094D\u0935\u091A\u094D\u091B \u0915\u0930\u093F\u0924 \u0906\u0939\u0947.</button>",
