-  linearElementMulti: "\u0B95\u0B9F\u0BC8\u0B9A\u0BBF \u0BAA\u0BC1\u0BB3\u0BCD\u0BB3\u0BBF\u0BAF\u0BBF\u0BB2\u0BCD \u0B9A\u0BCA\u0B9F\u0BC1\u0B95\u0BCD\u0B95\u0BC1 \u0B85 \u0BAE\u0BC1\u0B9F\u0BBF\u0B95\u0BCD\u0B95 Escape \u0B85 Enter \u0B85\u0BB4\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1",
-  lockAngle: "SHIFT\u0B90 \u0B85\u0BB4\u0BC1\u0BA4\u0BCD\u0BA4\u0BBF\u0BAA\u0BCD\u0BAA\u0BBF\u0B9F\u0BBF\u0BA4\u0BCD\u0BA4\u0BC1 \u0B95\u0BCB\u0BA3\u0BA4\u0BCD\u0BA4\u0BC8 \u0BB5\u0BB1\u0BCD\u0BAA\u0BC1\u0BB1\u0BC1\u0BA4\u0BCD\u0BA4\u0BB2\u0BBE\u0BAE\u0BCD",
-  resize: "\u0BAE\u0BB1\u0BC1\u0B85\u0BB3\u0BB5\u0BBF\u0B9F\u0BC1\u0B95\u0BC8\u0BAF\u0BBF\u0BB2\u0BCD SHIFT\u0B90 \u0B85\u0BB4\u0BC1\u0BA4\u0BCD\u0BA4\u0BBF\u0BAA\u0BCD\u0BAA\u0BBF\u0B9F\u0BBF\u0BA4\u0BCD\u0BA4\u0BC1 \u0BB5\u0BBF\u0B95\u0BBF\u0BA4\u0B9A\u0BAE\u0BA4\u0BCD\u0BA4\u0BC8 \u0BB5\u0BB1\u0BCD\u0BAA\u0BC1\u0BB1\u0BC1\u0BA4\u0BCD\u0BA4\u0BB2\u0BBE\u0BAE\u0BCD,\n\u0BAE\u0BC8\u0BAF\u0BA4\u0BCD\u0BA4\u0BBF\u0BB2\u0BBF\u0BB0\u0BC1\u0BA8\u0BCD\u0BA4\u0BC1 \u0BAE\u0BB1\u0BC1\u0B85\u0BB3\u0BB5\u0BBF\u0B9F ALT\u0B90 \u0B85\u0BB4\u0BC1\u0BA4\u0BCD\u0BA4\u0BBF\u0BAA\u0BCD\u0BAA\u0BBF\u0B9F\u0BBF",
-  resizeImage: "SHIFT\u0B90 \u0BA8\u0BC0\u0BA3\u0BCD\u0B9F\u0BB4\u0BC1\u0BA4\u0BCD\u0BA4\u0BBF \u0B95\u0B9F\u0BCD\u0B9F\u0BB1\u0BCD\u0BB1\u0BC1 \u0B85\u0BB3\u0BB5\u0BC1\u0BAE\u0BBE\u0BB1\u0BCD\u0BB1\u0BB2\u0BBE\u0BAE\u0BCD,\n\u0BAE\u0BC8\u0BAF\u0BA4\u0BCD\u0BA4\u0BBF\u0BB2\u0BBF\u0BB0\u0BC1\u0BA8\u0BCD\u0BA4\u0BC1 \u0B85\u0BB3\u0BB5\u0BC1\u0BAE\u0BBE\u0BB1\u0BCD\u0BB1 ALT\u0B90 \u0BA8\u0BC0\u0BA3\u0BCD\u0B9F\u0BB4\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1\u0B95",
-  rotate: "\u0B9A\u0BC1\u0BB4\u0BB1\u0BCD\u0BB1\u0BC1\u0B95\u0BC8\u0BAF\u0BBF\u0BB2\u0BCD SHIFT\u0B90 \u0B85\u0BB4\u0BC1\u0BA4\u0BCD\u0BA4\u0BBF\u0BAA\u0BCD\u0BAA\u0BBF\u0B9F\u0BBF\u0BA4\u0BCD\u0BA4\u0BC1 \u0B95\u0BCB\u0BA3\u0B99\u0BCD\u0B95\u0BB3\u0BC8 \u0BB5\u0BB1\u0BCD\u0BAA\u0BC1\u0BB1\u0BC1\u0BA4\u0BCD\u0BA4\u0BB2\u0BBE\u0BAE\u0BCD",
-  lineEditor_info: "",
-  lineEditor_pointSelected: "\u0BAA\u0BC1\u0BB3\u0BCD\u0BB3\u0BBF(\u0B95\u0BB3\u0BCD)\u0B90 \u0BA8\u0BC0\u0B95\u0BCD\u0B95 Delete\u0B90 \u0B85\u0BB4\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1,\n\u0BA8\u0B95\u0BB2\u0BBE\u0B95\u0BCD\u0B95 CtrlOrCmd+D, \u0B85 \u0BA8\u0B95\u0BB0\u0BCD\u0BA4\u0BCD\u0BA4 \u0BAA\u0BBF\u0B9F\u0BBF\u0BA4\u0BCD\u0BA4\u0BBF\u0BB4\u0BC1",
-  lineEditor_nothingSelected: "\u0BA4\u0BBF\u0BB0\u0BC1\u0BA4\u0BCD\u0BA4 \u0BAA\u0BC1\u0BB3\u0BCD\u0BB3\u0BBF\u0BAF\u0BC8\u0BA4\u0BCD \u0BA4\u0BC7\u0BB0\u0BCD\u0BA8\u0BCD\u0BA4\u0BC6\u0B9F\u0BC1 (\u0BAA\u0BB2\u0BB5\u0BB1\u0BCD\u0BB1\u0BC8 \u0BA4\u0BC7\u0BB0 SHIFT\u0B90 \u0B85\u0BB4\u0BC1\u0BA4\u0BCD\u0BA4\u0BBF\u0BAA\u0BCD\u0BAA\u0BBF\u0B9F\u0BBF),\n\u0B85 \u0BAA\u0BC1\u0BA4\u0BBF\u0BAF \u0BAA\u0BC1\u0BB3\u0BCD\u0BB3\u0BBF\u0B95\u0BB3\u0BC8\u0B9A\u0BCD \u0B9A\u0BC7\u0BB0\u0BCD\u0B95\u0BCD\u0B95 Alt\u0B90 \u0B85\u0BB4\u0BC1\u0BA4\u0BCD\u0BA4\u0BBF\u0BAA\u0BCD\u0BAA\u0BBF\u0B9F\u0BBF\u0BA4\u0BCD\u0BA4\u0BC1\u0B9A\u0BCD \u0B9A\u0BCA\u0B9F\u0BC1\u0B95\u0BCD\u0B95\u0BC1",
-  placeImage: "\u0BAA\u0B9F\u0BA4\u0BCD\u0BA4\u0BC8 \u0BB5\u0BC8\u0B95\u0BCD\u0B95\u0B9A\u0BCD \u0B9A\u0BCA\u0B9F\u0BC1\u0B95\u0BCD\u0B95\u0BC1, \u0B85 \u0B95\u0BC8\u0BAE\u0BC1\u0BB1\u0BC8\u0BAF\u0BBE\u0B95 \u0B85\u0BB3\u0BB5\u0BC1 \u0B85\u0BAE\u0BC8\u0B95\u0BCD\u0B95 \u0B9A\u0BCA\u0B9F\u0BC1\u0B95\u0BCD\u0B95\u0BBF \u0BAA\u0BBF\u0B9F\u0BBF\u0BA4\u0BCD\u0BA4\u0BBF\u0BB4\u0BC1",
-  publishLibrary: "\u0B89\u0BAE\u0BCD \u0B9A\u0BCA\u0BA8\u0BCD\u0BA4 \u0BA8\u0BC2\u0BB2\u0B95\u0BA4\u0BCD\u0BA4\u0BC8\u0BAA\u0BCD \u0BAA\u0BBF\u0BB0\u0B9A\u0BC1\u0BB0\u0BBF",
-  bindTextToElement: "\u0B89\u0BB0\u0BC8\u0BAF\u0BC8\u0B9A\u0BCD \u0B9A\u0BC7\u0BB0\u0BCD\u0B95\u0BCD\u0B95 enter\u0B90 \u0B85\u0BB4\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1",
-  deepBoxSelect: "\u0B86\u0BB4\u0BCD\u0BA8\u0BCD\u0BA4\u0BC1\u0BA4\u0BCD \u0BA4\u0BC7\u0BB0\u0BB5\u0BC1\u0BAE\u0BCD \u0BAA\u0BBF\u0B9F\u0BBF\u0BA4\u0BCD\u0BA4\u0BBF\u0BB4\u0BC1\u0BA4\u0BCD\u0BA4\u0BB2\u0BC8\u0BA4\u0BCD \u0BA4\u0BB5\u0BBF\u0BB0\u0BCD\u0B95\u0BCD\u0B95\u0BB5\u0BC1\u0BAE\u0BCD CtrlOrCmd\u0B90 \u0B85\u0BB4\u0BC1\u0BA4\u0BCD\u0BA4\u0BBF\u0BAA\u0BCD\u0BAA\u0BBF\u0B9F\u0BBF",
