-  pasteAsSingleElement: "\u1794\u17D2\u179A\u17BE {{shortcut}} \u178A\u17BE\u1798\u17D2\u1794\u17B8\u1794\u17B7\u1791\u1797\u17D2\u1787\u17B6\u1794\u17CB\u1787\u17B6\u1792\u17B6\u178F\u17BB\u178F\u17C2\u1798\u17BD\u1799,\n\u17AC\u1794\u17B7\u1791\u1797\u17D2\u1787\u17B6\u1794\u17CB\u1791\u17C5\u1780\u17D2\u1793\u17BB\u1784\u1780\u1798\u17D2\u1798\u179C\u17B7\u1792\u17B8\u1793\u17B7\u1796\u1793\u17D2\u1792\u17A2\u178F\u17D2\u1790\u1794\u1791\u178A\u17C2\u179B\u1798\u17B6\u1793\u179F\u17D2\u179A\u17B6\u1794\u17CB",
