-  text_selected: "\u0932\u0947\u0916\u0928 \u0938\u0902\u092A\u093E\u0926\u0928 \u0938\u093E\u0920\u0940 \u0926\u0941\u0939\u0947\u0930\u0940 \u0915\u094D\u0932\u093F\u0915 \u0915\u0930\u093E \u0915\u093F\u0935\u094D\u0939\u093E \u090F\u0902\u091F\u0930 \u0926\u093E\u092C\u093E",
-  text_editing: "\u0938\u0902\u092A\u093E\u0926\u0928 \u0938\u0902\u092A\u0935\u093E\u092F\u091A\u0902 \u0905\u0938\u0932\u094D\u092F\u093E\u0938 \u090F\u0938\u094D\u0915\u0947\u092A \u0926\u093E\u092C\u093E \u0915\u093F\u0935\u094D\u0939\u093E \u0915\u0902\u091F\u094D\u0930\u094B\u0932 \u092F\u093E \u0915\u092E\u094D\u092E\u093E\u0902\u0921 \u092C\u0930\u094B\u092C\u093E\u0930 \u090F\u0902\u091F\u0930 \u0926\u093E\u092C\u093E",
