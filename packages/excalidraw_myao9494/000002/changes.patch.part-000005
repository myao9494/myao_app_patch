-      [['rgb(0, 0, 0)', { b: 50 }], 'rgb(0, 0, 127.5)'],
-      [['rgb(0, 0, 0)', { b: 0 }], 'rgb(0, 0, 0)'],
-      [['rgb(0, 0, 0)', { r: 50, g: 50, b: 50 }], 'rgb(127.5, 127.5, 127.5)'],
