-    "dist/**/*.js",
-    "src/**/*.js"
-  ],
-  "module": "src/index.js",
-  "main": "src/index.js",
-  "jsdelivr": "dist/d3-selection.min.js",
-  "unpkg": "dist/d3-selection.min.js",
-  "exports": {
-    "umd": "./dist/d3-selection.min.js",
-    "default": "./src/index.js"
-  },
-  "sideEffects": false,
-  "devDependencies": {
-    "eslint": "7",
