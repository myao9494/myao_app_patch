-  if (this.child != null)
-  {
-    var nodes = this.child.getNodes();
-    for (var i = 0; i < nodes.length; i++)
-    {
-      childNode = nodes[i];
-      children = childNode.withChildren();
-      children.forEach(function(node) {
-        withNeighborsList.add(node);
-      });
-    }
-  }
-
-  return withNeighborsList;
