-          action_: 'text='
-        }
-      }
-    }),
-    actions: {
-      'output': function (buffer) {
-        if (buffer.text_) {
-          /** @type {ParserOutput} */
-          var ret = {
-            type_: 'text',
-            p1: buffer.text_
-          };
-          for (var p in buffer) {
-            delete buffer[p];
-          }
-          return ret;
-        }
-      }
-    }
-  },
-  'pq': {
-    transitions: mhchemParser.createTransitions({
-      'empty': {
