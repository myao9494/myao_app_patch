-// \def\rq{'}
-// \def \aa {\r a}
-// \def \AA {\r A}
-defineMacro("~", "\\nobreakspace");
-defineMacro("\\lq", "`");
-defineMacro("\\rq", "'");
-defineMacro("\\aa", "\\r a");
-defineMacro("\\AA", "\\r A");
