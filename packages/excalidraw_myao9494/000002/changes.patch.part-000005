-[2, 1, 1],
-// size2: [6, 5, 5]
-[3, 1, 1],
-// size3: [7, 5, 5]              \scriptsize
-[4, 2, 1],
-// size4: [8, 6, 5]              \footnotesize
-[5, 2, 1],
-// size5: [9, 6, 5]              \small
-[6, 3, 1],
-// size6: [10, 7, 5]             \normalsize
-[7, 4, 2],
-// size7: [12, 8, 6]             \large
-[8, 6, 3],
-// size8: [14.4, 10, 7]          \Large
-[9, 7, 6],
-// size9: [17.28, 12, 10]        \LARGE
-[10, 8, 7],
