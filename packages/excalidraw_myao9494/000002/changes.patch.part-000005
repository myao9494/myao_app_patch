-  let nextID = 0;
-  let fakeBuildError = (text) => {
-    let error = new Error(`Build failed with 1 error:
-error: ${text}`);
-    let errors = [{ id: "", pluginName: "", text, location: null, notes: [], detail: void 0 }];
-    error.errors = errors;
-    error.warnings = [];
-    return error;
-  };
