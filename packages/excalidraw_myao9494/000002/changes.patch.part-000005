-  if (!is_uint8array(jpeg_bin)) {
-    throw error('Invalid argument (jpeg_bin), Uint8Array expected', 'EINVAL');
-  }
-
-  if (typeof on_exif_entry !== 'function') {
-    throw error('Invalid argument (on_exif_entry), Function expected', 'EINVAL');
