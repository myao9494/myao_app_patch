-// List of commands that act like macros but aren't defined as a macro,
-// function, or symbol.  Used in `isDefined`.
-const implicitCommands = {
-  "^": true,
-  // Parser.js
-  "_": true,
-  // Parser.js
-  "\\limits": true,
