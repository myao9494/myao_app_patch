-        mapper: (value: T, key: T, iter: this) => M,
-        context?: unknown
-      ): Collection.Set<M>;
-
-      /**
-       * Flat-maps the Collection, returning a Collection of the same type.
-       *
-       * Similar to `collection.map(...).flatten(true)`.
-       */
