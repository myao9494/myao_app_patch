-/* IMPORT */
-import _ from '../utils/index.js';
-import Type from './type.js';
-import { TYPE } from '../constants.js';
-/* MAIN */
-class Channels {
-    /* CONSTRUCTOR */
-    constructor(data, color) {
-        this.color = color;
-        this.changed = false;
-        this.data = data; //TSC
-        this.type = new Type();
-    }
-    /* API */
-    set(data, color) {
-        this.color = color;
-        this.changed = false;
-        this.data = data; //TSC
-        this.type.type = TYPE.ALL;
-        return this;
-    }
-    /* HELPERS */
-    _ensureHSL() {
-        const data = this.data;
-        const { h, s, l } = data;
-        if (h === undefined)
-            data.h = _.channel.rgb2hsl(data, 'h');
