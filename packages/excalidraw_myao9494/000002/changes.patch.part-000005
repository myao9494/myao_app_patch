-
-      /**
-       * Shallowly converts this Indexed collection to equivalent native JavaScript Array.
-       */
-      toJSON(): Array<T>;
-
-      /**
-       * Shallowly converts this collection to an Array.
-       */
-      toArray(): Array<T>;
