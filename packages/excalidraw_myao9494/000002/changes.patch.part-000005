-{
-  "name": "d3-selection",
-  "version": "3.0.0",
-  "description": "Data-driven DOM manipulation: select elements and join them to data.",
-  "homepage": "https://d3js.org/d3-selection/",
-  "repository": {
-    "type": "git",
-    "url": "https://github.com/d3/d3-selection.git"
-  },
-  "keywords": [
-    "d3",
-    "d3-module",
-    "dom",
