-        var ret = [];
-        if (m.match(/^[+\-]/)) {
-          ret.push(m.substr(0, 1));
-          m = m.substr(1);
-        }
-        var n = m.match(/^([0-9]+|\$[a-z]\$|[a-z])\/([0-9]+)(\$[a-z]\$|[a-z])?$/);
