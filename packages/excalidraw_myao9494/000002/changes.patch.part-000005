-      /* WITH COMMAS AND WEIRD SPACES */
-      ['hsla(  1 , 20% , 50%, 0.5  )', 'hsla(1, 20%, 50%, 0.5)'],
-      ['hsla(1,20%,50%,50%)', 'hsla(1, 20%, 50%, 0.5)'],
-      ['hsla( 1,20%,50%,0.5 )', 'hsla(1, 20%, 50%, 0.5)'],
-      /* WITH SLASH */
