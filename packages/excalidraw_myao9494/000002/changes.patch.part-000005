-        throw ["MhchemBugT", "mhchem bug T. Please report."];
-      // Missing texify rule or unknown MhchemParser output
-    }
-    return res;
-  },
-  _getArrow: function _getArrow(a) {
-    switch (a) {
-      case "->":
-        return "rightarrow";
-      case "\u2192":
-        return "rightarrow";
-      case "\u27F6":
-        return "rightarrow";
-      case "<-":
-        return "leftarrow";
-      case "<->":
