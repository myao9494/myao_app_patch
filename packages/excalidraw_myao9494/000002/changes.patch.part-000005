-      'rgb(1%,, 20%, 255%)',
-      'rgb(1%, 255%)',
-      'rgb(1%, 10%%, 255%)',
-      'rgb(1%, %10%, 255%)',
-      'rgb(1)',
-      'rgb(1, 20, 255',
-      'rgb 1, 20, 255',
-      'rgb 1, 20, 255)',
-      'rgb(1, a, 255)',
-      'rgb (1, 2, 255)',
-      'rgb(1,2,3..5)',
-      'rgb(1, 2, 3.4.5)',
-      'rgbQ(1, 2, 255)',
-      'r g b(1, 2, 255)'
