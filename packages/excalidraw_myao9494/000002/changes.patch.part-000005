-
-    if (on_entry(entry) === false) {
-      this.aborted = true;
-      return;
-    }
-
-    offset += 12;
-  }
-
-  if (ifd_no === 0) {
-    this.ifds_to_read.push({
-      id:     1,
-      offset: this.read_uint32(offset)
-    });
-  }
-};
