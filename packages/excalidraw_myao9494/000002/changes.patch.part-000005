-    if (child.height > height) {
-      height = child.height;
-    }
-    if (child.depth > depth) {
-      depth = child.depth;
-    }
-    if (child.maxFontSize > maxFontSize) {
-      maxFontSize = child.maxFontSize;
-    }
-  }
