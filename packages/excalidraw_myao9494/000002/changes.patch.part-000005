-    var segment_code, segment_length;
-
-    if (offset + 1 >= length) throw error('Unexpected EOF', 'EBADDATA');
-    var byte1 = jpeg_bin[offset];
-    var byte2 = jpeg_bin[offset + 1];
-
-    if (byte1 === 0xFF && byte2 === 0xFF) {
-      // padding
-      segment_code = 0xFF;
-      segment_length = 1;
-
-    } else if (byte1 === 0xFF && byte2 !== 0) {
