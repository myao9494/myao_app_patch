-  var bottom = -Integer.MAX_VALUE;
-  var nodeLeft;
-  var nodeRight;
-  var nodeTop;
-  var nodeBottom;
-
-  var s = nodes.length;
-
-  for (var i = 0; i < s; i++)
-  {
-    var lNode = nodes[i];
-    nodeLeft = lNode.getLeft();
-    nodeRight = lNode.getRight();
-    nodeTop = lNode.getTop();
-    nodeBottom = lNode.getBottom();
-
-    if (left > nodeLeft)
-    {
-      left = nodeLeft;
-    }
-
-    if (right < nodeRight)
-    {
-      right = nodeRight;
-    }
-
-    if (top > nodeTop)
-    {
-      top = nodeTop;
-    }
-
-    if (bottom < nodeBottom)
-    {
-      bottom = nodeBottom;
-    }
-  }
-
-  var boundingRect = new RectangleD(left, top, right - left, bottom - top);
-
-  return boundingRect;
