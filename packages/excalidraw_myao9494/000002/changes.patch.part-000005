-       *
-       * Note: `filter()` always returns a new instance, even if it results in
-       * not filtering out any values.
-       */
-      filter<F extends T>(
-        predicate: (value: T, key: T, iter: this) => value is F,
-        context?: unknown
-      ): Collection.Set<F>;
-      filter(
-        predicate: (value: T, key: T, iter: this) => unknown,
-        context?: unknown
