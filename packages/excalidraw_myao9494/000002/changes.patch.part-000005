-    /* VARIABLES */
-    format: {
-        keyword: Keyword,
-        hex: Hex,
-        rgb: RGB,
-        rgba: RGB,
-        hsl: HSL,
-        hsla: HSL
-    },
-    /* API */
-    parse: (color) => {
-        if (typeof color !== 'string')
-            return color;
-        const channels = Hex.parse(color) || RGB.parse(color) || HSL.parse(color) || Keyword.parse(color); // Color providers ordered with performance in mind
-        if (channels)
-            return channels;
-        throw new Error(`Unsupported color format: "${color}"`);
-    },
