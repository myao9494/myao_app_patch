-  else
-  {
-    var nodes = this.child.getNodes();
-    for (var i = 0; i < nodes.length; i++)
-    {
-      childNode = nodes[i];
-
-      noOfChildren += childNode.getNoOfChildren();
-    }
-  }
-  
-  if(noOfChildren == 0){
-    noOfChildren = 1;
-  }
-  return noOfChildren;
-};
-
-LNode.prototype.getEstimatedSize = function () {
