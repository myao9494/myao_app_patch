-  const ratio = ( max + Number.EPSILON ) / ( min + Number.EPSILON );
-
-  return _.lang.round ( _.lang.clamp ( ratio, 1, 10 ) );
-
-};
-
-/* EXPORT */
-
-export default contrast;
