-    if ( charCode !== 114 && charCode !== 82 ) return; // 'r'/'R'
-
-    const match = color.match ( RGB.re );
-
-    if ( !match ) return;
-
-    const [, r, isRedPercentage, g, isGreenPercentage, b, isBluePercentage, a, isAlphaPercentage] = match;
-
-    return ChannelsReusable.set ({
