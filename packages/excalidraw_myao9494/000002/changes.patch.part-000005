-  child.on("error", afterClose);
-  const stdin = child.stdin;
-  const stdout = child.stdout;
-  stdout.on("data", readFromStdout);
-  stdout.on("end", afterClose);
-  stopService = () => {
-    stdin.destroy();
-    stdout.destroy();
-    child.kill();
-    initializeWasCalled = false;
-    longLivedService = void 0;
-    stopService = void 0;
-  };
-  let refCount = 0;
-  child.unref();
-  if (stdin.unref) {
-    stdin.unref();
-  }
-  if (stdout.unref) {
-    stdout.unref();
