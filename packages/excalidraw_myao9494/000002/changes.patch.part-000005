-      collection?: Iterable<T> | ArrayLike<T>
-    ): Collection.Indexed<T>;
-
-    interface Indexed<T> extends Collection<number, T> {
-      /**
-       * Deeply converts this Indexed collection to equivalent native JavaScript Array.
-       */
