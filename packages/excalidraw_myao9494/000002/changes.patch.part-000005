-    return monthFormat[dayjsInstance.month()];
-  }
-
-  return monthStandalone[dayjsInstance.month()];
-};
-
-months.s = monthStandalone;
-months.f = monthFormat;
-
-var monthsShort = function monthsShort(dayjsInstance, format) {
