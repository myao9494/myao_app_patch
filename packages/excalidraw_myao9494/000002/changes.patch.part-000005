-    const {r, g, b, a} = channels;
-
-    if ( a < 1 ) { // RGBA
-
-      return `rgba(${_.lang.round ( r )}, ${_.lang.round ( g )}, ${_.lang.round ( b )}, ${_.lang.round ( a )})`;
-
-    } else { // RGB
-
-      return `rgb(${_.lang.round ( r )}, ${_.lang.round ( g )}, ${_.lang.round ( b )})`;
-
-    }
-
-  }
-
-};
-
