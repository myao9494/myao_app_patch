-  wasmModule?: WebAssembly.Module
-
-  /**
-   * By default esbuild runs the WebAssembly-based browser API in a web worker
-   * to avoid blocking the UI thread. This can be disabled by setting "worker"
-   * to false.
-   */
-  worker?: boolean
