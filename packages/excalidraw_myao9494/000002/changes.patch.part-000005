-      ['rgb( 1,20,255 )', 'rgb(1, 20, 255)'],
-      /* WITHOUT COMMAS */
-      ['rgb(10% 20% 30%)', 'rgb(25.5, 51, 76.5)'],
-      ['rgb(1 20 255)', 'rgb(1, 20, 255)'],
-      ['rgb(   1    20     255   )', 'rgb(1, 20, 255)'],
-      /* MIXED UNITS */
