-
-export { layout };
-
-function layout(g, opts) {
-  var time = opts && opts.debugTiming ? util.time : util.notime;
-  time('layout', () => {
-    var layoutGraph = time('  buildLayoutGraph', () => buildLayoutGraph(g));
-    time('  runLayout', () => runLayout(layoutGraph, time));
