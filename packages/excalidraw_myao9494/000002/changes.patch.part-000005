-// \def\enspace{\kern.5em }
-defineMacro("\\enspace", "\\kern.5em ");
-// \def\enskip{\hskip.5em\relax}
-defineMacro("\\enskip", "\\hskip.5em\\relax");
-// \def\quad{\hskip1em\relax}
-defineMacro("\\quad", "\\hskip1em\\relax");
-// \def\qquad{\hskip2em\relax}
