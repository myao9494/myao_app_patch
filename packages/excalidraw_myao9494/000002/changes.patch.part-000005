-  },
-  htmlBuilder: array_htmlBuilder,
-  mathmlBuilder: array_mathmlBuilder
-});
-defineEnvironment({
-  type: "array",
-  names: ["smallmatrix"],
-  props: {
-    numArgs: 0
-  },
-  handler(context) {
-    const payload = {
-      arraystretch: 0.5
