-    "dist/**/*.js",
-    "src/**/*.js"
-  ],
-  "module": "src/index.js",
-  "main": "src/index.js",
-  "jsdelivr": "dist/d3-timer.min.js",
-  "unpkg": "dist/d3-timer.min.js",
-  "exports": {
-    "umd": "./dist/d3-timer.min.js",
-    "default": "./src/index.js"
-  },
-  "sideEffects": false,
-  "devDependencies": {
