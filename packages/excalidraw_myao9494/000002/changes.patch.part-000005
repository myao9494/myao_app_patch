-
-      /**
-       * Shallowly converts this Set collection to equivalent native JavaScript Array.
-       */
-      toJSON(): Array<T>;
-
-      /**
-       * Shallowly converts this collection to an Array.
-       */
-      toArray(): Array<T>;
-
-      /**
-       * Returns Seq.Set.
-       * @override
-       */
-      toSeq(): Seq.Set<T>;
-
-      // Sequence algorithms
-
-      /**
-       * Returns a new Collection with other collections concatenated to this one.
-       */
