-{
-  "name": "es6-promise-pool",
-  "version": "2.5.0",
-  "description": "Runs Promises in a pool that limits their concurrency.",
-  "author": {
-    "name": "Tim De Pauw",
-    "url": "https://tmdpw.eu"
-  },
-  "main": "es6-promise-pool.js",
