-
-  export interface MangleOptions {
-    eval?: boolean
-    keep_classnames?: boolean | RegExp
-    keep_fnames?: boolean | RegExp
-    module?: boolean
-    nth_identifier?: SimpleIdentifierMangler | WeightedIdentifierMangler
-    properties?: boolean | ManglePropertiesOptions
