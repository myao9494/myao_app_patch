-     * @default false
-     */
-    ssr?: boolean | string;
-    /**
-     * Generate SSR manifest for determining style links and asset preload
-     * directives in production.
-     * @default false
-     */
-    ssrManifest?: boolean | string;
-    /**
-     * Emit assets during SSR.
-     * @default false
-     */
