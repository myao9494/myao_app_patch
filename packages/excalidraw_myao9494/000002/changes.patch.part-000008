-/**
- * ファイルパスがExcalidrawファイルかどうかを判定
- */
-export const isExcalidrawFile = (filePath: string): boolean => {
-  if (!filePath) return false;
-  const pathLower = filePath.toLowerCase();
-  return pathLower.endsWith('.excalidraw') || pathLower.endsWith('.excalidraw.md');
-};
-
-/**
- * パスがObsidianフォルダ内にあるかを判定
- * 簡易的にパスに 'obsidian' が含まれるかで判定
- */
-export const isObsidianPath = (filePath: string): boolean => {
-  if (!filePath) return false;
-  const normalized = filePath.toLowerCase();
-  return normalized.endsWith('.excalidraw.md') || normalized.includes('obsidian');
-};
-
-/** Excalidrawの裏面を持つObsidianノートとして扱うパスかどうかを判定 */
-export const isObsidianDrawingPath = (filePath: string): boolean => {
-  if (!filePath) return false;
-  const normalized = filePath.toLowerCase();
-  return normalized.endsWith('.md') || normalized.endsWith('.excalidraw');
-};
-
-/**
- * 相対パスかどうかを判定
- */
-const isRelativePath = (path: string): boolean => {
-  // 絶対パスの判定（Unix: /で始まる, Windows: C:\など）
-  if (path.startsWith('/')) return false;
-  if (/^[a-zA-Z]:[\\/]/.test(path)) return false;
-  // URL形式は除外
-  if (path.startsWith('http://') || path.startsWith('https://')) return false;
-  if (path.startsWith('obsidian://')) return false;
-  // その他は相対パスとみなす
-  return true;
-};
-
-/**
- * 相対パスを絶対パスに変換
- */
-const resolveRelativePath = (relativePath: string, currentFolder: string): string => {
-  // currentFolderをスラッシュで正規化
-  const normalizedFolder = currentFolder.replace(/\\/g, '/');
-  const normalizedRelative = relativePath.replace(/\\/g, '/');
-
-  // 相対パスの各セグメントを処理
-  const folderParts = normalizedFolder.split('/').filter(p => p !== '');
-  const relativeParts = normalizedRelative.split('/');
-
-  for (const part of relativeParts) {
-    if (part === '..') {
-      // 親ディレクトリへ移動
-      folderParts.pop();
-    } else if (part !== '.' && part !== '') {
-      // 通常のディレクトリ/ファイル名を追加
-      folderParts.push(part);
-    }
-  }
-
-  // Unix形式の絶対パスを構築
-  // 元のフォルダがスラッシュで始まっていた場合は先頭にスラッシュを追加
-  const prefix = normalizedFolder.startsWith('/') ? '/' : '';
-  return prefix + folderParts.join('/');
-};
-
-/**
- * 付箋のリンククリック処理
- * Excalidrawファイル以外は外部ファイルビューアーにリダイレクト
- */
-export const handleStickyNoteLink = async (linkUrl: string, currentFolder?: string): Promise<void> => {
-  try {
-    // HTMLエンティティをデコード（&quot; → "）
-    let trimmedLink = linkUrl.trim().replace(/&quot;/g, '"');
-
-    if (CMD_LINK_PATTERN.test(trimmedLink)) {
-      await runCommandViaBackend(trimmedLink, currentFolder); // ← フォルダを渡す
-      return;
-    }
-
-    // Obsidian URLスキームの場合は同梱FastAPI経由で開く。
-    if (trimmedLink.startsWith('obsidian://')) {
-      try {
-        const encodedUrl = encodeURIComponent(trimmedLink);
-        const response = await fetch(`${API_BASE_URL}/api/open-url?url=${encodedUrl}`);
-
-        if (response.ok) {
-          const result = await response.json();
-          console.log('Obsidianで開きました:', result.url);
-        } else {
-          console.error('Obsidian URLを開けませんでした:', response.status);
-          if (typeof window !== 'undefined' && window.alert) {
-            window.alert('Obsidianを開くことができませんでした。');
-          }
-        }
-      } catch (error) {
-        console.error('Error opening Obsidian URL:', error);
-        if (typeof window !== 'undefined' && window.alert) {
-          window.alert('Obsidianを開く際にエラーが発生しました。');
-        }
-      }
-      return;
-    }
-
-    // URLの場合はそのまま開く
-    if (trimmedLink.startsWith('http://') || trimmedLink.startsWith('https://')) {
-      window.open(trimmedLink, '_blank');
-      return;
-    }
-
-    const isRelativeFilePath = isRelativePath(trimmedLink);
-    const targetPath = isRelativeFilePath && currentFolder
-      ? resolveRelativePath(trimmedLink, currentFolder)
-      : trimmedLink;
-
-    if (isRelativeFilePath && currentFolder) {
-      console.log(`[Link] Resolved relative path: ${trimmedLink} -> ${targetPath}`);
-    } else {
-      console.log(`[Link] Using absolute path directly: ${targetPath}`);
-    }
-
-    // ファイルパスの場合
-    if (isExcalidrawFile(targetPath)) {
-      // Excalidrawファイルの場合は現在のアプリで開く
-      const currentUrl = new URL(window.location.href);
-      currentUrl.searchParams.set('filepath', targetPath);
-      window.open(currentUrl.toString(), '_blank', 'noopener');
-    } else {
-      // Excalidraw以外は同梱FastAPIからOSの既定アプリへ渡す。
-      try {
-        const redirectWindow = window.open('about:blank', '_blank');
-        await openPathWithFallback(targetPath, redirectWindow);
-      } catch (error) {
-        console.error('Error opening file via bundled backend:', error);
-        if (typeof window !== 'undefined' && window.alert) {
-          window.alert('ファイルを開けませんでした。ファイルが存在し、OSに対応アプリが設定されているか確認してください。');
-        }
-      }
-    }
-  } catch (error) {
-    console.error('Error handling sticky note link:', error);
-    if (typeof window !== 'undefined' && window.alert) {
-      window.alert('リンクの処理中にエラーが発生しました。');
-    }
-  }
-};
-
-/**
- * SVGファイルとして保存する関数
- * @param elements 選択された要素または全要素
- * @param appState アプリケーションの状態
- * @param files ファイルデータ
- * @param currentFolder 現在のフォルダパス
- * @param selectedElements 選択された要素（nullの場合は全要素）
- */
-export const exportToSvgFile = async (
-  elements: NonDeletedExcalidrawElement[],
-  appState: AppState,
-  files: any,
-  currentFolder: string | null,
-  selectedElements: NonDeletedExcalidrawElement[] | null = null
-): Promise<boolean> => {
-  try {
-    // ファイル名を入力させる
-    const fileName = prompt('SVGファイル名を入力してください（拡張子なし）:');
-    if (!fileName || !fileName.trim()) {
-      return false;
-    }
-
-    // 選択された要素がある場合はそれを使用、なければ全要素を使用
-    const baseElementsForExport = selectedElements && selectedElements.length > 0 ? selectedElements : elements;
-
-    // 付箋のテキストが含まれるように、containerIdを持つテキスト要素も含める
-    let elementsToExport: NonDeletedExcalidrawElement[] = baseElementsForExport;
-    if (selectedElements && selectedElements.length > 0) {
-      const selectedIds = new Set(selectedElements.map(el => el.id));
-      const relatedTextElements = elements.filter(element =>
-        element.type === 'text' &&
-        element.containerId &&
-        selectedIds.has(element.containerId)
-      );
-
-      // 関連するテキスト要素を追加
-      const additionalTextElements = relatedTextElements.filter(textEl => !selectedIds.has(textEl.id));
-      elementsToExport = [...selectedElements, ...additionalTextElements];
-
-      console.log('Added related text elements:', additionalTextElements.length);
-    }
-
-    // エクスポート用にクローンを作成（オリジナルを汚さないため）
-    const elementsForSvg = elementsToExport.map(element => ({ ...element }));
-
-    // コンテナにリンクがある場合は、紐づくテキスト要素にも同じリンクを設定
-    const elementCloneMap = new Map(elementsForSvg.map(element => [element.id, element]));
-    const originalElementMap = new Map(elements.map(element => [element.id, element]));
-
-    elementsForSvg.forEach(clone => {
-      if (!clone.link) {
-        return;
-      }
-
-      const original = originalElementMap.get(clone.id);
-      if (!original) {
-        return;
-      }
-
-      const boundTexts = elements.filter(element => element.type === 'text' && element.containerId === original.id);
-      boundTexts.forEach(boundText => {
-        const textClone = elementCloneMap.get(boundText.id);
-        if (textClone && !textClone.link) {
-          textClone.link = clone.link;
-        }
-      });
-    });
-
-    // SVGを生成（改善版）
-    const svg = await exportToSvg({
-      elements: elementsForSvg,
-      appState: {
-        ...appState,
-        exportBackground: true,
-        exportWithDarkMode: false,
-        exportEmbedScene: false,
-        // フォント関連の設定を保持
-        currentItemFontFamily: appState.currentItemFontFamily || 1, // デフォルトフォント
-        currentItemFontSize: appState.currentItemFontSize || 20,
-        // テキストの可視性を確保
-        currentItemStrokeColor: appState.currentItemStrokeColor || '#000000',
-        currentItemOpacity: appState.currentItemOpacity || 100,
-      },
-      files,
-      exportPadding: 10,
-      metadata: "" // 必要に応じてメタデータを追加
-    });
-
-    // SVGをテキストとして取得
-    enhanceSvgLinks(svg);
-    const svgString = new XMLSerializer().serializeToString(svg);
-
-    // デバッグ用：SVG内容を確認
-    console.log('Generated SVG contains font data:', svgString.includes('@font-face'));
-    console.log('Text elements count:', elementsForSvg.filter(e => e.type === 'text').length);
-    console.log('Elements to export:', elementsForSvg.length);
-
-    // ファイルパスを構築
-    const normalizedFolder = currentFolder ? currentFolder.replace(/\\/g, '/') : '.';
-    const filePath = `${normalizedFolder}/${fileName.trim()}.svg`;
-
-    // バックエンドに保存
-    const response = await fetch(`${API_BASE_URL}/api/save-svg`, {
-      method: 'POST',
-      headers: {
-        'Content-Type': 'application/json',
-      },
-      body: JSON.stringify({
-        filepath: filePath,
-        svg_content: svgString
-      })
-    });
-
-    if (!response.ok) {
-      throw new Error(`HTTP error! status: ${response.status}`);
-    }
-
-    const result = await response.json();
-    console.log('SVG file saved successfully:', result.message);
-    return true;
-  } catch (error) {
-    console.error('Error saving SVG file:', error);
-    return false;
-  }
-};
-
-/**
- * JsonErrorResponseをユーザー向けメッセージに整形
- */
-export function formatJsonError(error: JsonErrorResponse): string {
-  let message = error.message;
-
-  // JSON構文エラーの場合
-  if (error.error_type === 'json_syntax') {
-    if (error.line && error.column) {
-      message += `\n\n行 ${error.line}, カラム ${error.column}`;
-    }
-    if (error.context) {
-      message += `\n\nエラー箇所:\n${error.context}`;
-    }
-  }
-
-  // バリデーションエラーの場合
-  if (error.error_type === 'validation' && error.details && error.details.length > 0) {
-    message += '\n\n詳細:';
-    error.details.forEach((detail, idx) => {
-      message += `\n${idx + 1}. ${detail.field}`;
-      message += `\n   ${detail.message}`;
-      if (detail.value) {
-        message += `\n   値: ${detail.value}`;
-      }
-    });
-  }
-
-  return message;
-}
-
-/**
- * ファイルをアーカイブ（バックアップフォルダへ移動）する
- */
-export const archiveFile = async (
-  filePath: string
-): Promise<ArchiveFileResponse> => {
-  try {
-    const response = await fetch(`${API_BASE_URL}/api/archive-file`, {
-      method: 'POST',
-      headers: {
-        'Content-Type': 'application/json',
-      },
-      body: JSON.stringify({
-        filepath: filePath
-      })
-    });
-
-    if (!response.ok) {
-      throw new Error(`HTTP error! status: ${response.status}`);
-    }
-
-    const result = await response.json();
-    return result;
-  } catch (error) {
-    console.error('Error archiving file:', error);
-    return {
-      success: false,
-      error: error instanceof Error ? error.message : 'Unknown error'
-    };
-  }
-};
-
-/**
- * LoadFileErrorをユーザー向けメッセージに整形
- */
-export function formatLoadFileError(loadError: LoadFileError): string {
-  return formatJsonError(loadError.error);
-}
diff --git a/utils/libraryItems.test.ts b/utils/libraryItems.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1510779db959a41f425a932207abecba1b0a1b6e
--- /dev/null
+++ b/utils/libraryItems.test.ts
@@ -0,0 +1,70 @@
+import { describe, expect, it } from 'vitest';
+import { isLibrarySynced, markLibrarySynced, parseLibraryContent, refreshLibraryItemIds } from './libraryItems';
+
+describe('parseLibraryContent', () => {
+  it('空ファイルは空ライブラリとして扱う', () => {
+    expect(parseLibraryContent('  \n')).toEqual({ libraryItems: [] });
+  });
+
+  it('オブジェクトでないJSONはエラー', () => {
+    expect(() => parseLibraryContent('123')).toThrow();
+  });
+});
+
+describe('refreshLibraryItemIds', () => {
+  const item = {
+    id: 'item-1',
+    status: 'published',
+    elements: [
+      {
+        id: 'box',
+        type: 'rectangle',
+        groupIds: ['g1'],
+        boundElements: [{ type: 'text', id: 'label' }, { type: 'arrow', id: 'arrow' }],
+      },
+      { id: 'label', type: 'text', groupIds: ['g1'], containerId: 'box' },
+      {
+        id: 'arrow',
+        type: 'arrow',
+        groupIds: [],
+        startBinding: { elementId: 'box', focus: 0, gap: 1 },
+        endBinding: null,
+      },
+    ],
+  };
+
+  it('アイテムと要素のIDを振り直す', () => {
+    const [refreshed] = refreshLibraryItemIds([item], 'seed');
+    expect(refreshed.id).not.toBe('item-1');
+    expect(refreshed.status).toBe('published');
+    const ids = refreshed.elements.map((element: any) => element.id);
+    expect(ids).not.toContain('box');
+    expect(new Set(ids).size).toBe(3);
+  });
+
+  it('グループ・テキストの所属先・矢印の接続を保つ', () => {
+    const [refreshed] = refreshLibraryItemIds([item], 'seed');
+    const [box, label, arrow] = refreshed.elements;
+
+    expect(box.groupIds).toEqual(label.groupIds);
+    expect(box.groupIds[0]).not.toBe('g1');
+    expect(label.containerId).toBe(box.id);
+    expect(box.boundElements.map((bound: any) => bound.id)).toEqual([label.id, arrow.id]);
+    expect(arrow.startBinding.elementId).toBe(box.id);
+    expect(arrow.endBinding).toBeNull();
+  });
+
+  it('元のアイテムは変更しない', () => {
+    refreshLibraryItemIds([item], 'seed');
+    expect(item.elements[1].containerId).toBe('box');
+  });
+});
+
+describe('isLibrarySynced', () => {
+  it('同じアイテム構成なら同期済み（順序は問わない）、追加・削除があれば未同期', () => {
+    markLibrarySynced([{ id: 'a' }, { id: 'b' }]);
+    expect(isLibrarySynced([{ id: 'b' }, { id: 'a' }])).toBe(true);
+    expect(isLibrarySynced([{ id: 'a' }])).toBe(false);
+    expect(isLibrarySynced([{ id: 'a' }, { id: 'b' }, { id: 'c' }])).toBe(false);
+  });
+});
diff --git a/utils/libraryItems.ts b/utils/libraryItems.ts
new file mode 100644
index 0000000000000000000000000000000000000000..86e38f5ae9d6e8ec2598144085895ba112789141
--- /dev/null
+++ b/utils/libraryItems.ts
@@ -0,0 +1,115 @@
+/**
+ * 共有ライブラリ (public/excalidraw_lib/my_lib.excalidrawlib) の読み込み補助
+ */
+
+export const LIBRARY_URL = '/excalidraw_lib/my_lib.excalidrawlib';
+
+const randomSuffix = (): string => Math.random().toString(36).slice(2, 11);
+
+/** ファイルと同期済みのアイテムID一覧（ライブラリはアイテムの追加・削除のみで、編集はできない） */
+let syncedItemIdsKey: string | null = null;
+
+const itemIdsKey = (items: readonly any[]): string =>
+  items.map((item) => item?.id ?? '').sort().join('\n');
+
+/** ファイルと同期済みのアイテムとして記録する */
+export const markLibrarySynced = (items: readonly any[]): void => {
+  syncedItemIdsKey = itemIdsKey(items);
+};
+
+/**
+ * ファイルと同じアイテム構成か。
+ * Excalidraw は読み込んだライブラリも onLibraryChange で通知するため、
+ * これで判定して、ページを開くたびにライブラリファイルを書き換えないようにする。
+ */
+export const isLibrarySynced = (items: readonly any[]): boolean =>
+  syncedItemIdsKey !== null && syncedItemIdsKey === itemIdsKey(items);
+
+/** ライブラリファイルの文字列を解析する。空ファイルは空ライブラリとして扱う */
+export const parseLibraryContent = (libraryContent: string): { libraryItems?: unknown[] } => {
+  const trimmedContent = libraryContent.trim();
+  if (!trimmedContent) {
+    return { libraryItems: [] };
+  }
+
+  const parsed = JSON.parse(trimmedContent);
+  if (!parsed || typeof parsed !== 'object') {
+    throw new Error('ライブラリデータがオブジェクトではありません');
+  }
+  return parsed;
+};
+
+/**
+ * ライブラリアイテムと要素のIDを新しい一意のIDに振り直す。
+ * 1つのアイテム内では「旧ID → 新ID」の対応を共有するため、
+ * グループ・テキストの所属先(containerId)・結び付き(boundElements)・矢印の接続は保たれる。
+ */
+export const refreshLibraryItemIds = (libraryItems: any[], seed: string = `${Date.now()}`): any[] =>
+  libraryItems.map((item) => {
+    const idMap = new Map<string, string>();
+    const remap = (prefix: string, id: string | null | undefined): string | null | undefined => {
+      if (!id) {
+        return id;
+      }
+      let newId = idMap.get(id);
+      if (!newId) {
+        newId = `${prefix}-${seed}-${randomSuffix()}`;
+        idMap.set(id, newId);
+      }
+      return newId;
+    };
+
+    // 先に全要素のIDを確定させ、前方参照（後ろの要素への containerId 等）も解決できるようにする
+    for (const element of item.elements ?? []) {
+      remap('elem', element.id);
+    }
+
+    const remapBinding = (binding: any) =>
+      binding && binding.elementId ? { ...binding, elementId: remap('elem', binding.elementId) } : binding;
+
+    return {
+      ...item,
+      id: `lib-${seed}-${randomSuffix()}`,
+      elements: item.elements?.map((element: any) => ({
+        ...element,
+        id: remap('elem', element.id),
+        groupIds: element.groupIds?.map((groupId: string) => remap('group', groupId)),
+        ...(element.containerId ? { containerId: remap('elem', element.containerId) } : {}),
+        ...(element.frameId ? { frameId: remap('elem', element.frameId) } : {}),
+        ...(Array.isArray(element.boundElements)
+          ? {
+            boundElements: element.boundElements.map((bound: any) => ({
+              ...bound,
+              id: remap('elem', bound.id),
+            })),
+          }
+          : {}),
+        ...(element.startBinding ? { startBinding: remapBinding(element.startBinding) } : {}),
+        ...(element.endBinding ? { endBinding: remapBinding(element.endBinding) } : {}),
+      })),
+    };
+  });
+
+/** ライブラリファイルを読み込み、IDを振り直したアイテムを返す。失敗時は null */
+export const fetchLibraryItems = async (): Promise<any[] | null> => {
+  try {
+    const response = await fetch(LIBRARY_URL, {
+      cache: 'no-store',
+      headers: { 'Cache-Control': 'no-cache' },
+    });
+    if (!response.ok) {
+      return null;
+    }
+    const libraryData = parseLibraryContent(await response.text());
+    if (!Array.isArray(libraryData.libraryItems)) {
+      return null;
+    }
+    const items = refreshLibraryItemIds(libraryData.libraryItems);
+    markLibrarySynced(items);
+    console.log(`ライブラリを読み込みました: ${items.length} アイテム`);
+    return items;
+  } catch (error) {
+    console.warn('ライブラリファイルの読み込みに失敗しました:', error);
+    return null;
+  }
+};
diff --git a/utils/linkHandler.test.ts b/utils/linkHandler.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fafaa016e6a660c9b87e5ce126f0f84df82aa40e
--- /dev/null
+++ b/utils/linkHandler.test.ts
@@ -0,0 +1,105 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+import {
+  REDIRECT_SERVICE_BASE_URL,
+  handleStickyNoteLink,
+  openPathWithFallback,
+} from './linkHandler';
+
+const createPopup = () => ({
+  location: { href: '' },
+  closed: false,
+  close: vi.fn(),
+}) as unknown as Window;
+
+describe('openPathWithFallback', () => {
+  afterEach(() => {
+    vi.restoreAllMocks();
+  });
+
+  it('port 8001が応答する場合はリダイレクトサービスを優先する', async () => {
+    const fetchMock = vi.spyOn(globalThis, 'fetch').mockResolvedValue({} as Response);
+    const popup = createPopup();
+
+    const method = await openPathWithFallback('/tmp/test file.pdf', popup);
+
+    expect(method).toBe('redirect-service');
+    expect(fetchMock).toHaveBeenCalledWith(
+      `${REDIRECT_SERVICE_BASE_URL}/api/config`,
+      expect.objectContaining({ method: 'GET', mode: 'no-cors' }),
+    );
+    expect(popup.location.href).toBe(
+      `${REDIRECT_SERVICE_BASE_URL}/api/open-path?path=%2Ftmp%2Ftest%20file.pdf`,
+    );
+    expect(popup.close).not.toHaveBeenCalled();
+  });
+
+  it('port 8001がない場合は同梱FastAPIのOSハンドラーへフォールバックする', async () => {
+    const fetchMock = vi.spyOn(globalThis, 'fetch')
+      .mockRejectedValueOnce(new TypeError('connection refused'))
+      .mockResolvedValueOnce({
+        ok: true,
+        json: async () => ({ success: true, targetType: 'file' }),
+      } as Response);
+    const popup = createPopup();
+
+    const method = await openPathWithFallback('/tmp/test.pdf', popup);
+
+    expect(method).toBe('system-handler');
+    expect(popup.close).toHaveBeenCalledOnce();
+    expect(fetchMock).toHaveBeenLastCalledWith('/api/open-file', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ filepath: '/tmp/test.pdf' }),
+    });
+  });
+});
+
+describe('handleStickyNoteLink', () => {
+  afterEach(() => {
+    vi.restoreAllMocks();
+  });
+
+  it('cmdリンクは図面のフォルダを作業ディレクトリとしてコマンド実行する', async () => {
+    const fetchMock = vi.spyOn(globalThis, 'fetch').mockResolvedValue({
+      ok: true,
+      json: async () => ({ success: true, command: 'python a.py' }),
+    } as Response);
+
+    await handleStickyNoteLink('cmd python &quot;a b.py&quot;', 'C:\\work\\dir');
+
+    expect(fetchMock).toHaveBeenCalledWith('/api/run-command', expect.objectContaining({
+      method: 'POST',
+      body: JSON.stringify({ command: 'cmd python "a b.py"', working_directory: 'C:/work/dir' }),
+    }));
+  });
+
+  it('相対パスのExcalidrawリンクは図面のフォルダ基準で新しいタブに開く', async () => {
+    window.history.pushState({}, '', '/?filepath=%2Fwork%2Fmain.excalidraw');
+    const openMock = vi.spyOn(window, 'open').mockReturnValue(null);
+
+    await handleStickyNoteLink('../other/sub.excalidraw', '/work/dir');
+
+    const openedUrl = new URL(openMock.mock.calls[0][0] as string);
+    expect(openedUrl.searchParams.get('filepath')).toBe('/work/other/sub.excalidraw');
+    expect(openMock.mock.calls[0][1]).toBe('_blank');
+  });
+
+  it('http(s)リンクはそのまま新しいタブで開く', async () => {
+    const openMock = vi.spyOn(window, 'open').mockReturnValue(null);
+
+    await handleStickyNoteLink('  https://example.com/a  ');
+
+    expect(openMock).toHaveBeenCalledWith('https://example.com/a', '_blank');
+  });
+
+  it('obsidian:// はバックエンドのopen-urlに渡す', async () => {
+    const fetchMock = vi.spyOn(globalThis, 'fetch').mockResolvedValue({ ok: true } as Response);
+
+    await handleStickyNoteLink('obsidian://open?vault=v&file=a');
+
+    expect(fetchMock).toHaveBeenCalledWith(
+      `/api/open-url?url=${encodeURIComponent('obsidian://open?vault=v&file=a')}`,
+    );
+  });
+});
diff --git a/utils/linkHandler.ts b/utils/linkHandler.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0773e535b9fb64ec3816956976d58200786c1ae9
--- /dev/null
+++ b/utils/linkHandler.ts
@@ -0,0 +1,153 @@
+/**
+ * 図形リンク（付箋のリンク）のクリック処理と、OS側でファイルを開く処理
+ *
+ * リンクの種類ごとの動作:
+ * - `cmd ...`            : バックエンドでシェルコマンドを実行（作業フォルダ = 図面のフォルダ）
+ * - `obsidian://...`     : バックエンド経由でOSのURLハンドラーへ渡す
+ * - `http(s)://...`      : 新しいタブで開く
+ * - `.excalidraw(.md)`   : このアプリの新しいタブで開く（相対パスは図面のフォルダ基準）
+ * - その他のファイル     : port 8001 のリダイレクトサービス、なければOSの既定アプリで開く
+ */
+import { openFileViaBackend, openUrlViaBackend, runCommandViaBackend } from './backendApi';
+import {
+  isExcalidrawFile,
+  isRelativePath,
+  normalizePath,
+  openFileInNewTab,
+  resolveRelativePath,
+} from './pathUtils';
+
+const CMD_LINK_PATTERN = /^cmd(\s|$)/i;
+
+const alertUser = (message: string): void => {
+  if (typeof window !== 'undefined' && window.alert) {
+    window.alert(message);
+  }
+};
+
+const getRedirectServiceBaseUrl = (): string => {
+  const configuredUrl = import.meta.env.VITE_REDIRECT_SERVICE_URL?.trim();
+  if (configuredUrl) {
+    return configuredUrl.replace(/\/$/, '');
+  }
+  const host = window.location.hostname || 'localhost';
+  return `http://${host}:8001`;
+};
+
+/** 任意の外部リダイレクトサービス（既定: 同じホストの port 8001） */
+export const REDIRECT_SERVICE_BASE_URL = getRedirectServiceBaseUrl();
+
+/** port 8001 のリダイレクトサービスが応答するか確認する */
+export const checkRedirectServiceAvailable = async (timeoutMs: number = 500): Promise<boolean> => {
+  const controller = new AbortController();
+  const timeoutId = window.setTimeout(() => controller.abort(), timeoutMs);
+  try {
+    await fetch(`${REDIRECT_SERVICE_BASE_URL}/api/config`, {
+      method: 'GET',
+      mode: 'no-cors',
+      cache: 'no-store',
+      signal: controller.signal,
+    });
+    return true;
+  } catch {
+    return false;
+  } finally {
+    window.clearTimeout(timeoutId);
+  }
+};
+
+/**
+ * port 8001 のリダイレクトサービスを優先し、なければ同梱FastAPIから
+ * OSの既定アプリで開く。redirectWindow にはユーザー操作中に開いた空タブを渡せる
+ * （非同期処理の後では window.open がポップアップブロックされるため）。
+ */
+export const openPathWithFallback = async (
+  filePath: string,
+  redirectWindow?: Window | null,
+): Promise<'redirect-service' | 'system-handler'> => {
+  if (await checkRedirectServiceAvailable()) {
+    const redirectUrl = `${REDIRECT_SERVICE_BASE_URL}/api/open-path?path=${encodeURIComponent(filePath)}`;
+    if (redirectWindow) {
+      redirectWindow.location.href = redirectUrl;
+    } else {
+      window.location.href = redirectUrl;
+    }
+    return 'redirect-service';
+  }
+
+  if (redirectWindow && redirectWindow !== window && !redirectWindow.closed) {
+    redirectWindow.close();
+  }
+  await openFileViaBackend(filePath);
+  return 'system-handler';
+};
+
+/** `cmd <command>` リンクをバックエンドで実行する */
+const runCommandLink = async (command: string, currentFolder?: string): Promise<void> => {
+  const workingDirectory = currentFolder && currentFolder.trim() ? normalizePath(currentFolder) : undefined;
+  console.log('[Link] Running command:', command, 'in', workingDirectory ?? '(not provided)');
+  try {
+    const result = await runCommandViaBackend(command, workingDirectory);
+    if (!result.success) {
+      throw new Error(result.error || 'Backend reported command execution failure');
+    }
+  } catch (error) {
+    console.error('Error executing command via backend:', error);
+    alertUser('コマンドを実行できませんでした。コマンドの形式を確認してください。');
+  }
+};
+
+/**
+ * 図形リンクのクリック処理
+ * @param linkUrl 図形に設定されたリンク
+ * @param currentFolder 開いている図面のフォルダ（相対パス解決とコマンドの作業フォルダに使用）
+ */
+export const handleStickyNoteLink = async (linkUrl: string, currentFolder?: string): Promise<void> => {
+  try {
+    // HTMLエンティティをデコード（&quot; → "）
+    const link = linkUrl.trim().replace(/&quot;/g, '"');
+
+    if (CMD_LINK_PATTERN.test(link)) {
+      await runCommandLink(link, currentFolder);
+      return;
+    }
+
+    if (link.startsWith('obsidian://')) {
+      try {
+        if (!(await openUrlViaBackend(link))) {
+          alertUser('Obsidianを開くことができませんでした。');
+        }
+      } catch (error) {
+        console.error('Error opening Obsidian URL:', error);
+        alertUser('Obsidianを開く際にエラーが発生しました。');
+      }
+      return;
+    }
+
+    if (link.startsWith('http://') || link.startsWith('https://')) {
+      window.open(link, '_blank');
+      return;
+    }
+
+    const targetPath = isRelativePath(link) && currentFolder
+      ? resolveRelativePath(link, currentFolder)
+      : link;
+    console.log(`[Link] ${link} -> ${targetPath}`);
+
+    if (isExcalidrawFile(targetPath)) {
+      openFileInNewTab(targetPath);
+      return;
+    }
+
+    try {
+      const redirectWindow = window.open('about:blank', '_blank');
+      await openPathWithFallback(targetPath, redirectWindow);
+    } catch (error) {
+      console.error('Error opening file via bundled backend:', error);
+      alertUser('ファイルを開けませんでした。ファイルが存在し、OSに対応アプリが設定されているか確認してください。');
+    }
+  } catch (error) {
+    console.error('Error handling sticky note link:', error);
+    alertUser('リンクの処理中にエラーが発生しました。');
+  }
+};
