diff --git a/node_modules/use-callback-ref/dist/es2015/createRef.js b/node_modules/use-callback-ref/dist/es2015/createRef.js
deleted file mode 100644
index 3e639de13c383cd80c8585e811769761dc578629..0000000000000000000000000000000000000000
--- a/node_modules/use-callback-ref/dist/es2015/createRef.js
+++ /dev/null
@@ -1,23 +0,0 @@
-/**
- * creates a Ref object with on change callback
- * @param callback
- * @returns {RefObject}
- *
- * @see {@link useCallbackRef}
- * @see https://reactjs.org/docs/refs-and-the-dom.html#creating-refs
- */
-export function createCallbackRef(callback) {
-    var current = null;
-    return {
-        get current() {
-            return current;
-        },
-        set current(value) {
-            var last = current;
-            if (last !== value) {
-                current = value;
-                callback(value, last);
-            }
-        },
-    };
-}
