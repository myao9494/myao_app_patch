+/** メールファイル(.eml)の Subject ヘッダーを取り出す */
+export const extractEmailSubjectFromFile = async (file: File): Promise<string | null> => {
+  try {
+    const text = await file.text();
+    const subjectMatch = text.match(/^Subject:\s*(.+)$/m);
+    return subjectMatch ? subjectMatch[1].trim() : null;
+  } catch (error) {
+    console.error('Error extracting email subject:', error);
+    return null;
+  }
+};
diff --git a/utils/drawWatcher.test.ts b/utils/drawWatcher.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8017cffd66398822b401f5a66a58254942c7bf03
--- /dev/null
+++ b/utils/drawWatcher.test.ts
@@ -0,0 +1,116 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { createDrawWatcher } from './drawWatcher';
+
+/** onChange の購読と要素一覧だけを持つ、Excalidraw API の最小モック */
+const createFakeApi = () => {
+  let elements: any[] = [];
+  const listeners = new Set<(elements: any[], appState: any) => void>();
+  return {
+    api: {
+      getSceneElements: () => elements,
+      onChange: (callback: (elements: any[], appState: any) => void) => {
+        listeners.add(callback);
+        return () => listeners.delete(callback);
+      },
+    } as any,
+    setElements: (next: any[]) => {
+      elements = next;
+    },
+    emitTool: (type: string) => listeners.forEach((listener) => listener(elements, { activeTool: { type } })),
+    listenerCount: () => listeners.size,
+  };
+};
+
+const pointerUp = () => document.dispatchEvent(new Event('pointerup'));
+
+describe('createDrawWatcher', () => {
+  afterEach(() => {
+    vi.restoreAllMocks();
+  });
+
+  it('対象ツールで要素が描かれたら onCreated → onFinish の順に呼び、監視を終える', () => {
+    const fake = createFakeApi();
+    const calls: string[] = [];
+    createDrawWatcher(fake.api).start({
+      toolType: 'rectangle',
+      onCreated: (element) => calls.push(`created:${element.id}`),
+      onFinish: () => calls.push('finish'),
+    });
+
+    fake.setElements([{ id: 'r1', type: 'rectangle' }]);
+    pointerUp();
+    pointerUp();
+
+    expect(calls).toEqual(['created:r1', 'finish']);
+    expect(fake.listenerCount()).toBe(0);
+  });
+
+  it('要素が増えない pointerup（クリックだけ）では監視を続ける', () => {
+    const fake = createFakeApi();
+    const onCreated = vi.fn();
+    createDrawWatcher(fake.api).start({ toolType: 'rectangle', onCreated });
+
+    pointerUp();
+    fake.setElements([{ id: 'r1', type: 'rectangle' }]);
+    pointerUp();
+
+    expect(onCreated).toHaveBeenCalledOnce();
+  });
+
+  it('描かずに別のツールへ切り替えたら取り消し、onFinish だけ呼ぶ', () => {
+    const fake = createFakeApi();
+    const onCreated = vi.fn();
+    const onFinish = vi.fn();
+    createDrawWatcher(fake.api).start({ toolType: 'arrow', onCreated, onFinish });
+
+    fake.emitTool('arrow'); // setActiveTool が反映された
+    fake.emitTool('selection'); // ユーザーが選択ツールに戻した
+    fake.setElements([{ id: 'a1', type: 'arrow' }]);
+    pointerUp();
+
+    expect(onFinish).toHaveBeenCalledOnce();
+    expect(onCreated).not.toHaveBeenCalled();
+    expect(fake.listenerCount()).toBe(0);
+  });
+
+  it('ツールの反映前に届いた古い状態の通知では取り消さない', () => {
+    const fake = createFakeApi();
+    const onCreated = vi.fn();
+    createDrawWatcher(fake.api).start({ toolType: 'line', onCreated });
+
+    fake.emitTool('selection'); // setActiveTool 反映前の通知
+    fake.setElements([{ id: 'l1', type: 'line' }]);
+    pointerUp();
+
+    expect(onCreated).toHaveBeenCalledOnce();
+  });
+
+  it('別の種類の要素が描かれた場合は onCreated を呼ばずに終える', () => {
+    const fake = createFakeApi();
+    const onCreated = vi.fn();
+    const onFinish = vi.fn();
+    createDrawWatcher(fake.api).start({ toolType: 'arrow', onCreated, onFinish });
+
+    fake.setElements([{ id: 't1', type: 'text' }]);
+    pointerUp();
+
+    expect(onCreated).not.toHaveBeenCalled();
+    expect(onFinish).toHaveBeenCalledOnce();
+  });
+
+  it('新しい監視を始めると前の監視は取り消される', () => {
+    const fake = createFakeApi();
+    const watcher = createDrawWatcher(fake.api);
+    const first = { onCreated: vi.fn(), onFinish: vi.fn() };
+    const second = { onCreated: vi.fn(), onFinish: vi.fn() };
+
+    watcher.start({ toolType: 'rectangle', ...first });
+    watcher.start({ toolType: 'line', ...second });
+    fake.setElements([{ id: 'l1', type: 'line' }]);
+    pointerUp();
+
+    expect(first.onFinish).toHaveBeenCalledOnce();
+    expect(first.onCreated).not.toHaveBeenCalled();
+    expect(second.onCreated).toHaveBeenCalledOnce();
+  });
+});
diff --git a/utils/drawWatcher.ts b/utils/drawWatcher.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e7ee2871b353a50b9a3b5f3a8f8dcc4d6a533a61
--- /dev/null
+++ b/utils/drawWatcher.ts
@@ -0,0 +1,72 @@
+/**
+ * 「ツールを切り替えた後、次に描かれた要素に後処理をする」ための監視
+ *
+ * C / M / U キーは描画ツールを選んだうえで、描き終えた要素に処理
+ * （矢じりを消す・テキストの背面へ送る・テキストとグループ化する）を行う。
+ * 描かずにツールを切り替えた（Esc など）場合は監視をやめ、onCancel を呼ぶ。
+ * 監視は同時に1つだけで、新しい監視を始めると前の監視はキャンセルされる。
+ */
+import type { ExcalidrawImperativeAPI } from '@excalidraw/excalidraw/types';
+import type { NonDeletedExcalidrawElement } from '@excalidraw/excalidraw/element/types';
+
+export interface DrawWatchOptions {
+  /** 監視対象のツール（このツール以外に切り替わったらキャンセル） */
+  toolType: string;
+  /** 新しい要素が描かれたとき（ポインタを離した時点）に呼ばれる */
+  onCreated: (newElement: NonDeletedExcalidrawElement, elements: readonly NonDeletedExcalidrawElement[]) => void;
+  /** 描画完了・キャンセルのどちらでも最後に呼ばれる（スタイルの復元など） */
+  onFinish?: () => void;
+}
+
+export interface DrawWatcher {
+  start: (options: DrawWatchOptions) => void;
+  cancel: () => void;
+}
+
+export const createDrawWatcher = (api: ExcalidrawImperativeAPI): DrawWatcher => {
+  let cleanup: (() => void) | null = null;
+
+  const stop = () => {
+    const finish = cleanup;
+    cleanup = null;
+    finish?.();
+  };
+
+  const start = ({ toolType, onCreated, onFinish }: DrawWatchOptions) => {
+    stop();
+    const initialCount = api.getSceneElements().length;
+
+    const handlePointerUp = () => {
+      const elements = api.getSceneElements();
+      if (elements.length <= initialCount) {
+        return;
+      }
+      const newElement = elements[elements.length - 1];
+      if (newElement.type === toolType) {
+        onCreated(newElement, elements);
+      }
+      stop();
+    };
+
+    // 描かずに別ツールへ切り替えたら監視をやめる。
+    // setActiveTool の反映は非同期のため、対象ツールが有効になったのを確認してから判定する。
+    // （描画中の pointerup は、Excalidraw がツールを戻すより先に document で受け取る）
+    let toolActivated = false;
+    const unsubscribeChange = api.onChange?.((_elements, appState) => {
+      if (appState.activeTool?.type === toolType) {
+        toolActivated = true;
+      } else if (toolActivated) {
+        stop();
+      }
+    });
+
+    document.addEventListener('pointerup', handlePointerUp);
+    cleanup = () => {
+      document.removeEventListener('pointerup', handlePointerUp);
+      unsubscribeChange?.();
+      onFinish?.();
+    };
+  };
+
+  return { start, cancel: stop };
+};
