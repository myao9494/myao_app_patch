-  data: string;
-  filePath?: string;
-}
-
-export interface EmailSaveResponse {
-  success: boolean;
-  savedPath?: string;
-  error?: string;
-}
-
-/**
- * メール専用の付箋要素を作成（青色）
- */
-export const createEmailStickyNote = (
-  x: number,
-  y: number,
