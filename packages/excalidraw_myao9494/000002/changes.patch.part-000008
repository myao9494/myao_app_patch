diff --git a/utils/pathUtils.test.ts b/utils/pathUtils.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..916d4ac39294befb8b36568802c312a9779f103e
--- /dev/null
+++ b/utils/pathUtils.test.ts
@@ -0,0 +1,67 @@
+import { describe, expect, it } from 'vitest';
+import {
+  buildAppUrlForFile,
+  getFilePathFromUrl,
+  getParentFolder,
+  isExcalidrawFile,
+  isRelativePath,
+  normalizePath,
+  resolveRelativePath,
+} from './pathUtils';
+
+describe('normalizePath / getParentFolder', () => {
+  it('Windowsの区切りを / に統一する', () => {
+    expect(normalizePath('C:\\work\\a.excalidraw')).toBe('C:/work/a.excalidraw');
+  });
+
+  it('親フォルダを返し、区切りがなければ null', () => {
+    expect(getParentFolder('/tmp/dir/a.excalidraw')).toBe('/tmp/dir');
+    expect(getParentFolder('C:\\work\\a.excalidraw')).toBe('C:/work');
+    expect(getParentFolder('a.excalidraw')).toBeNull();
+    expect(getParentFolder(null)).toBeNull();
+  });
+});
+
+describe('isExcalidrawFile', () => {
+  it.each([
+    ['/a/b.excalidraw', true],
+    ['/a/b.EXCALIDRAW.md', true],
+    ['/a/b.md', false],
+    ['/a/b.png', false],
+    ['', false],
+  ])('%s -> %s', (path, expected) => {
+    expect(isExcalidrawFile(path)).toBe(expected);
+  });
+});
+
+describe('isRelativePath / resolveRelativePath', () => {
+  it.each([
+    ['docs/a.pdf', true],
+    ['../a.pdf', true],
+    ['/abs/a.pdf', false],
+    ['C:\\abs\\a.pdf', false],
+    ['https://example.com', false],
+    ['obsidian://open?vault=v', false],
+  ])('isRelativePath(%s) -> %s', (path, expected) => {
+    expect(isRelativePath(path)).toBe(expected);
+  });
+
+  it('. と .. を解決して絶対パスにする', () => {
+    expect(resolveRelativePath('../docs/./a.pdf', '/home/u/work')).toBe('/home/u/docs/a.pdf');
+    expect(resolveRelativePath('uploads\\files\\a.txt', 'C:/work')).toBe('C:/work/uploads/files/a.txt');
+  });
+});
+
+describe('URL helpers', () => {
+  it('パーセント記号を含むファイル名を二重デコードしない', () => {
+    window.history.pushState({}, '', '/?filepath=%2Ftmp%2F100%252Fdone.excalidraw');
+    expect(getFilePathFromUrl()).toBe('/tmp/100%2Fdone.excalidraw');
+  });
+
+  it('filepath だけを差し替えたURLを作る', () => {
+    window.history.pushState({}, '', '/?filepath=%2Fold.excalidraw&x=1');
+    const url = new URL(buildAppUrlForFile('/new dir/a.excalidraw'));
+    expect(url.searchParams.get('filepath')).toBe('/new dir/a.excalidraw');
+    expect(url.searchParams.get('x')).toBe('1');
+  });
+});
diff --git a/utils/pathUtils.ts b/utils/pathUtils.ts
new file mode 100644
index 0000000000000000000000000000000000000000..172a8c45d3a8cface4e41afa626543d4e7fd19a8
--- /dev/null
+++ b/utils/pathUtils.ts
@@ -0,0 +1,67 @@
+/**
+ * ファイルパス・URL まわりの純粋関数
+ *
+ * フロントエンドではパス区切りを常に `/` に正規化して扱う（Windowsパスも同様）。
+ */
+
+/** パス区切りを `/` に統一する */
+export const normalizePath = (path: string): string => path.replace(/\\/g, '/');
+
+/** ファイルパスの親フォルダを返す。区切りを含まない場合は null */
+export const getParentFolder = (filePath: string | null | undefined): string | null => {
+  if (!filePath) {
+    return null;
+  }
+  const normalized = normalizePath(filePath);
+  const lastSlashIndex = normalized.lastIndexOf('/');
+  return lastSlashIndex !== -1 ? normalized.substring(0, lastSlashIndex) : null;
+};
+
+/** Excalidraw の図面ファイル（.excalidraw / .excalidraw.md）か判定する */
+export const isExcalidrawFile = (filePath: string): boolean => {
+  if (!filePath) return false;
+  const pathLower = filePath.toLowerCase();
+  return pathLower.endsWith('.excalidraw') || pathLower.endsWith('.excalidraw.md');
+};
+
+/** 相対パスか判定する（URL・Unix/Windowsの絶対パスは除外） */
+export const isRelativePath = (path: string): boolean => {
+  if (path.startsWith('/')) return false;
+  if (/^[a-zA-Z]:[\\/]/.test(path)) return false;
+  if (path.startsWith('http://') || path.startsWith('https://')) return false;
+  if (path.startsWith('obsidian://')) return false;
+  return true;
+};
+
+/** 基準フォルダからの相対パスを絶対パスに変換する（`.` と `..` を解決） */
+export const resolveRelativePath = (relativePath: string, currentFolder: string): string => {
+  const normalizedFolder = normalizePath(currentFolder);
+  const folderParts = normalizedFolder.split('/').filter((part) => part !== '');
+
+  for (const part of normalizePath(relativePath).split('/')) {
+    if (part === '..') {
+      folderParts.pop();
+    } else if (part !== '.' && part !== '') {
+      folderParts.push(part);
+    }
+  }
+
+  const prefix = normalizedFolder.startsWith('/') ? '/' : '';
+  return prefix + folderParts.join('/');
+};
+
+/** URLの `?filepath=` を返す。URLSearchParams が1回デコード済みなので二重デコードしない */
+export const getFilePathFromUrl = (): string | null =>
+  new URLSearchParams(window.location.search).get('filepath');
+
+/** 指定ファイルをこのアプリで開くURL（現在のURLの filepath だけを差し替える） */
+export const buildAppUrlForFile = (filePath: string): string => {
+  const url = new URL(window.location.href);
+  url.searchParams.set('filepath', filePath);
+  return url.toString();
+};
+
+/** 指定ファイルをこのアプリの新しいタブで開く */
+export const openFileInNewTab = (filePath: string): void => {
+  window.open(buildAppUrlForFile(filePath), '_blank', 'noopener');
+};
diff --git a/utils/resolvablePromise.ts b/utils/resolvablePromise.ts
new file mode 100644
index 0000000000000000000000000000000000000000..05863476f413b560b43a420ee83a147f6fb8a995
--- /dev/null
+++ b/utils/resolvablePromise.ts
@@ -0,0 +1,17 @@
+/** 外部から resolve / reject できる Promise（Excalidraw の initialData に渡す） */
+export type ResolvablePromise<T> = Promise<T> & {
+  resolve: [T] extends [undefined] ? (value?: T) => void : (value: T) => void;
+  reject: (error: Error) => void;
+};
+
+export const resolvablePromise = <T>(): ResolvablePromise<T> => {
+  let resolve!: any;
+  let reject!: any;
+  const promise = new Promise<T>((_resolve, _reject) => {
+    resolve = _resolve;
+    reject = _reject;
+  });
+  (promise as any).resolve = resolve;
+  (promise as any).reject = reject;
+  return promise as ResolvablePromise<T>;
+};
diff --git a/utils/sceneSummary.test.ts b/utils/sceneSummary.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8720a470ea4ef04575fa0104cc348ae9352b6409
--- /dev/null
+++ b/utils/sceneSummary.test.ts
@@ -0,0 +1,98 @@
+import { describe, expect, it } from 'vitest';
+import type { NonDeletedExcalidrawElement } from '@excalidraw/excalidraw/element/types';
+import { buildElementSummary, pickPersistedAppState } from './sceneSummary';
+
+const rect = (overrides: Record<string, unknown> = {}) => ({
+  id: 'r1',
+  type: 'rectangle',
+  x: 0,
+  y: 0,
+  width: 100,
+  height: 50,
+  angle: 0,
+  strokeColor: '#000',
+  backgroundColor: 'transparent',
+  fillStyle: 'solid',
+  strokeWidth: 1,
+  strokeStyle: 'solid',
+  roughness: 1,
+  opacity: 100,
+  roundness: null,
+  groupIds: [],
+  frameId: null,
+  link: null,
+  locked: false,
+  isDeleted: false,
+  version: 1,
+  ...overrides,
+}) as unknown as NonDeletedExcalidrawElement;
+
+const text = (overrides: Record<string, unknown> = {}) => rect({
+  id: 't1',
+  type: 'text',
+  text: 'hello',
+  fontSize: 20,
+  fontFamily: 1,
+  textAlign: 'left',
+  verticalAlign: 'top',
+  containerId: null,
+  ...overrides,
+});
+
+describe('buildElementSummary', () => {
+  it('バージョンだけが変わっても内容が同じなら同じ要約になる', () => {
+    expect(buildElementSummary([rect()])).toBe(buildElementSummary([rect({ version: 5 })]));
+  });
+
+  it('削除済み要素は要約に含めない（削除は要素の消失として検知される）', () => {
+    expect(buildElementSummary([rect(), text({ isDeleted: true })])).toBe(buildElementSummary([rect()]));
+    expect(buildElementSummary([rect(), text()])).not.toBe(buildElementSummary([rect()]));
+  });
+
+  it.each([
+    ['位置', { x: 10 }],
+    ['サイズ', { width: 120 }],
+    ['線色', { strokeColor: '#f00' }],
+    ['線種', { strokeStyle: 'dashed' }],
+    ['角丸', { roundness: { type: 3 } }],
+    ['リンク', { link: 'https://example.com' }],
+    ['グループ', { groupIds: ['g1'] }],
+    ['ロック', { locked: true }],
+  ])('%sの変更を検知する', (_label, change) => {
+    expect(buildElementSummary([rect(change)])).not.toBe(buildElementSummary([rect()]));
+  });
+
+  it.each([
+    ['文字', { text: 'world' }],
+    ['文字サイズ', { fontSize: 28 }],
+    ['フォント', { fontFamily: 2 }],
+    ['揃え', { textAlign: 'center' }],
+  ])('テキストの%sの変更を検知する', (_label, change) => {
+    expect(buildElementSummary([text(change)])).not.toBe(buildElementSummary([text()]));
+  });
+
+  it('線の頂点・矢じりの変更を検知する', () => {
+    const line = (overrides: Record<string, unknown> = {}) => rect({
+      id: 'l1', type: 'arrow', points: [[0, 0], [50, 50]], startArrowhead: null, endArrowhead: 'arrow', ...overrides,
+    });
+    expect(buildElementSummary([line({ points: [[0, 0], [10, 40], [50, 50]] })])).not.toBe(buildElementSummary([line()]));
+    expect(buildElementSummary([line({ endArrowhead: null })])).not.toBe(buildElementSummary([line()]));
+  });
+
+  it('重なり順の変更を検知する', () => {
+    expect(buildElementSummary([rect(), text()])).not.toBe(buildElementSummary([text(), rect()]));
+  });
+});
+
+describe('pickPersistedAppState', () => {
+  it('選択状態などは保存対象に含めない', () => {
+    const picked = pickPersistedAppState({
+      viewBackgroundColor: '#fff',
+      scrollX: 10,
+      selectedElementIds: { a: true },
+    } as any);
+    expect(picked.viewBackgroundColor).toBe('#fff');
+    expect(picked.scrollX).toBe(10);
+    expect('selectedElementIds' in picked).toBe(false);
+  });
+});
diff --git a/utils/sceneSummary.ts b/utils/sceneSummary.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6eecf8e08832ecc7c1d5a1e199e26333666ca831
--- /dev/null
+++ b/utils/sceneSummary.ts
@@ -0,0 +1,83 @@
+/**
+ * 自動保存の要否判定に使う「シーンの要約」
+ *
+ * 保存済みの要約と現在の要約が異なるときだけ保存する。
+ * 選択状態・スクロール・ズームなど、図面の内容に関係しない変化では保存しない。
+ * 要素の並び順（重なり順）も変更として扱う。
+ */
+import type { NonDeletedExcalidrawElement } from "@excalidraw/excalidraw/element/types";
+import type { AppState } from "@excalidraw/excalidraw/types";
+
+const fixed = (value: number | undefined | null): string => (value ?? 0).toFixed(2);
+
+const describeElement = (element: NonDeletedExcalidrawElement): string => {
+  const el = element as any;
+  const parts: unknown[] = [
+    el.id,
+    el.type,
+    // 位置・サイズ・回転
+    fixed(el.x), fixed(el.y), fixed(el.width), fixed(el.height), fixed(el.angle),
+    // スタイル
+    el.strokeColor, el.backgroundColor, el.fillStyle, el.strokeWidth, el.strokeStyle,
+    el.roughness, el.opacity, el.roundness?.type ?? '',
+    // 関係・属性
+    el.link ?? '', (el.groupIds || []).join(','), el.frameId ?? '', el.locked ? 1 : 0,
+    el.containerId ?? '',
+  ];
+
+  if (el.type === 'text') {
+    parts.push(el.text ?? '', el.fontSize, el.fontFamily, el.textAlign, el.verticalAlign);
+  }
+  if (Array.isArray(el.points)) {
+    parts.push(el.points.map((point: number[]) => `${fixed(point[0])}:${fixed(point[1])}`).join(' '));
+  }
+  if (el.type === 'arrow' || el.type === 'line') {
+    parts.push(el.startArrowhead ?? '', el.endArrowhead ?? '');
+  }
+  if (el.type === 'image') {
+    parts.push(el.fileId ?? '', JSON.stringify(el.scale ?? null), JSON.stringify(el.crop ?? null));
+  }
+
+  return parts.join('|');
+};
+
+/** 削除されていない要素から、内容比較用の要約文字列を作る */
+export const buildElementSummary = (elements: readonly NonDeletedExcalidrawElement[]): string =>
+  elements
+    .filter((element) => !element.isDeleted)
+    .map(describeElement)
+    .join('\n');
+
+/** ファイルに保存する appState の項目（ビュー位置と描画スタイルのみ） */
+export const pickPersistedAppState = (appState: Partial<AppState>): Partial<AppState> => ({
+  viewBackgroundColor: appState.viewBackgroundColor,
+  currentItemFontFamily: appState.currentItemFontFamily,
+  currentItemFontSize: appState.currentItemFontSize,
+  currentItemStrokeColor: appState.currentItemStrokeColor,
+  currentItemBackgroundColor: appState.currentItemBackgroundColor,
+  currentItemFillStyle: appState.currentItemFillStyle,
+  currentItemStrokeWidth: appState.currentItemStrokeWidth,
+  currentItemStrokeStyle: appState.currentItemStrokeStyle,
+  currentItemRoughness: appState.currentItemRoughness,
+  currentItemOpacity: appState.currentItemOpacity,
+  zoom: appState.zoom,
+  scrollX: appState.scrollX,
+  scrollY: appState.scrollY,
+});
+
+/**
+ * 要素のバージョンから計算する軽量なキー。
+ * onChange はスクロールやポインタ移動でも頻繁に呼ばれるため、まずこのキーで
+ * 「要素が変わったか」だけを O(要素数) で判定し、重い要約の作成は保存直前に行う。
+ * 削除済み要素も含めて渡すこと（削除もバージョン更新として検知する）。
+ */
+export const getSceneVersionKey = (
+  elements: readonly { version: number; versionNonce: number }[],
+): string => {
+  let hash = 5381;
+  for (const element of elements) {
+    hash = ((hash << 5) + hash + element.versionNonce) | 0;
+    hash = ((hash << 5) + hash + element.version) | 0;
+  }
+  return `${elements.length}:${hash >>> 0}`;
+};
