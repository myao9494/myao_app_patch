\ No newline at end of file
diff --git a/start_servers.bat b/start_servers.bat
index 4c0e375bc2dc39dcd3e2e18dd2f489562ef8a9b1..dc3913da1ae39f4c6625d51ecafa0df440d7c988 100644
--- a/start_servers.bat
+++ b/start_servers.bat
@@ -11,12 +11,26 @@ REM プロジェクトディレクトリに移動
 cd /d %~dp0
 set "ROOT_DIR=%CD%"
 
-REM 変更の反映忘れを防ぐため、常にフロントエンドをビルドする
-echo フロントエンドのビルドを実行しています...
-call npm run build
-if errorlevel 1 (
-  echo ビルドに失敗しました。
-  exit /b 1
+REM 変更の反映忘れを防ぐため、ビルド可能な環境では常にフロントエンドをビルドする。
+REM npm または node_modules がない環境（ビルドできない社内PCなど）では、
+REM git管理されているビルド済み dist\ をそのまま配信する。
+set "CAN_BUILD="
+where npm > nul 2>&1
+if not errorlevel 1 if exist "%ROOT_DIR%\node_modules\" set "CAN_BUILD=1"
+
+if defined CAN_BUILD (
+  echo フロントエンドのビルドを実行しています...
+  call npm run build
+  if errorlevel 1 (
+    echo ビルドに失敗しました。
+    exit /b 1
+  )
+) else (
+  if not exist "%ROOT_DIR%\dist\index.html" (
+    echo エラー: ビルド環境がなく、ビルド済みの dist\index.html も見つかりません。
+    exit /b 1
+  )
+  echo npm または node_modules が見つからないため、ビルド済みの dist\ を使用します。
 )
 
 REM ビルド成功後にport 3001の既存待受プロセスを終了する
diff --git a/start_servers.sh b/start_servers.sh
index bd20266b3e3928b6015f1506fdc42ef9965cc905..217edde768c9e896612db66c049cafbfffe01a00 100755
--- a/start_servers.sh
+++ b/start_servers.sh
@@ -44,9 +44,18 @@ free_port() {
     fi
 }
 
-# 変更の反映忘れを防ぐため、常にフロントエンドをビルドする
-echo "フロントエンドのビルドを実行しています..."
-npm run build
+# 変更の反映忘れを防ぐため、ビルド可能な環境では常にフロントエンドをビルドする。
+# npm または node_modules がない環境（ビルドできない社内PCなど）では、
+# git管理されているビルド済み dist/ をそのまま配信する。
+if command -v npm >/dev/null 2>&1 && [ -d node_modules ]; then
+    echo "フロントエンドのビルドを実行しています..."
+    npm run build
+elif [ -f dist/index.html ]; then
+    echo "npm または node_modules が見つからないため、ビルド済みの dist/ を使用します。"
+else
+    echo "エラー: ビルド環境がなく、ビルド済みの dist/index.html も見つかりません。"
+    exit 1
+fi
 
 # ビルド成功後に旧サーバーを停止し、停止時間を最小限にする
 free_port 3001
