-        let { y1, y2 } = posPts;
-
-        rs.segpts = [
-          x, y1,
-          x, y2
-        ];
-      } else if( lShapeInsideTgt ){ // vertical Z-shape (distance not respected)
-        let y = (posPts.y1 + posPts.y2)/2;
-        let { x1, x2 } = posPts;
-
-        rs.segpts = [
-          x1, y,
-          x2, y
-        ];
-      } else { // L-shape fallback (turn distance not respected, but works well with tree siblings)
-        rs.segpts = [
-          posPts.x1, posPts.y2
-        ];
-      }
-
-    } else { // horizontal fallbacks
