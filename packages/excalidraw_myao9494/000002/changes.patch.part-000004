-  var halfW = width / 2;
-  var halfH = height / 2;
-
-  if( context.beginPath ){ context.beginPath(); }
-
-  context.moveTo( x + halfW * points[0], y + halfH * points[1] );
-
-  for( var i = 1; i < points.length / 2; i++ ){
-    context.lineTo( x + halfW * points[ i * 2], y + halfH * points[ i * 2 + 1] );
-  }
-
-  context.closePath();
-};
