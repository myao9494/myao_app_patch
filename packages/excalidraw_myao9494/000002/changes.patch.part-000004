-
-  buffer.bufferSubData = () => {
-    gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
-    gl.bufferSubData(gl.ARRAY_BUFFER, 0, matrixData);
-  };
-
-  return buffer;
-}
