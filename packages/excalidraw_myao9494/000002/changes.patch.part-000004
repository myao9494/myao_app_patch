-
-  startFrame(panZoomMatrix, renderTarget = RENDER_TARGET.SCREEN) {
-    this.panZoomMatrix = panZoomMatrix;
-    this.renderTarget = renderTarget;
-
-    this.batchDebugInfo = [];
-    this.wrappedCount = 0;
-    this.simpleCount = 0;
