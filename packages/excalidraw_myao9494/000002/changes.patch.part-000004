-  const VERTICAL = 'vertical';
-  const HORIZONTAL = 'horizontal';
-  const LEFTWARD = 'leftward';
-  const RIGHTWARD = 'rightward';
-  const DOWNWARD = 'downward';
-  const UPWARD = 'upward';
-  const AUTO = 'auto';
