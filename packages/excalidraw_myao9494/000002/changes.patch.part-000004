-    iterations++;
-  }
-
-  // Assign nodes to clusters with highest probability.
-  clusters = assign( nodes, U, opts, cy );
-
-  return {
-    clusters: clusters,
-    degreeOfMembership: U
-  };
-};
-
-export default {
-  kMeans, kMedoids, fuzzyCMeans, fcm: fuzzyCMeans
-};
