-{
-  "name": "cose-base",
-  "description": "Core module for compound spring embedder based layout styles",
-  "main": "cose-base.js",
-  "dependencies": {
-    "layout-base": "^1.0.0"
-  },
-  "repository": {
-    "type": "git",
-    "url": "https://github.com/iVis-at-Bilkent/cose-base.git"
-  },
-  "ignore": [
-    "**/.*",
-    "node_modules",
-    "bower_components",
-    "test",
-    "tests"
-  ],
-  "keywords": [
-    "layout"
-  ],
-  "license": "MIT"
-}
