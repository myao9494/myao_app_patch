-            CollectionTraversing,
-            CollectionLayout,
-            CollectionSelection,
-            CollectionStyle,
-            CollectionAnimation,
-            CollectionComparision,
-            CollectionIteration<TIn, TOut>,
-            CollectionBuildingFiltering<TIn, TOut>,
-            CollectionAlgorithms
