-    return json;
-  }
-};
-
-elesfn.jsons = function(){
-  let jsons = [];
-
-  for( let i = 0; i < this.length; i++ ){
-    let ele = this[ i ];
-    let json = ele.json();
-
-    jsons.push( json );
-  }
-
-  return jsons;
-};
-
-elesfn.clone = function(){
-  let cy = this.cy();
-  let elesArr = [];
-
-  for( let i = 0; i < this.length; i++ ){
-    let ele = this[ i ];
-    let json = ele.json();
-    let clone = new Element( cy, json, false ); // NB no restore
-
-    elesArr.push( clone );
-  }
-
-  return new Collection( cy, elesArr );
-};
-elesfn.copy = elesfn.clone;
