-    "bin/*.js",
-    "dist/**/*.js",
-    "src/**/*.js"
-  ],
-  "module": "src/index.js",
-  "main": "src/index.js",
-  "jsdelivr": "dist/d3-dsv.min.js",
-  "unpkg": "dist/d3-dsv.min.js",
-  "exports": {
-    "umd": "./dist/d3-dsv.min.js",
-    "default": "./src/index.js"
-  },
-  "sideEffects": false,
-  "dependencies": {
-    "commander": "7",
-    "iconv-lite": "0.6",
-    "rw": "1"
-  },
-  "devDependencies": {
-    "csv-spectrum": "1",
-    "eslint": "7",
-    "mocha": "8",
-    "rollup": "2",
-    "rollup-plugin-terser": "7"
-  },
-  "scripts": {
