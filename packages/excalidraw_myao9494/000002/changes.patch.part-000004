-function clearWebgl(r) {
-  const gl = r.data.contexts[r.WEBGL];
-  gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
-}
-
-function clearCanvas(r) {
