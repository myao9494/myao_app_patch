-  }
-
-  return this; // chaining
-};
-
-//Get the top most ones of a list of nodes
-_CoSELayout.prototype.getTopMostNodes = function(nodes) {
-  var nodesMap = {};
-  for (var i = 0; i < nodes.length; i++) {
-      nodesMap[nodes[i].id()] = true;
