-// Canvas Upscaling Plugin
-class MiscUpscaler {
-    constructor(options = {}) {
-        // Plugin Settings
-        this.options = Object.assign({
-            useEdgeDetection: true,  // Edge Detection
-            scaleFactor: 2.0,        // Upscaling Value
-        }, options);
