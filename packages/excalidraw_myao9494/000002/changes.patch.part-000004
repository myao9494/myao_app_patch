-
-      for( let e = 0; e < numEdges; e++ ){
-        let edge = edges[e];
-        let src = edge.source();
-        let tgt = edge.target();
-        let weight = weightFn(edge);
-        let srcInfo = getInfo(src);
-        let tgtInfo = getInfo(tgt);
