-          changedNow = true;
-        }
-
-        if( !changedEle && changedNow ){
-          changed.push( ele );
-          changedEle = true;
-        }
-
-      } // for j classes
-    } // for i eles
-
-    // trigger update style on those eles that had class changes
-    if( changed.length > 0 ){
-      this.spawn( changed )
-        .updateStyle()
-        .emit( 'class' )
-      ;
-    }
-
-    return self;
-  },
-
-  removeClass: function( classes ){
-    return this.toggleClass( classes, false );
-  },
-
-  flashClass: function( classes, duration ){
-    let self = this;
-
-    if( duration == null ){
-      duration = 250;
-    } else if( duration === 0 ){
