-      for( let i = 0; i < arr.length; i++ ){
-        this.add( arr[i] );
-      }
-    }
-  }
-
-  instanceString(){
-    return 'set';
-  }
-
-  add( val ){
-    let o = this._obj;
-
-    if( o[ val ] !== 1 ){
-      o[ val ] = 1;
-      this.size++;
-    }
-  }
-
-  delete( val ){
-    let o = this._obj;
-
-    if( o[ val ] === 1 ){
-      o[ val ] = 0;
-      this.size--;
-    }
-  }
-
-  clear(){
-    this._obj = Object.create(null);
-  }
-
-  has( val ){
