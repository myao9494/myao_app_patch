-  "license": "ISC",
-  "author": {
-    "name": "Mike Bostock",
-    "url": "http://bost.ocks.org/mike"
-  },
-  "type": "module",
-  "files": [
-    "dist/**/*.js",
-    "src/**/*.js"
-  ],
-  "module": "src/index.js",
-  "main": "src/index.js",
-  "jsdelivr": "dist/d3-fetch.min.js",
-  "unpkg": "dist/d3-fetch.min.js",
-  "exports": {
-    "umd": "./dist/d3-fetch.min.js",
-    "default": "./src/index.js"
-  },
-  "sideEffects": false,
-  "dependencies": {
-    "d3-dsv": "1 - 3"
-  },
-  "devDependencies": {
-    "eslint": "7",
-    "mocha": "8",
-    "rollup": "2",
-    "rollup-plugin-terser": "7"
-  },
-  "scripts": {
