-        }
-      }
-    }
-
-    if( obj.position ){
-      ele.position( obj.position );
-    }
-
-    // ignore group -- immutable
-
-    let checkSwitch = function( k, trueFnName, falseFnName ){
-      let obj_k = obj[ k ];
-
-      if( obj_k != null && obj_k !== p[ k ] ){
