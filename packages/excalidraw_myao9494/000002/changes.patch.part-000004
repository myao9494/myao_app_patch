-            selector: '#ab1',
-            style: {
-              'segment-weights': [0.5],
-              'segment-distances': [50]
-            }
-          },
-          {
-            selector: '#ab2',
-            style: {
-              'segment-weights': [0.25 , 0.5, 0.75],
-              'segment-distances': [50, 50, 50]
-            }
-          }
-        ]).update();
-
-        cy.add([
-          {
-            data: { id: 'a' }
-          },
-          {
-            data: { id: 'b' }
-          },
-          {
-            data: { id: 'ab1', source: 'a', target: 'b' }
-          },
-          {
-            data: { id: 'ab2', source: 'a', target: 'b' }
-          },
-        ]);
