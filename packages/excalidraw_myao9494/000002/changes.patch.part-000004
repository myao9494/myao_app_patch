-      g = Math.round( 255 * hue2rgb( p, q, h ) );
-      b = Math.round( 255 * hue2rgb( p, q, h - 1 / 3 ) );
-    }
-
-    ret = [ r, g, b, a ];
-  }
-
-  return ret;
-};
-
-// get [r, g, b, a] from rgb(0, 0, 0) or rgba(0, 0, 0, 0)
-export const rgb2tuple = rgb => {
