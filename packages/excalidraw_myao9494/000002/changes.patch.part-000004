-        subtract: CollectionBuildingDifferenceFunc;
-        "\\": CollectionBuildingDifferenceFunc;
-        not: CollectionBuildingDifferenceFunc;
-        "!": CollectionBuildingDifferenceFunc;
-        relativeComplement: CollectionBuildingDifferenceFunc;
-        "-": CollectionBuildingDifferenceFunc;
-
-        /**
