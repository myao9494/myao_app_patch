43\u044E\u0447\u0438 SHIFT \u043F\u0456\u0434 \u0447\u0430\u0441 \u0437\u043C\u0456\u043D\u0438 \u0440\u043E\u0437\u043C\u0456\u0440\u0443,
-\u0443\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435 ALT \u0434\u043B\u044F \u0437\u043C\u0456\u043D\u0435\u043D\u043D\u044F \u0440\u043E\u0437\u043C\u0456\u0440\u0443 \u0432\u0456\u0434 \u0446\u0435\u043D\u0442\u0440\u0443`,resizeImage:"\u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0437\u043C\u0456\u043D\u044E\u0432\u0430\u0442\u0438 \u0440\u043E\u0437\u043C\u0456\u0440\u0438 \u0443\u0442\u0440\u0438\u043C\u0443\u044E\u0447\u0438 \u043A\u043B\u0430\u0432\u0456\u0448\u0443 SHIFT, \u0432\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435 \u043A\u043B\u0430\u0432\u0456\u0448\u0443 ALT \u0449\u043E\u0431 \u0437\u043C\u0456\u043D\u044E\u0432\u0430\u0442\u0438 \u0440\u043E\u0437\u043C\u0456\u0440 \u0432\u0456\u0434\u043D\u043E\u0441\u043D\u043E \u0446\u0435\u043D\u0442\u0440\u0443",rotate:"\u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u043E\u0431\u043C\u0435\u0436\u0438\u0442\u0438 \u043A\u0443\u0442\u0438, \u0443\u0442\u0440\u0438\u043C\u0443\u044E\u0447\u0438 SHIFT \u043F\u0456\u0434 \u0447\u0430\u0441 \u043E\u0431\u0435\u0440\u0442\u0430\u043D\u043D\u044F",lineEditor_info:"\u0423\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435 CtrlOrCmd \u0456 \u0434\u0432\u0456\u0447\u0456 \u043A\u043B\u0430\u0446\u043D\u0456\u0442\u044C \u0430\u0431\u043E \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C CtrlOrCmd + Enter, \u0449\u043E\u0431 \u0440\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u0442\u0438 \u0446\u044F\u0442\u043A\u0438",lineEditor_pointSelected:"\u041D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C Delete \u0434\u043B\u044F \u0432\u0438\u0434\u0430\u043B\u0435\u043D\u043D\u044F \u0442\u043E\u0447\u043A\u0443 (\u0442\u043E\u0447\u043E\u043A), \u0430\u0431\u043E Ctrl/Cmd+D \u0434\u043B\u044F \u0434\u0443\u0431\u043B\u044E\u0432\u0430\u043D\u043D\u044F, \u043F\u0435\u0440\u0435\u0442\u0430\u0441\u043A\u0443\u0432\u0430\u043D\u043D\u044F \u043F\u0440\u0430\u0446\u044E\u0454 \u044F\u043A \u0437\u0432\u0438\u0447\u043D\u043E",lineEditor_nothingSelected:"\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044C \u0442\u043E\u0447\u043A\u0443 \u0434\u043B\u044F \u0440\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u043D\u043D\u044F (\u0432\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435 \u043A\u043B\u0430\u0432\u0456\u0448\u0443 SHIFT \u0434\u043B\u044F \u0432\u0438\u0431\u043E\u0440\u0443 \u043A\u0456\u043B\u044C\u043A\u043E\u0445 \u0442\u043E\u0447\u043E\u043A), \u0430\u0431\u043E \u043A\u043B\u0430\u0432\u0456\u0448\u0443 Alt \u0434\u043B\u044F \u0434\u043E\u0434\u0430\u0432\u0430\u043D\u043D\u044F \u043D\u043E\u0432\u0438\u0445 \u0442\u043E\u0447\u043E\u043A",placeImage:"\u041A\u043B\u0430\u0446\u043D\u0456\u0442\u044C, \u0449\u043E\u0431 \u0440\u043E\u0437\u043C\u0456\u0441\u0442\u0438\u0442\u0438 \u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u043D\u044F, \u0430\u0431\u043E \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C \u0442\u0430 \u043F\u043E\u0442\u044F\u0433\u043D\u0456\u0442\u044C \u0449\u043E\u0431 \u0437\u043C\u0456\u043D\u0438\u0442\u0438 \u0439\u043E\u0433\u043E \u0440\u043E\u0437\u043C\u0456\u0440",publishLibrary:"\u041E\u043F\u0443\u0431\u043B\u0456\u043A\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u043E\u044E \u0432\u043B\u0430\u0441\u043D\u0443 \u0431\u0456\u0431\u043B\u0456\u043E\u0442\u0435\u043A\u0443",bindTextToElement:"\u041D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C Enter, \u0449\u043E\u0431 \u0434\u043E\u0434\u0430\u0442\u0438 \u0442\u0435\u043A\u0441\u0442",deepBoxSelect:"\u0412\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435 Ctrl/Cmd \u0434\u043B\u044F \u0433\u043B\u0438\u0431\u043E\u043A\u043E\u0433\u043E \u0432\u0438\u0434\u0456\u043B\u0435\u043D\u043D\u044F \u0442\u0430 \u0449\u043E\u0431 \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u0438\u0442\u0438 \u043F\u0435\u0440\u0435\u0442\u044F\u0433\u0443\u0432\u0430\u043D\u043D\u044F",eraserRevert:"\u0412\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435 \u043A\u043B\u0430\u0432\u0456\u0448\u0443 Alt, \u0449\u043E\u0431 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438 \u0435\u043B\u0435\u043C\u0435\u043D\u0442\u0438 \u043F\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u0456 \u0434\u043B\u044F \u0432\u0438\u0434\u0430\u043B\u0435\u043D\u043D\u044F",firefox_clipboard_write:'\u0426\u044E \u0444\u0443\u043D\u043A\u0446\u0456\u044E \u043C\u043E\u0436\u043D\u0430 \u0432\u0432\u0456\u043C\u043A\u043D\u0443\u0442\u0438, \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0432\u0448\u0438 \u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F "true" \u0434\u043B\u044F \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F "dom.events.asyncClipboard.clipboardItem". \u041F\u0435\u0440\u0435\u0439\u0434\u0456\u0442\u044C \u043D\u0430 \u0441\u0442\u043E\u0440\u0456\u043D\u043A\u0443 \xABabout:config\xBB, \u0449\u043E\u0431 \u0437\u043C\u0456\u043D\u0438\u0442\u0438 \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0430 \u0443 Firefox.',disableSnapping:""},c={cannotShowPreview:"\u041D\u0435 \u0432\u0434\u0430\u0454\u0442\u044C\u0441\u044F \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0438 \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u043D\u0456\u0439 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u0434",canvasTooBig:"\u041F\u043E\u043B\u043E\u0442\u043D\u043E \u043C\u043E\u0436\u0435 \u0431\u0443\u0442\u0438 \u0437\u0430\u0432\u0435\u043B\u0438\u043A\u0438\u043C.",canvasTooBigTip:"\u041F\u043E\u0440\u0430\u0434\u0430: \u0441\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u043F\u0456\u0434\u0441\u0443\u043D\u0443\u0442\u0438 \u043D\u0430\u0439\u0432\u0456\u0434\u0434\u0430\u043B\u0435\u043D\u0456\u0448\u0456 \u0435\u043B\u0435\u043C\u0435\u043D\u0442\u0438 \u0431\u043B\u0438\u0436\u0447\u0435 \u043E\u0434\u0438\u043D \u0434\u043E \u043E\u0434\u043D\u043E\u0433\u043E."},b={headingMain:"\u0421\u0442\u0430\u043B\u0430\u0441\u044F \u043F\u043E\u043C\u0438\u043B\u043A\u0430. \u0421\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 <button>\u043F\u0435\u0440\u0435\u0437\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0438\u0442\u0438 \u0441\u0442\u043E\u0440\u0456\u043D\u043A\u0443.</button>",clearCanvasMessage:"\u042F\u043A\u0449\u043E \u043F\u0435\u0440\u0435\u0437\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F \u043D\u0435 \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435, \u0441\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 <button>\u043E\u0447\u0438\u0441\u0442\u0438\u0442\u0438 \u043F\u043E\u043B\u043E\u0442\u043D\u043E.</button>",clearCanvasCaveat:" \u0426\u0435 \u043F\u0440\u0438\u0437\u0432\u0435\u0434\u0435 \u0434\u043E \u0432\u0442\u0440\u0430\u0442\u0438 \u0440\u043E\u0431\u043E\u0442\u0438 ",trackedToSentry:"\u041F\u043E\u043C\u0438\u043B\u043A\u0430 \u0437 \u0456\u0434\u0435\u043D\u0442\u0438\u0444\u0456\u043A\u0430\u0442\u043E\u0440\u043E\u043C {{eventId}} \u0431\u0443\u043B\u043E \u0432\u0456\u0434\u0441\u043B\u0456\u0434\u043A\u043E\u0432\u0430\u043D\u043E \u0432 \u043D\u0430\u0448\u0456\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u0456.",openIssueMessage:"\u041C\u0438 \u0431\u0443\u043B\u0438 \u0434\u0443\u0436\u0435 \u043E\u0431\u0435\u0440\u0435\u0436\u043D\u0456, \u0449\u043E\u0431 \u043D\u0435 \u0432\u043A\u043B\u044E\u0447\u0430\u0442\u0438 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044E \u043F\u0440\u043E \u0432\u0430\u0448\u0456 \u0441\u0446\u0435\u043D\u0438 \u0432 \u0442\u0435\u043A\u0441\u0442 \u043F\u043E\u043C\u0438\u043B\u043A\u0438. \u042F\u043A\u0449\u043E \u0432\u0430\u0448\u0430 \u0441\u0446\u0435\u043D\u0430 \u043D\u0435 \u0431\u0443\u043B\u0430 \u043F\u0440\u0438\u0432\u0430\u0442\u043D\u0430, \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0440\u043E\u0437\u0433\u043B\u044F\u043D\u044C\u0442\u0435 \u043C\u043E\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0435\u043D\u043D\u044F \u043D\u0430 \u043D\u0430\u0448\u043E\u043C\u0443 <button>\u0442\u0440\u0435\u043A\u0435\u0440 \u043F\u043E\u043C\u0438\u043B\u043E\u043A.</button> \u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0434\u043E\u0434\u0430\u0439\u0442\u0435 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044E \u043D\u0438\u0436\u0447\u0435, \u0441\u043A\u043E\u043F\u0456\u044E\u044E\u0447\u0438 \u0456 \u0432\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0447\u0438 \u0443 GitHub issue.",sceneContent:"\u0412\u043C\u0456\u0441\u0442 \u0441\u0446\u0435\u043D\u0438:"},m={desc_intro:"\u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0437\u0430\u043F\u0440\u043E\u0441\u0438\u0442\u0438 \u043B\u044E\u0434\u0435\u0439 \u0434\u043B\u044F \u0441\u043F\u0456\u043B\u044C\u043D\u043E\u0457 \u0440\u043E\u0431\u043E\u0442\u0438.",desc_privacy:"\u041D\u0435 \u0445\u0432\u0438\u043B\u044E\u0439\u0442\u0435\u0441\u044F, \u0441\u0435\u0441\u0456\u044F \u0437\u0430\u0445\u0438\u0449\u0435\u043D\u0430 \u043D\u0430\u0441\u043A\u0440\u0456\u0437\u043D\u0438\u043C \u0448\u0438\u0444\u0440\u0443\u0432\u0430\u043D\u043D\u044F\u043C, \u0442\u043E\u043C\u0443 \u0432\u0430\u0448\u0435 \u043A\u0440\u0435\u0441\u043B\u0435\u043D\u043D\u044F \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u044C\u0441\u044F \u043F\u0440\u0438\u0432\u0430\u0442\u043D\u0438\u043C. \u041D\u0430\u0432\u0456\u0442\u044C \u043D\u0430\u0448 \u0441\u0435\u0440\u0432\u0435\u0440 \u043D\u0435 \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u044C \u0432\u0430\u0448\u0443 \u0440\u043E\u0431\u043E\u0442\u0443.",button_startSession:"\u041F\u043E\u0447\u0430\u0442\u0438 \u0441\u0435\u0441\u0456\u044E",button_stopSession:"\u0417\u0430\u043A\u0440\u0438\u0442\u0438 \u0441\u0435\u0441\u0456\u044E",desc_inProgressIntro:"\u0421\u0435\u0441\u0456\u044F \u0441\u043F\u0456\u043B\u044C\u043D\u043E\u0457 \u0440\u043E\u0431\u043E\u0442\u0438 \u043D\u0430\u0434 \u043A\u0440\u0435\u0441\u043B\u0435\u043D\u043D\u044F\u043C \u0442\u0440\u0438\u0432\u0430\u0454.",desc_shareLink:"\u041F\u043E\u0434\u0456\u043B\u0456\u0442\u044C\u0441\u044F \u0446\u0438\u043C \u043F\u043E\u0441\u0438\