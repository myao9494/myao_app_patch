-
-  /** E.g. #foo <-> #bar */
-  UNDIRECTED_EDGE: 10,
-
-  /** E.g. #foo -> #bar */
-  DIRECTED_EDGE: 11,
-
-  /** E.g. $#foo -> #bar */
-  NODE_SOURCE: 12,
-
-  /** E.g. #foo -> $#bar */
-  NODE_TARGET: 13,
-
-  /** E.g. $#foo <-> #bar */
-  NODE_NEIGHBOR: 14,
-
-  /** E.g. #foo > #bar */
-  CHILD: 15,
-
-  /** E.g. #foo #bar */
