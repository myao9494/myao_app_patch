-
-  /** E.g. [foo] */
-  DATA_EXIST: 4,
-
-  /** E.g. [?foo] */
-  DATA_BOOL: 5,
-
-  /** E.g. [[degree > 2]] */
-  META_COMPARE: 6,
-
-  /** E.g. :selected */
