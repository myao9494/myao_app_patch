-    }
-    
-    resize() {
-        if (this.inputCanvas && this.outputCanvas) {
-            this.outputCanvas.width = this.inputCanvas.width * this.options.scaleFactor;
-            this.outputCanvas.height = this.inputCanvas.height * this.options.scaleFactor;
