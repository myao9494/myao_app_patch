-        const isInt = /^\+?\d+$/.test(innerTxt);
-        if (isInt) {
-            return `ﬂ°°${innerTxt}¶ß`;
-        }
-        return `ﬂ°${innerTxt}¶ß`;
-    });
-    return txt;
-};
-export const decodeEntities = function (text) {
