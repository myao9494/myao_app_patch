-    } );
-
-  } else {
-
-    // width/height * splits^2 = cells where splits is number of times to split width
-    let cells = nodes.size();
-    let splits = Math.sqrt( cells * bb.h / bb.w );
-    let rows = Math.round( splits );
-    let cols = Math.round( bb.w / bb.h * splits );
