u062F\u06CC\u0645\u06D5\u0646",zoomToFit:"\u0632\u0648\u0648\u0645 \u0628\u06A9\u06D5 \u0628\u06C6 \u0626\u06D5\u0648\u06D5\u06CC \u0644\u06D5\u06AF\u06D5\u06B5 \u0647\u06D5\u0645\u0648\u0648 \u062A\u0648\u062E\u0645\u06D5\u06A9\u0627\u0646\u062F\u0627 \u0628\u06AF\u0648\u0646\u062C\u06CE\u062A",zoomToSelection:"\u0632\u0648\u0648\u0645 \u0628\u06A9\u06D5 \u0628\u06C6 \u062F\u06D5\u0633\u062A\u0646\u06CC\u0634\u0627\u0646\u06A9\u0631\u0627\u0648\u06D5\u06A9\u0627\u0646",toggleElementLock:"\u0642\u0641\u06B5/\u06A9\u0631\u062F\u0646\u06D5\u0648\u06D5\u06CC \u062F\u06D5\u0633\u062A\u0646\u06CC\u0634\u0627\u0646\u06A9\u0631\u0627\u0648\u06D5\u06A9\u0627\u0646",movePageUpDown:"\u0644\u0627\u067E\u06D5\u0695\u06D5\u06A9\u06D5 \u0628\u062C\u0648\u06B5\u06CE\u0646\u06D5 \u0628\u06C6 \u0633\u06D5\u0631\u06D5\u0648\u06D5/\u062E\u0648\u0627\u0631\u06D5\u0648\u06D5",movePageLeftRight:"\u0644\u0627\u067E\u06D5\u0695\u06D5\u06A9\u06D5 \u0628\u062C\u0648\u06B5\u06CE\u0646\u06D5 \u0628\u06C6 \u0686\u06D5\u067E/\u0695\u0627\u0633\u062A"},h={title:"\u062A\u0627\u0628\u0644\u06C6\u06A9\u06D5 \u062E\u0627\u0648\u06CE\u0646 \u0628\u06A9\u06D5\u0631\u06D5\u0648\u06D5"},y={title:"\u067E\u06CE\u0634\u06A9\u06D5\u0634\u06A9\u0631\u062F\u0646\u06CC \u06A9\u062A\u06CE\u0628\u062E\u0627\u0646\u06D5",itemName:"\u0646\u0627\u0648\u06CC \u0628\u0695\u06AF\u06D5",authorName:"\u0646\u0627\u0648\u06CC \u0646\u0648\u0633\u06D5\u0631",githubUsername:"\u0646\u0627\u0648\u06CC \u0628\u06D5\u06A9\u0627\u0631\u0647\u06CE\u0646\u06D5\u0631\u06CC Github",twitterUsername:"\u0646\u0627\u0648\u06CC \u0628\u06D5\u06A9\u0627\u0631\u0647\u06CE\u0646\u06D5\u0631\u06CC Twitter",libraryName:"\u0646\u0627\u0648\u06CC \u06A9\u062A\u06CE\u0628\u062E\u0627\u0646\u06D5",libraryDesc:"\u0648\u06D5\u0633\u0641\u06CC \u06A9\u062A\u06CE\u0628\u062E\u0627\u0646\u06D5",website:"\u0645\u0627\u06B5\u067E\u06D5\u0695",placeholder:{authorName:"\u0646\u0627\u0648\u06D5\u06A9\u0627\u062A \u06CC\u0627\u062E\u0648\u062F \u0646\u0627\u