-    }
-
-    cy.endBatch();
-
-    return this;
-
-  } else if( obj === undefined ){ // get
-
-    let json = {
-      data: util.copy( p.data ),
-      position: util.copy( p.position ),
-      group: p.group,
-      removed: p.removed,
-      selected: p.selected,
-      selectable: p.selectable,
-      locked: p.locked,
-      grabbable: p.grabbable,
-      pannable: p.pannable,
-      classes: null
-    };
-
-    json.classes = '';
-
-    let i = 0;
-    p.classes.forEach( cls => json.classes += ( i++ === 0 ? cls : ' ' + cls ) );
