-        .replace(/#(\d+);/g, "&#$1;")
-        .replace(/#([a-z]+);/g, "&$1;");
-    // Render the decimal code as html character, eg &#9829; => ♥
-    const element = document.createElement("textarea");
-    element.innerHTML = inputWithDecimalCode;
-    return element.value;
-};
