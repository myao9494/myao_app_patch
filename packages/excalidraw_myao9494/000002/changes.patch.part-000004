BC8\u0BAA\u0BCD \u0BAA\u0BC1\u0B95\u0BB4\u0BCD\u0BB5\u0BA4\u0BC6\u0BA9\u0BCD\u0BB1\u0BB1\u0BBF\u0BB5\u0BCB\u0BAE\u0BCD",website:"\u0B89\u0BAE\u0B95\u0BCD\u0B95\u0BC1\u0BB0\u0BBF\u0BAF \u0BB5\u0BB2\u0BC8\u0BA4\u0BCD\u0BA4\u0BB3\u0BA4\u0BCD\u0BA4\u0BBF\u0BB1\u0BCD\u0B95\u0BC1 \u0B85 \u0BB5\u0BC7\u0BB1\u0BC6\u0B99\u0BCD\u0B95\u0BBF\u0BB1\u0BCD\u0B95\u0BC1\u0BAE\u0BBE\u0BA9 \u0BA4\u0BCA\u0B9F\u0BC1\u0BAA\u0BCD\u0BAA\u0BC1 (\u0BB5\u0BBF\u0BB0\u0BC1\u0BAE\u0BCD\u0BAA\u0BBF\u0BA9\u0BBE\u0BB2\u0BCD)"},errors:{required:"\u0BA4\u0BC7\u0BB5\u0BC8\u0BAA\u0BCD\u0B9F\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1",website:"\u0B9A\u0BC6\u0BB2\u0BCD\u0BB2\u0BA4\u0BCD\u0BA4\u0B95\u0BCD\u0B95 \u0B89\u0BB0\u0BB2\u0BBF\u0BAF\u0BC8 \u0B89\u0BB3\u0BCD\u0BB3\u0BBF\u0B9F\u0BC1"},noteDescription:"\u0B89\u0BAE\u0BCD \u0BA8\u0BC2\u0BB2\u0B95\u0BA4\u0BCD\u0BA4\u0BC8\u0B9A\u0BCD \u0B9A\u0BAE\u0BB0\u0BCD\u0BAA\u0BCD\u0BAA\u0BBF \u0B89\u0BB3\u0BCD\u0BB3\u0B9F\u0B95\u0BCD\u0B95\u0BC1\u0BB5\u0BA4\u0BB1\u0BCD\u0B95\u0BC1 <link>\u0BAA\u0BCA\u0BA4\u0BC1 \u0BA8\u0BC2\u0BB2\u0B95 \u0B95\u0BB3\u0B9E\u0BCD\u0B9A\u0BBF\u0BAF\u0BA4\u0BCD\u0BA4\u0BBF\u0BB2\u0BCD</link>\u0BAA\u0BBF\u0BB1 \u0BAE\u0B95\u0BCD\u0B95\u0BB3\u0BB5\u0BB0\u0BCD\u0B95\u0BB3\u0BBF\u0BA9\u0BCD \u0B9A\u0BBF\u0BA4\u0BCD\u0BA4\u0BBF\u0BB0\u0B99\u0BCD\u0B95\u0BB3\u0BBF\u0BB2\u0BCD \u0BAA\u0BAF\u0BA9\u0BCD\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4.",noteGuidelines:"\u0BA8\u0BC2\u0BB2\u0B95\u0BAE\u0BCD \u0BAE\u0BC1\u0BA4\u0BB2\u0BBF\u0BB2\u0BCD \u0B95\u0BC8\u0BAE\u0BC1\u0BB1\u0BC8\u0BAF\u0BBE\u0B95 \u0B92\u0BAA\u0BCD\u0BAA\u0BC1\u0B95\u0BCD\u0B95\u0BCA\u0BB3\u0BCD\u0BB3\u0BAA\u0BCD\u0BAA\u0B9F\u0BB5\u0BC7\u0BA3\u0BCD\u0B9F\u0BC1\u0BAE\u0BCD. \u0BB5\u0BBE\u0B9A\u0BBF\u0B95\u0BCD\u0B95\u0BB5\u0BC1\u0BAE\u0BCD <link>\u0BB5\u0BB4\u0BBF\u0B95\u0BBE\u0B9F\u0BCD\u0B9F\u0BC1\u0BA4\u0BB2\u0BCD\u0B95\u0BB3\u0BC8\u0B9A\u0BCD</link> \u0B9A\u0BAE\u0BB0\u0BCD\u0BAA\u0BCD\u0BAA\u0BBF\u0B95\u0BCD\u0B95\u0BC1\u0BAE\u0BCD \u0BAE\u0BC1\u0BA9\u0BCD\u0BAA\u0BC1. \u0B95\u0BCB\u0BB0