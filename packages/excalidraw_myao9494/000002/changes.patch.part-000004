-  _getCurveSegmentPoints(controlPoints, segments) {
-    if(controlPoints.length == 4) {
-      return controlPoints; // straight line
-    }
-    const curvePoints = Array((segments + 1) * 2);
-    for(let i = 0; i <= segments; i++) {
