-    const atlases = collection.atlases;
-    for(let i = 0; i < atlases.length; i++) {
-      const atlas = atlases[i];
-      const canvas = atlas.canvas;
-      if(canvas) {
-        const w = canvas.width;
-        const h = canvas.height;
-        const x = w * i;
-        const y = canvas.height * row;
