-        values[x0 + 1 + y0 * n] += xt * (1 - yt) * wi;
-        values[x0 + 1 + (y0 + 1) * n] += xt * yt * wi;
-        values[x0 + (y0 + 1) * n] += (1 - xt) * yt * wi;
-      }
-    }
