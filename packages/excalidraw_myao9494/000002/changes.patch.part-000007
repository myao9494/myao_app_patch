-  let uy = 3 * p2[1] - 2 * p1[1] - p4[1]; uy *= uy;
-  let vx = 3 * p3[0] - 2 * p4[0] - p1[0]; vx *= vx;
-  let vy = 3 * p3[1] - 2 * p4[1] - p1[1]; vy *= vy;
-
-  if (ux < vx) {
-    ux = vx;
-  }
-
-  if (uy < vy) {
-    uy = vy;
-  }
-
-  return ux + uy;
-}
-
