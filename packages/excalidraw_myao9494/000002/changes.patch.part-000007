-     * ```
-     * // string is `Arial`.
-     * string.getValue(); // "Arial"
-     *
-     * // string is `"Helvetica Neue"`.
-     * string.getValue(); // "Helvetica Neue"
-     *
-     * // string is `\1F46D`.
-     * string.getValue(); // "\\1F46D"
-     *
-     * // string is `"\1F46D"`.
-     * string.getValue(); // "👭"
-     * ```
-     */
-    getValue(): string;
-
-    /**
-     * Destructively modifies this string by setting its numeric value to
