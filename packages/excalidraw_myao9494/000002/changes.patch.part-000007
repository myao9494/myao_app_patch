-                    this.argument.hasEffectsOnInteractionAtPath(UNKNOWN_PATH, NODE_INTERACTION_UNKNOWN_ACCESS, context))));
-    }
-    includeNode(context) {
-        this.included = true;
-        if (!this.deoptimized)
-            this.applyDeoptimizations();
