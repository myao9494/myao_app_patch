@@ -287,6 +289,17 @@ def _resolve_existing_link_target(file_path: Path, link: str) -> Path:
     return target
 
 
+def _original_name_hint(file_data: Any) -> Optional[str]:
+    """元のファイル名が分かれば返す（変換除外パターンの判定用）。"""
+    if not isinstance(file_data, dict):
+        return None
+    for key in ("name", "fileName", "sourcePath"):
+        value = file_data.get(key)
+        if isinstance(value, str) and value:
+            return value
+    return None
+
+
 def export_embedded_images(
     file_path: Path,
     files: Dict[str, Any],
@@ -323,8 +336,23 @@ def export_embedded_images(
 
             if file_id in existing_embedded_files:
                 target_path = _resolve_existing_link_target(file_path, existing_embedded_files[file_id])
+                if target_path.suffix.lower() == ".webp" and mime_type.lower() != "image/webp":
+                    # WebP に変換済みの画像。ブラウザは変換前の dataURL を持ち続けるが、
+                    # fileId は内容から決まるので、ファイルがあれば書き直さない
+                    if target_path.exists():
+                        continue
+                    converted = convert_to_webp(image_bytes, mime_type, force=True)
+                    if converted is None:
+                        logger.warning("Failed to restore WebP image %s", file_id)
+                        continue
+                    image_bytes = converted
             else:
-                filename = f"{file_id}.{ext}"
+                converted = None
+                if not should_skip_conversion(mime_type, _original_name_hint(file_data)):
+                    converted = convert_to_webp(image_bytes, mime_type)
+                if converted is not None:
+                    image_bytes, ext = converted, "webp"
+                filename = build_image_filename(file_path.parent, file_path.name, ext)
                 target_path = file_path.parent / filename
                 image_files_map[file_id] = filename
 
